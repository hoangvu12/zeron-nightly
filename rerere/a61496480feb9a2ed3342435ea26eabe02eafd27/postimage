        let long = "word ".repeat(24 * 1024);
        rig.core.doc_host.queue_command("lead", report_from("kid-a", ReportStatus::Message, &long)).unwrap();
        rig.until("the first part reaches the lead", |r| !r.reports("lead").is_empty()).await;
        let first = rig.reports("lead").remove(0);
        assert!(read(&first)[0].2.starts_with("(Part 1 of 3 of this message.)"), "{}", &first[..200]);
        assert!(notes(&first).iter().any(|n| n.starts_with("More of your children's reports are waiting")));
        assert_eq!(rig.queued("lead").len(), 2, "the rest wait for the turn's end");
        // The lead's runtime reads each part from its mailbox (played here),
        // and each turn's end brings the next.
        for n in 2..=3 {
            let lead = lock(&rig.harness.runs).get("lead").cloned().unwrap();
            loop {
                if lock(&lead._steers).try_recv().is_ok() {
                    break;
                }
                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
            }
            lead.feed
                .send(AgentEvent::Steered { assistant_message_id: None, next_assistant_message_id: Some(format!("a{n}")) })
                .unwrap();
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            rig.until("the next part", |r| r.reports("lead").len() == n).await;
        }
        let whole: String = rig
            .reports("lead")
            .iter()
            .enumerate()
            .map(|(i, text)| read(text)[0].2.strip_prefix(&format!("(Part {} of 3 of this message.)\n\n", i + 1)).unwrap().to_owned())
            .collect();
        assert_eq!(whole, long);
        rig.core.sessions.shutdown().await;
    }

