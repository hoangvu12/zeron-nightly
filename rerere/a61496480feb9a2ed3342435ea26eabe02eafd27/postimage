        let kid = rig.start("kid-a", &from_lead("Push once the tests pass.")).await;
        kid.turn.set_background_processes(vec![background_task()]);
        rig.until("its tests run", |r| !r.status("kid-a").background_tasks.is_empty()).await;
        kid.feed.send(text("The tests are building.")).unwrap();
