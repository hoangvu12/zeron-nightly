    type Ask = Arc<
        dyn Fn(Vec<UserInputQuestion>) -> oneshot::Receiver<Vec<zeron_proto::UserInputAnswer>>
            + Send
            + Sync,
    >;

    /// One run of a chat on [`ChatsHarness`], played by the test: its event
    /// feed, its input bridge (to ask the person something), and its
    /// mailbox, kept open so steers land in it.
    #[derive(Clone)]
    struct ChatRun {
        feed: mpsc::UnboundedSender<AgentEvent>,
        ask: Ask,
        _steers: Arc<Mutex<mpsc::Receiver<SteerMessage>>>,
        /// Where the engine stops the run's turn in place.
        turn: zeron_harness::TurnControl,
        /// What the run was started with.
        prompt: String,
    }

    /// A harness running several chats at once, told apart by the origin
    /// every run carries. Each chat's latest run is the test's to play. It
    /// stops a turn in place, and a steer stops a running tool first, as
    /// Claude does.
    #[derive(Default)]
    struct ChatsHarness {
        runs: Mutex<HashMap<String, ChatRun>>,
    }

    #[async_trait::async_trait]
    impl Harness for ChatsHarness {
        fn id(&self) -> HarnessId {
            HarnessId::Mock
        }
        fn display_name(&self) -> &str {
            "Chats"
        }
        fn supports_steering(&self) -> bool {
            true
        }
        fn steering_mode(&self) -> zeron_proto::SteeringMode {
            zeron_proto::SteeringMode::StepBoundary
        }
        fn stops_turn_in_place(&self) -> bool {
            true
        }
        fn steer_stops_tool(&self) -> bool {
            true
        }
        fn reasoning_levels(&self) -> &[zeron_proto::ReasoningLevel] {
            &[zeron_proto::ReasoningLevel::High]
        }
        async fn models(&self) -> Result<Vec<zeron_proto::Model>, zeron_harness::HarnessError> {
            Ok(vec![])
        }
        async fn run(
            &self,
            request: RunRequest,
            controls: RunControls,
        ) -> Result<
            futures::stream::BoxStream<'static, Result<AgentEvent, zeron_harness::HarnessError>>,
            zeron_harness::HarnessError,
        > {
            let chat = request
                .env
                .get(zeron_proto::ORIGIN_ENV)
                .and_then(|origin| origin.strip_prefix("chat:"))
                .expect("every run carries its chat")
                .to_owned();
            let (feed, mut rx) = mpsc::unbounded_channel();
            lock(&self.runs).insert(
                chat,
                ChatRun {
                    feed,
                    ask: Arc::from(controls.request_input),
                    _steers: Arc::new(Mutex::new(controls.steering)),
                    turn: controls.turn,
                    prompt: request.prompt.clone(),
                },
            );
            Ok(futures::stream::poll_fn(move |cx| rx.poll_recv(cx).map(|e| e.map(Ok))).boxed())
        }
    }

    /// A lead chat and two subagents it made, `kid-a` and `kid-b`, all
    /// hosted here on [`ChatsHarness`].
    struct FamilyRig {
        core: crate::EngineCore,
        harness: Arc<ChatsHarness>,
        _dir: tempfile::TempDir,
    }

    async fn family_rig() -> FamilyRig {
        // SAFETY: tests only; nothing reads these but the run loop and the
        // queue's drain, each when it needs it.
        unsafe { std::env::set_var("ZERON_WAKE_GRACE_MS", "300") };
        unsafe { std::env::set_var("ZERON_REPORT_WINDOW_MS", "1000") };
        unsafe { std::env::set_var("ZERON_REPORT_RETRY_MS", "300") };
        unsafe { std::env::set_var("ZERON_REPORT_MESSAGE_HOLD_MS", "4000") };
        unsafe { std::env::set_var("ZERON_REPORT_FYI_HOLD_MS", "2500") };
        unsafe { std::env::set_var("ZERON_REPORT_PERSON_HOLD_MS", "5000") };
        unsafe { std::env::set_var("ZERON_REPORT_GROUP_HOLD_MS", "3000") };
        unsafe { std::env::set_var("ZERON_REPORT_UNSYNCED_MS", "3000") };
        unsafe { std::env::set_var("ZERON_REPORT_UPDATED_GRACE_MS", "3000") };
        let harness = Arc::new(ChatsHarness::default());
        let registry = HarnessRegistry::new();
        registry.register(harness.clone());
        let dir = tempfile::tempdir().unwrap();
        let core =
            crate::EngineCore::assemble(dir.path(), Arc::new(registry), HarnessId::Mock, None)
                .unwrap();
        let config = zeron_proto::ChatConfig {
            harness: HarnessId::Mock,
            model: request().model,
            reasoning: request().reasoning,
            model_options: Default::default(),
            sandbox: SandboxLevel::WorkspaceWrite,
            access: Default::default(),
            plan: false,
        };
        for (id, title, parent) in [
            ("lead", "Lead", None),
            ("kid-a", "Tests", Some("lead")),
            ("kid-b", "Docs", Some("lead")),
        ] {
            core.workspace
                .create_chat_with_parent(
                    id,
                    None,
                    Some(&core.device_id),
                    Some(config.clone()),
                    Some(request().cwd),
                    parent.map(str::to_owned),
                )
                .unwrap();
            core.workspace.rename_chat(id, title).unwrap();
        }
        FamilyRig { core, harness, _dir: dir }
    }

    /// What the lead's agent writes its subagent, as Zeron delivers it.
    fn from_lead(text: &str) -> String {
        zeron_proto::agent_messages::agent_message("Lead (lead)", "lead", text)
    }

    impl FamilyRig {
        /// Send `chat` its first message and start its run, mid-turn.
        async fn start(&self, chat: &str, prompt: &str) -> ChatRun {
            let mut request = request();
            request.prompt = prompt.into();
            self.core
                .sessions
                .dispatch(chat, HarnessId::Mock, request, Some(format!("{chat}-m1")))
                .await
                .unwrap();
            let run = loop {
                if let Some(run) = lock(&self.harness.runs).get(chat).cloned() {
                    break run;
                }
                tokio::time::sleep(std::time::Duration::from_millis(5)).await;
            };
            run.feed.send(started()).unwrap();
            run
        }

        fn status(&self, chat: &str) -> Session {
            self.core.sessions.session_status(chat).expect("a session row")
        }

        /// The reports `chat` received, each message's in order.
        fn reports(&self, chat: &str) -> Vec<String> {
            let handle = self.core.doc_host.open(chat).unwrap();
            handle
                .doc()
                .read_entries()
                .unwrap()
                .into_iter()
                .filter(|e| e.role == zeron_doc::MessageRole::User)
                .map(|e| reports::text_of_entry(&e))
                .filter(|text| zeron_proto::agent_messages::child_reports(text).is_some())
                .collect()
        }

        /// The lead's queue: what waits for its turn's end.
        fn queued(&self, chat: &str) -> Vec<String> {
            let handle = self.core.doc_host.open(chat).unwrap();
            handle.doc().read_queue().unwrap().into_iter().map(|q| q.text).collect()
        }

        /// Until `check` holds (a few seconds at most).
        async fn until(&self, what: &str, check: impl Fn(&Self) -> bool) {
            for _ in 0..400 {
                if check(self) {
                    return;
                }
                tokio::time::sleep(std::time::Duration::from_millis(30)).await;
            }
            panic!("never happened: {what}");
        }

        /// Nothing more happens for a while.
        async fn quiet(&self) {
            tokio::time::sleep(std::time::Duration::from_millis(600)).await;
        }
    }

    fn read(report: &str) -> Vec<(String, zeron_proto::agent_messages::ReportStatus, String)> {
        zeron_proto::agent_messages::child_reports(report)
            .unwrap()
            .into_iter()
            .map(|r| (r.sender.chat_id, r.status, r.body.to_owned()))
            .collect()
    }

    fn tool_call(id: &str, tool: &str, input: serde_json::Value) -> AgentEvent {
        AgentEvent::ToolCall {
            id: id.into(),
            call: zeron_proto::ToolCall::Mcp {
                server: "zeron".into(),
                tool: tool.into(),
                input: Some(input),
            },
        }
    }

    fn tool_result(id: &str) -> AgentEvent {
        AgentEvent::ToolResult {
            id: id.into(),
            is_error: false,
            output: None,
            diff: None,
            exit_code: None,
            preview_paths: Vec::new(),
            image_payloads: Vec::new(),
        }
    }

