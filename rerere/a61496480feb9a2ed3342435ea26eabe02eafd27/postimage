    impl FamilyRig {
        /// What a `read_chat` of `chat` returns now, as the agent gets it,
        /// with `older` bytes of older messages ahead of its own.
        fn read_chat(&self, chat: &str, older: usize) -> String {
            let handle = self.core.doc_host.open(chat).unwrap();
            let entries = handle.doc().read_entries().unwrap();
            let mut messages = Vec::new();
            if older > 0 {
                messages.push(serde_json::json!({ "id": "older", "role": "user", "text": "x".repeat(older) }));
            }
            messages.extend(
                zeron_mcp::render_entries(&entries, zeron_mcp::RenderOptions::default())
                    .iter()
                    .map(|m| serde_json::json!(m)),
            );
            serde_json::to_string_pretty(&serde_json::json!({ "chatId": chat, "messages": messages })).unwrap()
        }
    }

    fn tool_output(id: &str, output: String) -> AgentEvent {
        AgentEvent::ToolResult {
            id: id.into(),
            is_error: false,
            output: Some(output),
            diff: None,
            exit_code: None,
            preview_paths: Vec::new(),
            image_payloads: Vec::new(),
        }
    }

