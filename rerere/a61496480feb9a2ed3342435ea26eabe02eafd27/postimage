    async fn held_reports_go_on_their_own_once_the_person_is_quiet() {
        let rig = family_rig().await;
        let kid = rig.talking_to_lead().await;
        let typed = rig.typed_at();
        kid.feed.send(text("All 40 pass.")).unwrap();
        kid.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' report waits", |r| r.queued("lead").len() == 1).await;
        rig.until("it goes", |r| !r.reports("lead").is_empty()).await;
        assert!(now_ms() >= typed + 5_000, "not before the person is quiet");
        let said = rig.said_to_lead();
        assert_eq!(read(said.last().unwrap()), [("kid-a".into(), ReportStatus::Finished, "All 40 pass.".into())]);
        assert!(rig.queued("lead").is_empty());
        rig.core.sessions.shutdown().await;
    }

    /// The lead's run on the person's words fails before its agent does
    /// anything: the report that went with them is held again, waits for
    /// the person, and goes with what they write next, one copy of it in
    /// the transcript.
    #[tokio::test]
    async fn a_report_that_went_with_a_run_that_failed_first_is_held_again() {
        let rig = family_rig().await;
        let kid = rig.talking_to_lead().await;
        kid.feed.send(text("All 40 pass.")).unwrap();
        kid.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' report waits", |r| r.queued("lead").len() == 1).await;
        let lead = lock(&rig.harness.runs).get("lead").cloned().unwrap();
        rig.person_writes("lead", "Anything back?", "p2");
        rig.until("the lead reads it", |r| r.status("lead").status == SessionStatus::Working).await;
        let (lead, _) = rig.next_prompt("lead", &lead).await;
        // The provider refuses before the agent does anything.
        lead.feed.send(done(DoneStatus::Errored)).unwrap();
        rig.until("the report is held again", |r| r.queued("lead").len() == 1).await;
        rig.quiet().await;
        assert_eq!(rig.queued("lead").len(), 1, "it waits for the person");
        assert_eq!(rig.reports("lead").len(), 1);

        rig.person_writes("lead", "Try again, please.", "p3");
        rig.until("the lead reads it", |r| r.status("lead").status == SessionStatus::Working).await;
        let (_, given) = rig.next_prompt("lead", &lead).await;
        let rest = given.strip_prefix("Try again, please.\n\n").unwrap_or_else(|| panic!("{given}"));
        assert_eq!(statuses(rest), [("kid-a".to_owned(), ReportStatus::Finished)]);
        assert!(rig.queued("lead").is_empty());
        assert_eq!(rig.reports("lead").len(), 1, "one copy in the transcript");
        rig.core.sessions.shutdown().await;
    }

    /// Once the lead's agent has answered the person's words and the report
    /// with them, an engine starting again sends nothing anew: the lead's
    /// ledger has the report, its last message was answered, and when the
    /// person last typed is kept in its doc.
    #[tokio::test]
    async fn a_report_that_went_with_the_persons_words_isnt_sent_again_on_a_restart() {
        let rig = family_rig().await;
        let kid = rig.talking_to_lead().await;
        kid.feed.send(text("All 40 pass.")).unwrap();
        kid.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' report waits", |r| r.queued("lead").len() == 1).await;
        let lead = lock(&rig.harness.runs).get("lead").cloned().unwrap();
        rig.person_writes("lead", "Anything back?", "p2");
        rig.until("the lead reads it", |r| r.status("lead").status == SessionStatus::Working).await;
        let (lead, _) = rig.next_prompt("lead", &lead).await;
        lead.feed.send(text("All 40 pass, says Tests.")).unwrap();
        lead.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("the lead rests", |r| r.status("lead").status != SessionStatus::Working).await;

        assert!(reports::owed_on_boot(&rig.core.doc_host, i64::MIN, |_| false, |_| false).is_empty());
        reports::report_turn_end(
            rig.core.doc_host.clone(),
            rig.core.sessions.inner.journal.clone(),
            Arc::new(reports::Reported::default()),
            "kid-a".into(),
            ReportStatus::Finished,
            None,
            now_ms(),
        )
        .await;
        rig.core.doc_host.retry_unread_reports("lead");
        let handle = rig.core.doc_host.open("lead").unwrap();
        rig.core.doc_host.drain_queue(&handle).await;
        rig.quiet().await;
        assert!(rig.queued("lead").is_empty());
        assert_eq!(rig.reports("lead").len(), 1);
        assert!(handle.doc().person_typed_at().is_some());
        rig.core.sessions.shutdown().await;
    }

    impl FamilyRig {
        /// As [`Self::both_at_work`], the lead having made both to hear from
        /// at once (`create_chats` with `notify: "all"`): its run too.
        async fn group_at_work(&self) -> (ChatRun, ChatRun, ChatRun) {
            let kids = ["kid-a".to_owned(), "kid-b".to_owned()];
            let group = self.core.doc_host.open_report_group("lead", &kids).unwrap();
            let lead = self.start("lead", "Get tests and docs done.").await;
            lead.feed.send(text("Asked both; I'll hear back.")).unwrap();
            let a = self.start("kid-a", &from_lead("Run the tests.")).await;
            let b = self.start("kid-b", &from_lead("Write the docs.")).await;
            for kid in &kids {
                let asked = format!("{kid}-m1");
                assert!(self.core.doc_host.confirm_group_member("lead", &group, kid, &asked).unwrap());
            }
            a.feed.send(text("Running them.")).unwrap();
            b.feed.send(text("Writing.")).unwrap();
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            self.until("the lead waits on both", |r| {
                r.status("lead").waiting.is_some_and(|w| w.on.len() == 2)
            })
            .await;
            (lead, a, b)
        }

        /// The groups the lead keeps.
        fn groups(&self) -> Vec<zeron_doc::ReportGroup> {
            self.core.doc_host.open("lead").unwrap().doc().report_groups()
        }
    }

    /// Both children the lead asked to hear from at once finish, the second
    /// well past the first's window: one wake, with both ends.
    #[tokio::test]
    async fn a_group_all_done_wakes_its_parent_once() {
        let rig = family_rig().await;
        let (_lead, a, b) = rig.group_at_work().await;
        a.feed.send(text("Green.")).unwrap();
        a.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' end is held", |r| r.queued("lead").len() == 1).await;
        tokio::time::sleep(std::time::Duration::from_millis(1500)).await;
        assert!(rig.reports("lead").is_empty(), "Tests' end waits for Docs'");
        b.feed.send(text("Written.")).unwrap();
        b.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("the lead reads both", |r| !r.reports("lead").is_empty()).await;
        rig.quiet().await;
        let reports = rig.reports("lead");
        assert_eq!(reports.len(), 1);
        assert_eq!(
            statuses(&reports[0]),
            [("kid-a".to_owned(), ReportStatus::Finished), ("kid-b".to_owned(), ReportStatus::Finished)]
        );
        assert_eq!(notes(&reports[0]), ["No child is working for you now."]);
        assert!(rig.queued("lead").is_empty());
        assert!(rig.groups().is_empty());
        rig.core.sessions.shutdown().await;
    }

    /// A member's failure wakes the lead at once, and counts as done: the
    /// other's end then goes as soon as it's in.
    #[tokio::test]
    async fn a_group_members_failure_wakes_its_parent_at_once() {
        let rig = family_rig().await;
        let (lead, a, b) = rig.group_at_work().await;
        a.feed.send(done(DoneStatus::Errored)).unwrap();
        rig.until("the lead hears of it", |r| !r.reports("lead").is_empty()).await;
        let report = &rig.reports("lead")[0];
        assert_eq!(statuses(report), [("kid-a".to_owned(), ReportStatus::Failed)]);
        let notes = notes(report);
        assert!(
            notes.iter().any(|n| n == "You asked to hear from Tests, Docs at once, when all are done. Done: Tests. Still out: Docs."),
            "{notes:?}"
        );
        let (woke, _) = rig.next_prompt("lead", &lead).await;
        woke.feed.send(done(DoneStatus::Completed)).unwrap();
        b.feed.send(text("Written.")).unwrap();
        b.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("the lead reads Docs'", |r| r.reports("lead").len() == 2).await;
        assert_eq!(statuses(&rig.reports("lead")[1]), [("kid-b".to_owned(), ReportStatus::Finished)]);
        assert!(rig.groups().is_empty());
        rig.core.sessions.shutdown().await;
    }

    /// A member's question wakes the lead at once; the member stays in the
    /// group, and the other's end waits on for it.
    #[tokio::test]
    async fn a_group_members_question_wakes_its_parent_and_keeps_the_group() {
        let rig = family_rig().await;
        let (_lead, a, b) = rig.group_at_work().await;
        b.feed.send(text("Written.")).unwrap();
        b.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Docs' end is held", |r| r.queued("lead").len() == 1).await;
        let _answer = (a.ask)(vec![UserInputQuestion {
            id: "q1".into(),
            header: "Suite".into(),
            question: "Which suite do I run?".into(),
            options: vec!["unit".into(), "all".into()],
            multi_select: false,
            prefill: None,
            multiline: false,
            note: None,
        }]);
        rig.until("the lead hears the question", |r| !r.reports("lead").is_empty()).await;
        let reports = rig.reports("lead");
        assert_eq!(reports.len(), 1);
        assert_eq!(statuses(&reports[0]), [("kid-a".to_owned(), ReportStatus::NeedsInput)], "Docs' end isn't with it");
        let notes = notes(&reports[0]);
        assert!(
            notes.iter().any(|n| n == "You asked to hear from Tests, Docs at once, when all are done. Done: Docs. Still out: Tests."),
            "{notes:?}"
        );
        assert_eq!(rig.queued("lead").len(), 1, "Docs' end waits on");
        assert_eq!(rig.groups().len(), 1);
        assert_eq!(rig.groups()[0].members.len(), 2);
        rig.core.sessions.shutdown().await;
    }

    /// The first end held waits the group's hold out (30 minutes; here 3
    /// seconds): it goes, saying who is still out, and the group is over.
    #[tokio::test]
    async fn a_group_waited_on_too_long_lets_its_ends_go() {
        let rig = family_rig().await;
        let (_lead, a, b) = rig.group_at_work().await;
        let held = std::time::Instant::now();
        a.feed.send(text("Green.")).unwrap();
        a.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' end is held", |r| r.queued("lead").len() == 1).await;
        tokio::time::sleep(std::time::Duration::from_millis(1500)).await;
        assert!(rig.reports("lead").is_empty(), "Tests' end waits for Docs'");
        rig.until("the group lets it go", |r| !r.reports("lead").is_empty()).await;
        assert!(held.elapsed() >= std::time::Duration::from_millis(2500), "{:?}", held.elapsed());
        let report = &rig.reports("lead")[0];
        assert_eq!(statuses(report), [("kid-a".to_owned(), ReportStatus::Finished)]);
        let notes = notes(report);
        assert!(
            notes.iter().any(|n| n.ends_with("Still waiting on Docs, each reporting on its own from now on.")),
            "{notes:?}"
        );
        // Docs reports on its own.
        b.feed.send(text("Written.")).unwrap();
        b.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Docs' end", |r| r.heard().iter().any(|(from, ..)| from == "kid-b")).await;
        assert!(rig.groups().is_empty());
        rig.core.sessions.shutdown().await;
    }

    /// A restart cut the lead's `create_chats` off while it still made Docs:
    /// the group is over, and Tests' end goes on its own.
    #[tokio::test]
    async fn a_group_cut_off_while_its_children_were_made_is_over() {
        let rig = family_rig().await;
        let (a, b) = rig.both_at_work().await;
        let group = zeron_doc::ReportGroup {
            id: "g1".into(),
            boot: "an earlier run".into(),
            members: vec![
                zeron_doc::GroupMember { child: "kid-a".into(), asked: Some("kid-a-m1".into()) },
                zeron_doc::GroupMember { child: "kid-b".into(), asked: None },
            ],
            released: None,
        };
        rig.core.doc_host.open("lead").unwrap().doc().set_report_groups(&[group]).unwrap();
        a.feed.send(text("Green.")).unwrap();
        a.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' word goes", |r| !r.reports("lead").is_empty()).await;
        assert_eq!(statuses(&rig.reports("lead")[0]), [("kid-a".to_owned(), ReportStatus::Finished)]);
        assert_eq!(rig.status("kid-b").status, SessionStatus::Working);
        assert!(rig.groups().is_empty());
        drop(b);
        rig.core.sessions.shutdown().await;
    }

    /// The lead sends Tests something new while Tests' end is held: Tests
    /// leaves the group, and its end goes when the lead's turn ends.
    #[tokio::test]
    async fn a_new_request_takes_a_child_out_of_its_group() {
        let rig = family_rig().await;
        let (lead, a, b) = rig.group_at_work().await;
        a.feed.send(text("Green.")).unwrap();
        a.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' end is held", |r| r.queued("lead").len() == 1).await;
        rig.person_writes("lead", "Lint it too.", "l2");
        let (turn, _) = rig.next_prompt("lead", &lead).await;
        let mut request = request();
        request.prompt = from_lead("Now run the linter.");
        rig.core
            .doc_host
            .queue_command("kid-a", zeron_doc::SessionCommandPayload::Run { request, message_id: "kid-a-m2".into() })
            .unwrap();
        let _linting = rig.next_prompt("kid-a", &a).await;
        turn.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("the lead reads Tests'", |r| !r.reports("lead").is_empty()).await;
        assert_eq!(statuses(&rig.reports("lead")[0]), [("kid-a".to_owned(), ReportStatus::Finished)]);
        assert_eq!(rig.status("kid-b").status, SessionStatus::Working);
        let members: Vec<String> = rig.groups().iter().flat_map(|g| g.members.iter().map(|m| m.child.clone())).collect();
        assert_eq!(members, ["kid-b"]);
        drop(b);
        rig.core.sessions.shutdown().await;
    }

    /// A member's follow-up takes it out of its group: the end it follows
    /// goes first, the follow-up after it, never news without what it
    /// follows; the other member stays in.
    #[tokio::test]
    async fn a_group_members_follow_up_brings_its_end_first() {
        let rig = family_rig().await;
        let (_lead, kid, b) = rig.group_at_work().await;
        kid.turn.set_background_processes(vec![background_task()]);
        rig.until("its tests run", |r| !r.status("kid-a").background_tasks.is_empty()).await;
        kid.feed.send(text("The tests are building.")).unwrap();
        kid.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("Tests' end is held", |r| r.queued("lead").len() == 1).await;
        tokio::time::sleep(std::time::Duration::from_millis(50)).await;

        kid.turn.set_background_processes(Vec::new());
        rig.until("its tests are done", |r| r.status("kid-a").background_tasks.is_empty()).await;
        kid.turn.note_wake();
        rig.until("Tests works again", |r| r.status("kid-a").status == SessionStatus::Working).await;
        kid.feed.send(text("Pushed abc123.")).unwrap();
        kid.feed.send(done(DoneStatus::Completed)).unwrap();
        let said = |r: &FamilyRig| -> Vec<String> {
            r.reports("lead").iter().flat_map(|text| read(text)).map(|(_, _, body)| body).collect()
        };
        rig.until("the follow-up", |r| said(r).iter().any(|body| body.starts_with("(Follow-up:"))).await;
        let said = said(&rig);
        assert_eq!(said.len(), 2, "{said:?}");
        assert!(said[0].contains("The tests are building."), "the end first: {said:?}");
        assert!(said[1].starts_with("(Follow-up:"), "{said:?}");
        assert!(rig.queued("lead").is_empty());
        let members: Vec<String> = rig.groups().iter().flat_map(|g| g.members.iter().map(|m| m.child.clone())).collect();
        assert_eq!(members, ["kid-b"]);
        drop(b);
        rig.core.sessions.shutdown().await;
    }
