    impl FamilyRig {
        /// The person talks to the lead while Tests works on what the lead
        /// asked it: the lead answers them, and rests. Tests' run.
        async fn talking_to_lead(&self) -> ChatRun {
            let lead = self.start("lead", "Get the tests run.").await;
            lead.feed.send(text("Asked Tests.")).unwrap();
            let kid = self.start("kid-a", &from_lead("Run the tests.")).await;
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            self.until("the lead rests", |r| r.status("lead").status != SessionStatus::Working).await;
            self.person_writes("lead", "What's the plan?", "p1");
            self.until("the lead reads it", |r| r.status("lead").status == SessionStatus::Working).await;
            let (lead, _) = self.next_prompt("lead", &lead).await;
            lead.feed.send(text("Tests runs the suite; I'll tell you.")).unwrap();
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            self.until("the lead answered them", |r| r.status("lead").status != SessionStatus::Working).await;
            kid
        }

        /// What `chat`'s next turn was given: the message its runtime reads
        /// from its mailbox (played as read), or what a fresh run of it was
        /// started with. Its run.
        async fn next_prompt(&self, chat: &str, was: &ChatRun) -> (ChatRun, String) {
            loop {
                let run = lock(&self.harness.runs).get(chat).cloned().unwrap();
                if !run.feed.same_channel(&was.feed) {
                    run.feed.send(started()).unwrap();
                    let prompt = run.prompt.clone();
                    return (run, prompt);
                }
                let steer = lock(&run._steers).try_recv();
                if let Ok(steer) = steer {
                    let answer = format!("{}-answer", steer.message_id.clone().unwrap_or_default());
                    run.feed
                        .send(AgentEvent::Steered { assistant_message_id: None, next_assistant_message_id: Some(answer) })
                        .unwrap();
                    return (run, steer.prompt);
                }
                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
            }
        }

        /// Zeron's message right after the person's `id` in the lead's
        /// transcript: what was held, gone with their words. Theirs reads
        /// as they wrote it (`theirs`).
        fn held_after(&self, id: &str, theirs: &str) -> String {
            let entries = self.core.doc_host.open("lead").unwrap().doc().read_entries().unwrap();
            let at = entries.iter().position(|e| e.id == id).expect("their message");
            assert_eq!(reports::text_of_entry(&entries[at]), theirs);
            let next = entries.get(at + 1).expect("Zeron's after it");
            assert!(next.role == zeron_doc::MessageRole::User, "{}", next.id);
            reports::text_of_entry(next)
        }

        /// When the person last typed to the lead, as its host keeps it.
        fn typed_at(&self) -> i64 {
            self.core.doc_host.open("lead").unwrap().doc().person_typed_at().expect("the person's word, kept")
        }
    }

