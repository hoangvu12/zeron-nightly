    impl FamilyRig {
        /// `kid-r`, the lead's subagent on the laptop, whose Zeron has `caps`
        /// (none: one that doesn't report by itself), and the lead, its first
        /// turn done. The lead's run.
        async fn remote_child(&self, caps: &[&str]) -> ChatRun {
            let lead = self.start("lead", "Get the diff reviewed.").await;
            lead.feed.send(text("Asked Remote.")).unwrap();
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            self.until("the lead is done", |r| r.status("lead").last_completed_turn.is_some()).await;
            self.core
                .workspace
                .create_chat_with_parent("kid-r", None, Some("laptop"), None, Some(request().cwd), Some("lead".into()))
                .unwrap();
            self.core.workspace.rename_chat("kid-r", "Remote").unwrap();
            self.laptop(caps);
            lead
        }

        /// The laptop's device row, its Zeron having `caps`, online.
        fn laptop(&self, caps: &[&str]) {
            self.laptop_seen(caps, 0);
        }

        /// The laptop's device row, its Zeron having `caps`, last heard
        /// from `ago` ms ago (past 70 s: offline).
        fn laptop_seen(&self, caps: &[&str], ago: i64) {
            self.core.workspace.upsert_device_row(&zeron_proto::Device {
                id: "laptop".into(),
                name: "Laptop".into(),
                platform: "macos".into(),
                last_seen_at: Some(chrono::Utc::now() - chrono::Duration::milliseconds(ago)),
                created_at: None,
                version: None,
                cursor_sdk_version: None,
                capabilities: caps.iter().map(|c| (*c).to_owned()).collect(),
            });
        }

        /// `kid-r`'s transcript gains `id`, written `ago` ms ago by its host
        /// and synced here: the lead's message (`User`), or its answer.
        fn remote_says(&self, id: &str, role: zeron_doc::MessageRole, text: &str, ago: i64) {
            let entry = zeron_doc::SessionMessageEntry {
                id: id.into(),
                role,
                parts: vec![zeron_doc::MessagePart::Text { id: format!("{id}-t"), text: text.into() }],
                created_at: now_ms() - ago,
                device_id: "laptop".into(),
                status: Some(zeron_doc::MessageStatus::Complete),
                continuation_of: None,
                duration_ms: Some(100),
            };
            self.core.doc_host.open("kid-r").unwrap().doc().push_message(&entry).unwrap();
        }

        /// `kid-r`'s answer `id`, written `ago` ms ago and synced here,
        /// stopped on its question `request`, unanswered.
        fn remote_asks(&self, id: &str, request: &str, question: &str, ago: i64) {
            let entry = zeron_doc::SessionMessageEntry {
                id: id.into(),
                role: zeron_doc::MessageRole::Assistant,
                parts: vec![zeron_doc::MessagePart::Input {
                    id: format!("i-{request}"),
                    request_id: request.into(),
                    questions: vec![zeron_proto::UserInputQuestion {
                        id: "q".into(),
                        header: "Q".into(),
                        question: question.into(),
                        options: Vec::new(),
                        multi_select: false,
                        prefill: None,
                        multiline: false,
                        note: None,
                    }],
                    resolved: false,
                    answers: None,
                }],
                created_at: now_ms() - ago,
                device_id: "laptop".into(),
                status: Some(zeron_doc::MessageStatus::Streaming),
                continuation_of: None,
                duration_ms: None,
            };
            self.core.doc_host.open("kid-r").unwrap().doc().push_message(&entry).unwrap();
        }

        /// `kid-r`'s answer `id`, written `ago` ms ago and synced here, cut
        /// off by its engine's shutdown, as its host writes one.
        fn remote_cut(&self, id: &str, text: &str, ago: i64) {
            let entry = zeron_doc::SessionMessageEntry {
                id: id.into(),
                role: zeron_doc::MessageRole::Assistant,
                parts: vec![
                    zeron_doc::MessagePart::Text { id: format!("{id}-t"), text: text.into() },
                    zeron_doc::MessagePart::Error { id: format!("{id}-e"), message: SHUTDOWN_NOTE.into() },
                ],
                created_at: now_ms() - ago,
                device_id: "laptop".into(),
                status: Some(zeron_doc::MessageStatus::Aborted),
                continuation_of: None,
                duration_ms: Some(100),
            };
            self.core.doc_host.open("kid-r").unwrap().doc().push_message(&entry).unwrap();
        }

        /// `kid-r`'s registry row from the laptop: `status`, its last turn
        /// having ended `outcome` `ago` ms ago, its last finished answer
        /// `completed`.
        fn remote_row(&self, status: SessionStatus, outcome: Option<(DoneStatus, i64)>, completed: Option<&str>) {
            self.core.workspace.record_session(&Session {
                chat_id: "kid-r".into(),
                device_id: "laptop".into(),
                status,
                started_at: None,
                updated_at: chrono::Utc::now(),
                running_subagents: 0,
                background_tasks: Vec::new(),
                last_completed_turn: completed.map(str::to_owned),
                last_turn_outcome: outcome.map(|(status, ago)| zeron_proto::NativeTurnOutcome {
                    status,
                    finished_at: chrono::Utc::now() - chrono::Duration::milliseconds(ago),
                }),
                terminal_activity: None,
                waiting: None,
            });
        }

        /// What `kid-r`'s host, reporting by itself, files in the lead's
        /// ledger under `key`.
        fn remote_reports(&self, key: &str, body: &str) {
            let mut report = request();
            report.prompt = zeron_proto::agent_messages::child_report("Remote (kid-r)", "kid-r", ReportStatus::Finished, body);
            self.core
                .doc_host
                .queue_command("lead", zeron_doc::SessionCommandPayload::Run { request: report, message_id: key.into() })
                .unwrap();
        }

        /// What the lead heard from `kid-r`, read or waiting.
        fn heard_remote(&self) -> Vec<(ReportStatus, String)> {
            self.heard().into_iter().filter(|(id, ..)| id == "kid-r").map(|(_, status, body)| (status, body)).collect()
        }

        /// `kid-r`'s reports in the lead's ledger, by key.
        fn filed_remote(&self) -> Vec<String> {
            self.ledger().into_iter().filter(|id| id.starts_with("report-kid-r-")).collect()
        }
    }

    /// A child on a Zeron that doesn't report by itself: its row says its
    /// turn finished, but its answer hasn't synced here. The lead's host
    /// files nothing from the row alone, and the child's own report, as its
    /// host would have filed it, once its answer is in.
    #[tokio::test]
    async fn a_watched_child_reports_once_its_answer_is_in() {
        use zeron_doc::MessageRole::{Assistant, User};
        let rig = family_rig().await;
        let _lead = rig.remote_child(&[]).await;
        rig.remote_says("r-m1", User, &from_lead("Review the diff."), 3_000);
        rig.remote_row(SessionStatus::Idle, Some((DoneStatus::Completed, 1_000)), Some("r-a1"));
        rig.core.sessions.watch_children();
        rig.quiet().await;
        assert!(rig.filed_remote().is_empty(), "{:?}", rig.filed_remote());

        rig.remote_says("r-a1", Assistant, "LGTM.", 2_000);
