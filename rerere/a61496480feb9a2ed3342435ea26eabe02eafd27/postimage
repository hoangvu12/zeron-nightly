    /// Another chat's agent stops Tests; the stop's report is made once the
    /// lead's next message is in (and its turn under way): still on the
    /// message the stopped turn was on, with what it wrote there, and the
    /// new message's end still reports.
    #[tokio::test]
    async fn a_stops_report_made_late_is_on_the_message_its_turn_was_on() {
        let rig = family_rig().await;
        let lead = rig.start("lead", "Hello.").await;
        lead.feed.send(done(DoneStatus::Completed)).unwrap();
        rig.until("the lead is done", |r| r.status("lead").last_completed_turn.is_some()).await;
        let kid = rig.start("kid-a", &from_lead("Run the tests.")).await;
        kid.feed.send(text("Halfway through.")).unwrap();
        tokio::time::sleep(std::time::Duration::from_millis(300)).await;
        // The stop's report can't be queued at first.
        reports::FAIL_QUEUE.with(|left| left.set(1));
        rig.core
            .doc_host
            .queue_command("kid-a", zeron_doc::SessionCommandPayload::Interrupt { stopped_by: Some("kid-b".into()) })
            .unwrap();
        rig.lead_writes("kid-a", "Rebase on main.", "lead-m2", false);
        rig.until("Tests' next run", |r| {
            !lock(&r.harness.runs).get("kid-a").unwrap().feed.same_channel(&kid.feed)
        })
        .await;
        let next = lock(&rig.harness.runs).get("kid-a").cloned().unwrap();
        next.feed.send(started()).unwrap();
        next.feed.send(text("Rebasing.")).unwrap();
        rig.until("the report was tried", |_| reports::FAIL_QUEUE.with(std::cell::Cell::get) == 0).await;
        tokio::time::sleep(std::time::Duration::from_millis(400)).await;
        assert!(rig.heard().is_empty());
        // Tried again now, the next message's turn streaming.
        let stop = rig
            .core
            .doc_host
            .open("kid-a")
            .unwrap()
            .doc()
            .read_commands()
            .unwrap()
            .into_iter()
            .find(|c| matches!(c.payload, zeron_doc::SessionCommandPayload::Interrupt { .. }))
            .unwrap();
        reports::report_turn_end(
            rig.core.doc_host.clone(),
            rig.core.sessions.inner.journal.clone(),
            rig.core.sessions.inner.reported.clone(),
            "kid-a".into(),
            ReportStatus::Stopped,
            Some(reports::TurnStop::Command(stop.id)),
            now_ms(),
        )
        .await;
        rig.until("the stop reaches the lead", |r| !r.heard().is_empty()).await;
        next.feed.send(text(" Rebased.")).unwrap();
        next.feed.send(done(DoneStatus::Completed)).unwrap();
        // (The finished one says the next turn's reply, whatever it is.)
        let heard_both = |r: &FamilyRig| {
            let heard = r.heard();
            heard.len() == 2
                && (heard[0].0.as_str(), heard[0].1) == ("kid-a", ReportStatus::Stopped)
                && heard[0].2.starts_with("Chat ")
                && heard[0].2.ends_with("possibly unfinished:\n\nHalfway through.")
                && (heard[1].0.as_str(), heard[1].1) == ("kid-a", ReportStatus::Finished)
        };
        rig.until("the lead hears both", heard_both).await;
        rig.quiet().await;
        rig.until("and nothing more", heard_both).await;
        rig.core.sessions.shutdown().await;
    }

