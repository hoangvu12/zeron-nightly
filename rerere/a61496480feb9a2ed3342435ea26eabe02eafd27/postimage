    /// Wire desktop banners: how the person hears a child's reports to its
    /// parent here are paused (the latest set wins).
    pub fn set_notifier(&self, notify: impl Fn(&str, &str, Option<&str>) + Send + Sync + 'static) {
        *lock(&self.inner.notifier) = Some(Arc::new(notify));
