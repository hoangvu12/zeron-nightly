    impl FamilyRig {
        /// The person stops `chat` (no agent's Stop).
        fn person_stops(&self, chat: &str) {
            self.core
                .doc_host
                .queue_command(chat, zeron_doc::SessionCommandPayload::Interrupt { stopped_by: None })
                .unwrap();
        }

        /// The person writes `chat` themselves.
        fn person_writes(&self, chat: &str, text: &str, id: &str) {
            let mut request = request();
            request.prompt = text.into();
            self.core
                .doc_host
                .queue_command(chat, zeron_doc::SessionCommandPayload::Run { request, message_id: id.into() })
                .unwrap();
        }

        /// The children the lead's wait lists now.
        fn on(&self) -> Vec<String> {
            reports::children_on(&self.core.doc_host, "lead", &self.core.sessions.local_sessions())
                .into_iter()
                .map(|w| w.id)
                .collect()
        }

        /// `chat`'s next run, a fresh runtime after `was` stopped, started.
        async fn next_run(&self, chat: &str, was: &ChatRun) -> ChatRun {
            self.until("its next run", |r| !lock(&r.harness.runs).get(chat).unwrap().feed.same_channel(&was.feed))
                .await;
            let run = lock(&self.harness.runs).get(chat).cloned().unwrap();
            run.feed.send(started()).unwrap();
            run
        }
    }

    /// The person stops Tests, which runs the wrong suite, and tells it what
    /// to run instead, however much later: a correction to the lead's task.
    /// The lead hears nothing of the stop; Tests at rest isn't waited on;
    /// once corrected it works for the lead again, and its end reports.
    #[tokio::test]
    async fn a_correction_after_the_persons_stop_keeps_the_task_the_parents() {
        let rig = family_rig().await;
        let (a, b) = rig.both_at_work().await;
        a.feed.send(text("Running the whole suite.")).unwrap();
        tokio::time::sleep(std::time::Duration::from_millis(300)).await;
        rig.person_stops("kid-a");
        rig.until("Tests stops", |r| r.status("kid-a").status != SessionStatus::Working).await;
        rig.until("the stop is filed", |r| r.ledger().iter().any(|id| id.ends_with("-stopped-quiet"))).await;
        assert!(rig.heard().is_empty(), "{:?}", rig.heard());
