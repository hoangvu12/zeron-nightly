    type Banners = Arc<Mutex<Vec<(String, String, Option<String>)>>>;

    impl FamilyRig {
        /// Every desktop banner the engine posts from now on.
        fn banners(&self) -> Banners {
            let banners = Banners::default();
            let sink = banners.clone();
            self.core.sessions.set_notifier(move |title, body, chat| {
                lock(&sink).push((title.into(), body.into(), chat.map(str::to_owned)));
            });
            banners
        }

        /// The lead is done with the person's word (sent it, so it's in its
        /// ledger), and Tests has come back to it 20 times since: reports
        /// its waits returned, after it in its ledger. The lead's run.
        async fn back_twenty_times(&self) -> ChatRun {
            self.person_writes("lead", "Hello.", "lead-m1");
            let lead = loop {
                if let Some(run) = lock(&self.harness.runs).get("lead").cloned() {
                    break run;
                }
                tokio::time::sleep(std::time::Duration::from_millis(5)).await;
            };
            lead.feed.send(started()).unwrap();
            lead.feed.send(done(DoneStatus::Completed)).unwrap();
            self.until("the lead is done", |r| r.status("lead").last_completed_turn.is_some()).await;
            for i in 0..20 {
                let mut request = request();
                request.prompt = zeron_proto::agent_messages::child_report("Tests (kid-a)", "kid-a", ReportStatus::Finished, "ok");
                self.core
                    .doc_host
                    .queue_command(
                        "lead",
                        zeron_doc::SessionCommandPayload::Run { request, message_id: format!("report-kid-a-old{i}-end-waited") },
                    )
                    .unwrap();
            }
            lead
        }

        /// The reports from Tests the lead's host kept from its agent for a
        /// pause: filed under their own keys, the outcome saying so.
        fn kept(&self) -> usize {
            let handle = self.core.doc_host.open("lead").unwrap();
            handle
                .doc()
                .read_commands()
                .unwrap()
                .iter()
                .filter(|c| {
                    c.resolution.as_deref() == Some(reports::PAUSED)
                        && matches!(&c.payload, zeron_doc::SessionCommandPayload::Run { message_id, .. } if message_id.starts_with("report-kid-a-"))
                })
                .count()
        }

        /// Zeron's note under the lead's next report saying Tests' reports
        /// are paused, if one does.
        fn paused_note(&self) -> Option<String> {
            let batch = zeron_proto::agent_messages::child_report("Docs (kid-b)", "kid-b", ReportStatus::Finished, "ok");
            reports::report_notes(&self.core.doc_host, "lead", &batch, &self.core.sessions.local_sessions(), false)
                .into_iter()
                .find(|note| note.contains("its reports are paused"))
        }
    }

