        rig.until("the first report", |r| r.heard().len() == 1).await;
        assert!(rig.heard()[0].2.contains("(Still running in its background: the tests"), "{:?}", rig.heard());
        tokio::time::sleep(std::time::Duration::from_millis(50)).await;

