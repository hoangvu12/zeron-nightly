    impl FamilyRig {
        /// `chat`'s run as it stands now, started if it's a new one since
        /// `was`; a parked run reads the next message from its mailbox.
        async fn current_run(&self, chat: &str, was: &ChatRun) -> ChatRun {
            let run = lock(&self.harness.runs).get(chat).cloned().unwrap();
            if run.feed.same_channel(&was.feed) {
                self.take_steer(&run).await;
            } else {
                run.feed.send(started()).unwrap();
            }
            run
        }

        /// The lead's ledger: every command's message id.
        fn ledger(&self) -> Vec<String> {
            let handle = self.core.doc_host.open("lead").unwrap();
            handle
                .doc()
                .read_commands()
                .unwrap()
                .into_iter()
                .filter_map(|c| match c.payload {
                    zeron_doc::SessionCommandPayload::Run { message_id, .. } => Some(message_id),
                    _ => None,
                })
                .collect()
        }
    }

    /// A background command the subagent's runtime runs.
    fn background_task() -> zeron_proto::BackgroundTask {
        zeron_proto::BackgroundTask {
            id: "bg1".into(),
            command: "cargo test".into(),
            description: Some("the tests".into()),
            started_at: chrono::Utc::now(),
        }
    }

