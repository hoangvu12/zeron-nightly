 /// Where the parent's latest message sits in `entries` (see
 /// [`request_message`]), while the child's latest turn is still the
-/// parent's: none once the person wrote to it since, taking it over.
-fn parents_turn(entries: &[SessionMessageEntry], parent: &str) -> Option<usize> {
+/// parent's: none once the person wrote to it since, taking it over (a
+/// correction right after their Stop doesn't: see [`took_over`]).
+fn parents_turn(entries: &[SessionMessageEntry], commands: &[zeron_doc::SessionCommandEntry], parent: &str) -> Option<usize> {
     let at = request_message(entries, parent)?;
-    let person_since = entries[at + 1..]
-        .iter()
-        .any(|e| e.role == MessageRole::User && typed(&text_of(&e.parts)));
-    (!person_since).then_some(at)
+    (!took_over(entries, commands, at)).then_some(at)
 }
 
 /// A span of milliseconds as a person says it.
@@ -922,6 +980,50 @@ fn typed(text: &str) -> bool {
     agent_messages::agent_message_sender(text).is_none()
 }
 
+/// `c` is a message the person typed to the chat.
+fn typed_command(c: &zeron_doc::SessionCommandEntry) -> bool {
+    match &c.payload {
+        SessionCommandPayload::Run { request, .. } => typed(&request.prompt),
+        SessionCommandPayload::Steer { prompt, .. } => typed(prompt),
+        _ => false,
+    }
+}
+
+/// `c` is a Stop the person sent (no agent's).
+fn persons_stop(c: &zeron_doc::SessionCommandEntry) -> bool {
+    matches!(c.payload, SessionCommandPayload::Interrupt { stopped_by: None })
+}
+
+/// A message the person sent at `at` corrects the task their Stop `stop`
+/// cut: it came while that Stop was held.
+fn corrects(stop: &zeron_doc::SessionCommandEntry, at: i64) -> bool {
+    at >= stop.issued_at && at - stop.issued_at <= stop_hold_ms()
+}
+
+/// The person wrote to the child since the parent's message at `at` (in its
+/// transcript, or sent and not run yet), other than to correct the task
+/// right after a Stop of theirs: it's theirs now.
+fn took_over(entries: &[SessionMessageEntry], commands: &[zeron_doc::SessionCommandEntry], at: usize) -> bool {
+    let since = entries[at].created_at;
+    let stops: Vec<_> = commands.iter().filter(|c| c.issued_at >= since && persons_stop(c)).collect();
+    entries[at + 1..]
+        .iter()
+        .filter(|e| e.role == MessageRole::User && typed(&text_of(&e.parts)))
+        .map(|e| e.created_at)
+        .chain(commands.iter().filter(|c| c.issued_at >= since && typed_command(c)).map(|c| c.issued_at))
+        .any(|written| !stops.iter().any(|stop| corrects(stop, written)))
+}
+
+/// The person's latest Stop on the child since the parent's message at
+/// `since`, while it's still held (they may yet correct the task).
+fn held_stop(commands: &[zeron_doc::SessionCommandEntry], since: i64, now: i64) -> Option<&zeron_doc::SessionCommandEntry> {
+    commands
+        .iter()
+        .filter(|c| c.issued_at >= since && persons_stop(c))
+        .max_by_key(|c| c.issued_at)
+        .filter(|stop| now - stop.issued_at <= stop_hold_ms())
+}
