+    impl FamilyRig {
+        /// The person stops `chat` (no agent's Stop).
+        fn person_stops(&self, chat: &str) {
+            self.core
+                .doc_host
+                .queue_command(chat, zeron_doc::SessionCommandPayload::Interrupt { stopped_by: None })
+                .unwrap();
+        }
+
+        /// The person writes `chat` themselves.
+        fn person_writes(&self, chat: &str, text: &str, id: &str) {
+            let mut request = request();
+            request.prompt = text.into();
+            self.core
+                .doc_host
+                .queue_command(chat, zeron_doc::SessionCommandPayload::Run { request, message_id: id.into() })
+                .unwrap();
+        }
+
+        /// The children the lead's wait lists now.
+        fn on(&self) -> Vec<String> {
+            reports::children_on(&self.core.doc_host, "lead", &self.core.sessions.local_sessions())
+                .into_iter()
+                .map(|w| w.id)
+                .collect()
+        }
+
+        /// `chat`'s next run, a fresh runtime after `was` stopped, started.
+        async fn next_run(&self, chat: &str, was: &ChatRun) -> ChatRun {
+            self.until("its next run", |r| !lock(&r.harness.runs).get(chat).unwrap().feed.same_channel(&was.feed))
+                .await;
+            let run = lock(&self.harness.runs).get(chat).cloned().unwrap();
+            run.feed.send(started()).unwrap();
+            run
+        }
+    }
