+/// How long the person's Stop on a child is held before the parent hears of
+/// it: what they write to it meanwhile corrects the parent's task (the child
+/// goes on with it, and its end reports as usual), and only a Stop left
+/// standing is news. An agent's Stop, or Zeron's, isn't held.
+/// `ZERON_STOP_HOLD_MS` sets it for tests.
+const STOP_HOLD_MS: i64 = 2 * 60 * 1000;
+
+fn stop_hold_ms() -> i64 {
+    std::env::var("ZERON_STOP_HOLD_MS")
+        .ok()
+        .and_then(|ms| ms.parse().ok())
+        .unwrap_or(STOP_HOLD_MS)
+}
