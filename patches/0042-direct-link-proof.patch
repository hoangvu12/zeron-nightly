+/// `service` as one link from `peer` (the transport's claim) sees it: as an
+/// unverified peer's until the link proves which device it's from
+/// ([`methods::DIRECT_HELLO`]), then as that device's. Any road between two of
+/// the person's devices may serve this; the far end calls [`prove`].
+pub fn proven_service(
+    service: Arc<dyn RpcService>,
+    host: &str,
+    peer: &str,
+    verifier: Arc<dyn Verifier>,
+) -> Arc<dyn RpcService> {
+    Arc::new(Proven {
+        unverified: zeron_rpc::device_room::peer_service(service.clone(), None),
+        service,
+        verified: std::sync::OnceLock::new(),
+        host: host.to_owned(),
+        peer: peer.to_owned(),
+        nonce: uuid::Uuid::new_v4().simple().to_string(),
+        verifier,
+    })
+}
+
+/// What a link's proof signs for: this link, by the host's nonce.
+fn link_name(nonce: &str) -> String {
+    format!("direct-{nonce}")
+}
+
+struct Proven {
+    service: Arc<dyn RpcService>,
+    unverified: Arc<dyn RpcService>,
+    /// Set once, when the link proved its device.
+    verified: std::sync::OnceLock<Arc<dyn RpcService>>,
+    host: String,
+    peer: String,
+    nonce: String,
+    verifier: Arc<dyn Verifier>,
+}
+
+#[async_trait::async_trait]
+impl RpcService for Proven {
+    async fn handle(
+        &self,
+        method: &str,
+        params: serde_json::Value,
+    ) -> Result<zeron_rpc::RpcReply, RpcError> {
+        if method == methods::DIRECT_HELLO {
+            return self.hello(params).await;
+        }
+        let service = self.verified.get().unwrap_or(&self.unverified);
+        service.handle(method, params).await
+    }
+}
+
+impl Proven {
+    /// `{}` → `{device, nonce}`: what to sign. A [`Claim`] → `{device}`, the
+    /// device proven; refused, the link stays an unverified peer's.
+    async fn hello(&self, params: serde_json::Value) -> Result<zeron_rpc::RpcReply, RpcError> {
+        if params.get("key").is_none() {
+            return zeron_rpc::RpcReply::value(&serde_json::json!({
+                "device": self.host,
+                "nonce": self.nonce,
+            }));
+        }
+        let claim: Claim = zeron_rpc::parse_params(params)?;
+        // The device the transport says it is: one device can't prove
+        // itself on another's link.
+        let proven = if claim.device != self.peer {
+            Err(crate::device_proof::Refused::OtherDevice)
+        } else {
+            self.verifier
+                .verify(&claim, &self.host, &link_name(&self.nonce))
+                .await
+        };
+        match proven {
