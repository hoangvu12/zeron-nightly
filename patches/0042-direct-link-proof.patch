index 0000000000000000000000000000000000000000..6ad775bd9eef4546d817d9b43b729ce8e5f7be95
--- /dev/null
+++ b/crates/engine/src/device_proof.rs
@@ -0,0 +1,300 @@
+//! Which of the person's devices is at the far end of a link the edge doesn't
+//! stand behind: a direct WebRTC link ([`crate::direct_rpc`]), or any other
+//! road between two of their computers.
+//!
+//! On the relay the edge checks a dial's proof and stamps the device on every
+//! frame, so the host serves the call as `Caller::Peer{device: Some(..)}`, and
+//! plugins trust it. Elsewhere the far end proves it to the host itself, with
+//! the same proof: its registered signing key over
+//! [`zeron_rpc::caller_proof_message`] (`zeron-device-link:v1:{host}:{link}:{ts}`),
+//! where `link` names this one link (the host's nonce, so a proof made for one
+//! link can't open another). The host checks it against the account's keys
+//! (`GET /plugin-keys`, kept in `<data>/device-keys.json`): the key is the
+//! named device's, not revoked, and the signature holds.
+//!
+//! Nothing here knows the transport: [`Claim`] crosses as JSON, and
+//! [`Verifier`] is what a host asks.
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicI64, Ordering};
+
+use base64::Engine as _;
+use serde::{Deserialize, Serialize};
+
+use crate::plugins::keys::{KeyDirectory, KeyRow};
+
+/// `<data>/device-keys.json`: the account's keys, by device.
+pub const FILE: &str = "device-keys.json";
+/// How far a claim's time (epoch ms) may be from the host's, either way:
+/// clocks differ, and a claim is made for a link as it opens.
+pub const CLAIM_SKEW_MS: i64 = 5 * 60 * 1000;
+/// The account's keys are read again when the copy here is older than this:
+/// a revoked key stops counting within it.
+pub const KEYS_FRESH_MS: i64 = 10 * 60 * 1000;
+/// Past this the copy isn't trusted at all (the edge out of reach that long).
+pub const KEYS_TRUSTED_MS: i64 = 60 * 60 * 1000;
+/// A key not on the copy (made since it was read) sends for the keys again
+/// at most this often.
+pub const MISS_GAP_MS: i64 = 30 * 1000;
+
+/// A device's word for who it is, for one link.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Claim {
+    pub device: String,
+    /// Its registered signing key (b64url).
+    pub key: String,
+    /// The key's signature (b64url) over
+    /// [`zeron_rpc::caller_proof_message`]`(host, link, ts)`.
+    pub signature: String,
+    /// Epoch ms.
+    pub ts: i64,
+}
+
+impl Claim {
+    /// This device's claim for `link` to `host`, signed with its key
+    /// (`prove`: the relay dial's [`zeron_rpc::CallerProofFn`]). `None`: no
+    /// key to sign with yet.
+    pub fn make(prove: &zeron_rpc::CallerProofFn, host: &str, link: &str) -> Option<Self> {
+        let ts = now_ms();
+        let proof = prove(host, link, ts)?;
+        Some(Self {
+            device: proof.device,
+            key: proof.key,
+            signature: proof.signature,
+            ts,
+        })
+    }
+}
+
+/// Why a claim wasn't taken.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Refused {
+    /// Made too long ago, or for later.
+    Stale,
+    /// No key of the account's is this one.
+    UnknownKey,
+    Revoked,
+    /// The key is another device's.
+    OtherDevice,
+    BadSignature,
+    /// The account's keys couldn't be read, and no copy here is recent.
+    NoKeys,
+}
+
+impl std::fmt::Display for Refused {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Stale => "the proof is too old",
+            Self::UnknownKey => "the key isn't one of the account's",
+            Self::Revoked => "the key was revoked",
+            Self::OtherDevice => "the key is another device's",
+            Self::BadSignature => "the signature doesn't hold",
+            Self::NoKeys => "the account's keys couldn't be read",
+        })
+    }
+}
+
+/// What a host asks to know which device a link is from.
+#[async_trait::async_trait]
+pub trait Verifier: Send + Sync + 'static {
+    /// The device `claim` proves for `link` to `host`.
+    async fn verify(&self, claim: &Claim, host: &str, link: &str) -> Result<String, Refused>;
+}
+
+pub fn now_ms() -> i64 {
+    chrono::Utc::now().timestamp_millis()
+}
+
+/// `claim` checked against the account's key `rows` at `now` (epoch ms): the
+/// device it proves, or why not.
+pub fn check(claim: &Claim, host: &str, link: &str, now: i64, rows: &[KeyRow]) -> Result<String, Refused> {
+    if (now - claim.ts).abs() > CLAIM_SKEW_MS {
+        return Err(Refused::Stale);
+    }
+    let row = rows.iter().find(|row| row.key == claim.key).ok_or(Refused::UnknownKey)?;
+    if row.revoked_at.is_some() {
+        return Err(Refused::Revoked);
+    }
+    if row.device_id.is_empty() || row.device_id != claim.device {
+        return Err(Refused::OtherDevice);
+    }
+    let b64 = base64::engine::general_purpose::URL_SAFE_NO_PAD;
+    let (Ok(key), Ok(signature)) = (b64.decode(&claim.key), b64.decode(&claim.signature)) else {
+        return Err(Refused::BadSignature);
+    };
+    let message = zeron_rpc::caller_proof_message(host, link, claim.ts);
+    ring::signature::UnparsedPublicKey::new(&ring::signature::ED25519, key)
+        .verify(message.as_bytes(), &signature)
+        .map_err(|_| Refused::BadSignature)?;
+    Ok(claim.device.clone())
+}
+
+/// The copy of the account's keys kept here.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+struct Copy {
+    account: String,
+    rows: Vec<KeyRow>,
+    /// Epoch ms.
+    read_at: i64,
+}
+
+/// The account's keys as a host checks claims against them: read from the
+/// edge when the copy here is stale or lacks the key asked about, kept in
+/// `<data>/device-keys.json` so a restart offline still knows them.
+pub struct AccountKeys {
+    data_dir: PathBuf,
+    copy: tokio::sync::Mutex<Option<Copy>>,
+    missed_at: AtomicI64,
+}
+
+impl AccountKeys {
+    pub fn new(data_dir: &Path) -> Self {
+        Self {
+            data_dir: data_dir.to_owned(),
+            copy: tokio::sync::Mutex::new(None),
+            missed_at: AtomicI64::new(i64::MIN / 2),
+        }
+    }
+
+    /// `claim` checked against `account`'s keys, read through `directory`
+    /// (the edge) when the copy here won't do.
+    pub async fn verify(
+        &self,
+        directory: Option<&dyn KeyDirectory>,
+        account: Option<&str>,
+        claim: &Claim,
+        host: &str,
+        link: &str,
+    ) -> Result<String, Refused> {
+        let account = account.ok_or(Refused::NoKeys)?;
+        let now = now_ms();
+        let mut copy = self.copy.lock().await;
+        if copy.is_none() {
+            *copy = std::fs::read(self.data_dir.join(FILE))
+                .ok()
+                .and_then(|bytes| serde_json::from_slice(&bytes).ok());
+        }
+        let ours = copy.as_ref().filter(|c| c.account == account);
+        let stale = ours.is_none_or(|c| now - c.read_at >= KEYS_FRESH_MS);
+        let missing = ours.is_some_and(|c| !c.rows.iter().any(|row| row.key == claim.key))
+            && now - self.missed_at.load(Ordering::Relaxed) >= MISS_GAP_MS;
+        if (stale || missing)
+            && let Some(directory) = directory
+        {
+            if missing {
+                self.missed_at.store(now, Ordering::Relaxed);
+            }
+            match directory.keys_since(0).await {
+                Ok((rows, _)) => {
+                    let read = Copy {
+                        account: account.to_owned(),
+                        rows,
+                        read_at: now,
+                    };
+                    let bytes = serde_json::to_vec_pretty(&read).unwrap_or_default();
+                    if let Err(error) = crate::runner::write_private_atomic(&self.data_dir.join(FILE), &bytes) {
+                        tracing::warn!(%error, "couldn't keep the account's device keys");
+                    }
+                    *copy = Some(read);
+                }
+                Err(error) => tracing::info!(%error, "the account's device keys couldn't be read; the copy here is used"),
+            }
+        }
+        let copy = copy
+            .as_ref()
+            .filter(|c| c.account == account && now - c.read_at < KEYS_TRUSTED_MS)
+            .ok_or(Refused::NoKeys)?;
+        check(claim, host, link, now, &copy.rows)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::plugins::keys::tests::FakeDirectory;
+    use crate::plugins::signing;
+
+    const HOST: &str = "desktop";
+    const LINK: &str = "direct-n0nce";
+
+    /// The laptop's key, registered to it, and its claim for [`LINK`].
+    fn laptop(dir: &Path) -> (KeyRow, zeron_rpc::CallerProofFn) {
+        let key = signing::load_or_create_key(dir).unwrap();
+        let row = KeyRow {
+            key: key.public(),
+            fingerprint: String::new(),
+            device_id: "laptop".into(),
+            created_at: 1,
+            revoked_at: None,
+        };
+        let dir = dir.to_owned();
+        let prove: zeron_rpc::CallerProofFn = std::sync::Arc::new(move |host: &str, link: &str, ts: i64| {
+            let (key, signature) = signing::device_link_proof(&dir, host, link, ts)?;
+            Some(zeron_rpc::CallerProof { device: "laptop".into(), key, signature })
+        });
+        (row, prove)
+    }
+
+    #[test]
+    fn a_claim_proves_the_device_its_key_is_registered_to() {
+        let dir = tempfile::tempdir().unwrap();
+        let (row, prove) = laptop(dir.path());
+        let claim = Claim::make(&prove, HOST, LINK).expect("a key to sign with");
+        let now = claim.ts;
+        assert_eq!(check(&claim, HOST, LINK, now, std::slice::from_ref(&row)), Ok("laptop".into()));
+
+        // For another host or another link, it proves nothing.
+        assert_eq!(check(&claim, "server", LINK, now, std::slice::from_ref(&row)), Err(Refused::BadSignature));
+        assert_eq!(check(&claim, HOST, "direct-other", now, std::slice::from_ref(&row)), Err(Refused::BadSignature));
+        // Nor as another device, nor with its time moved.
+        let other = Claim { device: "server".into(), ..claim.clone() };
+        assert_eq!(check(&other, HOST, LINK, now, std::slice::from_ref(&row)), Err(Refused::OtherDevice));
+        let moved = Claim { ts: claim.ts + 1, ..claim.clone() };
+        assert_eq!(check(&moved, HOST, LINK, now, std::slice::from_ref(&row)), Err(Refused::BadSignature));
+        // Not long after it was made.
+        assert_eq!(
+            check(&claim, HOST, LINK, now + CLAIM_SKEW_MS + 1, std::slice::from_ref(&row)),
+            Err(Refused::Stale)
+        );
+        // Not with its key revoked, or not the account's.
+        let revoked = KeyRow { revoked_at: Some(2), ..row.clone() };
+        assert_eq!(check(&claim, HOST, LINK, now, &[revoked]), Err(Refused::Revoked));
+        assert_eq!(check(&claim, HOST, LINK, now, &[]), Err(Refused::UnknownKey));
+        // A key registered to no device in particular proves none.
+        let anyone = KeyRow { device_id: String::new(), ..row };
+        assert_eq!(check(&claim, HOST, LINK, now, &[anyone]), Err(Refused::OtherDevice));
+    }
+
+    #[tokio::test]
+    async fn keys_are_read_when_stale_or_missing_and_a_revocation_counts() {
+        let host_dir = tempfile::tempdir().unwrap();
+        let laptop_dir = tempfile::tempdir().unwrap();
+        let (row, prove) = laptop(laptop_dir.path());
+        let edge = FakeDirectory::default();
+        let keys = AccountKeys::new(host_dir.path());
+        let claim = Claim::make(&prove, HOST, LINK).unwrap();
+
+        // Signed out: no account to read keys for.
+        assert_eq!(keys.verify(Some(&edge), None, &claim, HOST, LINK).await, Err(Refused::NoKeys));
+        // The edge doesn't know it yet.
+        assert_eq!(keys.verify(Some(&edge), Some("acct"), &claim, HOST, LINK).await, Err(Refused::UnknownKey));
+        // Registered since: a missing key reads them again (once a while).
+        edge.rows.lock().unwrap().push(row.clone());
+        keys.missed_at.store(i64::MIN / 2, Ordering::Relaxed);
+        assert_eq!(keys.verify(Some(&edge), Some("acct"), &claim, HOST, LINK).await, Ok("laptop".into()));
+        // Kept here: with the edge out of reach, a restart still knows them.
+        let again = AccountKeys::new(host_dir.path());
+        assert_eq!(again.verify(None, Some("acct"), &claim, HOST, LINK).await, Ok("laptop".into()));
+        // Not for another account.
+        assert_eq!(again.verify(None, Some("other"), &claim, HOST, LINK).await, Err(Refused::NoKeys));
+
+        // Revoked on the edge: counted once the copy is read again.
+        edge.rows.lock().unwrap()[0].revoked_at = Some(5);
+        keys.copy.lock().await.as_mut().unwrap().read_at -= KEYS_FRESH_MS;
+        assert_eq!(keys.verify(Some(&edge), Some("acct"), &claim, HOST, LINK).await, Err(Refused::Revoked));
+
+        // A copy too old to trust, the edge out of reach: nothing proven.
+        keys.copy.lock().await.as_mut().unwrap().read_at -= KEYS_TRUSTED_MS;
+        assert_eq!(keys.verify(None, Some("acct"), &claim, HOST, LINK).await, Err(Refused::NoKeys));
+    }
+}
