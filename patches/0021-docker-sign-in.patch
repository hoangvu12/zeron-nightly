+test("a sign-in that failed in the background says why, and Try again shows a new code", function()
+	local app = open()
+	app:click(`{PAGE} >> role:button "Connect Docker Sandbox"`)
+	app:frames(20)
+	app:click('role:dialog >> role:button "Sign in with Docker Sandbox"')
+	app:frames(20)
+	expect(shows(app, "role:dialog", "WXYZ-1234")).to_be(true)
+	app:command("sandbox_settings_stub.refuse")
+	-- This device's engine said it didn't connect: the dialog says so.
+	expect(app:wait('role:dialog >> role:button "Try again"', { timeout_ms = 15000 })).to_be(true)
+	expect(shows(app, "role:dialog", "Docker didn't sign in")).to_be(true)
+	expect(shows(app, "role:dialog", "Check this code")).to_be(false)
+	expect(app:has(`{PAGE} >> role:button "Disconnect Docker Sandbox"`)).to_be(false)
+
+	app:click('role:dialog >> role:button "Try again"')
+	app:frames(20)
+	expect(shows(app, "role:dialog", "Check this code")).to_be(true)
+	expect(app:has('role:dialog >> role:button "Try again"')).to_be(false)
+	app:command("sandbox_settings_stub.approve")
+	expect(app:wait(`{PAGE} >> role:button "Disconnect Docker Sandbox"`, { timeout_ms = 15000 })).to_be(true)
+end)
+
