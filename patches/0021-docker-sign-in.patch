+    pub(crate) fn connect_began(&self, provider: &str, user_code: &str) {
+        lock(&self.inner.connects).insert(
+            provider.to_owned(),
+            ConnectAttempt {
+                user_code: user_code.to_owned(),
+                error: None,
+            },
