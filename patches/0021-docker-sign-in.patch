+    pub(crate) fn connect_ended(&self, provider: &str, user_code: &str, error: Option<String>) {
+        let mut connects = lock(&self.inner.connects);
+        if connects.get(provider).is_none_or(|a| a.user_code != user_code) {
+            return;
+        }
+        match error {
+            Some(error) => {
