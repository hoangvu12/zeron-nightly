diff --git a/crates/engine/tests/docker_sign_in.rs b/crates/engine/tests/docker_sign_in.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d81fdc372efcdab91589ea1613e5cd743c87103
--- /dev/null
+++ b/crates/engine/tests/docker_sign_in.rs
@@ -0,0 +1,175 @@
+//! Signing in to Docker Sandbox on Docker's own page, at the engine's RPCs:
+//! `ConnectSandboxProvider` answers the code at once and finishes in the
+//! background. However that ends, `ListSandboxProviders` says so with the
+//! provider (`connect`), so Settings never waits on a sign-in that already
+//! failed: Docker refusing it, its code running out, or the key not reaching
+//! the host device.
+
+#[path = "support/docker_stub.rs"]
+mod docker_stub;
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/scripted_edge.rs"]
+mod scripted_edge;
+
+use std::path::Path;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use docker_stub::DockerStub;
+use fake_provider::{engine_config, start_engine};
+use scripted_edge::{ScriptedEdge, USER};
+use serde_json::{Value, json};
+use zeron_engine::EngineRuntime;
+use zeron_engine::sandboxes::KeySlot;
+use zeron_engine::sandboxes::docker::{DockerProvider, DockerUrls};
+use zeron_rpc::{RpcClient, memory_client, methods};
+
+const ORG: &str = "org_home";
+
+/// A device with Docker Sandbox built in, talking to `stub`.
+async fn device(dir: &Path, edge: &ScriptedEdge, stub: &DockerStub) -> EngineRuntime {
+    std::fs::create_dir_all(dir).unwrap();
+    let session = json!({
+        "refreshToken": edge.seed_session(ORG),
+        "user": { "id": USER, "email": "u@example.com" },
+        "orgId": ORG,
+    });
+    std::fs::write(dir.join("session.json"), session.to_string()).unwrap();
+    let runtime = start_engine(&engine_config(dir, &edge.url, None)).await;
+    let docker = DockerProvider::with_urls(KeySlot::open(dir, "docker"), DockerUrls::all(&stub.url));
+    runtime.core().sandboxes.register(Arc::new(docker));
+    runtime
+}
+
+/// Docker as `rpc`'s device lists it.
+async fn docker_on(rpc: &RpcClient) -> Value {
+    let listed = rpc
+        .call(methods::LIST_SANDBOX_PROVIDERS, json!({}))
+        .await
+        .expect("ListSandboxProviders");
+    listed
+        .as_array()
+        .and_then(|list| list.iter().find(|p| p["id"] == "docker"))
+        .cloned()
+        .expect("Docker is listed")
+}
+
+/// Wait until Docker's row on `rpc`'s device passes `done`.
+async fn until(rpc: &RpcClient, done: impl Fn(&Value) -> bool) -> Value {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        let row = docker_on(rpc).await;
+        if done(&row) {
+            return row;
+        }
+        assert!(Instant::now() < deadline, "never: {row:#}");
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+}
+
+/// The page's code, from `ConnectSandboxProvider` without a token.
+async fn sign_in_on_page(rpc: &RpcClient) -> Value {
+    let answer = rpc
+        .call(methods::CONNECT_SANDBOX_PROVIDER, json!({ "provider": "docker" }))
+        .await
+        .expect("ConnectSandboxProvider");
+    answer["deviceCode"].clone()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_sign_in_docker_refuses_says_why_with_its_code() {
+    let edge = ScriptedEdge::with_registry().await;
+    let stub = DockerStub::start().await;
+    stub.state().refuse_device = Some("access_denied".into());
+    let dir = tempfile::tempdir().unwrap();
+    let laptop = device(dir.path(), &edge, &stub).await;
+    let rpc = memory_client(laptop.core().rpc_service());
+
+    let code = sign_in_on_page(&rpc).await;
+    assert_eq!(code["userCode"], "ABCD-EFGH");
+    // While it waits, it says so.
+    let waiting = docker_on(&rpc).await;
+    assert_eq!(waiting["connect"]["userCode"], "ABCD-EFGH", "{waiting:#}");
+
+    let ended = until(&rpc, |row| row["connect"]["error"].is_string()).await;
+    assert_eq!(ended["connect"]["userCode"], "ABCD-EFGH");
+    let error = ended["connect"]["error"].as_str().unwrap();
+    assert!(error.contains("Docker didn't sign in"), "{error}");
+    assert!(ended["account"].is_null(), "{ended:#}");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_code_that_runs_out_says_so() {
+    let edge = ScriptedEdge::with_registry().await;
+    let stub = DockerStub::start().await;
+    {
+        let mut state = stub.state();
+        state.pending_polls = 1_000;
+        state.code_life = 2;
+    }
+    let dir = tempfile::tempdir().unwrap();
+    let laptop = device(dir.path(), &edge, &stub).await;
+    let rpc = memory_client(laptop.core().rpc_service());
+
+    sign_in_on_page(&rpc).await;
+    let ended = until(&rpc, |row| row["connect"]["error"].is_string()).await;
+    let error = ended["connect"]["error"].as_str().unwrap();
+    assert!(error.contains("expired"), "{error}");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn an_approved_sign_in_connects_and_leaves_nothing_waiting() {
+    let edge = ScriptedEdge::with_registry().await;
+    let stub = DockerStub::start().await;
+    let dir = tempfile::tempdir().unwrap();
+    let laptop = device(dir.path(), &edge, &stub).await;
+    let rpc = memory_client(laptop.core().rpc_service());
+
+    sign_in_on_page(&rpc).await;
+    let connected = until(&rpc, |row| !row["account"].is_null()).await;
+    assert_eq!(connected["account"]["name"], "vu-test");
+    assert!(connected.get("connect").is_none(), "{connected:#}");
+    let host = rpc
+        .call(methods::SANDBOX_HOST, json!({ "provider": "docker" }))
+        .await
+        .expect("SandboxHost");
+    assert_eq!(host["hostDeviceId"], laptop.core().device_id.as_str(), "{host:#}");
+}
+
+/// The Laptop's sign-in on 2026-11-17: the registry still named, as
+/// Docker's host device, one the account no longer has (from testing the
+/// day before). The key was sent there, never taken, and forgotten here,
+/// and the page asked that device forever. A host device that's gone is
+/// none: this one keeps the key.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_host_device_the_account_no_longer_has_is_none() {
+    let edge = ScriptedEdge::with_registry().await;
+    let stub = DockerStub::start().await;
+    let dir = tempfile::tempdir().unwrap();
+    let laptop = device(dir.path(), &edge, &stub).await;
+    let me = laptop.core().device_id.clone();
+    let rpc = memory_client(laptop.core().rpc_service());
+    // (The device list is here: it names this device.)
+    let deadline = Instant::now() + Duration::from_secs(30);
+    while !laptop.core().workspace.watch_devices().borrow().iter().any(|d| d.id == me) {
+        assert!(Instant::now() < deadline, "this device never listed itself");
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    laptop.core().workspace.set_sandbox_host(&zeron_proto::SandboxHost {
+        provider: "docker".into(),
+        host_device_id: "062cdf75-gone".into(),
+        connected_on: Some("062cdf75-gone".into()),
+    });
+
+    sign_in_on_page(&rpc).await;
+    let connected = until(&rpc, |row| !row["account"].is_null() || row["connect"]["error"].is_string()).await;
+    assert!(connected.get("connect").is_none(), "{connected:#}");
+    assert_eq!(connected["account"]["name"], "vu-test");
+    let host = rpc
+        .call(methods::SANDBOX_HOST, json!({ "provider": "docker" }))
+        .await
+        .expect("SandboxHost");
+    assert_eq!(host["hostDeviceId"], me.as_str(), "{host:#}");
+    assert_eq!(host["connectedOn"], me.as_str(), "{host:#}");
+}
