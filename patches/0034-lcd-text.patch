+-- `value` ("#rrggbbaa" or "#rgba") with its alpha dropped, for a window with
+-- no glass under it (ds/material's solid theme); nil where there's nothing
+-- to drop: opaque already, a `$token`, not a colour written so.
+function M.opaque(value: any): string?
+	if type(value) ~= "string" then
+		return nil
+	end
+	local rgb, alpha = string.match(value, "^(#%x%x%x%x%x%x)(%x%x)$")
+	if not rgb then
+		local r, g, b, a = string.match(value, "^#(%x)(%x)(%x)(%x)$")
+		if r then
+			rgb, alpha = "#" .. r .. r .. g .. g .. b .. b, a .. a
+		end
+	end
+	if not rgb or string.lower(alpha :: string) == "ff" then
+		return nil
+	end
+	return rgb
+end
+
 return M
