diff --git a/apps/zgx/ui/tests/material_solid.test.luau b/apps/zgx/ui/tests/material_solid.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..ca9f52761e60de47f86e804ae28d191abcec2855
--- /dev/null
+++ b/apps/zgx/ui/tests/material_solid.test.luau
@@ -0,0 +1,25 @@
+-- A solid window (ds/material: frosted off, or the system's transparency
+-- off) has no glass under it (ui/app.luau drops it), so its own fill is
+-- whole (ds/glass_tint `opaque`): the themes' translucent `background`
+-- (72-80%) would show the desktop through unblurred, and only a window
+-- cleared opaque draws its text for an LCD screen's subpixels.
+
+local glass_tint = require("@ds/glass_tint")
+
+test("Material: a solid window's background, its colour's alpha dropped", function()
+	-- Zeron dark's and light's backgrounds.
+	expect(glass_tint.opaque("#0b0b0dcc")).to_be("#0b0b0d")
+	expect(glass_tint.opaque("#f5f5f7b8")).to_be("#f5f5f7")
+	expect(glass_tint.opaque("#ABCDEF80")).to_be("#ABCDEF")
+	-- The short form.
+	expect(glass_tint.opaque("#abc8")).to_be("#aabbcc")
+end)
+
+test("Material: nothing to drop, nothing changed", function()
+	expect(glass_tint.opaque("#0b0b0dff")).to_be_nil()
+	expect(glass_tint.opaque("#0b0b0dFF")).to_be_nil()
+	expect(glass_tint.opaque("#0b0b0d")).to_be_nil()
+	expect(glass_tint.opaque("$zeron.menu.solid")).to_be_nil()
+	expect(glass_tint.opaque(nil)).to_be_nil()
+	expect(glass_tint.opaque(3)).to_be_nil()
+end)
