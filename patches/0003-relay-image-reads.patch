+/// Chunk reads in flight at once after the first. Over the relay each read is
+/// a round trip (~100 ms between two networks), so one at a time made a 1 MB
+/// image 23 waits in a row.
+const READ_CONCURRENCY: usize = 8;
+/// Tries per chunk after the first: a relay link that drops mid-image costs
+/// a retry, not the image.
+const READ_CHUNK_ATTEMPTS: u32 = 3;
+
+/// One `{name, mimeType, data, nextOffset, done, size?}` reply. `size` is
+/// absent from engines older than the field.
+struct ReadChunk {
+    name: String,
+    mime: String,
+    data: String,
+    next_offset: u64,
+    done: bool,
+    size: Option<u64>,
+}
+
+impl ReadChunk {
+    fn parse(reply: &serde_json::Value) -> Option<Self> {
+        Some(Self {
+            name: reply.get("name")?.as_str()?.to_string(),
+            mime: reply.get("mimeType")?.as_str()?.to_string(),
+            data: reply.get("data")?.as_str()?.to_string(),
+            next_offset: reply.get("nextOffset")?.as_u64()?,
+            done: reply.get("done")?.as_bool()?,
+            size: reply.get("size").and_then(|size| size.as_u64()),
+        })
+    }
+}
