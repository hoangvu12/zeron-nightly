+    /// A host answering in 45 000-byte chunks, slowly enough for reads to
+    /// overlap, failing the offsets in `drops` once each (`u32::MAX` times
+    /// for those in `dead`).
+    struct ChunkedRpc {
+        bytes: Vec<u8>,
+        sends_size: bool,
+        drops: Mutex<Vec<u64>>,
+        dead: Vec<u64>,
+        offsets: Mutex<Vec<u64>>,
+        in_flight: std::sync::atomic::AtomicUsize,
+        peak: std::sync::atomic::AtomicUsize,
+    }
+
+    impl ChunkedRpc {
+        fn new(bytes: Vec<u8>, sends_size: bool, drops: Vec<u64>, dead: Vec<u64>) -> Self {
+            Self {
+                bytes,
+                sends_size,
+                drops: Mutex::new(drops),
+                dead,
+                offsets: Mutex::new(vec![]),
+                in_flight: Default::default(),
+                peak: Default::default(),
+            }
+        }
+    }
+
+    #[async_trait::async_trait]
+    impl zeron_rpc::RpcService for ChunkedRpc {
+        async fn handle(
+            &self,
+            _: &str,
+            params: serde_json::Value,
+        ) -> Result<zeron_rpc::RpcReply, zeron_rpc::RpcError> {
+            use std::sync::atomic::Ordering::SeqCst;
+            let offset = params["offset"].as_u64().unwrap();
+            self.offsets.lock().unwrap().push(offset);
+            let now = self.in_flight.fetch_add(1, SeqCst) + 1;
+            self.peak.fetch_max(now, SeqCst);
+            tokio::time::sleep(Duration::from_millis(5)).await;
+            self.in_flight.fetch_sub(1, SeqCst);
+            let dropped = {
+                let mut drops = self.drops.lock().unwrap();
+                let at = drops.iter().position(|dropped| *dropped == offset);
+                at.map(|at| drops.remove(at)).is_some()
+            };
+            if dropped || self.dead.contains(&offset) {
+                return Err(zeron_rpc::RpcError::Failed("link dropped".into()));
+            }
+            let size = self.bytes.len() as u64;
+            let start = offset.min(size);
+            let next = (start + 45_000).min(size);
+            let mut reply = serde_json::json!({
+                "name": "shot.png",
+                "mimeType": "image/png",
+                "data": BASE64.encode(&self.bytes[start as usize..next as usize]),
+                "nextOffset": next,
+                "done": next >= size,
+            });
+            if self.sends_size {
+                reply["size"] = size.into();
+            }
+            zeron_rpc::RpcReply::value(&reply)
+        }
+    }
+
+    #[tokio::test]
+    async fn chunks_are_read_several_at_a_time_and_retried_when_dropped() {
+        use std::sync::atomic::Ordering::SeqCst;
+        let executor = gpui_platform::background_executor();
+        let bytes: Vec<u8> = (0..1_000_000u32).map(|i| (i % 251) as u8).collect();
+        let chunks = bytes.len().div_ceil(45_000);
+        for sends_size in [true, false] {
+            let host = Arc::new(ChunkedRpc::new(
+                bytes.clone(),
+                sends_size,
+                vec![90_000],
+                vec![],
+            ));
+            let engine = EngineHandle::from_test_client(zeron_rpc::memory_client(host.clone()));
+            let (_, _, read) =
+                read_attachment_bytes(&engine, &executor, Some("pc"), "/a.png", None)
+                    .await
+                    .unwrap();
+            assert_eq!(read, bytes, "sends_size: {sends_size}");
+            let offsets = host.offsets.lock().unwrap().clone();
+            // Every chunk once, the dropped one twice; without a size, at
+            // most a window's worth of reads run past the end.
+            let extra = offsets.len() - (chunks + 1);
+            if sends_size {
+                assert_eq!(extra, 0);
+            } else {
+                assert!(extra < READ_CONCURRENCY, "{extra} reads past the end");
+            }
+            let peak = host.peak.load(SeqCst);
+            assert!((2..=READ_CONCURRENCY).contains(&peak), "peak {peak}");
+        }
+
+        // A chunk that never arrives fails the image rather than tearing it.
+        let host = Arc::new(ChunkedRpc::new(bytes.clone(), true, vec![], vec![450_000]));
+        let engine = EngineHandle::from_test_client(zeron_rpc::memory_client(host.clone()));
+        assert!(
+            read_attachment_bytes(&engine, &executor, None, "/a.png", None)
+                .await
+                .is_none()
+        );
+        let offsets = host.offsets.lock().unwrap();
+        assert_eq!(
+            offsets.iter().filter(|offset| **offset == 450_000).count(),
+            READ_CHUNK_ATTEMPTS as usize
+        );
+    }
+
