--- a/crates/engine/src/reply_images.rs
+++ b/crates/engine/src/reply_images.rs
@@ -260,6 +260,7 @@ pub(crate) fn read_chunk(
         data: BASE64.encode(&buf),
         next_offset,
         done: next_offset >= size,
+        size,
     })
 }
 
