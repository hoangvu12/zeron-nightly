diff --git a/apps/zgx/src/key_confirm.rs b/apps/zgx/src/key_confirm.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b7a8e7bf96cd33363e27e63d02015bd2bf9ec9c
--- /dev/null
+++ b/apps/zgx/src/key_confirm.rs
@@ -0,0 +1,170 @@
+//! Settings → Account's "Confirm it's you" for this device's signing key
+//! (ui/screens/settings/signing_keys.luau). A device signed in from before
+//! keys existed, or whose key the edge refused for want of a fresh
+//! sign-in, has no key on the account: other devices refuse its direct
+//! road and the plugins it makes go unsigned. Confirming signs in again as
+//! the same account (the engine's `StepUp` page, in the browser); when that
+//! lands, the engine registers the key with the step-up's ticket. The
+//! ticket stays in the engine: this side only watches `PluginSigningKey`.
+//! No sign-out, and the session stays as it is.
+//!
+//!   account.confirm_key           the sign-in page opened, then waited on
+//!                                 until the key registers: true; rejects
+//!                                 cancelled (account.cancel_confirm_key),
+//!                                 timed_out, failed (the registration
+//!                                 after it failed), step_up_refused (the
+//!                                 sign-in wasn't this account's), or an
+//!                                 engine outcome
+//!   account.cancel_confirm_key    stops waiting for that sign-in
+
+use serde_json::{Value as Json, json};
+use zgx_script::{ScriptHost, Value};
+
+use crate::engine;
+
+type Outcome = &'static str;
+
+pub fn install(host: &ScriptHost) {
+    host.async_action("account.confirm_key", |_| async {
+        crate::plugins::preview::refuse("account.confirm_key")?;
+        confirm_key().await.map(|()| Value::Bool(true)).map_err(String::from)
+    });
+    host.action("account.cancel_confirm_key", |_| {
+        CONFIRM.with(|n| n.set(n.get() + 1));
+    });
+}
+
+/// What `account.signing_keys` passes on about this device's own key, from
+/// `PluginSigningKey`'s answer: whether it's registered, and if not, why
+/// (`register_error`: `step_up_required` or `failed`, with its words).
+pub(crate) fn own_key(answer: &Json, into: &mut Json) {
+    for field in ["registered", "register_error", "register_message"] {
+        if let Some(value) = answer.get(field).filter(|value| !value.is_null()) {
+            into[field] = value.clone();
+        }
+    }
+}
+
+thread_local! {
+    /// Which wait for a confirm is the live one: cancelling moves it on.
+    static CONFIRM: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+/// As long as the engine keeps a step-up's ticket (10 minutes at most),
+/// asked about every second (each ask is the engine's alone).
+const CONFIRM_WAIT: std::time::Duration = std::time::Duration::from_secs(10 * 60);
+const CONFIRM_EVERY: std::time::Duration = std::time::Duration::from_secs(1);
+
+/// `verify`: the edge asked whether the key is the account's (this
+/// device's file can be stale), not the file alone.
+async fn key_status(verify: bool) -> Result<Json, Outcome> {
+    engine::get()
+        .call("PluginSigningKey", json!({ "verify": verify }))
+        .await
+        .map_err(|error| engine::outcome(&error))
+}
+
+async fn confirm_key() -> Result<(), Outcome> {
+    let live = CONFIRM.with(|n| {
+        n.set(n.get() + 1);
+        n.get()
+    });
+    let start = key_status(true).await?;
+    if start["registered"].as_bool() == Some(true) {
+        return Ok(());
+    }
+    let from = start["register_attempts"].as_u64().unwrap_or(0);
+    let answer = engine::get().call("StepUp", json!({ "for": "key" })).await.map_err(|error| engine::outcome(&error))?;
+    let url = answer["url"].as_str().unwrap_or_default();
+    if !url.starts_with("https://") {
+        return Err("failed");
+    }
+    if let Err(error) = crate::auth::open_sign_in(url) {
+        eprintln!("zeron-zgx: account: the browser didn't open: {error}");
+        return Err("failed");
+    }
+    let until = std::time::Instant::now() + CONFIRM_WAIT;
+    loop {
+        zgx::timer::sleep(CONFIRM_EVERY).await;
+        if CONFIRM.with(std::cell::Cell::get) != live {
+            return Err("cancelled");
+        }
+        match progress(&key_status(false).await?, from) {
+            Progress::Registered => return Ok(()),
+            Progress::Failed(word) => return Err(word),
+            Progress::Waiting if std::time::Instant::now() < until => {}
+            Progress::Waiting => return Err("timed_out"),
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Progress {
+    Registered,
+    Waiting,
+    Failed(Outcome),
+}
+
+/// `PluginSigningKey`'s answer while a confirm is waited on, registrations
+/// tried before it numbering `from`: registered; failed, by a registration
+/// since then, or a step-up refused since then (another account's sign-in:
+/// said at once); one still wanting the step-up is waited on (the sign-in
+/// may not have landed yet); or still waiting.
+fn progress(answer: &Json, from: u64) -> Progress {
+    if answer["registered"].as_bool() == Some(true) {
+        return Progress::Registered;
+    }
+    let tried_since = answer["register_attempts"].as_u64().is_some_and(|n| n > from);
+    match answer["register_error"].as_str() {
+        Some("failed") if tried_since => Progress::Failed("failed"),
+        Some("step_up_refused") if tried_since => Progress::Failed("step_up_refused"),
+        _ => Progress::Waiting,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_confirm_waits_until_the_key_registers_and_says_a_failure_after_it() {
+        // Still wanting the step-up (it hasn't landed): waited on.
+        let refused = json!({ "registered": false, "register_error": "step_up_required", "register_attempts": 1 });
+        assert_eq!(progress(&refused, 1), Progress::Waiting);
+        assert_eq!(progress(&json!({ "registered": false, "register_error": "step_up_required", "register_attempts": 2 }), 1), Progress::Waiting);
+        // A failure from before the confirm isn't this one's.
+        let failed = json!({ "registered": false, "register_error": "failed", "register_message": "HTTP 500", "register_attempts": 3 });
+        assert_eq!(progress(&failed, 3), Progress::Waiting);
+        // One after it is, and never reads as done.
+        assert_eq!(progress(&failed, 2), Progress::Failed("failed"));
+        assert_eq!(progress(&json!({ "registered": true, "register_attempts": 4 }), 3), Progress::Registered);
+        assert_eq!(progress(&json!({}), 0), Progress::Waiting);
+    }
+
+    /// Security review 9, L3: a sign-in again as another account (or one
+    /// without a ticket) left the wait going ten minutes.
+    #[test]
+    fn a_refused_step_up_ends_the_wait_at_once() {
+        let refused = json!({ "registered": false, "register_error": "step_up_refused", "register_attempts": 3 });
+        assert_eq!(progress(&refused, 2), Progress::Failed("step_up_refused"));
+        assert_eq!(progress(&refused, 3), Progress::Waiting, "one from before isn't this one's");
+    }
+
+    #[test]
+    fn the_signing_keys_say_whether_this_devices_key_is_registered_and_why_not() {
+        let mut read = json!({ "keys": [], "new_keys": [] });
+        own_key(&json!({ "key": "k1", "registered": false, "register_error": "step_up_required", "register_message": "Confirm it's you" }), &mut read);
+        assert_eq!(read["registered"], false);
+        assert_eq!(read["register_error"], "step_up_required");
+        assert_eq!(read["register_message"], "Confirm it's you");
+        assert_eq!(read["keys"], json!([]), "the rest kept");
+        let mut read = json!({});
+        own_key(&json!({ "key": "k1", "registered": true }), &mut read);
+        assert_eq!(read["registered"], true);
+        assert!(read.get("register_error").is_none_or(Json::is_null));
+        // An engine from before: nothing said, so nothing offered.
+        let mut read = json!({});
+        own_key(&json!({ "key": "k1" }), &mut read);
+        assert!(read.get("registered").is_none_or(Json::is_null));
+    }
+}
