diff --git a/apps/zgx/ui/tests/key_confirm.test.luau b/apps/zgx/ui/tests/key_confirm.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..2c58dfa4c57827f7de945406dcf5e5cf21e8c3e5
--- /dev/null
+++ b/apps/zgx/ui/tests/key_confirm.test.luau
@@ -0,0 +1,89 @@
+-- Settings → Account's "Confirm it's you" for this computer's signing key
+-- (screens/settings/key_confirm.luau): offered only while the engine says
+-- the key isn't on the account, and why; confirming waits on the sign-in
+-- again in the browser, then the key is registered, with no sign-out. On
+-- the shell in ui/shell_fixture.luau, its host calls answered by
+-- ui/settings_stub.luau.
+
+local PAGE = "#settings-page"
+local NAV = "#settings-nav"
+
+local function shows(app: any, scope: string, text: string): boolean
+	return app:tree(scope):find(text, 1, true) ~= nil
+end
+
+local function asked(app: any, entry: string): boolean
+	for _, c in (app:state("settings_stub_calls") :: any) or {} do
+		if c == entry then
+			return true
+		end
+	end
+	return false
+end
+
+-- Settings → Account, this computer's key `own` ("registered",
+-- "step_up_required", "failed"), scrolled to the signing keys.
+local function open(own: string): any
+	local app = mount("shell_fixture.luau")
+	app:resize(1200, 900)
+	app:frames(30)
+	app:set_state("settings_stub_own_key", own)
+	app:command("settings_stub.sign_in")
+	app:command("shell.settings")
+	app:frames(20)
+	app:click(`{NAV} >> role:tab "Account"`)
+	app:frames(30)
+	app:scroll(PAGE, 2000)
+	app:frames(10)
+	return app
+end
+
+local UNREGISTERED = "This computer's key isn't on your account"
+
+test("a key the account refused offers Confirm it's you, and once signed in again it's registered", function()
+	local app = open("step_up_required")
+	expect(shows(app, PAGE, UNREGISTERED)).to_be(true)
+	expect(shows(app, PAGE, "Confirm it's you to add it.")).to_be(true)
+	app:click(`{PAGE} >> role:button "Confirm it's you"`)
+	app:frames(10)
+	expect(asked(app, "account.confirm_key")).to_be(true)
+	expect(shows(app, PAGE, "Waiting for you to sign in again in your browser")).to_be(true)
+	-- The sign-in lands: the engine registers the key; the row goes.
+	app:command("settings_stub.signed_in_again")
+	app:frames(30)
+	expect(shows(app, PAGE, UNREGISTERED)).to_be(false)
+	expect(asked(app, "account.sign_out")).to_be(false)
+end)
+
+test("a registration that failed says why, and a confirm can be cancelled", function()
+	local app = open("failed")
+	expect(shows(app, PAGE, "It couldn't be added: plugin-keys register: HTTP 500")).to_be(true)
+	app:click(`{PAGE} >> role:button "Confirm it's you"`)
+	app:frames(10)
+	app:click(`{PAGE} >> role:button "Cancel"`)
+	app:frames(20)
+	expect(asked(app, "account.cancel_confirm_key")).to_be(true)
+	-- Still not on the account: still offered.
+	expect(shows(app, PAGE, UNREGISTERED)).to_be(true)
+	expect(app:has(`{PAGE} >> role:button "Confirm it's you"`)).to_be(true)
+end)
+
+-- Security review 9, L3: a sign-in again as another account ended the wait
+-- only after ten minutes.
+test("a sign-in again as another account is said at once, and Confirm offered again", function()
+	local app = open("step_up_required")
+	app:click(`{PAGE} >> role:button "Confirm it's you"`)
+	app:frames(10)
+	app:command("settings_stub.signed_in_as_another")
+	app:frames(20)
+	expect(app:has('"That sign-in didn\'t confirm it\'s you. Sign in again as the account using Zeron here, then try again."')).to_be(true)
+	expect(shows(app, PAGE, "Waiting for you to sign in again")).to_be(false)
+	expect(app:has(`{PAGE} >> role:button "Confirm it's you"`)).to_be(true)
+	expect(asked(app, "account.sign_out")).to_be(false)
+end)
+
+test("a registered key offers nothing", function()
+	local app = open("registered")
+	expect(shows(app, PAGE, "Signing keys")).to_be(true)
+	expect(shows(app, PAGE, UNREGISTERED)).to_be(false)
+end)
