+/// Security review 9, L3: a step-up refused (another account) or bringing
+/// no ticket changed nothing the desktop could see, so it waited ten
+/// minutes. It's said at once.
+#[tokio::test]
+async fn the_desktop_hears_at_once_when_a_step_up_is_refused() {
+    let edge = StubEdge::start().await;
+    let dir = tempfile::tempdir().expect("tempdir");
+    std::fs::write(dir.path().join("device-id"), "device-desk").unwrap();
+    let auth = persisted_auth(&edge, dir.path());
+    let core = engine_on(dir.path(), &auth);
+    let said = |want: &'static str| {
+        let core = &core;
+        async move {
+            tokio::time::timeout(Duration::from_secs(3), async {
+                loop {
+                    let status = signing_key_status(core).await;
+                    if status["register_error"] == want {
+                        return status;
+                    }
+                    tokio::time::sleep(Duration::from_millis(20)).await;
+                }
+            })
+            .await
+            .unwrap_or_else(|_| panic!("{want} said in time"))
+        }
+    };
+    let refused = said("step_up_required").await;
+    let step_up = |auth: Auth| async move {
+        let url = auth.start_step_up_for_key().await.expect("a step-up");
+        let callback = query_param(&url, "redirect_uri").unwrap().replace("%3A", ":").replace("%2F", "/");
+        let state = query_param(&url, "state").unwrap();
+        let _ = reqwest::get(format!("{callback}?code=abc&state={state}")).await.expect("callback");
+    };
+    // Signed in again as someone else.
+    *edge.state.exchange_user.lock().unwrap() = "user_2".into();
+    step_up(auth.clone()).await;
+    let other = said("step_up_refused").await;
+    assert!(other["register_message"].as_str().unwrap().contains("another account"), "{other}");
+    assert!(other["register_attempts"].as_u64() > refused["register_attempts"].as_u64());
+    // Signed in, but the edge gave no ticket.
+    *edge.state.exchange_user.lock().unwrap() = String::new();
+    edge.state.exchange_no_ticket.store(true, Ordering::SeqCst);
+    step_up(auth.clone()).await;
+    let none = tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            let status = signing_key_status(&core).await;
+            if status["register_attempts"].as_u64() > other["register_attempts"].as_u64() {
+                return status;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .expect("said in time");
+    assert_eq!(none["register_error"], "step_up_refused", "{none}");
+    assert_eq!(none["registered"], false);
+}
