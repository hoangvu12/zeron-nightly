+-- Settings → Account's "Confirm it's you" for this computer's signing key
+-- (src/key_confirm.rs). Shown only while the engine says the key isn't on
+-- the account, and why (`account.signing_keys`' `register_error`): the
+-- edge wanted a fresh sign-in ("step_up_required"), or registering failed
+-- ("failed", its words shown), or a sign-in again didn't confirm it's the
+-- person ("step_up_refused": another account's). Confirming opens the sign-in page in the
+-- browser; once that lands the engine registers the key with it. Waiting,
+-- it can be cancelled. You stay signed in throughout.
+--
+--   confirm.heard(answer)   what `account.signing_keys` said about this
+--                           computer's own key
+--   confirm.row(reload)     the row, for the signing keys section
+--                           (`reload`: ask for the keys again)
+
+local host = require("@app/screens/settings/host")
+local ds = require("@ds")
+local toast = require("@ds/toast")
+local store = require("@app/screens/settings/store")
+
+local M = {}
+
+-- "" (registered, or nothing said) | "step_up_required" | "failed"
+-- | "step_up_refused"
+M.error = ui.state("settings_own_key_error", "")
+M.message = ui.state("settings_own_key_message", "")
+-- Waiting on the sign-in again.
+M.confirming = ui.state("settings_own_key_confirming", false)
+
+function M.heard(answer: any)
+	local err = if answer.registered == false then (answer.register_error or "") else ""
+	ui.batch(function()
+		M.error:set(err)
+		M.message:set(answer.register_message or "")
+	end)
+end
+
+local function said(err: any): string
+	return if type(err) == "table" or type(err) == "userdata" then err.message else tostring(err)
+end
+
+local function confirm(reload: () -> ())
+	if M.confirming:peek() then
+		return
+	end
+	M.confirming:set(true)
+	host.call("account.confirm_key"):after(function()
+		ui.batch(function()
+			M.confirming:set(false)
+			M.error:set("")
+			M.message:set("")
+		end)
+		toast.show { title = ui.t("settings.profile.keys.confirmed"):get(), tone = "success" }
+		reload()
+	end, function(err: any)
+		M.confirming:set(false)
+		local word = said(err)
+		if word == "cancelled" then
+			return
+		end
+		toast.show {
+			title = ui.t("settings.profile.keys.confirm_failed"):get(),
+			body = if word == "timed_out"
+				then ui.t("settings.profile.keys.confirm_timed_out"):get()
+				elseif word == "step_up_refused" then ui.t("settings.profile.keys.step_up_refused"):get()
+				else store.says(word),
+			tone = "danger",
+		}
+		reload()
+	end)
+end
+
+function M.row(reload: () -> ()): Node
+	return ui.show(
+		function(): boolean
+			return M.error:get() ~= ""
+		end,
+		ds.Settings.Group {
+			ds.Settings.Row {
+				icon = "shield-check",
+				label = ui.t("settings.profile.keys.unregistered"),
+				description = function(): string
+					if M.confirming:get() then
+						return ui.t("settings.profile.keys.confirming"):get()
+					elseif M.error:get() == "failed" then
+						return ui.t("settings.profile.keys.unregistered_failed", { why = M.message:get() }):get()
+					elseif M.error:get() == "step_up_refused" then
+						return ui.t("settings.profile.keys.step_up_refused"):get()
+					end
+					return ui.t("settings.profile.keys.unregistered_step_up"):get()
+				end,
+				control = ui.row {
+					gap = "$space.2",
+					items = "center",
+					ui.show(
+						function(): boolean
+							return not M.confirming:get()
+						end,
+						ds.Button {
+							ui.t("settings.profile.keys.confirm"),
+							tone = "primary",
+							size = "sm",
+							on_click = function()
+								confirm(reload)
+							end,
+						}
+					),
+					ui.show(
+						function(): boolean
+							return M.confirming:get()
+						end,
+						ds.Button {
+							ui.t("settings.profile.keys.confirm_cancel"),
+							tone = "ghost",
+							size = "sm",
+							on_click = function()
+								host.invoke("account.cancel_confirm_key")
+							end,
+						}
+					),
+				},
+			},
+		}
+	)
+end
+
+return M
