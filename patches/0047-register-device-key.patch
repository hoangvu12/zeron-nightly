+/// Security review 10, N3: any ticket held could delete the account: one a
+/// key's step-up (or a sign-in) brought and no registration used up. Only
+/// a step-up begun for deleting can.
+#[tokio::test]
+async fn only_a_step_up_for_deleting_can_delete_the_account() {
+    use zeron_engine::auth::DeleteAccountError;
+    let edge = StubEdge::start().await;
+    let dir = tempfile::tempdir().expect("tempdir");
+    let auth = persisted_auth(&edge, dir.path());
+    let land = |url: String| async move {
+        let callback = query_param(&url, "redirect_uri").unwrap().replace("%3A", ":").replace("%2F", "/");
+        let state = query_param(&url, "state").unwrap();
+        let _ = reqwest::get(format!("{callback}?code=abc&state={state}")).await.expect("callback");
+    };
+    // "Confirm it's you" landed; no engine here to register with it.
+    land(auth.start_step_up_for_key().await.expect("a step-up")).await;
+    assert!(auth.step_up().is_some(), "held, for the key");
+    let refused = auth.delete_account("w@example.com").await;
+    assert!(matches!(refused, Err(DeleteAccountError::StepUpRequired)), "{refused:?}");
+    assert!(edge.state.deletions.lock().unwrap().is_empty(), "nothing sent to delete with");
+    assert!(auth.step_up().is_some(), "still the key's");
+    // Signed in again to delete: that one does.
+    land(auth.start_step_up().await.expect("a step-up")).await;
+    auth.delete_account("w@example.com").await.expect("deleted");
+    assert_eq!(*edge.state.deletions.lock().unwrap(), vec!["ticket-2".to_string()]);
+}
