+/// Security review 9, M1: "registered" came from this device's own file, so
+/// a key revoked from another device read as registered. The edge is asked:
+/// only a key it calls this account's and live counts; anything else has
+/// its file cleared and is registered again (a revoked one replaced, and
+/// the plugins it signed owed a re-sign, L1).
+#[tokio::test]
+async fn zeron_login_asks_the_edge_before_calling_a_key_registered() {
+    use zeron_engine::device_key::{self, DeviceKey};
+    use zeron_engine::plugins::{keys, signing};
+    let edge = StubEdge::start().await;
+    *edge.state.exchange_org.lock().expect("lock") = "org_1".into();
+    let dir = tempfile::tempdir().expect("tempdir");
+    std::fs::write(dir.path().join("device-id"), "device-box").unwrap();
+    let auth = Auth::new(workos_config(&edge.url(), dir.path()));
+    paste_sign_in(&auth).await;
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::Registered);
+    let first = signing::load_key(dir.path()).unwrap().public();
+    let posts = || edge.state.plugin_keys.lock().unwrap().len();
+    assert_eq!(posts(), 1);
+    // This device's file lost, the key still the account's: the edge's
+    // word is enough, and the file is made again. Nothing registered anew.
+    std::fs::remove_file(dir.path().join(keys::REGISTRATION_FILE)).unwrap();
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::AlreadyRegistered);
+    assert_eq!(posts(), 1);
+    assert!(device_key::is_registered(&auth, dir.path()));
+    drop(auth);
+
+    // Revoked from the laptop while this box's engine was off.
+    edge.state.revoked_keys.lock().unwrap().push(first.clone());
+    let auth = Auth::new(workos_config(&edge.url(), dir.path()));
+    assert_eq!(
+        device_key::register(&auth, dir.path()).await,
+        DeviceKey::NeedsConfirm,
+        "a revoked key never reads as registered"
+    );
+    assert!(!device_key::is_registered(&auth, dir.path()));
+    let second = signing::load_key(dir.path()).unwrap().public();
+    assert_ne!(second, first, "a new key, the revoked one never used again");
+    assert!(keys::resign_owed(dir.path()), "the plugins the old key signed are owed a re-sign");
+    assert_eq!(
+        keys::owed_revocations(dir.path()),
+        vec![first.clone()],
+        "and the revocation owed its answer at the next engine start (review 10, N1)"
+    );
+    // Confirmed: the new key registers.
+    let url = auth.start_headless_step_up().expect("a step-up");
+    let state = query_param(&url, "state").expect("state");
+    auth.complete_sign_in(&format!("{state}.code123")).await.expect("step-up");
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::Registered);
+    let last = edge.state.plugin_keys.lock().unwrap().last().cloned().unwrap();
+    assert_eq!((last["key"].as_str(), last["stepUp"].as_str()), (Some(second.as_str()), Some("ticket-2")));
+    assert!(auth.step_up().is_none(), "the ticket is let go once the key is registered");
+}
