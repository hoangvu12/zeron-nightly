+    tokio::join!(f.plugins.own_key_revoked(&newer_from), f.plugins.own_key_revoked(&newer_from));
+    let newer = signing::load_key(&f.data).unwrap().public();
+    assert_ne!(newer, newer_from);
+    assert!(keys::Registration::load(&f.data).covers(&newer, "user-1"), "the key left is the one registered");
+    // Review 11, L2: compared and deleted under one hold.
+    assert!(!signing::delete_key_if(&f.data, &old), "another key isn't deleted");
+    assert_eq!(signing::load_key(&f.data).unwrap().public(), newer);
+    assert!(signing::delete_key_if(&f.data, &newer));
+    assert!(signing::load_key(&f.data).is_none());
+}
