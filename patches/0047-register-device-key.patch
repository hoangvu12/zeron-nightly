+/// [`delete_key`] only while the key is `public`, checked and deleted
+/// under one hold: one replaced meanwhile is kept. Whether it was deleted.
+pub fn delete_key_if(data_dir: &Path, public: &str) -> bool {
+    let _held = KEY_LOCK.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    if !load_key(data_dir).is_some_and(|key| key.public() == public) {
+        return false;
+    }
+    match delete_locked(data_dir) {
+        Ok(()) => true,
+        Err(error) => {
+            tracing::warn!(%error, "plugins: couldn't delete the old signing key");
+            false
+        }
+    }
+}
