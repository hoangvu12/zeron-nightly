diff --git a/apps/zeron/src/key_cli.rs b/apps/zeron/src/key_cli.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0cd12f7a878594c15a512cb174cbc5034219d63a
--- /dev/null
+++ b/apps/zeron/src/key_cli.rs
@@ -0,0 +1,74 @@
+//! `zeron login`'s last step: this device's signing key registered on the
+//! account while the sign-in's ticket is in this process (memory only, so
+//! it's gone once `zeron login` exits). A device signed in from before keys
+//! existed has no ticket: it confirms it's the person first, with a
+//! paste-code step-up as the same account (`zeron login --confirm`).
+//!
+//! Without a registered key other devices refuse this one's direct road,
+//! its relay dials go unstamped, and the plugins it makes go unsigned, so a
+//! failure is said and exits non-zero: it never reads as success.
+
+use std::path::Path;
+
+use zeron_engine::Auth;
+use zeron_engine::device_key::{self, DeviceKey};
+
+/// Register this device's key, confirming it's the person first (on a
+/// terminal) when the edge wants a fresh sign-in.
+pub async fn register_device_key(auth: &Auth, data_dir: &Path, interactive: bool) -> anyhow::Result<()> {
+    let mut outcome = device_key::register(auth, data_dir).await;
+    if outcome == DeviceKey::NeedsConfirm && interactive {
+        println!(
+            "\nThis device's signing key isn't on your account yet. Confirm it's you to add it \
+             (you stay signed in as you are)."
+        );
+        if let Err(error) = device_key::terminal_confirm(auth).await {
+            anyhow::bail!(
+                "Couldn't confirm it's you: {error}\nThis device's signing key isn't registered. \
+                 Run `zeron login --confirm` to try again."
+            );
+        }
+        outcome = device_key::register(auth, data_dir).await;
+    }
+    let line = key_report(&outcome).map_err(anyhow::Error::msg)?;
+    println!("{line}");
+    Ok(())
+}
+
+/// What `zeron login` says about the key: `Ok` for a registered one,
+/// `Err` (the command fails) for anything else.
+fn key_report(outcome: &DeviceKey) -> Result<String, String> {
+    match outcome {
+        DeviceKey::Registered => Ok("This device's signing key is registered on your account now.".into()),
+        DeviceKey::AlreadyRegistered => Ok("This device's signing key is registered on your account.".into()),
+        DeviceKey::NeedsConfirm => Err(
+            "This device's signing key isn't registered: your account wants you to confirm it's you. \
+             Run `zeron login --confirm` in a terminal."
+                .into(),
+        ),
+        DeviceKey::Failed(why) => Err(format!(
+            "This device's signing key couldn't be registered: {why}\n\
+             Run `zeron login --confirm` to try again."
+        )),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_registered_key_reads_as_success() {
+        for done in [DeviceKey::Registered, DeviceKey::AlreadyRegistered] {
+            let said = key_report(&done).expect("success");
+            assert!(said.contains("signing key is registered"), "{said}");
+        }
+        let confirm = key_report(&DeviceKey::NeedsConfirm).expect_err("not registered");
+        assert!(confirm.contains("isn't registered"), "{confirm}");
+        assert!(confirm.contains("zeron login --confirm"), "{confirm}");
+        let failed = key_report(&DeviceKey::Failed("plugin-keys register: HTTP 500".into())).expect_err("not registered");
+        assert!(failed.contains("couldn't be registered"), "{failed}");
+        assert!(failed.contains("HTTP 500"), "says why: {failed}");
+        assert!(failed.contains("zeron login --confirm"), "{failed}");
+    }
+}
