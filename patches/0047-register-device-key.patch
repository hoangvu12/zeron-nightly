+/// Owed by a key replaced while no engine ran (`zeron login`): this
+/// device's own plugins re-signed with the new key at the next start.
+pub const RESIGN_FILE: &str = "plugin-keys-resign";
+
+pub fn owe_resign(data_dir: &Path) {
+    if let Err(err) = crate::runner::write_private_atomic(&data_dir.join(RESIGN_FILE), b"owed\n") {
+        tracing::warn!(error = %err, "plugins: couldn't keep a re-sign owed");
+    }
+}
+
+pub fn resign_owed(data_dir: &Path) -> bool {
+    data_dir.join(RESIGN_FILE).exists()
+}
+
+pub fn settle_resign(data_dir: &Path) {
+    let _ = std::fs::remove_file(data_dir.join(RESIGN_FILE));
+}
+
+/// Owed by a key `zeron login` found revoked (and replaced) while no
+/// engine ran: the next start answers the revocation as a running engine
+/// would (`Plugins::own_key_revoked`): the old key no longer yours, your
+/// own plugins' code-running powers asked again, and you're told. One old
+/// key per line.
+pub const REVOKED_FILE: &str = "plugin-keys-revoked-owed";
+
+pub fn owe_revocation(data_dir: &Path, key: &str) {
+    let mut owed = owed_revocations(data_dir);
+    if owed.iter().any(|k| k == key) {
+        return;
+    }
+    owed.push(key.to_owned());
+    let body = format!("{}\n", owed.join("\n"));
+    if let Err(err) = crate::runner::write_private_atomic(&data_dir.join(REVOKED_FILE), body.as_bytes()) {
+        tracing::warn!(error = %err, "plugins: couldn't keep a revocation owed");
+    }
+}
+
+pub fn owed_revocations(data_dir: &Path) -> Vec<String> {
+    std::fs::read_to_string(data_dir.join(REVOKED_FILE))
+        .map(|body| body.lines().map(str::trim).filter(|k| !k.is_empty()).map(str::to_owned).collect())
+        .unwrap_or_default()
+}
+
+pub fn settle_revocations(data_dir: &Path) {
+    let _ = std::fs::remove_file(data_dir.join(REVOKED_FILE));
+}
