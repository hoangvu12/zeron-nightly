+/// No file under `dir` holds a step-up ticket (they're memory only).
+fn no_ticket_on_disk(dir: &std::path::Path) {
+    for entry in std::fs::read_dir(dir).expect("read dir").flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            no_ticket_on_disk(&path);
+        } else if let Ok(bytes) = std::fs::read(&path) {
+            assert!(
+                !String::from_utf8_lossy(&bytes).contains("ticket-"),
+                "a step-up ticket written to {}",
+                path.display()
+            );
+        }
+    }
+}
