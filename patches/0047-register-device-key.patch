+    let auth = persisted_auth(&edge, dir.path());
+    let core = engine_on(dir.path(), &auth);
+    let refused = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let status = signing_key_status(&core).await;
+            if !status["register_error"].is_null() {
+                return status;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .expect("the refusal said");
+    assert_eq!(refused["registered"], false);
+    assert_eq!(refused["register_error"], "step_up_required", "{refused}");
+    let before = saved_account(dir.path());
+
+    // "Confirm it's you": the engine's `StepUp` page (`for: "key"`), signed
+    // in in the browser.
