+        assert_eq!(said["register_error"], "step_up_required", "{said}");
+        assert_eq!(said["register_attempts"], 1);
+        // Some other failure: said with its words, never as success.
+        fake.register_answers.lock().unwrap().push(Err(RegisterError::Other("plugin-keys register: HTTP 500".into())));
+        plugins.register_key_as("user-1").await;
+        let said = status(&plugins).await;
