+/// L2: a mistyped code used the sign-in up, with no way to try again but
+/// running the command again. A fresh sign-in is offered to try with.
+#[tokio::test]
+async fn a_mistyped_code_gets_a_fresh_sign_in_to_try_again() {
+    use zeron_engine::device_key::{self, DeviceKey};
+    let edge = StubEdge::start().await;
+    let dir = tempfile::tempdir().expect("tempdir");
+    std::fs::write(dir.path().join("device-id"), "device-box").unwrap();
+    let auth = persisted_auth(&edge, dir.path());
+    let shown: Arc<Mutex<Vec<String>>> = Arc::default();
+    let (show_into, read_from) = (shown.clone(), shown.clone());
+    let pasted = Arc::new(AtomicUsize::new(0));
+    device_key::confirm_with(
+        &auth,
+        move || {
+            let n = pasted.fetch_add(1, Ordering::SeqCst);
+            let url = read_from.lock().unwrap().last().cloned().unwrap_or_default();
+            async move {
+                Some(match n {
+                    0 => "not-the-code".to_owned(),
+                    _ => format!("{}.code123", query_param(&url, "state").expect("state")),
+                })
+            }
+        },
+        Duration::from_secs(5),
+        move |url: &str| show_into.lock().unwrap().push(url.to_owned()),
+    )
+    .await
+    .expect("confirmed on the second try");
+    assert_eq!(shown.lock().unwrap().len(), 2, "a fresh sign-in after the mistake");
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::Registered);
+}
