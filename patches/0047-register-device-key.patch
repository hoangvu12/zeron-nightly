+    assert!(
+        edge.state.plugin_keys.lock().unwrap().iter().all(|body| body["stepUp"].is_null()),
+        "no key registered with another account's ticket"
+    );
+    assert!(matches!(auth.state(), AuthState::SignedIn { user, .. } if user.id == "user_1"));
+    assert_eq!(saved_account(dir.path()).0, before.0);
