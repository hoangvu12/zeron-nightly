+    std::fs::write(dir.path().join("device-id"), "device-old").unwrap();
+    let auth = persisted_auth(&edge, dir.path());
+    let before = saved_account(dir.path());
+    *edge.state.exchange_user.lock().expect("lock") = "user_2".into();
+
+    let url = auth.start_headless_step_up().expect("a step-up");
+    let state = query_param(&url, "state").expect("state param");
+    let refused = auth.complete_sign_in(&format!("{state}.code123")).await.expect_err("another account");
+    assert!(refused.to_string().contains("another account"), "{refused}");
