+//! This device's signing key on the account, registered where the person
+//! proves a fresh sign-in.
+//!
+//! The desktop engine registers it itself (`plugins::Plugins::attach_auth`):
+//! a sign-in or a `StepUp` brings a ticket while the engine runs. `zeron
+//! login` holds the engine lock, so no engine runs then: it registers the
+//! key here with its own sign-in's ticket, before it exits and the ticket
+//! (memory only) is gone. A device signed in before keys existed confirms
+//! it's the person with a paste-code step-up (`zeron login --confirm`).
+
+use std::path::Path;
+
+use crate::Auth;
+use crate::plugins::{keys, signing};
+
+/// What became of registering this device's key.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DeviceKey {
+    /// It was registered for the account already: nothing was asked.
+    AlreadyRegistered,
+    /// Registered now.
+    Registered,
+    /// The edge wants a fresh sign-in first (a step-up).
+    NeedsConfirm,
+    /// It couldn't be registered (why).
+    Failed(String),
+}
+
+/// Whether this device's own file says its key is registered for the
+/// account signed in (the edge may say otherwise: [`register`] asks it).
+pub fn is_registered(auth: &Auth, data_dir: &Path) -> bool {
+    let Some(account) = auth.user_id() else {
+        return false;
+    };
+    signing::load_key(data_dir)
+        .is_some_and(|key| keys::Registration::load(data_dir).covers(&key.public(), &account))
+}
+
+/// What the edge says this device's key is to the account signed in.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum OnAccount {
+    /// The account's, and live.
+    Live,
+    /// The account's, revoked (from another device).
+    Revoked,
+    /// Not the account's (nobody's, or someone else's).
+    Absent,
+}
+
+pub(crate) async fn on_account(directory: &dyn keys::KeyDirectory, key: &str) -> Result<OnAccount, String> {
+    Ok(match directory.lookup(key).await? {
+        keys::Lookup::Found { mine: true, revoked: false, .. } => OnAccount::Live,
+        keys::Lookup::Found { mine: true, revoked: true, .. } => OnAccount::Revoked,
+        _ => OnAccount::Absent,
+    })
+}
+
+/// Register this device's key for the account signed in, with the ticket
+/// of the sign-in (or step-up) just made, if there is one: through the edge
+/// it signs in against, with the session's own bearer (the engine's id,
+/// key and registration files, so the engine started next finds it done).
+/// The edge is asked first: only a key it calls the account's and live is
+/// registered already; any other has this device's file cleared and is
+/// registered again (a revoked one replaced, and the revocation owed its
+/// answer at the next engine start: your plugins re-signed and their
+/// code-running powers asked again, and you told). The ticket is let go
+/// once used.
+pub async fn register(auth: &Auth, data_dir: &Path) -> DeviceKey {
+    let Some(account) = auth.user_id() else {
+        return DeviceKey::Failed("not signed in".into());
+    };
+    let device_id = match crate::load_or_create_device_id(data_dir) {
+        Ok(id) => id,
+        Err(error) => return DeviceKey::Failed(format!("this device's id couldn't be read: {error}")),
+    };
+    let directory = keys::EdgeDirectory::new(auth.edge_url(), auth.session_bearer());
+    let before = signing::load_key(data_dir).map(|key| key.public());
+    if let Some(key) = &before {
+        match on_account(&directory, key).await {
+            Ok(OnAccount::Live) => {
+                keys::Registration { registered_for: Some(account), key: Some(key.clone()) }.save(data_dir);
+                return DeviceKey::AlreadyRegistered;
+            }
+            Ok(on) => {
+                if on == OnAccount::Revoked {
+                    // No engine runs to answer it: the next one does
+                    // (`Plugins::own_key_revoked`), not just a re-sign.
+                    keys::owe_revocation(data_dir, key);
+                }
+                let _ = std::fs::remove_file(data_dir.join(keys::REGISTRATION_FILE));
+            }
+            Err(error) => {
+                return DeviceKey::Failed(format!("couldn't check this device's key with Zeron's server: {error}"));
+            }
+        }
+    }
+    let ticket = auth.step_up();
+    let result = keys::ensure_registered(data_dir, &directory, &device_id, &account, ticket.as_deref()).await;
+    if before.is_some() && signing::load_key(data_dir).map(|key| key.public()) != before {
+        keys::owe_resign(data_dir);
+    }
+    match result {
+        Ok(_) => {
+            if ticket.is_some() {
+                auth.step_up_spent();
+            }
+            DeviceKey::Registered
+        }
+        Err(error) if is_step_up(&error) => DeviceKey::NeedsConfirm,
+        Err(error) => DeviceKey::Failed(error),
+    }
+}
+
+/// Whether [`keys::ensure_registered`]'s error is the edge wanting a fresh
+/// sign-in first.
+pub(crate) fn is_step_up(error: &str) -> bool {
+    error == STEP_UP
+}
+
+/// How long a terminal waits on a pasted code: as long as the sign-in it's
+/// for can be finished. (`zeron login` holds the engine lock meanwhile.)
+pub const CODE_WAIT: std::time::Duration = crate::auth::SIGN_IN_TTL;
+/// Sign-ins offered to paste a code from before giving up.
+const TRIES: usize = 3;
+
+/// Confirm it's the person on a terminal: the paste-code step-up
+/// ([`Auth::start_headless_step_up`]) printed, the code read from stdin.
+/// Its ticket stays in this process (memory only) for [`register`]; the
+/// session is left as it is. A sign-in as another account is refused.
+pub async fn terminal_confirm(auth: &Auth) -> Result<(), crate::EngineError> {
+    let who = auth.state().user().map(|u| u.email.clone()).unwrap_or_default();
+    confirm_with(auth, crate::read_stdin_line, CODE_WAIT, |url: &str| {
+        println!("Sign in again as {who} to confirm it's you:\n\n  {url}\n");
+        println!("Then paste the code shown in the browser here and press enter.");
+    })
+    .await
+}
+
+/// [`terminal_confirm`] with its lines from `read` and its sign-in pages
+/// shown by `show`: given up `wait` after it begins. A code that doesn't
+/// work (mistyped, expired) gets a fresh sign-in to try again, a few times;
+/// another account's is refused at once.
+pub async fn confirm_with<R, F>(
+    auth: &Auth,
+    mut read: R,
+    wait: std::time::Duration,
+    mut show: impl FnMut(&str),
+) -> Result<(), crate::EngineError>
+where
+    R: FnMut() -> F,
+    F: std::future::Future<Output = Option<String>>,
+{
+    let until = tokio::time::Instant::now() + wait;
+    let mut tries = 0;
+    loop {
+        tries += 1;
+        show(&auth.start_headless_step_up()?);
+        let pasted = loop {
+            match tokio::time::timeout_at(until, read()).await {
+                Err(_) => {
+                    return Err(crate::EngineError::Other(
+                        "timed out waiting for the code; run `zeron login --confirm` again".into(),
+                    ));
+                }
+                Ok(None) => return Err(crate::EngineError::Other("no code was pasted".into())),
+                Ok(Some(line)) if line.trim().is_empty() => {}
+                Ok(Some(line)) => break line.trim().to_owned(),
+            }
+        };
+        match auth.complete_sign_in(&pasted).await {
+            Ok(()) => return Ok(()),
+            Err(error) if tries >= TRIES || error.to_string().contains(crate::auth::ANOTHER_ACCOUNT) => return Err(error),
+            Err(error) => println!("That didn't work ({error}). Here's a fresh sign-in to try again."),
+        }
+    }
+}
+
+/// How [`keys::ensure_registered`] says the edge wants a fresh sign-in
+/// (`RegisterError::StepUp`, as its error text).
+const STEP_UP: &str = "StepUp";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_refused_step_up_reads_as_one() {
+        assert_eq!(format!("{:?}", keys::RegisterError::StepUp), STEP_UP);
+    }
+}
