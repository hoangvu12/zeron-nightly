+        loop {
+            let status = signing_key_status(&core).await;
+            if status["registered"] == true {
+                return status;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await
+    .expect("registered once the step-up landed");
+    assert!(status["register_error"].is_null(), "{status}");
+    // The ticket stays in the engine: not in what Settings reads, nor on disk.
+    assert!(!status.to_string().contains("ticket-"), "{status}");
+    assert!(!refused.to_string().contains("ticket-"), "{refused}");
+    no_ticket_on_disk(dir.path());
