+/// The step-up must be the account signed in here: another account's is
+/// refused, registers nothing, and leaves the session as it was.
+#[tokio::test]
+async fn zeron_login_confirm_refuses_another_accounts_sign_in() {
+    use zeron_engine::device_key::{self, DeviceKey};
