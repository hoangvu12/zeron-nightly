@@ -0,0 +1,295 @@
+//! What became of this device's last key registration, for Settings →
+//! Account (`PluginSigningKey`): a key the edge refused until the person
+//! confirms it's them (`step_up_required`; the app offers "Confirm it's
+//! you", which runs `StepUp`, and the step-up's ticket registers it), or a
+//! registration that failed (`failed`, and why). A registered key says
+//! nothing. Never the ticket: only what happened.
+
+/// The last registration's outcome, and how many were tried.
+#[derive(Debug, Default, Clone)]
+pub(super) struct KeyStatus {
+    attempts: u64,
+    error: Option<(&'static str, String)>,
+}
+
+impl KeyStatus {
+    /// `result`: [`super::keys::ensure_registered`]'s.
+    pub(super) fn record(&mut self, result: &Result<bool, String>) {
+        self.attempts += 1;
+        self.error = match result {
+            Ok(_) => None,
+            Err(error) if crate::device_key::is_step_up(error) => Some((
+                "step_up_required",
+                "Confirm it's you to add this device's key to your account".to_owned(),
+            )),
+            Err(error) => Some(("failed", error.clone())),
+        };
+    }
+
+    /// A step-up that landed with no ticket to use (`step_up_refused`):
+    /// another account's sign-in, or one the edge gave none for.
+    pub(super) fn refused(&mut self, why: &str) {
+        self.attempts += 1;
+        self.error = Some(("step_up_refused", why.to_owned()));
+    }
+
+    /// This device's key couldn't be checked with the edge.
+    fn unchecked(&mut self, why: String) {
+        self.attempts += 1;
+        self.error = Some(("failed", why));
+    }
+
+    /// Said on `reply`: `register_attempts`, and while the key isn't
+    /// `registered`, `register_error` with its `register_message`.
+    pub(super) fn add_to(&self, reply: &mut serde_json::Value, registered: bool) {
+        reply["register_attempts"] = serde_json::json!(self.attempts);
+        if let (false, Some((code, message))) = (registered, &self.error) {
+            reply["register_error"] = serde_json::json!(code);
+            reply["register_message"] = serde_json::json!(message);
+        }
+    }
+}
+
+impl super::Plugins {
+    /// Whether this device's key is the account's by the edge's word (this
+    /// device's file can be stale: revoked from another device while this
+    /// one was off). A revoked key is replaced; one the edge doesn't call
+    /// the account's has its file cleared; either is registered again.
+    /// `false` too when the edge can't be asked.
+    pub(super) async fn verify_own_key(&self) -> bool {
+        use crate::device_key::OnAccount;
+        let (Some(directory), Some(account)) = (self.directory(), self.account()) else {
+            return false;
+        };
+        let data_dir = self.inner.data_dir.clone();
+        let Some(key) = super::signing::load_key(&data_dir).map(|k| k.public()) else {
+            self.register_key().await;
+            return self.own_key_covers(&account);
+        };
+        match crate::device_key::on_account(directory.as_ref(), &key).await {
+            Ok(OnAccount::Live) => {
+                super::keys::Registration { registered_for: Some(account.clone()), key: Some(key) }.save(&data_dir);
+                super::lock(&self.inner.key_status).record(&Ok(false));
+                true
+            }
+            Ok(OnAccount::Revoked) => {
+                // Replaced, re-signed and registered again there.
+                self.own_key_revoked(&key).await;
+                self.own_key_covers(&account)
+            }
+            Ok(OnAccount::Absent) => {
+                let _ = std::fs::remove_file(data_dir.join(super::keys::REGISTRATION_FILE));
+                self.register_key().await;
+                self.own_key_covers(&account)
+            }
+            Err(error) => {
+                super::lock(&self.inner.key_status)
+                    .unchecked(format!("Couldn't check this device's key with Zeron's server: {error}"));
+                false
+            }
+        }
+    }
+
+    fn own_key_covers(&self, account: &str) -> bool {
+        super::signing::load_key(&self.inner.data_dir)
+            .is_some_and(|key| super::keys::Registration::load(&self.inner.data_dir).covers(&key.public(), account))
+    }
+
+    /// The revocations `zeron login` owed, withdrawn at once (the cache
+    /// and your own plugins' grants), before the rest of their answer
+    /// ([`Self::settle_owed_resign`]) waits on the network.
+    pub(super) fn withdraw_owed_revocations(&self) {
+        for key in super::keys::owed_revocations(&self.inner.data_dir) {
+            self.withdraw_as_revoked(&key);
+        }
+    }
+
+    /// What `zeron login` owed, having replaced the key with no engine
+    /// running: a revocation it found answered as a running engine would
+    /// (`keys::owe_revocation`, `own_key_revoked`, which re-signs too), or
+    /// else a re-sign (`keys::owe_resign`): this device's own plugins
+    /// signed with the key there is now.
+    pub(super) async fn settle_owed_resign(&self) {
+        let data_dir = self.inner.data_dir.clone();
+        let revoked = super::keys::owed_revocations(&data_dir);
+        if !revoked.is_empty() {
+            for key in &revoked {
+                self.own_key_revoked(key).await;
+            }
+            super::keys::settle_revocations(&data_dir);
+            super::keys::settle_resign(&data_dir);
+            return;
+        }
+        if !super::keys::resign_owed(&data_dir) {
+            return;
+        }
+        let this = self.clone();
+        let _ = tokio::task::spawn_blocking(move || {
+            if super::signing::load_key(&this.inner.data_dir).is_some() {
+                this.resign_all_own();
+                super::keys::settle_resign(&this.inner.data_dir);
+            }
+        })
+        .await;
+    }
+}
