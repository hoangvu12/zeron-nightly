+/// A device signed in from before keys existed (no ticket now): `zeron
+/// login --confirm` signs in again as the account, by paste code, for a
+/// ticket alone, and registers the key with it. Still signed in as it was.
+#[tokio::test]
+async fn zeron_login_confirm_registers_without_changing_the_session() {
+    use zeron_engine::device_key::{self, DeviceKey};
