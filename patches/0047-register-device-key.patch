+/// A local engine on `dir` (as `zeron headless` or the app starts one), with
+/// `auth` attached.
+fn engine_on(dir: &std::path::Path, auth: &Auth) -> zeron_engine::EngineCore {
+    let core = zeron_engine::EngineCore::assemble(
+        dir,
+        Arc::new(zeron_engine::HarnessRegistry::new()),
+        zeron_engine::HarnessId::Mock,
+        None,
+    )
+    .expect("a local engine");
+    core.set_auth(auth.clone());
+    core
+}
+
+/// `PluginSigningKey`'s answer (what Settings → Account reads).
+async fn signing_key_status(core: &zeron_engine::EngineCore) -> serde_json::Value {
+    match core
+        .plugins
+        .dispatch(zeron_rpc::methods::PLUGIN_SIGNING_KEY, serde_json::json!({}))
+        .await
+    {
+        Ok(zeron_rpc::RpcReply::Value(value)) => value,
+        _ => panic!("PluginSigningKey didn't answer"),
+    }
+}
