+/// `zeron login` holds the engine lock, so no engine runs to register this
+/// device's key: it registers the key itself with its sign-in's ticket,
+/// before it exits. The engine started afterwards finds it registered, and
+/// asks the edge for nothing (no `StepUp`).
+#[tokio::test]
+async fn zeron_login_registers_this_devices_key_with_its_ticket() {
+    use zeron_engine::device_key::{self, DeviceKey};
+    let edge = StubEdge::start().await;
+    *edge.state.exchange_org.lock().expect("lock") = "org_1".into();
+    let dir = tempfile::tempdir().expect("tempdir");
+    std::fs::write(dir.path().join("device-id"), "device-cli").unwrap();
+    let auth = Auth::new(workos_config(&edge.url(), dir.path()));
+    paste_sign_in(&auth).await;
+    assert!(!device_key::is_registered(&auth, dir.path()));
+
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::Registered);
+    let registered = edge.state.plugin_keys.lock().unwrap().clone();
+    assert_eq!(registered.len(), 1, "{registered:?}");
+    assert_eq!(registered[0]["stepUp"], "ticket-1");
+    assert_eq!(registered[0]["deviceId"], "device-cli");
+    assert!(device_key::is_registered(&auth, dir.path()));
+    // Again: nothing to do, and nothing asked.
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::AlreadyRegistered);
+    drop(auth);
+
+    // The engine started afterwards, from the saved session.
+    let auth = Auth::new(workos_config(&edge.url(), dir.path()));
+    let core = engine_on(dir.path(), &auth);
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    let status = signing_key_status(&core).await;
+    assert_eq!(status["registered"], true, "{status}");
+    assert_eq!(status["key"], registered[0]["key"]);
+    assert!(status["register_error"].is_null(), "{status}");
+    assert_eq!(edge.state.plugin_keys.lock().unwrap().len(), 1, "the engine registers nothing again");
+    no_ticket_on_disk(dir.path());
+}
