+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::NeedsConfirm);
+    assert!(!device_key::is_registered(&auth, dir.path()));
+    let before = saved_account(dir.path());
+
+    let url = auth.start_headless_step_up().expect("a step-up as the account signed in");
+    let redirect = query_param(&url, "redirect_uri").expect("redirect");
+    assert!(redirect.contains("auth%2Fcli%2Fcallback"), "the paste-code page: {redirect}");
+    assert!(url.contains("max_age=0"), "a fresh sign-in, not the browser's: {url}");
+    let state = query_param(&url, "state").expect("state param");
+    auth.complete_sign_in(&format!("{state}.code123")).await.expect("step-up");
+    assert_eq!(device_key::register(&auth, dir.path()).await, DeviceKey::Registered);
+
+    let registered = edge.state.plugin_keys.lock().unwrap().clone();
+    assert_eq!(registered.last().unwrap()["stepUp"], "ticket-1", "{registered:?}");
+    assert_eq!(registered.last().unwrap()["deviceId"], "device-old");
+    assert!(device_key::is_registered(&auth, dir.path()));
+    // No sign-out, no sign-in: the same account, and the step-up's own
+    // session (`refresh-1`) never kept.
+    assert!(matches!(auth.state(), AuthState::SignedIn { user, org_id: Some(org) } if user.id == "user_1" && org == "org_1"));
+    let after = saved_account(dir.path());
+    assert_eq!((&after.0, &after.1), (&before.0, &before.1));
+    assert_ne!(after.2, "refresh-1");
+    no_ticket_on_disk(dir.path());
