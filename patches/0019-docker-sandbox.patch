+-- A chat's sandbox on its composer (spec #37 "When things go wrong"). First
+-- what's said (screens/chat/sandbox_machine, pure functions); then, on
+-- ui/chat_fixture.luau with the host answered by ui/sandbox_stub.luau, the
+-- composer's band (a row of its own, always shown, never in the deck's
+-- Alerts): Sandbox deleted with Start fresh, a full disk, asleep, and what
+-- they ask of the host.
+
+local logic = require("../screens/chat/sandbox_machine")
+
+-- (All findable by one filter: `zgx test ui "Sandbox machine:"`.)
+local named_test = test
+local function test(name: string, body: () -> ())
+	named_test(`Sandbox machine: {name}`, body)
+end
+
+-- (`false` for a field it doesn't have: a nil in a table isn't there.)
+local function steps(fields: { [string]: any }): any
+	local s: { [string]: any } = { state = "ready", provider = "docker", provider_name = "Docker Sandbox", disk_full = false }
+	for k, v in fields do
+		s[k] = if v == false and k ~= "disk_full" then nil else v
+	end
+	return s
+end
+
+-- ── What's said ────────────────────────────────────────────────────────────
+
+test("a sandbox that's fine, or none, says nothing", function()
+	expect(logic.alert(nil)).to_be(nil)
+	expect(logic.alert(steps({}))).to_be(nil)
+	expect(logic.alert(steps({ state = "starting", step = "create" }))).to_be(nil)
+	-- A failure that isn't the disk is the steps line's to say (#41).
+	expect(logic.alert(steps({ state = "failed", step = "getCode", error = "auth failed" }))).to_be(nil)
+end)
+
+test("the provider is named as a place", function()
+	expect(logic.place_name(steps({}))).to_be("Docker")
+	expect(logic.place_name(steps({ provider_name = "Modal" }))).to_be("Modal")
+	expect(logic.place_name(steps({ provider_name = "sandbox" }))).to_be("sandbox")
+	expect(logic.place_name(steps({ provider_name = false }))).to_be(nil)
+	expect(logic.place_name(steps({ provider_name = "" }))).to_be(nil)
+end)
+
+test("deleted outside Zeron: where, and Start fresh, nothing more (screen 14)", function()
+	local a = logic.alert(steps({ state = "gone", error = "The sandbox was deleted outside Zeron." })) :: any
+	expect(a.kind).to_be("gone")
+	expect(a.title).to_be("Sandbox deleted in Docker")
+	expect(a.detail).to_be(nil)
+	expect(a.action).to_be("fresh")
+	expect(a.action_label).to_be("Start fresh")
+	local unnamed = logic.alert(steps({ state = "gone", provider_name = false })) :: any
+	expect(unnamed.title).to_be("Sandbox deleted")
+end)
+
+test("a full disk says so, with Start fresh", function()
+	local a = logic.alert(steps({
+		state = "failed",
+		disk_full = true,
+		error = "The sandbox's disk is full. Free some space, or start fresh.\nNo space left on device",
+	})) :: any
+	expect(a.kind).to_be("disk")
+	expect(a.tone).to_be("danger")
+	expect(a.title).to_be("Sandbox's disk is full")
+	expect(a.detail).to_be("Free some space, or start fresh")
+	expect(a.action).to_be("fresh")
+end)
+
+test("deleted wins over a full disk", function()
+	local a = logic.alert(steps({ state = "gone", disk_full = true })) :: any
+	expect(a.kind).to_be("gone")
+end)
+
+test("as the band: one row in its provider's glyph, a spinner while on its way, and why it didn't go", function()
+	local a = logic.alert(steps({ state = "gone" })) :: any
+	local idle = logic.band(a, { icon = "docker" })
+	expect(idle.kind).to_be("gone")
+	expect(idle.icon).to_be("docker")
+	expect(idle.tone).to_be(nil)
+	expect(idle.action).to_be("Start fresh")
+	expect(idle.spinner).to_be(false)
+	expect(idle.dismissable).to_be(nil)
+	expect(idle.detail).to_be(nil)
+	local busy = logic.band(a, { busy = true })
+	expect(busy.action).to_be(nil)
+	expect(busy.spinner).to_be(true)
+	local failed = logic.band(a, { failure = "offline" })
+	expect(failed.action).to_be("Start fresh")
+	expect(failed.detail).to_be(logic.failure_words("offline"))
+	-- The others in their tone, with the warning glyph.
+	local disk = logic.band(logic.alert(steps({ disk_full = true })) :: any)
+	expect(disk.tone).to_be("danger")
+	expect(disk.icon).to_be("danger-triangle")
+end)
+
+test("why Start fresh didn't go, by its word", function()
+	expect(string.find(logic.failure_words("offline"), "Couldn't reach", 1, true) ~= nil).to_be(true)
+	expect(string.find(logic.failure_words("outdated"), "too old", 1, true) ~= nil).to_be(true)
+	expect(logic.failure_words("signed_out")).to_be("Sign in again, then try again.")
+	expect(logic.failure_words("failed")).to_be("Couldn't start fresh. Try again.")
+	expect(logic.failure_words("failed", "wake")).to_be("Couldn't wake it. Try again.")
+	expect(string.find(logic.failure_words("outdated", "wake"), "too old to wake", 1, true) ~= nil).to_be(true)
+end)
+
+-- ── Sleep and wake (#43) ───────────────────────────────────────────────────
+
+test("asleep: the moon and Wake on the band, no alert", function()
+	local s = steps({ state = "asleep" })
+	expect(logic.alert(s)).to_be(nil)
+	local line = logic.line(s) :: any
+	expect(line.text).to_be("Sandbox asleep")
+	expect(line.action).to_be("Wake")
+	expect(line.icon).to_be("moon")
+	local band = logic.asleep_band(line)
+	expect(band.kind).to_be("asleep")
+	expect(band.icon).to_be("moon")
+	expect(band.title).to_be("Sandbox asleep")
+	expect(band.action).to_be("Wake")
+	expect(band.tone).to_be(nil)
+	-- Awake, going to sleep or waking (said in the transcript): no line.
+	expect(logic.line(steps({}))).to_be(nil)
+	expect(logic.line(steps({ state = "sleeping", step = "sleep" }))).to_be(nil)
+	expect(logic.line(steps({ state = "waking", step = "wake" }))).to_be(nil)
+	expect(logic.line(nil)).to_be(nil)
+end)
+
+test("asleep, or on its way to or from it, is resting: its host is offline, not out of reach", function()
+	expect(logic.resting(steps({ state = "asleep" }))).to_be(true)
+	expect(logic.resting(steps({ state = "sleeping" }))).to_be(true)
+	expect(logic.resting(steps({ state = "waking" }))).to_be(true)
+	expect(logic.resting(steps({}))).to_be(false)
+	expect(logic.resting(steps({ state = "failed", step = "wake" }))).to_be(false)
+	expect(logic.resting(nil)).to_be(false)
+end)
+
+test("waking says how long above the composer; a failed wake is left to its alert", function()
+	local Line = require("../screens/chat/sandbox_line")
+	local waking = Line.line({ state = "waking", step = "wake", since = 100 }, 103) :: any
+	expect(waking.title).to_be("Waking sandbox")
+	expect(waking.time).to_be("3s")
+	expect(waking.spinner).to_be(true)
+	expect(waking.icon).to_be(nil)
+	expect(Line.line({ state = "asleep", since = 100 }, 103)).to_be(nil)
+	expect(Line.line({ state = "failed", step = "wake", since = 100, error = "No." }, 103)).to_be(nil)
+	-- (Any other failed step keeps its Run again.)
+	expect((Line.line({ state = "failed", step = "getCode", since = 100 }, 103) :: any).action).to_be("Run again")
+end)
+
+test("a wake that failed: its reason, and Wake", function()
+	local a = logic.alert(steps({ state = "failed", step = "wake", error = "Couldn't start the sandbox." })) :: any
+	expect(a.kind).to_be("wake_failed")
+	expect(a.tone).to_be("danger")
+	expect(a.title).to_be("Sandbox didn't wake")
+	expect(a.detail).to_be("Try waking it again")
+	expect(a.action).to_be("wake")
+	local band = logic.band(a, { failure = "failed" })
+	expect(band.action).to_be("Wake")
+	expect(band.detail).to_be("Couldn't wake it. Try again.")
+end)
+
+-- ── On the composer ────────────────────────────────────────────────────────
+
+local function calls(app: any): { string }
+	return (app:state("sandbox_stub_calls") :: any) or {}
+end
+
+local function asked(app: any, entry: string): number
+	local n = 0
+	for _, c in calls(app) do
+		if c == entry then
+			n += 1
+		end
+	end
+	return n
+end
+
+-- The band: a row of its own over the composer, never behind the deck's
+-- Alerts pill.
+local function in_band(what: string): string
+	return `#composer-band >> {what}`
+end
+
+-- The chat fixture's s2 on the box (not this device), its sandbox as the
+-- engine says `case`.
+local function on_sandbox(case: string): any
+	local app = mount("chat_fixture.luau")
+	app:resize(960, 760)
+	app:command("go_s2")
+	app:frames(30)
+	-- (On the fixture's Docker sandbox device, box-sb.)
+	app:command("sandbox_stub.steps.ready")
+	app:command(`sandbox_stub.{case}`)
+	app:wait("#never-shown", { timeout_ms = 300 })
+	app:frames(30)
+	return app
+end
+
+test("opening a chat on a sandbox follows it", function()
+	local app = on_sandbox("ready")
+	expect(asked(app, "follow:s2") >= 1).to_be(true)
+	-- A sandbox that's up raises nothing.
+	expect(app:has('role:button "Open Alerts"')).to_be(false)
+	expect(app:has("#composer-band")).to_be(false)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a chat hosted here is never asked about", function()
+	local app = mount("chat_fixture.luau")
+	app:command("go_s2")
+	app:frames(30)
+	expect(asked(app, "follow:s2")).to_be(0)
+end)
+
+test("a chat on another device that isn't a sandbox is never asked about", function()
+	local app = mount("chat_fixture.luau")
+	app:command("go_s2")
+	app:frames(30)
+	app:command("session_on_box")
+	app:wait("#never-shown", { timeout_ms = 300 })
+	app:frames(30)
+	expect(asked(app, "follow:s2")).to_be(0)
+	expect(app:error()).to_be(nil)
+end)
+
+test("deleted outside Zeron: one row says where, and Start fresh starts one", function()
+	local app = on_sandbox("gone")
+	expect(app:has(in_band('~"Sandbox deleted in Docker"'))).to_be(true)
+	-- Never behind the Alerts pill, and no word more (screen 14).
+	expect(app:has('role:button "Open Alerts"')).to_be(false)
+	expect(app:has("#composer-band-detail")).to_be(false)
+	app:click(in_band('role:button "Start fresh"'))
+	app:frames(30)
+	expect(asked(app, "fresh:s2")).to_be(1)
+	-- The engine starts it: the alert goes.
+	app:command("sandbox_stub.started")
+	app:frames(30)
+	expect(app:has(in_band('~"Sandbox deleted"'))).to_be(false)
+	expect(app:error()).to_be(nil)
+end)
+
+test("on a provider whose name isn't known, it's just deleted", function()
+	local app = on_sandbox("gone_unnamed")
+	expect(app:has(in_band('~"Sandbox deleted"'))).to_be(true)
+	expect(app:has(in_band('~"Sandbox deleted in"'))).to_be(false)
+end)
+
+test("Start fresh on its way: no second one asked", function()
+	local app = on_sandbox("gone")
+	app:command("sandbox_stub.hold_next")
+	app:click(in_band('role:button "Start fresh"'))
+	app:frames(30)
+	expect(app:has(in_band('role:button "Start fresh"'))).to_be(false)
+	expect(asked(app, "fresh:s2")).to_be(1)
+end)
+
+test("a Start fresh that didn't go says why, and can be tried again", function()
+	local app = on_sandbox("gone")
+	app:command("sandbox_stub.fail_next")
+	app:click(in_band('role:button "Start fresh"'))
+	app:frames(30)
+	expect(app:has(in_band('~"Couldn\'t reach Zeron"'))).to_be(true)
+	app:click(in_band('role:button "Start fresh"'))
+	app:frames(30)
+	expect(asked(app, "fresh:s2")).to_be(2)
+	expect(app:error()).to_be(nil)
+end)
+
+test("asleep: always shown over the composer, and its Wake wakes it", function()
+	local app = on_sandbox("asleep")
+	expect(app:has(in_band('~"Sandbox asleep"'))).to_be(true)
+	expect(app:has('role:button "Open Alerts"')).to_be(false)
+	app:click(in_band('role:button "Wake"'))
+	app:frames(30)
+	expect(asked(app, "wake:s2")).to_be(1)
+	-- Waking, the band says so instead.
+	app:command("sandbox_stub.waking")
+	app:frames(30)
+	expect(app:has(in_band('~"Sandbox asleep"'))).to_be(false)
+	expect(app:has(in_band('~"Waking sandbox"'))).to_be(true)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a wake that failed says why, and Wake tries again", function()
+	local app = on_sandbox("wake_failed")
+	expect(app:has(in_band('~"Sandbox didn\'t wake"'))).to_be(true)
+	app:click(in_band('role:button "Wake"'))
+	app:frames(30)
+	expect(asked(app, "wake:s2")).to_be(1)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a full disk is said in the chat, with Start fresh", function()
+	local app = on_sandbox("disk_full")
+	expect(app:has(in_band('~"Sandbox\'s disk is full"'))).to_be(true)
+	app:click(in_band('role:button "Start fresh"'))
+	app:frames(30)
+	expect(asked(app, "fresh:s2")).to_be(1)
+end)
diff --git a/apps/zgx/ui/tests/save_sandbox_template.test.luau b/apps/zgx/ui/tests/save_sandbox_template.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..f91600330b8c4bc1c8e55b033660aae570a15432
--- /dev/null
+++ b/apps/zgx/ui/tests/save_sandbox_template.test.luau
@@ -0,0 +1,57 @@
+-- Save as sandbox template (spec #37, design 21–23): what a chat's save
+-- says on its composer's band while it saves, once it's saved, and when it
+-- isn't (screens/shell/save_sandbox_template, pure functions).
+
+local words = require("../screens/shell/save_sandbox_template")
+
+-- (All findable by one filter: `zgx test ui "Save as sandbox template:"`.)
+local named_test = test
+local function test(name: string, body: () -> ())
+	named_test(`Save as sandbox template: {name}`, body)
+end
+
+test("it saves under the name trimmed, and a blank one saves nothing", function()
+	expect(words.trimmed("  reportly-dev ")).to_be("reportly-dev")
+	expect(words.saving(" reportly-dev ").name).to_be("reportly-dev")
+	expect(words.can_start(nil, "reportly-dev")).to_be(true)
+	expect(words.can_start(nil, "   ")).to_be(false)
+end)
+
+test("while it saves: a spinner and its name in mono, no second save, and it stays", function()
+	local save = words.saving("reportly-dev")
+	local b = words.band(save)
+	expect(b.spinner).to_be(true)
+	expect(b.title).to_be("Saving as template")
+	expect(b.detail).to_be("reportly-dev")
+	expect(b.mono).to_be(true)
+	expect(b.dismissable).to_be(nil)
+	expect(words.can_start(save, "other")).to_be(false)
+	expect(words.dismissable(save)).to_be(false)
+end)
+
+test("saved (screen 23): a green check, its label, the name in mono, put away with ×", function()
+	local save = words.saved(words.saving("reportly-dev"), { id = "tmpl_1", name = "reportly-dev" })
+	local b = words.band(save)
+	expect(b.icon).to_be("check-circle")
+	expect(b.tone).to_be("success")
+	expect(b.title).to_be("Saved as template")
+	expect(b.detail).to_be("reportly-dev")
+	expect(b.mono).to_be(true)
+	expect(b.dismissable).to_be(true)
+	expect(words.dismissable(save)).to_be(true)
+	expect(words.can_start(save, "again")).to_be(true)
+	-- (No name back: the one asked for.)
+	expect(words.saved(words.saving("x"), nil).name).to_be("x")
+	expect(words.band(nil)).to_be(nil)
+end)
+
+test("not saved: the engine's words, or ours when there are none", function()
+	local save = words.saving("reportly-dev")
+	local busy = words.band(words.failed(save, { message = "The chat is still working. Save it as a template once it's done." }))
+	expect(busy.tone).to_be("danger")
+	expect(busy.dismissable).to_be(true)
+	expect(busy.title).to_be("Couldn’t save the template")
+	expect(busy.detail).to_be("The chat is still working. Save it as a template once it's done.")
+	expect(words.band(words.failed(save, { message = "offline" })).detail).to_be(nil)
+	expect(words.band(words.failed(save, "failed")).title).to_be("Couldn’t save the template")
+end)
diff --git a/apps/zgx/ui/tests/settings_sandboxes.test.luau b/apps/zgx/ui/tests/settings_sandboxes.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..454f7f3578f1251a1c0680429f18c827bcfae58c
--- /dev/null
+++ b/apps/zgx/ui/tests/settings_sandboxes.test.luau
@@ -0,0 +1,377 @@
+-- Settings › Sandboxes (spec #37, ticket #48). First its words and rows
+-- (screens/settings/sandbox_words, pure): When as five moments and Replace a
+-- step…, For, one row per script that exists, which host device may sleep,
+-- which provider signs in on its own page (its ops). Then the page on
+-- ui/shell_fixture.luau, the engine answered by
+-- ui/sandbox_settings_stub.luau: provider rows Connect / Disconnect, the
+-- host device (shown before connecting too) and its note, the scripts list
+-- (connected or not), Add script and editing one, every script call asked of
+-- this device's engine, which routes it.
+
+local words = require("../screens/settings/sandbox_words")
+
+-- (All findable by one filter: `zgx test ui "Sandboxes:"`.)
+local named_test = test
+local function test(name: string, body: () -> ())
+	named_test(`Sandboxes: {name}`, body)
+end
+
+local PROVIDERS = {
+	{ id = "docker", name = "Docker Sandbox", icon = "docker" },
+	{ id = "boat", name = "Boat", icon = "boat" },
+}
+local PROJECTS = {
+	{ id = "reportly", name = "reportly", device = "box" },
+	{ id = "atlas", name = "Atlas", device = "mac" },
+}
+
+-- Words ───────────────────────────────────────────────────────────────────
+
+test("When offers five moments, then Replace a step", function()
+	local labels = {}
+	for _, o in words.when_options() do
+		table.insert(labels, o.label)
+	end
+	expect(table.concat(labels, "|")).to_be("When it's created|When it's ready|When it wakes|Before it sleeps|Before it's deleted|Replace a step…")
+	expect(words.hook_of("after-wake")).to_be("after-wake")
+	expect(words.hook_of(words.REPLACE, "get-code")).to_be("instead-of-get-code")
+	-- Replace without a step names nothing yet.
+	expect(words.hook_of(words.REPLACE, nil)).to_be(nil)
+	-- Ready isn't a step to stand in for.
+	for _, o in words.step_options() do
+		expect(o.value ~= "ready").to_be(true)
+	end
+end)
+
+test("a script's When reads plainly, whatever hook it's on", function()
+	expect(words.when("after-ready")).to_be("When it's ready")
+	expect(words.when("before-sleep")).to_be("Before it sleeps")
+	expect(words.when("setup")).to_be("When it's ready")
+	expect(words.when("instead-of-get-code")).to_be("Instead of Get the code")
+	expect(words.when("before-install-zeron")).to_be("Before Install Zeron")
+	expect(words.when("after-setup")).to_be("After Setup")
+	-- And back to the choices that name it.
+	local choice, step = words.choice_of("instead-of-secrets")
+	expect(choice).to_be(words.REPLACE)
+	expect(step).to_be("secrets")
+	expect((words.choice_of("setup"))).to_be("after-ready")
+end)
+
+test("one row per script there is: name, When, For", function()
+	local rows = words.rows({
+		{ ["for"] = { kind = "all" }, hook = "after-ready", name = "fleet-sync.sh" },
+		{ ["for"] = { kind = "provider", provider = "docker" }, hook = "after-wake", name = "git-fetch.sh" },
+		{ ["for"] = { kind = "project", spaceId = "reportly" }, hook = "setup", name = "setup.sh" },
+	}, PROVIDERS, PROJECTS)
+	expect(#rows).to_be(3)
+	local said = {}
+	for _, r in rows do
+		table.insert(said, `{r.name}|{r.when}|{r.whom}`)
+	end
+	expect(said[1]).to_be("fleet-sync.sh|When it's ready|All sandboxes")
+	expect(said[2]).to_be("git-fetch.sh|When it wakes|Docker Sandbox")
+	expect(said[3]).to_be("setup.sh|When it's ready|reportly")
+	-- No empty rows: nothing is nothing.
+	expect(#words.rows({}, PROVIDERS, PROJECTS)).to_be(0)
+	expect(#words.rows(nil, PROVIDERS, PROJECTS)).to_be(0)
+	-- Each row's key is the script's own.
+	expect(rows[2].key).to_be("provider:docker/after-wake/git-fetch.sh")
+end)
+
+test("When sets Replace a step apart with a rule", function()
+	local options = words.when_options()
+	expect(options[#options].value).to_be(words.REPLACE)
+	expect(options[#options].rule).to_be(true)
+	for i = 1, #options - 1 do
+		expect(options[i].rule).to_be(nil)
+	end
+end)
+
+test("All sandboxes reads as stacked layers, a project as a project", function()
+	local _, all = words.for_label({ kind = "all" }, PROVIDERS, PROJECTS)
+	expect(all).to_be("layers")
+	local _, project = words.for_label({ kind = "project", spaceId = "reportly" }, PROVIDERS, PROJECTS)
+	expect(project).to_be("folder-with-files")
+	local icons = {}
+	for _, o in words.for_options(PROVIDERS, PROJECTS) do
+		icons[o.value] = o.icon
+	end
+	expect(icons.all).to_be("layers")
+	expect(icons["project:reportly"]).to_be("folder-with-files")
+end)
+
+test("For offers every sandbox, each provider and the host devices' projects", function()
+	local hosted = {
+		{ id = "docker", name = "Docker Sandbox", icon = "docker", host = "box" },
+		{ id = "boat", name = "Boat", icon = "boat" },
+	}
+	local labels = {}
+	for _, o in words.for_options(hosted, PROJECTS) do
+		table.insert(labels, o.label)
+	end
+	expect(table.concat(labels, "|")).to_be("All sandboxes|Docker Sandbox|Boat|reportly")
+	-- With no host device yet, every project.
+	labels = {}
+	for _, o in words.for_options(PROVIDERS, PROJECTS) do
+		table.insert(labels, o.label)
+	end
+	expect(table.concat(labels, "|")).to_be("All sandboxes|Docker Sandbox|Boat|reportly|Atlas")
+	expect(words.scope_of("project:reportly").spaceId).to_be("reportly")
+	expect(words.scope_of("provider:boat").provider).to_be("boat")
+	expect(words.scope_of("all").kind).to_be("all")
+	expect(words.scope_value({ kind = "provider", provider = "boat" })).to_be("provider:boat")
+end)
+
+test("a script's name is one plain file name", function()
+	expect(words.valid_name("warm-cache.sh")).to_be(true)
+	for _, bad in { "", ".", "..", ".hidden", "a/b.sh", "a\\b.sh", "c:d" } do
+		expect(words.valid_name(bad)).to_be(false)
+	end
+end)
+
+test("a computer that isn't always on may sleep (no device says it's a laptop)", function()
+	expect(words.may_sleep({ platform = "macos", headless = false })).to_be(true)
+	expect(words.may_sleep({ platform = "windows" })).to_be(true)
+	expect(words.may_sleep({ platform = "linux", headless = true })).to_be(false)
+	expect(words.may_sleep({ platform = "ios" })).to_be(false)
+	expect(words.may_sleep(nil)).to_be(false)
+	-- Said as a maybe, never as a fact.
+	expect(words.sleep_note("MacBook Pro")).to_contain("may sleep")
+end)
+
+test("a provider signs in on its own page only when its ops say so", function()
+	expect(words.signs_in_on_page({ id = "docker", name = "Docker Sandbox", ops = { "create", "connect", "signInPage" } })).to_be(true)
+	expect(words.signs_in_on_page({ id = "boat", name = "Boat", ops = { "create", "connect" } })).to_be(false)
+	-- (Whatever its id: the ops decide.)
+	expect(words.signs_in_on_page({ id = "docker", name = "Docker Sandbox" })).to_be(false)
+	expect(words.signs_in_on_page(nil)).to_be(false)
+end)
+
+test("Docker's token field says which keys it takes", function()
+	expect(words.token_hint("docker")).to_contain("username:")
+	expect(words.token_hint("boat")).to_be(nil)
+end)
+
+test("before it's connected, the host device is the one the engine would pick", function()
+	local devices = {
+		{ id = "mac", name = "MacBook Pro", platform = "macos", here = true, host = true },
+		{ id = "box", name = "devbox", platform = "linux", here = false, online = true, host = true, headless = true },
+		{ id = "old", name = "old box", platform = "linux", here = false, online = false, host = true, headless = true },
+	}
+	expect(words.planned_host(devices)).to_be("box")
+	-- No always-on server online: this one.
+	expect(words.planned_host({ devices[1], devices[3] })).to_be("mac")
+	expect(words.planned_host({})).to_be(nil)
+end)
+
+-- The page ────────────────────────────────────────────────────────────────
+
+local PAGE = "#settings-page"
+local NAV = "#settings-nav"
+
+local function open(before: { string }?): any
+	local app = mount("shell_fixture.luau")
+	app:resize(1200, 900)
+	app:frames(30)
+	app:command("settings_stub.sign_in")
+	for _, c in before or {} do
+		app:command(c)
+	end
+	app:command("shell.settings")
+	app:frames(20)
+	app:click(`{NAV} >> role:tab "Sandboxes"`)
+	app:frames(40)
+	return app
+end
+
+local function shows(app: any, scope: string, text: string): boolean
+	return app:tree(scope):find(text, 1, true) ~= nil
+end
+
+-- What the page asked of the engine (the stub's log): "method@device".
+local function asked(app: any, entry: string): boolean
+	for _, c in (app:state("sandbox_settings_stub_asked") :: any) or {} do
+		if c == entry then
+			return true
+		end
+	end
+	return false
+end
+
+-- Whether a script call went anywhere but this device's engine (the engine
+-- routes scripts to the host devices itself).
+local function scripts_sent_away(app: any): boolean
+	for _, c in (app:state("sandbox_settings_stub_asked") :: any) or {} do
+		local method, device = string.match(c, "^(%w+)@(.*)$")
+		if method and string.find(method, "StepScript", 1, true) and device ~= "" then
+			return true
+		end
+	end
+	return false
+end
+
+test("not connected, the host device and the scripts still show", function()
+	local app = open()
+	expect(app:has(`{PAGE} >> role:button "Connect Docker Sandbox"`)).to_be(true)
+	expect(app:has(`{PAGE} >> role:button "Disconnect Docker Sandbox"`)).to_be(false)
+	expect(shows(app, PAGE, "Host device")).to_be(true)
+	-- The one the engine would pick: devbox, the always-on server.
+	expect(app:text(`{PAGE} >> role:button "Host device for Docker Sandbox"`)).to_contain("devbox")
+	for _, text in { "fleet-sync.sh", "git-fetch.sh", "setup.sh" } do
+		expect(shows(app, PAGE, text)).to_be(true)
+	end
+end)
+
+test("each provider says whether it's connected, with Connect or Disconnect", function()
+	local app = open()
+	expect(shows(app, PAGE, "Docker Sandbox")).to_be(true)
+	expect(shows(app, PAGE, "Boat")).to_be(true)
+
+	-- Connected with a pasted token: the host device keeps it.
+	app:click(`{PAGE} >> role:button "Connect Docker Sandbox"`)
+	app:frames(20)
+	app:fill('role:dialog >> role:textbox "Token"', "user:dckr_pat_x")
+	app:click('role:dialog >> role:button "Connect"')
+	app:frames(40)
+	expect(asked(app, "ConnectSandboxProvider@")).to_be(true)
+	expect(app:has(`{PAGE} >> role:button "Disconnect Docker Sandbox"`)).to_be(true)
+	expect(shows(app, PAGE, "Connected")).to_be(true)
+	-- The account is the host device's to say.
+	expect(asked(app, "ListSandboxProviders@box")).to_be(true)
+	-- devbox was the one shown: nothing to move.
+	expect(asked(app, "SetSandboxHost@")).to_be(false)
+
+	-- Disconnect, after a confirm.
+	app:click(`{PAGE} >> role:button "Disconnect Docker Sandbox"`)
+	app:frames(20)
+	app:click('role:dialog >> role:button "Disconnect"')
+	app:frames(40)
+	expect(asked(app, "DisconnectSandboxProvider@")).to_be(true)
+	expect(app:has(`{PAGE} >> role:button "Connect Docker Sandbox"`)).to_be(true)
+end)
+
+test("a host device picked before connecting is where it goes", function()
+	local app = open()
+	app:click(`{PAGE} >> role:button "Host device for Docker Sandbox"`)
+	app:frames(20)
+	app:click('role:menuitem ~"MacBook Pro"')
+	app:frames(20)
+	-- Not connected yet: nothing to move.
+	expect(asked(app, "SetSandboxHost@")).to_be(false)
