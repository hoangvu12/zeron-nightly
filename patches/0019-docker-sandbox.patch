diff --git a/apps/zgx/ui/account/sandbox_template_saves.luau b/apps/zgx/ui/account/sandbox_template_saves.luau
new file mode 100644
index 0000000000000000000000000000000000000000..f0ada1e7355f2ff6e634b1cac12a4505461f6626
--- /dev/null
+++ b/apps/zgx/ui/account/sandbox_template_saves.luau
@@ -0,0 +1,82 @@
+-- Save as sandbox template (spec #37): a chat's sandbox saved through its
+-- provider, by the host device that keeps it (src/sandbox_template_save.rs).
+-- A sandbox template, named apart from the interface's own templates
+-- (`templates.*`). What a save says is screens/shell/save_sandbox_template's;
+-- a provider's sandbox templates are listed by account/sandboxes.
+--
+--   template_saves.on_sandbox(chat)   whether its device is a sandbox
+--                                     (tracked): its menu offers the save
+--   template_saves.save(chat, name)   saves it; while it does, and once
+--                                     it's done, its `band(chat)` says so
+--   template_saves.saving(chat)       whether it's saving (tracked)
+--   template_saves.band(chat)         the chat's composer band (tracked)
+--   template_saves.dismiss(chat)      put that band away
+--
+-- The host's call is a field (`ask_save`) a fixture can answer in its place.
+
+local sessions = require("@account/sessions")
+local sandboxes = require("@account/sandboxes")
+local words = require("@app/screens/shell/save_sandbox_template")
+
+local M = {}
+
+-- Chat → its last save (screens/shell/save_sandbox_template's).
+M.saves = ui.state("account_sandbox_template_saves", {} :: { [string]: any })
+
+function M.ask_save(chat: string, name: string): any
+	return ui.call("sandbox_template.save", { chat = chat, name = name })
+end
+
+M.trimmed = words.trimmed
+
+function M.on_sandbox(chat: string?): boolean
+	if not chat then
+		return false
+	end
+	local device: string? = nil
+	for _, c in sessions.now:get().chats do
+		if c.id == chat then
+			device = c.device
+			break
+		end
+	end
+	if not device then
+		return false
+	end
+	for _, d in sessions.devices:get() do
+		if d.id == device then
+			return sandboxes.of_device(d :: any) ~= nil
+		end
+	end
+	return false
+end
+
+function M.save(chat: string, name: string)
+	if not words.can_start(M.saves:peek()[chat], name) then
+		return
+	end
+	local save = words.saving(name)
+	M.saves:set_key(chat, save)
+	M.ask_save(chat, save.name):after(function(t: any)
+		M.saves:set_key(chat, words.saved(save, t))
+	end, function(e: any)
+		M.saves:set_key(chat, words.failed(save, e))
+	end)
+end
+
+function M.saving(chat: string?): boolean
+	local s = chat and M.saves:get()[chat]
+	return s ~= nil and s.state == "saving"
+end
+
+function M.band(chat: string?): any
+	return words.band(chat and M.saves:get()[chat])
+end
+
+function M.dismiss(chat: string?)
+	if chat and words.dismissable(M.saves:peek()[chat]) then
+		M.saves:set_key(chat, nil :: any)
+	end
+end
+
+return M
diff --git a/apps/zgx/ui/account/sandboxes.luau b/apps/zgx/ui/account/sandboxes.luau
new file mode 100644
index 0000000000000000000000000000000000000000..c6f7360f9fe49d81464f45609a14d6e17af29684
--- /dev/null
+++ b/apps/zgx/ui/account/sandboxes.luau
@@ -0,0 +1,208 @@
+-- Places a chat runs on (spec #37): the sandbox providers this device's
+-- engine keeps (Docker Sandbox, Boat, …), as the host reads them
+-- (src/sandboxes.rs). A sandbox's device is never listed: its provider is,
+-- once, by its own name and icon (screens/chat/where). Picking it opens its
+-- account's templates, plus Blank.
+--
+--   sandboxes.providers()           { { id, name, icon } } (tracked)
+--   sandboxes.provider(id)          one of them, or nil (tracked)
+--   sandboxes.icon(id)              its glyph: its own when Zeron draws it,
+--                                   else a box (tracked)
+--   sandboxes.name(id)              its name, else its id (tracked)
+--   sandboxes.value(id) / .of(value)  the device picker's value for a provider
+--                                   (`place:<id>`), and back (nil: not one)
+--   sandboxes.target(id, template?) the agents' catalog target for a place
+--                                   (`place:<id>[:<template>]`, zeron_proto
+--                                   `places::place_target`): the device keeping
+--                                   the provider answers, never a sandbox
+--   sandboxes.of_device(device)     the provider a sandbox's device row names
+--   sandboxes.templates(provider)   a promise of { { id, name } }
+--   sandboxes.follow(chat) / .unfollow(chat)  keep its steps in `steps`
+--   sandboxes.steps_of(chat)        { state, step?, since, error? } (tracked)
+--   sandboxes.run_again(chat)       a promise: the failed step runs again
+--   sandboxes.machine(chat)         its sandbox as screens/chat/sandbox_machine
+--                                   reads it (tracked)
+--   sandboxes.fresh(chat) / .fresh_state(chat)  Start fresh, { busy?, failure? }
+--   sandboxes.wake(chat) / .wake_state(chat)    Wake (#43), the same
+--
+-- The host's calls are fields (`ask_*`), so a fixture answers in its place.
+
+local SVGS: { [string]: string } = require("@ds/icon_svgs")
+
+local M = {}
+
+export type Provider = { id: string, name: string, icon: string }
+export type Template = { id: string, name: string }
+export type Steps = { state: string, step: string?, template: string?, since: number, error: string? }
+
+-- (A place's own name for the engine, as zeron_proto `places` has it; not a
+-- device's `sandbox:<provider>` capability.)
+M.PREFIX = "place:"
+-- What a template picker's Blank is (no template: the provider's plain image).
+M.BLANK = ""
+
+M.now = ui.shared("sandboxes", { providers = {} :: { Provider } })
+M.steps = ui.shared("sandbox_steps", {} :: { [string]: Steps })
+
+function M.providers(): { Provider }
+	return M.now:get().providers or {}
+end
+
+function M.provider(id: string?): Provider?
+	if not id then
+		return nil
+	end
+	for _, p in M.providers() do
+		if p.id == id then
+			return p
+		end
+	end
+	return nil
+end
+
+-- A provider's glyph: the one it names when Zeron's set draws it (same
+-- grid, stroke and corners as every other), else a box.
+function M.icon(id: string?): string
+	local p = M.provider(id)
+	local icon = if p then p.icon else id
+	return if icon and SVGS[icon] then icon else "box"
+end
+
+function M.name(id: string): string
+	local p = M.provider(id)
+	return if p then p.name else id
+end
+
+function M.value(id: string): string
+	return M.PREFIX .. id
+end
+
+-- The provider a picker value or catalog target names (a template after it
+-- dropped), else nil.
+function M.of(value: string?): string?
+	if value and string.sub(value, 1, #M.PREFIX) == M.PREFIX and #value > #M.PREFIX then
+		local rest = string.sub(value, #M.PREFIX + 1)
+		return string.match(rest, "^([^:]+)") or rest
+	end
+	return nil
+end
+
+function M.target(id: string, template: string?): string
+	if template and template ~= M.BLANK then
+		return `{M.PREFIX}{id}:{template}`
+	end
+	return M.PREFIX .. id
+end
+
+function M.of_device(device: { sandbox: string? }?): string?
+	return if device then device.sandbox else nil
+end
+
+function M.steps_of(chat: string?): Steps?
+	if not chat then
+		return nil
+	end
+	return M.steps:get()[chat]
+end
+
+-- The host's calls, each a field a fixture answers.
+function M.ask_templates(provider: string): any
+	return ui.call("sandboxes.templates", provider)
+end
+function M.ask_run_again(chat: string): any
+	return ui.call("sandboxes.run_again", chat)
+end
+function M.ask_follow(chat: string)
+	ui.invoke("sandboxes.follow", chat)
+end
+function M.ask_unfollow(chat: string)
+	ui.invoke("sandboxes.unfollow", chat)
+end
+
+function M.templates(provider: string): any
+	return M.ask_templates(provider)
+end
+function M.run_again(chat: string): any
+	return M.ask_run_again(chat)
+end
+function M.follow(chat: string)
+	M.ask_follow(chat)
+end
+function M.unfollow(chat: string)
+	M.ask_unfollow(chat)
+end
+
+-- ── What goes wrong, and Wake (#44, #43) ───────────────────────────────────
+-- What's said of it is screens/chat/sandbox_machine's: these are its reads
+-- and its actions.
+
+function M.ask_fresh(chat: string): any
+	return ui.call("sandboxes.fresh", chat)
+end
+function M.ask_wake(chat: string): any
+	return ui.call("sandboxes.wake", chat)
+end
+-- (Read through here, so a fixture can stand in for the host's.)
+function M.read(): { [string]: any }
+	return M.steps:get() or {}
+end
+
+-- A chat's sandbox as screens/chat/sandbox_machine reads it (tracked):
+-- { state, provider, provider_name?, step?, error?, disk_full }, nil for a
+-- chat not on a place this device keeps.
+function M.machine(chat: string?): any
+	if not chat then
+		return nil
+	end
+	local s = M.read()[chat]
+	if not s then
+		return nil
+	end
+	local out = table.clone(s)
+	local p = M.provider(s.provider)
+	out.provider_name = out.provider_name or (if p then p.name else nil)
+	out.disk_full = s.disk_full == true
+	return out
+end
+
+M.fresh_states = ui.state("account_sandboxes_fresh", {} :: { [string]: { busy: boolean?, failure: string? } })
+M.wake_states = ui.state("account_sandboxes_wake", {} :: { [string]: { busy: boolean?, failure: string? } })
+
+-- An action asked of the host for a chat, its { busy?, failure? } kept in
+-- `states` meanwhile.
+local function ask(states: any, chat: string, call: (string) -> any)
+	local now = states:peek()[chat]
+	if now and now.busy then
+		return
+	end
+	states:set_key(chat, { busy = true } :: any)
+	call(chat):after(function()
+		states:set_key(chat, nil :: any)
+	end, function(e: any)
+		local word = if type(e) == "table" and type(e.message) == "string" then e.message else "failed"
+		states:set_key(chat, { failure = word } :: any)
+	end)
+end
+
+-- Start fresh: a new sandbox, the chat's pushed work with it.
+function M.fresh(chat: string)
+	ask(M.fresh_states, chat, function(c: string): any
+		return M.ask_fresh(c)
+	end)
+end
+function M.fresh_state(chat: string?): { busy: boolean?, failure: string? }
+	return (chat and M.fresh_states:get()[chat]) or {}
+end
+
+-- Wake: its sandbox started again, its engine with it. (A send wakes it
+-- too, on the engine's side.)
+function M.wake(chat: string)
+	ask(M.wake_states, chat, function(c: string): any
+		return M.ask_wake(c)
+	end)
+end
+function M.wake_state(chat: string?): { busy: boolean?, failure: string? }
+	return (chat and M.wake_states:get()[chat]) or {}
+end
+
+return M
