+        created["cwd"].as_str().unwrap(),
+        "hello box",
+    )
+    .await;
+    let done = ready(&rpc, "chat-ssh").await;
+    expect_states(
+        &done,
+        &[
+            ("create", "skipped"),
+            ("start", "skipped"),
+            ("installZeron", "skipped"),
+            ("signIn", "done"),
+            ("secrets", "skipped"),
+            ("getCode", "done"),
+            ("setup", "skipped"),
+            ("ready", "done"),
+        ],
+    );
+    assert!(
+        ssh.calls().iter().all(|c| c.starts_with("run box: ")),
+        "{:#?}",
+        ssh.calls()
+    );
+    replied(&ssh, "box", "chat-ssh", Duration::from_secs(60)).await;
+
+    // A PC at home: it can only be started, and it already runs Zeron,
+    // signed in itself. Nothing is installed, signed in or cloned.
+    let resident = Resident {
+        device_id: "device-pc".into(),
+        edge_url: edge.url.clone(),
+        sign_in: host.core().lend_sign_in("device-pc", ORG).await.unwrap(),
+    };
+    let pc = FakeProvider::start_only(&dirs.path().join("pc"), resident);
+    host.core().sandboxes.register(pc.clone());
+    let created = create_on_place(&rpc, "chat-pc", "fake-pc").await;
+    assert_eq!(created["deviceId"], "device-pc");
+    let done = ready(&rpc, "chat-pc").await;
+    expect_states(
+        &done,
+        &[
+            ("create", "skipped"),
+            ("start", "done"),
+            ("installZeron", "skipped"),
+            ("signIn", "skipped"),
+            ("secrets", "skipped"),
+            ("getCode", "skipped"),
+            ("setup", "skipped"),
+            ("ready", "done"),
+        ],
+    );
+    assert_eq!(pc.calls(), ["start pc"]);
+    assert!(edge.host_connected("device-pc"));
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_failed_clone_shows_its_error_and_runs_again() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    // The project's origin isn't there (yet).
+    let origin_url = dirs.path().join("origin.git");
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    let created = create_on_place(&rpc, "chat-c", "fake").await;
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    host.core()
+        .workspace
+        .rename_chat("chat-c", "Pre-titled")
+        .unwrap();
+    send(&rpc, "chat-c", &cwd, "hello again").await;
+
+    let failed = steps_until(&rpc, "chat-c", Duration::from_secs(30), |s| {
+        s["state"] == "failed"
+    })
+    .await;
+    assert_eq!(failed["step"], "getCode", "{failed:#}");
+    let error = failed["error"].as_str().unwrap_or_default();
+    assert!(
+        error.contains("origin.git") || error.to_lowercase().contains("repository"),
+        "git's own words: {error}"
+    );
+    // Nothing after it ran: the sandbox's engine isn't up.
+    assert!(
+        !provider
+            .calls()
+            .iter()
+            .any(|c| c.contains("zeron-engine watchdog")),
+        "{:#?}",
+        provider.calls()
+    );
+
+    // The user fixes GitHub and runs it again: it goes on from there.
+    origin(&origin_url);
+    rpc.call(
+        methods::RUN_SANDBOX_STEPS_AGAIN,
+        json!({ "chatId": "chat-c" }),
+    )
+    .await
+    .expect("Run again");
+    let done = ready(&rpc, "chat-c").await;
+    assert!(done["error"].is_null(), "{done:#}");
+    assert_eq!(
+        provider.calls().iter().filter(|c| *c == "create").count(),
+        1,
+        "{:#?}",
+        provider.calls()
+    );
+    assert_eq!(
+        git(Path::new(&cwd), &["branch", "--show-current"]),
+        "zeron/chat-c"
+    );
+    replied(&provider, "chat-c", "chat-c", Duration::from_secs(60)).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_sign_in_in_the_projects_origin_never_reaches_the_sandbox_or_its_error() {
+    const TOKEN: &str = "ghp_do-not-leak-0123456789";
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let host_dir = dirs.path().join("host");
+    let host = host_device(&host_dir, &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    // The project's origin carries a sign-in; nothing answers there.
+    let path = dirs.path().join("reportly");
+    std::fs::create_dir_all(&path).unwrap();
+    git(&path, &["init", "-q", "-b", "main"]);
+    let origin = format!("https://someone:{TOKEN}@127.0.0.1:9/acme/reportly.git");
+    git(&path, &["remote", "add", "origin", &origin]);
+    add_project(&rpc, &host, &path).await;
+
+    create_on_place(&rpc, "chat-t", "fake").await;
+    let failed = steps_until(&rpc, "chat-t", Duration::from_secs(60), |s| {
+        s["state"] == "failed"
+    })
+    .await;
+    assert_eq!(failed["step"], "getCode", "{failed:#}");
+    assert!(!failed.to_string().contains(TOKEN), "{failed:#}");
+    // The sandbox cloned the repository without it.
+    let calls = provider.calls();
+    assert!(
+        calls
+            .iter()
+            .any(|c| c.contains("git clone https://127.0.0.1:9/acme/reportly.git")),
+        "{calls:#?}"
+    );
+    assert!(calls.iter().all(|c| !c.contains(TOKEN)), "{calls:#?}");
+    // Nor is it kept in what this device remembers of the chat.
+    let kept = std::fs::read_to_string(host_dir.join("sandboxes.json")).unwrap();
+    assert!(!kept.contains(TOKEN));
+}
diff --git a/crates/engine/tests/sandbox_recovery.rs b/crates/engine/tests/sandbox_recovery.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f4b991d00da0bf16abb74bb5e9e40b2e5bf4c8a3
--- /dev/null
+++ b/crates/engine/tests/sandbox_recovery.rs
@@ -0,0 +1,403 @@
+//! Sandboxes going away and coming back (spec #37 "When things go wrong",
+//! docs/design/cloud-byo.md "Lifecycle"), at the engine's RPCs with a fake
+//! provider whose sandboxes run a second real engine, against a scripted
+//! edge:
+//!
+//! - deleting a chat deletes its sandbox and stops lending it tokens;
+//! - a subagent shares its parent's sandbox unless it asks for its own;
+//! - a sandbox deleted outside Zeron reads as gone, and Start fresh makes a
+//!   new one with the work pushed to the chat's branch;
+//! - a full disk is said as such, and Start fresh gets past it;
+//! - a chat deleted while its host device was off takes its sandbox with it
+//!   when the host device is back.
+//!
+//! The watchdog that restarts a crashed engine in a sandbox is tested in
+//! `zeron-cli` (`watchdog.rs`); here, Zeron starts its engine under it.
+
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/places.rs"]
+mod places;
+#[path = "support/scripted_edge.rs"]
+mod scripted_edge;
+
+use std::path::Path;
+use std::time::Duration;
+
+use fake_provider::FakeProvider;
+use places::{
+    SPACE, add_project, commit, create_on_place, eventually, git, host_device, origin, project,
+    ready, steps, steps_until,
+};
+use scripted_edge::ScriptedEdge;
+use serde_json::{Value, json};
+use zeron_rpc::{RpcClient, memory_client, methods};
+
+/// Whether the host device still lends a sign-in under `key`.
+async fn lends(rpc: &RpcClient, key: &str) -> bool {
+    rpc.call(methods::LEND_TOKEN, json!({ "key": key }))
+        .await
+        .is_ok()
+}
+
+async fn create_child(rpc: &RpcClient, chat: &str, parent: &str, extra: Value) -> Value {
+    let mut params = json!({
+        "op": "createChat",
+        "chatId": chat,
+        "spaceId": SPACE,
+        "parentChatId": parent,
+        "childKind": "subagent",
+    });
+    for (key, value) in extra.as_object().unwrap() {
+        params[key] = value.clone();
+    }
+    rpc.call(methods::MUTATE, params)
+        .await
+        .unwrap_or_else(|e| panic!("createChat {chat}: {e}"))
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_chat_deleted_while_its_host_device_was_off_loses_its_sandbox_when_it_is_back() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host_dir = dirs.path().join("host");
+    let host = host_device(&host_dir, &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    add_project(&rpc, &host, &project(dirs.path(), &origin_url)).await;
+    create_on_place(&rpc, "chat-a", "fake").await;
+    ready(&rpc, "chat-a").await;
+    assert_eq!(provider.sandboxes(), ["chat-a"]);
+    host.shutdown().await;
+    drop(rpc);
+    drop(host);
+
+    // While it's off, the chat is deleted on another device.
+    let phone = host_device(&dirs.path().join("phone"), &edge).await;
+    eventually(
+        "the other device has the chat",
+        Duration::from_secs(30),
+        async || phone.core().workspace.chat("chat-a").ok().flatten(),
+    )
+    .await;
+    memory_client(phone.core().rpc_service())
+        .call(
+            methods::MUTATE,
+            json!({ "op": "deleteChat", "chatId": "chat-a" }),
+        )
+        .await
+        .expect("deleteChat, on the other device");
+    assert_eq!(provider.sandboxes(), ["chat-a"]);
+
+    // The host device is back; it hears of the deletion before its
+    // providers are here (they connect after it starts). Once they are,
+    // the sandbox goes.
+    let host = host_device(&host_dir, &edge).await;
+    eventually(
+        "the host device hears the chat was deleted",
+        Duration::from_secs(30),
+        async || host.core().workspace.chat_deleted("chat-a").then_some(()),
+    )
+    .await;
+    host.core()
+        .sandboxes
+        .set_sleep_timings(zeron_engine::sandboxes::SleepTimings {
+            idle: Duration::from_secs(60 * 60),
+            time_limit: Duration::from_secs(60 * 60),
+            check_every: Duration::from_millis(250),
+        });
+    host.core().sandboxes.register(provider.clone());
+    eventually(
+        "the sandbox is deleted",
+        Duration::from_secs(30),
+        async || provider.sandboxes().is_empty().then_some(()),
+    )
+    .await;
+    assert!(host.core().sandboxes.steps("chat-a").is_none());
+    assert!(
+        provider.calls().contains(&"delete chat-a".to_owned()),
+        "{:?}",
+        provider.calls()
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn deleting_a_chat_deletes_its_sandbox_and_stops_lending_it_tokens() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    add_project(&rpc, &host, &project(dirs.path(), &origin_url)).await;
+
+    let created = create_on_place(&rpc, "chat-a", "fake").await;
+    let device = created["deviceId"].as_str().unwrap().to_owned();
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    ready(&rpc, "chat-a").await;
+    // Zeron started its engine under the watchdog.
+    assert_eq!(
+        provider.calls().last().unwrap(),
+        "run chat-a: zeron-engine watchdog"
+    );
+    let key = eventually(
+        "the sandbox's engine started",
+        Duration::from_secs(30),
+        async || provider.lent_key("chat-a"),
+    )
+    .await;
+    assert!(lends(&rpc, &key).await);
+
+    // A subagent its agent starts (through the sandbox's own engine, as the
+    // Zeron MCP does) shares the sandbox: its device and checkout.
+    let inside = eventually(
+        "the sandbox's engine is up",
+        Duration::from_secs(30),
+        async || provider.with_engine("chat-a", |core| memory_client(core.rpc_service())),
+    )
+    .await;
+    let sandbox_engine_sees_parent = async || {
+        provider
+            .with_engine("chat-a", |core| {
+                core.workspace.chat("chat-a").ok().flatten()
+            })
+            .flatten()
+            .map(|_| ())
+    };
+    eventually(
+        "the sandbox's engine has the chat",
+        Duration::from_secs(30),
+        sandbox_engine_sees_parent,
+    )
+    .await;
+    let sub = create_child(
+        &inside,
+        "chat-a-sub",
+        "chat-a",
+        json!({ "deviceId": device }),
+    )
+    .await;
+    assert_eq!(sub["deviceId"], device.as_str(), "{sub:#}");
+    assert_eq!(sub["cwd"], cwd.as_str(), "{sub:#}");
+    // So does a side chat started on the host device.
+    let side = create_child(
+        &rpc,
+        "chat-a-side",
+        "chat-a",
+        json!({ "childKind": "side" }),
+    )
+    .await;
+    assert_eq!(side["deviceId"], device.as_str(), "{side:#}");
+    assert_eq!(side["cwd"], cwd.as_str(), "{side:#}");
+    // A subagent that asks for a sandbox of its own gets one.
+    let own = create_child(
+        &rpc,
+        "chat-a-own",
+        "chat-a",
+        json!({ "place": { "provider": "fake" } }),
+    )
+    .await;
+    assert_ne!(own["deviceId"], device.as_str(), "{own:#}");
+    ready(&rpc, "chat-a-own").await;
+    assert_eq!(provider.sandboxes(), ["chat-a", "chat-a-own"]);
+
+    // The user deletes the chat: its sandbox goes, and its children's own.
+    rpc.call(
+        methods::MUTATE,
+        json!({ "op": "deleteChat", "chatId": "chat-a" }),
+    )
+    .await
+    .expect("deleteChat");
+    eventually(
+        "the sandboxes are deleted",
+        Duration::from_secs(30),
+        async || provider.sandboxes().is_empty().then_some(()),
+    )
+    .await;
+    let deletes: Vec<String> = provider
+        .calls()
+        .into_iter()
+        .filter(|c| c.starts_with("delete"))
+        .collect();
+    assert_eq!(deletes.len(), 2, "{deletes:#?}");
+    assert!(
+        deletes.contains(&"delete chat-a".to_owned()),
+        "{deletes:#?}"
+    );
+    assert!(
+        deletes.contains(&"delete chat-a-own".to_owned()),
+        "{deletes:#?}"
+    );
+    // Tokens stop: its next ask is refused.
+    assert!(!lends(&rpc, &key).await);
+    assert!(steps(&rpc, "chat-a").await.is_null());
+    // Nothing is left behind: no device list shows the sandboxes' devices
+    // (seen in a real Docker run, 2026-11-17: the row outlived its sandbox).
+    let own_device = own["deviceId"].as_str().unwrap().to_owned();
+    eventually(
+        "the sandboxes' devices leave the device list",
+        Duration::from_secs(30),
+        async || {
+            let rows = host.core().workspace.read_devices().ok()?;
+            rows.iter()
+                .all(|d| d.id != device && d.id != own_device)
+                .then_some(())
+        },
+    )
+    .await;
+    // Deleting it on another device deletes it here too (the rows sync):
+    // shown by the child's sandbox, whose row went with its parent's.
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_sandbox_deleted_outside_zeron_starts_fresh_with_its_pushed_work() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    add_project(&rpc, &host, &project(dirs.path(), &origin_url)).await;
+
+    let created = create_on_place(&rpc, "chat-b", "fake").await;
+    let device = created["deviceId"].as_str().unwrap().to_owned();
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    ready(&rpc, "chat-b").await;
+    let key = eventually(
+        "the sandbox's engine started",
+        Duration::from_secs(30),
+        async || provider.lent_key("chat-b"),
+    )
+    .await;
+
+    // The agent pushes some work, and leaves some unpushed.
+    let checkout = Path::new(&cwd);
+    std::fs::write(checkout.join("pushed.txt"), "kept\n").unwrap();
+    commit(checkout, "pushed work");
+    git(checkout, &["push", "-q", "origin", "zeron/chat-b"]);
+    std::fs::write(checkout.join("unpushed.txt"), "lost\n").unwrap();
+    commit(checkout, "unpushed work");
+
+    // While it's there, checking finds it so.
+    async fn check(rpc: &RpcClient) -> Value {
+        rpc.call(methods::CHECK_SANDBOX, json!({ "chatId": "chat-b" }))
+            .await
+            .expect("CheckSandbox")
+    }
+    assert_eq!(check(&rpc).await["state"], "ready");
+
+    // The user deletes it in the provider's console. Opening the chat
+    // finds it gone: "Sandbox deleted", with Start fresh.
+    provider.delete_outside("chat-b").await;
+    let gone = check(&rpc).await;
+    assert_eq!(gone["state"], "gone", "{gone:#}");
+    assert!(
+        gone["error"]
+            .as_str()
+            .unwrap_or_default()
+            .contains("deleted"),
+        "{gone:#}"
+    );
+    assert_eq!(steps(&rpc, "chat-b").await["state"], "gone");
+    // Nothing is lent to a sandbox that's gone.
+    assert!(!lends(&rpc, &key).await);
+
+    rpc.call(methods::START_SANDBOX_FRESH, json!({ "chatId": "chat-b" }))
+        .await
+        .expect("Start fresh");
+    let fresh = ready(&rpc, "chat-b").await;
+    assert!(fresh["error"].is_null(), "{fresh:#}");
+    assert_eq!(fresh["deviceId"], device.as_str());
+    assert_eq!(provider.sandboxes(), ["chat-b"]);
+    assert_eq!(
+        provider.calls().iter().filter(|c| *c == "create").count(),
+        2,
+        "{:#?}",
+        provider.calls()
+    );
+    // Gone already: nothing to delete.
+    assert!(
+        !provider.calls().iter().any(|c| c.starts_with("delete")),
+        "{:#?}",
+        provider.calls()
+    );
+
+    // The chat keeps its device and checkout; what was pushed came back on
+    // its branch, what wasn't is lost.
+    let row = host.core().workspace.chat("chat-b").unwrap().unwrap();
+    assert_eq!(row.device_id, device);
+    assert_eq!(row.cwd.as_deref(), Some(cwd.as_str()));
+    assert_eq!(git(checkout, &["branch", "--show-current"]), "zeron/chat-b");
+    assert!(checkout.join("pushed.txt").exists());
+    assert!(!checkout.join("unpushed.txt").exists());
+    // Its new engine is lent a sign-in afresh and comes online as the chat's
+    // host.
+    let fresh_key = eventually(
+        "the new engine started",
+        Duration::from_secs(30),
+        async || provider.lent_key("chat-b"),
+    )
+    .await;
+    assert_ne!(fresh_key, key);
+    assert!(lends(&rpc, &fresh_key).await);
+    eventually(
+        "the new engine hosts the chat's device",
+        Duration::from_secs(30),
+        async || edge.host_connected(&device).then_some(()),
+    )
+    .await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_full_disk_is_said_in_the_chat_and_start_fresh_gets_past_it() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    add_project(&rpc, &host, &project(dirs.path(), &origin_url)).await;
+
+    provider.set_disk_full(true);
+    create_on_place(&rpc, "chat-d", "fake").await;
+    let failed = steps_until(&rpc, "chat-d", Duration::from_secs(30), |s| {
+        s["state"] == "failed"
+    })
+    .await;
+    assert_eq!(failed["step"], "getCode", "{failed:#}");
+    assert_eq!(failed["diskFull"], true, "{failed:#}");
+    let error = failed["error"].as_str().unwrap_or_default();
+    assert!(
+        error.starts_with("The sandbox's disk is full."),
+        "{failed:#}"
+    );
+    assert!(error.contains("No space left on device"), "{failed:#}");
+
+    // Start fresh: the full sandbox is deleted, and a new one made.
+    provider.set_disk_full(false);
+    rpc.call(methods::START_SANDBOX_FRESH, json!({ "chatId": "chat-d" }))
+        .await
+        .expect("Start fresh");
+    let fresh = ready(&rpc, "chat-d").await;
+    assert_eq!(fresh["diskFull"], false, "{fresh:#}");
+    let calls = provider.calls();
+    assert_eq!(
+        calls.iter().filter(|c| *c == "create").count(),
+        2,
+        "{calls:#?}"
+    );
+    assert_eq!(
+        calls.iter().filter(|c| *c == "delete chat-d").count(),
+        1,
+        "{calls:#?}"
+    );
+}
diff --git a/crates/engine/tests/sandbox_sleep.rs b/crates/engine/tests/sandbox_sleep.rs
new file mode 100644
index 0000000000000000000000000000000000000000..85ac84b11b67cfc345e4ad4e3ea150da63388d16
--- /dev/null
+++ b/crates/engine/tests/sandbox_sleep.rs
@@ -0,0 +1,388 @@
+//! Sleep and wake (spec #37 ticket #43, docs/design/cloud-byo.md "Waking"),
+//! at the engine's RPCs with the fake provider: a sandbox idle (or its chat
+//! archived) winds its engine down and stops; the host device stands in for
+//! it in its device room and wakes it only for a queued send, from whichever
+//! client sent it; it extends the time limit while a chat is busy.
+//!
+//! The edge is scripted: device rooms (with the 4409 a second host gets, and
+//! nudges queued and replayed as production's front worker leaves them:
+//! deleted as they're sent), sign-in refresh and a shared registry. It has
+//! no chat rooms, so a send reaches a sandbox by the sender's relay escort.
+
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/places.rs"]
+mod places;
+#[path = "support/scripted_edge.rs"]
+mod scripted_edge;
+
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use fake_provider::FakeProvider;
+use places::{
+    add_project, create_on_place, eventually, host_device, origin, project, ready, send, steps,
+    steps_until,
+};
+use scripted_edge::ScriptedEdge;
+use serde_json::{Value, json};
+use zeron_doc::{MessageRole, MessageStatus, SessionCommandPayload};
+use zeron_engine::EngineRuntime;
+use zeron_engine::sandboxes::SleepTimings;
+use zeron_proto::{AccessMode, HarnessId, RunRequest, SandboxLevel, SessionStatus};
+use zeron_rpc::{RpcClient, memory_client, methods};
+
+const MINUTE: Duration = Duration::from_secs(60);
+
+/// Quick to sleep: idle 2 s, looked at four times a second.
+fn drowsy() -> SleepTimings {
+    SleepTimings {
+        idle: Duration::from_secs(2),
+        time_limit: Duration::from_secs(30 * 60),
+        check_every: Duration::from_millis(250),
+    }
+}
+
+/// Awake unless something puts it to sleep (archiving, its time limit).
+fn wakeful() -> SleepTimings {
+    SleepTimings {
+        idle: Duration::from_secs(60 * 60),
+        ..drowsy()
+    }
+}
+
+struct World {
+    edge: ScriptedEdge,
+    dirs: tempfile::TempDir,
+    host: EngineRuntime,
+    rpc: RpcClient,
+    provider: Arc<FakeProvider>,
+    chat: String,
+    device: String,
+    cwd: String,
+}
+
+/// A chat on the fake cloud whose first message (sent from the host
+/// device) ran on its sandbox. It stays awake until a test lets it sleep
+/// (a message reaches a sandbox some seconds after it's sent).
+async fn world(chat: &str) -> World {
+    let _ = tracing_subscriber::fmt()
+        .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())
+        .with_test_writer()
+        .try_init();
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    host.core().sandboxes.set_sleep_timings(wakeful());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+    let created = create_on_place(&rpc, chat, "fake").await;
+    let device = created["deviceId"].as_str().unwrap().to_owned();
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    host.core().workspace.rename_chat(chat, "Pre-titled").unwrap();
+    send(&rpc, chat, &format!("{chat}-first"), &cwd, "hello sandbox").await;
+    ready(&rpc, chat).await;
+    replied(&provider, chat, &format!("{chat}-first"), MINUTE).await;
+    World {
+        edge,
+        dirs,
+        host,
+        rpc,
+        provider,
+        chat: chat.to_owned(),
+        device,
+        cwd,
+    }
+}
+
+/// The message ran on the sandbox's engine: its transcript holds it and a
+/// finished reply after it.
+async fn replied(provider: &FakeProvider, chat: &str, message_id: &str, within: Duration) {
+    eventually(&format!("{message_id} ran on {chat}"), within, async || {
+        let entries = provider
+            .with_engine(chat, |core| {
+                core.doc_host
+                    .open(chat)
+                    .ok()
+                    .and_then(|h| h.doc().read_entries().ok())
+                    .unwrap_or_default()
+            })
+            .unwrap_or_default();
+        let asked = entries
+            .iter()
+            .position(|e| e.role == MessageRole::User && e.id == message_id)?;
+        entries[asked..]
+            .iter()
+            .any(|e| e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Complete))
+            .then_some(())
+    })
+    .await;
+}
+
+impl World {
+    fn timings(&self, timings: SleepTimings) {
+        self.host.core().sandboxes.set_sleep_timings(timings);
+    }
+}
+
+async fn asleep(w: &World) -> Value {
+    steps_until(&w.rpc, &w.chat, MINUTE, |s| {
+        assert!(s["state"] != "failed" && s["state"] != "gone", "{s:#}");
+        s["state"] == "asleep"
+    })
+    .await
+}
+
+fn count(calls: &[String], call: &str) -> usize {
+    calls.iter().filter(|c| *c == call).count()
+}
+
+/// The host device holds the sandbox's room for it.
+async fn stood_in_for(w: &World) {
+    eventually("the host device stands in", Duration::from_secs(20), async || {
+        w.edge.host_connected(&w.device).then_some(())
+    })
+    .await;
+}
+
+/// Nothing woke it: still asleep, never started again.
+async fn stays_asleep(w: &World, starts: usize, over: Duration) {
+    let until = Instant::now() + over;
+    while Instant::now() < until {
+        let now = steps(&w.rpc, &w.chat).await;
+        assert_eq!(now["state"], "asleep", "{now:#}");
+        assert_eq!(
+            count(&w.provider.calls(), &format!("start {}", w.chat)),
+            starts,
+            "{:#?}",
+            w.provider.calls()
+        );
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    }
+}
+
+/// Awake again: ready, started once more, its engine back in its room.
+async fn awake(w: &World, starts: usize) {
+    steps_until(&w.rpc, &w.chat, MINUTE, |s| {
+        assert!(s["state"] != "failed" && s["state"] != "gone", "{s:#}");
+        s["state"] == "ready"
+    })
+    .await;
+    assert_eq!(
+        count(&w.provider.calls(), &format!("start {}", w.chat)),
+        starts,
+        "{:#?}",
+        w.provider.calls()
+    );
+    assert!(w.provider.with_engine(&w.chat, |_| ()).is_some());
+}
+
+/// The stand-in stepped aside for the sandbox's engine and stays out: no
+/// host joins the room again (each would 4409 the other). The host device
+/// looks at the sandbox twice more and finds it awake each time (it asks
+/// the provider how it is only then), so it starts no stand-in.
+async fn no_host_fight(w: &World) {
+    let joins = w.edge.host_dials(&w.device).len();
+    let looked = w.provider.statuses();
+    eventually("the host device looks at it twice more", MINUTE, async || {
+        (w.provider.statuses() >= looked + 2).then_some(())
+    })
+    .await;
+    assert_eq!(w.edge.host_dials(&w.device).len(), joins);
+    assert!(w.edge.host_connected(&w.device));
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn an_idle_sandbox_sleeps_a_reader_doesnt_wake_it_and_a_send_does() {
+    let w = world("chat-idle").await;
+    w.timings(drowsy());
+
+    // Idle: its engine winds down, then the provider stops it.
+    asleep(&w).await;
+    let calls = w.provider.calls();
+    let quiesced = calls
+        .iter()
+        .position(|c| c == "run chat-idle: zeron-engine quiesce")
+        .unwrap_or_else(|| panic!("{calls:#?}"));
+    let stopped = calls
+        .iter()
+        .position(|c| c == "stop chat-idle")
+        .unwrap_or_else(|| panic!("{calls:#?}"));
+    assert!(quiesced < stopped, "{calls:#?}");
+    assert!(w.provider.with_engine("chat-idle", |_| ()).is_none());
+    stood_in_for(&w).await;
+    w.timings(wakeful());
+
+    // Someone opens the chat: the chat room nudges its host. A nudge with
+    // no queued send leaves it asleep.
+    assert_eq!(w.edge.post_nudge(&w.device, "chat-idle").await, 200);
+    stays_asleep(&w, 1, Duration::from_secs(12)).await;
+
+    // A send wakes it, and the message runs.
+    send(&w.rpc, "chat-idle", "chat-idle-second", &w.cwd, "again").await;
+    awake(&w, 2).await;
+    replied(&w.provider, "chat-idle", "chat-idle-second", 2 * MINUTE).await;
+    no_host_fight(&w).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_send_from_a_client_that_never_talks_to_the_host_device_wakes_it() {
+    let w = world("chat-far").await;
+    // Another of the user's devices, which knows the chat from the registry.
+    let laptop = host_device(&w.dirs.path().join("laptop"), &w.edge).await;
+    let laptop_rpc = memory_client(laptop.core().rpc_service());
+    eventually("the laptop knows the chat", MINUTE, async || {
+        laptop
+            .core()
+            .workspace
+            .chat("chat-far")
+            .ok()
+            .flatten()
+            .filter(|row| row.device_id == w.device)
+    })
+    .await;
+
+    w.timings(drowsy());
+    asleep(&w).await;
+    stood_in_for(&w).await;
+    w.timings(wakeful());
+    let host_device = w.host.core().device_id.clone();
+    let asked_host = w.edge.client_dials(&host_device).len();
+
+    send(&laptop_rpc, "chat-far", "chat-far-laptop", &w.cwd, "from afar").await;
+    awake(&w, 2).await;
+    replied(&w.provider, "chat-far", "chat-far-laptop", 2 * MINUTE).await;
+    // The laptop's send reached the sandbox's room only: nobody dialed the
+    // host device's own room for it.
+    assert_eq!(
+        w.edge.client_dials(&host_device).len(),
+        asked_host,
+        "the host device's room was dialed"
+    );
+    no_host_fight(&w).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn archiving_puts_it_to_sleep_unarchiving_doesnt_wake_it_and_wake_does() {
+    let w = world("chat-shelf").await;
+    let archive = |archived: bool| {
+        w.rpc.call(
+            methods::MUTATE,
+            json!({ "op": "setChatArchived", "chatId": "chat-shelf", "archived": archived }),
+        )
+    };
+
+    archive(true).await.expect("archive");
+    asleep(&w).await;
+    stood_in_for(&w).await;
+
+    archive(false).await.expect("unarchive");
+    stays_asleep(&w, 1, Duration::from_secs(3)).await;
+
+    // Files, Terminal and Diffs offer Wake.
+    w.rpc
+        .call(methods::WAKE_SANDBOX, json!({ "chatId": "chat-shelf" }))
+        .await
+        .expect("Wake");
+    awake(&w, 2).await;
+    no_host_fight(&w).await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_busy_chat_keeps_its_sandbox_awake_and_a_stopped_sandbox_is_stood_in_for() {
+    let w = world("chat-busy").await;
+    // A turn waiting on the person (approve a command) keeps the chat busy.
+    let command = serde_json::to_value(SessionCommandPayload::Run {
+        request: RunRequest {
+            mcp: None,
+            prompt: "run the tests".into(),
+            harness: Some(HarnessId::Mock),
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            cwd: w.cwd.clone(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            auto_approve: false,
+            access: AccessMode::Supervised,
+            plan: false,
+            attachments: Vec::new(),
+            worktree: None,
+            resume: None,
+            env: Default::default(),
+            extra_mcp: Vec::new(),
+        },
+        message_id: "chat-busy-ask".into(),
+    })
+    .unwrap();
+    w.rpc
+        .call(
+            methods::QUEUE_COMMAND,
+            json!({ "chatId": "chat-busy", "command": command }),
+        )
+        .await
+        .expect("queue");
+
+    // The turn reached the sandbox and waits on the person.
+    eventually("the chat waits on the person", 2 * MINUTE, async || {
+        w.host
+            .core()
+            .workspace
+            .read_sessions()
+            .ok()?
+            .into_iter()
+            .find(|s| s.chat_id == "chat-busy" && s.status == SessionStatus::AwaitingInput)
+            .map(drop)
+    })
+    .await;
+    // Busy: its time limit is pushed out, and it stays awake past its idle
+    // time.
+    // (A time limit of 3 s: extended again each second it's busy.)
+    let before = w.provider.extends().len();
+    w.timings(SleepTimings {
+        time_limit: Duration::from_secs(3),
+        ..drowsy()
+    });
+    eventually("the time limit is extended", MINUTE, async || {
+        w.provider.extends()[before..]
+            .contains(&"chat-busy 3".to_owned())
+            .then_some(())
+    })
+    .await;
+    // Extended three more times, a third of its limit apart: past its time
+    // limit and its idle time, found busy (not idle) each time.
+    let extended = w.provider.extends().len();
+    eventually("busy past its time limit", MINUTE, async || {
+        (w.provider.extends()[extended..]
+            .iter()
+            .filter(|e| *e == "chat-busy 3")
+            .count()
+            >= 3)
+            .then_some(())
+    })
+    .await;
+    let now = steps(&w.rpc, "chat-busy").await;
+    assert_eq!(now["state"], "ready", "{now:#}");
+    assert!(
+        !w.provider.calls().contains(&"stop chat-busy".to_owned()),
+        "{:#?}",
+        w.provider.calls()
+    );
+
+    // The time limit runs out anyway (the host device was away): the
+    // sandbox stops itself, and the host device stands in for it.
+    w.provider.sleep("chat-busy").await;
+    asleep(&w).await;
+    stood_in_for(&w).await;
+}
+
+#[test]
+fn sleep_timings_default_to_the_design() {
+    let timings = SleepTimings::default();
+    assert_eq!(timings.idle, Duration::from_secs(10 * 60));
+    assert_eq!(timings.time_limit, Duration::from_secs(30 * 60));
+}
diff --git a/crates/engine/tests/sandbox_template.rs b/crates/engine/tests/sandbox_template.rs
new file mode 100644
index 0000000000000000000000000000000000000000..67e7ce78954f59bad1a4a9f74ed67a4a42c68724
--- /dev/null
+++ b/crates/engine/tests/sandbox_template.rs
@@ -0,0 +1,280 @@
+//! Save as template (spec #37, docs/design/cloud-byo.md "What's in a
+//! sandbox"), at the engine's RPCs with a fake provider whose sandboxes run
+//! a second real engine, against a scripted edge:
+//!
+//! - the chat's sandbox is saved through the provider under the name given,
+//!   and the template is then among the provider's templates (the picker's);
+//! - Zeron's identity (its device id and data) is wiped from what's saved,
+//!   and no sign-in is in it: the lent token and its key are nowhere on the
+//!   saved disk, and a sandbox made from the template takes a device id of
+//!   its own;
+//! - the chat goes on afterwards on the same device;
+//! - a place that can't wipe or save is refused, saving nothing.
+
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/places.rs"]
+mod places;
+#[path = "support/scripted_edge.rs"]
+mod scripted_edge;
+
+use std::path::Path;
+use std::time::Duration;
+
+use fake_provider::FakeProvider;
+use places::{
+    ORG, SPACE, add_project, create_on_place, eventually, host_device, origin, project, ready, send,
+};
+use scripted_edge::ScriptedEdge;
+use serde_json::{Value, json};
+use zeron_doc::{MessageRole, MessageStatus};
+use zeron_rpc::{RpcClient, memory_client, methods};
+
+/// The chat's messages that ran on `sandbox`'s engine: user messages with an
+/// id in `ids` and finished replies, counted.
+async fn replies(provider: &FakeProvider, sandbox: &str, chat: &str, message: &str) {
+    eventually(
+        &format!("{message} ran on {sandbox}"),
+        Duration::from_secs(60),
+        async || {
+            let entries = provider.with_engine(sandbox, |core| {
+                core.doc_host
+                    .open(chat)
+                    .ok()
+                    .and_then(|h| h.doc().read_entries().ok())
+                    .unwrap_or_default()
+            })?;
+            let at = entries
+                .iter()
+                .position(|e| e.role == MessageRole::User && e.id == message)?;
+            entries[at..]
+                .iter()
+                .any(|e| {
+                    e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Complete)
+                })
+                .then_some(())
+        },
+    )
+    .await;
+}
+
+async fn save(rpc: &RpcClient, chat: &str, name: &str) -> Result<Value, String> {
+    rpc.call(
+        methods::SAVE_SANDBOX_TEMPLATE,
+        json!({ "chatId": chat, "name": name }),
+    )
+    .await
+    .map_err(|e| e.to_string())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_saved_template_leaves_zerons_identity_and_sign_in_behind() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    let created = create_on_place(&rpc, "chat-a", "fake").await;
+    let device_a = created["deviceId"].as_str().unwrap().to_owned();
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    host.core()
+        .workspace
+        .rename_chat("chat-a", "Pre-titled")
+        .unwrap();
+    send(&rpc, "chat-a", "chat-a-1", &cwd, "set it up").await;
+    ready(&rpc, "chat-a").await;
+    replies(&provider, "chat-a", "chat-a", "chat-a-1").await;
+
+    // What the sandbox has besides Zeron's own data: the release Zeron
+    // installed, and the user's work in the checkout.
+    let data = provider.data_dir("chat-a").expect("its engine's data");
+    assert!(data.join("device-id").exists());
+    let release = data.join("app").join("1.2.3");
+    std::fs::create_dir_all(&release).unwrap();
+    std::fs::write(release.join("zeron-engine"), "the release").unwrap();
+    std::fs::write(Path::new(&cwd).join("NOTES.md"), "work\n").unwrap();
+    let (lent_key, lent_token) = provider.lent("chat-a").expect("a lent sign-in");
+
+    let saved = save(&rpc, "chat-a", " reportly-dev ").await.expect("saved");
+    let template = saved["template"].clone();
+    assert_eq!(template["name"], "reportly-dev", "{saved:#}");
+    let id = template["id"].as_str().expect("its id").to_owned();
+
+    // Zeron stopped and wiped itself, the provider saved it, and Zeron
+    // started again, in that order.
+    let calls = provider.calls();
+    let at = |what: &str| {
+        calls
+            .iter()
+            .rposition(|c| c == what)
+            .unwrap_or_else(|| panic!("{what}: {calls:#?}"))
+    };
+    let forgot = at("run chat-a: zeron-engine forget-device");
+    let snapshot = at("save chat-a: reportly-dev");
+    let restarted = at("run chat-a: zeron-engine watchdog");
+    assert!(forgot < snapshot && snapshot < restarted, "{calls:#?}");
+
+    // What was saved: no device id, no data, no sign-in; the release kept.
+    let files = provider.template_files(&id);
+    let names: Vec<&str> = files.iter().map(|(name, _)| name.as_str()).collect();
+    assert!(
+        names.contains(&"zeron-data/app/1.2.3/zeron-engine"),
+        "{names:#?}"
+    );
+    for (name, _) in &files {
+        let inside = name.trim_start_matches("zeron-data/");
+        for gone in [
+            "device-id",
+            "session.json",
+            "orgs",
+            "profiles",
+            "local-profile.json",
+            "ipc-token",
+            "engine.lock",
+            "plugin-signing-key",
+            "logs",
+            "watchdog",
+        ] {
+            assert!(!inside.starts_with(gone), "{name} was saved");
+        }
+    }
+    for (name, contents) in &files {
+        let text = String::from_utf8_lossy(contents);
+        assert!(
+            !text.contains(&lent_token) && !text.contains(&lent_key),
+            "the lent sign-in is in {name}"
+        );
+    }
+    assert!(names.contains(&"home/reportly/NOTES.md"), "{names:#?}");
+
+    // The template is in the picker.
+    let listed = rpc
+        .call(
+            methods::LIST_SANDBOX_TEMPLATES,
+            json!({ "provider": "fake" }),
+        )
+        .await
+        .expect("ListSandboxTemplates");
+    assert!(
+        listed
+            .as_array()
+            .unwrap()
+            .contains(&json!({ "id": id, "name": "reportly-dev" })),
+        "{listed:#}"
+    );
+
+    // The chat goes on, on the same device.
+    assert_eq!(
+        std::fs::read_to_string(data.join("device-id"))
+            .ok()
+            .as_deref(),
+        Some(device_a.as_str())
+    );
+    send(&rpc, "chat-a", "chat-a-2", &cwd, "and now").await;
+    replies(&provider, "chat-a", "chat-a", "chat-a-2").await;
+    assert_eq!(
+        rpc.call(methods::SANDBOX_STEPS, json!({ "chatId": "chat-a" }))
+            .await
+            .unwrap()["state"],
+        "ready"
+    );
+
+    // A chat on the template gets a sandbox with a device id of its own.
+    let created = rpc
+        .call(
+            methods::MUTATE,
+            json!({
+                "op": "createChat", "chatId": "chat-b", "spaceId": SPACE,
+                "place": { "provider": "fake", "template": id },
+            }),
+        )
+        .await
+        .expect("createChat on the template");
+    let device_b = created["deviceId"].as_str().unwrap().to_owned();
+    assert_ne!(device_b, device_a);
+    ready(&rpc, "chat-b").await;
+    let data_b = provider.data_dir("chat-b").unwrap();
+    assert!(
+        data_b.join("app/1.2.3/zeron-engine").exists(),
+        "from the template"
+    );
+    assert_eq!(
+        std::fs::read_to_string(data_b.join("device-id"))
+            .ok()
+            .as_deref(),
+        Some(device_b.as_str())
+    );
+    let dials = edge.host_dials(&device_b);
+    assert!(
+        !dials.is_empty() && dials.iter().all(|d| d.org.as_deref() == Some(ORG)),
+        "{dials:?}"
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn what_cant_be_saved_safely_is_refused() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    // A chat not on a place.
+    let err = save(&rpc, "nowhere", "x").await.unwrap_err();
+    assert!(err.contains("sandbox"), "{err}");
+
+    // An SSH box can't save templates.
+    let ssh = FakeProvider::run_only(&dirs.path().join("ssh"));
+    host.core().sandboxes.register(ssh.clone());
+    let created = create_on_place(&rpc, "chat-ssh", "fake-ssh").await;
+    host.core()
+        .workspace
+        .rename_chat("chat-ssh", "Pre-titled")
+        .unwrap();
+    send(
+        &rpc,
+        "chat-ssh",
+        "m1",
+        created["cwd"].as_str().unwrap(),
+        "hi",
+    )
+    .await;
+    ready(&rpc, "chat-ssh").await;
+    let err = save(&rpc, "chat-ssh", "box").await.unwrap_err();
+    assert!(err.contains("can't save templates"), "{err}");
+    assert!(
+        !ssh.calls().iter().any(|c| c.contains("forget-device")),
+        "{:#?}",
+        ssh.calls()
+    );
+
+    // A blank name.
+    let cloud = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(cloud.clone());
+    let created = create_on_place(&rpc, "chat-c", "fake").await;
+    host.core()
+        .workspace
+        .rename_chat("chat-c", "Pre-titled")
+        .unwrap();
+    send(&rpc, "chat-c", "m2", created["cwd"].as_str().unwrap(), "hi").await;
+    ready(&rpc, "chat-c").await;
+    let err = save(&rpc, "chat-c", "  ").await.unwrap_err();
+    assert!(err.contains("name"), "{err}");
+    let err = save(&rpc, "chat-c", "a/b").await.unwrap_err();
+    assert!(err.contains("name"), "{err}");
+    assert!(cloud.saved().is_empty());
+    assert!(
+        !cloud.calls().iter().any(|c| c.contains("forget-device")),
+        "{:#?}",
+        cloud.calls()
+    );
+}
diff --git a/crates/engine/tests/step_scripts.rs b/crates/engine/tests/step_scripts.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a1e1c8ece151d0bdc9f4ab0341e928520267f53c
--- /dev/null
+++ b/crates/engine/tests/step_scripts.rs
@@ -0,0 +1,584 @@
+//! Step scripts (spec #37, docs/design/cloud-byo.md "Step scripts"), at the
+//! engine's RPCs with the fake provider: the user's own scripts, stored on
+//! the host device, run before, after or instead of a sandbox's steps, for
+//! all sandboxes, one provider or one repo. Each runs in the sandbox when
+//! it's up for that moment and on the host device otherwise, in name order.
+//! A failing one doesn't hold the chat up: the sandbox gets ready, the chat
+//! says which script failed and why, and Run again runs it again.
+//!
+//! What's asserted is what a user sees: what the scripts wrote (their own
+//! log, files in the sandbox), what the provider was asked to run, the
+//! steps' progress and the chat's first message running.
+//!
+//! The scripts are shell scripts; on Windows they run in Git's `sh`.
+
+#[path = "support/fake_provider.rs"]
+mod fake_provider;
+#[path = "support/places.rs"]
+mod places;
+#[path = "support/scripted_edge.rs"]
+mod scripted_edge;
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use fake_provider::FakeProvider;
+use places::{
+    SPACE, add_project, create_on_place, eventually, host_device, origin, project, ready,
+    steps_until,
+};
+use scripted_edge::ScriptedEdge;
+use serde_json::{Value, json};
+use zeron_doc::{MessageRole, MessageStatus};
+use zeron_engine::sandboxes::SandboxProvider;
+use zeron_rpc::{RpcClient, memory_client, methods};
+
+/// Send the chat's first message (`<chat>-first`).
+async fn send(rpc: &RpcClient, chat: &str, cwd: &str, prompt: &str) {
+    places::send(rpc, chat, &format!("{chat}-first"), cwd, prompt).await;
+}
+
+fn expect_states(steps: &Value, expected: &[(&str, &str)]) {
+    let got: Vec<(String, String)> = steps["steps"]
+        .as_array()
+        .expect("steps")
+        .iter()
+        .map(|s| {
+            (
+                s["step"].as_str().unwrap().to_owned(),
+                s["state"].as_str().unwrap().to_owned(),
+            )
+        })
+        .collect();
+    let expected: Vec<(String, String)> = expected
+        .iter()
+        .map(|(a, b)| (a.to_string(), b.to_string()))
+        .collect();
+    assert_eq!(got, expected, "{steps:#}");
+}
+
+async fn replied(provider: &FakeProvider, sandbox: &str, chat: &str, within: Duration) {
+    let deadline = Instant::now() + within;
+    loop {
+        let entries = provider
+            .with_engine(sandbox, |core| {
+                core.doc_host
+                    .open(chat)
+                    .ok()
+                    .and_then(|h| h.doc().read_entries().ok())
+                    .unwrap_or_default()
+            })
+            .unwrap_or_default();
+        let asked = entries
+            .iter()
+            .any(|e| e.role == MessageRole::User && e.id == format!("{chat}-first"));
+        let answered = entries
+            .iter()
+            .any(|e| e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Complete));
+        if asked && answered {
+            return;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "{chat}'s first message never ran on {sandbox}: {} entries",
+            entries.len()
+        );
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    }
+}
+
+/// A path as a shell script spells it (`C:/Users/…` on Windows).
+fn sh(path: &Path) -> String {
+    path.to_string_lossy().replace('\\', "/")
+}
+
+/// Write a script file, making its folders.
+fn script(path: &Path, body: &str) {
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, format!("#!/bin/sh\n{body}\n")).unwrap();
+}
+
+/// The lines the scripts appended to `log`.
+fn lines(log: &Path) -> Vec<String> {
+    std::fs::read_to_string(log)
+        .unwrap_or_default()
+        .lines()
+        .map(|l| l.trim().to_owned())
+        .filter(|l| !l.is_empty())
+        .collect()
+}
+
+/// The index of the first provider call containing `needle`.
+fn call_at(calls: &[String], needle: &str) -> usize {
+    calls
+        .iter()
+        .position(|c| c.contains(needle))
+        .unwrap_or_else(|| panic!("no call with {needle:?}: {calls:#?}"))
+}
+
+/// Save a script through `WriteStepScript`, as Settings does.
+async fn write(
+    rpc: &RpcClient,
+    scope: Value,
+    hook: &str,
+    name: &str,
+    content: &str,
+) -> Result<Value, String> {
+    let params = json!({ "for": scope, "hook": hook, "name": name, "content": content });
+    rpc.call(methods::WRITE_STEP_SCRIPT, params)
+        .await
+        .map_err(|e| format!("{e:?}"))
+}
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn scripts_run_where_their_moment_says_in_name_order() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host_dir = dirs.path().join("host");
+    let host = host_device(&host_dir, &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    let log = dirs.path().join("order.log");
+    let log_sh = sh(&log);
+    let note = |label: &str| format!("echo {label} >> \"{log_sh}\"");
+    let steps_dir = host_dir.join("steps");
+    // Every sandbox (the user's steps folder).
+    script(
+        &steps_dir.join("before-create/a.sh"),
+        &format!("echo \"before-create sandbox=[$ZERON_SANDBOX]\" >> \"{log_sh}\""),
+    );
+    script(
+        &steps_dir.join("after-create/b.sh"),
+        &format!(
+            "echo \"after-create $ZERON_PROVIDER $ZERON_SANDBOX $ZERON_CHAT $ZERON_REPO\" >> \"{log_sh}\"\n\
+             zeron-sandbox 'echo from-host > made-by-host.txt' || exit 1"
+        ),
+    );
+    script(
+        &steps_dir.join("after-start/c.sh"),
+        &format!("{}\ntouch after-start-ran", note("after-start")),
+    );
+    script(
+        &steps_dir.join("instead-of-secrets/s.sh"),
+        &note("instead-of-secrets"),
+    );
+    script(&steps_dir.join("after-setup/10-x.sh"), &note("10-x"));
+    script(&steps_dir.join("after-setup/30-z.sh"), &note("30-z"));
+    // Only this provider's sandboxes, and not another's.
+    script(&steps_dir.join("fake/after-setup/20-y.sh"), &note("20-y"));
+    script(
+        &steps_dir.join("fake-other/after-setup/no.sh"),
+        &note("other-provider"),
+    );
+    // Not this moment.
+    script(&steps_dir.join("after-wake/w.sh"), &note("after-wake"));
+    // The repo's own.
+    script(
+        &path.join(".zeron/setup.sh"),
+        &format!("{}\ntouch setup-ran", note("setup.sh")),
+    );
+    script(
+        &path.join(".zeron/before-ready/r.sh"),
+        &note("before-ready"),
+    );
+
+    let created = create_on_place(&rpc, "chat-a", "fake").await;
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    host.core()
+        .workspace
+        .rename_chat("chat-a", "Pre-titled")
+        .unwrap();
+    send(&rpc, "chat-a", &cwd, "hello scripts").await;
+
+    let done = ready(&rpc, "chat-a").await;
+    expect_states(
+        &done,
+        &[
+            ("create", "done"),
+            ("start", "done"),
+            ("installZeron", "skipped"),
+            ("signIn", "done"),
+            // A script did it instead.
+            ("secrets", "done"),
+            ("getCode", "done"),
+            // The repo's setup.sh ran.
+            ("setup", "done"),
+            ("ready", "done"),
+        ],
+    );
+    assert_eq!(done["scripts"], json!([]), "{done:#}");
+
+    // In order: each moment's scripts by name, whatever folder they're in.
+    let ran = lines(&log);
+    assert_eq!(ran.len(), 9, "{ran:#?}");
+    assert_eq!(ran[0], "before-create sandbox=[]");
+    let after_create = &ran[1];
+    assert!(
+        after_create.starts_with("after-create fake chat-a chat-a ")
+            && after_create.contains("origin.git"),
+        "provider, sandbox, chat and repo: {after_create}"
+    );
+    assert_eq!(
+        &ran[2..],
+        [
+            "after-start",
+            "instead-of-secrets",
+            "setup.sh",
+            "10-x",
+            "20-y",
+            "30-z",
+            "before-ready"
+        ]
+    );
+
+    // Where: the host-side ones never went through the provider; the
+    // others ran in the sandbox, after it started and before Zeron did.
+    let calls = provider.calls();
+    for host_side in ["before-create/a.sh", "after-create/b.sh"] {
+        assert!(
+            !calls.iter().any(|c| c.contains(host_side)),
+            "{host_side} ran on the host device: {calls:#?}"
+        );
+    }
+    let start = call_at(&calls, "start chat-a");
+    let engine = call_at(&calls, "zeron-engine watchdog");
+    let mut last = start;
+    for in_sandbox in [
+        "after-start/c.sh",
+        "instead-of-secrets/s.sh",
+        "reportly/.zeron/setup.sh",
+        "after-setup/10-x.sh",
+        "fake/after-setup/20-y.sh",
+        "after-setup/30-z.sh",
+        "reportly/.zeron/before-ready/r.sh",
+    ] {
+        let at = call_at(&calls, in_sandbox);
+        assert!(at > last && at < engine, "{in_sandbox}: {calls:#?}");
+        last = at;
+    }
+    // Files they made are on the sandbox's disk: a sandbox script in the
+    // checkout once there is one, the host's command where the provider runs.
+    let home = PathBuf::from(provider.workdir("chat-a"));
+    assert!(home.join("after-start-ran").exists());
+    assert!(Path::new(&cwd).join("setup-ran").exists());
+    assert_eq!(
+        std::fs::read_to_string(home.join("made-by-host.txt"))
+            .unwrap()
+            .trim(),
+        "from-host"
+    );
+
+    replied(&provider, "chat-a", "chat-a", Duration::from_secs(60)).await;
+
+    // Deleting the chat: its delete scripts run on the host device, the
+    // one before it while the sandbox is still there to act on.
+    std::fs::remove_file(&log).unwrap();
+    script(
+        &steps_dir.join("before-delete/keep.sh"),
+        &format!(
+            "echo \"before-delete $ZERON_SANDBOX\" >> \"{log_sh}\"\n\
+             zeron-sandbox 'echo last words > last-words.txt' && echo sandbox-ok >> \"{log_sh}\""
+        ),
+    );
+    script(
+        &steps_dir.join("after-delete/bye.sh"),
+        &note("after-delete"),
+    );
+    rpc.call(
+        methods::MUTATE,
+        json!({ "op": "deleteChat", "chatId": "chat-a" }),
+    )
+    .await
+    .expect("deleteChat");
+    eventually(
+        "the delete scripts ran",
+        Duration::from_secs(30),
+        async || (lines(&log).len() == 3).then_some(()),
+    )
+    .await;
+    assert_eq!(
+        lines(&log),
+        ["before-delete chat-a", "sandbox-ok", "after-delete"]
+    );
+    let calls = provider.calls();
+    let words = call_at(&calls, "last-words.txt");
+    let deleted = call_at(&calls, "delete chat-a");
+    assert!(words < deleted, "{calls:#?}");
+    for host_side in ["before-delete/keep.sh", "after-delete/bye.sh"] {
+        assert!(!calls.iter().any(|c| c.contains(host_side)), "{calls:#?}");
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_failing_script_opens_the_chat_with_its_error_and_runs_again() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host_dir = dirs.path().join("host");
+    let host = host_device(&host_dir, &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    let log = dirs.path().join("order.log");
+    let fixed = dirs.path().join("fixed");
+    script(
+        &path.join(".zeron/setup.sh"),
+        &format!(
+            "echo setup.sh >> \"{}\"\n\
+             test -f \"{}\" || {{ echo 'npm ERR! missing script: build' >&2; exit 1; }}",
+            sh(&log),
+            sh(&fixed)
+        ),
+    );
+    script(
+        &host_dir.join("steps/after-setup/ok.sh"),
+        &format!("echo ok >> \"{}\"", sh(&log)),
+    );
+
+    let created = create_on_place(&rpc, "chat-f", "fake").await;
+    let cwd = created["cwd"].as_str().unwrap().to_owned();
+    host.core()
+        .workspace
+        .rename_chat("chat-f", "Pre-titled")
+        .unwrap();
+    send(&rpc, "chat-f", &cwd, "hello anyway").await;
+
+    // The sandbox gets ready and the first message runs all the same.
+    let done = ready(&rpc, "chat-f").await;
+    assert!(done["error"].is_null(), "{done:#}");
+    let failed = &done["scripts"];
+    assert_eq!(failed.as_array().map(Vec::len), Some(1), "{done:#}");
+    assert_eq!(failed[0]["script"], "reportly/.zeron/setup.sh");
+    assert_eq!(failed[0]["hook"], "setup");
+    assert_eq!(failed[0]["state"], "failed");
+    let error = failed[0]["error"].as_str().unwrap_or_default();
+    assert!(
+        error.contains("npm ERR! missing script"),
+        "its own words: {error}"
+    );
+    assert_eq!(lines(&log), ["setup.sh", "ok"]);
+    replied(&provider, "chat-f", "chat-f", Duration::from_secs(60)).await;
+
+    // Fixed; Run again runs just that script, and the chat stays ready.
+    std::fs::write(&fixed, "").unwrap();
+    rpc.call(
+        methods::RUN_SANDBOX_STEPS_AGAIN,
+        json!({ "chatId": "chat-f" }),
+    )
+    .await
+    .expect("Run again");
+    let again = steps_until(&rpc, "chat-f", Duration::from_secs(30), |s| {
+        assert_eq!(s["state"], "ready", "{s:#}");
+        s["scripts"] == json!([])
+    })
+    .await;
+    assert!(again["error"].is_null(), "{again:#}");
+    assert_eq!(lines(&log), ["setup.sh", "ok", "setup.sh"]);
+    let calls = provider.calls();
+    assert_eq!(
+        calls
+            .iter()
+            .filter(|c| c.contains("zeron-engine watchdog"))
+            .count(),
+        1,
+        "{calls:#?}"
+    );
+    assert_eq!(calls.iter().filter(|c| *c == "create").count(), 1);
+}
