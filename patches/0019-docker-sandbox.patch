+		ds.Dialog {
+			open = delete_open,
+			title = (function(): string
+				local old = editing:get()
+				return ui.t("settings.sandboxes.delete_title", { name = if old then old.name else "" }):get()
+			end) :: any,
+			tone = "danger",
+			size = "sm",
+			confirm = {
+				label = ui.t("settings.sandboxes.delete_script"),
+				on_click = delete_script,
+			},
+		},
+	}
+end
