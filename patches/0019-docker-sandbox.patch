diff --git a/apps/zgx/src/sandbox_settings.rs b/apps/zgx/src/sandbox_settings.rs
new file mode 100644
index 0000000000000000000000000000000000000000..dee466022b8480ec2c17b035c172e04927ce2618
--- /dev/null
+++ b/apps/zgx/src/sandbox_settings.rs
@@ -0,0 +1,141 @@
+//! Settings › Sandboxes (spec #37, ticket #48): the engine's sandbox
+//! methods, asked for the page (ui/screens/settings/sandboxes.luau).
+//!
+//! - `sandbox_settings.ask {method, params?, device?}`: what the page reads
+//!   (the providers, a provider's host device, the step scripts and one's
+//!   text).
+//! - `sandbox_settings.change {method, params?, device?}`: what it changes
+//!   (connect, disconnect, the host device, a script saved or deleted).
+//!   Refused while a UI template is only a preview.
+//!
+//! `device` sends the call to that device (`targetDeviceId`): only the host
+//! device says who a provider is connected as. Step scripts are files on the
+//! host devices, but the page asks this device's engine for them (no
+//! `device`), which routes each call there. A refusal is the engine's own
+//! sentence when it
+//! has one ("The host device is offline, …"), else an outcome word
+//! (`offline`, `outdated`, `failed`).
+
+use serde_json::{Value as Json, json};
+use zgx_desktop::WindowContext;
+use zgx_script::{ScriptHost, Value};
+
+use crate::auth::text;
+use crate::engine;
+use crate::plugins::{json_value, value_json};
+
+/// What the page reads.
+const ASK: &[&str] = &["ListSandboxProviders", "SandboxHost", "ListStepScripts", "ReadStepScript"];
+/// What it changes.
+const CHANGE: &[&str] = &[
+    "ConnectSandboxProvider",
+    "DisconnectSandboxProvider",
+    "SetSandboxHost",
+    "WriteStepScript",
+    "DeleteStepScript",
+];
+
+pub fn install(_cx: &mut WindowContext, host: &ScriptHost) {
+    host.async_action("sandbox_settings.ask", |args| {
+        let call = request(&args, ASK);
+        async move { send(call?).await }
+    });
+    host.async_action("sandbox_settings.change", |args| {
+        let call = request(&args, CHANGE);
+        async move {
+            crate::plugins::preview::refuse("sandbox_settings.change")?;
+            send(call?).await
+        }
+    });
+}
+
+/// One call to the engine: its method and its params, `targetDeviceId` set
+/// when it's for another device.
+#[derive(Debug, PartialEq)]
+struct Call {
+    method: String,
+    params: Json,
+}
+
+fn request(args: &Value, allowed: &[&str]) -> Result<Call, String> {
+    let method = args.field("method").map(text).unwrap_or_default();
+    let params = args.field("params").map(value_json).unwrap_or(json!({}));
+    let device = args.field("device").map(text).filter(|d| !d.is_empty());
+    call(&method, params, device.as_deref(), allowed)
+}
+
+fn call(method: &str, params: Json, device: Option<&str>, allowed: &[&str]) -> Result<Call, String> {
+    if !allowed.contains(&method) {
+        return Err("refused".into());
+    }
+    let mut params = if params.is_object() { params } else { json!({}) };
+    if let Some(device) = device {
+        params["targetDeviceId"] = Json::from(device);
+    }
+    Ok(Call { method: method.to_owned(), params })
+}
+
+async fn send(call: Call) -> Result<Value, String> {
+    engine::get()
+        .call(&call.method, call.params)
+        .await
+        .map(|answer| json_value(&answer))
+        .map_err(|error| {
+            eprintln!("zeron-zgx: sandbox settings: {}: {error}", call.method);
+            words(&error)
+        })
+}
+
+/// Why a call didn't go, as the page says it: the engine's own sentence
+/// when it's one a person can read, else an outcome word.
+fn words(error: &str) -> String {
+    let lower = error.to_ascii_lowercase();
+    if lower.contains("unknown method") {
+        // A device running an older Zeron.
+        return "outdated".into();
+    }
+    if engine::outcome(error) == "offline" && !lower.contains("host device") {
+        return "offline".into();
+    }
+    engine::readable(error).unwrap_or_else(|| "failed".into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_page_reads_and_changes_only_the_sandbox_methods() {
+        let read = call("ListSandboxProviders", json!({}), Some("box"), ASK).unwrap();
+        assert_eq!(read.params, json!({ "targetDeviceId": "box" }));
+        // Scripts go to this device's engine, which routes them.
+        let scripts = call("ListStepScripts", json!({}), None, ASK).unwrap();
+        assert_eq!(scripts.params, json!({}));
+        let here = call("SandboxHost", json!({ "provider": "docker" }), None, ASK).unwrap();
+        assert_eq!(here.params, json!({ "provider": "docker" }));
+        // A change isn't a read, and nothing else is either.
+        for (method, allowed) in [
+            ("WriteStepScript", ASK),
+            ("ListStepScripts", CHANGE),
+            ("AccessToken", ASK),
+            ("Mutate", CHANGE),
+            ("AdoptSandboxProvider", CHANGE),
+        ] {
+            assert_eq!(call(method, json!({}), None, allowed), Err("refused".into()), "{method}");
+        }
+        // Params that aren't a record are none.
+        assert_eq!(call("ListSandboxProviders", json!([1]), None, ASK).unwrap().params, json!({}));
+    }
+
+    #[test]
+    fn a_refusal_says_the_engines_sentence_or_a_word() {
+        assert_eq!(
+            words("failed: The host device is offline, so it can't hand docker over. Connect it again on the new host device."),
+            "The host device is offline, so it can't hand docker over. Connect it again on the new host device."
+        );
+        assert_eq!(words("offline"), "offline");
+        assert_eq!(words("unknown method: DisconnectSandboxProvider"), "outdated");
+        assert_eq!(words("failed: {\"weird\":1}"), "failed");
+        assert_eq!(words(""), "failed");
+    }
+}
diff --git a/apps/zgx/src/sandbox_template_save.rs b/apps/zgx/src/sandbox_template_save.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8b61ed62d513640cf82cbcdfbe0848d77bdd8262
--- /dev/null
+++ b/apps/zgx/src/sandbox_template_save.rs
@@ -0,0 +1,75 @@
+//! Save as sandbox template (spec #37): a chat's sandbox saved through its provider
+//! (`SaveSandboxTemplate`), by the host device that keeps it; the engine
+//! routes the call there. The engine wipes Zeron's identity from the sandbox
+//! and saves it; this only carries the ask and the answer. (Named apart from
+//! the interface's own templates, `templates.*`. Listing a provider's
+//! templates is src/sandboxes.rs's `sandboxes.templates`.)
+//!
+//!   sandbox_template.save({ chat, name }) → { id, name }, or rejects with
+//!                                           the engine's words (or an
+//!                                           outcome word: offline, outdated)
+
+use serde_json::{Value as Json, json};
+use zgx_script::{ScriptHost, Value};
+
+use crate::auth::text;
+use crate::engine;
+
+pub fn install(host: &ScriptHost) {
+    host.async_action("sandbox_template.save", move |arg| {
+        let chat = arg.field("chat").map(text).unwrap_or_default();
+        let name = arg.field("name").map(text).unwrap_or_default();
+        async move {
+            crate::plugins::preview::refuse("sandbox_template.save")?;
+            if chat.is_empty() {
+                return Err("invalid".to_string());
+            }
+            let saved = engine::get()
+                .call("SaveSandboxTemplate", json!({ "chatId": chat, "name": name }))
+                .await
+                .map_err(|e| said(&e))?;
+            template_value(&saved["template"]).ok_or_else(|| "failed".to_string())
+        }
+    });
+}
+
+fn template_value(t: &Json) -> Option<Value> {
+    let id = t["id"].as_str()?;
+    let name = t["name"].as_str().unwrap_or(id);
+    Some(Value::record([("id", Value::from(id)), ("name", Value::from(name))]))
+}
+
+/// What a failed call says: the engine's own words (they're written to be
+/// read), or an outcome word when there are none.
+fn said(error: &str) -> String {
+    if error.to_ascii_lowercase().contains("unknown method") {
+        return "outdated".into();
+    }
+    match engine::outcome(error) {
+        "failed" => engine::readable(error).unwrap_or_else(|| "failed".into()),
+        word => word.to_string(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_template_reads_as_the_scripts_take_it() {
+        let t = template_value(&json!({ "id": "tmpl_1", "name": "reportly-dev" })).unwrap();
+        assert_eq!(t.field("id").map(text).as_deref(), Some("tmpl_1"));
+        assert_eq!(t.field("name").map(text).as_deref(), Some("reportly-dev"));
+        let unnamed = template_value(&json!({ "id": "tmpl_2" })).unwrap();
+        assert_eq!(unnamed.field("name").map(text).as_deref(), Some("tmpl_2"));
+        assert!(template_value(&json!({ "name": "x" })).is_none());
+    }
+
+    #[test]
+    fn the_engines_words_are_said_as_they_are() {
+        let busy = "The chat is still working. Save it as a template once it's done.";
+        assert_eq!(said(busy), busy);
+        assert_eq!(said("offline"), "offline");
+        assert_eq!(said("unknown method: SaveSandboxTemplate"), "outdated");
+    }
+}
diff --git a/apps/zgx/src/sandboxes.rs b/apps/zgx/src/sandboxes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..33de3e986a1b48056a9fade3cae16ccf2e1c0577
--- /dev/null
+++ b/apps/zgx/src/sandboxes.rs
@@ -0,0 +1,420 @@
+//! Places a chat runs on (spec #37, docs/design/cloud-byo.md): the sandbox
+//! providers this device's engine keeps, their accounts' templates, and how
+//! far a chat's sandbox got while it starts (the chat's progress line).
+//!
+//! ```text
+//! shared  sandboxes            { providers = { { id, name, icon }… } }
+//! shared  sandbox_steps        { [chat] = { state, step?, template?, since, error?,
+//!                              provider?, disk_full, progress?, scripts?,
+//!                              started? } }: `state` starting | ready |
+//!                              failed | gone | sleeping | asleep | waking,
+//!                              `step` the one it's on (or that failed),
+//!                              `since` when that began, in Unix seconds;
+//!                              `progress` each starting step's state;
+//!                              `scripts` { name, script, step, state, since,
+//!                              error? } running or failed; `started` { at,
+//!                              ready_at?, fresh } its last start
+//! call    sandboxes.templates  provider → { { id, name }… } (Blank isn't one)
+//! invoke  sandboxes.follow     chat: keep its steps in `sandbox_steps`; first
+//!                              asks the provider whether it's still there,
+//!                              never waking it (again once [`ASK_AGAIN`] has
+//!                              passed)
+//! invoke  sandboxes.unfollow   chat
+//! call    sandboxes.run_again  chat: a failed step, and the ones after it
+//! call    sandboxes.fresh      chat: Start fresh, a new sandbox with what the
+//!                              chat pushed
+//! call    sandboxes.wake       chat: Wake a sandbox asleep (#43)
+//! ```
+//!
+//! Every call is the engine's (`ListSandboxProviders`, `ListSandboxTemplates`,
+//! `CheckSandbox`, `WatchSandboxSteps`, `RunSandboxStepsAgain`,
+//! `StartSandboxFresh`, `WakeSandbox`); a failure rejects with an outcome
+//! word, or the engine's sentence.
+
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::rc::Rc;
+use std::time::{Duration, Instant};
+
+use serde_json::{Value as Json, json};
+use zgx_desktop::WindowContext;
+use zgx_script::{ScriptHost, Shared, Value};
+
+use crate::auth::text;
+use crate::engine;
+use crate::plugins::json_value;
+
+#[derive(Default)]
+struct State {
+    /// Each window's `sandboxes` and `sandbox_steps`.
+    shared: Vec<(Rc<Shared>, Rc<Shared>)>,
+    providers: Json,
+    /// The chats followed, and their steps as last heard.
+    steps: BTreeMap<String, Json>,
+    watches: BTreeMap<String, engine::rpc::Watch>,
+    /// When each chat's provider was last asked whether it's still there.
+    asked: BTreeMap<String, Instant>,
+}
+
+/// How long an answer from the provider stands before opening the chat asks
+/// again (a reload within it doesn't).
+const ASK_AGAIN: Duration = Duration::from_secs(60);
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State { providers: json!([]), ..State::default() });
+}
+
+fn publish() {
+    let (shared, providers, steps) = STATE.with(|s| {
+        let s = s.borrow();
+        let steps: serde_json::Map<String, Json> =
+            s.steps.iter().filter_map(|(chat, raw)| Some((chat.clone(), steps_json(raw)?))).collect();
+        (s.shared.clone(), providers_json(&s.providers), Json::Object(steps))
+    });
+    let (providers, steps) = (json_value(&json!({ "providers": providers })), json_value(&steps));
+    for (p, st) in shared {
+        p.set(providers.clone());
+        st.set(steps.clone());
+    }
+}
+
+/// The providers as the picker lists them.
+fn providers_json(listed: &Json) -> Json {
+    let providers: Vec<Json> = listed
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|p| {
+            let id = p["id"].as_str().filter(|id| !id.is_empty())?;
+            Some(json!({
+                "id": id,
+                "name": p["name"].as_str().filter(|n| !n.is_empty()).unwrap_or(id),
+                "icon": p["icon"].as_str().unwrap_or_default(),
+            }))
+        })
+        .collect();
+    Json::Array(providers)
+}
+
+/// A chat's steps as its progress line reads them (`SandboxSteps`), or none
+/// for a chat not on a place this engine keeps.
+fn steps_json(steps: &Json) -> Option<Json> {
+    let state = steps["state"].as_str()?;
+    let mut out = json!({
+        "state": state,
+        "since": steps["since"].as_i64().unwrap_or_default() as f64 / 1000.0,
+    });
+    if let Some(step) = steps["step"].as_str() {
+        out["step"] = Json::from(step);
+    }
+    if let Some(template) = steps["template"].as_str().filter(|t| !t.is_empty()) {
+        out["template"] = Json::from(template);
+    }
+    if let Some(error) = steps["error"].as_str().filter(|e| !e.is_empty()) {
+        out["error"] = Json::from(error);
+    }
+    if let Some(provider) = steps["provider"].as_str().filter(|p| !p.is_empty()) {
+        out["provider"] = Json::from(provider);
+    }
+    out["disk_full"] = Json::Bool(steps["diskFull"].as_bool() == Some(true));
+    // Each starting step's state, in order: the progress line's segments.
+    let progress: Vec<Json> = steps["steps"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|s| s["state"].as_str().map(Json::from))
+        .collect();
+    if !progress.is_empty() {
+        out["progress"] = Json::Array(progress);
+    }
+    // The step script running, and those that failed ("Running setup.sh",
+    // "Setup failed reportly/.zeron/setup.sh").
+    let scripts: Vec<Json> = steps["scripts"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|s| {
+            let mut run = json!({
+                "name": s["name"].as_str()?,
+                "script": s["script"].as_str().unwrap_or_default(),
+                "step": s["step"].as_str().unwrap_or_default(),
+                "state": s["state"].as_str()?,
+                "since": seconds(&s["since"]),
+            });
+            if let Some(error) = s["error"].as_str().filter(|e| !e.is_empty()) {
+                run["error"] = Json::from(error);
+            }
+            Some(run)
+        })
+        .collect();
+    if !scripts.is_empty() {
+        out["scripts"] = Json::Array(scripts);
+    }
+    // Its last start, and when it got ready ("Sandbox ready 52s").
+    if let Some(at) = steps["started"]["at"].as_i64() {
+        let mut started = json!({ "at": at as f64 / 1000.0, "fresh": steps["started"]["fresh"].as_bool() == Some(true) });
+        if steps["started"]["readyAt"].is_i64() {
+            started["ready_at"] = Json::from(seconds(&steps["started"]["readyAt"]));
+        }
+        out["started"] = started;
+    }
+    Some(out)
+}
+
+/// Epoch ms as Unix seconds.
+fn seconds(ms: &Json) -> f64 {
+    ms.as_i64().unwrap_or_default() as f64 / 1000.0
+}
+
+fn templates_json(listed: &Json) -> Json {
+    let templates: Vec<Json> = listed
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|t| {
+            let id = t["id"].as_str().filter(|id| !id.is_empty())?;
+            Some(json!({ "id": id, "name": t["name"].as_str().filter(|n| !n.is_empty()).unwrap_or(id) }))
+        })
+        .collect();
+    Json::Array(templates)
+}
+
+fn follow(rpc: &engine::rpc::Rpc, chat: &str) -> engine::rpc::Watch {
+    let heard = chat.to_owned();
+    rpc.watch("WatchSandboxSteps", json!({ "chatId": chat }), move |item| {
+        STATE.with(|s| s.borrow_mut().steps.insert(heard.clone(), item));
+        publish();
+    })
+}
+
+/// Ask the provider whether `chat`'s sandbox is still there (deleted outside
+/// Zeron, its disk full), never waking it; what it says is the chat's steps
+/// until the watch says more.
+fn check(chat: String) {
+    STATE.with(|s| s.borrow_mut().asked.insert(chat.clone(), Instant::now()));
+    engine::get().spawn(async move {
+        let Ok(checked) = call("CheckSandbox", json!({ "chatId": chat })).await else {
+            return;
+        };
+        if checked.is_object() && STATE.with(|s| s.borrow().steps.contains_key(&chat)) {
+            STATE.with(|s| s.borrow_mut().steps.insert(chat, checked));
+            publish();
+        }
+    });
+}
+
+async fn call(method: &str, params: Json) -> Result<Json, String> {
+    engine::get().call(method, params).await.map_err(|error| match engine::outcome(&error) {
+        "failed" => {
+            let words = error.trim().trim_start_matches("failed:").trim();
+            if words.is_empty() { "failed".into() } else { words.to_string() }
+        }
+        word => word.to_string(),
+    })
+}
+
+pub fn install(cx: &mut WindowContext, host: &ScriptHost) {
+    let providers = Rc::new(host.shared("sandboxes", json_value(&json!({ "providers": [] }))));
+    let steps = Rc::new(host.shared("sandbox_steps", json_value(&json!({}))));
+    let first = STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        s.shared.push((providers.clone(), steps.clone()));
+        s.shared.len() == 1
+    });
+    let mine = Rc::downgrade(&providers);
+    cx.on_closed(move || {
+        STATE.with(|s| s.borrow_mut().shared.retain(|(p, _)| !std::ptr::eq(Rc::as_ptr(p), mine.as_ptr())));
+    });
+    publish();
+    if first {
+        // Each connection: the providers it keeps, once, and the chats
+        // followed watched again on it.
+        engine::get().on_connect(|rpc| {
+            let chats: Vec<String> = STATE.with(|s| s.borrow().steps.keys().cloned().collect());
+            let watches: BTreeMap<String, engine::rpc::Watch> =
+                chats.iter().map(|chat| (chat.clone(), follow(rpc, chat))).collect();
+            STATE.with(|s| s.borrow_mut().watches = watches);
+            let rpc = rpc.clone();
+            engine::get().spawn(async move {
+                match rpc.call("ListSandboxProviders", json!({})).await {
+                    Ok(listed) => {
+                        STATE.with(|s| s.borrow_mut().providers = listed);
+                        publish();
+                    }
+                    // (An engine from before places: none to offer.)
+                    Err(error) => eprintln!("zeron-zgx: sandboxes: no providers: {error}"),
+                }
+            });
+        });
+    }
+    host.async_action("sandboxes.templates", |provider| {
+        let provider = text(&provider);
+        async move {
+            if provider.is_empty() {
+                return Err("invalid".into());
+            }
+            let listed = call("ListSandboxTemplates", json!({ "provider": provider })).await?;
+            Ok(json_value(&templates_json(&listed)))
+        }
+    });
+    host.action("sandboxes.follow", |chat| {
+        let chat = text(&chat);
+        if chat.is_empty() {
+            return;
+        }
+        let stale = STATE.with(|s| s.borrow().asked.get(&chat).is_none_or(|at| at.elapsed() >= ASK_AGAIN));
+        STATE.with(|s| {
+            s.borrow_mut().steps.entry(chat.clone()).or_insert(Json::Null);
+        });
+        if stale {
+            check(chat.clone());
+        }
+        if STATE.with(|s| s.borrow().watches.contains_key(&chat)) {
+            return;
+        }
+        if let Some(rpc) = engine::get().current() {
+            let watch = follow(&rpc, &chat);
+            STATE.with(|s| s.borrow_mut().watches.insert(chat, watch));
+        }
+    });
+    host.async_action("sandboxes.fresh", |chat| {
+        let chat = text(&chat);
+        async move {
+            crate::plugins::preview::refuse("sandboxes.fresh")?;
+            if chat.is_empty() {
+                return Err("invalid".into());
+            }
+            call("StartSandboxFresh", json!({ "chatId": chat })).await?;
+            Ok(Value::Bool(true))
+        }
+    });
+    host.async_action("sandboxes.wake", |chat| {
+        let chat = text(&chat);
+        async move {
+            crate::plugins::preview::refuse("sandboxes.wake")?;
+            if chat.is_empty() {
+                return Err("invalid".into());
+            }
+            call("WakeSandbox", json!({ "chatId": chat })).await?;
+            Ok(Value::Bool(true))
+        }
+    });
+    host.action("sandboxes.unfollow", |chat| {
+        let chat = text(&chat);
+        STATE.with(|s| {
+            let mut s = s.borrow_mut();
+            s.watches.remove(&chat);
+            s.steps.remove(&chat);
+        });
+        publish();
+    });
+    host.async_action("sandboxes.run_again", |chat| {
+        let chat = text(&chat);
+        async move {
+            crate::plugins::preview::refuse("sandboxes.run_again")?;
+            call("RunSandboxStepsAgain", json!({ "chatId": chat })).await?;
+            Ok(Value::Nil)
+        }
+    });
+}
