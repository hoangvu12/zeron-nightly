diff --git a/apps/zgx/ui/screens/settings/sandbox_words.luau b/apps/zgx/ui/screens/settings/sandbox_words.luau
new file mode 100644
index 0000000000000000000000000000000000000000..f3a48f86974491afbf4baa2663c05a141fac014f
--- /dev/null
+++ b/apps/zgx/ui/screens/settings/sandbox_words.luau
@@ -0,0 +1,316 @@
+-- Settings › Sandboxes, its words and choices, pure (no `ui` needed: a test
+-- reads the English). A step script is named by `{for, hook, name}`, as the
+-- engine's `ListStepScripts`/`WriteStepScript` name it (crates/engine
+-- sandboxes/scripts.rs): `for` is `{kind = "all"}`, `{kind = "provider",
+-- provider}` or `{kind = "project", spaceId}`; `hook` is `before-`,
+-- `after-` or `instead-of-` and a step, or `setup` for a project's own
+-- `.zeron/setup.sh`.
+--
+-- The page asks When as five moments and "Replace a step…", never as the
+-- grid of hooks: a script on another hook (Fleet-synced, written by hand)
+-- still lists, its When said plainly ("Before Install Zeron").
+
+local M = {}
+
+local function say(key: string, english: string, args: { [string]: any }?): string
+	if (ui :: any) == nil then
+		if args then
+			return (string.gsub(english, "{(%w+)}", function(k: string): string
+				return tostring(args[k] or "")
+			end))
+		end
+		return english
+	end
+	return ui.t(`settings.sandboxes.{key}`, args):get()
+end
+
+export type Scope = { kind: string, provider: string?, spaceId: string? }
+export type Script = { ["for"]: Scope, hook: string, name: string, script: string?, path: string?, runsOn: string? }
+-- `ops`: what it can do, as `ListSandboxProviders` names them ("create",
+-- "connect", "signInPage", …).
+export type Provider = { id: string, name: string, icon: string?, account: { name: string }?, host: string?, ops: { string }? }
+export type Project = { id: string, name: string, device: string? }
+
+-- Every sandbox's glyph (stacked layers) and a project's (the Projects
+-- page's own).
+M.ALL_ICON = "layers"
+M.PROJECT_ICON = "folder-with-files"
+
+-- A project's own Setup script (`<repo>/.zeron/setup.sh`).
+M.SETUP_HOOK = "setup"
+M.SETUP_NAME = "setup.sh"
+
+-- When, as the page offers it, in order: each a moment's hook.
+M.MOMENTS = {
+	{ value = "after-create", key = "when.created", english = "When it's created" },
+	{ value = "after-ready", key = "when.ready", english = "When it's ready" },
+	{ value = "after-wake", key = "when.wakes", english = "When it wakes" },
+	{ value = "before-sleep", key = "when.sleeps", english = "Before it sleeps" },
+	{ value = "before-delete", key = "when.deleted", english = "Before it's deleted" },
+}
+-- The last choice: a step to run instead of (then which step).
+M.REPLACE = "replace"
+
+-- The steps, in the order they run, with their names (ready isn't one to
+-- replace: it's only the moment the others are done).
+M.STEPS = {
+	{ value = "create", key = "step.create", english = "Create" },
+	{ value = "start", key = "step.start", english = "Start" },
+	{ value = "install-zeron", key = "step.install_zeron", english = "Install Zeron" },
+	{ value = "sign-in", key = "step.sign_in", english = "Sign in" },
+	{ value = "secrets", key = "step.secrets", english = "Secrets" },
+	{ value = "get-code", key = "step.get_code", english = "Get the code" },
+	{ value = "setup", key = "step.setup", english = "Setup" },
+	{ value = "ready", key = "step.ready", english = "Ready" },
+	{ value = "sleep", key = "step.sleep", english = "Sleep" },
+	{ value = "wake", key = "step.wake", english = "Wake" },
+	{ value = "delete", key = "step.delete", english = "Delete" },
+}
+
+local function step_named(step: string): string?
+	for _, s in M.STEPS do
+		if s.value == step then
+			return say(s.key, s.english)
+		end
+	end
+	return nil
+end
+
+local function moment(hook: string): any?
+	for _, m in M.MOMENTS do
+		if m.value == hook then
+			return m
+		end
+	end
+	return nil
+end
+
+-- When's choices: the moments, then Replace a step… set apart by a rule.
+function M.when_options(): { any }
+	local out = {}
+	for _, m in M.MOMENTS do
+		table.insert(out, { value = m.value, label = say(m.key, m.english) })
+	end
+	table.insert(out, { value = M.REPLACE, label = say("when.replace", "Replace a step…"), rule = true })
+	return out
+end
+
+-- The steps a script can stand in for.
+function M.step_options(): { any }
+	local out = {}
+	for _, s in M.STEPS do
+		if s.value ~= "ready" then
+			table.insert(out, { value = s.value, label = say(s.key, s.english) })
+		end
+	end
+	return out
+end
+
+-- The hook a When choice names (`step`: the step, for Replace).
+function M.hook_of(choice: string, step: string?): string?
+	if choice == M.REPLACE then
+		return if step and step_named(step) then `instead-of-{step}` else nil
+	end
+	return choice
+end
+
+-- A hook as the When choices hold it: `(choice, step?)`. A project's
+-- setup.sh is when it's ready; a hook that isn't one of the moments is
+-- itself (listed as it is).
+function M.choice_of(hook: string): (string, string?)
+	if hook == M.SETUP_HOOK then
+		return "after-ready", nil
+	end
+	local step = string.match(hook, "^instead%-of%-(.+)$")
+	if step then
+		return M.REPLACE, step
+	end
+	return hook, nil
+end
+
+-- When a script runs, in words: "When it wakes", "Instead of Get the
+-- code", "Before Install Zeron".
+function M.when(hook: string): string
+	if hook == M.SETUP_HOOK then
+		return say("when.ready", "When it's ready")
+	end
+	local m = moment(hook)
+	if m then
+		return say(m.key, m.english)
+	end
+	for _, timing in { { "instead-of-", "when.instead_of", "Instead of {step}" }, { "before-", "when.before", "Before {step}" }, { "after-", "when.after", "After {step}" } } do
+		local prefix, key, english = timing[1], timing[2], timing[3]
+		if string.sub(hook, 1, #prefix) == prefix then
+			local step = step_named(string.sub(hook, #prefix + 1))
+			if step then
+				return say(key, english, { step = step })
+			end
+		end
+	end
+	return hook
+end
+
+local function find(list: { any }?, field: string, value: string?): any?
+	for _, item in list or {} do
+		if item[field] == value then
+			return item
+		end
+	end
+	return nil
+end
+
+-- Who a script is for: its words and its glyph.
+function M.for_label(scope: Scope, providers: { Provider }?, projects: { Project }?): (string, string)
+	if scope.kind == "provider" then
+		local p = find(providers, "id", scope.provider)
+		return if p then p.name else (scope.provider or ""), M.icon_of(p and p.icon)
+	elseif scope.kind == "project" then
+		local p = find(projects, "id", scope.spaceId)
+		return if p then p.name else say("for.project_gone", "A removed project"), M.PROJECT_ICON
+	end
+	return say("for.all", "All sandboxes"), M.ALL_ICON
+end
+
+-- A provider's glyph: the one it carries (the page's providers carry
+-- account/sandboxes' `icon(id)`, as the picker draws it), else a box.
+function M.icon_of(icon: string?): string
+	return if icon and icon ~= "" then icon else "box"
+end
+
+-- A script's identity: one row each, whatever is renamed around it.
+function M.key(s: Script): string
+	local scope = s["for"]
+	local whom = if scope.kind == "provider" then `provider:{scope.provider}` elseif scope.kind == "project" then `project:{scope.spaceId}` else "all"
+	return `{whom}/{s.hook}/{s.name}`
+end
+
+export type Row = { key: string, name: string, when: string, whom: string, icon: string, script: Script }
+
+-- The page's list: one row per script there is (no empty moments, no
+-- grid), in the engine's order.
+function M.rows(scripts: { Script }?, providers: { Provider }?, projects: { Project }?): { Row }
+	local out: { Row } = {}
+	for _, s in scripts or {} do
+		local whom, icon = M.for_label(s["for"], providers, projects)
+		table.insert(out, { key = M.key(s), name = s.name, when = M.when(s.hook), whom = whom, icon = icon, script = s })
+	end
+	return out
+end
+
+-- For's choices: every sandbox, each provider, each project with its folder
+-- on a provider's host device (a script's file lives there); with no host
+-- device yet, every project.
+function M.for_options(providers: { Provider }?, projects: { Project }?): { any }
+	local out = { { value = "all", label = say("for.all", "All sandboxes"), icon = M.ALL_ICON } }
+	local hosts: { [string]: boolean } = {}
+	local any_host = false
+	for _, p in providers or {} do
+		table.insert(out, { value = `provider:{p.id}`, label = p.name, icon = M.icon_of(p.icon) })
+		if p.host then
+			hosts[p.host] = true
+			any_host = true
+		end
+	end
+	for _, p in projects or {} do
+		if not any_host or (p.device and hosts[p.device]) then
+			table.insert(out, { value = `project:{p.id}`, label = p.name, icon = M.PROJECT_ICON })
+		end
+	end
+	return out
+end
+
+-- A For choice's value, as the engine names it.
+function M.scope_of(value: string): Scope
+	local provider = string.match(value, "^provider:(.+)$")
+	if provider then
+		return { kind = "provider", provider = provider }
+	end
+	local project = string.match(value, "^project:(.+)$")
+	if project then
+		return { kind = "project", spaceId = project }
+	end
+	return { kind = "all" }
+end
+
+-- A scope as a For choice's value.
+function M.scope_value(scope: Scope): string
+	if scope.kind == "provider" then
+		return `provider:{scope.provider}`
+	elseif scope.kind == "project" then
+		return `project:{scope.spaceId}`
+	end
+	return "all"
+end
+
+-- A script's file name: one plain name (no folders, not hidden).
+function M.valid_name(name: string): boolean
+	return name ~= "" and name ~= "." and name ~= ".." and string.sub(name, 1, 1) ~= "." and not string.find(name, "[/\\:%z]")
+end
+
+local function phone(device: { platform: string }): boolean
+	return device.platform == "ios" or device.platform == "android"
+end
+
+-- Whether the host device may sleep: a computer that isn't an always-on
+-- `zeron headless`. (A device row doesn't say whether it's a laptop, so
+-- this is a maybe: a desktop may be put to sleep too.)
+function M.may_sleep(device: { platform: string, headless: boolean? }?): boolean
+	if not device then
+		return false
+	end
+	return device.headless ~= true and not phone(device)
+end
+
+-- The note under a host device that may sleep.
+function M.sleep_note(device: string): string
+	return say("host_sleeps", "{device} may sleep: its sandboxes can't start or wake while it does.", { device = device })
+end
+
+local function has(list: { string }?, item: string): boolean
+	for _, v in list or {} do
+		if v == item then
+			return true
+		end
+	end
+	return false
+end
+
+-- Whether a provider signs in on its own page (a code shown here, approved
+-- there): its ops say `signInPage`. The rest take a pasted key only.
+function M.signs_in_on_page(p: Provider?): boolean
+	return p ~= nil and has(p.ops, "signInPage")
+end
+
+-- What a provider's pasted key may be, where it takes more than one kind
+-- (Docker: an access token, or a username and personal access token that
+-- the engine exchanges at Docker Hub). nil: nothing to say.
+local TOKEN_HINTS: { [string]: { key: string, english: string } } = {
+	docker = { key = "token_hint.docker", english = "A Docker access token, or username:personal-access-token." },
+}
+function M.token_hint(provider: string?): string?
+	local hint = provider and TOKEN_HINTS[provider]
+	return if hint then say(hint.key, hint.english) else nil
+end
+
+-- The host device a provider not connected yet would get, as the engine
+-- picks one (crates/engine sandboxes/host_device `pick_host`): an always-on
+-- server online that can be one, else this device. (Ties go to the first;
+-- the engine's own pick, by how long each has been online, is the one that
+-- counts, and the page shows it once connected.)
+export type HostDevice = { id: string, here: boolean?, online: boolean?, host: boolean?, headless: boolean?, platform: string }
+function M.planned_host(devices: { HostDevice }?): string?
+	local here: string? = nil
+	for _, d in devices or {} do
+		if d.here then
+			here = d.id
+		end
+	end
+	for _, d in devices or {} do
+		if d.host and d.headless and (d.here or d.online ~= false) then
+			return d.id
+		end
+	end
+	return here
+end
+
+return M
diff --git a/apps/zgx/ui/screens/settings/sandboxes.luau b/apps/zgx/ui/screens/settings/sandboxes.luau
new file mode 100644
index 0000000000000000000000000000000000000000..6aec0568e31a093acc98c96c1247c6544ce4ac13
--- /dev/null
+++ b/apps/zgx/ui/screens/settings/sandboxes.luau
@@ -0,0 +1,1089 @@
+-- Settings › Sandboxes (spec #37, ticket #48): one page for every sandbox
+-- provider. Each provider is a card: whether it's connected, with Connect
+-- or Disconnect, and its host device (the device that keeps its key and
+-- runs its steps), with a note when that device may sleep. Not connected
+-- yet, the host device is the one it will get (picked there, it moves there
+-- once connected). Under them, the user's step scripts as a flat list, one
+-- row per script that exists (its name, When, For), Add script, and an
+-- editor; connected or not, the page shows all of it.
+--
+-- Everything comes from the engine (src/sandbox_settings.rs): the
+-- providers here (`ListSandboxProviders`: their ops too, which say which
+-- sign in on their own page), each one's host device (`SandboxHost`), and
+-- who it's connected as, which only the host device says (asked there).
+-- Step scripts are files on the host devices, but every script call goes to
+-- this device's engine, which routes it to the right one(s). Read once a
+-- visit, again after each change (no polling), but while a provider's own
+-- sign-in page waits on the user.
+--
+-- No descriptions on the page: the rows say what they are.
+
+local ds = require("@ds")
+local Icon = require("@ds/icon")
+local Links = require("@ds/links")
+local CodeEditor = require("@ds/code_editor")
+local Syntax = require("@ds/syntax")
+local toast = require("@ds/toast")
+local sandboxes = require("@account/sandboxes")
+local sessions = require("@account/sessions")
+local host = require("@app/screens/settings/host")
+local search = require("@app/screens/settings/search")
+local visits = require("@app/screens/settings/visits")
+local words = require("@app/screens/settings/sandbox_words")
+
+local M = {}
+
+M.ID = "sandboxes"
+M.TITLE = "Sandboxes"
+
+search.index(M.ID, ui.t("settings.sandboxes.title"), ui.t("settings.sandboxes.terms"), {
+	{ key = "providers", title = ui.t("settings.sandboxes.connect"), terms = ui.t("settings.sandboxes.providers_terms") },
+	{ key = "providers", title = ui.t("settings.sandboxes.host_device"), terms = ui.t("settings.sandboxes.host_terms") },
+	{ key = "scripts", title = ui.t("settings.sandboxes.scripts"), terms = ui.t("settings.sandboxes.scripts_terms") },
+})
+
+type Provider = words.Provider
+type Script = words.Script
+
+-- What the page shows: "loading", "ready", or "offline" (no engine).
+local phase = ui.state("settings_sandboxes_phase", "loading")
+-- What the engine says of each provider, by id: its host device, who it's
+-- connected as, what it can do, and (one the picker doesn't list yet) its
+-- name and icon.
+type Said = { id: string?, name: string?, icon: string?, host: string?, account: { name: string }?, ops: { string }? }
+local said = ui.state("settings_sandboxes_said", {} :: { [string]: Said })
+
+-- The providers, as the picker lists them (account/sandboxes: their names,
+-- order and glyphs), each with what its engine says.
+local function merged(of: { [string]: Said }): { Provider }
+	local out: { Provider } = {}
+	local listed: { [string]: boolean } = {}
+	for _, p in sandboxes.providers() do
+		listed[p.id] = true
+		local s = of[p.id] or {}
+		table.insert(out, { id = p.id, name = p.name, icon = sandboxes.icon(p.id), host = s.host, account = s.account, ops = s.ops })
+	end
+	local rest: { Provider } = {}
+	for id, s in of do
+		if not listed[id] then
+			table.insert(rest, { id = id, name = s.name or id, icon = sandboxes.icon(s.icon or id), host = s.host, account = s.account, ops = s.ops })
+		end
+	end
+	table.sort(rest, function(a: Provider, b: Provider): boolean
+		return a.id < b.id
+	end)
+	table.move(rest, 1, #rest, #out + 1, out)
+	return out
+end
+local providers = ui.computed(function(): { Provider }
+	return merged(said:get())
+end)
+local scripts = ui.state("settings_sandboxes_scripts", {} :: { Script })
+-- A script just added: its row's key, lit for a moment.
+local fresh = ui.state("settings_sandboxes_fresh", "")
+-- How long a new script's row stays lit.
+local FRESH_MS = 1600
+-- The host device picked for a provider not connected yet, by id: where it
+-- moves once it's connected.
+local planned = ui.state("settings_sandboxes_planned", {} :: { [string]: string })
+
+-- Connecting: which provider, the key being pasted, the provider's sign-in
+-- page's code while it waits, and whether that's on its way.
+local connecting = ui.state("settings_sandboxes_connecting", "")
+local connect_open = ui.state("settings_sandboxes_connect_open", false)
+local token = ui.state("settings_sandboxes_token", "")
+local code = ui.state("settings_sandboxes_code", nil :: any)
+local connect_busy = ui.state("settings_sandboxes_connect_busy", false)
+-- Disconnecting: which, after a confirm.
+local disconnecting = ui.state("settings_sandboxes_disconnecting", "")
+local disconnect_open = ui.state("settings_sandboxes_disconnect_open", false)
+local disconnect_busy = ui.state("settings_sandboxes_disconnect_busy", false)
+-- The editor: the script opened (nil: a new one), its When (a moment, or
+-- Replace and a step), For, file name and text.
+local editor_open = ui.state("settings_sandboxes_editor_open", false)
+local editing = ui.state("settings_sandboxes_editing", nil :: Script?)
+local when = ui.state("settings_sandboxes_when", "after-ready")
+local step = ui.state("settings_sandboxes_step", "")
+local whom = ui.state("settings_sandboxes_for", "all")
+local file_name = ui.state("settings_sandboxes_file", "")
+local content = ui.state("settings_sandboxes_content", "")
+local editor_busy = ui.state("settings_sandboxes_editor_busy", false)
+local delete_open = ui.state("settings_sandboxes_delete_open", false)
+
+-- The script editor's code, this tall (about seven lines; it scrolls past).
+local EDITOR_H = 160
+-- How often a sign-in on the provider's page is looked at while it waits.
+local POLL_MS = 2500
+
+local function here(): string?
+	for _, d in sessions.devices:peek() or {} do
+		if d.here then
+			return d.id
+		end
+	end
+	return nil
+end
+
+-- Another device's id, or nil for this one (the call stays here).
+local function target(device: string?): string?
+	return if device and device ~= "" and device ~= here() then device else nil
+end
+
+local function ask(method: string, params: any?, device: string?): any
+	return host.call("sandbox_settings.ask", { method = method, params = params or {}, device = target(device) })
+end
+
+local function change(method: string, params: any?, device: string?): any
+	return host.call("sandbox_settings.change", { method = method, params = params or {}, device = target(device) })
+end
+
+-- Why something didn't go, in words: the engine's sentence, or a word's.
+local function why(err: any): string
+	local said = if type(err) == "string" then err elseif type(err) == "table" or type(err) == "userdata" then err.message else nil
+	if said == "offline" then
+		return ui.t("settings.engine.offline"):get()
+	elseif said == "outdated" then
+		return ui.t("settings.engine.outdated"):get()
+	elseif said == nil or said == "" or said == "failed" or said == "refused" then
+		return ui.t("settings.sandboxes.try_again"):get()
+	end
+	return said
+end
+
+local function failed(title: string): (err: any) -> ()
+	return function(err: any)
+		toast.show { title = title, body = why(err), tone = "danger" }
+	end
+end
+
+local function device_named(id: string?): sessions.Device?
+	for _, d in sessions.devices:peek() or {} do
+		if d.id == id then
+			return d
+		end
+	end
+	return nil
+end
+
+-- The scripts, wherever they are: this device's engine asks the host
+-- devices.
+local function load_scripts()
+	ask("ListStepScripts"):after(function(list: any)
+		scripts:set(if type(list) == "table" then list else {})
+	end, function()
+		scripts:set({})
+	end)
+end
+
+-- Everything again: each provider's host device and account, then the
+-- scripts.
+local function load()
+	ask("ListSandboxProviders"):after(function(list: any)
+		local found: { [string]: Said } = {}
+		for _, p in (if type(list) == "table" then list else {}) do
+			found[p.id] = { name = p.name, icon = p.icon, account = p.account, ops = if type(p.ops) == "table" then p.ops else nil }
+		end
+		for _, p in sandboxes.providers() do
+			found[p.id] = found[p.id] or {}
+		end
+		local left = 0
+		for _ in found do
+			left += 1
+		end
+		local function done()
+			left -= 1
+			if left > 0 then
+				return
+			end
+			ui.batch(function()
+				said:set(found)
+				phase:set("ready")
+			end)
+			load_scripts()
+		end
+		if left == 0 then
+			left = 1
+			done()
+			return
+		end
+		for id, p in found do
+			p.id = id
+			ask("SandboxHost", { provider = p.id }):after(function(named: any)
+				p.host = if type(named) == "table" then named.hostDeviceId else nil
+				-- Who it's connected as is the host device's to say.
+				if p.host and target(p.host) then
+					ask("ListSandboxProviders", {}, p.host):after(function(there: any)
+						p.account = nil
+						for _, q in (if type(there) == "table" then there else {}) do
+							if q.id == p.id then
+								p.account = q.account
+							end
+						end
+						done()
+					end, function()
+						-- (The host device away: connected, as far as anyone can tell.)
+						done()
+					end)
+				else
+					done()
+				end
+			end, function()
+				done()
+			end)
+		end
+	end, function(err: any)
+		local said = if type(err) == "table" or type(err) == "userdata" then err.message else err
+		phase:set(if said == "offline" then "offline" else "ready")
+	end)
+end
+M.load = load
+
+local function provider(id: string): Provider?
+	for _, p in providers:peek() do
+		if p.id == id then
+			return p
+		end
+	end
+	return nil
+end
+
+-- Connect ──────────────────────────────────────────────────────────────────
+
+local function open_connect(id: string)
+	ui.batch(function()
+		connecting:set(id)
+		token:set("")
+		code:set(nil)
+		connect_busy:set(false)
+		connect_open:set(true)
+	end)
+end
+
+-- `id` connected, `host` the host device the engine gave it: moved to the
+-- one picked before, if another was.
+local function connected(id: string, host: string?)
+	local want = planned:peek()[id]
+	ui.batch(function()
+		connect_busy:set(false)
+		connect_open:set(false)
+		code:set(nil)
+		token:set("")
+		if want then
+			planned:set_key(id, nil :: any)
+		end
+	end)
+	if want and host and want ~= host then
+		change("SetSandboxHost", { provider = id, deviceId = want }):after(function()
+			load()
+		end, function(err: any)
+			failed(ui.t("settings.sandboxes.couldnt_move"):get())(err)
+			load()
+		end)
+		return
+	end
+	load()
+end
+
+local function connect_with_token()
+	local id = connecting:peek()
+	local key = string.match(token:peek(), "^%s*(.-)%s*$") or ""
+	if id == "" or key == "" or connect_busy:peek() then
+		return
+	end
+	connect_busy:set(true)
+	change("ConnectSandboxProvider", { provider = id, token = key }):after(function(answer: any)
+		connected(id, if type(answer) == "table" then answer.hostDeviceId else nil)
+	end, function(err: any)
+		connect_busy:set(false)
+		failed(ui.t("settings.sandboxes.couldnt_connect"):get())(err)
+	end)
+end
+
+-- The provider's own sign-in page: its code shown, opened in the browser;
+-- the engine finishes in the background, so the page asks the host device
+-- every few seconds until it's connected or the code runs out.
+local function connect_on_page()
+	local id = connecting:peek()
+	if id == "" or connect_busy:peek() then
+		return
+	end
+	connect_busy:set(true)
+	change("ConnectSandboxProvider", { provider = id }):after(function(answer: any)
+		connect_busy:set(false)
+		local shown = if type(answer) == "table" then answer.deviceCode else nil
+		if not shown then
+			connected(id, if type(answer) == "table" then answer.hostDeviceId else nil)
+			return
+		end
+		code:set(shown)
+		local url = shown.verificationUriComplete or shown.verificationUri
+		if url and url ~= "" then
+			Links.outside(url)
+		end
+		local until_at = os.time() + (tonumber(shown.expiresIn) or 900)
+		-- (Only while this code shows: closed, approved or run out, it stops.)
+		local function waiting(): boolean
+			-- (A state holds a copy: the code's own words say which.)
+			local now = code:peek()
+			return connect_open:peek() and now ~= nil and now.userCode == shown.userCode and os.time() <= until_at
+		end
+		local function look()
+			ui.after(POLL_MS, function()
+				if not waiting() then
+					return
+				end
+				ask("SandboxHost", { provider = id }):after(function(named: any)
+					local device = if type(named) == "table" then named.hostDeviceId else nil
+					ask("ListSandboxProviders", {}, device):after(function(list: any)
+						for _, p in (if type(list) == "table" then list else {}) do
+							if p.id == id and p.account and waiting() then
+								connected(id, device)
+								return
+							end
+						end
+						look()
+					end, look)
+				end, look)
+			end)
+		end
+		look()
+	end, function(err: any)
+		connect_busy:set(false)
+		failed(ui.t("settings.sandboxes.couldnt_connect"):get())(err)
+	end)
+end
+
+local function disconnect()
+	local id = disconnecting:peek()
+	if id == "" or disconnect_busy:peek() then
+		return
+	end
+	disconnect_busy:set(true)
+	change("DisconnectSandboxProvider", { provider = id }):after(function()
+		ui.batch(function()
+			disconnect_busy:set(false)
+			disconnect_open:set(false)
+		end)
+		load()
+	end, function(err: any)
+		ui.batch(function()
+			disconnect_busy:set(false)
+			disconnect_open:set(false)
+		end)
+		failed(ui.t("settings.sandboxes.couldnt_disconnect"):get())(err)
+	end)
+end
+
+-- Host device ──────────────────────────────────────────────────────────────
+
+local function set_host(id: string, device: string)
+	local p = provider(id)
+	if not p or p.host == device then
+		return
+	end
+	if p.account == nil then
+		-- Not connected: where it goes once it is.
+		planned:set_key(id, device)
+		return
+	end
+	change("SetSandboxHost", { provider = id, deviceId = device }):after(function()
+		load()
+	end, function(err: any)
+		failed(ui.t("settings.sandboxes.couldnt_move"):get())(err)
+		-- (The choice goes back to where it is.)
+		load()
+	end)
+end
+
+-- The devices that can be a host device: computers on a Zeron that can.
+local function host_choices(current: string?): { any }
+	local out = {}
+	for _, d in sessions.computers(sessions.devices:get(), true) do
+		if d.host or d.id == current then
+			table.insert(out, {
+				value = d.id,
+				label = d.name,
+				icon = if d.headless then "remote-server" elseif d.platform == "linux" then "monitor" else "laptop",
+				description = if not d.here and d.online == false then ui.t("settings.devices.offline") else nil,
+			})
+		end
+	end
+	return out
+end
+
+-- The host device a provider shows: its own once connected; before, the one
+-- picked for it, else the one the engine would pick.
+local function shown_host(p: Provider): string
+	if p.account ~= nil and p.host then
+		return p.host
+	end
+	return planned:get()[p.id] or p.host or words.planned_host(sessions.devices:get() :: any) or ""
+end
+
+-- A provider's card: its row (connected or not) and its host device, with a
+-- note when that one may sleep.
+local function provider_card(_p: Provider, _i: number, now: State<Provider>): Node
+	local id = _p.id
+	local function is_connected(): boolean
+		return now:get().account ~= nil
+	end
+	local chosen = ui.use_state(shown_host(now:peek()))
+	ui.effect(function()
+		local h = shown_host(now:get())
+		if h ~= chosen:peek() then
+			chosen:set(h)
+		end
+	end)
+	local function sleeper(): sessions.Device?
+		if not is_connected() then
+			return nil
+		end
+		local d = device_named(now:get().host)
+		sessions.devices:get()
+		return if words.may_sleep(d) then d else nil
+	end
+	local status = ui.row {
+		gap = "$space.2",
+		items = "center",
+		ui.div {
+			w = 6,
+			h = 6,
+			shrink = 0,
+			rounded = "$radius.full",
+			aria_hidden = true,
+			bg = function(): string
+				return if is_connected() then "$success" else "$text.tertiary"
+			end,
+		},
+		ui.text {
+			function(): string
+				return if is_connected() then ui.t("settings.sandboxes.connected"):get() else ui.t("settings.sandboxes.not_connected"):get()
+			end,
+			text_size = "$font.size.sm",
+			color = "$text.secondary",
+		},
+	}
+	local connect = ds.Button {
+		tone = "primary",
+		size = "sm",
+		label = ui.t("settings.sandboxes.connect_named", { name = _p.name }),
+		on_click = function()
+			open_connect(id)
+		end,
+		ui.t("settings.sandboxes.connect"),
+	}
+	local disconnect_button = ds.Button {
+		tone = "secondary",
+		size = "sm",
+		label = ui.t("settings.sandboxes.disconnect_named", { name = _p.name }),
+		on_click = function()
+			ui.batch(function()
+				disconnecting:set(id)
+				disconnect_open:set(true)
+			end)
+		end,
+		ui.t("settings.sandboxes.disconnect"),
+	}
+	local host_row = ds.Settings.Row {
+		label = ui.t("settings.sandboxes.host_device"),
+		icon = "global",
+		control = ds.Select {
+			value = chosen,
+			name = ui.t("settings.sandboxes.host_device_named", { name = _p.name }),
+			size = "sm",
+			fit = true,
+			options = function(): { any }
+				return host_choices(chosen:get())
+			end,
+			on_change = function(device: string)
+				set_host(id, device)
+			end,
+		},
+	}
+	local note = ui.row {
+		px = ds.Settings.inset(),
+		py = "$space.3",
+		gap = "$space.2",
+		items = "center",
+		ui.div { color = "$text.tertiary", Icon { name = "moon", size = 14 } },
+		ui.text {
+			function(): string
+				local d = sleeper()
+				return if d then words.sleep_note(d.name) else ""
+			end,
+			text_size = "$font.size.sm",
+			color = "$text.secondary",
+			wrap = true,
+		},
+	}
+	-- (One child: the rows that come and go bring their own hairlines.)
+	return ds.Settings.Group {
+		ui.column {
+			w_full = true,
+			ds.Settings.Row {
+				label = _p.name,
+				-- (Its glyph in the rounded tile, as the host device's.)
+				icon = words.icon_of(_p.icon) :: any,
+				control = ui.row {
+					gap = "$space.4",
+					items = "center",
+					status,
+					ui.show(is_connected, disconnect_button),
+					ui.show(function(): boolean
+						return not is_connected()
+					end, connect),
+				},
+			},
+			ds.Settings.Rule(),
+			host_row,
+			ui.show(function(): boolean
+				return sleeper() ~= nil
+			end, ui.column { w_full = true, ds.Settings.Rule(), note }),
+		},
+	}
+end
