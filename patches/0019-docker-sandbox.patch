diff --git a/crates/proto/src/places.rs b/crates/proto/src/places.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7ae407299a8b66d2758b0cec532e1f3071fedd80
--- /dev/null
+++ b/crates/proto/src/places.rs
@@ -0,0 +1,82 @@
+//! Places chats run on (a sandbox provider a device keeps; spec #37): how a
+//! composer names one to ask what agents it offers, and how a sandbox says
+//! the agent picked isn't on it. Pure; every client reads the same words.
+
+use crate::HarnessId;
+
+/// A place's catalog target: `place:<provider>` or
+/// `place:<provider>:<template>`, passed as `targetDeviceId` to
+/// `ListHarnesses` / `ListModels`. The device keeping the provider answers
+/// it itself, never asking a sandbox.
+pub const PLACE_TARGET_PREFIX: &str = "place:";
+
+pub fn place_target(provider: &str, template: Option<&str>) -> String {
+    match template {
+        Some(template) => format!("{PLACE_TARGET_PREFIX}{provider}:{template}"),
+        None => format!("{PLACE_TARGET_PREFIX}{provider}"),
+    }
+}
+
+/// `(provider, template)` of a place target; `None` for any other target.
+/// A template may hold `:` (an image reference); a provider id can't.
+pub fn parse_place_target(target: &str) -> Option<(&str, Option<&str>)> {
+    let rest = target.strip_prefix(PLACE_TARGET_PREFIX)?;
+    let (provider, template) = match rest.split_once(':') {
+        Some((provider, template)) => (provider, Some(template).filter(|t| !t.is_empty())),
+        None => (rest, None),
+    };
+    (!provider.is_empty()).then_some((provider, template))
+}
+
+/// The reason a sandbox refuses a send whose agent isn't there:
+/// `agent_not_on_template:<harness>: <Agent> isn't on this template`. The
+/// message is kept (it waits, refused, until it's sent again) and no other
+/// agent runs it.
+pub const AGENT_MISSING_PREFIX: &str = "agent_not_on_template:";
+
+pub fn agent_missing_reason(harness: HarnessId, name: &str) -> String {
+    format!(
+        "{AGENT_MISSING_PREFIX}{}: {name} isn't on this template",
+        harness.as_str()
+    )
+}
+
+/// The agent a refusal names and the words to show for it.
+pub fn agent_missing(reason: &str) -> Option<(HarnessId, &str)> {
+    let rest = reason.strip_prefix(AGENT_MISSING_PREFIX)?;
+    let (slug, words) = rest.split_once(':')?;
+    Some((HarnessId::from_slug(slug)?, words.trim()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn place_targets_round_trip_with_or_without_a_template() {
+        assert_eq!(
+            place_target("docker", Some("zeron-dev")),
+            "place:docker:zeron-dev"
+        );
+        assert_eq!(
+            parse_place_target("place:docker:docker/sandbox:claude"),
+            Some(("docker", Some("docker/sandbox:claude")))
+        );
+        assert_eq!(
+            parse_place_target(&place_target("boat", None)),
+            Some(("boat", None))
+        );
+        assert_eq!(parse_place_target("place:"), None);
+        assert_eq!(parse_place_target("device-1"), None);
+    }
+
+    #[test]
+    fn a_missing_agent_reads_back_as_its_agent_and_words() {
+        let reason = agent_missing_reason(HarnessId::Codex, "Codex");
+        assert_eq!(
+            agent_missing(&reason),
+            Some((HarnessId::Codex, "Codex isn't on this template"))
+        );
+        assert_eq!(agent_missing("harness binary not found: Codex"), None);
+    }
+}
diff --git a/crates/proto/src/sandboxes.rs b/crates/proto/src/sandboxes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a28ac048a46958c5bc89fbbbb8486fd80e4243d2
--- /dev/null
+++ b/crates/proto/src/sandboxes.rs
@@ -0,0 +1,64 @@
+//! Sandbox devices (spec #37): the engine in one chat's sandbox, on a
+//! provider the user brought (Docker Sandbox, Boat, …). Its device row says
+//! which provider with a capability of its own, `sandbox:<provider>`. Device
+//! lists and pickers hide those rows and show one entry per provider instead.
+//!
+//! Zeron Cloud's [`crate::CLOUD_SESSION_CAPABILITY`] is not reused: clients
+//! send a device with it to Zeron Cloud to wake and sleep.
+
+/// Capabilities naming a sandbox's provider start with this.
+pub const SANDBOX_CAPABILITY_PREFIX: &str = "sandbox:";
+
+/// The capability a sandbox on `provider` advertises.
+pub fn sandbox_capability(provider: &str) -> String {
+    format!("{SANDBOX_CAPABILITY_PREFIX}{provider}")
+}
+
+/// The provider a device's capabilities name, when it is a sandbox.
+pub fn sandbox_provider<S: AsRef<str>>(capabilities: &[S]) -> Option<&str> {
+    capabilities.iter().find_map(|c| {
+        c.as_ref()
+            .strip_prefix(SANDBOX_CAPABILITY_PREFIX)
+            .filter(|provider| !provider.is_empty())
+    })
+}
+
+/// Whether a device is one chat's machine (a sandbox, or a Zeron Cloud
+/// session's): never listed or picked as a device, but still found by id
+/// for its chats.
+pub fn is_one_chats_machine<S: AsRef<str>>(capabilities: &[S]) -> bool {
+    sandbox_provider(capabilities).is_some()
+        || capabilities
+            .iter()
+            .any(|c| c.as_ref() == crate::CLOUD_SESSION_CAPABILITY)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_sandbox_names_its_provider_in_its_capabilities() {
+        let caps = vec![
+            "message-queue-v1".to_string(),
+            sandbox_capability("docker"),
+        ];
+        assert_eq!(caps[1], "sandbox:docker");
+        assert_eq!(sandbox_provider(&caps), Some("docker"));
+    }
+
+    #[test]
+    fn a_machine_of_one_chats_is_a_sandbox_or_a_cloud_session() {
+        assert!(is_one_chats_machine(&["sandbox:docker"]));
+        assert!(is_one_chats_machine(&[crate::CLOUD_SESSION_CAPABILITY]));
+        assert!(!is_one_chats_machine(&["sandbox-host-v1", "sandbox:"]));
+        assert!(!is_one_chats_machine::<&str>(&[]));
+    }
+
+    #[test]
+    fn other_devices_name_no_provider() {
+        assert_eq!(sandbox_provider::<&str>(&[]), None);
+        assert_eq!(sandbox_provider(&["cloud-session", "sandbox-host-v1"]), None);
+        assert_eq!(sandbox_provider(&["sandbox:"]), None);
+    }
+}
