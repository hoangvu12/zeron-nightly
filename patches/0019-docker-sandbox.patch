diff --git a/apps/zgx/ui/screens/chat/sandbox_line.luau b/apps/zgx/ui/screens/chat/sandbox_line.luau
new file mode 100644
index 0000000000000000000000000000000000000000..0898d5f796dc3fe70047b79aa7111ec4e907fca3
--- /dev/null
+++ b/apps/zgx/ui/screens/chat/sandbox_line.luau
@@ -0,0 +1,228 @@
+-- What a chat on a place says of its sandbox's steps (spec #37): one row
+-- above the composer, its own and always shown (ds/composer_band), never
+-- folded into the deck's alerts.
+--
+--   starting      the working ring, the step it's on ("Installing Zeron"),
+--                 how long (muted, "12s") and the 8 steps as segments
+--                 (screens 05, 15)
+--   waking        the ring, "Waking sandbox", how long (09, 11)
+--   a script      the ring, "Running setup.sh" (13)
+--   step failed   "Getting the code failed", its error, Run again
+--   script failed "Setup failed", its path in mono, Run again and × (12)
+--
+-- Ready, asleep (screens/chat/sandbox_machine says that), or not on a place:
+-- nothing. Pure: `steps` as account/sandboxes has them (`{ state, step?,
+-- since, error?, progress?, scripts? }`, `since` and `now` in Unix seconds),
+-- so tests read it without `ui`.
+--
+--   line(steps, now, dismissed?)  the band, or nil (`dismissed`: failed
+--                                 scripts' keys, put away with their ×)
+--   script_key(run)               a failed script's key
+--   ready(steps)                  the transcript's "Sandbox ready 52s":
+--                                 { fresh, took, at } once its start got ready
+--   with_ready(messages, ready, text)  the transcript's messages with that
+--                                 row among them, where it happened
+
+local M = {}
+
+-- ds/composer_band's Band, as data.
+export type Band = {
+	kind: string,
+	title: string,
+	-- Its glyph (nil with `spinner`), in its tone's ink.
+	icon: string?,
+	spinner: boolean?,
+	tone: string?,
+	-- Muted after the title (`mono`: a path).
+	detail: string?,
+	mono: boolean?,
+	-- How long, muted after it.
+	time: string?,
+	-- Each starting step's state ("done", "running", …): its segments.
+	progress: { string }?,
+	-- Its action's label, and whether its × puts it away.
+	action: string?,
+	dismissable: boolean?,
+	-- (A failed script's, for its ×.)
+	key: string?,
+}
+
+local function say(key: string, english: string, args: { [string]: any }?): string
+	if (ui :: any) == nil then
+		return english
+	end
+	return ui.t(`chat.sandbox.{key}`, args):get()
+end
+
+-- Each step, as the band names it while it runs, and as what failed.
+local STEPS: { [string]: { key: string, english: string, noun: string } } = {
+	create = { key = "create", english = "Creating sandbox", noun = "Create" },
+	start = { key = "start", english = "Starting sandbox", noun = "Start" },
+	installZeron = { key = "install", english = "Installing Zeron", noun = "Install" },
+	signIn = { key = "sign_in", english = "Signing in", noun = "Sign-in" },
+	secrets = { key = "secrets", english = "Adding secrets", noun = "Secrets" },
+	getCode = { key = "get_code", english = "Getting the code", noun = "Getting the code" },
+	setup = { key = "setup", english = "Running setup", noun = "Setup" },
+	ready = { key = "ready", english = "Starting Zeron", noun = "Ready" },
+	wake = { key = "wake", english = "Waking sandbox", noun = "Wake" },
+	sleep = { key = "sleep", english = "Going to sleep", noun = "Sleep" },
+	delete = { key = "delete", english = "Deleting sandbox", noun = "Delete" },
+}
+
+function M.step_name(step: string?): string
+	local s = step and STEPS[step]
+	if not s then
+		return say("step.other", "Setting up sandbox")
+	end
+	return say(`step.{s.key}`, s.english)
+end
+
+-- What a step's script is called when it fails ("Setup failed").
+function M.script_failed(step: string?): string
+	local s = step and STEPS[step]
+	if not s then
+		return say("script_failed.other", "Script failed")
+	end
+	return say(`script_failed.{s.key}`, `{s.noun} failed`)
+end
+
+-- How long, compactly: "8s", "1m 05s".
+function M.elapsed(seconds: number): string
+	local s = math.max(0, math.floor(seconds))
+	if s < 60 then
+		return `{s}s`
+	end
+	return string.format("%dm %02ds", s // 60, s % 60)
+end
+
+function M.script_key(run: { script: string?, name: string?, since: number? }): string
+	return `{run.script or run.name or ""}@{run.since or 0}`
+end
+
+local function script(steps: any, state: string, dismissed: { [string]: boolean }?): any?
+	for _, run in steps.scripts or {} do
+		if run.state == state and not (dismissed and dismissed[M.script_key(run)]) then
+			return run
+		end
+	end
+	return nil
+end
+
+-- The band, or nil for none.
+function M.line(steps: any?, now: number, dismissed: { [string]: boolean }?): Band?
+	if not steps then
+		return nil
+	end
+	if steps.state == "failed" and steps.step ~= "wake" and not steps.disk_full then
+		-- A step that failed holds the chat up: no ×, Run again.
+		local name = M.step_name(steps.step)
+		return {
+			kind = "step_failed",
+			tone = "danger",
+			icon = "danger-triangle",
+			title = say("failed", `{name} failed`, { step = name }),
+			detail = if steps.error and steps.error ~= "" then steps.error else nil,
+			action = say("run_again", "Run again"),
+		}
+	end
+	if steps.state == "failed" or steps.state == "gone" then
+		-- (A wake that failed, a full disk, deleted: sandbox_machine's.)
+		return nil
+	end
+	local running = script(steps, "running")
+	if running and (steps.state == "starting" or steps.state == "ready" or steps.state == "waking") then
+		return {
+			kind = "script",
+			spinner = true,
+			title = say("running_script", `Running {running.name}`, { name = running.name }),
+		}
+	end
+	if steps.state == "starting" then
+		return {
+			kind = "starting",
+			spinner = true,
+			title = M.step_name(steps.step),
+			time = M.elapsed(now - (steps.since or now)),
+			progress = steps.progress,
+		}
+	elseif steps.state == "waking" then
+		return {
+			kind = "waking",
+			spinner = true,
+			title = say("waking", "Waking sandbox"),
+			time = M.elapsed(now - (steps.since or now)),
+		}
+	end
+	local failed = script(steps, "failed", dismissed)
+	if failed then
+		return {
+			kind = "script_failed",
+			tone = "danger",
+			icon = "danger-triangle",
+			title = M.script_failed(failed.step),
+			detail = if failed.script and failed.script ~= "" then failed.script else failed.name,
+			mono = true,
+			action = say("run_again", "Run again"),
+			dismissable = true,
+			key = M.script_key(failed),
+		}
+	end
+	return nil
+end
+
+-- The transcript's row once its last start got ready: how long it took,
+-- whether it was Start fresh, and when (to place it). Nil while it starts,
+-- or with no start known.
+function M.ready(steps: any?): { fresh: boolean, took: string, at: number }?
+	local started = steps and steps.started
+	if type(started) ~= "table" or type(started.ready_at) ~= "number" or type(started.at) ~= "number" then
+		return nil
+	end
+	return {
+		fresh = started.fresh == true,
+		took = M.elapsed(started.ready_at - started.at),
+		at = started.ready_at,
+	}
+end
+
+-- The ready row's id in the transcript.
+M.READY_ID = "\0sandbox-ready"
+
+-- The transcript's messages (ds/transcript's, oldest first) with the ready
+-- row among them: before the first reply that began once it was ready (so
+-- after the prompt that waited for it, screens 06–11), else before the
+-- first later prompt (never the chat's first: that one waited for it), else
+-- at the end (Start fresh, nothing sent since: screen 16). Without `ready`,
+-- the messages as they are.
+function M.with_ready(messages: { any }, ready: { took: string, at: number }?, text: string): { any }
+	if not ready then
+		return messages
+	end
+	local at = #messages + 1
+	local first_prompt: number? = nil
+	for i, m in messages do
+		if m.role == "user" and not first_prompt then
+			first_prompt = i
+		end
+		if m.role == "assistant" and type(m.started) == "number" and m.started >= ready.at then
+			at = i
+			break
+		end
+		if m.role == "user" and i ~= first_prompt and type(m.sent) == "number" and m.sent >= ready.at then
+			at = i
+			break
+		end
+	end
+	local out = table.clone(messages)
+	table.insert(out, at, {
+		id = M.READY_ID,
+		role = "event",
+		icon = "check-circle",
+		tone = "success",
+		text = text,
+		detail = ready.took,
+	})
+	return out
+end
+
+return M
diff --git a/apps/zgx/ui/screens/chat/sandbox_machine.luau b/apps/zgx/ui/screens/chat/sandbox_machine.luau
new file mode 100644
index 0000000000000000000000000000000000000000..2eddb4dc829359a9e3e1fcc154505af20e38752e
--- /dev/null
+++ b/apps/zgx/ui/screens/chat/sandbox_machine.luau
@@ -0,0 +1,148 @@
+-- What's said of a chat's sandbox when something went wrong with it (spec #37
+-- "When things go wrong"), and what can be done: pure functions over its
+-- steps (account/sandboxes), nothing drawn. screens/chat/sandbox_tray puts it
+-- in the composer's band, a row of its own over it.
+--
+--   alert(steps)                 the one thing to raise over the composer:
+--                                > deleted outside Zeron ("Sandbox deleted in
+--                                  Docker", Start fresh)
+--                                > its disk full (Start fresh)
+--                                > a wake that failed (Wake)
+--   line(steps)                  asleep (moon, Wake)
+--   resting(steps)               asleep, or going to or from it
+--   band(alert, opts)            that alert as the composer's band, its row of
+--                                its own over the composer (ds/composer_band)
+--   asleep_band(line)            asleep, the same
+--   failure_words(word)          why Start fresh didn't go
+--
+-- A test requires this module alone, in a VM with no `ui`: there, the English
+-- it says (as screens/chat/cloud_machine).
+
+local M = {}
+
+local function say(key: string, english: string, args: { [string]: any }?): string
+	if (ui :: any) == nil then
+		return english
+	end
+	return ui.t(`chat.sandbox_machine.{key}`, args):get()
+end
+
+export type Alert = {
+	-- gone, disk, wake_failed.
+	kind: string,
+	tone: string,
+	title: string,
+	-- A word more, muted after it (none for deleted: its title and Start
+	-- fresh say it, screen 14).
+	detail: string?,
+	-- "fresh" or "wake".
+	action: string?,
+	action_label: string?,
+}
+
+-- The provider as a place is named: "Docker" for "Docker Sandbox".
+function M.place_name(steps: any): string?
+	local name = steps.provider_name
+	if type(name) ~= "string" or name == "" then
+		return nil
+	end
+	local short = string.gsub(name, "%s+[Ss]andbox$", "")
+	return if short ~= "" then short else name
+end
+
+function M.alert(steps: any?): Alert?
+	if not steps then
+		return nil
+	end
+	local fresh = say("fresh", "Start fresh")
+	if steps.state == "gone" then
+		local place = M.place_name(steps)
+		return {
+			kind = "gone",
+			tone = "warning",
+			title = if place
+				then say("gone_title_in", `Sandbox deleted in {place}`, { place = place })
+				else say("gone_title", "Sandbox deleted"),
+			action = "fresh",
+			action_label = fresh,
+		}
+	end
+	if steps.state == "failed" and steps.step == "wake" then
+		return {
+			kind = "wake_failed",
+			tone = "danger",
+			title = say("wake_failed_title", "Sandbox didn't wake"),
+			detail = say("wake_failed_summary", "Try waking it again"),
+			action = "wake",
+			action_label = say("wake", "Wake"),
+		}
+	end
+	if steps.disk_full then
+		return {
+			kind = "disk",
+			tone = "danger",
+			title = say("disk_title", "Sandbox's disk is full"),
+			detail = say("disk_summary", "Free some space, or start fresh"),
+			action = "fresh",
+			action_label = fresh,
+		}
+	end
+	return nil
+end
+
+-- Whether it's stopped, or on its way to or from it: its host device is
+-- offline then, and that isn't "Can't reach" (link_notice).
+function M.resting(steps: any?): boolean
+	local s = steps and steps.state
+	return s == "sleeping" or s == "asleep" or s == "waking"
+end
+
+-- The deck's notice for a sandbox asleep (spec #37 "Sleep and wake"): the
+-- moon, and Wake. Nil otherwise: going to sleep or waking is said in the
+-- transcript, where a send waits for it, and a failed wake is an alert.
+function M.line(steps: any?): { [string]: any }?
+	if not steps or steps.state ~= "asleep" then
+		return nil
+	end
+	return { text = say("asleep", "Sandbox asleep"), action = say("wake", "Wake"), icon = "moon" }
+end
+
+-- Why Start fresh (or Wake, `action` "wake") didn't go, in words.
+function M.failure_words(word: string, action: string?): string
+	local wake = action == "wake"
+	if word == "offline" then
+		return say("failure_offline", "Couldn't reach Zeron on this device. Try again once it's back.")
+	elseif word == "outdated" then
+		return if wake
+			then say("wake_failure_outdated", "This device's Zeron is too old to wake a sandbox. Update it, then try again.")
+			else say("failure_outdated", "This device's Zeron is too old to start a sandbox fresh. Update it, then try again.")
+	elseif word == "signed_out" then
+		return say("failure_signed_out", "Sign in again, then try again.")
+	end
+	return if wake then say("wake_failure", "Couldn't wake it. Try again.") else say("failure", "Couldn't start fresh. Try again.")
+end
+
+-- The alert as the composer's band (screens/chat/sandbox_line's Band): one
+-- row, its title and action alone (screen 14). Deleted wears its provider's
+-- glyph (`icon`, Docker's), the rest their tone's. `busy`: Start fresh (or
+-- Wake) is on its way, the working ring in its glyph's place. `failure`: why
+-- the last one didn't go, said after the title.
+function M.band(a: Alert, opts: { busy: boolean?, failure: string?, icon: string? }?): { [string]: any }
+	local o = opts or {}
+	return {
+		kind = a.kind,
+		tone = if a.kind == "gone" then nil else a.tone,
+		icon = if a.kind == "gone" then (o.icon or "box") else "danger-triangle",
+		spinner = o.busy == true,
+		title = a.title,
+		detail = if o.failure then M.failure_words(o.failure, a.action) else a.detail,
+		action = if o.busy then nil else a.action_label,
+	}
+end
+
+-- Asleep as the band (screen 08): the moon, and Wake; always shown.
+function M.asleep_band(line: { [string]: any }): { [string]: any }
+	return { kind = "asleep", icon = line.icon, title = line.text, action = line.action }
+end
+
+return M
diff --git a/apps/zgx/ui/screens/chat/sandbox_tray.luau b/apps/zgx/ui/screens/chat/sandbox_tray.luau
new file mode 100644
index 0000000000000000000000000000000000000000..751ca1682ff04bdfd027e014d7f47eb1e371a4c1
--- /dev/null
+++ b/apps/zgx/ui/screens/chat/sandbox_tray.luau
@@ -0,0 +1,77 @@
+-- A chat's sandbox, in its composer's band (a row of its own over the
+-- composer, always shown, never in the deck's alerts): tracked reads and the
+-- actions, nothing drawn (as screens/chat/cloud_tray for Cloud). What's said
+-- is screens/chat/sandbox_machine's. The composer follows the chat's steps
+-- (account/sandboxes) while it's open on a sandbox.
+--
+--   local sandbox = SandboxTray.bind { chat = fn }
+--   band(): what's wrong with it (deleted, its disk full, a wake that
+--   failed), else asleep (moon, Wake), as the band takes it; nil for none
+--   act(): its band's action (Start fresh, Wake)
+--   resting(): asleep or on its way to or from it (its host's offline, not
+--   unreachable)
+--   wake(): Wake
+
+local sandboxes = require("@account/sandboxes")
+local logic = require("@app/screens/chat/sandbox_machine")
+
+local M = {}
+
+export type Bind = {
+	-- The open chat while it runs on a sandbox (its device's row names a
+	-- provider), else nil: a chat on any other device is never asked about.
+	chat: () -> string?,
+}
+
+function M.bind(c: Bind): any
+	local b: any = {}
+	function b.steps(): any
+		return sandboxes.machine(c.chat())
+	end
+	b.alert = ui.computed(function(): logic.Alert?
+		return logic.alert(b.steps())
+	end)
+	function b.band(): { [string]: any }?
+		local a = b.alert:get()
+		if a then
+			local f = if a.action == "wake" then sandboxes.wake_state(c.chat()) else sandboxes.fresh_state(c.chat())
+			local s = b.steps()
+			return logic.band(a, { busy = f.busy, failure = f.failure, icon = sandboxes.icon(s and s.provider) })
+		end
+		local line = b.line()
+		return if line then logic.asleep_band(line) else nil
+	end
+	function b.line(): any
+		if sandboxes.wake_state(c.chat()).busy then
+			-- (Woken: its band says so as it comes up.)
+			return nil
+		end
+		return logic.line(b.steps())
+	end
+	function b.resting(): boolean
+		return logic.resting(b.steps())
+	end
+	function b.wake()
+		local chat = c.chat()
+		if chat then
+			sandboxes.wake(chat)
+		end
+	end
+	function b.act()
+		local chat, a = c.chat(), b.alert:peek()
+		if not chat then
+			return
+		end
+		if not a then
+			-- Asleep: Wake.
+			sandboxes.wake(chat)
+		elseif a.action == "fresh" then
+			sandboxes.fresh(chat)
+		elseif a.action == "wake" then
+			sandboxes.wake(chat)
+		end
+	end
+	return b
+end
+
+return M
