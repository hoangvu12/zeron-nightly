+//! A fake sandbox provider (spec #37, Seam 1): each sandbox is a folder under
+//! the test's directory, and its "machine" runs real commands there. Running
+//! Zeron's engine in it (`zeron-engine headless`, detached) starts a second
+//! real engine in this process, configured from the command's environment
+//! the way `zeron-engine` reads its own: on the sign-in the host device lent
+//! it, with the device id it was given.
+//!
+//! What it supplies is configurable, so steps a provider can't do are
+//! exercised: everything (like Docker Sandbox), `run` only (an SSH box), or
+//! `start` only (a PC at home that already runs Zeron).
+
+#![allow(dead_code)]
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use futures::StreamExt;
+use tokio::io::AsyncReadExt;
+use zeron_engine::sandboxes::{
+    Account, Command, CreateSandbox, Credential, ErrorKind, Exit, KeySlot, Ops, Placement,
+    ProviderError, RunEvent, RunStream, SandboxProvider, SandboxStatus, Template,
+};
+use zeron_engine::{Engine, EngineConfig, EngineRuntime, HarnessId, LentSignIn};
+
+/// An engine as `zeron-engine headless` brings one up: auth, its refresh
+/// loop, then the runtime (device room host relay included).
+pub async fn start_engine(config: &EngineConfig) -> EngineRuntime {
+    let auth = Engine::build_auth(config).await;
+    let scope = Engine::initial_workspace_scope(&auth);
+    let profile = Engine::resolve_profile(config, &auth, scope)
+        .expect("profile resolves")
+        .expect("a signed-in profile");
+    drop(auth.spawn_refresh_loop());
+    Engine::assemble_runtime(config, auth, profile)
+        .await
+        .expect("runtime assembles")
+}
+
+pub fn engine_config(data_dir: &Path, edge_url: &str, lent: Option<LentSignIn>) -> EngineConfig {
+    EngineConfig {
+        data_dir: data_dir.to_path_buf(),
+        edge_url: edge_url.to_owned(),
+        edge_token: None,
+        ipc_port: 0,
+        default_harness: HarnessId::Mock,
+        org_id: None,
+        // As production: a WorkOS client id is configured everywhere.
+        workos_client_id: Some("client_test".into()),
+        lent_sign_in: lent,
+    }
+}
+
+/// The engine a PC at home runs, already signed in: the start-only place
+/// starts it.
+pub struct Resident {
+    pub device_id: String,
+    pub edge_url: String,
+    pub sign_in: LentSignIn,
+}
+
+struct FakeBox {
+    dir: PathBuf,
+    /// Its engine's data folder (`ZERON_DATA_DIR` there): one per sandbox
+    /// made, so a new one under the same name starts apart.
+    data_dir: PathBuf,
+    running: bool,
+    engine: Option<EngineRuntime>,
+    /// The sign-in its engine was lent.
+    lent: Option<LentSignIn>,
+}
+
+impl FakeBox {
+    fn new(dir: PathBuf, made: usize, running: bool) -> Self {
+        Self {
+            data_dir: dir.join(format!("zeron-data-{made}")),
+            dir,
+            running,
+            engine: None,
+            lent: None,
+        }
+    }
+}
+
+/// A saved template: a copy of the sandbox's disk.
+struct Saved {
+    template: Template,
+    dir: PathBuf,
+}
+
+#[derive(Default)]
+struct State {
+    calls: Vec<String>,
+    boxes: BTreeMap<String, FakeBox>,
+    /// Create waits while this is set.
+    create_gate: Option<tokio::sync::watch::Receiver<bool>>,
+    /// Commands find the disk full (Zeron's own engine aside).
+    disk_full: bool,
+    /// Sandboxes made so far: each one's engine keeps its data apart.
+    made: usize,
+    saved: Vec<Saved>,
+    /// Time limits pushed out: `<box> <seconds>`.
+    extends: Vec<String>,
+    /// Times it was asked how a sandbox is.
+    statuses: usize,
+}
+
+pub struct FakeProvider {
+    id: String,
+    ops: Ops,
+    root: PathBuf,
+    /// The template has Zeron on it (Install Zeron finds it).
+    has_zeron: bool,
+    /// Every chat on this one place.
+    shared: Option<String>,
+    resident: Option<Resident>,
+    /// The agents its template has (`None`: whatever this computer has).
+    agents: Option<Vec<HarnessId>>,
+    state: Arc<Mutex<State>>,
+    hold: Mutex<Option<tokio::sync::watch::Sender<bool>>>,
+    /// Where one device keeps the account's key ([`Self::on_device`]).
+    slot: Option<KeySlot>,
+}
+
+impl FakeProvider {
+    /// A full cloud: one sandbox per chat, every sandbox operation,
+    /// templates with Zeron on them (no account to connect, no time limit).
+    pub fn cloud(root: &Path) -> Arc<Self> {
+        let ops = Ops::CREATE
+            | Ops::START
+            | Ops::STOP
+            | Ops::DELETE
+            | Ops::RUN
+            | Ops::TEMPLATES
+            | Ops::SAVE_TEMPLATE
+            | Ops::EXTEND;
+        Arc::new(Self::new("fake", ops, root))
+    }
+
+    /// An SSH box: `run` only, every chat on the one box.
+    pub fn run_only(root: &Path) -> Arc<Self> {
+        let mut provider = Self::new("fake-ssh", Ops::RUN, root);
+        provider.shared = Some("box".into());
+        provider
+            .state
+            .lock()
+            .unwrap()
+            .boxes
+            .insert("box".into(), FakeBox::new(root.join("box"), 0, true));
+        Arc::new(provider)
+    }
+
+    /// A PC at home: `start` only, already running Zeron signed in.
+    pub fn start_only(root: &Path, resident: Resident) -> Arc<Self> {
+        let mut provider = Self::new("fake-pc", Ops::START, root);
+        provider.shared = Some("pc".into());
+        provider
+            .state
+            .lock()
+            .unwrap()
+            .boxes
+            .insert("pc".into(), FakeBox::new(root.join("pc"), 0, false));
+        provider.resident = Some(resident);
+        Arc::new(provider)
+    }
+
+    fn new(id: &str, ops: Ops, root: &Path) -> Self {
+        Self {
+            id: id.into(),
+            ops,
+            root: root.to_path_buf(),
+            has_zeron: true,
+            shared: None,
+            resident: None,
+            agents: None,
+            state: Arc::default(),
+            hold: Mutex::new(None),
+            slot: None,
+        }
+    }
+
+    /// The same cloud as one of the user's devices builds it in: connected
+    /// with a key kept in that device's data dir, as Docker Sandbox is.
+    pub fn on_device(&self, data_dir: &Path) -> Arc<Self> {
+        Arc::new(Self {
+            id: self.id.clone(),
+            ops: self.ops | Ops::CONNECT,
+            root: self.root.clone(),
+            has_zeron: self.has_zeron,
+            shared: self.shared.clone(),
+            resident: None,
+            state: self.state.clone(),
+            hold: Mutex::new(None),
+            slot: Some(KeySlot::open(data_dir, &self.id)),
+            agents: self.agents.clone(),
+        })
+    }
+
+    /// A full cloud whose template has only `agents` on it: its engine
+    /// knows no other.
+    pub fn cloud_with_agents(root: &Path, agents: &[HarnessId]) -> Arc<Self> {
+        let mut provider = Self::new("fake", Ops::ALL, root);
+        provider.agents = Some(agents.to_vec());
+        Arc::new(provider)
+    }
+
+    /// The sandbox goes to sleep: its engine stops and nothing runs there
+    /// until it's started again.
+    pub async fn sleep(&self, sandbox: &str) {
+        let engine = {
+            let mut state = self.state.lock().unwrap();
+            let Some(fake) = state.boxes.get_mut(sandbox) else {
+                return;
+            };
+            fake.running = false;
+            fake.engine.take()
+        };
+        if let Some(engine) = engine {
+            engine.shutdown().await;
+        }
+    }
+
+    /// Hold `create` until [`Self::release_create`].
+    pub fn hold_create(&self) {
+        let (tx, rx) = tokio::sync::watch::channel(false);
+        self.state.lock().unwrap().create_gate = Some(rx);
+        *self.hold.lock().unwrap() = Some(tx);
+    }
+
+    pub fn release_create(&self) {
+        if let Some(tx) = self.hold.lock().unwrap().take() {
+            let _ = tx.send(true);
+        }
+    }
+
+    /// What it was asked to do, in order: `create`, `start <box>`,
+    /// `run <box>: <args>`.
+    pub fn calls(&self) -> Vec<String> {
+        self.state.lock().unwrap().calls.clone()
+    }
+
+    /// Each time limit pushed out, in order: `<box> <seconds>`.
+    pub fn extends(&self) -> Vec<String> {
+        self.state.lock().unwrap().extends.clone()
+    }
+
+    /// How many times it was asked how a sandbox is (kept apart from
+    /// `calls`: the host device asks each time it looks at a sandbox).
+    pub fn statuses(&self) -> usize {
+        self.state.lock().unwrap().statuses
+    }
+
+    pub fn sandboxes(&self) -> Vec<String> {
+        self.state.lock().unwrap().boxes.keys().cloned().collect()
+    }
+
+    /// The user deletes `sandbox` in the provider's own console: its engine
+    /// goes with it.
+    pub async fn delete_outside(&self, sandbox: &str) {
+        self.discard(sandbox).await;
+    }
+
+    /// Commands in its sandboxes find the disk full (or not, again).
+    pub fn set_disk_full(&self, full: bool) {
+        self.state.lock().unwrap().disk_full = full;
+    }
+
+    /// The key of the sign-in `sandbox`'s engine was lent, once it started.
+    pub fn lent_key(&self, sandbox: &str) -> Option<String> {
+        self.lent(sandbox).map(|(key, _)| key)
+    }
+
+    /// The sign-in `sandbox`'s engine was lent: `(key, token)`.
+    pub fn lent(&self, sandbox: &str) -> Option<(String, String)> {
+        let state = self.state.lock().unwrap();
+        let lent = state.boxes.get(sandbox)?.lent.as_ref()?;
+        Some((lent.key.clone(), lent.token.clone()))
+    }
+
+    /// `sandbox`'s engine's data folder.
+    pub fn data_dir(&self, sandbox: &str) -> Option<PathBuf> {
+        Some(
+            self.state
+                .lock()
+                .unwrap()
+                .boxes
+                .get(sandbox)?
+                .data_dir
+                .clone(),
+        )
+    }
+
+    /// The templates saved, in order.
+    pub fn saved(&self) -> Vec<Template> {
+        let state = self.state.lock().unwrap();
+        state.saved.iter().map(|s| s.template.clone()).collect()
+    }
+
+    /// What template `id` holds: each file's path in the sandbox (`home/…`,
+    /// and `zeron-data/…` for its engine's data) and its bytes.
+    pub fn template_files(&self, id: &str) -> Vec<(String, Vec<u8>)> {
+        let dir = {
+            let state = self.state.lock().unwrap();
+            let saved = state.saved.iter().find(|s| s.template.id == id);
+            saved.expect("a saved template").dir.clone()
+        };
+        let mut files = Vec::new();
+        list_files(&dir, &dir, &mut files);
+        files.sort();
+        files
+    }
+
+    async fn discard(&self, sandbox: &str) -> bool {
+        let removed = self.state.lock().unwrap().boxes.remove(sandbox);
+        let Some(fake) = removed else {
+            return false;
+        };
+        if let Some(engine) = fake.engine {
+            engine.shutdown().await;
+        }
+        // Its checkout goes. (Its engine's data stays: on Windows a file may
+        // still be held a moment, and each sandbox's engine has a data
+        // folder of its own.)
+        let home = fake.dir.join("home");
+        writable(&home);
+        if let Err(err) = std::fs::remove_dir_all(&home)
+            && home.exists()
+        {
+            panic!("the fake couldn't delete {}: {err}", home.display());
+        }
+        true
+    }
+
+    /// Look inside the engine running in `sandbox`, once it has started.
+    pub fn with_engine<T>(
+        &self,
+        sandbox: &str,
+        look: impl FnOnce(&zeron_engine::EngineCore) -> T,
+    ) -> Option<T> {
+        let state = self.state.lock().unwrap();
+        let engine = state.boxes.get(sandbox)?.engine.as_ref()?;
+        Some(look(engine.core()))
+    }
+
+    fn record(&self, call: String) {
+        self.state.lock().unwrap().calls.push(call);
+    }
+
+    fn dir(&self, sandbox: &str) -> Result<PathBuf, ProviderError> {
+        let state = self.state.lock().unwrap();
+        let fake = state.boxes.get(sandbox).ok_or_else(|| {
+            ProviderError::new(ErrorKind::NotFound, format!("no sandbox {sandbox}"))
+        })?;
+        if !fake.running {
+            return Err(ProviderError::new(
+                ErrorKind::Conflict,
+                format!("{sandbox} isn't running"),
+            ));
+        }
+        Ok(fake.dir.clone())
+    }
+
+    /// `zeron-engine headless`, detached: boot an engine from the command's
+    /// environment, as the real binary reads its own.
+    fn boot(&self, sandbox: &str, env: &BTreeMap<String, String>) -> RunStream {
+        let var = |name: &str| env.get(name).cloned();
+        let [lender, key, token] = LentSignIn::ENV.map(var);
+        let lent = match (lender, key, token) {
+            (Some(lender), Some(key), Some(token)) => LentSignIn { lender, key, token },
+            _ => return exit_with(1, "no lent sign-in in the environment"),
+        };
+        let Some(edge_url) = var("ZERON_EDGE_URL") else {
+            return exit_with(1, "ZERON_EDGE_URL isn't set");
+        };
+        let data_dir = {
+            let mut state = self.state.lock().unwrap();
+            let Some(fake) = state.boxes.get_mut(sandbox) else {
+                return exit_with(1, "the sandbox is gone");
+            };
+            fake.lent = Some(lent.clone());
+            fake.data_dir.clone()
+        };
+        std::fs::create_dir_all(&data_dir).unwrap();
+        if let Some(device) = var(zeron_engine::sandboxes::DEVICE_ID_ENV) {
+            zeron_engine::sandboxes::take_device_id(&data_dir, &device).unwrap();
+        }
+        if let Some(provider) = var(zeron_engine::sandboxes::PROVIDER_ENV) {
+            zeron_engine::sandboxes::take_provider(&data_dir, &provider).unwrap();
+        }
+        let config = engine_config(&data_dir, &edge_url, Some(lent));
+        let up = self.spawn_engine(sandbox, config);
+        if self.agents.is_none() {
+            return futures::stream::iter([Ok(RunEvent::Exit(Exit::code(0)))]).boxed();
+        }
+        // A template's agents are there before anyone can ask its engine.
+        futures::stream::once(async move {
+            let _ = up.await;
+            Ok(RunEvent::Exit(Exit::code(0)))
+        })
+        .boxed()
+    }
+
+    /// `zeron-engine forget-device`: its engine quiesced and stopped, then
+    /// Zeron's identity wiped from its data, as the real command does.
+    async fn forget(&self, sandbox: &str) -> RunStream {
+        let (engine, data_dir) = {
+            let mut state = self.state.lock().unwrap();
+            let Some(fake) = state.boxes.get_mut(sandbox) else {
+                return exit_with(1, "the sandbox is gone");
+            };
+            (fake.engine.take(), fake.data_dir.clone())
+        };
+        if let Some(engine) = engine {
+            if let Err(busy) = engine.core().doc_host.quiesce_for_sleep().await {
+                if let Some(fake) = self.state.lock().unwrap().boxes.get_mut(sandbox) {
+                    fake.engine = Some(engine);
+                }
+                return exit_with(75, &format!("busy: {busy}"));
+            }
+            engine.shutdown().await;
+        }
+        match zeron_engine::sandboxes::forget_device_files(&data_dir) {
+            Ok(()) => futures::stream::iter([Ok(RunEvent::Exit(Exit::code(0)))]).boxed(),
+            Err(err) => exit_with(1, &err.to_string()),
+        }
+    }
+
+    /// `zeron-engine quiesce`: the engine winds down for a sleep; 75 when
+    /// it's busy (a turn running, a message waiting).
+    fn quiesce(&self, sandbox: &str) -> RunStream {
+        let doc_host = {
+            let state = self.state.lock().unwrap();
+            state
+                .boxes
+                .get(sandbox)
+                .and_then(|fake| fake.engine.as_ref())
+                .map(|engine| engine.core().doc_host.clone())
+        };
+        let Some(doc_host) = doc_host else {
+            return exit_with(1, "zeron-engine isn't running");
+        };
+        futures::stream::once(async move {
+            Ok(RunEvent::Exit(Exit::code(
+                match doc_host.quiesce_for_sleep().await {
+                    Ok(()) => 0,
+                    Err(_) => 75,
+                },
+            )))
+        })
+        .boxed()
+    }
+
+    /// Start an engine in `sandbox`; the receiver fires once it's up.
+    fn spawn_engine(
+        &self,
+        sandbox: &str,
+        config: EngineConfig,
+    ) -> tokio::sync::oneshot::Receiver<()> {
+        let state = self.state.clone();
+        let sandbox = sandbox.to_owned();
+        let agents = self.agents.clone();
+        let (up_tx, up) = tokio::sync::oneshot::channel();
+        tokio::spawn(async move {
+            let engine = start_engine(&config).await;
+            if let Some(agents) = agents {
+                engine.core().registry.retain(|id| agents.contains(&id));
+            }
+            if let Some(fake) = state.lock().unwrap().boxes.get_mut(&sandbox) {
+                fake.engine = Some(engine);
+            }
+            let _ = up_tx.send(());
+        });
+        up
+    }
+}
+
+/// Make everything under `dir` writable (git's objects are read-only, which
+/// Windows won't delete).
+fn writable(dir: &Path) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            writable(&path);
+        } else if let Ok(meta) = std::fs::metadata(&path) {
+            let mut perms = meta.permissions();
+            #[allow(clippy::permissions_set_readonly_false)]
+            perms.set_readonly(false);
+            let _ = std::fs::set_permissions(&path, perms);
+        }
+    }
+}
+
+fn copy_dir(from: &Path, to: &Path) {
+    std::fs::create_dir_all(to).unwrap();
+    let Ok(entries) = std::fs::read_dir(from) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let target = to.join(entry.file_name());
+        if path.is_dir() {
+            copy_dir(&path, &target);
+        } else {
+            // (A file held open, a lock, is copied as far as it reads.)
+            let _ = std::fs::copy(&path, &target);
+        }
+    }
+}
+
+fn list_files(root: &Path, dir: &Path, out: &mut Vec<(String, Vec<u8>)>) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            list_files(root, &path, out);
+        } else {
+            let name = path.strip_prefix(root).unwrap().to_string_lossy();
+            out.push((
+                name.replace('\\', "/"),
+                std::fs::read(&path).unwrap_or_default(),
+            ));
+        }
+    }
+}
+
+fn exit_with(code: i32, stderr: &str) -> RunStream {
+    futures::stream::iter([
+        Ok(RunEvent::Stderr(stderr.as_bytes().to_vec())),
+        Ok(RunEvent::Exit(Exit::code(code))),
+    ])
+    .boxed()
+}
+
+#[async_trait]
+impl SandboxProvider for FakeProvider {
+    fn id(&self) -> &str {
+        &self.id
+    }
+
+    fn name(&self) -> &str {
+        "Fake Sandbox"
+    }
+
+    fn icon(&self) -> &str {
+        "box"
+    }
+
+    fn ops(&self) -> Ops {
+        self.ops
+    }
+
+    fn account(&self) -> Option<Account> {
+        self.slot.as_ref()?.get().map(|_| Account {
+            name: "fake-account".into(),
+        })
+    }
+
+    async fn connect(&self, credential: Credential) -> Result<Account, ProviderError> {
+        let Credential::Token(token) = credential else {
+            return Err(ProviderError::unsupported("sign in on a page"));
+        };
+        // The keys the fake cloud gives out start with `fake-`.
+        if !token.starts_with("fake-") {
+            return Err(ProviderError::new(
+                ErrorKind::Config,
+                "that isn't a fake cloud key",
+            ));
+        }
+        self.adopt_key(serde_json::json!({ "token": token }).to_string())
+            .await
+    }
+
+    fn export_key(&self) -> Option<String> {
+        self.slot.as_ref()?.get()
+    }
+
+    async fn adopt_key(&self, raw: String) -> Result<Account, ProviderError> {
+        let slot = self
+            .slot
+            .as_ref()
+            .ok_or_else(|| ProviderError::unsupported("keep a key"))?;
+        slot.set(&raw)
+            .map_err(|e| ProviderError::new(ErrorKind::Fatal, e.to_string()))?;
+        Ok(Account {
+            name: "fake-account".into(),
+        })
+    }
+
+    async fn forget_key(&self) {
+        if let Some(slot) = &self.slot {
+            slot.clear().unwrap();
+        }
+    }
+
+    fn placement(&self, _chat_id: &str) -> Placement {
+        match &self.shared {
+            None => Placement::PerChat,
+            Some(sandbox) => Placement::Shared {
+                sandbox: sandbox.clone(),
+                device_id: self.resident.as_ref().map(|r| r.device_id.clone()),
+            },
+        }
+    }
+
+    /// The account's one template, then those saved from its sandboxes.
+    async fn templates(&self) -> Result<Vec<Template>, ProviderError> {
+        let mut templates = vec![Template {
+            id: "zeron-dev".into(),
+            name: "zeron-dev".into(),
+        }];
+        templates.extend(self.saved());
+        Ok(templates)
+    }
+
+    fn workdir(&self, chat_id: &str) -> String {
+        // Each chat's sandbox is its own folder (`create` names it after
+        // the chat); on a shared box every chat works in the same home.
+        let sandbox = self.shared.clone().unwrap_or_else(|| chat_id.to_owned());
+        self.root
+            .join(sandbox)
+            .join("home")
+            .to_string_lossy()
+            .into_owned()
+    }
+
+    async fn create(&self, request: CreateSandbox) -> Result<String, ProviderError> {
+        self.record("create".into());
+        let gate = self.state.lock().unwrap().create_gate.clone();
+        if let Some(mut gate) = gate {
+            let _ = gate.wait_for(|open| *open).await;
+        }
+        let sandbox = request.key.clone();
+        let dir = self.root.join(&sandbox);
+        std::fs::create_dir_all(dir.join("home")).unwrap();
+        let mut state = self.state.lock().unwrap();
+        state.made += 1;
+        let fake = FakeBox::new(dir, state.made, true);
+        // From a saved template: its disk, as it was saved. (The account's
+        // own template starts as Blank does.)
+        if let Some(saved) = request
+            .template
+            .as_ref()
+            .and_then(|id| state.saved.iter().find(|s| &s.template.id == id))
+        {
+            copy_dir(&saved.dir.join("home"), &fake.dir.join("home"));
+            copy_dir(&saved.dir.join("zeron-data"), &fake.data_dir);
+        }
+        state.boxes.insert(sandbox.clone(), fake);
+        Ok(sandbox)
+    }
+
+    async fn delete(&self, sandbox: &str) -> Result<(), ProviderError> {
+        self.record(format!("delete {sandbox}"));
+        if self.discard(sandbox).await {
+            Ok(())
+        } else {
+            Err(ProviderError::new(
+                ErrorKind::NotFound,
+                format!("no sandbox {sandbox}"),
+            ))
+        }
+    }
+
+    async fn extend(&self, sandbox: &str, ttl: std::time::Duration) -> Result<(), ProviderError> {
+        // Kept apart from `calls`: the host device extends whenever it
+        // finds a chat busy, in any test.
+        let extended = format!("{sandbox} {}", ttl.as_secs());
+        self.state.lock().unwrap().extends.push(extended);
+        self.dir(sandbox).map(drop)
+    }
+
+    async fn status(&self, sandbox: &str) -> Result<SandboxStatus, ProviderError> {
+        let mut state = self.state.lock().unwrap();
+        state.statuses += 1;
+        Ok(match state.boxes.get(sandbox) {
+            None => SandboxStatus::Gone,
+            Some(fake) if fake.running => SandboxStatus::Running,
+            Some(_) => SandboxStatus::Stopped,
+        })
+    }
+
+    async fn start(&self, sandbox: &str) -> Result<(), ProviderError> {
+        self.record(format!("start {sandbox}"));
+        let config = {
+            let mut state = self.state.lock().unwrap();
+            let fake = state.boxes.get_mut(sandbox).ok_or_else(|| {
+                ProviderError::new(ErrorKind::NotFound, format!("no sandbox {sandbox}"))
+            })?;
+            let woke = !fake.running;
+            fake.running = true;
+            // A PC at home: waking it starts the Zeron it runs.
+            match &self.resident {
+                Some(resident) if woke && fake.engine.is_none() => {
+                    let data_dir = fake.dir.join("zeron-data");
+                    std::fs::create_dir_all(&data_dir).unwrap();
+                    std::fs::write(data_dir.join("device-id"), &resident.device_id).unwrap();
+                    Some(engine_config(
+                        &data_dir,
+                        &resident.edge_url,
+                        Some(resident.sign_in.clone()),
+                    ))
+                }
+                _ => None,
+            }
+        };
+        if let Some(config) = config {
+            drop(self.spawn_engine(sandbox, config));
+        }
+        Ok(())
+    }
+
+    async fn stop(&self, sandbox: &str) -> Result<(), ProviderError> {
+        self.record(format!("stop {sandbox}"));
+        let engine = {
+            let mut state = self.state.lock().unwrap();
+            let fake = state.boxes.get_mut(sandbox).ok_or_else(|| {
+                ProviderError::new(ErrorKind::NotFound, format!("no sandbox {sandbox}"))
+            })?;
+            fake.running = false;
+            fake.engine.take()
+        };
+        if let Some(engine) = engine {
+            engine.shutdown().await;
+        }
+        Ok(())
+    }
+
+    /// A copy of the sandbox's whole disk: its home and its engine's data.
+    async fn save_template(&self, sandbox: &str, name: &str) -> Result<Template, ProviderError> {
+        self.record(format!("save {sandbox}: {name}"));
+        let mut state = self.state.lock().unwrap();
+        let fake = state.boxes.get(sandbox).ok_or_else(|| {
+            ProviderError::new(ErrorKind::NotFound, format!("no sandbox {sandbox}"))
+        })?;
+        let id = format!("tmpl-{}", state.saved.len() + 1);
+        let dir = self.root.join("templates").join(&id);
+        copy_dir(&fake.dir.join("home"), &dir.join("home"));
+        copy_dir(&fake.data_dir, &dir.join("zeron-data"));
+        let template = Template {
+            id,
+            name: name.to_owned(),
+        };
+        state.saved.push(Saved {
+            template: template.clone(),
+            dir,
+        });
+        Ok(template)
+    }
+
+    async fn run(&self, sandbox: &str, command: Command) -> Result<RunStream, ProviderError> {
+        self.record(format!("run {sandbox}: {}", command.args.join(" ")));
+        let dir = self.dir(sandbox)?;
+        let home = dir.join("home");
+        std::fs::create_dir_all(&home).unwrap();
+        let Some(program) = command.args.first() else {
+            return Ok(exit_with(2, "no program"));
+        };
+        if program == zeron_engine::sandboxes::ENGINE_PROGRAM {
+            return Ok(match command.args.get(1).map(String::as_str) {
+                Some("--version") if self.has_zeron => futures::stream::iter([
+                    Ok(RunEvent::Stdout(b"zeron 0.0.0-fake\n".to_vec())),
+                    Ok(RunEvent::Exit(Exit::code(0))),
+                ])
+                .boxed(),
+                // Under its watchdog, as Zeron starts it, or bare.
+                Some("watchdog" | "headless") if command.detach => {
+                    // A rerun replaces the engine already there.
+                    let old = self
+                        .state
+                        .lock()
+                        .unwrap()
+                        .boxes
+                        .get_mut(sandbox)
+                        .and_then(|fake| fake.engine.take());
+                    if let Some(old) = old {
+                        old.shutdown().await;
+                    }
+                    self.boot(sandbox, &command.env)
+                }
+                Some("quiesce") => self.quiesce(sandbox),
+                Some(zeron_engine::sandboxes::FORGET_DEVICE) => self.forget(sandbox).await,
+                _ => exit_with(127, "zeron-engine: not found"),
+            });
+        }
+        if self.state.lock().unwrap().disk_full {
+            return Ok(exit_with(
+                1,
+                &format!("{program}: write error: No space left on device"),
+            ));
+        }
+        let cwd = command.cwd.map(PathBuf::from).unwrap_or(home.clone());
+        // The sandbox's `sh` (step scripts): on Windows, Git's.
+        let mut child = if program == "sh" {
+            tokio::process::Command::from(zeron_engine::sandboxes::scripts::sh_command())
+        } else {
+            tokio::process::Command::new(program)
+        };
+        child
+            .args(&command.args[1..])
+            .current_dir(&cwd)
+            .envs(&command.env)
+            .env("HOME", &home)
+            .stdin(std::process::Stdio::null())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .kill_on_drop(true);
+        let mut child = match child.spawn() {
+            Ok(child) => child,
+            Err(err) => return Ok(exit_with(127, &format!("{program}: {err}"))),
+        };
+        let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut stdout = child.stdout.take().unwrap();
+        let mut stderr = child.stderr.take().unwrap();
+        tokio::spawn(async move {
+            let (mut out, mut err) = (Vec::new(), Vec::new());
+            let _ = tokio::join!(stdout.read_to_end(&mut out), stderr.read_to_end(&mut err));
+            let status = child.wait().await;
+            let _ = tx.send(Ok(RunEvent::Stdout(out)));
+            let _ = tx.send(Ok(RunEvent::Stderr(err)));
+            let code = status.ok().and_then(|s| s.code());
+            let _ = tx.send(Ok(RunEvent::Exit(Exit {
+                code,
+                timed_out: false,
+            })));
+        });
+        Ok(tokio_stream_from(rx))
+    }
+}
+
+fn tokio_stream_from(
+    mut rx: tokio::sync::mpsc::UnboundedReceiver<Result<RunEvent, ProviderError>>,
+) -> RunStream {
+    futures::stream::poll_fn(move |cx| rx.poll_recv(cx)).boxed()
+}
diff --git a/crates/engine/tests/support/places.rs b/crates/engine/tests/support/places.rs
new file mode 100644
index 0000000000000000000000000000000000000000..795c64259f6b405c2d5c42e7d737ff55fb0e8317
--- /dev/null
+++ b/crates/engine/tests/support/places.rs
@@ -0,0 +1,206 @@
+//! What tests of chats on places share: the host device, a project with an
+//! `origin`, creating a chat on a place and following its steps through
+//! the engine's RPCs. (Same fixtures as `sandbox_place.rs`, which predates
+//! this module.)
+
+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use serde_json::{Value, json};
+use zeron_doc::SessionCommandPayload;
+use zeron_engine::EngineRuntime;
+use zeron_proto::{HarnessId, RunRequest, SandboxLevel};
+use zeron_rpc::{RpcClient, methods};
+
+use crate::fake_provider::{engine_config, start_engine};
+use crate::scripted_edge::{ScriptedEdge, USER};
+
+pub const ORG: &str = "org_home";
+pub const SPACE: &str = "space-1";
+
+/// The host device: signed in with a WorkOS session on its disk.
+pub async fn host_device(dir: &Path, edge: &ScriptedEdge) -> EngineRuntime {
+    std::fs::create_dir_all(dir).unwrap();
+    let session = json!({
+        "refreshToken": edge.seed_session(ORG),
+        "user": { "id": USER, "email": "u@example.com" },
+        "orgId": ORG,
+    });
+    std::fs::write(dir.join("session.json"), session.to_string()).unwrap();
+    start_engine(&engine_config(dir, &edge.url, None)).await
+}
+
+pub fn git(cwd: &Path, args: &[&str]) -> String {
+    let out = std::process::Command::new("git")
+        .args(args)
+        .current_dir(cwd)
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .output()
+        .expect("git runs");
+    assert!(
+        out.status.success(),
+        "git {args:?}: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    String::from_utf8_lossy(&out.stdout).trim().to_owned()
+}
+
+/// Commit everything in `cwd` as a test user.
+pub fn commit(cwd: &Path, message: &str) {
+    git(cwd, &["add", "."]);
+    git(
+        cwd,
+        &[
+            "-c",
+            "user.name=t",
+            "-c",
+            "user.email=t@example.com",
+            "commit",
+            "-qm",
+            message,
+        ],
+    );
+}
+
+/// A bare `origin` with one commit on `main`.
+pub fn origin(at: &Path) {
+    let seed = at.with_extension("seed");
+    std::fs::create_dir_all(&seed).unwrap();
+    git(&seed, &["init", "-q", "-b", "main"]);
+    std::fs::write(seed.join("README.md"), "reportly\n").unwrap();
+    commit(&seed, "first");
+    git(
+        at.parent().unwrap(),
+        &[
+            "clone",
+            "-q",
+            "--bare",
+            &seed.to_string_lossy(),
+            &at.to_string_lossy(),
+        ],
+    );
+}
+
+/// The project on the host device: a checkout of `origin_url`.
+pub fn project(dir: &Path, origin_url: &Path) -> PathBuf {
+    let project = dir.join("reportly");
+    std::fs::create_dir_all(&project).unwrap();
+    git(&project, &["init", "-q", "-b", "main"]);
+    git(
+        &project,
+        &["remote", "add", "origin", &origin_url.to_string_lossy()],
+    );
+    project
+}
+
+pub async fn add_project(rpc: &RpcClient, host: &EngineRuntime, path: &Path) {
+    rpc.call(
+        methods::MUTATE,
+        json!({
+            "op": "createSpace",
+            "spaceId": SPACE,
+            "deviceId": host.core().device_id,
+            "path": path.to_string_lossy(),
+            "gitDetected": true,
+        }),
+    )
+    .await
+    .expect("createSpace");
+}
+
+/// Create `chat` on `provider`, as the composer does: `{deviceId, cwd}`.
+pub async fn create_on_place(rpc: &RpcClient, chat: &str, provider: &str) -> Value {
+    rpc.call(
+        methods::MUTATE,
+        json!({
+            "op": "createChat",
+            "chatId": chat,
+            "spaceId": SPACE,
+            "place": { "provider": provider },
+        }),
+    )
+    .await
+    .expect("createChat on a place")
+}
+
+/// Send a message, as a client does: a Run command in the chat doc.
+pub async fn send(rpc: &RpcClient, chat: &str, message_id: &str, cwd: &str, prompt: &str) {
+    let command = serde_json::to_value(SessionCommandPayload::Run {
+        request: RunRequest {
+            mcp: None,
+            prompt: prompt.into(),
+            harness: Some(HarnessId::Mock),
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            cwd: cwd.into(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            auto_approve: true,
+            access: Default::default(),
+            plan: false,
+            attachments: Vec::new(),
+            worktree: None,
+            resume: None,
+            env: Default::default(),
+            extra_mcp: Vec::new(),
+        },
+        message_id: message_id.into(),
+    })
+    .unwrap();
+    rpc.call(
+        methods::QUEUE_COMMAND,
+        json!({ "chatId": chat, "command": command }),
+    )
+    .await
+    .expect("queue the message");
+}
+
+pub async fn steps(rpc: &RpcClient, chat: &str) -> Value {
+    rpc.call(methods::SANDBOX_STEPS, json!({ "chatId": chat }))
+        .await
+        .expect("SandboxSteps")
+}
+
+/// Poll the chat's steps until `done` says so; panics with the last answer.
+pub async fn steps_until(
+    rpc: &RpcClient,
+    chat: &str,
+    within: Duration,
+    done: impl Fn(&Value) -> bool,
+) -> Value {
+    let deadline = Instant::now() + within;
+    loop {
+        let now = steps(rpc, chat).await;
+        if done(&now) {
+            return now;
+        }
+        assert!(Instant::now() < deadline, "steps of {chat}: {now:#}");
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+}
+
+pub async fn ready(rpc: &RpcClient, chat: &str) -> Value {
+    steps_until(rpc, chat, Duration::from_secs(60), |s| {
+        assert!(s["state"] != "failed" && s["state"] != "gone", "{s:#}");
+        s["state"] == "ready"
+    })
+    .await
+}
+
+/// Poll `check` until it gives a value; panics with `what` after `within`.
+pub async fn eventually<T>(
+    what: &str,
+    within: Duration,
+    mut check: impl AsyncFnMut() -> Option<T>,
+) -> T {
+    let deadline = Instant::now() + within;
+    loop {
+        if let Some(value) = check().await {
+            return value;
+        }
+        assert!(Instant::now() < deadline, "never: {what}");
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+}
diff --git a/crates/engine/tests/support/scripted_edge.rs b/crates/engine/tests/support/scripted_edge.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c709b7f30645dc777b09eccb08e2d3d9909acc78
--- /dev/null
+++ b/crates/engine/tests/support/scripted_edge.rs
@@ -0,0 +1,623 @@
+//! A scripted edge for engines on a borrowed sign-in (ADR 0003): the user's
+//! devices and sandboxes against one port. It models what the real edge
+//! checks: WorkOS refresh tokens are single-use and carry their org scope, an
+//! org-scoped refresh moves the session, and a device room admits any
+//! unexpired bearer of the user (whatever device or session minted it).
+//!
+//! - `POST /auth/refresh`: WorkOS refresh through the edge.
+//! - `/device/{id}/ws`: DeviceRoom relay (edge/src/device-room.ts), as the
+//!   client crate's mock edge has it; every dial is recorded. A host joining
+//!   closes the one before with 4409.
+//! - `POST /device/{id}/nudge`: queued per chat in a room some host has
+//!   claimed (404 before), sent to the host now or when one joins, and
+//!   deleted as it's sent: production's front worker drops `nudgeAck`.
+//! - `/registry/{org}/ws`, with [`ScriptedEdge::with_registry`]: proxied to
+//!   zeron-sync's `MockRegistryServer`, so devices' and chats' rows reach
+//!   every engine.
+//! - Anything else (chat rooms, releases): 404, which engines retry quietly.
+
+// Each test binary uses its own part of this.
+#![allow(dead_code)]
+// tungstenite fixes the handshake callback's Err type as a full Response.
+#![allow(clippy::result_large_err)]
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use base64::Engine as _;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD as B64URL;
+use futures::{SinkExt, StreamExt};
+use serde_json::{Value, json};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::protocol::CloseFrame;
+use tokio_tungstenite::tungstenite::protocol::frame::coding::CloseCode;
+use tokio_tungstenite::tungstenite::handshake::server::{ErrorResponse, Request, Response};
+use tokio_tungstenite::tungstenite::http;
+use zeron_rpc::device_room::{
+    CLIENT_CLOSED, CLIENT_GONE, HOST_CLOSED, HOST_OFFLINE, NUDGE_KIND, RELAY_KIND,
+};
+use zeron_rpc::{DeviceFrameHeader, decode_device_frame, encode_device_frame};
+use zeron_sync::registry::mock_server::MockRegistryServer;
+
+pub const USER: &str = "user_1";
+
+pub fn now_secs() -> i64 {
+    chrono::Utc::now().timestamp()
+}
+
+/// An unsigned JWT with the claims the engine and this edge read.
+pub fn jwt(org: &str, ttl: i64) -> String {
+    let iat = now_secs();
+    let claims =
+        json!({ "sub": USER, "sid": "session_1", "org_id": org, "iat": iat, "exp": iat + ttl });
+    format!("e30.{}.sig", B64URL.encode(claims.to_string()))
+}
+
+pub fn claims(token: &str) -> Option<Value> {
+    let payload = token.split('.').nth(1)?;
+    serde_json::from_slice(&B64URL.decode(payload).ok()?).ok()
+}
+
+/// One WebSocket dial of a device room, as the edge saw it.
+#[derive(Clone, Debug)]
+pub struct Dial {
+    pub device: String,
+    pub role: String,
+    pub org: Option<String>,
+    pub admitted: bool,
+}
+
+enum Out {
+    Frame(Vec<u8>),
+    /// Close, with a code (4409: another host joined).
+    Close(Option<u16>),
+}
+
+/// The DeviceRoom's close for a superseded host.
+const SUPERSEDED: u16 = 4409;
+
+type Tx = tokio::sync::mpsc::UnboundedSender<Out>;
+
+#[derive(Default)]
+struct Room {
+    host: Option<Tx>,
+    clients: HashMap<String, Tx>,
+    /// A host has joined once: the room has an owner.
+    claimed: bool,
+    /// Nudges not yet sent to a host, one per chat.
+    nudges: Vec<String>,
+}
+
+impl Room {
+    /// Send every queued nudge to the host, deleting each as it goes.
+    fn replay(&mut self) {
+        let Some(host) = &self.host else { return };
+        for chat in self.nudges.drain(..) {
+            let payload = json!({ "chatId": chat, "token": uuid_ish() }).to_string();
+            let frame = encode_device_frame(&DeviceFrameHeader::new(&chat, NUDGE_KIND), payload.as_bytes())
+                .unwrap();
+            let _ = host.send(Out::Frame(frame));
+        }
+    }
+}
+
+fn uuid_ish() -> String {
+    format!("{:x}", rand_u64())
+}
+
+fn rand_u64() -> u64 {
+    use std::hash::{BuildHasher, Hasher};
+    let mut hasher = std::collections::hash_map::RandomState::new().build_hasher();
+    hasher.write_u64(0);
+    hasher.finish()
+}
+
+#[derive(Default)]
+struct EdgeState {
+    /// Live WorkOS refresh tokens and the org each is scoped to (single-use).
+    refresh_tokens: HashMap<String, String>,
+    minted: usize,
+    seeded: usize,
+    /// Access-token lifetime per org (seconds); 3600 otherwise.
+    ttl: HashMap<String, i64>,
+    dials: Vec<Dial>,
+    rooms: HashMap<String, Room>,
+    /// `POST /plugin-keys` bodies: a device registering a signing key.
+    plugin_keys: Vec<Value>,
+    /// Every nudge posted: `(device, chat)`.
+    nudged: Vec<(String, String)>,
+}
+
+impl EdgeState {
+    fn ttl(&self, org: &str) -> i64 {
+        self.ttl.get(org).copied().unwrap_or(3600)
+    }
+}
+
+pub struct ScriptedEdge {
+    pub url: String,
+    pub registry: Option<MockRegistryServer>,
+    state: Arc<Mutex<EdgeState>>,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for ScriptedEdge {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+impl ScriptedEdge {
+    /// Device rooms and sign-in; the registry is a 404.
+    pub async fn start() -> Self {
+        Self::serve(None).await
+    }
+
+    /// And a registry every engine shares.
+    pub async fn with_registry() -> Self {
+        Self::serve(Some(MockRegistryServer::start().await)).await
+    }
+
+    async fn serve(registry: Option<MockRegistryServer>) -> Self {
+        let registry_url = registry.as_ref().map(MockRegistryServer::url);
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        let state = Arc::new(Mutex::new(EdgeState::default()));
+        let shared = state.clone();
+        let task = tokio::spawn(async move {
+            while let Ok((stream, _)) = listener.accept().await {
+                tokio::spawn(serve_one(stream, shared.clone(), registry_url.clone()));
+            }
+        });
+        Self {
+            url,
+            registry,
+            state,
+            task,
+        }
+    }
+
+    /// A signed-in session for a device's disk, scoped to `org`: each device
+    /// seeded gets its own (refresh tokens are single-use).
+    pub fn seed_session(&self, org: &str) -> String {
+        let mut state = self.state.lock().unwrap();
+        state.seeded += 1;
+        let token = match state.seeded {
+            1 => "refresh-secret-seed".to_string(),
+            n => format!("refresh-secret-seed-{n}"),
+        };
+        state.refresh_tokens.insert(token.clone(), org.into());
+        token
+    }
+
+    pub fn set_ttl(&self, org: &str, secs: i64) {
+        self.state.lock().unwrap().ttl.insert(org.into(), secs);
+    }
+
+    /// A bearer as another of the user's devices (the phone) holds one.
+    pub fn user_token(&self, org: &str) -> String {
+        jwt(org, 3600)
+    }
+
+    pub fn dials(&self, device: &str) -> Vec<Dial> {
+        let state = self.state.lock().unwrap();
+        state
+            .dials
+            .iter()
+            .filter(|d| d.device == device)
+            .cloned()
+            .collect()
+    }
+
+    /// The host sockets `device` opened on its own room.
+    pub fn host_dials(&self, device: &str) -> Vec<Dial> {
+        self.dials(device)
+            .into_iter()
+            .filter(|d| d.role == "host")
+            .collect()
+    }
+
+    /// The client sockets dialed into `device`'s room.
+    pub fn client_dials(&self, device: &str) -> Vec<Dial> {
+        self.dials(device)
+            .into_iter()
+            .filter(|d| d.role == "client")
+            .collect()
+    }
+
+    /// Nudge `chat`'s host `device`, as a chat room does for a reader or a
+    /// sender (straight to the room, as the chat room's own wake does): the
+    /// status the room answers.
+    pub async fn post_nudge(&self, device: &str, chat: &str) -> u16 {
+        nudge(&mut self.state.lock().unwrap(), device, chat)
+    }
+
+    /// The chats nudged on `device`, in order.
+    pub fn nudges(&self, device: &str) -> Vec<String> {
+        let state = self.state.lock().unwrap();
+        state
+            .nudged
+            .iter()
+            .filter(|(d, _)| d == device)
+            .map(|(_, chat)| chat.clone())
+            .collect()
+    }
+
+    pub fn host_connected(&self, device: &str) -> bool {
+        let state = self.state.lock().unwrap();
+        state
+            .rooms
+            .get(device)
+            .is_some_and(|room| room.host.is_some())
+    }
+
+    /// Every socket of `device`'s room closed by the edge (a deploy, an
+    /// eviction): its host must dial again, with whatever bearer it has now.
+    pub fn drop_room(&self, device: &str) {
+        let state = self.state.lock().unwrap();
+        if let Some(room) = state.rooms.get(device) {
+            for tx in room.host.iter().chain(room.clients.values()) {
+                let _ = tx.send(Out::Close(None));
+            }
+        }
+    }
+
+    pub fn plugin_key_devices(&self) -> Vec<String> {
+        let state = self.state.lock().unwrap();
+        state
+            .plugin_keys
+            .iter()
+            .filter_map(|body| body["deviceId"].as_str().map(str::to_owned))
+            .collect()
+    }
+}
+
+/// `POST /device/{device}/nudge {chatId}` (edge/src/device-room.ts): 404 in
+/// a room no host ever joined, else queued and sent to its host if one is
+/// there (deleted as it's sent).
+fn nudge(state: &mut EdgeState, device: &str, chat: &str) -> u16 {
+    state.nudged.push((device.to_owned(), chat.to_owned()));
+    let room = state.rooms.entry(device.to_owned()).or_default();
+    if !room.claimed {
+        return 404;
+    }
+    if !room.nudges.iter().any(|c| c == chat) {
+        room.nudges.push(chat.to_owned());
+    }
+    room.replay();
+    200
+}
+
+async fn serve_one(mut stream: TcpStream, state: Arc<Mutex<EdgeState>>, registry: Option<String>) {
+    // The whole request head, left in the socket for whoever serves it.
+    let mut head = vec![0u8; 16 * 1024];
+    let mut n = 0;
+    for _ in 0..100 {
+        let Ok(read) = stream.peek(&mut head).await else {
+            return;
+        };
+        n = read;
+        if read == 0 || head[..read].windows(4).any(|w| w == b"\r\n\r\n") {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let text = String::from_utf8_lossy(&head[..n]).to_ascii_lowercase();
+    if text.contains("upgrade: websocket") {
+        serve_ws(stream, state, registry).await;
+    } else {
+        serve_http(&mut stream, state).await;
+    }
+}
+
+async fn read_http(stream: &mut TcpStream) -> Option<(String, String, Vec<u8>)> {
+    let mut buf = Vec::new();
+    let mut chunk = [0u8; 4096];
+    loop {
+        if let Some(end) = buf.windows(4).position(|w| w == b"\r\n\r\n") {
+            let head = String::from_utf8_lossy(&buf[..end]).into_owned();
+            let length = head
+                .lines()
+                .find_map(|line| {
+                    let (key, value) = line.split_once(':')?;
+                    key.eq_ignore_ascii_case("content-length")
+                        .then(|| value.trim().parse::<usize>().ok())
+                        .flatten()
+                })
+                .unwrap_or(0);
+            while buf.len() < end + 4 + length {
+                let n = stream.read(&mut chunk).await.ok()?;
+                if n == 0 {
+                    return None;
+                }
+                buf.extend_from_slice(&chunk[..n]);
+            }
+            let mut line = head.lines().next()?.split_whitespace();
+            let method = line.next()?.to_owned();
+            let target = line.next()?.to_owned();
+            return Some((method, target, buf[end + 4..end + 4 + length].to_vec()));
+        }
+        let n = stream.read(&mut chunk).await.ok()?;
+        if n == 0 {
+            return None;
+        }
+        buf.extend_from_slice(&chunk[..n]);
+    }
+}
+
+async fn serve_http(stream: &mut TcpStream, state: Arc<Mutex<EdgeState>>) {
+    let Some((method, target, body)) = read_http(stream).await else {
+        return;
+    };
+    let path = target.split('?').next().unwrap_or_default();
+    let body: Value = serde_json::from_slice(&body).unwrap_or_default();
+    let (status, reply) = match (method.as_str(), path) {
+        // WorkOS refresh through the edge: single-use tokens; a scoped
+        // refresh moves the session to that org, a plain one keeps its org.
+        ("POST", "/auth/refresh") => {
+            let mut state = state.lock().unwrap();
+            let presented = body["refreshToken"].as_str().unwrap_or_default();
+            match state.refresh_tokens.remove(presented) {
+                None => (401, json!({ "error": "invalid_grant" })),
+                Some(scope) => {
+                    let org = body["organizationId"].as_str().map_or(scope, str::to_owned);
+                    state.minted += 1;
+                    let rotated = format!("refresh-secret-{}", state.minted);
+                    state.refresh_tokens.insert(rotated.clone(), org.clone());
+                    let ttl = state.ttl(&org);
+                    (
+                        200,
+                        json!({ "accessToken": jwt(&org, ttl), "refreshToken": rotated }),
+                    )
+                }
+            }
+        }
+        ("POST", path) if path.starts_with("/device/") && path.ends_with("/nudge") => {
+            let device = path.trim_start_matches("/device/").trim_end_matches("/nudge");
+            let chat = body["chatId"].as_str().unwrap_or_default();
+            match nudge(&mut state.lock().unwrap(), device, chat) {
+                200 => (200, json!({ "delivered": true, "queued": true })),
+                status => (status, json!({ "error": "not_found" })),
+            }
+        }
+        ("POST", "/plugin-keys") => {
+            state.lock().unwrap().plugin_keys.push(body);
+            (403, json!({ "error": "step_up_required" }))
+        }
+        _ => (404, json!({ "error": "not_found" })),
+    };
+    let reply = reply.to_string();
+    let response = format!(
+        "HTTP/1.1 {status} Scripted\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{reply}",
+        reply.len()
+    );
+    let _ = stream.write_all(response.as_bytes()).await;
+    let _ = stream.shutdown().await;
+}
+
+fn refuse(status: u16) -> ErrorResponse {
+    http::Response::builder()
+        .status(status)
+        .body(Some("refused".into()))
+        .unwrap()
+}
+
+/// What a WebSocket upgrade asked for, as the handshake saw it.
+enum Upgrade {
+    /// A device room: its device id and the query.
+    Room(String, HashMap<String, String>),
+    Registry,
+}
+
+/// `/device/{id}/ws`: the DeviceRoom relay, admitting any unexpired bearer of
+/// the user (it checks nothing about the device or session that minted it).
+/// `/registry/{org}/ws`: the registry.
+async fn serve_ws(stream: TcpStream, state: Arc<Mutex<EdgeState>>, registry: Option<String>) {
+    let has_registry = registry.is_some();
+    let seen: Arc<Mutex<Option<Upgrade>>> = Arc::default();
+    let record = seen.clone();
+    let gate = state.clone();
+    let callback = move |request: &Request, response: Response| {
+        let uri = request.uri().to_string();
+        let (path, query) = uri.split_once('?').unwrap_or((uri.as_str(), ""));
+        let query: HashMap<String, String> = query
+            .split('&')
+            .filter_map(|kv| kv.split_once('='))
+            .map(|(k, v)| (k.to_owned(), v.to_owned()))
+            .collect();
+        let parts: Vec<&str> = path.trim_matches('/').split('/').collect();
+        let device = match parts.as_slice() {
+            ["device", device, "ws"] => device.to_string(),
+            ["registry", _, "ws"] if has_registry => {
+                *record.lock().unwrap() = Some(Upgrade::Registry);
+                return Ok(response);
+            }
+            _ => return Err(refuse(404)),
+        };
+        let bearer = query.get("token").and_then(|t| claims(t));
+        let org = bearer
+            .as_ref()
+            .and_then(|c| c["org_id"].as_str().map(str::to_owned));
+        let admitted = bearer.as_ref().is_some_and(|c| {
+            c["sub"] == USER && c["exp"].as_i64().is_some_and(|exp| exp > now_secs())
+        });
+        gate.lock().unwrap().dials.push(Dial {
+            device: device.clone(),
+            role: query.get("role").cloned().unwrap_or_default(),
+            org,
+            admitted,
+        });
+        if !admitted {
+            return Err(refuse(401));
+        }
+        *record.lock().unwrap() = Some(Upgrade::Room(device, query));
+        Ok(response)
+    };
+    let Ok(ws) = tokio_tungstenite::accept_hdr_async(stream, callback).await else {
+        return;
+    };
+    let upgrade = seen.lock().unwrap().take();
+    match upgrade {
+        Some(Upgrade::Room(device, query)) => relay(ws, device, query, state).await,
+        Some(Upgrade::Registry) => {
+            if let Some(registry) = registry {
+                proxy(ws, &registry).await;
+            }
+        }
+        None => {}
+    }
+}
+
+/// The registry socket, passed through to the mock registry.
+async fn proxy(client: tokio_tungstenite::WebSocketStream<TcpStream>, upstream: &str) {
+    let Ok((server, _)) = tokio_tungstenite::connect_async(upstream).await else {
+        return;
+    };
+    let (mut client_tx, mut client_rx) = client.split();
+    let (mut server_tx, mut server_rx) = server.split();
+    let up = async {
+        while let Some(Ok(message)) = client_rx.next().await {
+            if server_tx.send(message).await.is_err() {
+                return;
+            }
+        }
+        let _ = server_tx.close().await;
+    };
+    let down = async {
+        while let Some(Ok(message)) = server_rx.next().await {
+            if client_tx.send(message).await.is_err() {
+                return;
+            }
+        }
+        let _ = client_tx.close().await;
+    };
+    tokio::select! {
+        _ = up => {}
+        _ = down => {}
+    }
+}
+
+fn relay_error(code: &str) -> Vec<u8> {
+    json!({ "error": code }).to_string().into_bytes()
+}
+
+/// DeviceRoom semantics (edge/src/device-room.ts), as the client crate's
+/// mock edge has them.
+async fn relay(
+    ws: tokio_tungstenite::WebSocketStream<TcpStream>,
+    device: String,
+    query: HashMap<String, String>,
+    state: Arc<Mutex<EdgeState>>,
+) {
+    let is_host = query.get("role").map(String::as_str) == Some("host");
+    let conn_id = query
+        .get("connId")
+        .cloned()
+        .unwrap_or_else(|| "anon".into());
+    let (mut sink, mut stream) = ws.split();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<Out>();
+    {
+        let mut state = state.lock().unwrap();
+        let room = state.rooms.entry(device.clone()).or_default();
+        if is_host {
+            if let Some(old) = room.host.replace(tx.clone()) {
+                let _ = old.send(Out::Close(Some(SUPERSEDED)));
+            }
+            room.claimed = true;
+            room.replay();
+        } else {
+            room.clients.insert(conn_id.clone(), tx.clone());
+        }
+    }
+    let writer = tokio::spawn(async move {
+        while let Some(out) = rx.recv().await {
+            match out {
+                Out::Frame(bytes) => {
+                    if sink.send(Message::Binary(bytes)).await.is_err() {
+                        break;
+                    }
+                }
+                Out::Close(code) => {
+                    let frame = code.map(|code| CloseFrame {
+                        code: CloseCode::from(code),
+                        reason: "superseded by new host connection".into(),
+                    });
+                    let _ = sink.send(Message::Close(frame)).await;
+                    break;
+                }
+            }
+        }
+    });
+    let encode = |header: &DeviceFrameHeader, payload: &[u8]| {
+        Out::Frame(encode_device_frame(header, payload).unwrap())
+    };
+    loop {
+        let bytes = tokio::select! {
+            message = stream.next() => match message {
+                Some(Ok(Message::Binary(bytes))) => bytes,
+                Some(Ok(Message::Close(_))) | Some(Err(_)) | None => break,
+                Some(Ok(_)) => continue,
+            },
+            // Closed by the edge (`drop_room`, or a newer host).
+            () = tx.closed() => break,
+        };
+        let Ok((header, payload)) = decode_device_frame(&bytes) else {
+            break;
+        };
+        let mut state = state.lock().unwrap();
+        let room = state.rooms.entry(device.clone()).or_default();
+        if !is_host {
+            match &room.host {
+                Some(host) => {
+                    let mut routed = DeviceFrameHeader::new(header.s, header.k);
+                    routed.from = Some(conn_id.clone());
+                    let _ = host.send(encode(&routed, &payload));
+                }
+                None => {
+                    let bounce = DeviceFrameHeader::new(header.s, RELAY_KIND);
+                    let _ = tx.send(encode(&bounce, &relay_error(HOST_OFFLINE)));
+                }
+            }
+            continue;
+        }
+        let Some(to) = header.to else { continue };
+        match room.clients.get(&to) {
+            Some(client) => {
+                let _ = client.send(encode(
+                    &DeviceFrameHeader::new(header.s, header.k),
+                    &payload,
+                ));
+            }
+            None => {
+                let bounce = DeviceFrameHeader::new(header.s, RELAY_KIND).with_to(to);
+                let _ = tx.send(encode(&bounce, &relay_error(CLIENT_GONE)));
+            }
+        }
+    }
+    {
+        let mut state = state.lock().unwrap();
+        let room = state.rooms.entry(device.clone()).or_default();
+        if is_host {
+            if room.host.as_ref().is_some_and(|h| h.same_channel(&tx)) {
+                room.host = None;
+                for client in room.clients.values() {
+                    let _ = client.send(encode(
+                        &DeviceFrameHeader::new("", RELAY_KIND),
+                        &relay_error(HOST_CLOSED),
+                    ));
+                }
+            }
+        } else {
+            room.clients.remove(&conn_id);
+            if let Some(host) = &room.host {
+                let mut header = DeviceFrameHeader::new("", RELAY_KIND);
+                header.from = Some(conn_id.clone());
+                let _ = host.send(encode(&header, &relay_error(CLIENT_CLOSED)));
+            }
+        }
+    }
+    writer.abort();
+}
