+
+    #[cfg(unix)]
+    #[test]
+    fn the_chats_on_places_are_kept_owner_only() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = tempfile::tempdir().unwrap();
+        Sandboxes::open(dir.path()).persist();
