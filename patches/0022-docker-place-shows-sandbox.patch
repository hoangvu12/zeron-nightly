diff --git a/crates/engine/src/workspace_host.rs b/crates/engine/src/workspace_host.rs
index 1b77962d781f3a83b6dbdb4d2cf473bc610a3fa7..84e5c13c9c4a6d8571c0ea8a4af7798c7c8a40be 100644
--- a/crates/engine/src/workspace_host.rs
+++ b/crates/engine/src/workspace_host.rs
@@ -721,6 +721,34 @@ impl WorkspaceHost {
         }
     }
 
+    /// A chat was just placed on a sandbox of `provider` whose engine hasn't
+    /// signed in yet: its device gets a row of its own now, saying it's that
+    /// provider's sandbox (`sandbox:<provider>`), so every device shows where
+    /// the chat runs ("Docker Sandbox") and follows its steps from the start,
+    /// not an unknown device. Never seen online; the sandbox's engine writes
+    /// its own row over it when it starts. A device with a row keeps it.
+    pub fn note_sandbox_device(&self, device_id: &str, name: &str, provider: &str) {
+        let outcome = self.mutate(|doc| {
+            if doc.read_devices()?.iter().any(|d| d.id == device_id) {
+                return Ok(());
+            }
+            doc.upsert_device(&Device {
+                id: device_id.to_owned(),
+                name: name.to_owned(),
+                platform: "linux".to_owned(),
+                last_seen_at: None,
+                created_at: Some(Utc::now()),
+                version: None,
+                cursor_sdk_version: None,
+                capabilities: vec![zeron_proto::sandbox_capability(provider)],
+                online_since: None,
+            })
+        });
+        if let Err(err) = outcome {
+            tracing::warn!(device = %device_id, error = %err, "couldn't list a sandbox's device before it signs in");
+        }
+    }
+
     /// Dial-gate verdict for `LinkCache` (park dials to registry-dark peers).
     /// `Dark` requires positive evidence; every ambiguous state — registry
     /// room down or still in its warm-up window, unknown device, heartbeat in
