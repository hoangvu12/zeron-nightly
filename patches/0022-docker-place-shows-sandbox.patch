index a08586ed23fd7331989babd550be866e90c29ef5..3e34002e8aa1c8d2799ef6e1d90308f0d7352964 100644
--- a/crates/engine/tests/sandbox_place.rs
+++ b/crates/engine/tests/sandbox_place.rs
@@ -491,3 +491,61 @@ async fn a_sign_in_in_the_projects_origin_never_reaches_the_sandbox_or_its_error
     let kept = std::fs::read_to_string(host_dir.join("sandboxes.json")).unwrap();
     assert!(!kept.contains(TOKEN));
 }
+
+/// While its sandbox is still being made (Docker can take minutes, or fail),
+/// a chat on a place shows where it runs: its device is listed at once as
+/// that provider's sandbox, never seen online, not an unknown device with
+/// no steps (the Laptop, 2026-11-17). Once the sandbox's engine starts, its
+/// own row stands.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_chat_on_a_place_shows_its_sandbox_before_the_sandbox_signs_in() {
+    let edge = ScriptedEdge::with_registry().await;
+    let dirs = tempfile::tempdir().unwrap();
+    let origin_url = dirs.path().join("origin.git");
+    origin(&origin_url);
+    let host = host_device(&dirs.path().join("host"), &edge).await;
+    let provider = FakeProvider::cloud(&dirs.path().join("cloud"));
+    host.core().sandboxes.register(provider.clone());
+    let rpc = memory_client(host.core().rpc_service());
+    let path = project(dirs.path(), &origin_url);
+    add_project(&rpc, &host, &path).await;
+
+    provider.hold_create();
+    let created = create_on_place(&rpc, "chat-early", "fake").await;
+    let device = created["deviceId"].as_str().unwrap().to_owned();
+    let rows = host.core().workspace.read_devices().unwrap();
+    let row = rows
+        .iter()
+        .find(|d| d.id == device)
+        .unwrap_or_else(|| panic!("{device} isn't listed while its sandbox is made: {rows:#?}"));
+    assert_eq!(row.sandbox_provider(), Some("fake"), "{row:#?}");
+    assert_eq!(row.name, "Fake Sandbox");
+    assert!(row.last_seen_at.is_none(), "never seen online: {row:#?}");
+    // (Never a host device: it doesn't say it can be one.)
+    assert!(!row.supports(zeron_proto::capabilities::SANDBOX_HOST_V1), "{row:#?}");
+    // The steps say how far it got, from the start.
+    let making = steps(&rpc, "chat-early").await;
+    assert_eq!(making["step"], "create", "{making:#}");
+
+    provider.release_create();
+    ready(&rpc, "chat-early").await;
+    let own = sandbox_row(&host, &device).await;
+    let deadline = Instant::now() + Duration::from_secs(30);
+    let own = loop {
+        let row = host
+            .core()
+            .workspace
+            .read_devices()
+            .unwrap()
+            .into_iter()
+            .find(|d| d.id == device)
+            .unwrap_or(own.clone());
+        if row.last_seen_at.is_some() {
+            break row;
+        }
+        assert!(Instant::now() < deadline, "the sandbox never wrote its own row: {row:#?}");
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    };
+    assert_eq!(own.sandbox_provider(), Some("fake"), "{own:#?}");
+    assert!(own.version.is_some(), "its engine's own row: {own:#?}");
+}
