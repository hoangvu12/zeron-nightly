@@ -688,12 +688,19 @@ function M.bind(c: Choices)
 			return
 		end
 		provider_was = provider
-		if c.template and c.template:peek() ~= sandboxes.BLANK then
-			c.template:set(sandboxes.BLANK)
-		end
 		if not provider then
+			if c.template and c.template:peek() ~= sandboxes.BLANK then
