 end)
 
+test("Blank picked while the templates load stays Blank when they arrive", function()
+	local app = mount("chat_fixture.luau")
+	home(app)
+	app:command("sandbox_stub.offer")
+	app:command("sandbox_stub.slow_templates")
+	settle(app)
+	open_row(app, "Device")
+	app:click('role:option ~"Docker Sandbox"')
+	rested(app)
+	-- Still loading: Blank is all there is, and it's what's picked.
+	expect(showing(app, 'role:option ~"zeron-dev"')).to_be(false)
+	app:click('role:option ~"Blank"')
+	close(app)
+	app:command("sandbox_stub.templates_arrive")
+	rested(app)
+	expect(chosen(app, "Template")).never.to_contain("zeron-dev")
+	app:type('role:textbox "Message"', "hi")
+	app:key("Enter")
+	rested(app)
+	local calls = app:state("calls")
+	expect(calls).to_contain("|place:docker:blank")
+	expect(calls).never.to_contain("|place:docker:zeron-dev")
+end)
+
+test("left alone while the templates load, a place starts on the first listed", function()
+	local app = mount("chat_fixture.luau")
+	home(app)
+	app:command("sandbox_stub.offer")
+	app:command("sandbox_stub.slow_templates")
+	settle(app)
+	open_row(app, "Device")
+	app:click('role:option ~"Docker Sandbox"')
+	rested(app)
+	close(app)
+	app:command("sandbox_stub.templates_arrive")
+	rested(app)
+	expect(chosen(app, "Template")).to_contain("zeron-dev")
+end)
