--- a/apps/zgx/ui/chat_fixture.luau
+++ b/apps/zgx/ui/chat_fixture.luau
@@ -1539,10 +1539,30 @@ end
 -- got (starting, failed, ready); follows and Run again are noted.
 do
 	local sandboxes = require("@account/sandboxes") :: any
+	local listed = { { id = "zeron-dev", name = "zeron-dev" }, { id = "zgx-dev", name = "zgx-dev" } }
+	-- `sandbox_stub.slow_templates`: the next list waits for
+	-- `sandbox_stub.templates_arrive` (Docker answering in its own time).
+	local slow_templates, held_templates = false, nil :: ((any) -> ())?
 	sandboxes.ask_templates = function(provider: string): any
 		note(`templates:{provider}`)
-		return settled({ { id = "zeron-dev", name = "zeron-dev" }, { id = "zgx-dev", name = "zgx-dev" } })
+		if slow_templates then
+			slow_templates = false
+			return { after = function(_self: any, ok: (any) -> (), _bad: (any) -> ())
+				held_templates = ok
+			end }
+		end
+		return settled(listed)
 	end
+	ui.command { id = "sandbox_stub.slow_templates", title = "The next templates list is slow", run = function()
+		slow_templates = true
+	end }
+	ui.command { id = "sandbox_stub.templates_arrive", title = "The slow templates list arrives", run = function()
+		local ok = held_templates
+		held_templates = nil
+		if ok then
+			ok(listed)
+		end
+	end }
 	-- (sandbox_stub's notes it too, for its own tests.)
 	local stub_follow = sandboxes.ask_follow
 	sandboxes.ask_follow = function(chat: string)
