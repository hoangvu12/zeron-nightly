From 14b4be4b88480c7f5f29c374829e24f3ded8fc8f Mon Sep 17 00:00:00 2001
From: hoangvu12 <hggaming91@gmail.com>
Date: Fri, 6 Nov 2026 05:38:38 +0700
Subject: [PATCH] zgx on Windows: no console window, and the ui folder beside
 the exe

A beta build on Windows opened a console window next to the app, and
looked for its scripts in a macOS bundle's Contents/Resources/ui. An
install on Windows keeps ui and plugins-builtin beside zeron.exe.

- The beta build uses the windows subsystem, as apps/zeron does.
- bundled_ui reads the ui folder beside the exe on Windows.
---
 apps/zgx/src/main.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/apps/zgx/src/main.rs b/apps/zgx/src/main.rs
index 02726f3e67460f06fa8549cc547dda5313652791..75be8efd9c705ab6985d49694223df847a318d3d 100644
--- a/apps/zgx/src/main.rs
+++ b/apps/zgx/src/main.rs
@@ -1303,7 +1303,8 @@ fn ui_dir() -> PathBuf {
 /// The packaged scripts of the install this executable runs from, if any:
 /// `Contents/Resources/ui` of a macOS bundle, `ui` beside it on Linux (the
 /// tarball's, scripts/package-linux.sh), `beta\<version>\ui` beside it on
-/// Windows (scripts/package-windows.ps1).
+/// Windows (scripts/package-windows.ps1), else there the `ui` beside it (an
+/// install that has its folder to itself).
 fn bundled_ui() -> Option<PathBuf> {
     static BUNDLED: std::sync::OnceLock<Option<PathBuf>> = std::sync::OnceLock::new();
     BUNDLED
@@ -1313,7 +1314,8 @@ fn bundled_ui() -> Option<PathBuf> {
             let ui = if cfg!(target_os = "macos") {
                 dir.parent()?.join("Resources").join("ui")
             } else if cfg!(windows) {
-                windows_version_files(dir)?.join("ui")
+                let beta = windows_version_files(dir)?.join("ui");
+                if beta.join("app.luau").is_file() { beta } else { dir.join("ui") }
             } else {
                 dir.join("ui")
             };
-- 
