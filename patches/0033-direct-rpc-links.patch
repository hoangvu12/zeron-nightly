@@ -0,0 +1,593 @@
+//! Engine-to-engine RPC over a direct peer connection: the WebRTC link
+//! terminals already take between the person's own computers
+//! (`zeron_preview`, `terminals::link`), when the two can reach each other.
+//!
+//! The device-room relay carries every call between devices through the
+//! edge, even for two computers on one network. A message's files to a chat
+//! on another computer went that way too, and a relay link that drops every
+//! minute or two could not carry them. This is a second road for those calls:
+//! the same RPC, as newline-delimited JSON frames over one `rpc` stream.
+//!
+//! - **Host** ([`Service`]): served alongside the relay host
+//!   ([`crate::EngineCore::start_host_relay`]), with the service the relay
+//!   serves, behind the same guard ([`zeron_rpc::device_room::peer_service`]):
+//!   local-only calls refused, the rest answered as a peer's. The device a
+//!   direct link names is the signaling's claim, not proven, so calls are
+//!   served as an unverified peer, as an unstamped relay dial's are. Cloud
+//!   machines may not open one, as for terminals.
+//! - **Client** ([`Links`]): a call that would cross the relay takes an open
+//!   direct link instead, when the host says it serves one
+//!   ([`zeron_proto::capabilities::DIRECT_RPC_V1`]) and the two are paired.
+//!   Not paired yet: the relay carries this call and pairing starts, so a
+//!   retry finds the direct link up. Nothing waits on one.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex, PoisonError};
+use std::time::Duration;
+
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader};
+use tokio::sync::mpsc;
+use tokio::time::Instant;
+use zeron_rpc::{RpcClient, RpcService};
+
+/// The stream id direct RPC is served under.
+pub const SERVICE: &str = "rpc";
+
+/// The longest frame either end reads: a chunk of a file is 60,000 base64
+/// characters, a long chat's transcript a few MB. Past it the link closes.
+const MAX_FRAME: usize = 64 * 1024 * 1024;
+
+/// How long a call waits for the `rpc` stream to open on a paired
+/// connection. Past it the call takes the relay; the opening goes on, and
+/// the link it makes is there for the next call.
+const OPEN_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// After the stream failed to open (a blip, mostly: the connection closing
+/// as it opened, the host restarting), the relay alone for this long,
+/// doubling with each failure in a row up to [`OPEN_BACKOFF_CAP`].
+const OPEN_BACKOFF: Duration = Duration::from_secs(5);
+const OPEN_BACKOFF_CAP: Duration = Duration::from_secs(60);
+
+/// Pairing is asked for at most this often per device, doubling while it
+/// never comes up (two networks that can't reach each other) up to
+/// [`WARM_GAP_CAP`]. A pairing gives up after 30 s by itself, so one is in
+/// flight at a time.
+const WARM_GAP: Duration = Duration::from_secs(30);
+const WARM_GAP_CAP: Duration = Duration::from_secs(5 * 60);
+
+/// An open link is asked something this often, so one whose far end stopped
+/// answering is dropped before a call is handed to it.
+const PING_EVERY: Duration = Duration::from_secs(15);
+const PING_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// A link no call used for this long is closed, as the relay closes its idle
+/// links: the next call opens it again.
+const IDLE_CLOSE: Duration = Duration::from_secs(5 * 60);
+
+/// The wait after `previous` (none: the first), doubling up to `cap`.
+fn next_gap(previous: Option<Duration>, first: Duration, cap: Duration) -> Duration {
+    previous.map_or(first, |gap| (gap * 2).min(cap))
+}
+
+/// The host end: each `rpc` stream a peer opens is one RPC connection to
+/// `service`, guarded as relay clients are.
+///
+/// It holds the service weakly: the engine's preview service keeps this,
+/// and the doc host keeps the preview service ([`Links`]), so a strong
+/// reference would keep the whole engine alive after it shut down. The relay
+/// host holds the service while it runs; once it's gone, so is direct RPC.
+pub struct Service {
+    service: std::sync::Weak<dyn RpcService>,
+}
+
+impl Service {
+    pub fn new(service: &Arc<dyn RpcService>) -> Self {
+        Self {
+            service: Arc::downgrade(service),
+        }
+    }
+}
+
+/// Whether `peer` may open direct RPC here: another of the person's own
+/// computers. A Cloud machine runs agent code; a link it opens back over a
+/// connection this device made to it must not reach this device's RPC.
+fn peer_allowed(peer: Option<&str>) -> bool {
+    peer.is_some_and(|peer| !zeron_proto::is_cloud_device(peer, ""))
+}
+
+#[async_trait::async_trait]
+impl zeron_preview::mux::Connector for Service {
+    /// This device asking itself: it has its own IPC for that.
+    async fn connect(&self, _service: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        anyhow::bail!("direct RPC is for the owner's other devices")
+    }
+
+    async fn connect_from(
+        &self,
+        peer: Option<&str>,
+        service: &str,
+    ) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        anyhow::ensure!(service == SERVICE, "unknown direct RPC stream {service}");
+        anyhow::ensure!(
+            peer_allowed(peer),
+            "direct RPC here is only for the owner's devices"
+        );
+        let service = self
+            .service
+            .upgrade()
+            .ok_or_else(|| anyhow::anyhow!("this device isn't serving other devices now"))?;
+        let (ours, theirs) = tokio::io::duplex(1024 * 1024);
+        let guarded = zeron_rpc::device_room::peer_service(service, None);
+        tokio::spawn(serve(guarded, ours));
+        Ok(Box::new(theirs))
+    }
+}
+
+/// Serve `service` on one byte stream of newline-delimited frames, until
+/// either side closes it.
+pub async fn serve<S>(service: Arc<dyn RpcService>, io: S)
+where
+    S: AsyncRead + AsyncWrite + Send + 'static,
+{
+    let (out, inbound) = bridge(io);
+    zeron_rpc::serve_connection(service, out, inbound).await;
+}
+
+/// An RPC client over one byte stream of newline-delimited frames.
+pub fn client<S>(io: S) -> RpcClient
+where
+    S: AsyncRead + AsyncWrite + Send + 'static,
+{
+    let (out, inbound) = bridge(io);
+    RpcClient::new(out, inbound)
+}
+
+/// Frames to and from a byte stream: what's sent on the returned sender is
+/// written as one line; each line read arrives on the receiver. Both end when
+/// the stream does. JSON frames never hold a raw newline.
+fn bridge<S>(io: S) -> (mpsc::Sender<String>, mpsc::Receiver<String>)
+where
+    S: AsyncRead + AsyncWrite + Send + 'static,
+{
+    let (read, mut write) = tokio::io::split(io);
+    let (out_tx, mut out_rx) = mpsc::channel::<String>(64);
+    let (in_tx, in_rx) = mpsc::channel::<String>(64);
+    tokio::spawn(async move {
+        while let Some(frame) = out_rx.recv().await {
+            let sent = async {
+                write.write_all(frame.as_bytes()).await?;
+                write.write_all(b"\n").await?;
+                write.flush().await
+            };
+            if sent.await.is_err() {
+                break;
+            }
+        }
+        let _ = write.shutdown().await;
+    });
+    tokio::spawn(async move {
+        let mut read = BufReader::new(read);
+        let mut line = String::new();
+        loop {
+            line.clear();
+            match (&mut read)
+                .take(MAX_FRAME as u64 + 1)
+                .read_line(&mut line)
+                .await
+            {
+                Ok(0) | Err(_) => break,
+                Ok(_) if line.len() > MAX_FRAME => {
+                    tracing::warn!("direct RPC: a frame over {MAX_FRAME} bytes; closing");
+                    break;
+                }
+                Ok(_) => {}
+            }
+            let frame = line.trim_end_matches(['\n', '\r']);
+            if frame.is_empty() {
+                continue;
+            }
+            if in_tx.send(frame.to_owned()).await.is_err() {
+                break;
+            }
+        }
+    });
+    (out_tx, in_rx)
+}
+
+/// The client end: one direct RPC client per device, opened over the paired
+/// connection when there is one.
+///
+/// Nothing a call does waits long on the direct road: a link that isn't up
+/// yet, is opening, or failed a moment ago sends the call by the relay. Open
+/// links are pinged, so one whose far end went quiet is dropped before a call
+/// is handed to it, and closed once no call has used them for a while.
+#[derive(Clone)]
+pub struct Links {
+    previews: zeron_preview::PreviewService,
+    state: Arc<Mutex<State>>,
+}
+
+#[derive(Default)]
+struct State {
+    links: HashMap<String, Link>,
+    /// Devices whose stream is opening now: one opening at a time.
+    opening: HashSet<String>,
+    /// After a stream failed to open.
+    backoff: HashMap<String, Wait>,
+    /// Pairing asked for, and not up yet.
+    warm: HashMap<String, Wait>,
+    /// The road the last call to each device took.
+    roads: HashMap<String, bool>,
+}
+
+struct Link {
+    client: Arc<RpcClient>,
+    used: Instant,
+}
+
+#[derive(Clone, Copy)]
+struct Wait {
+    until: Instant,
+    gap: Duration,
+}
+
+fn lock(state: &Mutex<State>) -> std::sync::MutexGuard<'_, State> {
+    state.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+impl Links {
+    pub fn new(previews: zeron_preview::PreviewService) -> Self {
+        Self {
+            previews,
+            state: Arc::default(),
+        }
+    }
+
+    fn state(&self) -> std::sync::MutexGuard<'_, State> {
+        lock(&self.state)
+    }
+
+    /// A direct client for `device`, if one is up or the paired connection
+    /// opens one now. `None`: take the relay (and pairing starts for next
+    /// time). The caller has checked the device serves direct RPC.
+    pub async fn client(&self, device: &str) -> Option<Arc<RpcClient>> {
+        if zeron_proto::is_cloud_device(device, "") {
+            return None;
+        }
+        {
+            let mut state = self.state();
+            if let Some(link) = state.links.get_mut(device) {
+                // (A clean close sets no reason: ask whether it closed.)
+                if !link.client.is_closed() {
+                    link.used = Instant::now();
+                    return Some(link.client.clone());
+                }
+                state.links.remove(device);
+            }
+            if state.opening.contains(device)
+                || state
+                    .backoff
+                    .get(device)
+                    .is_some_and(|wait| Instant::now() < wait.until)
+            {
+                return None;
+            }
+        }
+        if !self.previews.peer_ready(device).await {
+            self.warm(device);
+            return None;
+        }
+        {
+            let mut state = self.state();
+            state.warm.remove(device);
+            if !state.opening.insert(device.to_owned()) {
+                return None;
+            }
+        }
+        // Opened on a task of its own: a call that stops waiting doesn't cut
+        // the opening off half-way (which can leave the pairing under it
+        // stuck), and what it opens is kept for the next call.
+        let this = self.clone();
+        let target = device.to_owned();
+        let opening = tokio::spawn(async move { this.open(&target).await });
+        match tokio::time::timeout(OPEN_TIMEOUT, opening).await {
+            Ok(Ok(client)) => client,
+            Ok(Err(_)) => {
+                self.state().opening.remove(device);
+                None
+            }
+            Err(_) => {
+                tracing::info!(
+                    device,
+                    "direct RPC stream still opening; the relay carries this call"
+                );
+                None
+            }
+        }
+    }
+
+    async fn open(&self, device: &str) -> Option<Arc<RpcClient>> {
+        let opened = self.previews.open_peer_stream(device, SERVICE).await;
+        let mut state = self.state();
+        state.opening.remove(device);
+        match opened {
+            Ok(stream) => {
+                state.backoff.remove(device);
+                let client = Arc::new(client(stream));
+                state.links.insert(
+                    device.to_owned(),
+                    Link {
+                        client: client.clone(),
+                        used: Instant::now(),
+                    },
+                );
+                drop(state);
+                tracing::info!(device, "direct RPC link up");
+                self.keep(device, &client);
+                Some(client)
+            }
+            Err(error) => {
+                let gap = next_gap(
+                    state.backoff.get(device).map(|wait| wait.gap),
+                    OPEN_BACKOFF,
+                    OPEN_BACKOFF_CAP,
+                );
+                state.backoff.insert(
+                    device.to_owned(),
+                    Wait {
+                        until: Instant::now() + gap,
+                        gap,
+                    },
+                );
+                tracing::info!(device, %error, retry_in_secs = gap.as_secs(),
+                    "direct RPC stream didn't open; the relay carries calls");
+                None
+            }
+        }
+    }
+
+    /// Ask for pairing with `device`, unless it was asked for lately.
+    fn warm(&self, device: &str) {
+        {
+            let mut state = self.state();
+            let wait = state.warm.get(device).copied();
+            if wait.is_some_and(|wait| Instant::now() < wait.until) {
+                return;
+            }
+            let gap = next_gap(wait.map(|wait| wait.gap), WARM_GAP, WARM_GAP_CAP);
+            state.warm.insert(
+                device.to_owned(),
+                Wait {
+                    until: Instant::now() + gap,
+                    gap,
+                },
+            );
+        }
+        self.previews.warm_peer(device);
+    }
+
+    /// Watch an open link: dropped once it closes, stops answering, or no
+    /// call has used it for [`IDLE_CLOSE`]. Holds it weakly, so dropping it
+    /// from the map closes it.
+    fn keep(&self, device: &str, client: &Arc<RpcClient>) {
+        let link = Arc::downgrade(client);
+        let state = Arc::downgrade(&self.state);
+        let device = device.to_owned();
+        tokio::spawn(async move {
+            loop {
+                tokio::time::sleep(PING_EVERY).await;
+                let (Some(client), Some(state)) = (link.upgrade(), state.upgrade()) else {
+                    return;
+                };
+                let idle = match lock(&state).links.get(&device) {
+                    Some(held) if Arc::ptr_eq(&held.client, &client) => {
+                        held.used.elapsed() >= IDLE_CLOSE
+                    }
+                    _ => return, // dropped or replaced
+                };
+                let why = if client.is_closed() {
+                    Some("closed")
+                } else if idle {
+                    Some("idle")
+                } else {
+                    let ping = client.call(zeron_rpc::methods::ENGINE_INFO, serde_json::json!({}));
+                    match tokio::time::timeout(PING_TIMEOUT, ping).await {
+                        Err(_)
+                        | Ok(Err(
+                            zeron_rpc::RpcError::Transport(_) | zeron_rpc::RpcError::Closed,
+                        )) => Some("unanswered"),
+                        // Any answer, even a refusal, says the far end is there.
+                        Ok(_) => None,
+                    }
+                };
+                if let Some(why) = why {
+                    let mut state = lock(&state);
+                    if state
+                        .links
+                        .get(&device)
+                        .is_some_and(|held| Arc::ptr_eq(&held.client, &client))
+                    {
+                        state.links.remove(&device);
+                    }
+                    tracing::info!(
+                        device,
+                        why,
+                        "direct RPC link closed; the relay carries calls"
+                    );
+                    return;
+                }
+            }
+        });
+    }
+
+    /// The direct link to `device` failed a call: the next one opens afresh
+    /// (or takes the relay).
+    pub fn invalidate(&self, device: &str) {
+        self.state().links.remove(device);
+    }
+
+    /// Note the road a call to `device` took: logged when it changes, so the
+    /// log says when calls went direct and when they fell back to the relay.
+    pub fn note_road(&self, device: &str, direct: bool) {
+        let changed = self.state().roads.insert(device.to_owned(), direct) != Some(direct);
+        let road = if direct { "direct" } else { "relay" };
+        if changed {
+            tracing::info!(device, road, "calls to this device take a new road");
+        } else {
+            tracing::debug!(device, road, "peer call");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{Value, json};
+    use zeron_rpc::{RpcError, RpcReply};
+
+    struct Echo;
+
+    #[async_trait::async_trait]
+    impl RpcService for Echo {
+        async fn handle(&self, method: &str, params: Value) -> Result<RpcReply, RpcError> {
+            let caller = match zeron_rpc::caller() {
+                zeron_rpc::Caller::Peer { device } => json!({ "peer": device }),
+                _ => json!("not a peer"),
+            };
+            RpcReply::value(&json!({ "method": method, "params": params, "caller": caller }))
+        }
+    }
+
+    #[tokio::test]
+    async fn calls_cross_a_byte_stream_and_are_served_as_a_peers() {
+        let (near, far) = tokio::io::duplex(64 * 1024);
+        tokio::spawn(serve(
+            zeron_rpc::device_room::peer_service(Arc::new(Echo), None),
+            far,
+        ));
+        let client = client(near);
+        // A frame far larger than the duplex buffer, as a file's chunk is.
+        let data = "A".repeat(200_000);
+        let reply = client
+            .call(
+                zeron_rpc::methods::UPLOAD_CHUNK,
+                json!({ "uploadId": "u", "seq": 0, "data": data }),
+            )
+            .await
+            .expect("call crosses");
+        assert_eq!(reply["method"], "UploadChunk");
+        assert_eq!(
+            reply["params"]["data"].as_str().map(str::len),
+            Some(200_000)
+        );
+        assert_eq!(reply["caller"], json!({ "peer": null }));
+        // Several at once, answered each to its own call.
+        let calls = (0..8).map(|i| client.call("Ping", json!({ "i": i })));
+        for (i, reply) in futures::future::join_all(calls)
+            .await
+            .into_iter()
+            .enumerate()
+        {
+            assert_eq!(reply.expect("ping")["params"]["i"], i);
+        }
+    }
+
+    /// A blip costs the direct road seconds, not the ten minutes it used to;
+    /// failures in a row wait longer, never past the cap.
+    #[test]
+    fn waits_double_from_the_first_to_the_cap() {
+        let first = OPEN_BACKOFF;
+        let mut gap = next_gap(None, first, OPEN_BACKOFF_CAP);
+        assert_eq!(gap, Duration::from_secs(5));
+        let mut seen = vec![gap];
+        for _ in 0..6 {
+            gap = next_gap(Some(gap), first, OPEN_BACKOFF_CAP);
+            seen.push(gap);
+        }
+        assert_eq!(
+            seen.iter().map(Duration::as_secs).collect::<Vec<_>>(),
+            [5, 10, 20, 40, 60, 60, 60]
+        );
+        assert_eq!(
+            next_gap(None, WARM_GAP, WARM_GAP_CAP),
+            Duration::from_secs(30)
+        );
+        assert_eq!(
+            next_gap(Some(Duration::from_secs(240)), WARM_GAP, WARM_GAP_CAP),
+            WARM_GAP_CAP
+        );
+    }
+
+    /// A link that dropped says so, so a cached client isn't handed a call
+    /// nobody will answer.
+    #[tokio::test]
+    async fn a_client_whose_link_dropped_reads_closed() {
+        let (near, far) = tokio::io::duplex(64 * 1024);
+        let host = tokio::spawn(serve(
+            zeron_rpc::device_room::peer_service(Arc::new(Echo), None),
+            far,
+        ));
+        let client = client(near);
+        client.call("Ping", json!({})).await.expect("ping");
+        assert!(!client.is_closed());
+        host.abort();
+        tokio::time::timeout(std::time::Duration::from_secs(5), client.closed())
+            .await
+            .expect("the drop is noticed");
+        assert!(client.is_closed());
+        assert!(
+            client.close_reason().is_none(),
+            "a clean close has no reason"
+        );
+    }
+
+    #[tokio::test]
+    async fn the_relays_refusals_hold_on_a_direct_link_too() {
+        let (near, far) = tokio::io::duplex(64 * 1024);
+        tokio::spawn(serve(
+            zeron_rpc::device_room::peer_service(Arc::new(Echo), None),
+            far,
+        ));
+        let client = client(near);
+        let local_only = zeron_rpc::methods::ACCESS_TOKEN;
+        assert!(zeron_rpc::local_only(local_only));
+        let refused = client.call(local_only, json!({})).await;
+        assert!(
+            matches!(refused, Err(RpcError::Failed(ref m)) if m.contains("local IPC")),
+            "{refused:?}"
+        );
+    }
+
+    /// The host end keeps the engine's service only while the relay host
+    /// does: it must never be what keeps an engine alive after shutdown.
+    #[tokio::test]
+    async fn the_host_end_holds_its_service_weakly() {
+        use zeron_preview::mux::Connector as _;
+        let service: Arc<dyn RpcService> = Arc::new(Echo);
+        let host = Service::new(&service);
+        assert!(host.connect_from(Some("cloud-1"), SERVICE).await.is_err());
+        assert!(host.connect_from(Some("laptop"), "rpcx").await.is_err());
+        assert!(host.connect_from(None, SERVICE).await.is_err());
+        // Nothing but the relay host's reference keeps it.
+        assert_eq!(Arc::strong_count(&service), 1);
+        drop(service);
+        assert!(host.connect_from(Some("laptop"), SERVICE).await.is_err());
+
+        // While it's held, a peer's stream is a working connection.
+        let service: Arc<dyn RpcService> = Arc::new(Echo);
+        let host = Service::new(&service);
+        let io = host
+            .connect_from(Some("laptop"), SERVICE)
+            .await
+            .expect("a peer's stream");
+        let reply = client(io).call("Ping", json!({})).await.expect("served");
+        assert_eq!(reply["caller"], json!({ "peer": null }));
+    }
+
+    #[test]
+    fn only_the_owners_own_computers_may_open_one() {
+        assert!(peer_allowed(Some("laptop-device-id")));
+        assert!(!peer_allowed(None));
+        assert!(!peer_allowed(Some("cloud-0b59268e")));
+    }
+}
