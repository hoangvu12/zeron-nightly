new file mode 100644
index 0000000000000000000000000000000000000000..3d08931fb99fd04f3f97c40e62202bb33e8bc21c
--- /dev/null
+++ b/crates/proto/src/access_wire.rs
@@ -0,0 +1,195 @@
+//! How an [`AccessMode`] crosses devices. Engines from before Auto (0.3.7,
+//! and nightlies before 4b983c6c8) know only supervised, auto-accept-edits
+//! and full-access. They fail a whole message that holds any other value:
+//! the harness catalog, a chat row or a run. So "auto" never goes in a field
+//! they read. The catalog's `accessModes` lists only the modes they know,
+//! and `autoAccessMode` says Auto is offered too. A chat's or a run's
+//! `access` holds [`OLD_READER_AUTO`], and `autoAccess` says the mode is
+//! Auto. Old engines ignore the new fields, and this build reads them back
+//! into one value. A plain "auto" (sent by an engine that did) still reads
+//! as Auto.
+
+use std::ops::Not;
+
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+use serde_json::Value;
+
+use crate::AccessMode;
+
+/// What an engine from before Auto runs instead of Auto: supervised, which
+/// is stricter than Auto and honored by every agent that honors any mode.
+/// (Auto-accept-edits is nearer, but an old engine runs an agent that
+/// lacks a mode with full access.)
+pub const OLD_READER_AUTO: AccessMode = AccessMode::Supervised;
+
+fn for_old_readers(mode: AccessMode) -> AccessMode {
+    if mode == AccessMode::Auto { OLD_READER_AUTO } else { mode }
+}
+
+/// A chat's or a run's `access`, as `#[serde(flatten, with = "access_wire::mode")]`.
+pub mod mode {
+    use super::*;
+
+    #[derive(Serialize, Deserialize)]
+    struct Wire {
+        #[serde(default, skip_serializing_if = "AccessMode::is_full_access")]
+        access: AccessMode,
+        #[serde(default, rename = "autoAccess", skip_serializing_if = "Not::not")]
+        auto_access: bool,
+    }
+
+    pub fn serialize<S: Serializer>(mode: &AccessMode, serializer: S) -> Result<S::Ok, S::Error> {
+        Wire {
+            access: for_old_readers(*mode),
+            auto_access: *mode == AccessMode::Auto,
+        }
+        .serialize(serializer)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<AccessMode, D::Error> {
+        let wire = Wire::deserialize(deserializer)?;
+        Ok(if wire.auto_access { AccessMode::Auto } else { wire.access })
+    }
+}
+
+/// A harness catalog's `accessModes`, as `#[serde(flatten, with = "access_wire::modes")]`.
+pub mod modes {
+    use super::*;
+
+    #[derive(Serialize, Deserialize)]
+    struct Wire {
+        #[serde(default, rename = "accessModes", skip_serializing_if = "Vec::is_empty")]
+        access_modes: Vec<AccessMode>,
+        #[serde(default, rename = "autoAccessMode", skip_serializing_if = "Not::not")]
+        auto_access_mode: bool,
+    }
+
+    pub fn serialize<S: Serializer>(modes: &[AccessMode], serializer: S) -> Result<S::Ok, S::Error> {
+        Wire {
+            access_modes: modes.iter().copied().filter(|m| *m != AccessMode::Auto).collect(),
+            auto_access_mode: modes.contains(&AccessMode::Auto),
+        }
+        .serialize(serializer)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Vec<AccessMode>, D::Error> {
+        let Wire { mut access_modes, auto_access_mode } = Wire::deserialize(deserializer)?;
+        if auto_access_mode && !access_modes.contains(&AccessMode::Auto) {
+            // In its place among the modes, least to most trusting.
+            let at = access_modes
+                .iter()
+                .position(|m| *m == AccessMode::FullAccess)
+                .unwrap_or(access_modes.len());
+            access_modes.insert(at, AccessMode::Auto);
+        }
+        Ok(access_modes)
+    }
+}
+
+/// The access mode of a chat's config or a run request held as JSON, read
+/// as [`mode`] reads it. Missing or unknown reads as full access, as
+/// [`AccessMode`]'s default.
+pub fn read(object: &Value) -> AccessMode {
+    mode::deserialize(object).unwrap_or_default()
+}
+
+/// Sets `mode` on a chat's config or a run request held as JSON, as
+/// [`mode`] writes it.
+pub fn write(object: &mut Value, mode: AccessMode) {
+    object["access"] = serde_json::json!(for_old_readers(mode));
+    if mode == AccessMode::Auto {
+        object["autoAccess"] = Value::Bool(true);
+    } else if let Some(map) = object.as_object_mut() {
+        map.remove("autoAccess");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::*;
+    use crate::{ChatConfig, HarnessId, RunRequest, SandboxLevel};
+
+    /// [`AccessMode`] as engines from before Auto have it.
+    #[derive(Debug, PartialEq, Deserialize)]
+    #[serde(rename_all = "kebab-case")]
+    enum OldAccessMode {
+        Supervised,
+        AutoAcceptEdits,
+        FullAccess,
+    }
+
+    #[derive(Debug, Deserialize)]
+    struct OldChatConfig {
+        #[serde(default)]
+        access: Option<OldAccessMode>,
+    }
+
+    fn config(access: AccessMode) -> ChatConfig {
+        ChatConfig {
+            harness: HarnessId::ClaudeCode,
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            access,
+            plan: false,
+        }
+    }
+
+    #[test]
+    fn an_old_reader_reads_auto_as_supervised_and_a_new_one_round_trips_it() {
+        let wire = serde_json::to_value(config(AccessMode::Auto)).unwrap();
+        assert_eq!((&wire["access"], &wire["autoAccess"]), (&json!("supervised"), &json!(true)));
+        let old: OldChatConfig = serde_json::from_value(wire.clone()).unwrap();
+        assert_eq!(old.access, Some(OldAccessMode::Supervised));
+        let new: ChatConfig = serde_json::from_value(wire).unwrap();
+        assert_eq!(new, config(AccessMode::Auto));
+    }
+
+    #[test]
+    fn other_modes_go_as_before() {
+        for access in AccessMode::ALL {
+            let wire = serde_json::to_value(config(access)).unwrap();
+            assert!(wire.get("autoAccess").is_none());
+            assert_eq!(wire.get("access").is_none(), access == AccessMode::FullAccess);
+            assert_eq!(serde_json::from_value::<ChatConfig>(wire).unwrap().access, access);
+        }
+    }
+
+    #[test]
+    fn a_plain_auto_from_an_engine_that_sent_one_still_reads_as_auto() {
+        let mut wire = serde_json::to_value(config(AccessMode::Supervised)).unwrap();
+        wire["access"] = json!("auto");
+        assert_eq!(serde_json::from_value::<ChatConfig>(wire.clone()).unwrap().access, AccessMode::Auto);
+        assert_eq!(read(&wire), AccessMode::Auto);
+    }
+
+    #[test]
+    fn a_run_request_carries_auto_the_same_way() {
+        let wire = json!({
+            "prompt": "hi", "model": null, "reasoning": null, "cwd": "/",
+            "sandbox": "workspace-write", "resume": null,
+            "access": "supervised", "autoAccess": true,
+        });
+        let request: RunRequest = serde_json::from_value(wire).unwrap();
+        assert_eq!(request.access, AccessMode::Auto);
+        let back = serde_json::to_value(&request).unwrap();
+        assert_eq!((&back["access"], &back["autoAccess"]), (&json!("supervised"), &json!(true)));
+        let old: OldChatConfig = serde_json::from_value(back).unwrap();
+        assert_eq!(old.access, Some(OldAccessMode::Supervised));
+    }
+
+    #[test]
+    fn json_helpers_read_and_write_the_wire_form() {
+        let mut object = json!({ "access": "full-access" });
+        write(&mut object, AccessMode::Auto);
+        assert_eq!(object, json!({ "access": "supervised", "autoAccess": true }));
+        assert_eq!(read(&object), AccessMode::Auto);
+        write(&mut object, AccessMode::AutoAcceptEdits);
+        assert_eq!(object, json!({ "access": "auto-accept-edits" }));
+        assert_eq!(read(&object), AccessMode::AutoAcceptEdits);
+        assert_eq!(read(&json!({})), AccessMode::FullAccess);
+    }
+}
