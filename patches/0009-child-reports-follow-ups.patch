+    /// A child that sent its result with `send_message` and then said it
+    /// again as its final reply: the report says so, not the words again.
+    #[tokio::test]
+    async fn a_final_reply_repeating_what_the_child_sent_isnt_said_twice() {
+        let rig = family_rig().await;
+        let lead = rig.start("lead", "Hello.").await;
+        lead.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the lead is done", |r| r.status("lead").last_completed_turn.is_some()).await;
+        let kid = rig.start("kid-a", &from_lead("Run the tests.")).await;
