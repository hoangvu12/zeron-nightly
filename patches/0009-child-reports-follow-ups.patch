+        assert!(!body.contains(said), "{body}");
+        rig.core.sessions.shutdown().await;
+    }
+
+    /// The lead thanks a child for its report; the child's "ok" back is
+    /// kept from the lead's agent (in its ledger, marked), so a thanks
+    /// starts no round of them. A question back is news, and goes.
+    #[tokio::test]
+    async fn a_childs_answer_to_a_thanks_doesnt_wake_the_lead() {
+        let rig = family_rig().await;
+        let lead = rig.start("lead", "Hello.").await;
+        lead.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the lead is done", |r| r.status("lead").last_completed_turn.is_some()).await;
+        let kid = rig.start("kid-a", &from_lead("Run the tests.")).await;
+        kid.feed.send(text("Green.")).unwrap();
+        kid.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the report", |r| r.heard().len() == 1).await;
+
+        rig.lead_writes("kid-a", "Thanks, that is all.", "lead-m2", false);
+        rig.until("Tests reads it", |r| r.status("kid-a").status == SessionStatus::Working).await;
+        let run = rig.current_run("kid-a", &kid).await;
+        run.feed.send(text("Ok, stopping here.")).unwrap();
+        run.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("its answer is in the ledger", |r| r.ledger().iter().any(|id| id.ends_with(reports::QUIET)))
+            .await;
+        rig.quiet().await;
