+    /// After a handoff: an agent's message to an archived chat is refused
+    /// (it would only wake it), unless it's that chat's parent; a child of
+    /// an archived parent goes to the next chat that asks it something; and
+    /// a Stop says which chat made it, whoever's child it stopped.
+    #[tokio::test]
+    async fn after_a_handoff_the_new_orchestrator_has_the_children() {
+        let (_temp, core) = core().await;
+        chat(&core, "old", "Old lead", "workspace-write", "full-access").await;
+        chat(&core, "new", "New lead", "workspace-write", "full-access").await;
+        let rpc = core.rpc_service();
+        rpc.handle(
+            methods::MUTATE,
+            json!({"op":"createChat", "chatId":"kid", "deviceId":core.device_id, "parentChatId":"old",
+                "config":{"harness":"codex","sandbox":"workspace-write","access":"full-access"}}),
+        )
+        .await
+        .unwrap();
+        let rpc = &rpc;
+        let send = |from: &'static str, to: &'static str| {
+            with_caller(agent(from), async move {
+                rpc.agent_gate(methods::QUEUE_MESSAGE, json!({"chatId": to, "text": "Status?"}))
+            })
+        };
+        // While its parent works, a stranger's message leaves it be.
+        send("new", "kid").await.unwrap();
+        assert_eq!(core.workspace.chat("kid").unwrap().unwrap().parent_chat_id.as_deref(), Some("old"));
+
+        core.workspace.set_chat_archived("old", true).unwrap();
+        let refused = send("kid", "old").await.unwrap_err();
+        assert!(refused.to_string().contains("archived"), "{refused}");
+        let gated = send("new", "kid").await.unwrap();
+        assert_eq!(core.workspace.chat("kid").unwrap().unwrap().parent_chat_id.as_deref(), Some("new"));
+        assert!(gated["text"].as_str().unwrap().contains("Your reply reaches it on its own"), "{gated}");
+
+        // An archived child still hears from its own parent.
+        core.workspace.set_chat_archived("kid", true).unwrap();
+        send("new", "kid").await.unwrap();
+
+        let stop = with_caller(agent("kid"), async {
+            rpc.agent_gate(methods::QUEUE_COMMAND, json!({"chatId":"new", "command":{"kind":"interrupt"}}))
+        })
+        .await
+        .unwrap();
+        assert_eq!(stop["command"]["stoppedBy"], "kid");
+        core.sessions.shutdown().await;
+    }
