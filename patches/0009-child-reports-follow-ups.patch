+/// `reply` says what `sent` said already: the same words, give or take
+/// spacing, or most of them, one inside the other.
+fn repeats(reply: &str, sent: &str) -> bool {
+    let squash = |text: &str| text.split_whitespace().collect::<Vec<_>>().join(" ");
+    let (reply, sent) = (squash(reply), squash(sent));
+    if reply.is_empty() || sent.is_empty() {
+        return false;
+    }
+    let (short, long) = if reply.len() <= sent.len() { (&reply, &sent) } else { (&sent, &reply) };
+    long.contains(short.as_str()) && short.len() * 10 >= long.len() * 8
+}
