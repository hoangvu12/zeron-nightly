+    /// The queue opens with children's reports that came in after the latest
+    /// Stop sent to this chat (see [`Self::drain_queue`]).
+    fn reports_since_stop(&self, handle: &Arc<ChatDocHandle>) -> bool {
+        let Ok(queue) = handle.doc.read_queue() else {
+            return false;
+        };
+        let Some(head) = queue.first().filter(|row| held_report_row(row)) else {
+            return false;
+        };
+        let stopped = handle
+            .doc
+            .read_commands()
+            .unwrap_or_default()
+            .iter()
+            .filter(|c| matches!(c.payload, SessionCommandPayload::Interrupt { .. }))
+            .map(|c| c.issued_at)
+            .max();
+        stopped.is_none_or(|at| head.issued_at > at)
+    }
