+/// A `create_chat(s)` call in the parent's transcript (`entries`) that
+/// waited, and returned `child`'s first turn settled: its result names the
+/// child with a turn whose outcome is in (not timed out, not unknown).
+fn create_returned(entries: &[SessionMessageEntry], child: &str) -> bool {
+    fn names(value: &Value, child: &str) -> bool {
+        match value {
+            Value::Object(map) => {
+                let settled = map.get("turn").and_then(|t| t.get("outcome")).and_then(Value::as_str);
+                (map.get("chatId").and_then(Value::as_str) == Some(child)
+                    && settled.is_some_and(|o| !matches!(o, "timedOut" | "unknown")))
+                    || map.values().any(|v| names(v, child))
+            }
+            Value::Array(items) => items.iter().any(|v| names(v, child)),
+            // A result wrapped as text (MCP content) holds the JSON inside.
+            Value::String(text) => parsed(text).is_some_and(|v| names(&v, child)),
+            _ => false,
+        }
+    }
+    fn parsed(text: &str) -> Option<Value> {
+        let text = text.trim();
+        serde_json::from_str(text).ok().or_else(|| {
+            let (start, end) = (text.find(['{', '['])?, text.rfind(['}', ']'])?);
+            (start < end).then(|| serde_json::from_str(&text[start..=end]).ok()).flatten()
+        })
+    }
+    entries.iter().flat_map(|e| &e.parts).any(|part| {
+        let MessagePart::Tool { call: ToolCall::Mcp { server, tool, .. }, resolved: true, is_error: false, output: Some(output), .. } = part
+        else {
+            return false;
+        };
+        server == "zeron"
+            && matches!(tool.as_str(), "create_chat" | "create_chats")
+            && output.contains(child)
+            && parsed(output).is_some_and(|value| names(&value, child))
+    })
+}
