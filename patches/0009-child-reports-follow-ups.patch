+
+        rig.lead_writes("kid-a", "Thanks. Did you push?", "lead-m3", false);
+        rig.until("Tests reads it", |r| r.status("kid-a").status == SessionStatus::Working).await;
+        let again = rig.current_run("kid-a", &run).await;
+        again.feed.send(text("No, not yet.")).unwrap();
+        again.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("a question's answer goes", |r| r.heard().len() == 2).await;
+        rig.core.sessions.shutdown().await;
+    }
