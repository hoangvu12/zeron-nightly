+/// How often a link served as a proven device's checks that device again,
+/// and the longest it's served before it must prove itself afresh.
+#[derive(Clone, Copy, Debug)]
+pub struct Recheck {
+    pub every: Duration,
+    pub lifetime: Duration,
+}
+
+/// A proven link's device is checked again this often (and whenever the
