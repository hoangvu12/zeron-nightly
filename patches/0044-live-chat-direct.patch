+    /// A machine that refuses every connection; counts the dials.
+    struct Refuses(std::sync::atomic::AtomicUsize);
+
+    #[async_trait::async_trait]
+    impl Pairing for Refuses {
+        async fn ready(&self, _device: &str) -> bool {
+            true
+        }
+        fn warm(&self, _device: &str) {}
+        async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Err(std::io::Error::from(std::io::ErrorKind::ConnectionRefused).into())
+        }
+    }
+
+    /// A refused connection is waited out for a moment, not dialled by
+    /// every call, nor held against the device for the backoff.
+    #[tokio::test]
+    async fn a_refused_connection_is_waited_out_for_a_moment() {
+        let pairing = Arc::new(Refuses(0.into()));
+        let links = Links::over(pairing.clone());
+        let dials = || pairing.0.load(std::sync::atomic::Ordering::SeqCst);
+        assert!(links.client("desktop").await.is_none());
+        assert!(links.client("desktop").await.is_none());
+        assert_eq!(dials(), 1, "not dialled again at once");
+        tokio::time::sleep(REFUSED_WAIT + Duration::from_millis(100)).await;
+        assert!(links.client("desktop").await.is_none());
+        assert_eq!(dials(), 2, "dialled again a moment later");
     }
 }
diff --git a/crates/engine/src/direct_rpc/next_road.rs b/crates/engine/src/direct_rpc/next_road.rs
new file mode 100644
index 0000000000000000000000000000000000000000..afeb9952be6bb7c207bbabfa886e77040e14bdac
--- /dev/null
+++ b/crates/engine/src/direct_rpc/next_road.rs
@@ -0,0 +1,326 @@
+//! A forwarded call, asked down the roads ([`Roads::ask`]). A read cut off
+//! on one road (its link closed or failed under it) is asked again: first,
+//! once, on a fresh link on the same road (the one it was on may have gone
+//! stale unnoticed, as when the far engine restarted), then on the next in
+//! order: the Tailscale road, then the WebRTC link, then the relay.
+//! So with the edge down, a read the Tailscale road dropped is still
+//! answered over the WebRTC link rather than sent to a relay that isn't
+//! there. As 0038 set it, only reads go again ([`super::repeatable`]), and a
+//! read that timed out isn't asked again anywhere: it may still be running,
+//! and a second copy would run beside it.
+
+use std::future::Future;
+use std::sync::Arc;
+use std::time::Duration;
+
+use tokio::time::Instant;
+use zeron_rpc::RpcError;
+
+use super::{Road, RoadKind, Roads, needs_verified_caller, repeatable};
+use crate::workspace_host::WorkspaceHost;
+
+/// How one try of a call on a road came to nothing.
+#[derive(Debug)]
+pub enum Missed {
+    /// No answer by the call's deadline. It may still be running there, so
+    /// it isn't asked again on another road.
+    TimedOut(RpcError),
+    /// Anything else: the far end's refusal or failure, or the road's link
+    /// failing under the call (closed, a transport error).
+    Failed(RpcError),
+}
+
+impl Missed {
+    pub fn into_error(self) -> RpcError {
+        match self {
+            Self::TimedOut(error) | Self::Failed(error) => error,
+        }
+    }
+}
+
+/// The road's link failed under the call: it may not have reached the host.
+fn cut_off(error: &RpcError) -> bool {
+    matches!(error, RpcError::Closed | RpcError::Transport(_))
+}
+
+impl Roads {
+    /// Ask `method` of `target` by `attempt`, on the road picked for it
+    /// ([`Self::for_method`]). A read that a road other than the relay cut
+    /// off is asked again: once on a fresh link on the same road, then on
+    /// the next road in order, once on each. Every try
+    /// is given the same end, `deadline` from now, so together they take no
+    /// longer than one. A try that timed out, or a cut-off call that isn't a
+    /// read, ends it; so does having no next road, with the try's own error.
+    pub async fn ask<T, F, Fut>(&self, target: &str, method: &str, deadline: Duration, mut attempt: F) -> Result<T, RpcError>
+    where
+        F: FnMut(Road, Instant) -> Fut,
+        Fut: Future<Output = Result<T, Missed>>,
+    {
+        let until = Instant::now() + deadline;
+        let mut road = self.for_method(target, method).await?;
+        let mut afresh = true;
+        loop {
+            let kind = road.kind;
+            let error = match attempt(road, until).await {
+                Ok(reply) => return Ok(reply),
+                Err(Missed::TimedOut(error)) => {
+                    if kind != RoadKind::Relay && repeatable(method) {
+                        tracing::info!(device = target, method, road = kind.name(), error = %error,
+                            "a read timed out; not asked again on another road (it may still be running)");
+                    }
+                    return Err(error);
+                }
+                Err(Missed::Failed(error)) => error,
+            };
+            if !cut_off(&error) {
+                return Err(error);
+            }
+            let Some(next) = self.after(target, method, kind, std::mem::take(&mut afresh)).await else {
+                return Err(error);
+            };
+            tracing::info!(device = target, method, road = kind.name(), next = next.kind.name(), error = %error,
+                "a read cut off on one road; asking again on the next");
+            road = next;
+        }
+    }
+
+    /// The road after `failed` for a read of `method` to `target`: `afresh`,
+    /// a new link on `failed` itself if one opens now; else the next road in
+    /// order that reaches it and has a link up now (one that proved
+    /// this device, for a call that needs the verified caller), else the
+    /// relay, unless the edge is known to be out of reach or no relay link
+    /// can be had. `None` after the relay, and for any call that isn't a
+    /// read: it is never asked twice.
+    async fn after(&self, target: &str, method: &str, failed: RoadKind, afresh: bool) -> Option<Road> {
+        if !repeatable(method) || failed == RoadKind::Relay {
+            return None;
+        }
+        let proven = needs_verified_caller(method);
+        let at = self.lanes.iter().position(|lane| lane.kind == failed)?;
+        let from = if afresh { at } else { at + 1 };
+        for lane in &self.lanes[from..] {
+            if let Some(client) = lane.client(target, Duration::ZERO, proven).await {
+                self.note_road(target, lane.kind);
+                return Some(Road { client, kind: lane.kind });
+            }
+        }
+        if (self.edge_down)() {
+            tracing::info!(device = target, method, "the edge is out of reach; a read cut off isn't asked of the relay");
+            return None;
+        }
+        match self.by_relay(target).await {
+            Ok(road) => {
+                self.note_road(target, RoadKind::Relay);
+                Some(road)
+            }
+            Err(error) => {
+                tracing::info!(device = target, method, %error, "no relay link for a read cut off on another road");
+                None
+            }
+        }
+    }
+
+    /// The edge counts as out of reach while `workspace`'s registry room is
+    /// down after a failure (its socket dropped, or dials failing), not
+    /// merely before its first dial.
+    pub(crate) fn knowing_edge_of(self, workspace: WorkspaceHost) -> Self {
+        self.knowing_edge_down(Arc::new(move || {
+            workspace.edge_expected()
+                && !workspace.sync_status().is_some_and(|room| room.connected)
+                && workspace.reconnect_state().is_some_and(|room| room.last_failure.is_some())
+        }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::{Arc, Mutex};
+    use std::time::Duration;
+
+    use serde_json::{Value, json};
+    use zeron_rpc::{RpcError, RpcReply, RpcService, methods};
+
+    use super::super::{Links, Pairing, RoadKind, Roads, serve};
+    use super::Missed;
+
+    /// Answers every call with the road's name.
+    struct Named(&'static str);
+
+    #[async_trait::async_trait]
+    impl RpcService for Named {
+        async fn handle(&self, _method: &str, _params: Value) -> Result<RpcReply, RpcError> {
+            RpcReply::value(&json!(self.0))
+        }
+    }
+
+    /// A stand-in pairing whose streams reach a [`Named`] host, while up.
+    struct Up(&'static str, AtomicBool);
+
+    #[async_trait::async_trait]
+    impl Pairing for Up {
+        async fn ready(&self, _device: &str) -> bool {
+            self.1.load(Ordering::SeqCst)
+        }
+        fn warm(&self, _device: &str) {}
+        async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+            let (near, far) = tokio::io::duplex(64 * 1024);
+            tokio::spawn(serve(zeron_rpc::device_room::peer_service(Arc::new(Named(self.0)), None), far));
+            Ok(Box::new(near))
+        }
+    }
+
+    /// The Tailscale road and the WebRTC link (`direct`); the relay at an
+    /// address nothing answers on, and the edge known down when `edge_down`.
+    fn roads_to(direct: Arc<Up>, edge_down: bool) -> Roads {
+        let mut relay = zeron_rpc::LinkCacheConfig::new("http://127.0.0.1:9", Arc::new(zeron_rpc::StaticToken("t".into())));
+        relay.probe_timeout = Duration::from_millis(200);
+        Roads::new(zeron_rpc::LinkCache::new(relay), Links::over(direct), Arc::new(|_: &str| true))
+            .first(
+                RoadKind::Tailnet,
+                Links::over(Arc::new(Up("tailnet", AtomicBool::new(true)))),
+                Arc::new(|_: &str| true),
+                Duration::ZERO,
+            )
+            .knowing_edge_down(Arc::new(move || edge_down))
+    }
+
+    /// What a test's `attempt` does on each road.
+    #[derive(Clone, Copy)]
+    enum Does {
+        Answers,
+        IsCutOff,
+        TimesOut,
+    }
+
+    /// Ask `method` with every try doing what `does` says for its road;
+    /// returns the outcome and the roads tried, with each try's end.
+    async fn ask(
+        roads: &Roads,
+        method: &str,
+        does: impl Fn(RoadKind) -> Does,
+    ) -> (Result<Value, RpcError>, Vec<(RoadKind, tokio::time::Instant)>) {
+        let tried = Mutex::new(Vec::new());
+        let outcome = roads
+            .ask("desktop", method, Duration::from_secs(30), |road, until| {
+                tried.lock().unwrap().push((road.kind, until));
+                let does = does(road.kind);
+                async move {
+                    match does {
+                        Does::Answers => road.client.call(method, json!({})).await.map_err(Missed::Failed),
+                        Does::IsCutOff => Err(Missed::Failed(RpcError::Transport(format!("cut off on {}", road.kind.name())))),
+                        Does::TimesOut => Err(Missed::TimedOut(RpcError::Transport("no reply in time".into()))),
+                    }
+                }
+            })
+            .await;
+        (outcome, tried.into_inner().unwrap())
+    }
+
+    fn kinds(tried: &[(RoadKind, tokio::time::Instant)]) -> Vec<RoadKind> {
+        tried.iter().map(|(kind, _)| *kind).collect()
+    }
+
+    #[tokio::test]
+    async fn a_read_cut_off_on_the_tailscale_road_is_answered_on_the_next_road_within_one_deadline() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), true);
+        let cut_on_tailnet = |kind| if kind == RoadKind::Tailnet { Does::IsCutOff } else { Does::Answers };
+        let (outcome, tried) = ask(&roads, methods::LIST_HARNESSES, cut_on_tailnet).await;
+        assert_eq!(outcome.unwrap(), json!("direct"));
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet, RoadKind::Tailnet, RoadKind::WebRtc]);
+        assert!(tried.iter().all(|(_, until)| *until == tried[0].1), "each try gets what remains, not a fresh deadline");
+    }
+
+    #[tokio::test]
+    async fn a_call_that_isnt_a_read_is_asked_once() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), false);
+        let (outcome, tried) = ask(&roads, methods::RUN_COMMAND, |_| Does::IsCutOff).await;
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet]);
+        assert!(matches!(outcome, Err(RpcError::Transport(ref m)) if m == "cut off on tailnet"), "{outcome:?}");
+    }
+
+    /// A read that got no answer in time may still be running on the host:
+    /// asked again elsewhere, two would run at once.
+    #[tokio::test]
+    async fn a_read_that_timed_out_isnt_asked_again() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), false);
+        let (outcome, tried) = ask(&roads, methods::LIST_MODELS, |_| Does::TimesOut).await;
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet]);
+        assert!(matches!(outcome, Err(RpcError::Transport(ref m)) if m == "no reply in time"), "{outcome:?}");
+    }
+
+    /// After the Tailscale road (once afresh) comes the WebRTC link, then the
+    /// relay, never the Tailscale road again; with the edge known down, not
+    /// the relay either, and the error is the road's own, at once.
+    #[tokio::test]
+    async fn with_the_edge_down_a_read_cut_off_everywhere_fails_at_once_with_its_own_error() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), true);
+        let started = std::time::Instant::now();
+        let (outcome, tried) = ask(&roads, methods::LIST_HARNESSES, |_| Does::IsCutOff).await;
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet, RoadKind::Tailnet, RoadKind::WebRtc]);
+        assert!(matches!(outcome, Err(RpcError::Transport(ref m)) if m == "cut off on direct"), "{outcome:?}");
+
+        // No WebRTC link: straight from the Tailscale road to failing.
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(false))), true);
+        let (outcome, tried) = ask(&roads, methods::LIST_HARNESSES, |_| Does::IsCutOff).await;
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet, RoadKind::Tailnet]);
+        assert!(matches!(outcome, Err(RpcError::Transport(ref m)) if m == "cut off on tailnet"), "{outcome:?}");
+        assert!(started.elapsed() < Duration::from_millis(500), "nothing waited on the edge: {:?}", started.elapsed());
+    }
+
+    /// The edge up but no relay link to be had: the road's own error, not
+    /// the relay's dial failure.
+    #[tokio::test]
+    async fn with_no_relay_link_the_roads_own_error_stands() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(false))), false);
+        let (outcome, tried) = ask(&roads, methods::LIST_HARNESSES, |_| Does::IsCutOff).await;
+        assert_eq!(kinds(&tried), [RoadKind::Tailnet, RoadKind::Tailnet]);
+        assert!(matches!(outcome, Err(RpcError::Transport(ref m)) if m == "cut off on tailnet"), "{outcome:?}");
+    }
+
+    /// A read cut off on a link that went stale unnoticed (the far engine
+    /// restarted) is answered on a fresh link on the same road.
+    #[tokio::test]
+    async fn a_read_cut_off_on_a_stale_link_is_answered_on_a_fresh_one() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), true);
+        let links = Mutex::new(Vec::new());
+        let reply = roads
+            .ask("desktop", methods::LIST_HARNESSES, Duration::from_secs(30), |road, _| {
+                let first = links.lock().unwrap().is_empty();
+                links.lock().unwrap().push((road.kind, road.client.clone()));
+                let roads = &roads;
+                async move {
+                    if first {
+                        // As forward_on does with a link that failed.
+                        roads.suspect("desktop", road.kind);
+                        return Err(Missed::Failed(RpcError::Closed));
+                    }
+                    road.client.call(methods::LIST_HARNESSES, json!({})).await.map_err(Missed::Failed)
+                }
+            })
+            .await;
+        assert_eq!(reply.unwrap(), json!("tailnet"));
+        let links = links.into_inner().unwrap();
+        assert_eq!(links.iter().map(|(kind, _)| *kind).collect::<Vec<_>>(), [RoadKind::Tailnet, RoadKind::Tailnet]);
+        assert!(!Arc::ptr_eq(&links[0].1, &links[1].1), "a fresh link");
+    }
+
+    /// Each road keeps its own health: a failure on one drops its link alone.
+    #[tokio::test]
+    async fn a_road_that_failed_drops_its_own_link_alone() {
+        let roads = roads_to(Arc::new(Up("direct", AtomicBool::new(true))), true);
+        let webrtc = roads.lanes[1].links.client("desktop").await.expect("the WebRTC link");
+        let tailnet = roads.client("desktop").await.expect("the Tailscale road");
+        assert_eq!(tailnet.kind, RoadKind::Tailnet);
+
+        roads.suspect("desktop", RoadKind::Tailnet);
+        let again = roads.lanes[1].links.client("desktop").await.expect("the WebRTC link");
+        assert!(Arc::ptr_eq(&again, &webrtc), "the WebRTC link stayed up");
+        let reopened = roads.client("desktop").await.expect("the Tailscale road");
+        assert!(!Arc::ptr_eq(&reopened.client, &tailnet.client), "the Tailscale link opened afresh");
+
+        roads.suspect("desktop", RoadKind::WebRtc);
+        let kept = roads.client("desktop").await.expect("the Tailscale road");
+        assert!(Arc::ptr_eq(&kept.client, &reopened.client), "the Tailscale link stayed up");
+    }
+}
