+++ b/crates/rpc/src/direct_only.rs
@@ -0,0 +1,74 @@
+//! Calls that only ever go between two of the person's devices directly,
+//! never through the edge's relay.
+//!
+//! The edge carries their traffic another way already: a chat's frames and
+//! wakes go through its ChatRoom, list changes through the RegistryRoom. So
+//! the relay's host refuses them ([`NotOnTheRelay`]), whoever the edge says
+//! is calling. Who may call them over a direct link is the engine's
+//! `direct_peer` check.
+
+use std::sync::Arc;
+
+use crate::{RpcError, RpcReply, RpcService, methods};
+
+/// Methods only ever sent between two devices directly: the relay's host
+/// refuses them.
+pub fn direct_only(method: &str) -> bool {
+    matches!(
+        method,
+        methods::WATCH_CHAT_LINK | methods::SEND_CHAT_FRAMES | methods::WAKE_CHAT
+    )
+}
+
+/// `service` as the relay serves it: [`direct_only`] methods refused before
+/// they reach it.
+pub(crate) struct NotOnTheRelay(Arc<dyn RpcService>);
+
+impl NotOnTheRelay {
+    pub(crate) fn wrap(service: Arc<dyn RpcService>) -> Arc<dyn RpcService> {
+        Arc::new(Self(service))
+    }
+}
+
+#[async_trait::async_trait]
+impl RpcService for NotOnTheRelay {
+    async fn handle(&self, method: &str, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        if direct_only(method) {
+            return Err(RpcError::Failed(format!(
+                "{method} is only answered over a direct link, never the relay"
+            )));
+        }
+        self.0.handle(method, params).await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct Echo;
+
+    #[async_trait::async_trait]
+    impl RpcService for Echo {
+        async fn handle(&self, method: &str, _params: serde_json::Value) -> Result<RpcReply, RpcError> {
+            Ok(RpcReply::Value(serde_json::json!(method)))
+        }
+    }
+
+    /// Chat links, direct wakes and list changes from a device the edge
+    /// vouched for are still refused on the relay; a direct link serves them.
+    #[tokio::test]
+    async fn the_relay_refuses_what_only_goes_direct() {
+        let relay = NotOnTheRelay::wrap(crate::device_room::peer_service(Arc::new(Echo), Some("laptop".into())));
+        let direct = crate::device_room::peer_service(Arc::new(Echo), Some("laptop".into()));
+        for method in [
+            methods::WATCH_CHAT_LINK,
+            methods::SEND_CHAT_FRAMES,
+            methods::WAKE_CHAT,
+        ] {
+            assert!(relay.handle(method, serde_json::json!({})).await.is_err(), "{method} on the relay");
+            assert!(direct.handle(method, serde_json::json!({})).await.is_ok(), "{method} direct");
+        }
+        assert!(relay.handle(methods::RELAY_COMMAND, serde_json::json!({})).await.is_ok());
+    }
+}
