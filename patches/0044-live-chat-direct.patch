@@ -0,0 +1,576 @@
+//! Live chat links: a relayed chat's frames between its host and a device
+//! viewing it, over the direct road as well as through the ChatRoom.
+//!
+//! A host doesn't know who is viewing its chats, so the viewer opens the
+//! link: [`methods::WATCH_CHAT_LINK`] to the host over a road from
+//! [`crate::direct_rpc::Roads::direct`] (never the relay: the edge carries the
+//! chat already). The host's frames come back on that stream; the viewer's go
+//! to the host as [`methods::SEND_CHAT_FRAMES`] calls, one at a time, in order.
+//! Both ends hand their frames to the chat's [`RelayHandle`] as a link.
+//!
+//! A link is a second path only. The room still gets every frame it would
+//! without one, and stays the record. A link's frames only ever import
+//! (`relay_import`): they never become rows and never move a row cursor, and
+//! a queue row is only ever confirmed by the room's own copy.
+//!
+//! Only relay-layer (generation 3) chats get links, and only between the
+//! person's own computers whose host advertises
+//! [`zeron_proto::capabilities::CHAT_LINK_V1`]. Without one, nothing here runs
+//! and the chat behaves exactly as before.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, Weak};
+use std::time::Duration;
+
+use base64::Engine as _;
+use futures::StreamExt;
+use serde::Deserialize;
+use tokio::sync::mpsc;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+use zeron_rpc::{RpcError, RpcReply, methods, parse_params};
+use zeron_sync::chat_relay::RelayHandle;
+
+use super::relay::{ChatRelayState, relay_layer_enabled};
+use super::{ChatDocHandle, DocHost, lock};
+
+/// Keepalive both ways while a link is quiet, and how long silence lasts
+/// before a link is given up. The room takes over from there.
+const LINK_PROBE: Duration = Duration::from_secs(3);
+const LINK_DEAD: Duration = Duration::from_secs(8);
+/// How long a host waits for a chat it just opened to start its relay.
+const ACCEPT_WAIT: Duration = Duration::from_secs(5);
+/// How long the viewer waits for a pairing under way before trying later.
+const ROAD_PATIENCE: Duration = Duration::from_millis(1500);
+/// The viewer's wait between tries, doubling.
+const RETRY_FIRST: Duration = Duration::from_secs(1);
+const RETRY_CAP: Duration = Duration::from_secs(15);
+/// How often the viewer looks again at whether it wants a link.
+const WANT_POLL: Duration = Duration::from_secs(1);
+/// Frames per `SendChatFrames` call, and how long one may take.
+const SEND_BATCH: usize = 16;
+const SEND_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// Why a viewer's link ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum LinkEnd {
+    /// The host closed the stream.
+    HostEnded,
+    /// Nothing from the host for [`LINK_DEAD`], or a send unanswered: the
+    /// road is suspect.
+    WentQuiet,
+    /// The host refused this device's frames.
+    FramesRefused,
+    /// The chat's relay closed the link.
+    RelayEnded,
+    /// This device stopped wanting it (off screen, or the host changed).
+    NotWanted,
+}
+
+impl LinkEnd {
+    fn why(self) -> &'static str {
+        match self {
+            Self::HostEnded => "the host ended it",
+            Self::WentQuiet => "the host went quiet",
+            Self::FramesRefused => "the host refused frames",
+            Self::RelayEnded => "the chat's relay ended it",
+            Self::NotWanted => "not wanted any more",
+        }
+    }
+}
+
+/// Links a host keeps per chat (a person's computers viewing it, with room
+/// to spare), per device over all chats (so one device can't take every
+/// slot), and over all its chats. Past any of them a new link is refused,
+/// and the ChatRoom carries the chat as before.
+const LINKS_PER_CHAT: usize = 4;
+const LINKS_PER_DEVICE: usize = 8;
+const LINKS_IN_ALL: usize = 32;
+/// A link opens a chat that isn't open here only while links hold fewer
+/// chats than this: a linked chat is never evicted. Every chat a link holds
+/// counts, whoever opened it.
+const LINKED_CHATS: usize = 8;
+
+/// What a host keeps for chat links and direct sends, on its doc host.
+#[derive(Default)]
+pub(super) struct DirectChats {
+    /// The chat links held here, against the caps.
+    pub(super) slots: Slots,
+    /// Commands whose host took a direct copy lately (`direct_hints`).
+    pub(super) taken: super::direct_hints::Taken,
+}
+
+/// The chat links this host holds, by chat and device: what the caps count.
+/// A link takes its slot before its chat is opened or anything awaited, and
+/// gives it back when it ends (or never comes up).
+#[derive(Clone, Default)]
+pub(super) struct Slots(Arc<Mutex<HashMap<(String, String), usize>>>);
+
+/// One link's hold on a slot; dropped, the slot is free.
+pub(super) struct Slot {
+    slots: Slots,
+    key: (String, String),
+}
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        let mut held = lock(&self.slots.0);
+        if let Some(holders) = held.get_mut(&self.key) {
+            *holders -= 1;
+            if *holders == 0 {
+                held.remove(&self.key);
+            }
+        }
+    }
+}
+
+impl Slots {
+    /// A slot for `device`'s link to `chat` (`cold`: the chat isn't open
+    /// here, so the link would open it), or why there's none. A device
+    /// replacing its own link to a chat takes no new room.
+    pub(super) fn reserve(&self, chat: &str, device: &str, cold: bool) -> Result<Slot, RpcError> {
+        let refused = |why: &str| Err(RpcError::Failed(why.into()));
+        let key = (chat.to_owned(), device.to_owned());
+        let mut held = lock(&self.0);
+        if !held.contains_key(&key) {
+            if held.keys().filter(|(c, _)| c == chat).count() >= LINKS_PER_CHAT {
+                return refused("that chat has as many links as it takes");
+            }
+            if held.keys().filter(|(_, d)| d == device).count() >= LINKS_PER_DEVICE {
+                return refused("that device has as many chat links here as it may");
+            }
+            if held.len() >= LINKS_IN_ALL {
+                return refused("this device has as many chat links as it takes");
+            }
+            let linked: std::collections::HashSet<&str> = held.keys().map(|(c, _)| c.as_str()).collect();
+            if cold && !linked.contains(chat) && linked.len() >= LINKED_CHATS {
+                return refused("links hold as many chats open here as they may");
+            }
+        }
+        *held.entry(key.clone()).or_default() += 1;
+        Ok(Slot {
+            slots: self.clone(),
+            key,
+        })
+    }
+}
+
+fn b64() -> &'static base64::engine::GeneralPurpose {
+    &base64::engine::general_purpose::STANDARD
+}
+
+/// The links a host accepted for one chat, on its relay state. Dropping it
+/// (the chat's handle evicted) ends them.
+#[derive(Default)]
+pub(crate) struct Accepted {
+    shared: AcceptedShared,
+}
+
+#[derive(Clone, Default)]
+struct AcceptedShared {
+    ended: CancellationToken,
+    /// Each linked peer's link id, and when it last sent anything.
+    heard: Arc<Mutex<HashMap<String, (u64, Instant)>>>,
+}
+
+impl Drop for Accepted {
+    fn drop(&mut self) {
+        self.shared.ended.cancel();
+    }
+}
+
+impl AcceptedShared {
+    fn linked(&self, peer: &str, id: u64) {
+        lock(&self.heard).insert(peer.to_owned(), (id, Instant::now()));
+    }
+
+    /// `peer` sent something: false if it has no link here.
+    fn heard_from(&self, peer: &str) -> bool {
+        match lock(&self.heard).get_mut(peer) {
+            Some((_, at)) => {
+                *at = Instant::now();
+                true
+            }
+            None => false,
+        }
+    }
+
+    /// Link `id` to `peer` has heard nothing for [`LINK_DEAD`], or has been
+    /// replaced.
+    fn silent(&self, peer: &str, id: u64) -> bool {
+        lock(&self.heard)
+            .get(peer)
+            .is_none_or(|(current, at)| *current != id || at.elapsed() >= LINK_DEAD)
+    }
+
+    fn unlinked(&self, peer: &str, id: u64) {
+        let mut heard = lock(&self.heard);
+        if heard.get(peer).is_some_and(|(current, _)| *current == id) {
+            heard.remove(peer);
+        }
+    }
+}
+
+/// One link the host accepted. Dropped with its stream: the relay hears the
+/// link is down.
+struct HostLink {
+    chat: String,
+    peer: String,
+    id: u64,
+    relay: RelayHandle,
+    accepted: AcceptedShared,
+    frames: mpsc::Receiver<Vec<u8>>,
+    beat: tokio::time::Interval,
+    /// Its hold on the caps, given back with it.
+    _slot: Slot,
+}
+
+impl HostLink {
+    /// The next item for the viewer, or `None`: the link is over.
+    async fn next(&mut self) -> Option<serde_json::Value> {
+        tokio::select! {
+            frame = self.frames.recv() => frame.map(|frame| serde_json::json!({ "f": b64().encode(frame) })),
+            _ = self.beat.tick() => (!self.accepted.silent(&self.peer, self.id)).then(|| serde_json::json!({ "p": 1 })),
+            _ = self.accepted.ended.cancelled() => None,
+        }
+    }
+}
+
+impl Drop for HostLink {
+    fn drop(&mut self) {
+        self.relay.link_down(&self.peer, self.id);
+        self.accepted.unlinked(&self.peer, self.id);
+        tracing::info!(chat = %self.chat, device = %self.peer, "chat link closed");
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WatchParams {
+    chat_id: String,
+    device: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct FramesParams {
+    chat_id: String,
+    device: String,
+    #[serde(default)]
+    frames: Vec<String>,
+}
+
+impl DocHost {
+    /// The device at the far end of a link or a direct wake, from the call
+    /// being served (`named`: the device the call says it's from, if it
+    /// says): one [`crate::direct_peer`] admits. It must be the id the
+    /// ChatRoom knows it by, so sync rounds line up over both paths.
+    pub(super) fn link_peer(&self, named: Option<&str>) -> Result<String, RpcError> {
+        self.workspace()
+            .ok_or_else(|| RpcError::Failed("this device has no list yet".into()))?
+            .direct_peer(named)
+    }
+
+    /// Host side of [`methods::WATCH_CHAT_LINK`]. A link takes its slot
+    /// (the caps) before the chat is opened or anything awaited: one refused
+    /// opens nothing.
+    pub(crate) async fn watch_chat_link(&self, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        let p: WatchParams = parse_params(params)?;
+        let peer = self.link_peer(Some(&p.device))?;
+        self.hosts_relayed(&p.chat_id).map_err(RpcError::Failed)?;
+        let cold = !lock(&self.inner.handles).contains_key(&p.chat_id);
+        let slot = self.inner.direct.slots.reserve(&p.chat_id, &peer, cold)?;
+        let state = self.relay_for_link(&p.chat_id).await.map_err(RpcError::Failed)?;
+        let accepted = state.chat_links.shared.clone();
+        let (id, frames) = state.relay.link_up(&peer);
+        accepted.linked(&peer, id);
+        tracing::info!(chat = %p.chat_id, device = %peer, "chat link accepted");
+        let link = HostLink {
+            chat: p.chat_id,
+            peer,
+            id,
+            relay: state.relay.clone(),
+            accepted,
+            frames,
+            beat: tokio::time::interval_at(Instant::now() + LINK_PROBE, LINK_PROBE),
+            _slot: slot,
+        };
+        let up = futures::stream::once(async { serde_json::json!({ "up": true }) });
+        let rest = futures::stream::unfold(link, |mut link| async move {
+            let item = link.next().await?;
+            Some((item, link))
+        });
+        Ok(RpcReply::Stream(up.chain(rest).boxed()))
+    }
+
+    /// Host side of [`methods::SEND_CHAT_FRAMES`]: a linked viewer's frames,
+    /// in order. Never opens a chat.
+    pub(crate) fn send_chat_frames(&self, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        let p: FramesParams = parse_params(params)?;
+        let peer = self.link_peer(Some(&p.device))?;
+        let handle = lock(&self.inner.handles).get(&p.chat_id).cloned();
+        let state = handle
+            .and_then(|handle| lock(&handle.relay).clone())
+            .filter(|state| state.chat_links.shared.heard_from(&peer))
+            .ok_or_else(|| RpcError::Failed("no chat link from that device here".into()))?;
+        let mut taken = 0;
+        for frame in &p.frames {
+            let bytes = b64()
+                .decode(frame)
+                .map_err(|_| RpcError::BadParams("a frame isn't base64".into()))?;
+            if !state.relay.link_frame(&peer, &bytes) {
+                return Err(RpcError::BadParams("not a chat frame".into()));
+            }
+            taken += 1;
+        }
+        RpcReply::value(&serde_json::json!({ "taken": taken }))
+    }
+
+    /// Whether `chat` is a relayed chat this device hosts, read from its
+    /// row without opening it: why not, if it isn't.
+    fn hosts_relayed(&self, chat: &str) -> Result<(), String> {
+        if !relay_layer_enabled() {
+            return Err("this device doesn't relay chats".into());
+        }
+        let row = self
+            .workspace()
+            .and_then(|ws| ws.chat(chat).ok().flatten())
+            .ok_or("no such chat here")?;
+        if row.device_id != self.inner.config.device_id {
+            return Err("this device doesn't host that chat".into());
+        }
+        if row.room_gen.unwrap_or(1) < zeron_proto::relay_gen::RELAY_ROOM_GEN {
+            return Err("that chat isn't relayed".into());
+        }
+        Ok(())
+    }
+
+    /// The relay state of `chat` (one [`Self::hosts_relayed`] passed), opened
+    /// if it isn't, for a link that holds its slot.
+    async fn relay_for_link(&self, chat: &str) -> Result<Arc<ChatRelayState>, String> {
+        let handle = self.open(chat).map_err(|e| e.to_string())?;
+        let deadline = Instant::now() + ACCEPT_WAIT;
+        loop {
+            if let Some(state) = lock(&handle.relay).clone() {
+                return Ok(state);
+            }
+            if Instant::now() >= deadline {
+                return Err("that chat's relay isn't running here yet".into());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    }
+
+    /// The viewer's side: while this chat is on screen and its host takes
+    /// links, keep one open. Runs beside the chat's relay duties, under the
+    /// same cancel.
+    pub(super) fn spawn_chat_link(&self, handle: &Arc<ChatDocHandle>, relay: RelayHandle, cancel: CancellationToken) {
+        if !relay_layer_enabled() {
+            return;
+        }
+        let host = self.clone();
+        let weak = Arc::downgrade(handle);
+        let chat = handle.chat_id.clone();
+        self.spawn_sync_worker(cancel, async move {
+            let mut retry: Option<Duration> = None;
+            loop {
+                if weak.strong_count() == 0 {
+                    return;
+                }
+                let wait = match host.chat_link_target(&weak) {
+                    None => WANT_POLL,
+                    Some(target) => match host.run_chat_link(&chat, &target, &relay, &weak).await {
+                        Ok(()) => {
+                            retry = None;
+                            continue;
+                        }
+                        Err(why) => {
+                            let wait = retry.map_or(RETRY_FIRST, |gap| (gap * 2).min(RETRY_CAP));
+                            retry = Some(wait);
+                            tracing::debug!(chat = %chat, device = %target, %why,
+                                retry_in_secs = wait.as_secs(), "no chat link");
+                            wait
+                        }
+                    },
+                };
+                tokio::time::sleep(wait).await;
+            }
+        });
+    }
+
+    /// The chat's host, when this device wants a link to it now: the chat is
+    /// on screen here, relayed, hosted by another of the person's computers,
+    /// and that host takes links.
+    fn chat_link_target(&self, handle: &Weak<ChatDocHandle>) -> Option<String> {
+        let handle = handle.upgrade()?;
+        if handle.messages_tx.receiver_count() == 0 {
+            return None;
+        }
+        let row = self.workspace()?.chat(&handle.chat_id).ok().flatten()?;
+        if row.room_gen.unwrap_or(1) < zeron_proto::relay_gen::RELAY_ROOM_GEN {
+            return None;
+        }
+        self.linkable_host(&row.device_id)
+    }
+
+    /// `host`, when it's another of the person's computers this one may
+    /// reach (crate::direct_peer) and it takes chat links: what a link or a
+    /// direct hint goes to.
+    pub(super) fn linkable_host(&self, host: &str) -> Option<String> {
+        self.workspace()?
+            .reachable_peers()
+            .into_iter()
+            .find(|device| device.id == host && device.supports(zeron_proto::capabilities::CHAT_LINK_V1))
+            .map(|device| device.id)
+    }
+
+    /// One link to `target`, until it ends. `Ok`: it was up a while, or this
+    /// device stopped wanting it; `Err`: it never came up, or died at once.
+    async fn run_chat_link(
+        &self,
+        chat: &str,
+        target: &str,
+        relay: &RelayHandle,
+        handle: &Weak<ChatDocHandle>,
+    ) -> Result<(), String> {
+        let roads = self.roads().ok_or("no roads to other devices")?;
+        let road = roads
+            .proven(target, ROAD_PATIENCE)
+            .await
+            .ok_or("no direct road to the host")?;
+        let me = self.inner.config.device_id.clone();
+        let opened = road.client.subscribe_checked(
+            methods::WATCH_CHAT_LINK,
+            serde_json::json!({ "chatId": chat, "device": me }),
+        );
+        let mut items = tokio::time::timeout(ACCEPT_WAIT * 2, opened)
+            .await
+            .map_err(|_| "the host didn't answer".to_string())?
+            .map_err(|e| format!("the host refused: {e}"))?;
+        let (id, mut frames) = relay.link_up(target);
+        let began = Instant::now();
+        tracing::info!(chat = %chat, device = %target, road = road.name(), "chat link up");
+
+        // The host's frames: straight into the relay, never awaiting anything
+        // slow, or they'd hold up every other call on this road.
+        let read = async {
+            loop {
+                match tokio::time::timeout(LINK_DEAD, items.recv()).await {
+                    Ok(Some(item)) => {
+                        if let Some(frame) = item["f"].as_str()
+                            && let Ok(bytes) = b64().decode(frame)
+                        {
+                            relay.link_frame(target, &bytes);
+                        }
+                    }
+                    Ok(None) => return LinkEnd::HostEnded,
+                    Err(_) => return LinkEnd::WentQuiet,
+                }
+            }
+        };
+        // This device's frames, in order: one call at a time. Quiet, an empty
+        // call is the keepalive that tells the host the link is still there.
+        let write = async {
+            let mut batch = Vec::with_capacity(SEND_BATCH);
+            loop {
+                let waited = tokio::time::timeout(LINK_PROBE, frames.recv_many(&mut batch, SEND_BATCH)).await;
+                if matches!(waited, Ok(0)) {
+                    return LinkEnd::RelayEnded;
+                }
+                let sent: Vec<String> = batch.drain(..).map(|frame| b64().encode(frame)).collect();
+                let call = road.client.call(
+                    methods::SEND_CHAT_FRAMES,
+                    serde_json::json!({ "chatId": chat, "device": me, "frames": sent }),
+                );
+                match tokio::time::timeout(SEND_TIMEOUT, call).await {
+                    Ok(Ok(_)) => {}
+                    Ok(Err(_)) => return LinkEnd::FramesRefused,
+                    Err(_) => return LinkEnd::WentQuiet,
+                }
+            }
+        };
+        let wanted = async {
+            loop {
+                tokio::time::sleep(WANT_POLL).await;
+                if self.chat_link_target(handle).as_deref() != Some(target) {
+                    return LinkEnd::NotWanted;
+                }
+            }
+        };
+        let why = tokio::select! {
+            why = read => why,
+            why = write => why,
+            why = wanted => why,
+        };
+        drop(items);
+        relay.link_down(target, id);
+        tracing::info!(chat = %chat, device = %target, road = road.name(), why = why.why(), "chat link down");
+        if why == LinkEnd::WentQuiet {
+            roads.suspect(target, road.kind);
+        }
+        if began.elapsed() >= LINK_DEAD || why == LinkEnd::NotWanted {
+            Ok(())
+        } else {
+            Err(why.why().to_owned())
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn held(slots: &Slots, links: &[(&str, &str)]) -> Vec<Slot> {
+        links
+            .iter()
+            .map(|(chat, device)| slots.reserve(chat, device, false).expect("room for it"))
+            .collect()
+    }
+
+    #[test]
+    fn one_device_holds_at_most_its_share_of_chat_links() {
+        let slots = Slots::default();
+        let chats: Vec<String> = (0..LINKS_PER_DEVICE).map(|i| format!("chat-{i}")).collect();
+        let _laptop = held(&slots, &chats.iter().map(|c| (c.as_str(), "laptop")).collect::<Vec<_>>());
+        assert!(slots.reserve("chat-more", "laptop", false).is_err(), "past its share");
+        assert!(slots.reserve("chat-0", "laptop", false).is_ok(), "replacing its own link");
+        assert!(slots.reserve("chat-more", "desktop", false).is_ok(), "another device still links");
+    }
+
+    #[test]
+    fn a_chat_takes_so_many_links_and_the_host_so_many_in_all() {
+        let slots = Slots::default();
+        let devices: Vec<String> = (0..LINKS_PER_CHAT).map(|i| format!("device-{i}")).collect();
+        let _one_chat = held(&slots, &devices.iter().map(|d| ("chat", d.as_str())).collect::<Vec<_>>());
+        assert!(slots.reserve("chat", "device-more", false).is_err(), "past the chat's links");
+
+        let slots = Slots::default();
+        let mut links = Vec::new();
+        for device in 0..LINKS_IN_ALL / LINKS_PER_DEVICE {
+            for chat in 0..LINKS_PER_DEVICE {
+                let chat = format!("chat-{chat}-{device}");
+                links.push(slots.reserve(&chat, &format!("device-{device}"), false).expect("room"));
+            }
+        }
+        assert_eq!(links.len(), LINKS_IN_ALL);
+        assert!(slots.reserve("chat-new", "device-new", false).is_err(), "past the host's links");
+        drop(links.pop());
+        assert!(
+            slots.reserve("chat-new", "device-new", false).is_ok(),
+            "a link that ended gives its slot back"
+        );
+    }
+
+    #[test]
+    fn a_link_opens_a_cold_chat_only_while_links_hold_few_chats_whoever_opened_them() {
+        let slots = Slots::default();
+        let held: Vec<Slot> = (0..LINKED_CHATS)
+            .map(|i| slots.reserve(&format!("chat-{i}"), &format!("device-{}", i % 2), false).expect("room"))
+            .collect();
+        assert!(slots.reserve("chat-cold", "device-2", true).is_err(), "no cold chat opened");
+        assert!(slots.reserve("chat-warm", "device-2", false).is_ok(), "an open chat still links");
+        assert!(slots.reserve("chat-0", "device-2", true).is_ok(), "a chat links already hold");
+        drop(held);
+        assert!(slots.reserve("chat-cold", "device-2", true).is_ok());
+    }
+}
diff --git a/crates/engine/src/doc_host/direct_hints.rs b/crates/engine/src/doc_host/direct_hints.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b2862526c4ffa241f252e472fed797e2121a3d5e
--- /dev/null
+++ b/crates/engine/src/doc_host/direct_hints.rs
@@ -0,0 +1,257 @@
+//! A viewer's sends and wakes, straight to the chat's host over the direct
+//! road as well as through the edge.
+//!
+//! When another of the person's computers hosts a chat and takes chat links
+//! ([`zeron_proto::capabilities::CHAT_LINK_V1`]), a send or steer queued here
+//! also goes to it directly, once: the wake as [`methods::WAKE_CHAT`], the
+//! command as [`methods::RELAY_COMMAND`]. Both are hints. The command still
+//! goes into the chat and to the ChatRoom's queue (queued, then delivered),
+//! and the edge's wake still goes as the backup; nothing here waits for, or
+//! settles, either. The host runs each command id once whichever way it
+//! comes (its processed ledger), so a send arriving both ways runs once. A
+//! copy never overtakes an earlier send of this device's that hasn't reached
+//! the host: that one and those behind it go the usual way, in order.
+//!
+//! Hints go only on a road that isn't the relay and that proved this device
+//! ([`crate::direct_rpc::Roads::direct`]); with none up, nothing goes and the
+//! send takes the edge alone, as before. A hint that fails is logged and not
+//! retried on another road.
+
+use std::collections::VecDeque;
+use std::future::Future;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use serde::Deserialize;
+use zeron_doc::{SessionCommandEntry, SessionCommandPayload, SessionCommandStatus};
+use zeron_rpc::{Caller, RpcError, RpcReply, methods, parse_params};
+
+use super::{DocHost, lock};
+use crate::direct_rpc::{Road, Roads};
+
+/// How long a hint waits for a pairing under way before it isn't sent.
+const HINT_PATIENCE: Duration = Duration::from_millis(1500);
+/// How long the host may take to take a wake.
+const WAKE_TIMEOUT: Duration = Duration::from_secs(2);
+/// How long the host may take to take a command (opening a cold chat first).
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(20);
+/// Command ids [`Taken`] keeps.
+const TAKEN_KEPT: usize = 256;
+
+/// Command ids whose host took a direct copy lately, newest last: an earlier
+/// send in this list doesn't hold a later one's copy back while the host's
+/// word on it is on its way back.
+#[derive(Default)]
+pub(super) struct Taken(Mutex<VecDeque<String>>);
+
+impl Taken {
+    fn note(&self, command: &str) {
+        let mut taken = lock(&self.0);
+        if taken.len() >= TAKEN_KEPT {
+            taken.pop_front();
+        }
+        taken.push_back(command.to_owned());
+    }
+
+    fn has(&self, command: &str) -> bool {
+        lock(&self.0).iter().any(|id| id == command)
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WakeParams {
+    chat_id: String,
+}
+
+impl DocHost {
+    /// Host side of [`methods::WAKE_CHAT`]: a device that queued work in a
+    /// chat hosted here says so directly. Admitted as the edge's nudge is.
+    pub(crate) fn wake_chat(&self, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        let p: WakeParams = parse_params(params)?;
+        // Another of the person's computers, proven, as for a chat link.
+        let from = self.link_peer(None)?;
+        let row = self
+            .workspace()
+            .and_then(|ws| ws.chat(&p.chat_id).ok().flatten())
+            .ok_or_else(|| RpcError::Failed("no such chat here".into()))?;
+        if row.device_id != self.inner.config.device_id {
+            return Err(RpcError::Failed("this device doesn't host that chat".into()));
+        }
+        self.enqueue_wakeup(&p.chat_id)
+            .map_err(|e| RpcError::Failed(e.to_string()))?;
+        tracing::info!(chat = %p.chat_id, device = %from, "chat woken directly");
+        RpcReply::value(&serde_json::json!({ "admitted": true }))
+    }
+
+    /// Whether a command this device queued in `chat` before `command` still
+    /// waits for its host (pending, not expired) and its host didn't take a
+    /// direct copy of it. Unreadable: as if one did.
+    fn earlier_still_waiting(&self, chat: &str, command: &str) -> bool {
+        let Ok(handle) = self.open(chat) else {
+            return true;
+        };
+        let Ok(commands) = handle.doc.read_commands() else {
+            return true;
+        };
+        let Some(at) = commands.iter().position(|c| c.id == command) else {
+            return true;
+        };
+        let now = crate::now_ms();
+        let me = &self.inner.config.device_id;
+        commands[..at].iter().any(|c| {
+            &c.issued_by == me
+                && c.status == SessionCommandStatus::Pending
+                && c.effective_expiry() > now
+                && !self.inner.direct.taken.has(&c.id)
+        })
+    }
+
+    /// `chat`'s host, when it's another of the person's computers and takes
+    /// chat links: what a direct hint goes to.
+    fn hinted_host_of(&self, chat: &str) -> Option<String> {
+        self.linkable_host(&self.remote_host_for(chat)?)
+    }
+
+    /// Host side of [`methods::RELAY_COMMAND`], before the chat is opened:
+    /// from a caller whose device is known (the edge's stamp or a direct
+    /// link's proof), only that device's own commands; and never for a chat
+    /// whose row names another host (a host behind on a chat being moved to
+    /// it refuses until its list catches up: the old host, which still has
+    /// the room's row, would run the command too).
+    pub(crate) fn admit_relayed_command(&self, chat: &str, entry: &SessionCommandEntry) -> Result<(), RpcError> {
+        if let Caller::Peer { device: Some(device) } = zeron_rpc::caller()
+            && entry.issued_by != device
+        {
+            return Err(RpcError::Failed("a device relays its own commands only".into()));
+        }
+        let host = self.workspace().and_then(|ws| ws.chat(chat).ok().flatten()).map(|row| row.device_id);
+        if host.is_some_and(|host| host != self.inner.config.device_id) {
+            return Err(RpcError::Failed("this device doesn't host that chat".into()));
+        }
+        Ok(())
+    }
+
+    /// Tell `chat`'s host directly that the chat has new work, beside the
+    /// edge's wake. Returns at once.
+    pub(super) fn wake_host_directly(&self, chat: &str) {
+        let Some(target) = self.hinted_host_of(chat) else {
+            return;
+        };
+        let what = Hint {
+            chat: chat.to_owned(),
+            target,
+            command: None,
+        };
+        self.hint(what, WAKE_TIMEOUT, |client, chat| async move {
+            client.call(methods::WAKE_CHAT, serde_json::json!({ "chatId": chat })).await
+        });
+    }
+
+    /// Send `entry` (a send or steer queued in `chat`, hosted on `target`)
+    /// to the host directly, once, beside the chat and its delivery escort.
+    /// Returns at once.
+    ///
+    /// Not while an earlier command of this device's in the chat still
+    /// waits for the host and didn't go this way: the copy would overtake
+    /// it, and the host runs sends in the order they reach it. The chat
+    /// carries this one behind it, in order, as before.
+    pub(super) fn send_command_directly(&self, target: &str, chat: &str, entry: &SessionCommandEntry) {
+        if !matches!(
+            entry.payload,
+            SessionCommandPayload::Run { .. } | SessionCommandPayload::Steer { .. }
+        ) || self.hinted_host_of(chat).as_deref() != Some(target)
+        {
+            return;
+        }
+        let params = serde_json::json!({ "chatId": chat, "entry": entry });
+        let what = Hint {
+            chat: chat.to_owned(),
+            target: target.to_owned(),
+            command: Some(entry.id.clone()),
+        };
+        self.hint(what, COMMAND_TIMEOUT, move |client, _| async move {
+            client.call(methods::RELAY_COMMAND, params).await
+        });
+    }
+
+    /// Send one hint (`call` on a direct road to its target) in the
+    /// background, once, and log how it went. A command's copy doesn't go
+    /// while an earlier send of this device's in the chat still waits for
+    /// the host ([`Self::earlier_still_waiting`]). Not without a runtime or
+    /// roads.
+    fn hint<F, Fut>(&self, what: Hint, timeout: Duration, call: F)
+    where
+        F: FnOnce(std::sync::Arc<zeron_rpc::RpcClient>, String) -> Fut + Send + 'static,
+        Fut: Future<Output = Result<serde_json::Value, RpcError>> + Send,
+    {
+        let Ok(runtime) = tokio::runtime::Handle::try_current() else {
+            return;
+        };
+        let Some(roads) = self.roads() else { return };
+        let host = self.clone();
+        self.spawn_worker_on(&runtime, async move {
+            let Hint { chat, target, command } = &what;
+            let kind = if command.is_some() { "command" } else { "wake" };
+            if let Some(command) = command
+                && host.earlier_still_waiting(chat, command)
+            {
+                tracing::debug!(chat = %chat, device = %target, %command,
+                    "an earlier send hasn't reached the host yet; the chat carries this one behind it");
+                return;
+            }
+            let Some(road) = roads.proven(target, HINT_PATIENCE).await else {
+                tracing::debug!(chat = %chat, device = %target, kind,
+                    "no direct road for a hint; the edge carries it alone");
+                return;
+            };
+            let outcome = tokio::time::timeout(timeout, call(road.client.clone(), chat.clone())).await;
+            host.hinted(&roads, &road, &what, outcome);
+        });
+    }
+
+    /// Log how hint `what` went on `road`, and mark the road suspect when it
+    /// failed for want of the road.
+    fn hinted(
+        &self,
+        roads: &Roads,
+        road: &Road,
+        what: &Hint,
+        outcome: Result<Result<serde_json::Value, RpcError>, tokio::time::error::Elapsed>,
+    ) {
+        let Hint { chat, target, command } = what;
+        let road_name = road.name();
+        match (outcome, command) {
+            (Ok(Ok(_)), None) => {
+                tracing::info!(chat = %chat, device = %target, road = road_name, "chat's host woken directly");
+            }
+            (Ok(Ok(reply)), Some(command)) => {
+                let outcome = reply.get("outcome").and_then(|v| v.as_str()).unwrap_or("accepted").to_owned();
+                self.inner.direct.taken.note(command);
+                tracing::info!(chat = %chat, device = %target, road = road_name, %command, outcome,
+                    "command sent to its host directly");
+            }
+            (Ok(Err(RpcError::Failed(why))), _) => {
+                tracing::info!(chat = %chat, device = %target, road = road_name, command = ?command, %why,
+                    "the chat's host refused a direct hint; the edge carries it");
+            }
+            (Ok(Err(err)), _) => {
+                roads.suspect(target, road.kind);
+                tracing::info!(chat = %chat, device = %target, road = road_name, command = ?command, %err,
+                    "a direct hint failed; the edge carries it");
+            }
+            (Err(_), _) => {
+                roads.suspect(target, road.kind);
+                tracing::info!(chat = %chat, device = %target, road = road_name, command = ?command,
+                    "a direct hint went unanswered; the edge carries it");
+            }
+        }
+    }
+}
+
+/// One hint to a chat's host: a wake, or a command's copy (`command`, its id).
+struct Hint {
+    chat: String,
+    target: String,
+    command: Option<String>,
+}
