+//
+// A link is whatever carries one device's frames to another besides the room
+// (the engine's runs over an RPC stream). Here: a byte pipe, length-prefixed,
+// with the same keepalive the engine's has, driving the handle's link API.
+
+const LINK_PROBE: Duration = Duration::from_secs(3);
+const LINK_DEAD: Duration = Duration::from_secs(8);
+
+/// Carry `relay`'s frames for `peer` over `io` until it dies, goes silent or
+/// `stop` fires.
+async fn run_link<I>(io: I, peer: String, relay: RelayHandle, stop: CancellationToken)
+where
+    I: tokio::io::AsyncRead + tokio::io::AsyncWrite + Send + Unpin + 'static,
+{
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let (mut reader, mut writer) = tokio::io::split(io);
+    let (id, mut rx) = relay.link_up(&peer);
+    let write = async {
+        let probe = wire::encode(frame_type::PROBE, &json!({}), &[]);
+        let mut beat = tokio::time::interval(LINK_PROBE);
+        loop {
+            let frame = tokio::select! {
+                frame = rx.recv() => match frame {
+                    Some(frame) => frame,
+                    None => return,
+                },
+                _ = beat.tick() => probe.clone(),
+            };
+            let len = (frame.len() as u32).to_le_bytes();
+            if writer.write_all(&len).await.is_err() || writer.write_all(&frame).await.is_err() {
+                return;
+            }
+        }
+    };
+    let read = async {
+        loop {
+            let mut len = [0u8; 4];
+            if !matches!(tokio::time::timeout(LINK_DEAD, reader.read_exact(&mut len)).await, Ok(Ok(_))) {
+                return;
+            }
+            let mut bytes = vec![0u8; u32::from_le_bytes(len) as usize];
+            if reader.read_exact(&mut bytes).await.is_err() {
+                return;
+            }
+            relay.link_frame(&peer, &bytes);
+        }
+    };
+    tokio::select! {
+        _ = stop.cancelled() => {}
+        _ = write => {}
+        _ = read => {}
+    }
+    relay.link_down(&peer, id);
+}
+
+fn link(a: &Device, b: &Device) -> (CancellationToken, CancellationToken) {
+    let (one, two) = tokio::io::duplex(1024 * 1024);
+    let (stop_a, stop_b) = (CancellationToken::new(), CancellationToken::new());
+    tokio::spawn(run_link(one, b.name.clone(), a.relay.clone(), stop_a.clone()));
+    tokio::spawn(run_link(two, a.name.clone(), b.relay.clone(), stop_b.clone()));
+    (stop_a, stop_b)
+}
