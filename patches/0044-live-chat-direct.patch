+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_peer_that_doesnt_host_the_chat_refuses_the_link_and_the_chat_room_carries_it() {
+    let _serial = serial().await;
+    let engines = Engines::start("catchup-nochat").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-catchup-nochat";
+    // The chat's host is a third computer, C, that A would take a link to.
+    // A's direct road reaches B whatever device it's for, and B doesn't host
+    // the chat: B refuses the link, as a peer without the chat does.
+    let c_id = format!("{}-c", engines.a_id.trim_end_matches("-a"));
+    engines.a.workspace.upsert_device_row(&direct::direct_device_row(&c_id));
+    engines
+        .b
+        .workspace
+        .create_chat(chat, None, Some(&c_id), None, None)
+        .expect("create chat hosted on C");
+    engines.b.workspace.rename_chat(chat, "Pre-titled").expect("pre-title");
+    engines
+        .b
+        .workspace
+        .set_chat_room_gen(chat, zeron_proto::relay_gen::RELAY_ROOM_GEN)
+        .expect("relayed chat");
+    wait_until(Duration::from_secs(20), "A's list has the chat, hosted on C", || {
+        engines.a.workspace.chat(chat).ok().flatten().is_some_and(|row| {
+            row.device_id == c_id && row.room_gen == Some(zeron_proto::relay_gen::RELAY_ROOM_GEN)
+        })
+    })
+    .await;
+    let on_b = engines.b.doc_host.open(chat).expect("open on B");
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+    // A's road meant for C reaches B, which can't prove it's C: the link
+    // proves nothing (direct_rpc::prove checks who answered), so A asks
+    // nobody for a chat link over it. Asked anyway, B refuses
+    // (a_caller_that_didnt_prove_its_device_gets_no_chat_link_nor_wake).
+    wait_until(Duration::from_secs(20), "both are in the chat's room", || {
+        on_b.connected() && viewing.connected()
+    })
+    .await;
+
+    // B writes in the chat; A gets it through the room as quickly as it
+    // would with no link at all.
+    let at = chrono::Utc::now().timestamp_millis();
+    on_b.write_user_message("note-from-b", "written on B", at).expect("write on B");
+    let written = tokio::time::Instant::now();
+    wait_until(ROAD_TIMEOUT, "B's note reaches A through the room", || {
+        entries(&engines.a, chat).iter().any(|e| e.id == "note-from-b")
+    })
+    .await;
+    eprintln!("reached A through the room in {:?}", written.elapsed());
+    assert!(logs::find("chat link up", &[("chat", chat)]).is_empty(), "B never took the link");
+    assert_eq!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK), 0);
+
+    drop(_view);
+    engines.shutdown().await;
+}
