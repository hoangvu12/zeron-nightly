+//! Live chat over the direct link between two of the person's devices: a
+//! reply streaming on the host reaches a device viewing the chat over the
+//! direct link as well as through the ChatRoom, and the viewer's sends,
+//! steers and wakes reach the host directly. The room still gets every frame
+//! and stays the record; the direct copy is a second path only.
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+
+use std::collections::HashSet;
+use std::time::Duration;
+
+use engines::{Engines, entries, replies, reply_to, send, serial, text_of, wait_until};
+use zeron_doc::{MessageRole, SessionCommandPayload};
+use zeron_engine::EngineCore;
+use zeron_rpc::methods;
+
+/// `chat`'s transcript on `core`, as JSON, for comparing whole.
+fn transcript(core: &EngineCore, chat: &str) -> serde_json::Value {
+    serde_json::to_value(entries(core, chat)).expect("entries as json")
+}
+
+/// How far `core` has read `chat`'s stored rows from the ChatRoom.
+fn row_cursor(core: &EngineCore, chat: &str) -> u64 {
+    core.doc_host
+        .sync_statuses()
+        .into_iter()
+        .find(|(id, _)| id == chat)
+        .and_then(|(_, stats)| stats)
+        .map_or(0, |stats| stats.cursor)
+}
+
+/// Store a row in `chat`'s room from another device, as a stored-mode
+/// writer's push does: `bytes` broadcast to every socket, as a `row`.
+async fn store_row(engines: &Engines, chat: &str, batch: &str, bytes: Vec<u8>) {
+    let url = format!(
+        "{}/chat2/{chat}/rows?batchId={batch}&device={}-c",
+        engines.edge.url(),
+        engines.a_id.trim_end_matches("-a")
+    );
+    let response = reqwest::Client::new()
+        .post(url)
+        .header("authorization", "Bearer test")
+        .body(bytes)
+        .send()
+        .await
+        .expect("post a row");
+    assert!(response.status().is_success(), "{}", response.status());
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_reply_reaches_the_viewer_over_the_direct_link_while_the_chat_room_holds_it_back() {
+    let _serial = serial().await;
+    let engines = Engines::start("direct-reply").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-direct-reply";
+    engines.chat_hosted_on_b(chat).await;
+    // A has the chat on screen.
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+    // The viewer's log names the link and the road it took.
+    logs::wait_for_line(
+        "chat link up",
+        &[("chat", chat), ("device", engines.b_id.as_str()), ("road", "direct")],
+        Duration::from_secs(30),
+    )
+    .await;
+    assert!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK) >= 1);
+    let cursor = row_cursor(&engines.a, chat);
+
+    // The room holds back everything it sends A. The next reply reaches A
+    // whole all the same, over the link, and A's transcript is B's.
+    engines.edge.hold_to(&engines.a_id);
+    send(&engines.a, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "A's transcript matches B's while the room holds", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("two")]
+            && transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert!(engines.edge.held_to(&engines.a_id) > 0, "the room got the frames too, and held them");
+    assert_eq!(row_cursor(&engines.a, chat), cursor, "direct frames never move the row cursor");
+
+    // The room's copies arrive late: one copy of each, in order.
+    engines.edge.release_to(&engines.a_id);
+    wait_until(Duration::from_secs(15), "the room's held frames reach A", || {
+        engines.edge.held_to(&engines.a_id) == 0
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(transcript(&engines.a, chat), transcript(&engines.b, chat));
+    assert_eq!(replies(&engines.a, chat), [reply_to("one"), reply_to("two")]);
+    let ids: Vec<String> = entries(&engines.a, chat).into_iter().map(|e| e.id).collect();
+    assert_eq!(ids.iter().collect::<HashSet<_>>().len(), ids.len(), "one copy of each: {ids:?}");
+    let b_ids: Vec<String> = entries(&engines.b, chat).into_iter().map(|e| e.id).collect();
+    assert_eq!(ids, b_ids, "in B's order");
+    assert_eq!(row_cursor(&engines.a, chat), cursor, "nor do the relayed copies");
+
+    // A stored row from the ChatRoom is what moves it.
+    let known = engines
+        .b
+        .doc_host
+        .open(chat)
+        .expect("open on B")
+        .doc()
+        .doc()
+        .export(loro::ExportMode::all_updates())
+        .expect("export");
+    store_row(&engines, chat, "row-from-the-room", known).await;
+    wait_until(Duration::from_secs(15), "a row from the room moves A's cursor", || {
+        row_cursor(&engines.a, chat) > cursor
+    })
+    .await;
+    assert_eq!(transcript(&engines.a, chat), transcript(&engines.b, chat));
+
+    // The link goes: the room carries the next reply, as before.
+    pairing.cut().await;
+    logs::wait_for_line(
+        "chat link down",
+        &[("chat", chat), ("device", engines.b_id.as_str())],
+        Duration::from_secs(30),
+    )
+    .await;
+    send(&engines.a, chat, "three", "msg-three").await;
+    wait_until(Duration::from_secs(30), "the reply to three reaches A through the room", || {
+        replies(&engines.a, chat) == [reply_to("one"), reply_to("two"), reply_to("three")]
+    })
+    .await;
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_no_direct_link_a_reply_takes_the_chat_room_alone_as_before() {
+    let _serial = serial().await;
+    let engines = Engines::start("direct-none").await;
+    // Paired both ways, but the pairing never comes up.
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    let chat = "chat-direct-none";
+    engines.chat_hosted_on_b(chat).await;
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+
+    // Held at the room, the next reply doesn't reach A at all.
+    engines.edge.hold_to(&engines.a_id);
+    send(&engines.a, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "B finishes the reply to two", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("two")]
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(replies(&engines.a, chat), [reply_to("one")], "nothing of two reached A while held");
+
+    engines.edge.release_to(&engines.a_id);
+    wait_until(Duration::from_secs(15), "A's transcript matches B's", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK), 0);
+    assert_eq!(pairing.a_to_b.came_direct(methods::SEND_CHAT_FRAMES), 0);
+    assert!(logs::find("chat link up", &[("chat", chat)]).is_empty());
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+/// Queue `payload` in `chat` from `core`, as the app does.
+async fn queue(core: &EngineCore, chat: &str, payload: SessionCommandPayload) {
+    let command = serde_json::to_value(payload).expect("command json");
+    zeron_rpc::memory_client(core.rpc_service())
+        .call(
+            methods::QUEUE_COMMAND,
+            serde_json::json!({ "chatId": chat, "command": command }),
+        )
+        .await
+        .expect("queue the command");
+}
+
+/// Whether `core` has `chat` open.
+fn open_on(core: &EngineCore, chat: &str) -> bool {
+    core.doc_host.sync_statuses().iter().any(|(id, _)| id == chat)
+}
+
+/// The user's messages in `chat` on `core` whose text is `text`.
+fn user_messages(core: &EngineCore, chat: &str, text: &str) -> usize {
+    entries(core, chat)
+        .iter()
+        .filter(|e| e.role == MessageRole::User && text_of(e) == text)
+        .count()
+}
+
+/// A has B's chat on screen (for as long as the third value lives), with
+/// its chat link up, after a first send and its reply.
+async fn viewing_with_a_link(
+    name: &str,
+    chat: &str,
+) -> (Engines, direct::DirectPairing, Box<dyn std::any::Any + Send>) {
+    let engines = Engines::start(name).await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    engines.chat_hosted_on_b(chat).await;
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let view = viewing.watch_messages();
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+    logs::wait_for_line(
+        "chat link up",
+        &[("chat", chat), ("device", engines.b_id.as_str())],
+        Duration::from_secs(30),
+    )
+    .await;
+    (engines, pairing, Box::new((viewing, view)))
+}
+
+/// The ChatRoom's leg to B released: the room has A's sends since `before`
+/// queued, and B confirms each delivered. Then the send of `prompt`
+/// (message `message_id`) ran on B once: one user message, B's replies are
+/// `replies_now`, and the same command handed to B again is a duplicate.
+async fn released_and_ran_once(
+    engines: &Engines,
+    chat: &str,
+    before: &HashSet<String>,
+    prompt: &str,
+    message_id: &str,
+    replies_now: &[String],
+) {
+    let sent: Vec<String> = engines
+        .edge
+        .enqueued(chat)
+        .into_iter()
+        .filter(|batch| !before.contains(batch))
+        .filter(|batch| engines.edge.enqueued_by(chat, batch).as_deref() == Some(engines.a_id.as_str()))
+        .collect();
+    assert!(!sent.is_empty(), "the ChatRoom has the send queued");
+    engines.edge.release_to(&engines.b_id);
+    engines.edge.hold_nudges(false);
+    wait_until(Duration::from_secs(30), "B confirms the send delivered to the ChatRoom", || {
+        let delivered = engines.edge.delivered(chat);
+        sent.iter().all(|batch| delivered.contains(batch))
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    assert_eq!(replies(&engines.b, chat), replies_now, "one turn for the send");
+    assert_eq!(user_messages(&engines.b, chat, prompt), 1, "one message for the send");
+
+    // The same command once more, handed to B over A's road as the escort's
+    // relay or a direct copy would: B answers it's a duplicate, and runs
+    // nothing.
+    let command = engines
+        .b
+        .doc_host
+        .open(chat)
+        .expect("open on B")
+        .doc()
+        .read_commands()
+        .expect("B's commands")
+        .into_iter()
+        .find(|c| match &c.payload {
+            SessionCommandPayload::Run { message_id: id, .. } => id == message_id,
+            SessionCommandPayload::Steer { message_id: id, .. } => id.as_deref() == Some(message_id),
+            _ => false,
+        })
+        .expect("the command reached B's doc");
+    let road = engines
+        .a
+        .roads()
+        .expect("roads")
+        .client(&engines.b_id)
+        .await
+        .expect("a road to B");
+    let again = road
+        .client
+        .call(methods::RELAY_COMMAND, serde_json::json!({ "chatId": chat, "entry": command }))
+        .await
+        .expect("handed over again");
+    assert_eq!(again["outcome"], "duplicate");
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(replies(&engines.b, chat), replies_now);
+    wait_until(Duration::from_secs(15), "A's transcript matches B's", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_send_starts_the_hosts_turn_directly_while_the_chat_room_holds_it_back() {
+    let _serial = serial().await;
+    let chat = "chat-direct-send";
+    let (engines, pairing, _view) = viewing_with_a_link("direct-send", chat).await;
+    let relayed = pairing.a_to_b.came_direct(methods::RELAY_COMMAND);
+
+    // The room holds back everything it sends B, and the edge's wakes wait.
+    let before: HashSet<String> = engines.edge.enqueued(chat).into_iter().collect();
+    engines.edge.hold_to(&engines.b_id);
+    engines.edge.hold_nudges(true);
+    send(&engines.a, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "B runs the send while the room holds it", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("two")]
+    })
+    .await;
+    assert!(pairing.a_to_b.came_direct(methods::RELAY_COMMAND) > relayed, "a copy went direct");
+    logs::wait_for_line(
+        "command sent to its host directly",
+        &[("chat", chat), ("device", engines.b_id.as_str()), ("road", "direct")],
+        Duration::from_secs(10),
+    )
+    .await;
+
+    released_and_ran_once(&engines, chat, &before, "two", "msg-two", &[reply_to("one"), reply_to("two")]).await;
+    drop(_view);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_steer_reaches_the_host_directly_and_runs_once() {
+    let _serial = serial().await;
+    let chat = "chat-direct-steer";
+    let (engines, pairing, _view) = viewing_with_a_link("direct-steer", chat).await;
+    let relayed = pairing.a_to_b.came_direct(methods::RELAY_COMMAND);
+
+    let before: HashSet<String> = engines.edge.enqueued(chat).into_iter().collect();
+    engines.edge.hold_to(&engines.b_id);
+    engines.edge.hold_nudges(true);
+    queue(
+        &engines.a,
+        chat,
+        SessionCommandPayload::Steer {
+            prompt: "steered".into(),
+            message_id: Some("msg-steered".into()),
+        },
+    )
+    .await;
+    wait_until(Duration::from_secs(30), "B runs the steer while the room holds it", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("steered")]
+    })
+    .await;
+    assert!(pairing.a_to_b.came_direct(methods::RELAY_COMMAND) > relayed, "a copy went direct");
+
+    released_and_ran_once(
+        &engines,
+        chat,
+        &before,
+        "steered",
+        "msg-steered",
+        &[reply_to("one"), reply_to("steered")],
+    )
+    .await;
+    drop(_view);
+    engines.shutdown().await;
+}
+
+/// The send's doc op alone crossing the chat link (no direct copy of the
+/// command, no wake): it runs on the host through the command ledger, before
+/// the room's queued copy and only once, and the room's copy is what
+/// confirms the queue row.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_send_that_crosses_the_chat_link_alone_runs_once_through_the_command_ledger() {
+    let _serial = serial().await;
+    let chat = "chat-direct-link-only";
+    let (engines, pairing, _view) = viewing_with_a_link("direct-link-only", chat).await;
+    let relayed = pairing.a_to_b.came_direct(methods::RELAY_COMMAND);
+    let woken = pairing.a_to_b.came_direct(methods::WAKE_CHAT);
+
+    let before: HashSet<String> = engines.edge.enqueued(chat).into_iter().collect();
+    engines.edge.hold_to(&engines.b_id);
+    engines.edge.hold_nudges(true);
+    // Written straight into A's copy of the chat, as a send's command is, but
+    // with nothing sent beside it: only the chat's own frames carry it.
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let now = chrono::Utc::now().timestamp_millis();
+    viewing
+        .doc()
+        .queue_command(&zeron_doc::SessionCommandEntry {
+            id: "cmd-by-link".into(),
+            payload: SessionCommandPayload::Steer {
+                prompt: "by-link".into(),
+                message_id: Some("msg-by-link".into()),
+            },
+            issued_by: engines.a_id.clone(),
+            issued_at: now,
+            based_on: None,
+            expires_at: None,
+            status: zeron_doc::SessionCommandStatus::Pending,
+            resolution: None,
+        })
+        .expect("queue on A");
+    wait_until(Duration::from_secs(30), "B runs the send off the link while the room holds it", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("by-link")]
+    })
+    .await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::RELAY_COMMAND), relayed, "no copy of the command");
+    assert_eq!(pairing.a_to_b.came_direct(methods::WAKE_CHAT), woken, "no wake");
+    assert!(pairing.a_to_b.came_direct(methods::SEND_CHAT_FRAMES) >= 1);
+    // Running it off the link confirmed nothing: the room's queue still waits
+    // for its own copy to reach B.
+    assert!(
+        engines.edge.delivered(chat).iter().all(|batch| before.contains(batch)),
+        "the link's copy confirms nothing in the room's queue"
+    );
+
+    released_and_ran_once(
+        &engines,
+        chat,
+        &before,
+        "by-link",
+        "msg-by-link",
+        &[reply_to("one"), reply_to("by-link")],
+    )
+    .await;
+    drop(_view);
+    engines.shutdown().await;
+}
+
+/// The direct wake alone: B refuses the command's direct copy and the edge's
+/// wake waits, so only the wake can make B open the chat, where the ChatRoom
+/// hands it the send.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_send_to_a_cold_chat_wakes_its_host_directly() {
+    let _serial = serial().await;
+    let engines = Engines::start("direct-cold").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    pairing.a_to_b.refuse(methods::RELAY_COMMAND);
+    let chat = "chat-direct-cold";
+    engines.chat_hosted_on_b(chat).await;
+    // B hasn't the chat open: nothing in it yet, so nothing lost.
+    if open_on(&engines.b, chat) {
+        engines.b.doc_host.purge_chat(chat);
+    }
+    assert!(!open_on(&engines.b, chat), "cold on B");
+
+    // The edge's wake waits. A sends without the chat on screen: no chat
+    // link either.
+    engines.edge.hold_nudges(true);
+    send(&engines.a, chat, "cold", "msg-cold").await;
+    wait_until(Duration::from_secs(30), "B wakes and runs the send", || {
+        replies(&engines.b, chat) == [reply_to("cold")]
+    })
+    .await;
+    assert!(pairing.a_to_b.came_direct(methods::WAKE_CHAT) >= 1, "woken directly");
+    assert_eq!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK), 0);
+    logs::wait_for_line(
+        "the chat's host refused a direct hint; the edge carries it",
+        &[("chat", chat), ("device", engines.b_id.as_str())],
+        Duration::from_secs(10),
+    )
+    .await;
+    logs::wait_for_line(
+        "chat's host woken directly",
+        &[("chat", chat), ("device", engines.b_id.as_str()), ("road", "direct")],
+        Duration::from_secs(10),
+    )
+    .await;
+    // The edge's wake went too, as the backup.
+    wait_until(Duration::from_secs(15), "the edge was asked to wake B too", || {
+        engines.edge.nudges(chat) >= 1
+    })
+    .await;
+
+    engines.edge.hold_nudges(false);
+    wait_until(Duration::from_secs(30), "A's transcript matches B's", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert_eq!(replies(&engines.b, chat), [reply_to("cold")], "one turn for the send");
+    engines.shutdown().await;
+}
+
+/// A chat hosted on B, relayed, made on B alone.
+fn relayed_on_b(engines: &Engines, chat: &str) {
+    let b = &engines.b.workspace;
+    b.create_chat(chat, None, Some(&engines.b_id), None, None).expect("create chat on B");
+    b.rename_chat(chat, "Pre-titled").expect("pre-title");
+    b.set_chat_room_gen(chat, zeron_proto::relay_gen::RELAY_ROOM_GEN).expect("relayed chat");
+}
+
+/// One device asking for links to more cold chats at once than it may hold
+/// gets no more than its share, and a chat whose link was refused isn't
+/// opened.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn one_device_gets_at_most_its_share_of_chat_links_and_a_refused_one_opens_nothing() {
+    let _serial = serial().await;
+    let engines = Engines::start("direct-caps").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    const SHARE: usize = 8;
+    let chats: Vec<String> = (0..SHARE + 2).map(|i| format!("chat-direct-caps-{i}")).collect();
+    for chat in &chats {
+        relayed_on_b(&engines, chat);
+        if open_on(&engines.b, chat) {
+            engines.b.doc_host.purge_chat(chat);
+        }
+    }
+    let road = engines
+        .a
+        .roads()
+        .expect("roads")
+        .client(&engines.b_id)
+        .await
+        .expect("a road to B");
+    assert!(!road.is_relay(), "A's proven link to B");
+
+    // All at once: none has linked yet when the others ask.
+    let asks = chats.iter().map(|chat| {
+        road.client.subscribe_checked(
+            methods::WATCH_CHAT_LINK,
+            serde_json::json!({ "chatId": chat, "device": engines.a_id }),
+        )
+    });
+    let answers = tokio::time::timeout(Duration::from_secs(30), futures::future::join_all(asks))
+        .await
+        .expect("B answers every ask");
+    let mut links = Vec::new();
+    let mut refused = Vec::new();
+    for (chat, answer) in chats.iter().zip(answers) {
+        match answer {
+            Ok(link) => links.push(link),
+            Err(error) => refused.push((chat.clone(), error.to_string())),
+        }
+    }
+    assert!(links.len() <= SHARE, "{} links for one device", links.len());
+    assert!(
+        refused.iter().any(|(_, why)| why.contains("as many")),
+        "refused for the caps: {refused:?}"
+    );
+    for (chat, why) in &refused {
+        if why.contains("as many") {
+            assert!(!open_on(&engines.b, chat), "{chat} opened for a refused link");
+        }
+    }
+    drop(links);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_caller_that_didnt_prove_its_device_gets_no_chat_link_nor_wake() {
+    let _serial = serial().await;
+    let engines = Engines::start("direct-unproven").await;
+    // A direct link both ways, that never proves which device calls.
+    let pairing = direct::pair_unproven(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-direct-unproven";
+    engines.chat_hosted_on_b(chat).await;
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+
+    // The chat works through the room, and nothing of it goes direct.
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(3)).await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK), 0);
+    assert_eq!(pairing.a_to_b.came_direct(methods::WAKE_CHAT), 0);
+    assert!(logs::find("chat link up", &[("chat", chat)]).is_empty());
+
+    // Called anyway over that link, each is refused, whichever device it names.
+    let road = engines
+        .a
+        .roads()
+        .expect("roads")
+        .client(&engines.b_id)
+        .await
+        .expect("a road to B");
+    assert_eq!(road.kind, zeron_engine::direct_rpc::RoadKind::WebRtc, "the unproven direct link");
+    for device in [engines.a_id.as_str(), engines.b_id.as_str()] {
+        let watch = road
+            .client
+            .subscribe_checked(
+                methods::WATCH_CHAT_LINK,
+                serde_json::json!({ "chatId": chat, "device": device }),
+            )
+            .await;
+        assert!(watch.is_err(), "no chat link for an unproven caller naming {device}");
+        let frames = road
+            .client
+            .call(
+                methods::SEND_CHAT_FRAMES,
+                serde_json::json!({ "chatId": chat, "device": device, "frames": [] }),
+            )
+            .await;
+        assert!(frames.is_err(), "no frames from an unproven caller naming {device}");
+    }
+    let wake = road
+        .client
+        .call(methods::WAKE_CHAT, serde_json::json!({ "chatId": chat }))
+        .await;
+    assert!(wake.is_err(), "no wake from an unproven caller");
+
+    // Nor by the relay, which never carries them.
+    let relay = engines
+        .a
+        .roads()
+        .expect("roads")
+        .by_relay(&engines.b_id)
+        .await
+        .expect("the relay to B");
+    let watch = relay
+        .client
+        .subscribe_checked(
+            methods::WATCH_CHAT_LINK,
+            serde_json::json!({ "chatId": chat, "device": engines.a_id }),
+        )
+        .await;
+    assert!(watch.is_err(), "no chat link by the relay");
+    let wake = relay
+        .client
+        .call(methods::WAKE_CHAT, serde_json::json!({ "chatId": chat }))
+        .await;
+    assert!(wake.is_err(), "no wake by the relay");
+    let other = relay.client.call(methods::LIST_HARNESSES, serde_json::json!({})).await;
+    assert!(other.is_ok(), "the relay itself works: {other:?}");
+
+    // Nor from this device's own app or agents.
+    let local = zeron_rpc::memory_client(engines.b.rpc_service());
+    let watch = local
+        .subscribe_checked(
+            methods::WATCH_CHAT_LINK,
+            serde_json::json!({ "chatId": chat, "device": engines.a_id }),
+        )
+        .await;
+    assert!(watch.is_err(), "no chat link for a local caller");
+    let wake = local
+        .call(methods::WAKE_CHAT, serde_json::json!({ "chatId": chat }))
+        .await;
+    assert!(wake.is_err(), "no wake from a local caller");
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+/// A retry escorts every send still waiting in the chat, another device's
+/// too. With the edge down, A asks B once for the phone's send; B, which
+/// takes a device's own commands only, refuses, and A leaves it to the chat
+/// instead of asking again until it expires.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_retry_asks_the_host_once_for_another_devices_send_and_leaves_it_to_the_chat() {
+    let _serial = serial().await;
+    let chat = "chat-direct-theirs";
+    let (engines, pairing, _view) = viewing_with_a_link("direct-theirs", chat).await;
+    engines.gate.cut();
+    wait_until(Duration::from_secs(30), "A's chat lost its room", || {
+        engines
+            .a
+            .doc_host
+            .sync_statuses()
+            .into_iter()
+            .find(|(id, _)| id == chat)
+            .and_then(|(_, stats)| stats)
+            .is_some_and(|stats| !stats.connected)
+    })
+    .await;
+
+    // The phone's steer, which reached A's copy of the chat and not B's.
+    let theirs = zeron_doc::SessionCommandEntry {
+        id: "cmd-from-the-phone".into(),
+        payload: SessionCommandPayload::Steer {
+            prompt: "from the phone".into(),
+            message_id: Some("msg-from-the-phone".into()),
+        },
+        issued_by: "direct-theirs-phone".into(),
+        issued_at: chrono::Utc::now().timestamp_millis(),
+        based_on: None,
+        expires_at: None,
+        status: zeron_doc::SessionCommandStatus::Pending,
+        resolution: None,
+    };
+    engines
+        .a
+        .doc_host
+        .open(chat)
+        .expect("open on A")
+        .doc()
+        .queue_command(&theirs)
+        .expect("the phone's steer on A");
+    let asked = pairing.a_to_b.came_direct(methods::RELAY_COMMAND);
+    engines.a.doc_host.retry_delivery(chat).expect("retry on A");
+
+    logs::wait_for_line(
+        "peer-relay delivery stopped: the host takes another device's command from the chat",
+        &[("chat", chat), ("command", "cmd-from-the-phone")],
+        Duration::from_secs(30),
+    )
+    .await;
+    // Past the escort's next try: B was asked, refused, and wasn't asked
+    // again (every refusal is a retry warning). The chat itself (here its
+    // link, the room being down) carries the steer to B: it runs there once.
+    assert!(pairing.a_to_b.came_direct(methods::RELAY_COMMAND) > asked, "B was asked");
+    tokio::time::sleep(Duration::from_secs(7)).await;
+    let retried = logs::find("peer-relay delivery retrying", &[("chat", chat)]);
+    assert!(retried.is_empty(), "asked again: {retried:?}");
+    assert!(user_messages(&engines.b, chat, "from the phone") <= 1, "run once at most");
+
+    drop(_view);
+    engines.shutdown().await;
+}
diff --git a/crates/engine/tests/support/direct.rs b/crates/engine/tests/support/direct.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1c135f5c86b15e19df5e189e857e98fc11bda053
--- /dev/null
+++ b/crates/engine/tests/support/direct.rs
@@ -0,0 +1,283 @@
+//! A stand-in for the WebRTC pairing, both ways between two engines.
+//!
+//! Based on `DirectRig` / `direct_pair` in `device_routing.rs` (which keeps
+//! its own copy). [`DirectRig`] is one direction: while up, a stream the
+//! caller opens reaches the far engine's real direct RPC host
+//! (`direct_rpc::Service`, with its guard); `cut` drops every open link, as a
+//! lost connection does. [`pair_both_ways`] wires A→B and B→A, so list sync
+//! and chat links can run in either direction.
+//!
+//! Each link proves its caller's device as it opens (Phase A's signed hello,
+//! against the caller's own key), so the far end serves it as
+//! `Caller::Peer{device: Some(..)}`, as the real direct link between two of
+//! the person's signed-in computers does. [`pair_unproven`] leaves that out:
+//! the far end serves the caller as `Caller::Peer{device: None}`. `proven.rs`
+//! pairs the same rigs against the account's keys instead.
+//!
+//! [`DirectWay::refuse`] makes the far end refuse a method over the link, so
+//! a test can take one path away.
+
+#![allow(dead_code)]
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use zeron_engine::EngineCore;
+use zeron_engine::device_proof::{self, Claim, Refused, Verifier};
+use zeron_engine::direct_rpc;
+use zeron_engine::plugins::keys::KeyRow;
+use zeron_rpc::{RpcError, RpcReply, RpcService};
+
+/// What reached an engine over its direct link, by method.
+pub type Seen = Arc<Mutex<Vec<String>>>;
+
+/// Methods the far end refuses over a link.
+pub type RefusedMethods = Arc<Mutex<Vec<String>>>;
+
+/// An engine's service as its direct link serves it, noting each call that
+/// came that way, and refusing the methods in `refused`.
+pub struct NotedDirect {
+    pub inner: Arc<dyn RpcService>,
+    pub seen: Seen,
+    pub refused: RefusedMethods,
+}
+
+#[async_trait]
+impl RpcService for NotedDirect {
+    async fn handle(&self, method: &str, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        self.seen.lock().unwrap().push(method.to_owned());
+        if self.refused.lock().unwrap().iter().any(|m| m == method) {
+            return Err(RpcError::Failed(format!("{method} refused by the test")));
+        }
+        self.inner.handle(method, params).await
+    }
+}
+
+/// How many `method` calls came over the direct link.
+pub fn came_direct(seen: &Seen, method: &str) -> usize {
+    seen.lock().unwrap().iter().filter(|m| m.as_str() == method).count()
+}
+
+/// One direction of the stand-in pairing: `caller` opens, the far engine serves.
+pub struct DirectRig {
+    caller: String,
+    up: AtomicBool,
+    far: direct_rpc::Service,
+    pipes: Mutex<Vec<tokio::task::JoinHandle<()>>>,
+}
+
+impl DirectRig {
+    /// Streams from `caller` reach `far`'s real direct RPC host. Down at first.
+    pub fn new(caller: &str, far: &Arc<dyn RpcService>) -> Arc<Self> {
+        Self::over(caller, direct_rpc::Service::new(far))
+    }
+
+    /// Streams from `caller` reach `far`, a direct RPC host as built. Down at first.
+    pub fn over(caller: &str, far: direct_rpc::Service) -> Arc<Self> {
+        Arc::new(Self {
+            caller: caller.to_owned(),
+            up: AtomicBool::new(false),
+            far,
+            pipes: Mutex::new(Vec::new()),
+        })
+    }
+
+    pub fn set_up(&self) {
+        self.up.store(true, Ordering::SeqCst);
+    }
+
+    pub fn is_up(&self) -> bool {
+        self.up.load(Ordering::SeqCst)
+    }
+
+    /// Down, and every open link dropped.
+    pub async fn cut(&self) {
+        self.up.store(false, Ordering::SeqCst);
+        for pipe in self.pipes.lock().unwrap().drain(..) {
+            pipe.abort();
+        }
+        // Let the far ends read the close.
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    }
+}
+
+#[async_trait]
+impl direct_rpc::Pairing for DirectRig {
+    async fn ready(&self, _device: &str) -> bool {
+        self.is_up()
+    }
+
+    fn warm(&self, _device: &str) {}
+
+    async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        use zeron_preview::mux::Connector as _;
+        anyhow::ensure!(self.is_up(), "not paired");
+        let (near, mut pipe) = tokio::io::duplex(1024 * 1024);
+        let mut far = self.far.connect_from(Some(&self.caller), direct_rpc::SERVICE).await?;
+        let task = tokio::spawn(async move {
+            let _ = tokio::io::copy_bidirectional(&mut far, &mut pipe).await;
+        });
+        self.pipes.lock().unwrap().push(task);
+        Ok(Box::new(near))
+    }
+}
+
+/// A row for `device` as its peers' registries list it: this build's
+/// version and capabilities, plus the chat relay, direct RPC and chat links,
+/// as an engine on a person's own computer advertises them.
+pub fn direct_device_row(device: &str) -> zeron_proto::Device {
+    let mut capabilities = zeron_proto::capabilities::current();
+    capabilities.push(zeron_proto::relay_gen::CHAT_RELAY_CAPABILITY.to_owned());
+    capabilities.push(zeron_proto::capabilities::DIRECT_RPC_V1.to_owned());
+    capabilities.push(zeron_proto::capabilities::CHAT_LINK_V1.to_owned());
+    zeron_proto::Device {
+        id: device.into(),
+        name: format!("{device}-name"),
+        platform: "linux".into(),
+        last_seen_at: Some(chrono::Utc::now()),
+        created_at: None,
+        version: Some(env!("CARGO_PKG_VERSION").into()),
+        cursor_sdk_version: None,
+        capabilities,
+    }
+}
+
+/// One direction of a two-way pairing.
+pub struct DirectWay {
+    /// The rig the calling engine's calls take.
+    pub rig: Arc<DirectRig>,
+    /// Calls that reached the far engine over it.
+    pub seen: Seen,
+    refused: RefusedMethods,
+    /// Keeps the far engine's served service alive (the host holds it weakly).
+    _service: Arc<dyn RpcService>,
+}
+
+impl DirectWay {
+    pub fn came_direct(&self, method: &str) -> usize {
+        came_direct(&self.seen, method)
+    }
+
+    /// The far end refuses `method` over this way from now on.
+    pub fn refuse(&self, method: &str) {
+        self.refused.lock().unwrap().push(method.to_owned());
+    }
+}
+
+/// Stand-in direct links both ways between two engines.
+pub struct DirectPairing {
+    pub a_to_b: DirectWay,
+    pub b_to_a: DirectWay,
+}
+
+impl DirectPairing {
+    pub fn set_up(&self) {
+        self.a_to_b.rig.set_up();
+        self.b_to_a.rig.set_up();
+    }
+
+    pub async fn cut(&self) {
+        self.a_to_b.rig.cut().await;
+        self.b_to_a.rig.cut().await;
+    }
+}
+
+/// How a link proves its caller's device to the far end.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Proof {
+    /// It doesn't: the far end serves an unverified peer.
+    None,
+    /// With the caller's own key, which the far end takes as the account's.
+    CallerKey,
+    /// Against the far engine's own copy of the account's keys (its real
+    /// verifier: `proven.rs`).
+    AccountKeys,
+}
+
+/// Stand-in direct links both ways between `a` and `b`, down until
+/// `set_up`, each proving its caller's device as it opens. Each engine gets
+/// the other's row with direct RPC, and its rig as its direct links. The
+/// roads are wired once each engine's relay links are set (`set_links`,
+/// before or after this); build RPC clients after both.
+pub fn pair_both_ways(a: &EngineCore, b: &EngineCore) -> DirectPairing {
+    list_each_other(a, b);
+    pair(a, b, Proof::CallerKey)
+}
+
+/// [`pair_both_ways`], but no link proves its caller's device: each far end
+/// serves its caller as an unverified peer (`Caller::Peer{device: None}`).
+pub fn pair_unproven(a: &EngineCore, b: &EngineCore) -> DirectPairing {
+    list_each_other(a, b);
+    pair(a, b, Proof::None)
+}
+
+/// Each engine gets the other's row with direct RPC and chat links.
+fn list_each_other(a: &EngineCore, b: &EngineCore) {
+    a.workspace.upsert_device_row(&direct_device_row(b.workspace.device_id()));
+    b.workspace.upsert_device_row(&direct_device_row(a.workspace.device_id()));
+}
+
+/// Direct links both ways between `a` and `b`, proving callers by `proof`,
+/// down until `set_up`: each engine's rig is its direct links.
+pub fn pair(a: &EngineCore, b: &EngineCore, proof: Proof) -> DirectPairing {
+    DirectPairing {
+        a_to_b: way(a, b, proof),
+        b_to_a: way(b, a, proof),
+    }
+}
+
+/// `device`'s key row for `key`, as the account lists it.
+pub fn key_row(device: &str, key: String) -> KeyRow {
+    KeyRow {
+        key,
+        fingerprint: String::new(),
+        device_id: device.to_owned(),
+        created_at: 1,
+        revoked_at: None,
+    }
+}
+
+/// The account's keys as a far end checks a link's proof against them:
+/// the caller's alone.
+struct CallerKey(Vec<KeyRow>);
+
+#[async_trait]
+impl Verifier for CallerKey {
+    async fn verify(&self, claim: &Claim, host: &str, link: &str) -> Result<String, Refused> {
+        device_proof::check(claim, host, link, device_proof::now_ms(), &self.0)
+    }
+}
+
+/// `from`'s rig to `to`, and what reaches `to` over it, its caller proven by
+/// `proof`.
+fn way(from: &EngineCore, to: &EngineCore, proof: Proof) -> DirectWay {
+    let seen = Seen::default();
+    let refused = RefusedMethods::default();
+    let service: Arc<dyn RpcService> = Arc::new(NotedDirect {
+        inner: to.rpc_service(),
+        seen: seen.clone(),
+        refused: refused.clone(),
+    });
+    let caller = from.workspace.device_id().to_owned();
+    let far = direct_rpc::Service::new(&service);
+    let host = to.workspace.device_id();
+    let far = match proof {
+        Proof::None => far,
+        Proof::CallerKey => {
+            // The caller's public key, as its own proof names it.
+            let proof = (from.plugins.device_link_prover())("key", "key", 0).expect("the caller has a signing key");
+            far.proving(host, Arc::new(CallerKey(vec![key_row(&caller, proof.key)])))
+        }
+        Proof::AccountKeys => far.proving(host, to.plugins.device_verifier()),
+    };
+    let rig = DirectRig::over(&caller, far);
+    from.set_direct_links(direct_rpc::Links::over(rig.clone()));
+    DirectWay {
+        rig,
+        seen,
+        refused,
+        _service: service,
+    }
+}
diff --git a/crates/engine/tests/support/edge.rs b/crates/engine/tests/support/edge.rs
new file mode 100644
index 0000000000000000000000000000000000000000..46156b0e9096179cef560cd77477a8a65c57844c
--- /dev/null
+++ b/crates/engine/tests/support/edge.rs
@@ -0,0 +1,945 @@
+//! A fake edge for two real engines on one port, with a relay-era ChatRoom.
+//!
+//! Derived from the phone client's `crates/client/tests/support/mock_edge.rs`
+//! (kept separate so upstream changes there never touch these tests). One
+//! TCP port routes like the Worker:
+//!
+//! - `/registry/{org}/ws` → proxied to zeron-sync's `MockRegistryServer`
+//!   ([`FakeEdge::registry`]: take it down, hold its pushes), and its plain
+//!   `GET …/rows` and `POST …/push`, which engines use beside the socket;
+//! - `/chat2/{chat}/ws` → a relay-layer ChatRoom (generation 3): hello/state,
+//!   rows (`rowsReq`/`row`/`rowsDone`, `push`/`ack`), probe, `relay` and
+//!   `announce` to every other socket of the chat, `syncReq`/`syncData` by
+//!   `to`, and the queue (`enqueue` → `queued` to the sender and a queued
+//!   `relay` copy to the others, `queueReq`, `delivered`);
+//! - `/device/{id}/ws` → the DeviceRoom relay (client → host with `from`
+//!   stamped, host → client by `to`, `hostOffline` bounces);
+//! - `POST /device/{id}/nudge` → recorded, and handed to that device's host
+//!   socket as a `nudge` frame (as the DeviceRoom does), or kept while
+//!   [`FakeEdge::hold_nudges`] is on;
+//! - plain `GET /chat2/{chat}/rows|checkpoint` and `POST /chat2/{chat}/rows`.
+//!   Anything else gets a 404 or a closed connection.
+//!
+//! Per device, [`FakeEdge::hold_to`] keeps back what the ChatRoom sends that
+//! device's sockets (relayed frames, announces, sync frames, row broadcasts,
+//! queue answers) until [`FakeEdge::release_to`], which sends them on in
+//! order. Answers that keep a socket alive (`state`, `probeOk`, `queued`,
+//! `ack`, `rowsReq` answers, pongs) always pass, so a held socket isn't
+//! mistaken for a dead one. To cut the whole edge, put a `Gate` in front of
+//! [`FakeEdge::addr`].
+
+#![allow(dead_code)]
+// tungstenite fixes the handshake callback's Err type as a full Response.
+#![allow(clippy::result_large_err)]
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::net::SocketAddr;
+use std::sync::{Arc, Mutex};
+
+use futures::{SinkExt, StreamExt};
+use serde_json::json;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+use tokio::sync::{broadcast, mpsc, watch};
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::handshake::server::{Request, Response};
+use zeron_sync::chat_frames::{self, frame_type};
+use zeron_sync::registry::mock_server::MockRegistryServer;
+
+#[derive(Clone, Debug)]
+pub struct Row {
+    pub seq: u64,
+    pub device: String,
+    pub batch_id: String,
+    pub bytes: Vec<u8>,
+}
+
+#[derive(Default)]
+struct Room {
+    rows: Vec<Row>,
+    batches: HashMap<String, u64>,
+    /// The relay layer's queue: viewers' sends the host hasn't confirmed.
+    queue: Vec<Row>,
+    /// Every batch ever enqueued, in order (duplicates once): (batch id, device).
+    enqueued: Vec<(String, String)>,
+    /// Every batch id a host confirmed with `delivered`, in order.
+    delivered: Vec<String>,
+}
+
+/// A frame for other sockets in a room. Never stored.
+#[derive(Clone)]
+struct RelayOut {
+    chat: String,
+    from: String,
+    to: Option<String>,
+    frame: Vec<u8>,
+}
+
+struct Shared {
+    registry: Arc<MockRegistryServer>,
+    rooms: Mutex<HashMap<String, Room>>,
+    /// (chat, row) broadcasts to every socket of the chat.
+    tx: broadcast::Sender<(String, Row)>,
+    relay_tx: broadcast::Sender<RelayOut>,
+    /// Chat sockets currently open, per chat.
+    sockets: Mutex<HashMap<String, usize>>,
+    /// Devices whose chat frames are held back.
+    holds: watch::Sender<HashSet<String>>,
+    /// Frames currently held back, per device.
+    held: Mutex<HashMap<String, usize>>,
+    relays: Mutex<HashMap<String, RelayState>>,
+    /// `(target device, chat)` of every nudge asked for.
+    nudges: Mutex<Vec<(String, String)>>,
+    /// While set, nudges are answered but wait here, not handed to the host.
+    hold_nudges: Mutex<bool>,
+    /// Nudges waiting while held: (target device, chat).
+    held_nudges: Mutex<Vec<(String, String)>>,
+}
+
+#[derive(Default)]
+struct RelayState {
+    host: Option<mpsc::UnboundedSender<Out>>,
+    clients: HashMap<String, mpsc::UnboundedSender<Out>>,
+}
+
+enum Out {
+    Frame(Vec<u8>),
+    Close,
+}
+
+pub struct FakeEdge {
+    pub registry: Arc<MockRegistryServer>,
+    addr: SocketAddr,
+    shared: Arc<Shared>,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl FakeEdge {
+    pub async fn start() -> Self {
+        let registry = Arc::new(MockRegistryServer::start().await);
+        let registry_url = registry.url();
+        let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind edge");
+        let addr = listener.local_addr().expect("edge addr");
+        let shared = Arc::new(Shared {
+            registry: registry.clone(),
+            rooms: Mutex::new(HashMap::new()),
+            tx: broadcast::channel(4096).0,
+            relay_tx: broadcast::channel(4096).0,
+            sockets: Mutex::new(HashMap::new()),
+            holds: watch::Sender::new(HashSet::new()),
+            held: Mutex::new(HashMap::new()),
+            relays: Mutex::new(HashMap::new()),
+            nudges: Mutex::new(Vec::new()),
+            hold_nudges: Mutex::new(false),
+            held_nudges: Mutex::new(Vec::new()),
+        });
+        let accept_shared = shared.clone();
+        let task = tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    return;
+                };
+                let shared = accept_shared.clone();
+                let registry_url = registry_url.clone();
+                tokio::spawn(serve_connection(stream, shared, registry_url));
+            }
+        });
+        Self {
+            registry,
+            addr,
+            shared,
+            task,
+        }
+    }
+
+    pub fn addr(&self) -> SocketAddr {
+        self.addr
+    }
+
+    /// The edge's own URL (no gate in between).
+    pub fn url(&self) -> String {
+        format!("http://{}", self.addr)
+    }
+
+    /// Hold back what the ChatRoom sends `device`'s sockets, until
+    /// [`Self::release_to`].
+    pub fn hold_to(&self, device: &str) {
+        self.shared.holds.send_modify(|holds| {
+            holds.insert(device.to_owned());
+        });
+    }
+
+    /// Send everything held back for `device` on, in order, and stop holding.
+    pub fn release_to(&self, device: &str) {
+        self.shared.holds.send_modify(|holds| {
+            holds.remove(device);
+        });
+    }
+
+    /// Frames held back for `device` right now.
+    pub fn held_to(&self, device: &str) -> usize {
+        self.shared.held.lock().unwrap().get(device).copied().unwrap_or(0)
+    }
+
+    /// While on, nudges are answered (200) but wait here instead of reaching
+    /// the host: the edge's wake leg held back. Turned off, the waiting ones
+    /// are handed on, in order, to hosts in their device rooms.
+    pub fn hold_nudges(&self, on: bool) {
+        *self.shared.hold_nudges.lock().unwrap() = on;
+        if !on {
+            let waiting = std::mem::take(&mut *self.shared.held_nudges.lock().unwrap());
+            for (device, chat) in waiting {
+                hand_nudge(&self.shared, &device, &chat);
+            }
+        }
+    }
+
+    /// Nudges asked for `chat`, held or not.
+    pub fn nudges(&self, chat: &str) -> usize {
+        self.shared
+            .nudges
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(_, id)| id == chat)
+            .count()
+    }
+
+    /// The rows the room stored for `chat`, in seq order.
+    pub fn rows(&self, chat: &str) -> Vec<Row> {
+        self.room(chat, |r| r.rows.clone())
+    }
+
+    /// Batch ids sitting in `chat`'s queue (enqueued, not yet delivered).
+    pub fn queued(&self, chat: &str) -> Vec<String> {
+        self.room(chat, |r| r.queue.iter().map(|row| row.batch_id.clone()).collect())
+    }
+
+    /// Every batch id ever enqueued to `chat`, in order.
+    pub fn enqueued(&self, chat: &str) -> Vec<String> {
+        self.room(chat, |r| r.enqueued.iter().map(|(batch, _)| batch.clone()).collect())
+    }
+
+    /// The device that enqueued `batch_id` in `chat`.
+    pub fn enqueued_by(&self, chat: &str, batch_id: &str) -> Option<String> {
+        self.room(chat, |r| {
+            r.enqueued
+                .iter()
+                .find(|(batch, _)| batch == batch_id)
+                .map(|(_, device)| device.clone())
+        })
+    }
+
+    /// Every batch id a host confirmed delivered in `chat`, in order.
+    pub fn delivered(&self, chat: &str) -> Vec<String> {
+        self.room(chat, |r| r.delivered.clone())
+    }
+
+    /// Chat sockets open on `chat` right now.
+    pub fn chat_sockets(&self, chat: &str) -> usize {
+        self.shared.sockets.lock().unwrap().get(chat).copied().unwrap_or(0)
+    }
+
+    /// Whether `device`'s host is in its device room.
+    pub fn relay_host_connected(&self, device: &str) -> bool {
+        self.shared
+            .relays
+            .lock()
+            .unwrap()
+            .get(device)
+            .is_some_and(|r| r.host.is_some())
+    }
+
+    fn room<T: Default>(&self, chat: &str, read: impl FnOnce(&Room) -> T) -> T {
+        self.shared.rooms.lock().unwrap().get(chat).map(read).unwrap_or_default()
+    }
+}
+
+impl Drop for FakeEdge {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+type Ws = tokio_tungstenite::WebSocketStream<tokio::net::TcpStream>;
+
+async fn serve_connection(mut stream: tokio::net::TcpStream, shared: Arc<Shared>, registry_url: String) {
+    let mut peek = [0u8; 2048];
+    let Ok(n) = stream.peek(&mut peek).await else {
+        return;
+    };
+    let head = String::from_utf8_lossy(&peek[..n]).to_ascii_lowercase();
+    if head.starts_with("get ") && !head.contains("upgrade: websocket") {
+        serve_plain_get(&mut stream, &shared).await;
+        return;
+    }
+    if head.starts_with("head ") {
+        let _ = stream
+            .write_all(b"HTTP/1.1 404 Test\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+            .await;
+        return;
+    }
+    if head.starts_with("post ") || head.starts_with("put ") {
+        serve_post(&mut stream, &shared).await;
+        return;
+    }
+    let path = Arc::new(Mutex::new(String::new()));
+    let seen = path.clone();
+    let callback = move |request: &Request, response: Response| {
+        *seen.lock().unwrap() = request.uri().to_string();
+        Ok(response)
+    };
+    let Ok(ws) = tokio_tungstenite::accept_hdr_async(stream, callback).await else {
+        return;
+    };
+    let uri = path.lock().unwrap().clone();
+    let (path, query) = uri.split_once('?').unwrap_or((uri.as_str(), ""));
+    let query: HashMap<String, String> = query
+        .split('&')
+        .filter_map(|kv| kv.split_once('='))
+        .map(|(k, v)| (k.to_owned(), v.to_owned()))
+        .collect();
+    let parts: Vec<&str> = path.trim_matches('/').split('/').collect();
+    match parts.as_slice() {
+        ["device", device, "ws"] => serve_relay(ws, device.to_string(), query, shared).await,
+        ["registry", _, "ws"] => proxy(ws, &registry_url).await,
+        ["chat2", chat, "ws"] => serve_chat(ws, chat.to_string(), shared).await,
+        _ => {}
+    }
+}
+
+async fn proxy(client: Ws, upstream: &str) {
+    let Ok((server, _)) = tokio_tungstenite::connect_async(upstream).await else {
+        return;
+    };
+    let (mut client_tx, mut client_rx) = client.split();
+    let (mut server_tx, mut server_rx) = server.split();
+    let up = async {
+        while let Some(Ok(message)) = client_rx.next().await {
+            if server_tx.send(message).await.is_err() {
+                return;
+            }
+        }
+        let _ = server_tx.close().await;
+    };
+    let down = async {
+        while let Some(Ok(message)) = server_rx.next().await {
+            if client_tx.send(message).await.is_err() {
+                return;
+            }
+        }
+        let _ = client_tx.close().await;
+    };
+    tokio::select! {
+        _ = up => {}
+        _ = down => {}
+    }
+}
+
+fn reply(status: u16, body: &[u8]) -> Vec<u8> {
+    let mut out = format!(
+        "HTTP/1.1 {status} Test\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+        body.len()
+    )
+    .into_bytes();
+    out.extend_from_slice(body);
+    out
+}
+
+/// `GET /chat2/{id}/rows` and `/checkpoint` (there is never a checkpoint);
+/// anything else is a 404.
+async fn serve_plain_get(stream: &mut tokio::net::TcpStream, shared: &Shared) {
+    let mut buf = [0u8; 4096];
+    let Ok(n) = stream.read(&mut buf).await else {
+        return;
+    };
+    let line = String::from_utf8_lossy(&buf[..n]);
+    let target = line.split_whitespace().nth(1).unwrap_or_default().to_owned();
+    let (path, query) = target.split_once('?').unwrap_or((target.as_str(), ""));
+    let parts: Vec<&str> = path.trim_matches('/').split('/').collect();
+    let param = |name: &str| {
+        query
+            .split('&')
+            .find_map(|kv| kv.strip_prefix(&format!("{name}=")[..]))
+            .unwrap_or_default()
+            .to_owned()
+    };
+    let (status, body) = match parts.as_slice() {
+        ["registry", _, "rows"] => {
+            let since = param("since").parse().unwrap_or(0);
+            let (status, body) = shared.registry.http_rows(&param("device"), since, param("beat") == "1");
+            (status, body.into_bytes())
+        }
+        ["chat2", chat, "rows"] => {
+            let after = query
+                .split('&')
+                .find_map(|kv| kv.strip_prefix("after="))
+                .and_then(|v| v.parse::<u64>().ok())
+                .unwrap_or(0);
+            let (head_seq, rows) = {
+                let rooms = shared.rooms.lock().unwrap();
+                let room = rooms.get(*chat);
+                (
+                    room.map_or(0, |r| r.rows.len() as u64),
+                    room.map(|r| r.rows.iter().filter(|row| row.seq > after).cloned().collect::<Vec<_>>())
+                        .unwrap_or_default(),
+                )
+            };
+            let mut frames = vec![state_frame(head_seq)];
+            frames.extend(rows.iter().map(row_frame));
+            frames.push(chat_frames::encode(frame_type::ROWS_DONE, &json!({ "headSeq": head_seq }), &[]));
+            let mut body = Vec::new();
+            for frame in frames {
+                body.extend_from_slice(&(frame.len() as u32).to_le_bytes());
+                body.extend_from_slice(&frame);
+            }
+            (200, body)
+        }
+        _ => (404, Vec::new()),
+    };
+    let _ = stream.write_all(&reply(status, &body)).await;
+}
+
+/// `POST /device/{id}/nudge` and `POST /chat2/{id}/rows`; anything else is a 404.
+async fn serve_post(stream: &mut tokio::net::TcpStream, shared: &Shared) {
+    let mut request = Vec::new();
+    let mut buf = [0u8; 4096];
+    let (headers, body) = loop {
+        let Ok(n) = stream.read(&mut buf).await else {
+            return;
+        };
+        if n == 0 {
+            return;
+        }
+        request.extend_from_slice(&buf[..n]);
+        let Some(end) = request.windows(4).position(|b| b == b"\r\n\r\n") else {
+            continue;
+        };
+        let headers = String::from_utf8_lossy(&request[..end]).into_owned();
+        let length = headers
+            .lines()
+            .find_map(|line| {
+                let (key, value) = line.split_once(':')?;
+                key.eq_ignore_ascii_case("content-length")
+                    .then(|| value.trim().parse::<usize>().ok())
+                    .flatten()
+            })
+            .unwrap_or(0);
+        if request.len() < end + 4 + length {
+            continue;
+        }
+        break (headers, request[end + 4..end + 4 + length].to_vec());
+    };
+    let target = headers
+        .lines()
+        .next()
+        .and_then(|line| line.split_whitespace().nth(1))
+        .unwrap_or_default()
+        .to_owned();
+    let (path, query) = target.split_once('?').unwrap_or((target.as_str(), ""));
+    let parts: Vec<&str> = path.trim_matches('/').split('/').collect();
+    let answer = match parts.as_slice() {
+        ["device", device, "nudge"] => {
+            let chat = serde_json::from_slice::<serde_json::Value>(&body)
+                .ok()
+                .and_then(|v| v["chatId"].as_str().map(str::to_owned));
+            match chat {
+                Some(chat) => {
+                    deliver_nudge(shared, device, &chat);
+                    reply(200, b"{}")
+                }
+                None => reply(400, b"{}"),
+            }
+        }
+        ["chat2", chat, "rows"] => http_push(chat, query, body, shared),
+        ["registry", _, "push"] => {
+            let device = query
+                .split('&')
+                .find_map(|kv| kv.strip_prefix("device="))
+                .unwrap_or_default();
+            let (status, body) = shared
+                .registry
+                .http_push(device, &String::from_utf8_lossy(&body));
+            reply(status, body.as_bytes())
+        }
+        _ => reply(404, b"{}"),
+    };
+    let _ = stream.write_all(&answer).await;
+}
+
+fn deliver_nudge(shared: &Shared, device: &str, chat: &str) {
+    shared
+        .nudges
+        .lock()
+        .unwrap()
+        .push((device.to_owned(), chat.to_owned()));
+    if *shared.hold_nudges.lock().unwrap() {
+        shared
+            .held_nudges
+            .lock()
+            .unwrap()
+            .push((device.to_owned(), chat.to_owned()));
+        return;
+    }
+    hand_nudge(shared, device, chat);
+}
+
+/// A `nudge` frame to `device`'s host socket, if it's in its room.
+fn hand_nudge(shared: &Shared, device: &str, chat: &str) {
+    use zeron_rpc::device_room::NUDGE_KIND;
+    use zeron_rpc::{DeviceFrameHeader, encode_device_frame};
+    let relays = shared.relays.lock().unwrap();
+    if let Some(host) = relays.get(device).and_then(|r| r.host.as_ref()) {
+        let header = DeviceFrameHeader::new(chat, NUDGE_KIND);
+        let payload = json!({ "chatId": chat }).to_string().into_bytes();
+        let _ = host.send(Out::Frame(encode_device_frame(&header, &payload).unwrap()));
+    }
+}
+
+/// `POST /chat2/{id}/rows?batchId=…&device=…`: stored, as the real room stores it.
+fn http_push(chat: &str, query: &str, body: Vec<u8>, shared: &Shared) -> Vec<u8> {
+    let field = |name: &str| {
+        query
+            .split('&')
+            .find_map(|kv| kv.strip_prefix(name))
+            .unwrap_or_default()
+            .to_owned()
+    };
+    let batch = field("batchId=");
+    let device = field("device=");
+    let seq = {
+        let mut rooms = shared.rooms.lock().unwrap();
+        let room = rooms.entry(chat.to_owned()).or_default();
+        match room.batches.get(&batch) {
+            Some(seq) => *seq,
+            None => {
+                let seq = room.rows.len() as u64 + 1;
+                let row = Row { seq, device, batch_id: batch.clone(), bytes: body };
+                room.rows.push(row.clone());
+                room.batches.insert(batch.clone(), seq);
+                let _ = shared.tx.send((chat.to_owned(), row));
+                seq
+            }
+        }
+    };
+    reply(200, json!({ "batchId": batch, "seq": seq, "dup": false }).to_string().as_bytes())
+}
+
+fn state_frame(head_seq: u64) -> Vec<u8> {
+    chat_frames::encode(
+        frame_type::STATE,
+        &json!({
+            "headSeq": head_seq,
+            "seqFloor": 0,
+            "checkpointSeq": 0,
+            "checkpointSize": 0,
+            "rowCount": head_seq,
+            "rowBytes": 0,
+            "relay": 1,
+            "legacyPeers": 0,
+        }),
+        &[],
+    )
+}
+
+fn row_frame(row: &Row) -> Vec<u8> {
+    chat_frames::encode(
+        frame_type::ROW,
+        &json!({ "seq": row.seq, "device": row.device, "batchId": row.batch_id }),
+        &row.bytes,
+    )
+}
+
+/// One chat socket's way out: frames go straight to the socket unless the
+/// room is holding this device's frames, in which case they wait, in order.
+struct Outbox {
+    held: VecDeque<Vec<u8>>,
+    holds: watch::Receiver<HashSet<String>>,
+}
+
+impl Outbox {
+    fn holding(&self, device: &str) -> bool {
+        !device.is_empty() && self.holds.borrow().contains(device)
+    }
+
+    /// Send `frame`, or keep it while `device` is held. False: the socket is gone.
+    async fn send(
+        &mut self,
+        tx: &mut futures::stream::SplitSink<Ws, Message>,
+        shared: &Shared,
+        device: &str,
+        frame: Vec<u8>,
+    ) -> bool {
+        if self.holding(device) {
+            self.held.push_back(frame);
+            *shared.held.lock().unwrap().entry(device.to_owned()).or_default() += 1;
+            return true;
+        }
+        if !self.flush(tx, shared, device).await {
+            return false;
+        }
+        tx.send(Message::Binary(frame)).await.is_ok()
+    }
+
+    /// Everything kept back, in order, once `device` isn't held.
+    async fn flush(
+        &mut self,
+        tx: &mut futures::stream::SplitSink<Ws, Message>,
+        shared: &Shared,
+        device: &str,
+    ) -> bool {
+        if self.holding(device) {
+            return true;
+        }
+        while let Some(frame) = self.held.pop_front() {
+            if let Some(count) = shared.held.lock().unwrap().get_mut(device) {
+                *count = count.saturating_sub(1);
+            }
+            if tx.send(Message::Binary(frame)).await.is_err() {
+                return false;
+            }
+        }
+        true
+    }
+}
+
+async fn serve_chat(ws: Ws, chat: String, shared: Arc<Shared>) {
+    *shared.sockets.lock().unwrap().entry(chat.clone()).or_default() += 1;
+    let (mut tx, mut rx) = ws.split();
+    let mut broadcasts = shared.tx.subscribe();
+    let mut relayed = shared.relay_tx.subscribe();
+    let mut outbox = Outbox {
+        held: VecDeque::new(),
+        holds: shared.holds.subscribe(),
+    };
+    let mut device = String::new();
+    let mut joined = false;
+    loop {
+        tokio::select! {
+            message = rx.next() => {
+                let Some(Ok(message)) = message else { break };
+                let bytes = match message {
+                    Message::Binary(bytes) => bytes.to_vec(),
+                    Message::Text(text) if text.as_str() == "ping" => {
+                        let _ = tx.send(Message::Text("pong".into())).await;
+                        continue;
+                    }
+                    Message::Close(_) => break,
+                    _ => continue,
+                };
+                let Some(frame) = chat_frames::decode(&bytes) else { continue };
+                let head = |shared: &Shared| {
+                    shared.rooms.lock().unwrap().get(&chat).map_or(0, |r| r.rows.len() as u64)
+                };
+                match frame.kind {
+                    frame_type::HELLO => {
+                        device = frame.header["device"].as_str().unwrap_or_default().to_owned();
+                        shared.rooms.lock().unwrap().entry(chat.clone()).or_default();
+                        if tx.send(Message::Binary(state_frame(head(&shared)))).await.is_err() {
+                            break;
+                        }
+                    }
+                    frame_type::ROWS_REQ => {
+                        let after = frame.header["after"].as_u64().unwrap_or(0);
+                        let exclude_own = frame.header["excludeOwn"].as_bool().unwrap_or(false);
+                        let rows: Vec<Row> = shared
+                            .rooms
+                            .lock()
+                            .unwrap()
+                            .get(&chat)
+                            .map(|r| r.rows.iter().filter(|row| row.seq > after).cloned().collect())
+                            .unwrap_or_default();
+                        let head_seq = head(&shared);
+                        let mut failed = false;
+                        for row in rows {
+                            if exclude_own && row.device == device {
+                                continue;
+                            }
+                            if tx.send(Message::Binary(row_frame(&row))).await.is_err() {
+                                failed = true;
+                                break;
+                            }
+                        }
+                        let done = chat_frames::encode(frame_type::ROWS_DONE, &json!({ "headSeq": head_seq }), &[]);
+                        if failed || tx.send(Message::Binary(done)).await.is_err() {
+                            break;
+                        }
+                        joined = true;
+                    }
+                    frame_type::PUSH => {
+                        let batch_id = frame.header["batchId"].as_str().unwrap_or_default().to_owned();
+                        let (seq, dup, row) = {
+                            let mut rooms = shared.rooms.lock().unwrap();
+                            let room = rooms.entry(chat.clone()).or_default();
+                            match room.batches.get(&batch_id) {
+                                Some(seq) => (*seq, true, None),
+                                None => {
+                                    let seq = room.rows.len() as u64 + 1;
+                                    let row = Row {
+                                        seq,
+                                        device: device.clone(),
+                                        batch_id: batch_id.clone(),
+                                        bytes: frame.payload.clone(),
+                                    };
+                                    room.rows.push(row.clone());
+                                    room.batches.insert(batch_id.clone(), seq);
+                                    (seq, false, Some(row))
+                                }
+                            }
+                        };
+                        let ack = chat_frames::encode(
+                            frame_type::ACK,
+                            &json!({ "batchId": batch_id, "seq": seq, "dup": dup }),
+                            &[],
+                        );
+                        if tx.send(Message::Binary(ack)).await.is_err() {
+                            break;
+                        }
+                        if let Some(row) = row {
+                            let _ = shared.tx.send((chat.clone(), row));
+                        }
+                    }
+                    frame_type::PROBE => {
+                        let ok = chat_frames::encode(frame_type::PROBE_OK, &json!({ "headSeq": head(&shared) }), &[]);
+                        if tx.send(Message::Binary(ok)).await.is_err() {
+                            break;
+                        }
+                    }
+                    frame_type::RELAY | frame_type::ANNOUNCE | frame_type::SYNC_REQ | frame_type::SYNC_DATA => {
+                        let mut header = frame.header.clone();
+                        let to = header.get("to").and_then(|v| v.as_str()).map(str::to_owned);
+                        if let Some(map) = header.as_object_mut() {
+                            map.remove("to");
+                            map.insert("device".into(), json!(device));
+                        }
+                        let _ = shared.relay_tx.send(RelayOut {
+                            chat: chat.clone(),
+                            from: device.clone(),
+                            to,
+                            frame: chat_frames::encode(frame.kind, &header, &frame.payload),
+                        });
+                    }
+                    frame_type::ENQUEUE => {
+                        let batch_id = frame.header["batchId"].as_str().unwrap_or_default().to_owned();
+                        let dup = {
+                            let mut rooms = shared.rooms.lock().unwrap();
+                            let room = rooms.entry(chat.clone()).or_default();
+                            let dup = room.enqueued.iter().any(|(batch, _)| *batch == batch_id);
+                            if !dup {
+                                room.enqueued.push((batch_id.clone(), device.clone()));
+                                room.queue.push(Row {
+                                    seq: 0,
+                                    device: device.clone(),
+                                    batch_id: batch_id.clone(),
+                                    bytes: frame.payload.clone(),
+                                });
+                            }
+                            dup
+                        };
+                        if !dup {
+                            let _ = shared.relay_tx.send(RelayOut {
+                                chat: chat.clone(),
+                                from: device.clone(),
+                                to: None,
+                                frame: chat_frames::encode(
+                                    frame_type::RELAY,
+                                    &json!({ "device": device, "queued": true, "batchId": batch_id }),
+                                    &frame.payload,
+                                ),
+                            });
+                        }
+                        let ack = chat_frames::encode(frame_type::QUEUED, &json!({ "batchId": batch_id, "dup": dup }), &[]);
+                        if tx.send(Message::Binary(ack)).await.is_err() {
+                            break;
+                        }
+                    }
+                    frame_type::QUEUE_REQ => {
+                        let rows: Vec<Row> = shared
+                            .rooms
+                            .lock()
+                            .unwrap()
+                            .get(&chat)
+                            .map(|r| r.queue.clone())
+                            .unwrap_or_default();
+                        let count = rows.len();
+                        let mut failed = false;
+                        for row in rows {
+                            let out = chat_frames::encode(
+                                frame_type::RELAY,
+                                &json!({ "device": row.device, "queued": true, "batchId": row.batch_id }),
+                                &row.bytes,
+                            );
+                            if !outbox.send(&mut tx, &shared, &device, out).await {
+                                failed = true;
+                                break;
+                            }
+                        }
+                        let done = chat_frames::encode(frame_type::QUEUE_DONE, &json!({ "count": count }), &[]);
+                        if failed || !outbox.send(&mut tx, &shared, &device, done).await {
+                            break;
+                        }
+                    }
+                    frame_type::DELIVERED => {
+                        let ids: Vec<String> = frame.header["batchIds"]
+                            .as_array()
+                            .map(|list| list.iter().filter_map(|v| v.as_str().map(str::to_owned)).collect())
+                            .unwrap_or_default();
+                        if let Some(room) = shared.rooms.lock().unwrap().get_mut(&chat) {
+                            for id in &ids {
+                                // (A host may confirm a batch it heard twice, twice.)
+                                if room.queue.iter().any(|row| &row.batch_id == id) && !room.delivered.contains(id) {
+                                    room.delivered.push(id.clone());
+                                }
+                            }
+                            room.queue.retain(|row| !ids.contains(&row.batch_id));
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            out = relayed.recv() => {
+                let Ok(out) = out else { continue };
+                if out.chat != chat || device.is_empty() || out.from == device {
+                    continue;
+                }
+                if out.to.as_ref().is_some_and(|to| *to != device) {
+                    continue;
+                }
+                if !outbox.send(&mut tx, &shared, &device, out.frame).await {
+                    break;
+                }
+            }
+            broadcast = broadcasts.recv() => {
+                let Ok((room, row)) = broadcast else { continue };
+                if room != chat || !joined || row.device == device {
+                    continue;
+                }
+                if !outbox.send(&mut tx, &shared, &device, row_frame(&row)).await {
+                    break;
+                }
+            }
+            changed = outbox.holds.changed() => {
+                if changed.is_err() {
+                    break;
+                }
+                if !outbox.flush(&mut tx, &shared, &device).await {
+                    break;
+                }
+            }
+        }
+    }
+    if let Some(count) = shared.held.lock().unwrap().get_mut(&device) {
+        *count = count.saturating_sub(outbox.held.len());
+    }
+    if let Some(count) = shared.sockets.lock().unwrap().get_mut(&chat) {
+        *count = count.saturating_sub(1);
+    }
+}
+
+fn relay_error(code: &str) -> Vec<u8> {
+    json!({ "error": code }).to_string().into_bytes()
+}
+
+/// DeviceRoom semantics (edge/src/device-room.ts), as in zeron-rpc's fake.
+async fn serve_relay(ws: Ws, device: String, query: HashMap<String, String>, shared: Arc<Shared>) {
+    use zeron_rpc::device_room::{CLIENT_CLOSED, CLIENT_GONE, HOST_CLOSED, HOST_OFFLINE, RELAY_KIND};
+    use zeron_rpc::{DeviceFrameHeader, decode_device_frame, encode_device_frame};
+
+    let is_host = query.get("role").map(String::as_str) == Some("host");
+    let conn_id = query.get("connId").cloned().unwrap_or_else(|| "anon".into());
+    let (mut sink, mut stream) = ws.split();
+    let (tx, mut rx) = mpsc::unbounded_channel::<Out>();
+    {
+        let mut relays = shared.relays.lock().unwrap();
+        let st = relays.entry(device.clone()).or_default();
+        if is_host {
+            if let Some(old) = st.host.take() {
+                let _ = old.send(Out::Close);
+            }
+            st.host = Some(tx.clone());
+        } else {
+            st.clients.insert(conn_id.clone(), tx.clone());
+        }
+    }
+    let writer = tokio::spawn(async move {
+        while let Some(out) = rx.recv().await {
+            match out {
+                Out::Frame(bytes) => {
+                    if sink.send(Message::Binary(bytes)).await.is_err() {
+                        break;
+                    }
+                }
+                Out::Close => {
+                    let _ = sink.send(Message::Close(None)).await;
+                    break;
+                }
+            }
+        }
+    });
+    while let Some(message) = stream.next().await {
+        let bytes = match message {
+            Ok(Message::Binary(bytes)) => bytes,
+            Ok(Message::Close(_)) | Err(_) => break,
+            Ok(_) => continue,
+        };
+        let Ok((header, payload)) = decode_device_frame(&bytes) else {
+            break;
+        };
+        let mut relays = shared.relays.lock().unwrap();
+        let st = relays.entry(device.clone()).or_default();
+        if !is_host {
+            match &st.host {
+                Some(host) => {
+                    let mut routed = DeviceFrameHeader::new(header.s, header.k);
+                    routed.from = Some(conn_id.clone());
+                    let _ = host.send(Out::Frame(encode_device_frame(&routed, &payload).unwrap()));
+                }
+                None => {
+                    let bounce = DeviceFrameHeader::new(header.s, RELAY_KIND);
+                    let _ = tx.send(Out::Frame(
+                        encode_device_frame(&bounce, &relay_error(HOST_OFFLINE)).unwrap(),
+                    ));
+                }
+            }
+            continue;
+        }
+        let Some(to) = header.to else { continue };
+        match st.clients.get(&to) {
+            Some(client) => {
+                let stripped = DeviceFrameHeader::new(header.s, header.k);
+                let _ = client.send(Out::Frame(encode_device_frame(&stripped, &payload).unwrap()));
+            }
+            None => {
+                let bounce = DeviceFrameHeader::new(header.s, RELAY_KIND).with_to(to);
+                let _ = tx.send(Out::Frame(
+                    encode_device_frame(&bounce, &relay_error(CLIENT_GONE)).unwrap(),
+                ));
+            }
+        }
+    }
+    {
+        let mut relays = shared.relays.lock().unwrap();
+        let st = relays.entry(device.clone()).or_default();
+        if is_host {
+            if st.host.as_ref().is_some_and(|h| h.same_channel(&tx)) {
+                st.host = None;
+            }
+            for client in st.clients.values() {
+                let header = DeviceFrameHeader::new("", RELAY_KIND);
+                let _ = client.send(Out::Frame(
+                    encode_device_frame(&header, &relay_error(HOST_CLOSED)).unwrap(),
+                ));
+            }
+        } else {
+            st.clients.remove(&conn_id);
+            if let Some(host) = &st.host {
+                let mut header = DeviceFrameHeader::new("", RELAY_KIND);
+                header.from = Some(conn_id.clone());
+                let _ = host.send(Out::Frame(
+                    encode_device_frame(&header, &relay_error(CLIENT_CLOSED)).unwrap(),
+                ));
+            }
+        }
+    }
+    writer.abort();
+}
