@@ -0,0 +1,231 @@
+//! Who may make the calls that only ever go between two of the person's own
+//! computers directly: chat links (`chat_link`), direct wakes
+//! (`direct_hints`) and list changes with presence (`peer_list`,
+//! `peer_presence`). One check for all of them, here.
+//!
+//! A caller passes when it is:
+//! - **proven**: its road proved which device it is (`Caller::Peer{device:
+//!   Some(..)}`: a direct link's signed hello). This device's own app, its
+//!   agents and an unproven link are refused, whatever device they name, and
+//!   a call that names a device must name that one;
+//! - **another device**: not this one;
+//! - **listed**: its row is in the list here, not removed;
+//! - **not revoked**: the account's keys kept here, when there's a copy,
+//!   still hold a key of its that isn't revoked;
+//! - **not a Cloud machine**: by id or by its row's platform;
+//! - **not via the relay**: the relay's host refuses these methods before
+//!   they get here (`zeron_rpc::direct_only`), since the edge carries their
+//!   traffic another way.
+//!
+//! [`may_reach`] is the same test for a device this one sends to or counts
+//! as online, with no call in hand. A link proven before its device was
+//! removed or its key revoked stays open until the road re-checks it (the
+//! road's own business): this check is what keeps such a link from being
+//! heard, counted online or sent the list in the meantime.
+
+use std::sync::{Arc, Mutex};
+
+use zeron_proto::Device;
+use zeron_rpc::{Caller, RpcError};
+
+use crate::plugins::keys::KeyRow;
+use crate::workspace_host::WorkspaceHost;
+
+/// The account's keys as the copy here has them, whatever its age; `None`
+/// with no copy.
+pub type KeyCopy = Arc<dyn Fn() -> Option<Vec<KeyRow>> + Send + Sync>;
+
+/// Where the engine leaves the account's key copy for these checks.
+#[derive(Default)]
+pub(crate) struct PeerKeys(Mutex<Option<KeyCopy>>);
+
+impl PeerKeys {
+    fn copy(&self) -> Option<KeyCopy> {
+        self.0.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).clone()
+    }
+}
+
+fn refused<T>(why: &str) -> Result<T, RpcError> {
+    Err(RpcError::Failed(why.into()))
+}
+
+/// `device` has no key the copy holds unrevoked (`keys`: the copy, if any).
+fn revoked(keys: Option<&[KeyRow]>, device: &str) -> bool {
+    keys.is_some_and(|rows| {
+        !rows
+            .iter()
+            .any(|row| row.device_id == device && row.revoked_at.is_none())
+    })
+}
+
+/// Whether this device (`me`) may send to, or count as online, `device`,
+/// listed here as `listed`: another of the person's computers, not a Cloud
+/// machine, whose key isn't revoked.
+pub(crate) fn may_reach(listed: &Device, me: &str, keys: Option<&[KeyRow]>) -> bool {
+    listed.id != me && !zeron_proto::is_cloud_device(&listed.id, &listed.platform) && !revoked(keys, &listed.id)
+}
+
+/// The device `caller` is, when it may make a direct-only call to this one
+/// (`me`), by the list here (`devices`) and the account's keys (`keys`).
+/// `named`: the device the call says it's from, when it says.
+pub(crate) fn admit(
+    caller: Caller,
+    named: Option<&str>,
+    me: &str,
+    devices: &[Device],
+    keys: Option<&[KeyRow]>,
+) -> Result<String, RpcError> {
+    let proven = match caller {
+        Caller::Peer { device: Some(device) } if !device.is_empty() => device,
+        _ => return refused("only another of the person's devices that proved which it is may call this"),
+    };
+    if named.is_some_and(|named| named != proven) {
+        return refused("a call names the device it comes from");
+    }
+    if proven == me {
+        return refused("these calls come from another device");
+    }
+    let Some(listed) = devices.iter().find(|row| row.id == proven) else {
+        return refused("that device isn't one of the person's listed here");
+    };
+    if zeron_proto::is_cloud_device(&proven, &listed.platform) {
+        return refused("these calls are for the person's own computers");
+    }
+    if revoked(keys, &proven) {
+        return refused("that device's key was revoked");
+    }
+    Ok(proven)
+}
+
+impl WorkspaceHost {
+    /// Check the devices this one hears from and sends to directly against
+    /// the account's keys `keys` too.
+    pub(crate) fn check_peer_keys_with(&self, keys: KeyCopy) {
+        *self.peer_keys().0.lock().unwrap_or_else(|poisoned| poisoned.into_inner()) = Some(keys);
+    }
+
+    /// The account's keys as kept here, when the engine wired them.
+    pub(crate) fn peer_key_copy(&self) -> Option<Vec<KeyRow>> {
+        let keys = self.peer_keys().copy()?;
+        keys()
+    }
+
+    /// [`admit`] for the call being served, by this device's list and keys.
+    pub(crate) fn direct_peer(&self, named: Option<&str>) -> Result<String, RpcError> {
+        let devices = self.read_devices().unwrap_or_default();
+        let keys = self.peer_key_copy();
+        admit(zeron_rpc::caller(), named, self.device_id(), &devices, keys.as_deref())
+    }
+
+    /// [`may_reach`] for a device by id, as the roads ask it: a device not
+    /// listed here isn't reached.
+    pub(crate) fn reach(&self) -> crate::direct_rpc::Reach {
+        let workspace = self.clone();
+        Arc::new(move |device: &str| {
+            let keys = workspace.peer_key_copy();
+            workspace
+                .read_devices()
+                .unwrap_or_default()
+                .iter()
+                .find(|row| row.id == device)
+                .is_some_and(|row| may_reach(row, workspace.device_id(), keys.as_deref()))
+        })
+    }
+
+    /// The devices listed here this one may reach ([`may_reach`]).
+    pub(crate) fn reachable_peers(&self) -> Vec<Device> {
+        let keys = self.peer_key_copy();
+        let me = self.device_id();
+        self.read_devices()
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|device| may_reach(device, me, keys.as_deref()))
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn row(id: &str, platform: &str) -> Device {
+        Device {
+            id: id.into(),
+            name: id.into(),
+            platform: platform.into(),
+            last_seen_at: None,
+            created_at: None,
+            version: None,
+            cursor_sdk_version: None,
+            capabilities: Vec::new(),
+        }
+    }
+
+    fn key(device: &str, revoked_at: Option<i64>) -> KeyRow {
+        KeyRow {
+            key: format!("key-{device}-{revoked_at:?}"),
+            fingerprint: String::new(),
+            device_id: device.into(),
+            created_at: 1,
+            revoked_at,
+        }
+    }
+
+    fn proven(device: &str) -> Caller {
+        Caller::Peer {
+            device: Some(device.into()),
+        }
+    }
+
+    fn listed() -> Vec<Device> {
+        vec![row("desktop", "linux"), row("laptop", "macos"), row("phone", "ios")]
+    }
+
+    #[test]
+    fn another_listed_computer_that_proved_itself_is_admitted() {
+        let devices = listed();
+        assert_eq!(admit(proven("laptop"), Some("laptop"), "desktop", &devices, None).ok(), Some("laptop".into()));
+        assert_eq!(
+            admit(proven("laptop"), None, "desktop", &devices, None).ok(),
+            Some("laptop".into()),
+            "a call that names no device"
+        );
+    }
+
+    #[test]
+    fn an_unproven_link_this_devices_app_or_an_agent_is_refused_whatever_it_names() {
+        for caller in [Caller::Peer { device: None }, Caller::Local, Caller::Agent { chat: None }] {
+            assert!(admit(caller, Some("laptop"), "desktop", &listed(), None).is_err());
+        }
+    }
+
+    #[test]
+    fn a_caller_naming_another_device_this_one_or_an_unlisted_one_is_refused() {
+        let devices = listed();
+        assert!(admit(proven("phone"), Some("laptop"), "desktop", &devices, None).is_err(), "names another");
+        assert!(admit(proven("desktop"), None, "desktop", &devices, None).is_err(), "this device");
+        assert!(admit(proven("tablet"), None, "desktop", &devices, None).is_err(), "not listed");
+    }
+
+    #[test]
+    fn a_cloud_machine_is_refused_even_proven() {
+        let devices = vec![row("cloud-0b59268e", "linux"), row("runner", zeron_proto::CLOUD_PLATFORM)];
+        assert!(admit(proven("cloud-0b59268e"), None, "desktop", &devices, None).is_err(), "by id");
+        assert!(admit(proven("runner"), None, "desktop", &devices, None).is_err(), "by platform");
+        assert!(devices.iter().all(|device| !may_reach(device, "desktop", None)));
+    }
+
+    #[test]
+    fn a_device_whose_every_key_is_revoked_is_refused_and_not_reached() {
+        let devices = listed();
+        let keys = [key("laptop", Some(5)), key("phone", None)];
+        assert!(admit(proven("laptop"), None, "desktop", &devices, Some(&keys)).is_err());
+        assert!(!may_reach(&devices[1], "desktop", Some(&keys)));
+        // A new key beside the revoked one: admitted.
+        let rotated = [key("laptop", Some(5)), key("laptop", None)];
+        assert!(admit(proven("laptop"), None, "desktop", &devices, Some(&rotated)).is_ok());
+        assert!(may_reach(&devices[1], "desktop", Some(&rotated)));
+        // No copy of the keys here: the road's proof stands.
+        assert!(admit(proven("laptop"), None, "desktop", &devices, None).is_ok());
+    }
+}
