+#[tokio::test(start_paused = true)]
+async fn a_direct_link_carries_the_stream_while_the_room_holds_it_back_and_the_late_copies_change_nothing() {
+    let room = Room::default();
+    let host = Device::host("host");
+    let viewer = Device::viewer("viewer");
+    let _sockets = (room.join("host", &host.relay), room.join("viewer", &viewer.relay));
+    let _link = link(&host, &viewer);
+    let mut events = host.relay.events();
+    until("the link to come up", || host.relay.stats().links == 1).await;
+    assert_eq!(events.recv().await.unwrap(), RelayEvent::LinksChanged);
+    // The room still gets every frame, but holds them back.
+    room.0.lock().unwrap().reorder = true;
+    for i in 0..20 {
+        host.stream(&format!("{i} "));
+        tokio::time::sleep(Duration::from_millis(1)).await;
+    }
+    converged(&[&host, &viewer]).await;
+    let expected: String = (0..20).map(|i| format!("{i} ")).collect();
+    assert_eq!(viewer.body(), expected);
+    let stats = viewer.relay.stats();
+    assert!(stats.direct_frames_received >= 20, "{stats:?}");
+    assert_eq!(room.0.lock().unwrap().held.len(), 20, "the room got every frame too");
+    // The room's copies arrive late, and backwards: one copy, in order.
+    let before = viewer.relay.stats().room_frames_received;
+    room.release_reversed();
+    until("the room's copies to arrive", || viewer.relay.stats().room_frames_received >= before + 20).await;
+    converged(&[&host, &viewer]).await;
+    assert_eq!(viewer.body(), expected);
+}
