+
+/// [`serve`], until `stop` resolves first: then nothing more is read, the
+/// calls under way are ended, terminal input still queued is dropped, and
+/// the stream is closed. `Some`: what `stop` gave; `None`: the stream closed
+/// by itself, and its terminal input went in (`stop` still raced meanwhile:
+/// a far end that closed its own stream is cut off all the same).
+pub async fn serve_until<S, T>(service: Arc<dyn RpcService>, io: S, stop: impl std::future::Future<Output = T>) -> Option<T>
+where
+    S: AsyncRead + AsyncWrite + Send + 'static,
+{
+    let (out, inbound, tasks) = bridge(io);
+    let ends = ClosesIfDropped(Some(tasks));
+    let serving = zeron_rpc::serve_connection(service, out, inbound);
+    tokio::pin!(serving);
+    tokio::select! {
+        () = &mut serving => {
+            ends.disarm();
+            None
+        }
+        // Cut off, not closed: the serving is dropped (its calls, and the
+        // input queued behind a busy terminal, with it), then the stream.
+        stopped = stop => Some(stopped),
+    }
+}
+
+/// A served stream's reading and writing tasks, ended if the serving is
+/// dropped part-way (its task aborted, as a listener closing does). Else
+/// the stream stays open: unread, and held by any reply stream still
+/// sending, so the far end goes on handing calls to a link nobody answers.
+struct ClosesIfDropped(Option<[tokio::task::AbortHandle; 2]>);
+
+impl ClosesIfDropped {
+    /// The serving ended by itself: the stream closes as it does.
+    fn disarm(mut self) {
+        self.0 = None;
+    }
+}
+
+impl Drop for ClosesIfDropped {
+    fn drop(&mut self) {
+        for task in self.0.take().into_iter().flatten() {
+            task.abort();
+        }
+    }
 }
 
