+//! Two real engines on one fake edge, behind one gate.
+//!
+//! [`Engines::start`] gives each test its own pair, with device ids
+//! `{name}-a` and `{name}-b` (unique per test, so the log helper can tell
+//! tests apart). Both engines run with an `EdgeConfig` pointing at the
+//! [`Gate`] in front of the [`FakeEdge`]: their registry room, chat rooms,
+//! device rooms (each hosts its own and dials the other's) and nudges all
+//! cross the gate, so `gate.cut()` takes the whole edge away and
+//! `gate.restore()` brings it back. Their agent streams a reply in several
+//! commits ([`StreamingHarness`]).
+//!
+//! Tests that use chat rooms share a process-wide sync budget: hold
+//! [`serial`] for the test's length.
+
+#![allow(dead_code)]
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use futures::StreamExt;
+use futures::stream::BoxStream;
+use zeron_doc::{MessagePart, MessageRole, SessionCommandPayload, SessionMessageEntry};
+use zeron_engine::{EdgeConfig, EngineCore, HarnessRegistry};
+use zeron_harness::{Harness, HarnessError, RunControls};
+use zeron_proto::{
+    AgentEvent, DoneStatus, HarnessId, Model, ReasoningLevel, RunRequest, SandboxLevel,
+    SteeringMode,
+};
+use zeron_rpc::{HostRelay, LinkCache, LinkCacheConfig, StaticToken, methods};
+
+use super::edge::FakeEdge;
+use super::gate::Gate;
+
+/// Chunks of each streamed reply, and the wait between them (longer than
+/// the host's ~120 ms commit window, so a reply crosses in several commits).
+pub const REPLY_PARTS: usize = 6;
+pub const REPLY_GAP: Duration = Duration::from_millis(150);
+
+/// The reply a [`StreamingHarness`] streams for `prompt`, whole.
+pub fn reply_to(prompt: &str) -> String {
+    (0..REPLY_PARTS).map(|i| format!("{prompt}:part-{i} ")).collect()
+}
+
+/// A mock agent that streams [`reply_to`] its prompt over several commits.
+pub struct StreamingHarness;
+
+#[async_trait]
+impl Harness for StreamingHarness {
+    fn id(&self) -> HarnessId {
+        HarnessId::Mock
+    }
+    fn display_name(&self) -> &str {
+        "Streaming"
+    }
+    fn supports_steering(&self) -> bool {
+        false
+    }
+    fn steering_mode(&self) -> SteeringMode {
+        SteeringMode::TurnBoundary
+    }
+    fn reasoning_levels(&self) -> &[ReasoningLevel] {
+        &[]
+    }
+    async fn models(&self) -> Result<Vec<Model>, HarnessError> {
+        Ok(vec![])
+    }
+    async fn run(
+        &self,
+        request: RunRequest,
+        _controls: RunControls,
+    ) -> Result<BoxStream<'static, Result<AgentEvent, HarnessError>>, HarnessError> {
+        static RUNS: AtomicUsize = AtomicUsize::new(0);
+        let run = RUNS.fetch_add(1, Ordering::Relaxed);
+        let prompt = request.prompt.clone();
+        let started = futures::stream::iter([Ok(AgentEvent::SessionStarted {
+            harness: HarnessId::Mock,
+            model: "streaming-1".into(),
+            tools: vec![],
+            cwd: "/tmp".into(),
+            session_id: format!("hs-{run}"),
+            assistant_message_id: format!("a-{run}"),
+        })]);
+        let parts = futures::stream::iter(0..REPLY_PARTS).then(move |i| {
+            let text = format!("{prompt}:part-{i} ");
+            async move {
+                tokio::time::sleep(REPLY_GAP).await;
+                Ok(AgentEvent::TextDelta { text })
+            }
+        });
+        let done = futures::stream::iter([Ok(AgentEvent::Done {
+            status: DoneStatus::Completed,
+            result: None,
+            error: None,
+            session_id: Some(format!("hs-{run}")),
+        })]);
+        Ok(started.chain(parts).chain(done).boxed())
+    }
+}
+
+/// An engine on `edge` (or none), with the streaming agent.
+pub fn assemble(dir: &std::path::Path, device_id: &str, edge: Option<&str>) -> EngineCore {
+    std::fs::create_dir_all(dir).expect("create data dir");
+    std::fs::write(dir.join("device-id"), device_id).expect("write device id");
+    // Its signing key, as a signed-in device has: what proves it on a direct
+    // link (support/direct.rs).
+    zeron_engine::plugins::signing::load_or_create_key(dir).expect("device key");
+    let registry = HarnessRegistry::new();
+    registry.register(Arc::new(StreamingHarness));
+    let core = EngineCore::assemble(
+        dir,
+        Arc::new(registry),
+        HarnessId::Mock,
+        edge.map(|url| EdgeConfig::with_static_token(url, "test")),
+    )
+    .expect("engine assembles");
+    // No IPC port in tests: a turn goes on at once rather than waiting for one.
+    core.sessions.set_no_ipc_port();
+    core
+}
+
+/// Relay links to `edge_url` that redial quickly after a cut.
+pub fn quick_links(edge_url: &str) -> Arc<LinkCache> {
+    let mut config = LinkCacheConfig::new(edge_url.to_owned(), Arc::new(StaticToken("test-user".into())));
+    config.probe_timeout = Duration::from_secs(5);
+    config.cooldown_base = Duration::from_millis(100);
+    config.cooldown_max = Duration::from_millis(500);
+    LinkCache::new(config)
+}
+
+pub struct Engines {
+    pub edge: FakeEdge,
+    pub gate: Gate,
+    pub a: EngineCore,
+    pub b: EngineCore,
+    pub a_id: String,
+    pub b_id: String,
+    hosts: Vec<HostRelay>,
+    _dirs: tempfile::TempDir,
+}
+
+impl Engines {
+    /// Two engines on one fake edge behind one gate, each hosting its device
+    /// room and holding relay links to the other's.
+    pub async fn start(name: &str) -> Self {
+        super::logs::capture();
+        let edge = FakeEdge::start().await;
+        let gate = Gate::front(edge.addr()).await;
+        let dirs = tempfile::tempdir().expect("tempdir");
+        let a_id = format!("{name}-a");
+        let b_id = format!("{name}-b");
+        let url = gate.url();
+        let a = assemble(&dirs.path().join("a"), &a_id, Some(&url));
+        let b = assemble(&dirs.path().join("b"), &b_id, Some(&url));
+        let hosts = vec![a.start_host_relay(&url), b.start_host_relay(&url)];
+        a.set_links(quick_links(&url));
+        b.set_links(quick_links(&url));
+        // Each lists the other (their own rows, through the registry room):
+        // the roads read a peer's row to choose.
+        let lists = |core: &EngineCore, other: &str| {
+            core.workspace
+                .read_devices()
+                .is_ok_and(|devices| devices.iter().any(|d| d.id == other))
+        };
+        wait_until(Duration::from_secs(20), "each engine lists the other", || {
+            lists(&a, &b_id) && lists(&b, &a_id)
+        })
+        .await;
+        Self {
+            edge,
+            gate,
+            a,
+            b,
+            a_id,
+            b_id,
+            hosts,
+            _dirs: dirs,
+        }
+    }
+
+    /// A chat hosted on B, relayed (generation 3), pre-titled (no title run),
+    /// once A's list has it too.
+    pub async fn chat_hosted_on_b(&self, chat: &str) {
+        self.b
+            .workspace
+            .create_chat(chat, None, Some(&self.b_id), None, None)
+            .expect("create chat on B");
+        self.b.workspace.rename_chat(chat, "Pre-titled").expect("pre-title");
+        self.b
+            .workspace
+            .set_chat_room_gen(chat, zeron_proto::relay_gen::RELAY_ROOM_GEN)
+            .expect("relayed chat");
+        wait_until(Duration::from_secs(20), "A's list has B's chat, relayed", || {
+            self.a.workspace.chat(chat).ok().flatten().is_some_and(|row| {
+                row.room_gen == Some(zeron_proto::relay_gen::RELAY_ROOM_GEN)
+            })
+        })
+        .await;
+    }
+
+    pub async fn shutdown(self) {
+        self.a.shutdown().await;
+        self.b.shutdown().await;
+        drop(self.hosts);
+    }
+}
+
+/// Run `prompt` in `chat` from `core`, as the app's send does. The message
+/// id is `message_id`.
+pub async fn send(core: &EngineCore, chat: &str, prompt: &str, message_id: &str) {
+    let command = serde_json::to_value(SessionCommandPayload::Run {
+        request: RunRequest {
+            mcp: None,
+            prompt: prompt.into(),
+            harness: None,
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            cwd: "~".into(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            auto_approve: true,
+            access: Default::default(),
+            plan: false,
+            code_mode: false,
+            zeron_mcp_only: false,
+            attachments: Vec::new(),
+            worktree: None,
+            resume: None,
+            env: Default::default(),
+            extra_mcp: Vec::new(),
+        },
+        message_id: message_id.into(),
+    })
+    .expect("command json");
+    zeron_rpc::memory_client(core.rpc_service())
+        .call(
+            methods::QUEUE_COMMAND,
+            serde_json::json!({ "chatId": chat, "command": command }),
+        )
+        .await
+        .expect("queue the send");
+}
+
+/// `chat`'s transcript on `core`.
+pub fn entries(core: &EngineCore, chat: &str) -> Vec<SessionMessageEntry> {
+    core.doc_host
+        .open(chat)
+        .ok()
+        .and_then(|handle| handle.doc().read_entries().ok())
+        .unwrap_or_default()
+}
+
+/// An entry's text parts, joined.
+pub fn text_of(entry: &SessionMessageEntry) -> String {
+    entry
+        .parts
+        .iter()
+        .filter_map(|part| match part {
+            MessagePart::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect()
+}
+
+/// The assistant's text in `chat` on `core`, one string per entry, in order.
+pub fn replies(core: &EngineCore, chat: &str) -> Vec<String> {
+    entries(core, chat)
+        .iter()
+        .filter(|e| e.role == MessageRole::Assistant)
+        .map(text_of)
+        .collect()
+}
+
+/// Wait up to `within` for `ready`, polling; panic naming `what` if it never is.
+pub async fn wait_until(within: Duration, what: &str, mut ready: impl FnMut() -> bool) {
+    let deadline = tokio::time::Instant::now() + within;
+    while !ready() {
+        assert!(tokio::time::Instant::now() < deadline, "timed out after {within:?}: {what}");
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+/// Hold for the length of a test that uses chat rooms: the sync socket
+/// budget is process-wide.
+pub async fn serial() -> tokio::sync::MutexGuard<'static, ()> {
+    static LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+    LOCK.lock().await
+}
diff --git a/crates/engine/tests/support/gate.rs b/crates/engine/tests/support/gate.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e53c25ed33ca2533430550cb25ca9b23ff5f0783
--- /dev/null
+++ b/crates/engine/tests/support/gate.rs
@@ -0,0 +1,199 @@
+//! A cuttable, holdable TCP proxy in front of a fake edge's port.
+//!
+//! Engines are given [`Gate::url`] instead of the fake's own URL. While the
+//! gate is up, bytes pass both ways unchanged (WebSockets and plain HTTP
+//! alike). [`Gate::cut`] drops every open connection without a close
+//! handshake, as a lost network does, and refuses new ones until
+//! [`Gate::restore`]. [`Gate::hold`] stops bytes moving (both ways) without
+//! closing anything; they move again, in order, when the hold is lifted.
+//! [`Gate::set_delay`] adds a wait before each chunk is passed on.
+//! [`Gate::blackhole`] is a cut that takes new connections and never
+//! answers them, as a host whose route is blackholed: what dials it waits
+//! on its own timeouts.
+//!
+//! Don't put a gate in front of a road whose handshake binds socket
+//! addresses (the Tailscale road): the proxy changes them.
+
+#![allow(dead_code)]
+
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+
+struct Shared {
+    down: AtomicBool,
+    /// Cut, and new connections held open unanswered rather than dropped.
+    swallow: AtomicBool,
+    swallowed: Mutex<Vec<TcpStream>>,
+    hold: watch::Sender<bool>,
+    delay: Mutex<Duration>,
+    pipes: Mutex<Vec<JoinHandle<()>>>,
+    /// Connections accepted while up (dials that reached the far side).
+    passed: AtomicUsize,
+    /// Connections dropped at accept while cut.
+    refused: AtomicUsize,
+}
+
+pub struct Gate {
+    addr: SocketAddr,
+    shared: Arc<Shared>,
+    task: JoinHandle<()>,
+}
+
+impl Gate {
+    /// A gate on a fresh local port in front of `upstream`.
+    pub async fn front(upstream: SocketAddr) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind gate");
+        let addr = listener.local_addr().expect("gate addr");
+        let shared = Arc::new(Shared {
+            down: AtomicBool::new(false),
+            swallow: AtomicBool::new(false),
+            swallowed: Mutex::new(Vec::new()),
+            hold: watch::Sender::new(false),
+            delay: Mutex::new(Duration::ZERO),
+            pipes: Mutex::new(Vec::new()),
+            passed: AtomicUsize::new(0),
+            refused: AtomicUsize::new(0),
+        });
+        let accepting = shared.clone();
+        let task = tokio::spawn(async move {
+            loop {
+                let Ok((near, _)) = listener.accept().await else {
+                    return;
+                };
+                if accepting.down.load(Ordering::SeqCst) {
+                    accepting.refused.fetch_add(1, Ordering::SeqCst);
+                    if accepting.swallow.load(Ordering::SeqCst) {
+                        accepting.swallowed.lock().unwrap().push(near);
+                    }
+                    continue;
+                }
+                accepting.passed.fetch_add(1, Ordering::SeqCst);
+                let shared = accepting.clone();
+                let pipe = tokio::spawn(async move {
+                    let Ok(far) = TcpStream::connect(upstream).await else {
+                        return;
+                    };
+                    let _ = near.set_nodelay(true);
+                    let _ = far.set_nodelay(true);
+                    let (near_read, near_write) = near.into_split();
+                    let (far_read, far_write) = far.into_split();
+                    tokio::select! {
+                        () = carry(near_read, far_write, &shared) => {}
+                        () = carry(far_read, near_write, &shared) => {}
+                    }
+                });
+                let mut pipes = accepting.pipes.lock().unwrap();
+                pipes.retain(|pipe| !pipe.is_finished());
+                pipes.push(pipe);
+            }
+        });
+        Self { addr, shared, task }
+    }
+
+    /// The gate's own address, as `http://127.0.0.1:{port}` (what an
+    /// `EdgeConfig`, a `LinkCache` or a `HostRelay` takes).
+    pub fn url(&self) -> String {
+        format!("http://{}", self.addr)
+    }
+
+    /// The same address as a WebSocket URL (what `connect_registry_url` takes).
+    pub fn ws_url(&self) -> String {
+        format!("ws://{}", self.addr)
+    }
+
+    pub fn addr(&self) -> SocketAddr {
+        self.addr
+    }
+
+    /// Drop every open connection (no close frame, no FIN handshake beyond
+    /// the socket closing) and refuse new ones until [`Self::restore`].
+    pub fn cut(&self) {
+        self.shared.down.store(true, Ordering::SeqCst);
+        for pipe in self.shared.pipes.lock().unwrap().drain(..) {
+            pipe.abort();
+        }
+    }
+
+    /// [`Self::cut`], and every new connection is taken and never
+    /// answered (nor closed) until [`Self::restore`].
+    pub fn blackhole(&self) {
+        self.shared.swallow.store(true, Ordering::SeqCst);
+        self.cut();
+    }
+
+    /// Let connections through again. Nothing is redialled here: clients
+    /// come back on their own backoff.
+    pub fn restore(&self) {
+        self.shared.down.store(false, Ordering::SeqCst);
+        self.shared.swallow.store(false, Ordering::SeqCst);
+        self.shared.swallowed.lock().unwrap().clear();
+    }
+
+    pub fn is_cut(&self) -> bool {
+        self.shared.down.load(Ordering::SeqCst)
+    }
+
+    /// While on, bytes read from either side wait at the gate; nothing is
+    /// closed. Turned off, they move on in order.
+    pub fn hold(&self, on: bool) {
+        self.shared.hold.send_replace(on);
+    }
+
+    /// A wait before each chunk is passed on (both ways).
+    pub fn set_delay(&self, delay: Duration) {
+        *self.shared.delay.lock().unwrap() = delay;
+    }
+
+    /// Connections that reached the far side so far.
+    pub fn passed(&self) -> usize {
+        self.shared.passed.load(Ordering::SeqCst)
+    }
+
+    /// Connections refused (or, blackholed, held unanswered) while cut.
+    pub fn refused(&self) -> usize {
+        self.shared.refused.load(Ordering::SeqCst)
+    }
+}
+
+impl Drop for Gate {
+    fn drop(&mut self) {
+        self.task.abort();
+        for pipe in self.shared.pipes.lock().unwrap().drain(..) {
+            pipe.abort();
+        }
+    }
+}
+
+/// One direction of a connection: read a chunk, wait out any hold and
+/// delay, write it on.
+async fn carry(
+    mut from: tokio::net::tcp::OwnedReadHalf,
+    mut to: tokio::net::tcp::OwnedWriteHalf,
+    shared: &Shared,
+) {
+    let mut hold = shared.hold.subscribe();
+    let mut buf = vec![0u8; 64 * 1024];
+    loop {
+        let n = match from.read(&mut buf).await {
+            Ok(0) | Err(_) => return,
+            Ok(n) => n,
+        };
+        if hold.wait_for(|held| !*held).await.is_err() {
+            return;
+        }
+        let delay = *shared.delay.lock().unwrap();
+        if !delay.is_zero() {
+            tokio::time::sleep(delay).await;
+        }
+        if to.write_all(&buf[..n]).await.is_err() {
+            return;
+        }
+    }
+}
diff --git a/crates/engine/tests/support/logs.rs b/crates/engine/tests/support/logs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7879e35e98a24adebd3ea9a17134608d49458d7b
--- /dev/null
+++ b/crates/engine/tests/support/logs.rs
@@ -0,0 +1,106 @@
+//! What each engine logged, for tests that check "the log says so".
+//!
+//! One global capturing subscriber per test binary ([`capture`] installs it
+//! the first time). Tests in a binary run in parallel and share it, so give
+//! each test its own device ids and look lines up by them: [`lines_naming`]
+//! keeps the lines that name a device, and [`wait_for_line`] waits for a
+//! line with a given message and fields.
+//!
+//! Fields are matched in the formatter's text form, `key=value` or
+//! `key="value"` (a `&str` field is written quoted, a `%display` one bare).
+
+#![allow(dead_code)]
+
+use std::io::Write;
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::Duration;
+
+#[derive(Clone, Default)]
+struct Sink(Arc<Mutex<Vec<u8>>>);
+
+impl Write for Sink {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+static SINK: OnceLock<Sink> = OnceLock::new();
+
+/// Install the capturing subscriber for this test binary (idempotent).
+/// Captures `info` and up from every crate, so call it before the engines
+/// start.
+pub fn capture() {
+    SINK.get_or_init(|| {
+        let sink = Sink::default();
+        let writer = sink.clone();
+        let subscriber = tracing_subscriber::fmt()
+            .with_writer(move || writer.clone())
+            .with_ansi(false)
+            .with_max_level(tracing::Level::INFO)
+            .finish();
+        tracing::subscriber::set_global_default(subscriber)
+            .expect("no other global subscriber in this test binary");
+        sink
+    });
+}
+
+/// Every captured line so far.
+pub fn lines() -> Vec<String> {
+    let sink = SINK.get().expect("logs::capture() first");
+    let bytes = sink.0.lock().unwrap().clone();
+    String::from_utf8_lossy(&bytes).lines().map(str::to_owned).collect()
+}
+
+/// Whether `line` carries field `key` with exactly `value`, quoted or not
+/// (values without spaces, such as device ids and road names).
+pub fn has_field(line: &str, key: &str, value: &str) -> bool {
+    let bare = format!("{key}={value}");
+    let quoted = format!("{key}=\"{value}\"");
+    line.split_whitespace().any(|word| word == bare || word == quoted)
+}
+
+/// Captured lines naming `device` as the value of any field.
+pub fn lines_naming(device: &str) -> Vec<String> {
+    let bare = format!("={device}");
+    let quoted = format!("=\"{device}\"");
+    lines()
+        .into_iter()
+        .filter(|line| line.split_whitespace().any(|w| w.ends_with(&bare) || w.ends_with(&quoted)))
+        .collect()
+}
+
+/// Captured lines with `message` and every `(key, value)` field.
+pub fn find(message: &str, fields: &[(&str, &str)]) -> Vec<String> {
+    lines()
+        .into_iter()
+        .filter(|line| line.contains(message) && fields.iter().all(|(k, v)| has_field(line, k, v)))
+        .collect()
+}
+
+/// Wait (up to `within`) for a line with `message` and every field; the
+/// first such line. Panics with the lines naming the fields' values if none
+/// came.
+pub async fn wait_for_line(message: &str, fields: &[(&str, &str)], within: Duration) -> String {
+    let deadline = tokio::time::Instant::now() + within;
+    loop {
+        if let Some(line) = find(message, fields).into_iter().next() {
+            return line;
+        }
+        if tokio::time::Instant::now() >= deadline {
+            let related: Vec<String> = fields
+                .iter()
+                .flat_map(|(_, v)| lines_naming(v))
+                .collect();
+            panic!(
+                "no log line {message:?} with {fields:?} within {within:?}; lines naming them:\n{}",
+                related.join("\n")
+            );
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
diff --git a/crates/engine/tests/test_seams.rs b/crates/engine/tests/test_seams.rs
new file mode 100644
index 0000000000000000000000000000000000000000..384fa2a66c8d6bf44f0784a31ac9510a7cfe25ef
--- /dev/null
+++ b/crates/engine/tests/test_seams.rs
@@ -0,0 +1,371 @@
+//! The test seams the direct-transport tickets build on, each shown working
+//! between two real engines: the fake edge's ChatRoom (held per device), the
+//! gate that cuts the whole edge, the RegistryRoom going down, short
+//! presence timing, the log helper, and the two-way stand-in direct pairing.
+//!
+//! Later tickets' tests build on the same support files: include them with
+//! `#[path = "support/…"] mod …;` as below (`engines` needs `edge`, `gate`
+//! and `logs` beside it).
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+
+use std::time::Duration;
+
+use engines::{Engines, entries, replies, reply_to, send, serial, wait_until};
+use zeron_rpc::methods;
+
+/// A device-addressed call from `core` to `target`, asked again while the
+/// target's relay host is still joining.
+async fn call_until_answered(core: &zeron_engine::EngineCore, method: &str, target: &str) -> serde_json::Value {
+    let client = zeron_rpc::memory_client(core.rpc_service());
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(30);
+    loop {
+        match client
+            .call(method, serde_json::json!({ "targetDeviceId": target }))
+            .await
+        {
+            Ok(value) => return value,
+            Err(err) => {
+                assert!(tokio::time::Instant::now() < deadline, "{method} to {target} never answered: {err}");
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+        }
+    }
+}
+
+/// Both transcripts, as JSON, for comparing whole.
+fn transcript(core: &zeron_engine::EngineCore, chat: &str) -> serde_json::Value {
+    serde_json::to_value(entries(core, chat)).expect("entries as json")
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_reply_streamed_on_the_host_reaches_the_viewer_through_the_chat_room_and_waits_while_held() {
+    let _serial = serial().await;
+    let engines = Engines::start("seams-reply").await;
+    let chat = "chat-seams-reply";
+    engines.chat_hosted_on_b(chat).await;
+    // A has the chat on screen.
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+
+    // A sends; B runs it and streams the reply; A sees it through the room.
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+
+    // The room holds back what it sends A: B streams the next reply whole,
+    // and A has none of it.
+    engines.edge.hold_to(&engines.a_id);
+    send(&engines.a, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "B finishes the reply to two", || {
+        replies(&engines.b, chat) == [reply_to("one"), reply_to("two")]
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(replies(&engines.a, chat), [reply_to("one")], "nothing of two reached A while held");
+    assert!(engines.edge.held_to(&engines.a_id) > 0, "the room held frames for A");
+
+    // Released: it arrives whole and in order, the same transcript as B's.
+    engines.edge.release_to(&engines.a_id);
+    wait_until(Duration::from_secs(15), "A's transcript matches B's", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert_eq!(replies(&engines.a, chat), [reply_to("one"), reply_to("two")]);
+    assert_eq!(engines.edge.held_to(&engines.a_id), 0);
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_viewers_send_is_queued_in_the_chat_room_then_delivered_and_the_host_runs_it() {
+    let _serial = serial().await;
+    let engines = Engines::start("seams-queue").await;
+    let chat = "chat-seams-queue";
+    engines.chat_hosted_on_b(chat).await;
+    // B isn't in the chat's room yet, and its wake is held at the edge.
+    engines.edge.hold_nudges(true);
+    // A has the chat on screen, so it's in the room when it sends.
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+    wait_until(Duration::from_secs(20), "A joined the chat's room", || {
+        engines.edge.chat_sockets(chat) == 1
+    })
+    .await;
+
+    send(&engines.a, chat, "queued", "msg-queued").await;
+    wait_until(Duration::from_secs(20), "A asked the edge to wake B", || {
+        engines.edge.nudges(chat) >= 1
+    })
+    .await;
+    // (The send's doc writes may take more than one batch.)
+    let batches = engines.edge.enqueued(chat);
+    assert!(!batches.is_empty(), "A's send is in the room's queue");
+    let queued = engines.edge.queued(chat);
+    assert!(batches.iter().all(|b| queued.contains(b)), "all of it waiting");
+    for batch in &batches {
+        assert_eq!(engines.edge.enqueued_by(chat, batch).as_deref(), Some(engines.a_id.as_str()));
+    }
+    assert!(engines.edge.rows(chat).is_empty(), "a send is queued, not stored as a row");
+    assert!(engines.edge.delivered(chat).is_empty());
+    assert!(replies(&engines.b, chat).is_empty(), "B hasn't run it");
+
+    // The wake reaches B: it joins, confirms the send delivered, and runs it.
+    engines.edge.hold_nudges(false);
+    wait_until(Duration::from_secs(30), "B confirms the send delivered", || {
+        let delivered = engines.edge.delivered(chat);
+        batches.iter().all(|b| delivered.contains(b))
+    })
+    .await;
+    wait_until(Duration::from_secs(30), "B runs the send", || {
+        replies(&engines.b, chat) == [reply_to("queued")]
+    })
+    .await;
+    assert!(engines.edge.queued(chat).is_empty());
+    assert!(
+        entries(&engines.b, chat).iter().any(|e| e.id == "msg-queued"),
+        "B's transcript has A's message"
+    );
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_gate_cut_relay_calls_and_the_edge_rooms_fail_and_after_restore_all_work_again() {
+    let _serial = serial().await;
+    let engines = Engines::start("seams-gate").await;
+    let chat = "chat-seams-gate";
+    engines.chat_hosted_on_b(chat).await;
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+
+    // Up: a forwarded call, both registry rooms, and the chat room.
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    wait_until(Duration::from_secs(20), "both registry rooms joined", || {
+        engines.a.workspace.connected() && engines.b.workspace.connected()
+    })
+    .await;
+    send(&engines.a, chat, "before", "msg-before").await;
+    wait_until(Duration::from_secs(30), "the reply reaches A", || {
+        replies(&engines.a, chat) == [reply_to("before")]
+    })
+    .await;
+
+    // Cut: the call fails, and neither room can be reached.
+    engines.gate.cut();
+    let client = zeron_rpc::memory_client(engines.a.rpc_service());
+    let failed = tokio::time::timeout(
+        Duration::from_secs(20),
+        client.call(
+            methods::LIST_HARNESSES,
+            serde_json::json!({ "targetDeviceId": engines.b_id }),
+        ),
+    )
+    .await
+    .expect("the call ends");
+    assert!(failed.is_err(), "a relay call with the edge cut: {failed:?}");
+    wait_until(Duration::from_secs(20), "both registry rooms lost", || {
+        !engines.a.workspace.connected() && !engines.b.workspace.connected()
+    })
+    .await;
+    wait_until(Duration::from_secs(20), "no chat socket left", || {
+        engines.edge.chat_sockets(chat) == 0
+    })
+    .await;
+    let refused = engines.gate.refused();
+    wait_until(Duration::from_secs(20), "new dials are refused", || {
+        engines.gate.refused() > refused
+    })
+    .await;
+
+    // Restored, with no restart: all three work again.
+    engines.gate.restore();
+    zeron_sync::wake::notify_online();
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    wait_until(Duration::from_secs(30), "both registry rooms back", || {
+        engines.a.workspace.connected() && engines.b.workspace.connected()
+    })
+    .await;
+    send(&engines.a, chat, "after", "msg-after").await;
+    wait_until(Duration::from_secs(45), "the next reply reaches A", || {
+        replies(&engines.a, chat) == [reply_to("before"), reply_to("after")]
+    })
+    .await;
+
+    drop(_view);
+    engines.shutdown().await;
+}
+
+/// The HLC's wall clock (ms) and device: `{ms:013}-{counter:06}-{device}`.
+fn hlc_parts(hlc: &str) -> (i64, &str) {
+    (hlc[..13].parse().expect("hlc ms"), &hlc[21..])
+}
+
+fn now_ms() -> i64 {
+    chrono::Utc::now().timestamp_millis()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_list_change_waits_while_the_registry_room_is_down_and_reaches_it_with_its_original_clock() {
+    let _serial = serial().await;
+    let engines = Engines::start("seams-registry").await;
+    let chat = "chat-seams-registry";
+    engines.chat_hosted_on_b(chat).await;
+    let registry = &engines.edge.registry;
+    let title = |row: Option<zeron_doc::RegistryRow>| row.and_then(|r| r.fields.get("title").cloned());
+    wait_until(Duration::from_secs(20), "the room has the chat", || {
+        title(registry.row("chats", chat)) == Some("Pre-titled".into())
+    })
+    .await;
+    wait_until(Duration::from_secs(20), "A's queue is empty", || {
+        engines.a.workspace.connected() && engines.a.workspace.registry_pending_len() == 0
+    })
+    .await;
+
+    // Down: A's rename waits in its queue; the room never hears of it.
+    registry.set_down(true);
+    wait_until(Duration::from_secs(20), "A lost the room", || !engines.a.workspace.connected()).await;
+    let before = now_ms();
+    engines.a.workspace.rename_chat(chat, "Renamed while down").expect("rename");
+    let after = now_ms();
+    assert!(engines.a.workspace.registry_pending_len() >= 1);
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert!(engines.a.workspace.registry_pending_len() >= 1, "still waiting");
+    assert_eq!(title(registry.row("chats", chat)), Some("Pre-titled".into()));
+
+    // Back: the room holds the change, with the clock A wrote it at.
+    registry.set_down(false);
+    zeron_sync::wake::notify_online();
+    wait_until(Duration::from_secs(30), "the room has the rename", || {
+        title(registry.row("chats", chat)) == Some("Renamed while down".into())
+    })
+    .await;
+    let row = registry.row("chats", chat).expect("row");
+    let (ms, device) = hlc_parts(&row.clocks["title"]);
+    assert_eq!(device, engines.a_id, "A's write");
+    assert!(before <= ms && ms <= after, "written at {ms}, not on reconnect ({before}..={after})");
+    wait_until(Duration::from_secs(20), "A's queue drained, B has it", || {
+        engines.a.workspace.registry_pending_len() == 0
+            && engines
+                .b
+                .workspace
+                .chat(chat)
+                .ok()
+                .flatten()
+                .is_some_and(|c| c.title.as_deref() == Some("Renamed while down"))
+    })
+    .await;
+
+    // Pushes held, socket up: the next rename waits unapplied, then lands.
+    registry.hold_pushes(true);
+    engines.a.workspace.rename_chat(chat, "Renamed while held").expect("rename");
+    wait_until(Duration::from_secs(20), "the room holds A's push", || registry.held_pushes() >= 1).await;
+    assert!(engines.a.workspace.connected(), "A's socket stays up");
+    assert_eq!(title(registry.row("chats", chat)), Some("Renamed while down".into()));
+    registry.hold_pushes(false);
+    wait_until(Duration::from_secs(20), "the held push lands", || {
+        title(registry.row("chats", chat)) == Some("Renamed while held".into())
+            && engines.a.workspace.registry_pending_len() == 0
+    })
+    .await;
+
+    engines.shutdown().await;
+}
+
+/// `core`'s device list shows `device` online: seen within `window`.
+fn shows_online(core: &zeron_engine::EngineCore, device: &str, window: Duration) -> bool {
+    let devices = core.workspace.watch_devices().borrow().clone();
+    devices
+        .iter()
+        .find(|d| d.id == device)
+        .and_then(|d| d.last_seen_at)
+        .is_some_and(|seen| now_ms() - seen.timestamp_millis() < window.as_millis() as i64)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_short_presence_timing_each_engine_shows_the_other_online_and_a_stopped_one_offline_within_the_window() {
+    let _serial = serial().await;
+    let beat = Duration::from_millis(200);
+    let window = Duration::from_secs(2);
+    let engines = Engines::start("seams-presence").await;
+    engines.a.workspace.set_presence_timing(beat, window);
+    engines.b.workspace.set_presence_timing(beat, window);
+
+    wait_until(Duration::from_secs(20), "each shows the other online", || {
+        shows_online(&engines.a, &engines.b_id, window) && shows_online(&engines.b, &engines.a_id, window)
+    })
+    .await;
+    // And keeps doing so, beat after beat, for longer than the window.
+    for _ in 0..15 {
+        tokio::time::sleep(beat).await;
+        assert!(shows_online(&engines.a, &engines.b_id, window), "A lost B");
+        assert!(shows_online(&engines.b, &engines.a_id, window), "B lost A");
+    }
+
+    // B stops: A shows it offline within the window (and a beat or two).
+    engines.b.disconnect_edge();
+    engines.b.shutdown().await;
+    let stopped = std::time::Instant::now();
+    wait_until(window * 3, "A shows B offline", || !shows_online(&engines.a, &engines.b_id, window)).await;
+    assert!(stopped.elapsed() <= window + beat * 3, "offline after {:?}", stopped.elapsed());
+
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn the_log_helper_finds_the_new_road_line_naming_the_other_device() {
+    logs::capture();
+    let engines = Engines::start("seams-log").await;
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    let line = logs::wait_for_line(
+        "calls to this device take a new road",
+        &[("device", engines.b_id.as_str()), ("road", "relay")],
+        Duration::from_secs(5),
+    )
+    .await;
+    assert!(!line.contains(&engines.a_id), "{line}");
+    // Lines are told apart by device: nothing names a device no test started.
+    assert!(logs::lines_naming("seams-log-c").is_empty());
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn the_stand_in_direct_pairing_carries_calls_both_ways() {
+    let engines = Engines::start("seams-direct").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    // Down: the relay carries calls, both ways.
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    call_until_answered(&engines.b, methods::LIST_HARNESSES, &engines.a_id).await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::LIST_HARNESSES), 0);
+    assert_eq!(pairing.b_to_a.came_direct(methods::LIST_HARNESSES), 0);
+
+    // Up: A→B and B→A each take their direct link.
+    pairing.set_up();
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::LIST_HARNESSES), 1);
+    assert_eq!(pairing.b_to_a.came_direct(methods::LIST_HARNESSES), 0);
+    call_until_answered(&engines.b, methods::LIST_HARNESSES, &engines.a_id).await;
+    assert_eq!(pairing.b_to_a.came_direct(methods::LIST_HARNESSES), 1);
+
+    // Cut: back to the relay, both ways.
+    pairing.cut().await;
+    call_until_answered(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    call_until_answered(&engines.b, methods::LIST_HARNESSES, &engines.a_id).await;
+    assert_eq!(pairing.a_to_b.came_direct(methods::LIST_HARNESSES), 1);
+    assert_eq!(pairing.b_to_a.came_direct(methods::LIST_HARNESSES), 1);
+
+    engines.shutdown().await;
+}
