+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_down_reopening_a_chat_asks_its_host_over_the_link() {
+    let _serial = serial().await;
+    let engines = Engines::start("catchup-reopen").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-catchup-reopen";
+    engines.chat_hosted_on_b(chat).await;
+    let (_viewing, _view) = viewing_on_a(&engines, chat).await;
+
+    // The edge goes. The link stays, and is now the only way to the host.
+    engines.gate.cut();
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    let since = logs::lines().len();
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(45);
+    let line = loop {
+        // An open of the chat is what a reopen is.
+        let _ = engines.a.doc_host.open(chat);
+        let asked = logs::lines()
+            .into_iter()
+            .skip(since)
+            .find(|line| {
+                line.contains("chat2 reopened while connected") && logs::has_field(line, "chat", chat)
+            });
+        if let Some(line) = asked {
+            break line;
+        }
+        assert!(tokio::time::Instant::now() < deadline, "A's reopen never asked anyone");
+        tokio::time::sleep(Duration::from_millis(250)).await;
+    };
+    assert!(logs::has_field(&line, "asks_host", "true"), "the reopen asks the host over the link: {line}");
+
+    // And the host answers over the link: a reply B runs reaches A.
+    send(&engines.b, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "the reply to two reaches A with the edge down", || {
+        replies(&engines.a, chat) == [reply_to("one"), reply_to("two")]
+    })
+    .await;
+
+    engines.gate.restore();
+    drop(_view);
+    engines.shutdown().await;
+}
