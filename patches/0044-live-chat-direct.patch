diff --git a/crates/engine/tests/chat_catch_up.rs b/crates/engine/tests/chat_catch_up.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ab4295690fcddc5fb78e89f0997e655e04f8db21
--- /dev/null
+++ b/crates/engine/tests/chat_catch_up.rs
@@ -0,0 +1,271 @@
+//! Catch-up from a peer: a device coming back to a relayed chat it missed
+//! updates for gets them from the chat's host over the direct link, as well
+//! as through the ChatRoom. The room's catch-up still runs and stays the
+//! record; when the host can't serve the chat, or can't be reached, the room
+//! carries it with no wait beyond the road's own timeout.
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+
+use std::collections::HashSet;
+use std::sync::Arc;
+use std::time::Duration;
+
+use engines::{Engines, entries, replies, reply_to, send, serial, wait_until};
+use zeron_engine::{ChatDocHandle, EngineCore};
+use zeron_rpc::methods;
+
+/// How long a direct link may go quiet before the viewer gives it up and the
+/// room takes over: "the road's timeout".
+const ROAD_TIMEOUT: Duration = Duration::from_secs(8);
+
+/// `chat`'s transcript on `core`, as JSON, for comparing whole.
+fn transcript(core: &EngineCore, chat: &str) -> serde_json::Value {
+    serde_json::to_value(entries(core, chat)).expect("entries as json")
+}
+
+/// How far `core` has read `chat`'s stored rows from the ChatRoom.
+fn row_cursor(core: &EngineCore, chat: &str) -> u64 {
+    core.doc_host
+        .sync_statuses()
+        .into_iter()
+        .find(|(id, _)| id == chat)
+        .and_then(|(_, stats)| stats)
+        .map_or(0, |stats| stats.cursor)
+}
+
+/// A device's screen on a chat: while held, the chat is on screen there.
+type Screen = tokio::sync::watch::Receiver<zeron_engine::doc_host::TranscriptSnapshot>;
+
+/// A has `chat` on screen with a live link to B, and has B's reply to "one".
+/// Drop the returned screen and A looks away.
+async fn viewing_on_a(engines: &Engines, chat: &str) -> (Arc<ChatDocHandle>, Screen) {
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let view = viewing.watch_messages();
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies(&engines.a, chat) == [reply_to("one")]
+    })
+    .await;
+    logs::wait_for_line(
+        "chat link up",
+        &[("chat", chat), ("device", engines.b_id.as_str())],
+        Duration::from_secs(30),
+    )
+    .await;
+    (viewing, view)
+}
+
+/// A looks away from `chat` (its link closes), the room starts holding back
+/// everything it sends A, and B runs `prompts` meanwhile. A misses all of it.
+async fn a_away_while_b_runs(
+    engines: &Engines,
+    chat: &str,
+    view: Screen,
+    prompts: &[&str],
+) {
+    drop(view);
+    logs::wait_for_line(
+        "chat link down",
+        &[("chat", chat), ("device", engines.b_id.as_str())],
+        Duration::from_secs(15),
+    )
+    .await;
+    engines.edge.hold_to(&engines.a_id);
+    let mut expected = vec![reply_to("one")];
+    for prompt in prompts {
+        send(&engines.b, chat, prompt, &format!("msg-{prompt}")).await;
+        expected.push(reply_to(prompt));
+        let want = expected.clone();
+        wait_until(Duration::from_secs(30), &format!("B finishes the reply to {prompt}"), || {
+            replies(&engines.b, chat) == want
+        })
+        .await;
+    }
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(replies(&engines.a, chat), [reply_to("one")], "A missed what B ran while it was away");
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_viewer_back_from_away_catches_up_from_the_host_while_the_chat_room_holds_it_back() {
+    let _serial = serial().await;
+    let engines = Engines::start("catchup-away").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-catchup-away";
+    engines.chat_hosted_on_b(chat).await;
+    let (viewing, view) = viewing_on_a(&engines, chat).await;
+    let cursor = row_cursor(&engines.a, chat);
+    a_away_while_b_runs(&engines, chat, view, &["two", "three"]).await;
+    let links_before = pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK);
+
+    // A comes back to the chat. The room still holds everything for A, so
+    // what A missed can only come from B, over the link.
+    let _view = viewing.watch_messages();
+    wait_until(Duration::from_secs(20), "A catches up from B while the room holds it", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert_eq!(
+        replies(&engines.a, chat),
+        [reply_to("one"), reply_to("two"), reply_to("three")]
+    );
+    assert!(pairing.a_to_b.came_direct(methods::WATCH_CHAT_LINK) > links_before, "a new link to B");
+    assert!(engines.edge.held_to(&engines.a_id) > 0, "the room had it too, held back");
+    assert_eq!(row_cursor(&engines.a, chat), cursor, "catch-up from a peer never moves the row cursor");
+
+    // The room's copies arrive late and change nothing: one copy of each.
+    engines.edge.release_to(&engines.a_id);
+    wait_until(Duration::from_secs(15), "the room's held frames reach A", || {
+        engines.edge.held_to(&engines.a_id) == 0
+    })
+    .await;
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(transcript(&engines.a, chat), transcript(&engines.b, chat));
+    let ids: Vec<String> = entries(&engines.a, chat).into_iter().map(|e| e.id).collect();
+    assert_eq!(ids.iter().collect::<HashSet<_>>().len(), ids.len(), "one copy of each: {ids:?}");
+    assert_eq!(row_cursor(&engines.a, chat), cursor, "nor do the room's relayed copies");
+
+    drop(_view);
+    engines.shutdown().await;
+}
