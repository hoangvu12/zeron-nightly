diff --git a/crates/engine/src/doc_host/room_down.rs b/crates/engine/src/doc_host/room_down.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8585eeafdd8973275178f6c453cddbadef080e60
--- /dev/null
+++ b/crates/engine/src/doc_host/room_down.rs
@@ -0,0 +1,62 @@
+//! A reopened chat with its room out of reach (the edge down): the host's
+//! answer over a link is all that can come, so it settles the reopen rather
+//! than leave it to the room's redial deadline. Only a room that is out of
+//! reach counts: no session, and its dials failing since its last answer.
+//! A session that is connecting, or connected and silent (the zombie the
+//! redial exists for), still waits for its rows and is redialled.
+
+use zeron_sync::ChatClient;
+
+/// The room `client` is a member of is out of reach now.
+pub(super) fn room_down(client: &ChatClient) -> bool {
+    client.room_unreachable()
+}
+
+/// How a reopen stands, as [`super::DocHost`] checks it.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Reopen {
+    /// The room's rows caught up.
+    pub rows: bool,
+    /// The host was asked over a link.
+    pub host_asked: bool,
+    /// It answered (or wasn't asked).
+    pub answered: bool,
+    /// The room was out of reach when the host was asked, and still is.
+    pub room_down: bool,
+}
+
+impl Reopen {
+    /// Nothing more to wait for: the rows and the host's answer came, or the
+    /// room was out of reach and the host it was asked of answered.
+    pub fn settled(self) -> bool {
+        self.answered && (self.rows || (self.room_down && self.host_asked))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Reopen;
+
+    const ASKED_AND_ANSWERED: Reopen = Reopen {
+        rows: false,
+        host_asked: true,
+        answered: true,
+        room_down: false,
+    };
+
+    #[test]
+    fn with_the_room_out_of_reach_the_hosts_answer_settles_a_reopen() {
+        assert!(Reopen { room_down: true, ..ASKED_AND_ANSWERED }.settled());
+        // Not before it answers, and not unless it was asked.
+        assert!(!Reopen { room_down: true, answered: false, ..ASKED_AND_ANSWERED }.settled());
+        assert!(!Reopen { room_down: true, host_asked: false, ..ASKED_AND_ANSWERED }.settled());
+    }
+
+    /// A room connected but silent isn't down: its rows are waited for, and
+    /// past the deadline it's redialled, however the host answered.
+    #[test]
+    fn a_room_that_is_up_but_silent_still_waits_for_its_rows() {
+        assert!(!ASKED_AND_ANSWERED.settled());
+        assert!(Reopen { rows: true, ..ASKED_AND_ANSWERED }.settled());
+    }
+}
