+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_host_unreachable_a_viewer_back_from_away_catches_up_through_the_chat_room_without_waiting() {
+    let _serial = serial().await;
+    let engines = Engines::start("catchup-unreachable").await;
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    pairing.set_up();
+    let chat = "chat-catchup-unreachable";
+    engines.chat_hosted_on_b(chat).await;
+    let (viewing, view) = viewing_on_a(&engines, chat).await;
+    a_away_while_b_runs(&engines, chat, view, &["two"]).await;
+
+    // B can't be reached directly any more. A comes back; the room has
+    // what A missed and lets it through.
+    pairing.cut().await;
+    let links_up = logs::find("chat link up", &[("chat", chat)]).len();
+    let _view = viewing.watch_messages();
+    let back = tokio::time::Instant::now();
+    engines.edge.release_to(&engines.a_id);
+    wait_until(ROAD_TIMEOUT, "A catches up through the room within the road's timeout", || {
+        transcript(&engines.a, chat) == transcript(&engines.b, chat)
+    })
+    .await;
+    assert_eq!(replies(&engines.a, chat), [reply_to("one"), reply_to("two")]);
+    assert_eq!(logs::find("chat link up", &[("chat", chat)]).len(), links_up, "no link came up");
+    eprintln!("caught up through the room in {:?}", back.elapsed());
+
+    drop(_view);
+    engines.shutdown().await;
+}
