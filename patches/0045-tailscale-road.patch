+/// A port that takes a connection but never another, so none is answered.
+#[cfg(target_os = "linux")]
+struct NoAnswer {
+    at: SocketAddr,
+    _listener: tokio::net::TcpListener,
+    _filling: Vec<tokio::net::TcpStream>,
+}
+
+/// A loopback port that answers no connection, as a tailnet address whose
+/// device is gone: its backlog is full and never taken, so the OS drops a
+/// new connection's first packet (Linux) rather than refusing it.
+#[cfg(target_os = "linux")]
+async fn no_answer() -> NoAnswer {
+    let socket = tokio::net::TcpSocket::new_v4().unwrap();
+    socket.bind(SocketAddr::new(LOOPBACK, 0)).unwrap();
+    let listener = socket.listen(0).unwrap();
+    let at = listener.local_addr().unwrap();
+    let mut filling = Vec::new();
+    for _ in 0..16 {
+        match tokio::time::timeout(Duration::from_millis(300), tokio::net::TcpStream::connect(at)).await {
+            Ok(Ok(stream)) => filling.push(stream),
+            Ok(Err(error)) => panic!("this OS refuses at a full backlog rather than ignoring: {error}"),
+            Err(_) => {
+                return NoAnswer {
+                    at,
+                    _listener: listener,
+                    _filling: filling,
+                };
+            }
+        }
+    }
+    panic!("the backlog never filled");
+}
+
+/// Advertise `at` on `core`'s own row as its Tailscale endpoint, as its road
+/// would (none runs on it here).
+fn advertise(core: &EngineCore, at: SocketAddr) {
+    core.workspace.set_own_endpoints(&[zeron_doc::DeviceEndpoint {
+        kind: zeron_doc::ENDPOINT_TAILNET.into(),
+        addr: at.ip().to_string(),
+        port: at.port(),
+    }]);
+}
+
+/// How long one call from `core` to `target` takes.
+async fn timed_call(core: &EngineCore, target: &str) -> Duration {
+    let started = Instant::now();
+    call(core, methods::LIST_HARNESSES, target).await;
+    started.elapsed()
+}
+
+/// Linux only: there a full backlog stands in for a device that's gone, as
+/// Linux drops a new connection's first packet and the dial waits out its
+/// timeout. Windows refuses such a connection at once and macOS isn't relied
+/// on, and no other address on the machine never answers. What follows the
+/// failure, the backoff, is the same however a dial fails, and is checked on
+/// every OS by the next test.
+#[cfg(target_os = "linux")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_dead_endpoint_costs_about_a_second_then_the_call_takes_the_next_road() {
+    let engines = Engines::start("tailnet-dead").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+    // The relay up first, so what's timed below is the Tailscale road's cost.
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+
+    // B's row names an address nothing answers on.
+    let dead = no_answer().await;
+    advertise(&engines.b, dead.at);
+    wait_until(Duration::from_secs(20), "A's list has B's dead endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(dead.at)
+    })
+    .await;
+    // The call waits out the connect timeout, then takes the next road.
+    let took = timed_call(&engines.a, &engines.b_id).await;
+    assert!(took >= Duration::from_millis(900), "it tried the Tailscale road: {took:?}");
+    assert!(took < Duration::from_millis(1800), "about a second at most: {took:?}");
+    logs::wait_for_line(
+        "calls to this device take a new road",
+        &[("device", engines.b_id.as_str()), ("road", "relay")],
+        Duration::from_secs(5),
+    )
+    .await;
+
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_connection_closed_before_the_handshake_is_waited_out_for_the_backoffs_first_step_alone() {
+    let engines = Engines::start("tailnet-backoff").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+    // The relay up first, so what's timed below is the Tailscale road's cost.
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+
+    // B's row names an endpoint that takes each connection and closes it
+    // before any handshake, as a listener out of room even for a busy
+    // answer does, and counts each dial (cut before any connection, it
+    // never reaches what it fronts).
+    let closing = gate::Gate::front(SocketAddr::new(LOOPBACK, 9)).await;
+    closing.cut();
+    advertise(&engines.b, closing.addr());
+    wait_until(Duration::from_secs(20), "A's list has B's closing endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(closing.addr())
+    })
+    .await;
+    // Busy, not a failed road: tried once more after a moment, and once
+    // isn't held against the device.
+    timed_call(&engines.a, &engines.b_id).await;
+    assert_eq!(closing.refused(), 2, "tried once more");
+    timed_call(&engines.a, &engines.b_id).await;
+    assert_eq!(closing.refused(), 4, "dialled again at once");
+
+    // Twice in a row: waited out for 5 s, calls taking the next road at once
+    // meanwhile; and as often as it happens again, 5 s, never longer.
+    for round in ["twice in a row", "again"] {
+        let busy = Instant::now();
+        let dialled = closing.refused();
+        while closing.refused() == dialled {
+            assert!(busy.elapsed() < Duration::from_secs(8), "{round}: tried again once the wait ends");
+            let took = timed_call(&engines.a, &engines.b_id).await;
+            assert!(took < Duration::from_millis(1500), "{round}: about a second at most: {took:?}");
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+        let retried = busy.elapsed();
+        assert!(retried >= Duration::from_millis(4500), "{round}: not tried before the wait ended: {retried:?}");
+    }
+
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_peer_on_a_version_without_the_road_is_reached_the_old_way() {
+    let engines = Engines::start("tailnet-old").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config(&account, 1, Some(noted)));
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+    let at = road_b.listening().expect("B listens");
+    wait_until(Duration::from_secs(20), "A's list has B's endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(at)
+    })
+    .await;
+
+    // B goes back to a version without the road: its boot writes its row's
+    // capabilities without direct-tcp-v1, and the endpoint entry it left
+    // lingers (an old version doesn't know the field).
+    let mut row = engines
+        .b
+        .workspace
+        .read_devices()
+        .unwrap()
+        .into_iter()
+        .find(|d| d.id == engines.b_id)
+        .unwrap();
+    row.capabilities
+        .retain(|cap| cap != zeron_proto::capabilities::DIRECT_TCP_V1);
+    engines.b.workspace.upsert_device_row(&row);
+    wait_until(Duration::from_secs(20), "A sees B without the road", || {
+        endpoint_of(&engines.a, &engines.b_id).is_none()
+    })
+    .await;
+    assert_eq!(engines.a.workspace.device_endpoints(&engines.b_id).len(), 1, "the entry lingers");
+
+    // Calls reach it, the old way.
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert!(came(&seen, methods::LIST_HARNESSES).is_empty(), "not over the road");
+
+    drop(road_b);
+    engines.shutdown().await;
+}
