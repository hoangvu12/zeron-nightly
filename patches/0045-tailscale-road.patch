+    /// L7: a proof whose signature doesn't hold is refused before its key
+    /// is looked up (which could ask the edge).
+    #[tokio::test]
+    async fn a_proof_that_doesnt_hold_never_reaches_the_key_lookup() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let counting = Arc::new(Counting {
+            inner: keys(vec![desktop.row.clone()]),
+            asked: AtomicUsize::new(0),
+        });
+        let server_keys: Arc<dyn KeyCheck> = counting.clone();
+        let (near, far) = tokio::io::duplex(64 * 1024);
+        let (mut near, mut far) = (BufReader::new(near), BufReader::new(far));
+        let seen = SeenNonces::default();
+        let listen = server(
+            &mut far,
+            Ends {
+                me: desktop.id,
+                local: addr(SERVER),
+                peer: addr(CLIENT),
+                signer: &desktop.signer,
+                keys: &server_keys,
+            },
+            &seen,
+            &|_: &str| true,
+        );
+        let stranger = async {
+            let hello = json!({ "t": "hello", "v": VERSION, "from": "laptop", "to": "desktop", "nonce": nonce() });
+            write(&mut near, hello).await.unwrap();
+            let challenge = read(&mut near).await.unwrap();
+            assert_eq!(challenge["t"], "challenge");
+            // A random key, never registered, and a signature that isn't its.
+            let (key, _) = laptop.signer.sign(b"something else").unwrap();
+            let (_, sig) = laptop.signer.sign(b"not the message").unwrap();
+            write(&mut near, json!({ "t": "proof", "key": key, "sig": sig })).await.unwrap();
+        };
+        let (served, ()) = tokio::join!(listen, stranger);
+        assert_eq!(served, Err(Failed::BadSignature));
+        assert_eq!(counting.asked.load(Ordering::SeqCst), 0, "no key lookup");
+    }
