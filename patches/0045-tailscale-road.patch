+
+    /// A connection to `to` from loopback address `from` (all of 127/8 is
+    /// this machine on Linux), standing in for another tailnet machine.
+    async fn connect_from(from: [u8; 4], to: SocketAddr) -> TcpStream {
+        let socket = tokio::net::TcpSocket::new_v4().unwrap();
+        socket.bind(SocketAddr::from((from, 0))).unwrap();
+        socket.connect(to).await.unwrap()
+    }
+
+    /// What a connection hears within `wait`: a line, or "" once closed.
+    async fn hears(stream: &mut TcpStream, wait: Duration) -> Option<String> {
+        let mut heard = String::new();
+        let mut buf = [0u8; 256];
+        tokio::time::timeout(wait, async {
+            loop {
+                match stream.read(&mut buf).await {
+                    Ok(0) | Err(_) => return,
+                    Ok(n) => heard.push_str(&String::from_utf8_lossy(&buf[..n])),
+                }
+                if heard.ends_with('\n') {
+                    return;
+                }
+            }
+        })
+        .await
+        .ok()
+        .map(|()| heard)
+    }
+
+    /// M1: a stranger on the tailnet who opens connections and says nothing
+    /// holds at most two handshake slots, each for about a second; the
+    /// rest it opens are told "busy", and the person's devices still get in.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_stranger_holding_connections_open_doesnt_keep_the_devices_out() {
+        use direct_rpc::Pairing as _;
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let service: Arc<dyn RpcService> = Echo::new("tailnet");
+        let rows = keys(&[&laptop.row, &desktop.row]);
+        let road = serving(&desktop, &service, rows.clone());
+
+        let started = std::time::Instant::now();
+        let mut silent = Vec::new();
+        for _ in 0..5 {
+            silent.push(connect_from([127, 0, 0, 2], road.at).await);
+        }
+        // The first two hold a slot; the rest are told busy at once.
+        let mut busy = 0;
+        for extra in &mut silent[2..] {
+            let heard = hears(extra, Duration::from_millis(800)).await.unwrap_or_default();
+            assert!(heard.contains("busy"), "{heard:?}");
+            busy += 1;
+        }
+        assert_eq!(busy, 3);
+        // The laptop, from its own address, gets in at once.
+        let io = dialer(&laptop, Some(road.at), rows.clone())
+            .open("desktop")
+            .await
+            .expect("the laptop gets in");
+        drop(io);
+        // The silent two are closed after about a second, unheard.
+        for held in &mut silent[..2] {
+            let heard = hears(held, Duration::from_secs(3)).await.expect("closed");
+            assert!(!heard.contains("challenge"), "{heard}");
+        }
+        assert!(started.elapsed() < Duration::from_millis(2500), "{:?}", started.elapsed());
+    }
+
+    /// M1: with every slot taken, a dial is told busy, tries once more, and
+    /// isn't held against the device: the next call dials again at once
+    /// rather than waiting out a backoff.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_busy_listener_isnt_held_against_the_device() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let service: Arc<dyn RpcService> = Echo::new("tailnet");
+        let rows = keys(&[&laptop.row, &desktop.row]);
+        let road = serving(&desktop, &service, rows.clone());
+        let links = direct_rpc::Links::proven_over("tailnet", dialer(&laptop, Some(road.at), rows));
+
+        // Strangers on four addresses fill all eight slots.
+        let mut held = Vec::new();
+        for from in 2..6 {
+            for _ in 0..HANDSHAKES_PER_SOURCE {
+                held.push(connect_from([127, 0, 0, from], road.at).await);
+            }
+        }
+        let filled = std::time::Instant::now();
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        assert!(links.client("desktop").await.is_none(), "busy twice: the next road");
+        assert!(filled.elapsed() < handshake::HELLO_WAIT, "{:?}", filled.elapsed());
+        // The slots free once the silent ones are let go (about a second):
+        // the next call dials again, though 5 s haven't passed.
+        tokio::time::sleep((handshake::HELLO_WAIT + Duration::from_millis(300)).saturating_sub(filled.elapsed())).await;
+        let client = links.client("desktop").await.expect("no backoff after busy");
+        assert_eq!(client.call("Ping", json!({})).await.unwrap()["road"], "tailnet");
+        drop(held);
+    }
