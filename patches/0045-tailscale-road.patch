+    /// Calls take the Tailscale road first, then the direct link, then the
+    /// relay; the calls that need the verified caller take it too.
+    #[tokio::test]
+    async fn the_tailscale_road_comes_before_the_direct_link() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let tailnet = Echo::new("tailnet");
+        let service: Arc<dyn RpcService> = tailnet.clone();
+        let road = serving(&desktop, &service, keys(&[&laptop.row, &desktop.row]));
+        let mut relay = zeron_rpc::LinkCacheConfig::new(
+            "http://127.0.0.1:9",
+            Arc::new(zeron_rpc::StaticToken("t".into())),
+        );
+        relay.probe_timeout = Duration::from_millis(200);
+        let has_road = Arc::new(AtomicBool::new(true));
+        let serves = has_road.clone();
+        let roads = direct_rpc::Roads::new(
+            zeron_rpc::LinkCache::new(relay),
+            direct_rpc::Links::over(Arc::new(ToEcho(Echo::new("direct")))),
+            Arc::new(|_: &str| true),
+        )
+        .with_tailnet(
+            direct_rpc::Links::proven_over(
+                "tailnet",
+                dialer(&laptop, Some(road.at), keys(&[&laptop.row, &desktop.row])),
+            ),
+            Arc::new(move |_: &str| serves.load(Ordering::SeqCst)),
+        );
+        async fn ask(road: direct_rpc::Road) -> Value {
+            assert!(!road.is_relay(), "not the relay");
+            road.client.call("Ping", json!({})).await.unwrap()
+        }
+
+        let reply = ask(roads.client("desktop").await.unwrap()).await;
+        assert_eq!(reply, json!({ "road": "tailnet", "caller": { "peer": "laptop" } }));
+        let plugin = ask(roads.for_method("desktop", methods::SERVE_PLUGIN_CALL).await.unwrap()).await;
+        assert_eq!(plugin, json!({ "road": "tailnet", "caller": { "peer": "laptop" } }));
+
+        // A device without the road: the direct link.
+        has_road.store(false, Ordering::SeqCst);
+        let reply = ask(roads.client("desktop").await.unwrap()).await;
+        assert_eq!(reply["road"], "direct");
+
+        // The road's listener gone: the next road, within about a second.
+        has_road.store(true, Ordering::SeqCst);
+        roads.suspect("desktop", direct_rpc::RoadKind::Tailnet);
+        drop(road);
+        let started = std::time::Instant::now();
+        let reply = ask(roads.client("desktop").await.unwrap()).await;
+        assert_eq!(reply["road"], "direct");
+        assert!(started.elapsed() < Duration::from_secs(2), "{:?}", started.elapsed());
+    }
