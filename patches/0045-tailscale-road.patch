+    /// Counts the key checks asked of it.
+    struct Counting {
+        inner: Arc<dyn KeyCheck>,
+        asked: AtomicUsize,
+    }
+
+    #[async_trait::async_trait]
+    impl KeyCheck for Counting {
+        async fn device_key(&self, device: &str, key: &str) -> Result<(), Refused> {
+            self.asked.fetch_add(1, Ordering::SeqCst);
+            self.inner.device_key(device, key).await
+        }
+        async fn cached_key(&self, device: &str, key: &str) -> Result<(), Refused> {
+            self.asked.fetch_add(1, Ordering::SeqCst);
+            self.inner.cached_key(device, key).await
+        }
+    }
