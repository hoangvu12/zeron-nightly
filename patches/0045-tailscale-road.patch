+    /// Says whether the device stands, as a switch the test turns.
+    struct Switchable {
+        inner: Arc<dyn KeyCheck>,
+        revoked: AtomicBool,
+    }
+
+    #[async_trait::async_trait]
+    impl KeyCheck for Switchable {
+        async fn device_key(&self, device: &str, key: &str) -> Result<(), crate::device_proof::Refused> {
+            self.cached_key(device, key).await
+        }
+        async fn cached_key(&self, device: &str, key: &str) -> Result<(), crate::device_proof::Refused> {
+            if self.revoked.load(Ordering::SeqCst) {
+                return Err(crate::device_proof::Refused::Revoked);
+            }
+            self.inner.device_key(device, key).await
+        }
+    }
+
+    /// M2: a served link is checked again. It closes once its device leaves
+    /// the list (at once when the list changes), once its key is revoked
+    /// (at the next check), and once it has been served its longest.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_served_link_closes_once_its_device_no_longer_stands() {
+        use direct_rpc::Pairing as _;
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let service: Arc<dyn RpcService> = Echo::new("tailnet");
+        let checked = Arc::new(Switchable {
+            inner: keys(&[&laptop.row, &desktop.row]),
+            revoked: AtomicBool::new(false),
+        });
+        let listed = Arc::new(AtomicBool::new(true));
+        let (changed, watch) = tokio::sync::watch::channel(0u64);
+        let road = |every: Duration, lifetime: Duration| {
+            let still = listed.clone();
+            let watch = watch.clone();
+            let mut host = host(&desktop, &service, checked.clone());
+            host.admit = Arc::new(move |_| still.load(Ordering::SeqCst));
+            host.changes = Arc::new(move || direct_rpc::watch_stream(watch.clone()));
+            host.recheck = direct_rpc::Recheck { every, lifetime };
+            serving_host(host)
+        };
+        let hour = Duration::from_secs(3600);
+        let open = |at: SocketAddr| {
+            let dialer = dialer(&laptop, Some(at), checked.clone());
+            async move { direct_rpc::client(dialer.open("desktop").await.expect("proven")) }
+        };
+        let closes = |client: zeron_rpc::RpcClient| async move {
+            tokio::time::timeout(Duration::from_secs(3), client.closed()).await.is_ok()
+        };
+
+        // Removed from the list: closed as soon as the list changes, though
+        // the next timed check is an hour off.
+        let served = road(hour, hour);
+        let client = open(served.at).await;
+        assert_eq!(client.call("Ping", json!({})).await.unwrap()["caller"], json!({ "peer": "laptop" }));
+        listed.store(false, Ordering::SeqCst);
+        changed.send_replace(1);
+        assert!(closes(client).await, "closed once removed");
+        listed.store(true, Ordering::SeqCst);
+
+        // Its key revoked: closed at the next check.
+        let served = road(Duration::from_millis(200), hour);
+        let client = open(served.at).await;
+        client.call("Ping", json!({})).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        assert!(!client.is_closed(), "still standing: still served");
+        checked.revoked.store(true, Ordering::SeqCst);
+        assert!(closes(client).await, "closed once its key is revoked");
+        checked.revoked.store(false, Ordering::SeqCst);
+
+        // Served its longest: closed, to prove itself afresh.
+        let served = road(hour, Duration::from_millis(500));
+        let client = open(served.at).await;
+        client.call("Ping", json!({})).await.unwrap();
+        assert!(closes(client).await, "closed at its lifetime");
+    }
