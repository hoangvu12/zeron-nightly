+    fn device(id: &'static str) -> Device {
+        let dir = tempfile::tempdir().unwrap();
+        let key = crate::plugins::signing::load_or_create_key(dir.path()).unwrap();
+        let row = KeyRow {
+            key: key.public(),
+            fingerprint: String::new(),
+            device_id: id.into(),
+            created_at: 1,
+            revoked_at: None,
+        };
+        Device {
+            id,
+            signer: Signer::from_dir(dir.path()),
+            row,
+            _dir: dir,
+        }
+    }
+
+    fn keys(rows: Vec<KeyRow>) -> Arc<dyn KeyCheck> {
+        Arc::new(FixedKeys {
+            keys: AccountKeys::fixed(ACCOUNT, rows),
+            account: ACCOUNT.into(),
+        })
+    }
+
+    fn addr(s: &str) -> SocketAddr {
+        s.parse().unwrap()
+    }
+
+    const SERVER: &str = "100.64.0.1:27660";
+    const CLIENT: &str = "100.64.0.2:51000";
+
+    /// What each end of one handshake sees: the laptop dialling the desktop.
+    struct Run {
+        /// The laptop's own view of the addresses (local, far).
+        client_addrs: (SocketAddr, SocketAddr),
+        server_addrs: (SocketAddr, SocketAddr),
+        /// Whom the laptop dials.
+        target: &'static str,
+        /// The keys each end checks the other's against.
+        client_keys: Arc<dyn KeyCheck>,
+        server_keys: Arc<dyn KeyCheck>,
+        admit: fn(&str) -> bool,
+    }
+
+    impl Run {
+        fn new(rows: Vec<KeyRow>) -> Self {
+            Self {
+                client_addrs: (addr(CLIENT), addr(SERVER)),
+                server_addrs: (addr(SERVER), addr(CLIENT)),
+                target: "desktop",
+                client_keys: keys(rows.clone()),
+                server_keys: keys(rows),
+                admit: |_| true,
+            }
+        }
+
+        async fn between(
+            self,
+            laptop: &Device,
+            desktop: &Device,
+            seen: &SeenNonces,
+        ) -> (Result<(), Failed>, Result<String, Failed>) {
+            let (near, far) = tokio::io::duplex(64 * 1024);
+            let (mut near, mut far) = (BufReader::new(near), BufReader::new(far));
+            let dial = client(
+                &mut near,
+                Ends {
+                    me: laptop.id,
+                    local: self.client_addrs.0,
+                    peer: self.client_addrs.1,
+                    signer: &laptop.signer,
+                    keys: &self.client_keys,
+                },
+                self.target,
+            );
+            let admit = self.admit;
+            let listen = server(
+                &mut far,
+                Ends {
+                    me: desktop.id,
+                    local: self.server_addrs.0,
+                    peer: self.server_addrs.1,
+                    signer: &desktop.signer,
+                    keys: &self.server_keys,
+                },
+                seen,
+                &admit,
+            );
+            let (dialled, served) = tokio::time::timeout(Duration::from_secs(5), async { tokio::join!(dial, listen) })
+                .await
+                .expect("the handshake ends");
+            (dialled, served.map(|proven| proven.device))
+        }
+    }
+
+    /// Feed `lines` to a listener as the far end, and what it answers.
+    async fn serve_lines(desktop: &Device, server_keys: Arc<dyn KeyCheck>, lines: &[Value]) -> (Result<Proven, Failed>, String) {
+        let (near, far) = tokio::io::duplex(64 * 1024);
+        let (mut near, mut far) = (BufReader::new(near), BufReader::new(far));
+        for line in lines {
+            write(&mut near, line.clone()).await.unwrap();
+        }
+        let served = tokio::time::timeout(
+            Duration::from_secs(5),
+            server(
+                &mut far,
+                Ends {
+                    me: desktop.id,
+                    local: addr(SERVER),
+                    peer: addr(CLIENT),
+                    signer: &desktop.signer,
+                    keys: &server_keys,
+                },
+                &SeenNonces::default(),
+                &|_: &str| true,
+            ),
+        )
+        .await
+        .expect("the listener ends");
+        drop(far);
+        let mut answered = String::new();
+        let _ = near.read_to_string(&mut answered).await;
+        (served, answered)
+    }
