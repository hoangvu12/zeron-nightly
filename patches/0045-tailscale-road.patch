+        }
+        let mut other = connect_from([127, 0, 0, 8], road.at).await;
+        let heard = hears(&mut other, Duration::from_millis(400)).await.unwrap_or_default();
+        assert!(heard.contains("busy"), "{heard:?}");
+        drop((held, flood));
+    }
+
+    /// M1: a listener that closes a connection before its challenge (out of
+    /// room even for a busy answer) is busy, not a failed road: no backoff
+    /// after one, and the backoff's first step after two in a row (L4).
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_close_before_the_challenge_counts_as_busy() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let at = listener.local_addr().unwrap();
+        let accepted = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let counting = accepted.clone();
+        let closing = tokio::spawn(async move {
+            while let Ok((stream, _)) = listener.accept().await {
+                counting.fetch_add(1, Ordering::SeqCst);
+                drop(stream);
+            }
+        });
+        let links = direct_rpc::Links::proven_over(
+            "tailnet",
+            dialer(&laptop, Some(at), keys(&[&laptop.row, &desktop.row])),
+        );
+
+        assert!(links.client("desktop").await.is_none());
+        assert_eq!(accepted.load(Ordering::SeqCst), 2, "closed: tried once more");
+        assert!(links.client("desktop").await.is_none());
+        assert_eq!(accepted.load(Ordering::SeqCst), 4, "not held against the device");
+        assert!(links.client("desktop").await.is_none());
+        assert_eq!(accepted.load(Ordering::SeqCst), 4, "twice in a row: waited out");
+        closing.abort();
+    }
+
+    /// L3: the dialling end checks the device it dialled again: once the
+    /// key it proved itself with is revoked here, the link closes at the
+    /// next check, streams on it too.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_dialled_link_closes_once_the_far_devices_key_is_revoked() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let service: Arc<dyn RpcService> = Echo::new("tailnet");
+        let road = serving(&desktop, &service, keys(&[&laptop.row, &desktop.row]));
+        let checked = Arc::new(Switchable {
+            inner: keys(&[&laptop.row, &desktop.row]),
+            revoked: AtomicBool::new(false),
+        });
+        let links = direct_rpc::Links::proven_over("tailnet", dialer(&laptop, Some(road.at), checked.clone()))
+            .rechecking(direct_rpc::Recheck {
+                every: Duration::from_millis(200),
+                lifetime: Duration::from_secs(3600),
+            });
+
+        let client = links.client("desktop").await.expect("a link");
+        client.call("Ping", json!({})).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        assert!(!client.is_closed(), "still standing: still open");
+        checked.revoked.store(true, Ordering::SeqCst);
+        tokio::time::timeout(Duration::from_secs(3), client.closed())
+            .await
+            .expect("closed once its key is revoked");
+    }
+
+    /// A running engine's road is a Cloud machine's (none) by its platform,
+    /// `ZERON_DEVICE_PLATFORM`, and no other platform's is.
+    #[test]
+    fn a_cloud_machine_is_known_by_its_platform() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(TailnetConfig::from_env_on(dir.path(), zeron_proto::CLOUD_PLATFORM).cloud);
+        for other in ["linux", "macos", "windows"] {
+            assert!(!TailnetConfig::from_env_on(dir.path(), other).cloud, "{other}");
+        }
+    }
+}
