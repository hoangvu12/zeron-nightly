index 0000000000000000000000000000000000000000..9c12fd6457272e9f478c9c984ceb64f7b8eff5c8
--- /dev/null
+++ b/crates/engine/src/tailnet/address.rs
@@ -0,0 +1,338 @@
+//! This device's Tailscale address, the only one the road listens on.
+//!
+//! The engine never runs `tailscale` and never touches its configuration,
+//! Serve or Funnel: it asks the OS which local address would carry a packet
+//! to Tailscale's own resolver (100.100.100.100), and keeps it only when it
+//! is a tailnet address. Nothing is sent. With Tailscale off or missing the
+//! route takes the default gateway, a LAN address, and so none.
+//!
+//! A network that hands out carrier-grade NAT addresses (100.64.0.0/10, the
+//! same block as Tailscale's) would pass that alone with Tailscale off, and
+//! other VPNs (Cloudflare WARP: 100.96.0.0/12) use the block too, so the
+//! address must also sit on Tailscale's own interface
+//! ([`on_tailscale_interface`]):
+//!
+//! - **Linux and the BSDs:** `tailscale0` (any `tailscale*`).
+//! - **Windows:** the adapter whose description is "Tailscale Tunnel" (or
+//!   named "Tailscale"), by `GetAdaptersAddresses` (the adapter list the
+//!   preview's ICE uses, `zeron_preview::network_adapters`).
+//! - **macOS:** a `utun` interface isn't enough (every VPN has one): it must
+//!   also carry a Tailscale IPv6 address (fd7a:115c:a1e0::/48), which every
+//!   node gets on the same interface. WARP's is 2606:4700:110::/48.
+//!
+//! **An interface that can't be told counts as not Tailscale's**: the road
+//! stays off on that device. That's a device without the road, which the
+//! spec already handles (its calls take the WebRTC link or the relay, and
+//! Tailscale is never required), whereas counting it would open the
+//! listener's pre-handshake surface to everyone on an ISP's carrier-grade
+//! NAT network. A tailnet whose IPv6 is switched off on a Mac, or an OS this
+//! can't list, can still have the road by naming the address in
+//! `ZERON_TAILNET_ADDR`, which skips this check.
+
+use std::net::{IpAddr, Ipv4Addr, SocketAddr, UdpSocket};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, PoisonError};
+
+/// Tailscale's resolver, on every node's tailnet route.
+const QUAD100: Ipv4Addr = Ipv4Addr::new(100, 100, 100, 100);
+/// Tailscale's IPv6 block: every node's address there sits on the same
+/// interface as its 100.64/10 one.
+const TAILSCALE_V6: [u16; 3] = [0xfd7a, 0x115c, 0xa1e0];
+
+/// Where this device's tailnet address comes from.
+pub trait AddressSource: Send + Sync + 'static {
+    /// This device's tailnet address now, if it has one. Cheap; never waits.
+    fn current(&self) -> Option<IpAddr>;
+}
+
+/// Whether `ip` is a Tailscale node address: in 100.64.0.0/10, and not
+/// Tailscale's resolver.
+pub fn is_tailnet(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => {
+            let [a, b, ..] = v4.octets();
+            a == 100 && (64..128).contains(&b) && v4 != QUAD100
+        }
+        IpAddr::V6(_) => false,
+    }
+}
+
+fn is_tailscale_v6(ip: &IpAddr) -> bool {
+    matches!(ip, IpAddr::V6(v6) if v6.segments()[..3] == TAILSCALE_V6)
+}
+
+/// The OS's route to Tailscale's resolver, as above.
+pub struct RouteProbe;
+
+/// Said once: a tailnet-range address on an interface that isn't (or can't
+/// be told to be) Tailscale's.
+static SAID_NOT_TAILSCALE: AtomicBool = AtomicBool::new(false);
+
+impl AddressSource for RouteProbe {
+    fn current(&self) -> Option<IpAddr> {
+        tailscale_address(routed_to_quad100(), interface_of)
+    }
+}
+
+/// The local address the OS would send a packet to Tailscale's resolver
+/// from (none sent).
+fn routed_to_quad100() -> Option<IpAddr> {
+    let socket = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
+    socket.connect(SocketAddr::from((QUAD100, 53))).ok()?;
+    Some(socket.local_addr().ok()?.ip())
+}
+
+/// What [`RouteProbe`] makes of `routed`, the address the OS routes to
+/// Tailscale's resolver from, with `interface_of` naming the interface an
+/// address sits on: it, when it's a tailnet address on Tailscale's own.
+fn tailscale_address(routed: Option<IpAddr>, interface_of: impl FnOnce(IpAddr) -> Option<Interface>) -> Option<IpAddr> {
+    let ip = routed?;
+    // (Looked up only for a 100.64/10 address: nothing on a machine
+    // without Tailscale.)
+    if !is_tailnet(ip) {
+        return None;
+    }
+    let interface = interface_of(ip);
+    if on_tailscale_interface(ip, interface.as_ref()) {
+        return Some(ip);
+    }
+    if !SAID_NOT_TAILSCALE.swap(true, Ordering::Relaxed) {
+        tracing::info!(
+            %ip,
+            interface = interface.as_ref().map_or("(couldn't be told)", |i| i.name.as_str()),
+            "a 100.64/10 address that isn't Tailscale's, or can't be told to be: the Tailscale road stays off \
+             (ZERON_TAILNET_ADDR names one to use)"
+        );
+    }
+    None
+}
+
+/// The interface an address sits on, as the OS lists it.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Interface {
+    pub name: String,
+    /// Windows' adapter description ("Tailscale Tunnel"); empty elsewhere.
+    pub description: String,
+    /// Every address on it.
+    pub addrs: Vec<IpAddr>,
+}
+
+/// Whether tailnet address `ip`, found on `interface`, is Tailscale's (see
+/// the module's notes). `None`, an interface that couldn't be told: not.
+pub fn on_tailscale_interface(ip: IpAddr, interface: Option<&Interface>) -> bool {
+    let Some(interface) = interface else { return false };
+    if !is_tailnet(ip) {
+        return false;
+    }
+    let name = interface.name.to_ascii_lowercase();
+    let description = interface.description.to_ascii_lowercase();
+    if name.starts_with("tailscale") || description.starts_with("tailscale") {
+        return true;
+    }
+    name.starts_with("utun") && interface.addrs.iter().any(is_tailscale_v6)
+}
+
+/// The interface `ip` sits on, with every address on it, by the OS's list.
+#[cfg(unix)]
+fn interface_of(ip: IpAddr) -> Option<Interface> {
+    let IpAddr::V4(want) = ip else { return None };
+    let mut list: *mut libc::ifaddrs = std::ptr::null_mut();
+    // SAFETY: on success `list` is a list getifaddrs allocated, freed below
+    // and not used after.
+    if unsafe { libc::getifaddrs(&mut list) } != 0 {
+        return None;
+    }
+    // Every (interface, address) the list holds.
+    let mut entries: Vec<(String, IpAddr)> = Vec::new();
+    let mut at = list;
+    while !at.is_null() {
+        // SAFETY: `at` is a node of that list, still allocated.
+        let entry = unsafe { &*at };
+        at = entry.ifa_next;
+        if entry.ifa_addr.is_null() || entry.ifa_name.is_null() {
+            continue;
+        }
+        // SAFETY: a non-null ifa_addr points at a sockaddr of its family's
+        // size: a sockaddr_in for AF_INET, a sockaddr_in6 for AF_INET6.
+        let addr = unsafe {
+            match i32::from((*entry.ifa_addr).sa_family) {
+                libc::AF_INET => {
+                    let v4 = &*(entry.ifa_addr as *const libc::sockaddr_in);
+                    IpAddr::V4(Ipv4Addr::from(u32::from_be(v4.sin_addr.s_addr)))
+                }
+                libc::AF_INET6 => {
+                    let v6 = &*(entry.ifa_addr as *const libc::sockaddr_in6);
+                    IpAddr::V6(std::net::Ipv6Addr::from(v6.sin6_addr.s6_addr))
+                }
+                _ => continue,
+            }
+        };
+        // SAFETY: a non-null ifa_name is a NUL-terminated string.
+        let name = unsafe { std::ffi::CStr::from_ptr(entry.ifa_name) };
+        entries.push((name.to_string_lossy().into_owned(), addr));
+    }
+    // SAFETY: the list getifaddrs gave, freed once.
+    unsafe { libc::freeifaddrs(list) };
+    let name = entries
+        .iter()
+        .find(|(_, addr)| *addr == IpAddr::V4(want))
+        .map(|(name, _)| name.clone())?;
+    let addrs = entries
+        .into_iter()
+        .filter(|(on, _)| *on == name)
+        .map(|(_, addr)| addr)
+        .collect();
+    Some(Interface {
+        name,
+        description: String::new(),
+        addrs,
+    })
+}
+
+/// The adapter `ip` sits on, by `GetAdaptersAddresses`.
+#[cfg(windows)]
+fn interface_of(ip: IpAddr) -> Option<Interface> {
+    let IpAddr::V4(want) = ip else { return None };
+    let adapters = match zeron_preview::network_adapters() {
+        Ok(adapters) => adapters,
+        Err(error) => {
+            tracing::debug!(%error, "network adapters not listed; the Tailscale road can't tell its address");
+            return None;
+        }
+    };
+    adapters
+        .into_iter()
+        .find(|adapter| adapter.ipv4.contains(&want))
+        .map(|adapter| Interface {
+            name: adapter.name,
+            description: adapter.description,
+            addrs: adapter.ipv4.into_iter().map(IpAddr::V4).collect(),
+        })
+}
+
+/// Not told here: the road stays off unless `ZERON_TAILNET_ADDR` names one.
+#[cfg(not(any(unix, windows)))]
+fn interface_of(_ip: IpAddr) -> Option<Interface> {
+    None
+}
+
+/// An address set by hand: `ZERON_TAILNET_ADDR`, or a test's loopback
+/// address standing in for the tailnet one.
+#[derive(Default)]
+pub struct FixedAddress(Mutex<Option<IpAddr>>);
+
+impl FixedAddress {
+    pub fn new(ip: Option<IpAddr>) -> Self {
+        Self(Mutex::new(ip))
+    }
+
+    pub fn set(&self, ip: Option<IpAddr>) {
+        *self.0.lock().unwrap_or_else(PoisonError::into_inner) = ip;
+    }
+}
+
+impl AddressSource for FixedAddress {
+    fn current(&self) -> Option<IpAddr> {
+        *self.0.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_tailnet_node_addresses_count() {
+        for ip in ["100.64.0.1", "100.78.25.96", "100.127.255.254"] {
+            assert!(is_tailnet(ip.parse().unwrap()), "{ip}");
+        }
+        for ip in [
+            "100.100.100.100",
+            "100.63.255.255",
+            "100.128.0.1",
+            "192.168.1.20",
+            "127.0.0.1",
+            "0.0.0.0",
+            "::",
+            "fd7a:115c:a1e0::1",
+        ] {
+            assert!(!is_tailnet(ip.parse().unwrap()), "{ip}");
+        }
+    }
+
+    /// What the OS's route says, whatever this machine has: nothing without
+    /// a route; a LAN address (Tailscale off) not even looked up; a tailnet
+    /// address only on Tailscale's own interface.
+    #[test]
+    fn the_route_probe_takes_only_a_tailnet_address_on_tailscales_interface() {
+        let never = |ip: IpAddr| -> Option<Interface> { panic!("{ip} looked up") };
+        assert_eq!(tailscale_address(None, never), None, "no route");
+        assert_eq!(tailscale_address(Some("192.168.1.20".parse().unwrap()), never), None, "Tailscale off");
+        assert_eq!(tailscale_address(Some("100.100.100.100".parse().unwrap()), never), None, "the resolver");
+
+        let ip: IpAddr = "100.78.25.96".parse().unwrap();
+        let on = |name: &'static str| {
+            move |at: IpAddr| {
+                assert_eq!(at, ip, "the routed address looked up");
+                Some(named(name, "", &["100.78.25.96"]))
+            }
+        };
+        assert_eq!(tailscale_address(Some(ip), on("tailscale0")), Some(ip));
+        assert_eq!(tailscale_address(Some(ip), on("eth0")), None, "carrier-grade NAT");
+        assert_eq!(tailscale_address(Some(ip), |_| None), None, "an interface that can't be told");
+    }
+
+    fn named(name: &str, description: &str, addrs: &[&str]) -> Interface {
+        Interface {
+            name: name.into(),
+            description: description.into(),
+            addrs: addrs.iter().map(|a| a.parse().unwrap()).collect(),
+        }
+    }
+
+    /// A carrier-grade NAT address on the LAN or WAN interface, with
+    /// Tailscale off, isn't taken for the tailnet's.
+    #[test]
+    fn a_carrier_grade_nat_address_off_tailscales_interface_doesnt_count() {
+        let cgnat: IpAddr = "100.72.10.5".parse().unwrap();
+        for not_tailscale in ["eth0", "wlan0", "enp3s0", "en0", "wwan0", "ppp0"] {
+            assert!(!on_tailscale_interface(cgnat, Some(&named(not_tailscale, "", &["100.72.10.5"]))), "{not_tailscale}");
+        }
+        for tailscale in ["tailscale0", "tailscale1"] {
+            assert!(on_tailscale_interface(cgnat, Some(&named(tailscale, "", &["100.72.10.5"]))), "{tailscale}");
+        }
+        // Never anything but a tailnet address.
+        assert!(!on_tailscale_interface("192.168.1.20".parse().unwrap(), Some(&named("tailscale0", "", &[]))));
+    }
+
+    /// L3: on Windows the adapter must be Tailscale's; on macOS a `utun`
+    /// must also carry Tailscale's IPv6 address (another VPN's doesn't); and
+    /// an interface that can't be told doesn't count: the road stays off.
+    #[test]
+    fn only_tailscales_own_adapter_counts_and_one_that_cant_be_told_doesnt() {
+        let ip: IpAddr = "100.95.236.38".parse().unwrap();
+        // Windows: the adapter list says which.
+        assert!(on_tailscale_interface(ip, Some(&named("Tailscale", "Tailscale Tunnel", &["100.95.236.38"]))));
+        assert!(on_tailscale_interface(ip, Some(&named("Ethernet 4", "Tailscale Tunnel", &["100.95.236.38"]))));
+        assert!(!on_tailscale_interface(ip, Some(&named("Ethernet", "Intel(R) Ethernet Connection", &["100.95.236.38"]))));
+        assert!(!on_tailscale_interface(ip, Some(&named("Cellular", "Qualcomm WWAN", &["100.95.236.38"]))));
+        // macOS: Tailscale's utun carries its fd7a:115c:a1e0::/48 address too.
+        let tailscale = named("utun4", "", &["100.95.236.38", "fd7a:115c:a1e0::6f01:ec26", "fe80::1"]);
+        assert!(on_tailscale_interface(ip, Some(&tailscale)));
+        let warp = named("utun3", "", &["100.96.0.2", "2606:4700:110:8a4e::2", "fe80::2"]);
+        assert!(!on_tailscale_interface("100.96.0.2".parse().unwrap(), Some(&warp)), "another VPN's utun");
+        assert!(!on_tailscale_interface(ip, Some(&named("utun4", "", &["100.95.236.38"]))), "a utun alone");
+        // Couldn't be told: not Tailscale's.
+        assert!(!on_tailscale_interface(ip, None));
+    }
+
+    /// The interface an address sits on, as the OS lists it.
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn the_interface_an_address_sits_on_is_found() {
+        let lo = interface_of("127.0.0.1".parse().unwrap()).expect("loopback");
+        assert_eq!(lo.name, "lo");
+        assert!(lo.addrs.contains(&"127.0.0.1".parse().unwrap()));
+        assert_eq!(interface_of("203.0.113.77".parse().unwrap()), None, "on none here");
