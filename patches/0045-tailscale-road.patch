diff --git a/crates/engine/src/tailnet/handshake.rs b/crates/engine/src/tailnet/handshake.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c920e6418d58e007fc8fd049318766a96a50931b
--- /dev/null
+++ b/crates/engine/src/tailnet/handshake.rs
@@ -0,0 +1,1036 @@
+//! The Tailscale road's handshake: before any call, each end proves it's one
+//! of the person's devices with its Zeron device key, checked against the
+//! account's keys kept here (crate::device_proof), revocations included.
+//! Being on the tailnet proves nothing: other people's machines share it.
+//!
+//! One JSON object per line, C the end that dials and S the one that
+//! listens:
+//!
+//! 1. C→S `{"t":"hello","v":1,"from":C,"to":S,"nonce":Nc}`
+//! 2. S→C `{"t":"challenge","from":S,"nonce":Ns,"key":Ks,"sig":Ss}`
+//! 3. C→S `{"t":"proof","key":Kc,"sig":Sc}`
+//! 4. S→C `{"t":"ok"}`
+//!
+//! Either end may answer `{"t":"refused","why":"refused"}` instead, and
+//! close: the far end isn't proven yet, so it's told nothing more (why stays
+//! in this end's log). A listener with no room for another handshake answers
+//! [`BUSY`] before the hello, which the dialling end doesn't hold against the
+//! address ([`Failed::Busy`]).
+//!
+//! Each end signs [`message`]: its role, both device ids, both nonces and
+//! both addresses, so a signature made for one connection, one role or one
+//! pair of addresses proves nothing on another. The fields are joined with
+//! `:`, and none of the free ones may hold one: a nonce is exactly 43
+//! base64url characters ([`well_formed_nonce`]) and a device id has no `:`
+//! ([`well_formed_id`]), so the joined message reads back one way only. S
+//! also refuses a nonce it has seen ([`SeenNonces`]).
+//!
+//! Each end checks the other's signature before it looks the key up, so a
+//! proof that doesn't hold never reaches the account's keys (or the edge
+//! behind them). A key check waits at most [`KEY_WAIT`] on the edge, then
+//! answers from the copy kept here, so both ends' checks fit inside the
+//! dialling end's handshake deadline with the edge out of reach.
+
+use std::collections::{HashSet, VecDeque};
+use std::net::SocketAddr;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex, PoisonError};
+use std::time::{Duration, Instant, SystemTime};
+
+use base64::Engine as _;
+use futures::StreamExt as _;
+use futures::stream::BoxStream;
+use serde_json::{Value, json};
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader};
+
+use crate::device_proof::{AccountKeys, Refused};
+use crate::plugins::signing::SigningKey;
+
+/// The handshake's version.
+pub const VERSION: u64 = 1;
+/// What a listener with no room for another handshake answers, before the
+/// hello.
+pub const BUSY: &str = "{\"t\":\"refused\",\"why\":\"busy\"}\n";
+/// The longest line either end reads during the handshake.
+const MAX_LINE: usize = 4096;
+/// How long the listening end waits for the hello: a dialling end sends it
+/// the moment it connects.
+pub const HELLO_WAIT: Duration = Duration::from_secs(1);
+/// How long a key check waits on the edge before it answers from the copy
+/// kept here (the read goes on behind it). Both ends' waits together stay
+/// well inside the dialling end's handshake deadline.
+pub const KEY_WAIT: Duration = Duration::from_secs(1);
+/// How long a nonce is remembered.
+const NONCE_MEMORY: Duration = Duration::from_secs(10 * 60);
+/// At most this many remembered at once; past it the oldest go first.
+const NONCES_KEPT: usize = 16_384;
+/// A nonce: 32 random bytes, base64url without padding.
+const NONCE_LEN: usize = 43;
+/// The longest device id taken.
+const MAX_ID: usize = 256;
+
+/// Checks that a key is a device's, of the account's keys
+/// ([`AccountKeys::device_key`], `Plugins::device_key`).
+#[async_trait::async_trait]
+pub trait KeyCheck: Send + Sync + 'static {
+    async fn device_key(&self, device: &str, key: &str) -> Result<(), Refused>;
+    /// The same check against the copy kept here alone: never waits on the
+    /// edge.
+    async fn cached_key(&self, device: &str, key: &str) -> Result<(), Refused>;
+    /// Wakes when the account's keys kept here may have changed. Never, by
+    /// default.
+    fn changes(&self) -> BoxStream<'static, ()> {
+        futures::stream::pending().boxed()
+    }
+}
+
+/// `account`'s keys as `keys` has them, the edge never asked: for tests.
+#[doc(hidden)]
+pub struct FixedKeys {
+    pub keys: AccountKeys,
+    pub account: String,
+}
+
+#[async_trait::async_trait]
+impl KeyCheck for FixedKeys {
+    async fn device_key(&self, device: &str, key: &str) -> Result<(), Refused> {
+        self.keys.device_key(None, Some(&self.account), device, key).await
+    }
+
+    async fn cached_key(&self, device: &str, key: &str) -> Result<(), Refused> {
+        self.keys.device_key(None, Some(&self.account), device, key).await
+    }
+
+    fn changes(&self) -> BoxStream<'static, ()> {
+        crate::direct_rpc::watch_stream(self.keys.changes())
+    }
+}
+
+/// Signs as this device: `(its public key, the signature)`, both b64url.
+/// `None`: no key here yet.
+#[derive(Clone)]
+pub struct Signer(Arc<dyn Fn(&[u8]) -> Option<(String, String)> + Send + Sync>);
+
+/// The key file as last read: read again only once it changed (a rotation).
+type HeldKey = Option<((SystemTime, u64), Arc<SigningKey>)>;
+
+impl Signer {
+    /// With the key in `data_dir` (`plugin-signing-key`): read the first
+    /// time it signs and kept, read again only when the file changes (the
+    /// key rotated). No file: no key.
+    pub fn from_dir(data_dir: &std::path::Path) -> Self {
+        let file: PathBuf = data_dir.join(crate::plugins::signing::KEY_FILE);
+        let dir = data_dir.to_owned();
+        let held: Mutex<HeldKey> = Mutex::new(None);
+        Self(Arc::new(move |message| {
+            let key = {
+                let mut held = held.lock().unwrap_or_else(PoisonError::into_inner);
+                let Some(stamp) = std::fs::metadata(&file)
+                    .ok()
+                    .and_then(|meta| Some((meta.modified().ok()?, meta.len())))
+                else {
+                    *held = None;
+                    return None;
+                };
+                match &*held {
+                    Some((at, key)) if *at == stamp => key.clone(),
+                    _ => {
+                        let key = Arc::new(crate::plugins::signing::load_key(&dir)?);
+                        *held = Some((stamp, key.clone()));
+                        key
+                    }
+                }
+            };
+            Some((key.public(), key.sign(message)))
+        }))
+    }
+
+    fn sign(&self, message: &[u8]) -> Option<(String, String)> {
+        (self.0)(message)
+    }
+}
+
+/// Which end signs.
+#[derive(Clone, Copy)]
+enum Role {
+    Server,
+    Client,
+}
+
+/// What an end signs: `zeron-direct-tcp:v1:{role}:{signer}:{peer}:{Nc}:{Ns}:{server}:{client}`.
+/// Only ids and nonces that passed [`well_formed_id`] and
+/// [`well_formed_nonce`] reach it, so no field can carry a `:` into the next.
+fn message(role: Role, signer: &str, peer: &str, nc: &str, ns: &str, server: SocketAddr, client: SocketAddr) -> String {
+    let role = match role {
+        Role::Server => "server",
+        Role::Client => "client",
+    };
+    format!("zeron-direct-tcp:v{VERSION}:{role}:{signer}:{peer}:{nc}:{ns}:{server}:{client}")
+}
+
+/// A nonce as [`nonce`] makes one: exactly 43 base64url characters.
+pub fn well_formed_nonce(nonce: &str) -> bool {
+    nonce.len() == NONCE_LEN
+        && nonce
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
+
+/// A device id the handshake takes: not empty, not too long, no `:` (the
+/// signed message's separator) and nothing unprintable.
+pub fn well_formed_id(id: &str) -> bool {
+    !id.is_empty() && id.len() <= MAX_ID && !id.chars().any(|c| c == ':' || c.is_control())
+}
+
+/// Why a handshake didn't make a link.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Failed {
+    /// The far end's key isn't its device's, of this account's keys.
+    Key(Refused),
+    BadSignature,
+    /// The far end isn't the device dialled, or names this device wrong.
+    WrongDevice,
+    /// A device this one doesn't serve: itself, a Cloud machine, or one not
+    /// on the account's list.
+    NotAdmitted,
+    /// The client's nonce was used before.
+    Replayed,
+    /// No key here to sign with.
+    NoKey,
+    /// The listener had no room for another handshake: try again shortly,
+    /// nothing wrong with the address.
+    Busy,
+    /// The far end refused (it says no more).
+    RefusedBy(String),
+    /// Not the handshake: a line too long, not JSON, the wrong message, a
+    /// malformed field, no hello in time.
+    Protocol(String),
+    /// The stream closed or failed.
+    Closed,
+}
+
+impl std::fmt::Display for Failed {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Key(why) => write!(f, "{why}"),
+            Self::BadSignature => f.write_str("the signature doesn't hold"),
+            Self::WrongDevice => f.write_str("not the device it should be"),
+            Self::NotAdmitted => f.write_str("not a device this one serves"),
+            Self::Replayed => f.write_str("a nonce used before"),
+            Self::NoKey => f.write_str("no device key here to sign with"),
+            Self::Busy => f.write_str("the listener is busy"),
+            Self::RefusedBy(why) => write!(f, "refused: {why}"),
+            Self::Protocol(what) => write!(f, "not the handshake: {what}"),
+            Self::Closed => f.write_str("the connection closed"),
+        }
+    }
+}
+
+/// Client nonces the server has taken lately, oldest first.
+pub struct SeenNonces(Mutex<Seen>);
+
+struct Seen {
+    set: HashSet<String>,
+    order: VecDeque<(Instant, String)>,
+    cap: usize,
+}
+
+impl Default for SeenNonces {
+    fn default() -> Self {
+        Self::with_capacity(NONCES_KEPT)
+    }
+}
+
+impl SeenNonces {
+    fn with_capacity(cap: usize) -> Self {
+        Self(Mutex::new(Seen {
+            set: HashSet::new(),
+            order: VecDeque::new(),
+            cap: cap.max(1),
+        }))
+    }
+
+    /// `true` the first time `nonce` is offered within [`NONCE_MEMORY`]
+    /// (and while fewer than the cap came after it).
+    fn first(&self, nonce: &str) -> bool {
+        let mut seen = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+        let now = Instant::now();
+        let Seen { set, order, cap } = &mut *seen;
+        // Forgotten once old.
+        while order.front().is_some_and(|(at, _)| now.duration_since(*at) >= NONCE_MEMORY) {
+            if let Some((_, gone)) = order.pop_front() {
+                set.remove(&gone);
+            }
+        }
+        if set.contains(nonce) {
+            return false;
+        }
+        // Room for this one: the oldest go first.
+        while order.len() >= *cap {
+            if let Some((_, gone)) = order.pop_front() {
+                set.remove(&gone);
+            }
+        }
+        set.insert(nonce.to_owned());
+        order.push_back((now, nonce.to_owned()));
+        true
+    }
+}
+
+fn nonce() -> String {
+    use ring::rand::SecureRandom as _;
+    let mut bytes = [0u8; 32];
+    ring::rand::SystemRandom::new()
+        .fill(&mut bytes)
+        .expect("the system's random source");
+    base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(bytes)
+}
+
+async fn read<S: AsyncRead + Unpin>(io: &mut BufReader<S>) -> Result<Value, Failed> {
+    let mut line = String::new();
+    match (&mut *io).take(MAX_LINE as u64 + 1).read_line(&mut line).await {
+        Ok(0) | Err(_) => return Err(Failed::Closed),
+        Ok(_) if line.len() > MAX_LINE => return Err(Failed::Protocol("a line too long".into())),
+        Ok(_) => {}
+    }
+    let value: Value = serde_json::from_str(line.trim_end()).map_err(|_| Failed::Protocol("not JSON".into()))?;
+    if value["t"] == "refused" {
+        let why = value["why"].as_str().unwrap_or_default();
+        if why == "busy" {
+            return Err(Failed::Busy);
+        }
+        return Err(Failed::RefusedBy(why.to_owned()));
+    }
+    Ok(value)
+}
+
+async fn write<S: AsyncWrite + Unpin>(io: &mut S, value: Value) -> Result<(), Failed> {
+    let mut line = value.to_string();
+    line.push('\n');
+    io.write_all(line.as_bytes()).await.map_err(|_| Failed::Closed)?;
+    io.flush().await.map_err(|_| Failed::Closed)
+}
+
+/// Tell the far end no, and nothing more (it isn't proven: why would tell a
+/// stranger which keys and devices this account has), then fail with
+/// `failed`, which this end logs.
+async fn refuse<S: AsyncWrite + Unpin>(io: &mut S, failed: Failed) -> Failed {
+    let _ = write(io, json!({ "t": "refused", "why": "refused" })).await;
+    failed
+}
+
+fn text<'a>(value: &'a Value, field: &str) -> Result<&'a str, Failed> {
+    value[field]
+        .as_str()
+        .ok_or_else(|| Failed::Protocol(format!("no {field}")))
+}
+
+fn expect(value: &Value, t: &str) -> Result<(), Failed> {
+    if value["t"] == t {
+        Ok(())
+    } else {
+        Err(Failed::Protocol(format!("expected {t}")))
+    }
+}
+
+/// Whether `key` is `device`'s, of the account's keys: asked on a task of
+/// its own (a read of the edge finishes even if this gives up first), waited
+/// on up to [`KEY_WAIT`], then answered from the copy kept here.
+pub(crate) async fn check_key(keys: &Arc<dyn KeyCheck>, device: &str, key: &str) -> Result<(), Refused> {
+    let full = {
+        let (keys, device, key) = (keys.clone(), device.to_owned(), key.to_owned());
+        tokio::spawn(async move { keys.device_key(&device, &key).await })
+    };
+    match tokio::time::timeout(KEY_WAIT, full).await {
+        Ok(answer) => answer.unwrap_or(Err(Refused::NoKeys)),
+        Err(_) => keys.cached_key(device, key).await,
+    }
+}
+
+/// This end of one connection, and what it checks the other's with.
+pub struct Ends<'a> {
+    /// This device.
+    pub me: &'a str,
+    /// The connection's local and far addresses, as this end sees them.
+    pub local: SocketAddr,
+    pub peer: SocketAddr,
+    pub signer: &'a Signer,
+    pub keys: &'a Arc<dyn KeyCheck>,
+}
+
+/// Dial side: prove that `ends.peer` is `target` and this device to it.
+/// Nothing is sent after the proof until the far end says `ok`.
+pub async fn client<S: AsyncRead + AsyncWrite + Unpin>(
+    io: &mut BufReader<S>,
+    ends: Ends<'_>,
+    target: &str,
+) -> Result<(), Failed> {
+    client_key(io, ends, target).await.map(|_| ())
+}
+
+/// [`client`], with the key `target` proved itself with: what the dialled
+/// link is checked against again while it's open.
+pub async fn client_key<S: AsyncRead + AsyncWrite + Unpin>(
+    io: &mut BufReader<S>,
+    ends: Ends<'_>,
+    target: &str,
+) -> Result<String, Failed> {
+    let (server, client) = (ends.peer, ends.local);
+    if !well_formed_id(target) || !well_formed_id(ends.me) {
+        return Err(Failed::WrongDevice);
+    }
+    // A listener with no room even for a busy answer closes at once: a
+    // close before the challenge is busy too, not a failed road.
+    let early = |failed| match failed {
+        Failed::Closed => Failed::Busy,
+        other => other,
+    };
+    let nc = nonce();
+    write(io, json!({ "t": "hello", "v": VERSION, "from": ends.me, "to": target, "nonce": nc }))
+        .await
+        .map_err(early)?;
+
+    let challenge = read(io).await.map_err(early)?;
+    expect(&challenge, "challenge")?;
+    if text(&challenge, "from")? != target {
+        return Err(refuse(io, Failed::WrongDevice).await);
+    }
+    let (ns, key, sig) = (text(&challenge, "nonce")?, text(&challenge, "key")?, text(&challenge, "sig")?);
+    if !well_formed_nonce(ns) {
+        return Err(refuse(io, Failed::Protocol("a malformed nonce".into())).await);
+    }
+    // The signature first: one that doesn't hold costs no key lookup.
+    let signed = message(Role::Server, target, ends.me, &nc, ns, server, client);
+    if !crate::device_proof::verify_b64(key, signed.as_bytes(), sig) {
+        return Err(refuse(io, Failed::BadSignature).await);
+    }
+    if let Err(why) = check_key(ends.keys, target, key).await {
+        return Err(refuse(io, Failed::Key(why)).await);
+    }
+    let far_key = key.to_owned();
+
+    let mine = message(Role::Client, ends.me, target, &nc, ns, server, client);
+    let Some((key, sig)) = ends.signer.sign(mine.as_bytes()) else {
+        return Err(refuse(io, Failed::NoKey).await);
+    };
+    write(io, json!({ "t": "proof", "key": key, "sig": sig })).await?;
+    expect(&read(io).await?, "ok")?;
+    Ok(far_key)
+}
+
+/// The device a listener proved at the far end, and the key it proved
+/// itself with: what the link is checked against again while it's served.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Proven {
+    pub device: String,
+    pub key: String,
+}
+
+/// Listen side: the device at the far end, proven, or why not (the far end
+/// is told only no). `admit`: whether this device serves that one at all
+/// (on the account's list, not removed). The hello must come within
+/// [`HELLO_WAIT`].
+pub async fn server<S: AsyncRead + AsyncWrite + Unpin>(
+    io: &mut BufReader<S>,
+    ends: Ends<'_>,
+    seen: &SeenNonces,
+    admit: &(dyn Fn(&str) -> bool + Send + Sync),
+) -> Result<Proven, Failed> {
+    let (server, client) = (ends.local, ends.peer);
+    let hello = tokio::time::timeout(HELLO_WAIT, read(io))
+        .await
+        .map_err(|_| Failed::Protocol("no hello in time".into()))??;
+    expect(&hello, "hello")?;
+    if hello["v"].as_u64() != Some(VERSION) {
+        return Err(refuse(io, Failed::Protocol("another version".into())).await);
+    }
+    let (from, to, nc) = (text(&hello, "from")?.to_owned(), text(&hello, "to")?, text(&hello, "nonce")?.to_owned());
+    if !well_formed_id(&from) || !well_formed_nonce(&nc) {
+        return Err(refuse(io, Failed::Protocol("a malformed device id or nonce".into())).await);
+    }
+    if to != ends.me {
+        return Err(refuse(io, Failed::WrongDevice).await);
+    }
+    if from == ends.me || zeron_proto::is_cloud_device(&from, "") || !admit(&from) {
+        return Err(refuse(io, Failed::NotAdmitted).await);
+    }
+    if !seen.first(&nc) {
+        return Err(refuse(io, Failed::Replayed).await);
+    }
+
+    let ns = nonce();
+    let mine = message(Role::Server, ends.me, &from, &nc, &ns, server, client);
+    let Some((key, sig)) = ends.signer.sign(mine.as_bytes()) else {
+        return Err(refuse(io, Failed::NoKey).await);
+    };
+    write(io, json!({ "t": "challenge", "from": ends.me, "nonce": ns, "key": key, "sig": sig })).await?;
+
+    let proof = read(io).await?;
+    expect(&proof, "proof")?;
+    let (key, sig) = (text(&proof, "key")?, text(&proof, "sig")?);
+    // The signature first: a proof that doesn't hold never reaches the
+    // account's keys, nor the edge behind them.
+    let theirs = message(Role::Client, &from, ends.me, &nc, &ns, server, client);
+    if !crate::device_proof::verify_b64(key, theirs.as_bytes(), sig) {
+        return Err(refuse(io, Failed::BadSignature).await);
+    }
+    if let Err(why) = check_key(ends.keys, &from, key).await {
+        return Err(refuse(io, Failed::Key(why)).await);
+    }
+    write(io, json!({ "t": "ok" })).await?;
+    Ok(Proven {
+        device: from,
+        key: key.to_owned(),
+    })
+}
