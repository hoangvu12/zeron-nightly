diff --git a/crates/engine/tests/edge_down.rs b/crates/engine/tests/edge_down.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2f7bddb7c45f6a64e544186bcc135ac23d007064
--- /dev/null
+++ b/crates/engine/tests/edge_down.rs
@@ -0,0 +1,568 @@
+//! The person's desktops keep working together while the edge is down.
+//!
+//! Two real engines serve the Tailscale road on a loopback address (standing
+//! in for each one's tailnet address). Before the edge goes, each already
+//! lists the other with its endpoint, and both have the account's keys: the
+//! road only serves devices on its own cached list, and with the edge down a
+//! key missing from the saved list is refused. Then the gate in front of the
+//! fake edge is cut, which takes every edge room away (registry, chat rooms,
+//! device rooms, nudges).
+//!
+//! - A fresh Tailscale connection forms; a forwarded call (the first, timed,
+//!   as the road comes back), a file read, a file watch and a streamed reply
+//!   cross it, and nothing waits on the edge's timeouts.
+//! - A read cut off on the Tailscale road is asked again on the next road (the
+//!   direct link), not straight on the relay; with no direct link and the
+//!   edge blackholed, it fails at once rather than wait on the edge; a call
+//!   that isn't a read isn't asked again anywhere (0038's rule).
+//! - Reopening a chat with its room down is settled by the host's answer
+//!   over the link, not left to the room's 20 s deadline.
+//! - When the edge comes back, the ChatRoom gets what was written meanwhile,
+//!   and every write lands once.
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+
+use std::collections::HashSet;
+use std::net::{IpAddr, Ipv4Addr};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use async_trait::async_trait;
+use engines::{Engines, entries, replies, reply_to, send, serial, text_of, wait_until};
+use zeron_doc::{MessageRole, SessionCommandPayload};
+use zeron_engine::device_proof::AccountKeys;
+use zeron_engine::plugins::keys::KeyRow;
+use zeron_engine::tailnet::{
+    FixedAddress, FixedKeys, KeyCheck, Signer, TailnetConfig, TailnetRoad,
+    peer_endpoint_allowing_loopback as peer_endpoint,
+};
+use zeron_engine::{ChatDocHandle, EngineCore};
+use zeron_rpc::{RpcError, RpcReply, RpcService, methods};
+
+const LOOPBACK: IpAddr = IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1));
+
+/// Each engine's signing key (in a folder of its own), and the account's
+/// keys as both have them saved.
+struct Account {
+    keys: Arc<dyn KeyCheck>,
+    signers: [Signer; 2],
+    _dirs: [tempfile::TempDir; 2],
+}
+
+fn account(a: &str, b: &str) -> Account {
+    let dirs = [tempfile::tempdir().unwrap(), tempfile::tempdir().unwrap()];
+    let row = |dir: &tempfile::TempDir, device: &str| KeyRow {
+        key: zeron_engine::plugins::signing::load_or_create_key(dir.path()).unwrap().public(),
+        fingerprint: String::new(),
+        device_id: device.into(),
+        created_at: 1,
+        revoked_at: None,
+    };
+    let rows = vec![row(&dirs[0], a), row(&dirs[1], b)];
+    Account {
+        keys: Arc::new(FixedKeys {
+            keys: AccountKeys::fixed("test-account", rows),
+            account: "test-account".into(),
+        }),
+        signers: [Signer::from_dir(dirs[0].path()), Signer::from_dir(dirs[1].path())],
+        _dirs: dirs,
+    }
+}
+
+/// `core`'s Tailscale road on loopback at `port` (0: any), served by
+/// `serve` (`None`: the engine's own service).
+fn road(core: &EngineCore, account: &Account, which: usize, port: u16, serve: Option<Arc<dyn RpcService>>) -> TailnetRoad {
+    core.start_tailnet_road(TailnetConfig {
+        source: Arc::new(FixedAddress::new(Some(LOOPBACK))),
+        port,
+        signer: account.signers[which].clone(),
+        keys: Some(account.keys.clone()),
+        cloud: false,
+        serve,
+        enabled: true,
+        poll: Duration::from_millis(100),
+        // Loopback stands in for the tailnet here.
+        allow_loopback: true,
+    })
+}
+
+/// Both engines on the road, each listing the other with its endpoint:
+/// what they must know before the edge goes. B's road is served by
+/// `serve_b`, if given. Returns (A's road, B's road).
+async fn on_the_road(engines: &Engines, account: &Account, serve_b: Option<Arc<dyn RpcService>>) -> (TailnetRoad, TailnetRoad) {
+    let b = road(&engines.b, account, 1, 0, serve_b);
+    let a = road(&engines.a, account, 0, 0, None);
+    let (at_a, at_b) = (a.listening().expect("A listens"), b.listening().expect("B listens"));
+    wait_until(Duration::from_secs(20), "each lists the other's Tailscale endpoint", || {
+        peer_endpoint(&engines.a.workspace, &engines.b_id) == Some(at_b)
+            && peer_endpoint(&engines.b.workspace, &engines.a_id) == Some(at_a)
+    })
+    .await;
+    (a, b)
+}
+
+/// The stand-in direct link both ways, up, with each engine's row for the
+/// other still advertising the Tailscale road (the stand-in's row doesn't).
+fn with_direct_links(engines: &Engines) -> direct::DirectPairing {
+    let pairing = direct::pair_both_ways(&engines.a, &engines.b);
+    for (core, other) in [(&engines.a, &engines.b_id), (&engines.b, &engines.a_id)] {
+        let mut row = direct::direct_device_row(other);
+        row.capabilities.push(zeron_proto::capabilities::DIRECT_TCP_V1.to_owned());
+        core.workspace.upsert_device_row(&row);
+    }
+    pairing.set_up();
+    pairing
+}
+
+/// One device-addressed call from `core` to `target`, asked once.
+async fn call_once(core: &EngineCore, method: &str, target: &str, params: serde_json::Value) -> Result<serde_json::Value, RpcError> {
+    let mut params = params;
+    params["targetDeviceId"] = serde_json::json!(target);
+    zeron_rpc::memory_client(core.rpc_service()).call(method, params).await
+}
+
+/// Captured lines after the first `mark` with `message` and every field.
+fn since(mark: usize, message: &str, fields: &[(&str, &str)]) -> Vec<String> {
+    logs::lines()
+        .into_iter()
+        .skip(mark)
+        .filter(|line| line.contains(message) && fields.iter().all(|(k, v)| logs::has_field(line, k, v)))
+        .collect()
+}
+
+/// Wait up to `within` for a line after `mark` with `message` and every field.
+async fn wait_since(mark: usize, message: &str, fields: &[(&str, &str)], within: Duration) -> String {
+    let deadline = Instant::now() + within;
+    loop {
+        if let Some(line) = since(mark, message, fields).into_iter().next() {
+            return line;
+        }
+        assert!(Instant::now() < deadline, "no log line {message:?} with {fields:?} within {within:?}");
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+/// The assistant's text in the chat `handle` holds, one string per entry.
+fn replies_in(handle: &ChatDocHandle) -> Vec<String> {
+    handle
+        .doc()
+        .read_entries()
+        .unwrap_or_default()
+        .iter()
+        .filter(|e| e.role == MessageRole::Assistant)
+        .map(text_of)
+        .collect()
+}
+
+/// The user's messages in `chat` on `core` whose text is `text`.
+fn user_messages(core: &EngineCore, chat: &str, text: &str) -> usize {
+    entries(core, chat)
+        .iter()
+        .filter(|e| e.role == MessageRole::User && text_of(e) == text)
+        .count()
+}
+
+/// B's service on its Tailscale road, which notes each call that came and,
+/// the first time `cut_on` comes, switches the road off with the call still
+/// on it and never answers: the connection closes under the call, as a
+/// dropped tailnet path does. (The call's own task is the last thing holding
+/// the connection open once the road's link is gone, so it ends without a
+/// word, by panicking.)
+struct CutsTheRoad {
+    inner: Arc<dyn RpcService>,
+    cut_on: &'static str,
+    road: Arc<OnceLock<TailnetRoad>>,
+    seen: Arc<Mutex<Vec<String>>>,
+}
+
+#[async_trait]
+impl RpcService for CutsTheRoad {
+    async fn handle(&self, method: &str, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        self.seen.lock().unwrap().push(method.to_owned());
+        if method == self.cut_on {
+            if let Some(road) = self.road.get() {
+                road.set_enabled(false);
+            }
+            tokio::time::sleep(Duration::from_millis(200)).await;
+            panic!("the Tailscale road was cut under this call (expected)");
+        }
+        self.inner.handle(method, params).await
+    }
+}
+
+/// Engines on the road and the direct link, B's road cut by the first
+/// `cut_on`, and the edge cut. Returns what came over B's road and A's road.
+async fn edge_down_with_a_road_that_cuts(
+    engines: &Engines,
+    account: &Account,
+    cut_on: &'static str,
+) -> (direct::DirectPairing, Arc<Mutex<Vec<String>>>, TailnetRoad) {
+    let pairing = with_direct_links(engines);
+    let (seen, road_a) = on_a_road_that_cuts(engines, account, cut_on).await;
+    engines.gate.cut();
+    (pairing, seen, road_a)
+}
+
+/// Engines on the road, B's road cut by the first `cut_on` (none: never).
+/// Returns what came over B's road, and A's road.
+async fn on_a_road_that_cuts(engines: &Engines, account: &Account, cut_on: &'static str) -> (Arc<Mutex<Vec<String>>>, TailnetRoad) {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let cuts = Arc::new(OnceLock::new());
+    let service: Arc<dyn RpcService> = Arc::new(CutsTheRoad {
+        inner: engines.b.rpc_service(),
+        cut_on,
+        road: cuts.clone(),
+        seen: seen.clone(),
+    });
+    let (road_a, road_b) = on_the_road(engines, account, Some(service)).await;
+    assert!(cuts.set(road_b).is_ok());
+    (seen, road_a)
+}
+
+/// B's service on its road, noting what comes that way.
+fn noting(engines: &Engines) -> (Arc<dyn RpcService>, Arc<Mutex<Vec<String>>>) {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let service = Arc::new(CutsTheRoad {
+        inner: engines.b.rpc_service(),
+        cut_on: "",
+        road: Arc::new(OnceLock::new()),
+        seen: seen.clone(),
+    });
+    (service, seen)
+}
+
+/// Wait until `core`'s registry room has noticed the edge is gone.
+async fn registry_down(core: &EngineCore) {
+    wait_until(Duration::from_secs(15), "the registry room notices the edge is gone", || {
+        !core.workspace.sync_status().is_some_and(|room| room.connected)
+    })
+    .await;
+}
+
+fn came(seen: &Mutex<Vec<String>>, method: &str) -> usize {
+    seen.lock().unwrap().iter().filter(|m| m.as_str() == method).count()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_down_a_read_cut_off_on_the_tailscale_road_is_answered_on_the_next_road() {
+    let _serial = serial().await;
+    let engines = Engines::start("edgedown-read").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (pairing, seen, _road_a) = edge_down_with_a_road_that_cuts(&engines, &account, methods::LIST_HARNESSES).await;
+
+    let started = Instant::now();
+    let answer = call_once(&engines.a, methods::LIST_HARNESSES, &engines.b_id, serde_json::json!({})).await;
+    let took = started.elapsed();
+    assert!(answer.is_ok(), "the read was answered with the edge down: {answer:?}");
+    assert_eq!(came(&seen, methods::LIST_HARNESSES), 1, "it took the Tailscale road first");
+    assert_eq!(pairing.a_to_b.came_direct(methods::LIST_HARNESSES), 1, "then the direct link, the next road");
+    assert!(took < Duration::from_secs(3), "no wait on the edge: {took:?}");
+
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_call_that_isnt_a_read_cut_off_on_the_tailscale_road_isnt_asked_again_on_another_road() {
+    let _serial = serial().await;
+    let engines = Engines::start("edgedown-write").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (pairing, seen, _road_a) = edge_down_with_a_road_that_cuts(&engines, &account, methods::RUN_COMMAND).await;
+
+    let answer = call_once(
+        &engines.a,
+        methods::RUN_COMMAND,
+        &engines.b_id,
+        serde_json::json!({ "command": "true" }),
+    )
+    .await;
+    assert!(answer.is_err(), "cut off, it fails: {answer:?}");
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(came(&seen, methods::RUN_COMMAND), 1, "it took the Tailscale road");
+    assert_eq!(pairing.a_to_b.came_direct(methods::RUN_COMMAND), 0, "and wasn't run again on the direct link");
+
+    engines.shutdown().await;
+}
+
+/// No direct link, and the edge blackholed (it takes connections and never
+/// answers, so a relay dial would wait on its timeouts): a read cut off on the
+/// Tailscale road fails at once, with the road's own error, rather than be
+/// asked of the relay.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_blackholed_and_no_direct_link_a_read_cut_off_fails_at_once() {
+    let _serial = serial().await;
+    let engines = Engines::start("edgedown-blackhole").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (seen, _road_a) = on_a_road_that_cuts(&engines, &account, methods::LIST_HARNESSES).await;
+    engines.gate.blackhole();
+    registry_down(&engines.a).await;
+
+    let started = Instant::now();
+    let answer = call_once(&engines.a, methods::LIST_HARNESSES, &engines.b_id, serde_json::json!({})).await;
+    let took = started.elapsed();
+    assert_eq!(came(&seen, methods::LIST_HARNESSES), 1, "it took the Tailscale road");
+    // (Closed, as the road saw it; the local client gets its text.)
+    let error = answer.expect_err("cut off, with no other road").to_string();
+    assert!(error.contains("connection closed"), "the road's own error, not the relay's: {error}");
+    assert!(took < Duration::from_secs(3), "nothing waited on the edge: {took:?}");
+
+    engines.shutdown().await;
+}
+
+/// A file read and a file watch on B, asked from A with the edge down, cross
+/// the Tailscale road.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_down_a_file_read_and_a_file_watch_cross_the_tailscale_road() {
+    let _serial = serial().await;
+    let engines = Engines::start("edgedown-files").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let repo = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(repo.path().join("src")).unwrap();
+    std::fs::write(repo.path().join("src/remote.rs"), "pub const REMOTE: bool = true;\n").unwrap();
+    for args in [&["init", "-q", "-b", "main"][..], &["add", "."], &["-c", "user.name=t", "-c", "user.email=t@t", "commit", "-qm", "initial"]] {
+        let done = std::process::Command::new("git").args(args).current_dir(repo.path()).status().expect("git");
+        assert!(done.success(), "git {args:?}");
+    }
+    let chat = "chat-edgedown-files";
+    engines
+        .b
+        .workspace
+        .create_space("space-edgedown-files", &engines.b_id, &repo.path().to_string_lossy(), None, true)
+        .expect("space on B");
+    engines.b.workspace.create_chat(chat, Some("space-edgedown-files"), None, None, None).expect("chat on B");
+    let (service, seen) = noting(&engines);
+    let (_road_a, _road_b) = on_the_road(&engines, &account, Some(service)).await;
+    engines.gate.cut();
+
+    let params = |extra: serde_json::Value| {
+        let mut params = serde_json::json!({ "chatId": chat, "targetDeviceId": engines.b_id });
+        params.as_object_mut().unwrap().extend(extra.as_object().unwrap().clone());
+        params
+    };
+    let client = zeron_rpc::memory_client(engines.a.rpc_service());
+    let started = Instant::now();
+    let read = client
+        .call(methods::READ_WORKSPACE_FILE, params(serde_json::json!({ "path": "src/remote.rs" })))
+        .await
+        .expect("read with the edge down");
+    assert!(read["text"].as_str().is_some_and(|text| text.contains("REMOTE")), "{read}");
+    assert!(started.elapsed() < Duration::from_secs(3), "no wait on the edge: {:?}", started.elapsed());
+    assert_eq!(came(&seen, methods::READ_WORKSPACE_FILE), 1, "over the Tailscale road");
+
+    let mut watch = client
+        .subscribe(methods::WATCH_WORKSPACE_FILES, params(serde_json::json!({})))
+        .await
+        .expect("watch with the edge down");
+    let baseline = tokio::time::timeout(Duration::from_secs(5), watch.recv())
+        .await
+        .expect("the watch's first item")
+        .expect("watch alive");
+    assert_eq!(baseline["resyncRequired"], true);
+    std::fs::write(repo.path().join("created-on-b.txt"), "created\n").unwrap();
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(10);
+    loop {
+        let item = tokio::time::timeout_at(deadline, watch.recv())
+            .await
+            .expect("B's change streams to A")
+            .expect("watch alive");
+        if item["changes"].as_array().is_some_and(|changes| changes.iter().any(|c| c["path"] == "created-on-b.txt")) {
+            break;
+        }
+    }
+    assert_eq!(came(&seen, methods::WATCH_WORKSPACE_FILES), 1, "over the Tailscale road");
+
+    drop(watch);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_down_desktops_that_know_each_other_keep_working_over_the_tailscale_road() {
+    let _serial = serial().await;
+    let engines = Engines::start("edgedown-work").await;
+    let (a_id, b_id) = (engines.a_id.clone(), engines.b_id.clone());
+    let account = account(&a_id, &b_id);
+    let (_road_a, road_b) = on_the_road(&engines, &account, None).await;
+    let chat = "chat-edgedown-work";
+    engines.chat_hosted_on_b(chat).await;
+
+    // A has the chat on screen, linked to B; the reply to one came.
+    let viewing = engines.a.doc_host.open(chat).expect("open on A");
+    let _view = viewing.watch_messages();
+    send(&engines.a, chat, "one", "msg-one").await;
+    wait_until(Duration::from_secs(30), "the reply to one reaches A", || {
+        replies_in(&viewing) == [reply_to("one")]
+    })
+    .await;
+    logs::wait_for_line(
+        "chat link up",
+        &[("chat", chat), ("device", b_id.as_str()), ("road", "tailnet")],
+        Duration::from_secs(30),
+    )
+    .await;
+    let enqueued_before: HashSet<String> = engines.edge.enqueued(chat).into_iter().collect();
+
+    // The edge goes. B's road starts again on the same address and port,
+    // which closes every Tailscale connection: what follows is a fresh one,
+    // from what each had cached.
+    engines.gate.cut();
+    let mark = logs::lines().len();
+    let at = road_b.listening().expect("B listens");
+    drop(road_b);
+    // (The old listener closes on its own task: wait for its port.)
+    wait_until(Duration::from_secs(5), "the old listener lets its port go", || {
+        std::net::TcpListener::bind(at).is_ok()
+    })
+    .await;
+    let (service, seen) = noting(&engines);
+    let _road_b = road(&engines.b, &account, 1, at.port(), Some(service));
+    assert_eq!(_road_b.listening(), Some(at));
+
+    // At once, a forwarded call takes a fresh Tailscale connection, with no
+    // wait on the edge: a dial that found B's port closed a moment ago (it
+    // was refused) set no wait on the road.
+    let started = Instant::now();
+    call_once(&engines.a, methods::LIST_HARNESSES, &b_id, serde_json::json!({}))
+        .await
+        .expect("answered with the edge down");
+    let took = started.elapsed();
+    assert!(took < Duration::from_secs(3), "no wait on the edge: {took:?}");
+    assert_eq!(came(&seen, methods::LIST_HARNESSES), 1, "over the Tailscale road");
+
+    // A's chat link comes back over it too; B serves it as A's.
+    wait_since(
+        mark,
+        "chat link up",
+        &[("chat", chat), ("device", b_id.as_str()), ("road", "tailnet")],
+        Duration::from_secs(30),
+    )
+    .await;
+    assert!(!since(mark, "direct RPC link up", &[("device", b_id.as_str()), ("road", "tailnet")]).is_empty());
+    assert!(!since(mark, "tailnet link serving calls from this device", &[("device", a_id.as_str())]).is_empty());
+
+    // A reply B streams reaches A whole.
+    send(&engines.b, chat, "two", "msg-two").await;
+    wait_until(Duration::from_secs(30), "the reply to two reaches A with the edge down", || {
+        replies_in(&viewing) == [reply_to("one"), reply_to("two")]
+    })
+    .await;
+
+    // Reopened with its room down, the chat is settled by the host's answer
+    // over the link, well inside the room's 20 s deadline, and never redialled.
+    let reopen_mark = logs::lines().len();
+    let deadline = Instant::now() + Duration::from_secs(40);
+    let settled = loop {
+        let _ = engines.a.doc_host.open(chat);
+        let done = since(reopen_mark, "chat2 reopen:", &[("chat", chat)]);
+        if let Some(line) = done.into_iter().next() {
+            break line;
+        }
+        assert!(Instant::now() < deadline, "a reopen with the room down never settled");
+        tokio::time::sleep(Duration::from_millis(250)).await;
+    };
+    assert!(settled.contains("chat2 reopen: caught up"), "settled by the host's answer: {settled}");
+    let elapsed_ms: u64 = settled
+        .split_whitespace()
+        .find_map(|word| word.strip_prefix("elapsed_ms="))
+        .and_then(|ms| ms.parse().ok())
+        .expect("elapsed_ms");
+    assert!(elapsed_ms < 3_000, "nothing waits on the room's deadline: {settled}");
+    assert!(logs::has_field(&settled, "room_down", "true"), "settled by the host's answer, the room out of reach: {settled}");
+    let asked = since(reopen_mark, "chat2 reopened while connected", &[("chat", chat)]);
+    assert!(asked.iter().all(|line| logs::has_field(line, "asks_host", "true")), "{asked:?}");
+    assert!(since(mark, "redialing", &[("chat", chat)]).is_empty(), "never redialled");
+
+    // A sends: it reaches B over the road and B's turn starts at once; the
+    // reply streams back to A. What A writes meanwhile waits in its outbox
+    // for the ChatRoom: note each write's batches.
+    let pending = || -> HashSet<String> {
+        engines.a.doc_host.store().pending_chat_updates(chat).unwrap().into_iter().map(|(batch, _)| batch).collect()
+    };
+    let before_send = pending();
+    let sent = Instant::now();
+    send(&engines.a, chat, "three", "msg-three").await;
+    wait_until(Duration::from_secs(5), "B's turn for A's send starts with the edge down", || {
+        replies(&engines.b, chat).iter().any(|reply| reply.starts_with("three:part-0"))
+    })
+    .await;
+    eprintln!("B's turn for the send started {:?} after it", sent.elapsed());
+    wait_until(Duration::from_secs(30), "the reply to three reaches A with the edge down", || {
+        replies_in(&viewing) == [reply_to("one"), reply_to("two"), reply_to("three")]
+    })
+    .await;
+
+    let send_batches: HashSet<String> = pending().difference(&before_send).cloned().collect();
+
+    // A writes in the chat meanwhile: it reaches B over the link.
+    let before_note = pending();
+    let at_ms = chrono::Utc::now().timestamp_millis();
+    viewing
+        .write_user_message("note-from-a", "written on A with the edge down", at_ms)
+        .expect("write on A");
+    wait_until(Duration::from_secs(15), "A's note reaches B with the edge down", || {
+        entries(&engines.b, chat).iter().any(|e| e.id == "note-from-a")
+    })
+    .await;
+
+    let note_batches: HashSet<String> = pending().difference(&before_note).cloned().collect();
+    assert!(!note_batches.is_empty(), "A's note waits in its outbox for the ChatRoom");
+    let outage: HashSet<String> = send_batches.union(&note_batches).cloned().collect();
+    assert!(outage.iter().all(|batch| !enqueued_before.contains(batch)));
+    eprintln!("A's writes during the outage: send {send_batches:?}, note {note_batches:?}");
+
+    // The edge comes back. Each write A made meanwhile reaches the ChatRoom's
+    // queue and B confirms it, each once; every entry is there once, on both.
+    engines.gate.restore();
+    wait_until(Duration::from_secs(60), "the ChatRoom has A's writes from the outage, delivered", || {
+        let delivered = engines.edge.delivered(chat);
+        outage.iter().all(|batch| delivered.contains(batch)) && engines.edge.queued(chat).is_empty()
+    })
+    .await;
+    let (enqueued, delivered) = (engines.edge.enqueued(chat), engines.edge.delivered(chat));
+    for batch in &outage {
+        assert_eq!(enqueued.iter().filter(|b| *b == batch).count(), 1, "{batch} enqueued once: {enqueued:?}");
+        assert_eq!(delivered.iter().filter(|b| *b == batch).count(), 1, "{batch} delivered once: {delivered:?}");
+    }
+    assert_eq!(delivered.iter().collect::<HashSet<_>>().len(), delivered.len(), "each delivered once: {delivered:?}");
+    wait_until(Duration::from_secs(15), "A's outbox empties", || pending().is_empty()).await;
+    // The send ran once: one message, one turn, and the same command handed
+    // over again (as the escort's relay would) is a duplicate.
+    tokio::time::sleep(Duration::from_secs(2)).await;
+    let all = [reply_to("one"), reply_to("two"), reply_to("three")];
+    assert_eq!(replies(&engines.b, chat), all, "one turn for each send");
+    assert_eq!(user_messages(&engines.b, chat, "three"), 1, "one message for the send");
+    let command = engines
+        .b
+        .doc_host
+        .open(chat)
+        .expect("open on B")
+        .doc()
+        .read_commands()
+        .expect("B's commands")
+        .into_iter()
+        .find(|c| matches!(&c.payload, SessionCommandPayload::Run { message_id, .. } if message_id == "msg-three"))
+        .expect("the send reached B's doc");
+    let again = engines.b.doc_host.ingest_relayed_command(chat, command).await.expect("handed over again");
+    assert_eq!(again, "duplicate");
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    assert_eq!(replies(&engines.b, chat), all);
+    for core in [&engines.a, &engines.b] {
+        let ids: Vec<String> = entries(core, chat).into_iter().map(|e| e.id).collect();
+        assert_eq!(ids.iter().collect::<HashSet<_>>().len(), ids.len(), "each entry once: {ids:?}");
+        assert_eq!(ids.iter().filter(|id| id.as_str() == "note-from-a").count(), 1);
+    }
+    wait_until(Duration::from_secs(15), "A's and B's transcripts agree", || {
+        serde_json::to_value(entries(&engines.a, chat)).ok() == serde_json::to_value(entries(&engines.b, chat)).ok()
+    })
+    .await;
+
+    drop(_view);
+    engines.shutdown().await;
+}
