+        Host::new(
+            device.id.into(),
+            device.signer.clone(),
+            keys,
+            Arc::new(|_| true),
+            Arc::downgrade(service),
+            Arc::new(|| futures::stream::pending().boxed()),
+        )
+    }
+
+    /// `device` listening on loopback with `service`, checking keys with `keys`.
+    fn serving(device: &Device, service: &Arc<dyn RpcService>, keys: Arc<dyn KeyCheck>) -> Listener {
+        serving_host(host(device, service, keys))
+    }
+
+    fn serving_host(host: Host) -> Listener {
+        let listener = bind("127.0.0.1".parse().unwrap(), 0).unwrap();
+        listen(listener, Arc::new(host)).unwrap()
+    }
+
+    fn dialer(device: &Device, to: Option<SocketAddr>, keys: Arc<dyn KeyCheck>) -> Arc<Dialer> {
+        Arc::new(Dialer {
+            listed: Arc::new(|_| true),
+            far_keys: Mutex::default(),
+            me: device.id.into(),
+            endpoint: Arc::new(move |_| to),
+            signer: device.signer.clone(),
+            keys,
+        })
+    }
