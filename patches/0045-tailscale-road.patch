+/// Resolves, with why, once a link served as a proven device must close:
+/// `holds` (asked every [`Recheck::every`] and whenever `changes` wakes)
+/// says the device no longer stands (removed from the list, its key revoked
+/// or gone), or the link has been served for [`Recheck::lifetime`]. Run
+/// beside the link's serving, which stops when this resolves.
+pub async fn lapsed<F, Fut>(mut holds: F, mut changes: futures::stream::BoxStream<'static, ()>, timing: Recheck) -> String
+where
+    F: FnMut() -> Fut + Send,
+    Fut: std::future::Future<Output = Result<(), String>> + Send,
+{
+    use futures::StreamExt as _;
+    let end = tokio::time::sleep(timing.lifetime);
+    tokio::pin!(end);
+    let mut every = tokio::time::interval_at(Instant::now() + timing.every, timing.every);
+    every.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    let mut watching = true;
+    loop {
+        tokio::select! {
+            () = &mut end => return "served for its longest; it proves itself afresh".into(),
+            _ = every.tick() => {}
+            changed = changes.next(), if watching => {
+                if changed.is_none() {
+                    watching = false;
+                    continue;
+                }
+            }
+        }
+        if let Err(why) = holds().await {
+            return why;
+        }
+    }
+}
+
+/// Each change `receiver` sees after now, as a stream.
+pub fn watch_stream<T: Send + Sync + 'static>(
+    mut receiver: tokio::sync::watch::Receiver<T>,
+) -> futures::stream::BoxStream<'static, ()> {
+    use futures::StreamExt as _;
+    receiver.borrow_and_update();
+    futures::stream::unfold(receiver, |mut receiver| async move {
+        receiver.changed().await.ok()?;
+        Some(((), receiver))
+    })
+    .boxed()
+}
