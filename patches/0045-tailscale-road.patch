+        let first = crate::plugins::signing::load_or_create_key(dir.path()).unwrap().public();
+        let signer = Signer::from_dir(dir.path());
+        assert_eq!(signer.sign(b"m").map(|(key, _)| key), Some(first.clone()));
+        assert_eq!(signer.sign(b"m").map(|(key, _)| key), Some(first.clone()));
+        std::thread::sleep(Duration::from_millis(20));
