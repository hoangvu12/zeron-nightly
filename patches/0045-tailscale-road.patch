+    /// The direct link's stand-in: streams reach an [`Echo`] of its own.
+    struct ToEcho(Arc<Echo>);
+
+    #[async_trait::async_trait]
+    impl direct_rpc::Pairing for ToEcho {
+        async fn ready(&self, _device: &str) -> bool {
+            true
+        }
+        fn warm(&self, _device: &str) {}
+        async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+            let (near, far) = tokio::io::duplex(64 * 1024);
+            let service: Arc<dyn RpcService> = self.0.clone();
+            tokio::spawn(direct_rpc::serve(zeron_rpc::device_room::peer_service(service, None), far));
+            Ok(Box::new(near))
+        }
+    }
