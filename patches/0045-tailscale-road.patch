+    #[tokio::test]
+    async fn a_connection_that_cant_prove_itself_is_refused_before_any_call() {
+        use direct_rpc::Pairing as _;
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let echo = Echo::new("tailnet");
+        let service: Arc<dyn RpcService> = echo.clone();
+        let road = serving(&desktop, &service, keys(&[&laptop.row, &desktop.row]));
+        let at = Some(road.at);
+
+        // A device of another account: refused at the handshake.
+        let stranger = device("laptop");
+        let dialled = dialer(&stranger, at, keys(&[&desktop.row])).open("desktop").await;
+        assert!(dialled.is_err());
+        // Something that skips the handshake and calls at once.
+        let mut raw = TcpStream::connect(at.unwrap()).await.unwrap();
+        let frame = json!({ "id": 1, "method": methods::LIST_HARNESSES, "params": {} });
+        tokio::io::AsyncWriteExt::write_all(&mut raw, format!("{frame}\n").as_bytes()).await.unwrap();
+        let mut answer = String::new();
+        let _ = tokio::time::timeout(
+            Duration::from_secs(5),
+            tokio::io::AsyncReadExt::read_to_string(&mut raw, &mut answer),
+        )
+        .await
+        .expect("closed");
+        assert!(!answer.contains("\"result\""), "{answer}");
+        assert_eq!(echo.calls(), 0, "nothing served");
+
+        // The account's laptop: served as itself, behind the relay's guard.
+        let io = dialer(&laptop, at, keys(&[&laptop.row, &desktop.row]))
+            .open("desktop")
+            .await
+            .expect("the laptop proves itself");
+        let client = direct_rpc::client(io);
+        let reply = client.call(methods::LIST_HARNESSES, json!({})).await.unwrap();
+        assert_eq!(reply["caller"], json!({ "peer": "laptop" }));
+        assert!(client.call(methods::ACCESS_TOKEN, json!({})).await.is_err());
+        assert_eq!(echo.calls(), 1);
+
+        // Dropped: the listener and its links close.
+        drop(road);
+        tokio::time::timeout(Duration::from_secs(5), client.closed()).await.expect("closed with the road");
+        assert!(TcpStream::connect(at.unwrap()).await.is_err());
+    }
