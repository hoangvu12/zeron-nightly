+        assert!(!well_formed_id("lap:top") && !well_formed_id("") && !well_formed_id("a\nb"));
+        let desktop = device("desktop");
+        let hello = json!({ "t": "hello", "v": VERSION, "from": "laptop:desktop", "to": "desktop", "nonce": nonce() });
+        let (served, answered) = serve_lines(&desktop, keys(vec![desktop.row.clone()]), &[hello]).await;
+        assert!(matches!(served, Err(Failed::Protocol(_))), "{served:?}");
+        assert!(!answered.contains("challenge"), "{answered}");
+    }
+
+    /// M1: the hello must come within about a second: a connection that says
+    /// nothing doesn't hold a handshake slot for the whole budget.
+    #[tokio::test]
+    async fn a_listener_waits_about_a_second_for_the_hello() {
+        let desktop = device("desktop");
+        let (_near, far) = tokio::io::duplex(64 * 1024);
+        let mut far = BufReader::new(far);
+        let server_keys = keys(vec![desktop.row.clone()]);
+        let started = Instant::now();
+        let served = tokio::time::timeout(
+            Duration::from_secs(5),
+            server(
+                &mut far,
+                Ends {
+                    me: desktop.id,
+                    local: addr(SERVER),
+                    peer: addr(CLIENT),
+                    signer: &desktop.signer,
+                    keys: &server_keys,
+                },
+                &SeenNonces::default(),
+                &|_: &str| true,
+            ),
+        )
+        .await
+        .expect("gave up on the silent end");
+        assert!(matches!(served, Err(Failed::Protocol(_))), "{served:?}");
+        assert!(started.elapsed() < Duration::from_millis(1500), "{:?}", started.elapsed());
+    }
+
+    /// An edge that never answers: the full check hangs, the copy answers.
+    struct EdgeDown(Arc<dyn KeyCheck>);
+
+    #[async_trait::async_trait]
+    impl KeyCheck for EdgeDown {
+        async fn device_key(&self, _device: &str, _key: &str) -> Result<(), Refused> {
+            std::future::pending().await
+        }
+        async fn cached_key(&self, device: &str, key: &str) -> Result<(), Refused> {
+            self.0.cached_key(device, key).await
+        }
+    }
+
+    /// I3: with the edge hanging on both ends, both key checks answer from
+    /// the copy in time, and the handshake fits inside the dialling end's
+    /// deadline (3 s).
+    #[tokio::test]
+    async fn with_the_edge_hanging_both_key_checks_fit_the_dial_deadline() {
+        let (laptop, desktop) = (device("laptop"), device("desktop"));
+        let rows = vec![laptop.row.clone(), desktop.row.clone()];
+        let mut run = Run::new(rows.clone());
+        run.client_keys = Arc::new(EdgeDown(keys(rows.clone())));
+        run.server_keys = Arc::new(EdgeDown(keys(rows)));
+        let started = Instant::now();
+        let (dialled, served) = run.between(&laptop, &desktop, &SeenNonces::default()).await;
+        assert_eq!(dialled, Ok(()));
+        assert_eq!(served, Ok("laptop".into()));
+        let took = started.elapsed();
+        assert!(took < Duration::from_millis(2500), "{took:?}");
+        assert!(KEY_WAIT * 2 < Duration::from_secs(3), "two waits inside DIAL_HANDSHAKE");
+    }
+
+    /// M1: the listener's "busy" reads as [`Failed::Busy`], not a refusal.
+    #[tokio::test]
+    async fn busy_reads_as_busy() {
+        let (near, mut far) = tokio::io::duplex(1024);
+        far.write_all(BUSY.as_bytes()).await.unwrap();
+        assert_eq!(read(&mut BufReader::new(near)).await, Err(Failed::Busy));
+    }
+}
diff --git a/crates/engine/src/tailnet/mod.rs b/crates/engine/src/tailnet/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e7f12eae2a1ab23c215e93df0c877515e30eefbf
--- /dev/null
+++ b/crates/engine/src/tailnet/mod.rs
@@ -0,0 +1,1663 @@
+//! The Tailscale road: engine-to-engine RPC straight over the tailnet, the
+//! first road a call to another of the person's computers takes
+//! (crate::direct_rpc::Roads), ahead of the WebRTC link and the relay.
+//!
+//! - **Listen** ([`TailnetRoad`]): a TCP listener on this device's Tailscale
+//!   address only ([`AddressSource`]), never every address, on
+//!   [`DEFAULT_PORT`] (or [`PORT_ENV`]; another port when it's taken, as by a
+//!   second engine on the machine). The engine never touches Tailscale's
+//!   configuration, Serve or Funnel. Its row advertises
+//!   [`zeron_proto::capabilities::DIRECT_TCP_V1`] and an `endpoints` entry
+//!   with the address and port bound, which peers read from their cached
+//!   list, so the road needs no edge. It follows the address, asked again
+//!   every [`POLL`]: it listens once one appears, moves when it changes, and
+//!   with none (or switched off: [`SWITCH_ENV`], [`SETTINGS_FILE`]) there's
+//!   no listener and no entry, which is what makes peers skip the road.
+//! - **Prove** ([`handshake`]): before any call, each end proves it's one of
+//!   the person's devices with its Zeron device key, against the account's
+//!   keys kept here (crate::device_proof). Then the listener serves calls as
+//!   that device's (`Caller::Peer{device: Some(..)}`), behind the relay's
+//!   guard ([`zeron_rpc::device_room::peer_service`]): local-only calls
+//!   refused, no new powers.
+//! - **Dial** ([`Dialer`]): a [`crate::direct_rpc::Pairing`] under
+//!   [`crate::direct_rpc::Links`], so the road keeps the WebRTC link's
+//!   per-device health, backoff, keep-alive and idle close: an address that
+//!   doesn't answer costs [`CONNECT_TIMEOUT`], then the next road is taken
+//!   and the address isn't dialled again for 5 s, doubling to 60 s.
+//! - **Not on Cloud machines**: they neither listen nor dial.
+//! - **Old peers**: one whose row lacks the capability (a version without
+//!   the road rewrites it on boot) is reached the old way, whatever
+//!   `endpoints` entry lingers.
+//!
+//! The same RPC as the direct link: newline-delimited JSON frames on the
+//! one TCP stream. WireGuard already encrypts the hop.
+//!
+//! **Before the handshake** anyone on the tailnet can connect, so the
+//! listener rations it: at most [`HANDSHAKES_PER_SOURCE`] at once from one
+//! address and [`HANDSHAKES_AT_ONCE`] in all, the hello within
+//! [`handshake::HELLO_WAIT`]. Past that a connection is told `busy`, which
+//! the dialling end tries again once after a moment and never holds against
+//! the address. Refusals are logged a few a minute at most.
+//!
+//! **After it**, a served link is checked again ([`direct_rpc::lapsed`])
+//! every minute and whenever the list or the account's keys change: once its
+//! device is off the list or its key is revoked, the link closes. Every link
+//! closes after [`direct_rpc::PROVEN_LIFETIME`] and proves itself afresh.
+
+pub mod address;
+pub mod handshake;
+
+use std::collections::HashMap;
+use std::future::Future as _;
+use std::net::{IpAddr, SocketAddr};
+use std::path::Path;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, PoisonError, Weak};
+use std::task::{Context, Poll};
+use std::time::{Duration, Instant};
+
+use futures::StreamExt as _;
+use futures::stream::BoxStream;
+use tokio::io::{AsyncRead, AsyncReadExt as _, AsyncWrite, AsyncWriteExt as _, BufReader, ReadBuf};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::{OwnedSemaphorePermit, Semaphore};
+use tokio::task::AbortHandle;
+use zeron_doc::{DeviceEndpoint, ENDPOINT_TAILNET};
+use zeron_rpc::RpcService;
+
+pub use address::{AddressSource, FixedAddress, RouteProbe, is_tailnet};
+pub use handshake::{FixedKeys, KeyCheck, Signer};
+
+use crate::direct_rpc;
+use crate::workspace_host::WorkspaceHost;
+
+/// The port the road listens on unless [`PORT_ENV`] says otherwise. Taken
+/// (a second engine on the machine): any free one, which the row says.
+pub const DEFAULT_PORT: u16 = 27660;
+/// Environment: the port to listen on.
+pub const PORT_ENV: &str = "ZERON_TAILNET_PORT";
+/// Environment: this device's tailnet address, when the OS's route to
+/// Tailscale doesn't say it. Only a tailnet address counts.
+pub const ADDR_ENV: &str = "ZERON_TAILNET_ADDR";
+/// Environment: the off switch. `0` (or `false`, `off`, `no`) turns the road
+/// off on this device; anything else, on. Set, it wins over the setting.
+pub const SWITCH_ENV: &str = "ZERON_TAILNET";
+/// The setting, in the data folder: `{ "enabled": false }` turns the road
+/// off, `"port"` picks its port. No file: on, [`DEFAULT_PORT`].
+pub const SETTINGS_FILE: &str = "tailnet-road.json";
+/// How often the road asks for this device's Tailscale address again, so
+/// one that appears, changes or goes is followed without a restart.
+pub const POLL: Duration = Duration::from_secs(10);
+
+/// A dead or unreachable address costs this much before the next road.
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(1);
+/// The handshake, either side: two round trips and a key check on each end
+/// ([`handshake::KEY_WAIT`] at most each, with the edge out of reach).
+const DIAL_HANDSHAKE: Duration = Duration::from_secs(3);
+const SERVE_HANDSHAKE: Duration = Duration::from_secs(5);
+/// Connections handshaking at once; more are told busy.
+const HANDSHAKES_AT_ONCE: usize = 8;
+/// Connections handshaking at once from one address: one stranger can't
+/// fill every slot.
+const HANDSHAKES_PER_SOURCE: usize = 2;
+/// Handshake slots kept for the addresses the person's computers (listed,
+/// their keys not revoked) advertise as theirs on the road: strangers
+/// filling the shared slots don't keep those out.
+const HANDSHAKES_FOR_PEERS: usize = 4;
+/// Kept slots one address holds at once: one address (a stale endpoint's,
+/// now someone else's) can't take them all.
+const HANDSHAKES_FOR_PEERS_PER_SOURCE: usize = 1;
+/// Busy answers being written at once; past it a connection is just closed.
+const BUSY_ANSWERS: usize = 32;
+/// Busy answers being written at once to one address: one stranger can't
+/// take them all.
+const BUSY_ANSWERS_PER_SOURCE: usize = 4;
+/// A busy dial is tried once more after a pause between these.
+const BUSY_RETRY_MS: (u64, u64) = (150, 500);
+/// Refusals logged a minute, at most: a flood doesn't fill the log.
+const REFUSALS_LOGGED: u32 = 10;
+/// A served link nothing was read on for this long is closed: the dialling
+/// end pings every 15 s (crate::direct_rpc::Links), so one gone without a
+/// word doesn't keep its task.
+const SERVED_IDLE: Duration = Duration::from_secs(45);
+
+/// How an engine runs the road.
+pub struct TailnetConfig {
+    /// Where this device's Tailscale address comes from.
+    pub source: Arc<dyn AddressSource>,
+    /// The port to listen on (0: any).
+    pub port: u16,
+    /// Signs the handshake as this device.
+    pub signer: Signer,
+    /// What checks the far end's key. `None`: the account's keys, as the
+    /// plugins read them (`Plugins::device_key`).
+    pub keys: Option<Arc<dyn KeyCheck>>,
+    /// A Cloud machine: no road at all.
+    pub cloud: bool,
+    /// The service calls on the road are served by. `None`: the engine's
+    /// (tests: one that notes what came this way).
+    #[doc(hidden)]
+    pub serve: Option<Arc<dyn RpcService>>,
+    /// The off switch: off, the road neither listens, advertises nor dials
+    /// ([`TailnetRoad::set_enabled`] turns it while it runs).
+    pub enabled: bool,
+    /// How often [`Self::source`] is asked again ([`POLL`]).
+    pub poll: Duration,
+    /// Dial a peer's loopback endpoint (tests, where loopback stands in for
+    /// the tailnet). Never set by [`Self::from_env`]: a running engine dials
+    /// tailnet addresses only.
+    #[doc(hidden)]
+    pub allow_loopback: bool,
+}
+
+/// The road's setting, [`SETTINGS_FILE`].
+#[derive(Debug, Default, serde::Deserialize)]
+struct Settings {
+    enabled: Option<bool>,
+    port: Option<u16>,
+}
+
+impl Settings {
+    fn read(data_dir: &Path) -> Self {
+        std::fs::read(data_dir.join(SETTINGS_FILE))
+            .ok()
+            .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+            .unwrap_or_default()
+    }
+}
+
+/// Whether the road is on, by [`SWITCH_ENV`] (`switch`) and the setting's
+/// `enabled`: the variable when it's set, else the setting, else on.
+pub fn switched_on(switch: Option<&str>, setting: Option<bool>) -> bool {
+    match switch.map(|value| value.trim().to_ascii_lowercase()) {
+        Some(value) => !matches!(value.as_str(), "0" | "false" | "off" | "no"),
+        None => setting.unwrap_or(true),
+    }
+}
+
+impl TailnetConfig {
+    /// As a running engine has it: the OS's route to Tailscale (or
+    /// [`ADDR_ENV`]), [`DEFAULT_PORT`] (or [`PORT_ENV`], or the setting's),
+    /// on unless [`SWITCH_ENV`] or [`SETTINGS_FILE`] says off, the key in
+    /// `data_dir`.
+    pub fn from_env(data_dir: &Path) -> Self {
+        Self::from_env_on(data_dir, &crate::runner::device_platform())
+    }
+
+    /// [`Self::from_env`] on an engine whose `Device::platform` is
+    /// `platform`: on Cloud's, [`Self::cloud`].
+    pub fn from_env_on(data_dir: &Path, platform: &str) -> Self {
+        let settings = Settings::read(data_dir);
+        let source: Arc<dyn AddressSource> = match std::env::var(ADDR_ENV).ok().map(|v| v.trim().parse::<IpAddr>()) {
+            Some(Ok(ip)) if is_tailnet(ip) => Arc::new(FixedAddress::new(Some(ip))),
+            Some(_) => {
+                tracing::warn!("{ADDR_ENV} isn't a Tailscale address; asking the OS instead");
+                Arc::new(RouteProbe)
+            }
+            None => Arc::new(RouteProbe),
+        };
+        let port = std::env::var(PORT_ENV)
+            .ok()
+            .and_then(|v| v.trim().parse().ok())
+            .or(settings.port)
+            .unwrap_or(DEFAULT_PORT);
+        Self {
+            source,
+            port,
+            signer: Signer::from_dir(data_dir),
+            keys: None,
+            cloud: crate::runner::is_cloud(platform),
+            serve: None,
+            enabled: switched_on(std::env::var(SWITCH_ENV).ok().as_deref(), settings.enabled),
+            poll: POLL,
+            allow_loopback: false,
+        }
+    }
+}
+
+/// The road's listening end, while it's held. It follows this device's
+/// Tailscale address: listens once one appears, moves when it changes, and
+/// stops (taking the row's entry away) when it goes or the road is switched
+/// off. Dropping it closes the listener and every link it serves; the row's
+/// entry stays, as a device that went away leaves it.
+pub struct TailnetRoad {
+    /// `None`: a Cloud machine, no road.
+    serving: Option<Arc<Serving>>,
+    /// Asks for the address every [`TailnetConfig::poll`].
+    watch: Option<tokio::task::JoinHandle<()>>,
+}
+
+impl TailnetRoad {
+    fn none() -> Self {
+        Self {
+            serving: None,
+            watch: None,
+        }
+    }
+
+    /// The address the road listens on, if it does.
+    pub fn listening(&self) -> Option<SocketAddr> {
+        let serving = self.serving.as_ref()?;
+        lock(&serving.bound).listener.as_ref().map(|listener| listener.at)
+    }
+
+    /// The off switch, while the engine runs. Off: the listener closes, the
+    /// row's entry goes and calls stop taking the road, at once. On: it
+    /// listens again if there's an address.
+    pub fn set_enabled(&self, on: bool) {
+        let Some(serving) = &self.serving else { return };
+        serving.on.store(on, Ordering::SeqCst);
+        tracing::info!(on, "the Tailscale road switched");
+        serving.settle();
+    }
+}
+
+impl Drop for TailnetRoad {
+    fn drop(&mut self) {
+        if let Some(watch) = self.watch.take() {
+            watch.abort();
+        }
+    }
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The serving end: the listener on the address the source gives now, if
+/// any, and the row's entry that says where.
+struct Serving {
+    source: Arc<dyn AddressSource>,
+    port: u16,
+    host: Arc<Host>,
+    workspace: WorkspaceHost,
+    /// The off switch, shared with the dialling end.
+    on: Arc<AtomicBool>,
+    bound: Mutex<Bound>,
+    /// The served service; the listener holds it weakly.
+    _service: Arc<dyn RpcService>,
+}
+
+#[derive(Default)]
+struct Bound {
+    listener: Option<Listener>,
+    /// An address the listener couldn't take, said once in the log.
+    failed: Option<IpAddr>,
+}
+
+impl Serving {
+    /// Listen where the address is now (nowhere: switched off or none), and
+    /// make the row say so.
+    fn settle(&self) {
+        let want = if self.on.load(Ordering::SeqCst) {
+            self.source.current()
+        } else {
+            None
+        };
+        let mut bound = lock(&self.bound);
+        if bound.listener.as_ref().map(|listener| listener.at.ip()) != want {
+            if let Some(old) = bound.listener.take() {
+                tracing::info!(addr = %old.at, "tailnet listener closed");
+            }
+            if let Some(ip) = want {
+                match bind(ip, self.port).and_then(|listener| listen(listener, self.host.clone())) {
+                    Ok(listener) => {
+                        tracing::info!(addr = %listener.at, "tailnet listener bound");
+                        bound.listener = Some(listener);
+                        bound.failed = None;
+                    }
+                    Err(error) => {
+                        // Tried again at the next look.
+                        if bound.failed != Some(ip) {
+                            tracing::warn!(%ip, %error, "the Tailscale road couldn't listen");
+                        }
+                        bound.failed = Some(ip);
+                    }
+                }
+            } else if self.on.load(Ordering::SeqCst) {
+                tracing::info!("no Tailscale address here; the Tailscale road isn't served");
+            }
+        }
+        // (Under the lock: a switch and a look at once leave the row as the
+        // listener is.)
+        let endpoints: Vec<DeviceEndpoint> = bound
+            .listener
+            .iter()
+            .map(|listener| DeviceEndpoint {
+                kind: ENDPOINT_TAILNET.into(),
+                addr: listener.at.ip().to_string(),
+                port: listener.at.port(),
+            })
+            .collect();
+        self.workspace.set_own_endpoints(&endpoints);
+    }
+}
+
+/// The dialling end's part of the road, kept on the engine.
+#[derive(Clone)]
+pub(crate) struct Dialing {
+    links: direct_rpc::Links,
+    /// The off switch ([`TailnetRoad::set_enabled`]).
+    on: Arc<AtomicBool>,
+    /// [`TailnetConfig::allow_loopback`].
+    allow_loopback: bool,
+}
+
+/// Start the road for a running engine (nothing on a Cloud machine).
+pub fn start(core: &crate::EngineCore, data_dir: &Path) -> Option<TailnetRoad> {
+    let config = TailnetConfig::from_env(data_dir);
+    (!config.cloud).then(|| core.start_tailnet_road(config))
+}
+
+impl crate::EngineCore {
+    /// Run the Tailscale road: calls to devices that have one take it first,
+    /// and this device serves it on its tailnet address, if it has one.
+    /// Nothing on a Cloud machine.
+    pub fn start_tailnet_road(&self, config: TailnetConfig) -> TailnetRoad {
+        if config.cloud {
+            return TailnetRoad::none();
+        }
+        let on = Arc::new(AtomicBool::new(config.enabled));
+        let keys = config.keys.clone().unwrap_or_else(|| self.plugins.device_key_check());
+        let workspace = self.workspace.clone();
+        let switch = on.clone();
+        let allow_loopback = config.allow_loopback;
+        let still_listed = self.workspace.clone();
+        let dialer = Dialer {
+            listed: Arc::new(move |device: &str| listed(&still_listed, device)),
+            far_keys: Mutex::default(),
+            me: self.device_id.clone(),
+            endpoint: Arc::new(move |device: &str| {
+                switch
+                    .load(Ordering::SeqCst)
+                    .then(|| endpoint_of(&workspace, device, allow_loopback))
+                    .flatten()
+            }),
+            signer: config.signer.clone(),
+            keys: keys.clone(),
+        };
+        *self.tailnet.lock().unwrap_or_else(PoisonError::into_inner) = Some(Dialing {
+            links: direct_rpc::Links::proven_over("tailnet", Arc::new(dialer)),
+            on: on.clone(),
+            allow_loopback,
+        });
+        self.wire_roads();
+
+        let service = config
+            .serve
+            .clone()
+            .unwrap_or_else(|| self.rpc_service() as Arc<dyn RpcService>);
+        let workspace = self.workspace.clone();
+        let devices = self.workspace.watch_devices();
+        let key_changes = keys.clone();
+        let advertised = self.workspace.clone();
+        let mut host = Host::new(
+            self.device_id.clone(),
+            config.signer,
+            keys,
+            Arc::new(move |device: &str| listed(&workspace, device)),
+            Arc::downgrade(&service),
+            // A served link is checked again whenever the list or the keys
+            // change.
+            Arc::new(move || {
+                futures::stream::select(direct_rpc::watch_stream(devices.clone()), key_changes.changes()).boxed()
+            }),
+        );
+        host.peers = Arc::new(move |ip| {
+            advertised_by_peer(&advertised, |id| advertised.device_endpoints(id), ip, allow_loopback)
+        });
+        if !config.enabled {
+            tracing::info!("the Tailscale road is switched off here");
+        }
+        let serving = Arc::new(Serving {
+            source: config.source,
+            port: config.port,
+            host: Arc::new(host),
+            workspace: self.workspace.clone(),
+            on,
+            bound: Mutex::default(),
+            _service: service,
+        });
+        // At once (an entry its last run left goes, if there's no road now),
+        // then every `poll`.
+        serving.settle();
+        let looking = Arc::downgrade(&serving);
+        let poll = config.poll;
+        let watch = tokio::spawn(async move {
+            let mut every = tokio::time::interval_at(tokio::time::Instant::now() + poll, poll);
+            every.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+            loop {
+                every.tick().await;
+                let Some(serving) = looking.upgrade() else { return };
+                serving.settle();
+            }
+        });
+        TailnetRoad {
+            serving: Some(serving),
+            watch: Some(watch),
+        }
+    }
+
+    /// `roads` with the Tailscale road first, once it's started.
+    pub(crate) fn with_tailnet_road(&self, roads: direct_rpc::Roads) -> direct_rpc::Roads {
+        let dialing = self.tailnet.lock().unwrap_or_else(PoisonError::into_inner).clone();
+        let Some(Dialing { links, on, allow_loopback }) = dialing else { return roads };
+        let workspace = self.workspace.clone();
+        roads.with_tailnet(
+            links,
+            Arc::new(move |device: &str| {
+                on.load(Ordering::SeqCst) && endpoint_of(&workspace, device, allow_loopback).is_some()
+            }),
+        )
+    }
+}
+
+/// Where `device` serves the Tailscale road, by the list here: its row
+/// advertises the road and a tailnet endpoint. Never a Cloud machine, never
+/// a loopback address.
+pub fn peer_endpoint(workspace: &WorkspaceHost, device: &str) -> Option<SocketAddr> {
+    endpoint_of(workspace, device, false)
+}
+
+/// [`peer_endpoint`], a loopback endpoint taken too, as a test's road
+/// ([`TailnetConfig::allow_loopback`]) dials one.
+#[doc(hidden)]
+pub fn peer_endpoint_allowing_loopback(workspace: &WorkspaceHost, device: &str) -> Option<SocketAddr> {
+    endpoint_of(workspace, device, true)
+}
+
+fn endpoint_of(workspace: &WorkspaceHost, device: &str, allow_loopback: bool) -> Option<SocketAddr> {
+    if zeron_proto::is_cloud_device(device, "") {
+        return None;
+    }
+    let row = workspace.read_devices().ok()?.into_iter().find(|d| d.id == device)?;
+    if zeron_proto::is_cloud_device(&row.id, &row.platform) || !row.supports(zeron_proto::capabilities::DIRECT_TCP_V1) {
+        return None;
+    }
+    tailnet_endpoint(&workspace.device_endpoints(device), allow_loopback)
+}
+
+/// The first of a row's `endpoints` the road dials: a tailnet entry at a
+/// tailnet address, or (`allow_loopback`: tests) a loopback one. Anything
+/// else a row says (another device could have written it) is never dialled.
+fn tailnet_endpoint(endpoints: &[DeviceEndpoint], allow_loopback: bool) -> Option<SocketAddr> {
+    endpoints
+        .iter()
+        .filter(|endpoint| endpoint.kind == ENDPOINT_TAILNET)
+        .find_map(|endpoint| {
+            let ip: IpAddr = endpoint.addr.parse().ok()?;
+            (is_tailnet(ip) || (allow_loopback && ip.is_loopback())).then_some(SocketAddr::new(ip, endpoint.port))
+        })
+}
+
+/// Whether `ip` is where a computer of the person's this one may reach (not
+/// this one, not a Cloud machine, its key not revoked: `workspace.reachable_peers`)
+/// says it serves the road: a peer dials from there. The list read once.
+/// Each row's endpoints by `endpoints` (the list's own: [`WorkspaceHost::device_endpoints`]).
+fn advertised_by_peer(
+    workspace: &WorkspaceHost,
+    endpoints: impl Fn(&str) -> Vec<DeviceEndpoint>,
+    ip: IpAddr,
+    allow_loopback: bool,
+) -> bool {
+    workspace
+        .reachable_peers()
+        .iter()
+        .any(|row| tailnet_endpoint(&endpoints(&row.id), allow_loopback).is_some_and(|at| at.ip() == ip))
+}
+
+/// Whether this device serves `device` on the road: another of the
+/// account's devices on the list here (not removed), not a Cloud machine.
+pub(crate) fn listed(workspace: &WorkspaceHost, device: &str) -> bool {
+    device != workspace.device_id()
+        && workspace.read_devices().is_ok_and(|devices| {
+            devices
+                .iter()
+                .any(|d| d.id == device && !zeron_proto::is_cloud_device(&d.id, &d.platform))
+        })
+}
+
+/// A listener on `ip` alone, at `port` or, taken, any free one. Never on
+/// every address.
+fn bind(ip: IpAddr, port: u16) -> std::io::Result<TcpListener> {
+    if ip.is_unspecified() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "the Tailscale road listens on the Tailscale address alone",
+        ));
+    }
+    let listener = match std::net::TcpListener::bind((ip, port)) {
+        Err(error) if error.kind() == std::io::ErrorKind::AddrInUse && port != 0 => {
+            tracing::info!(port, "the Tailscale road's port is taken; listening on another");
+            std::net::TcpListener::bind((ip, 0))
+        }
+        bound => bound,
+    }?;
+    listener.set_nonblocking(true)?;
+    TcpListener::from_std(listener)
+}
+
+/// What wakes a served link's check again: the list or the keys changed.
+type Changes = Arc<dyn Fn() -> BoxStream<'static, ()> + Send + Sync>;
+
+/// What the listening end serves with.
+struct Host {
+    me: String,
+    signer: Signer,
+    keys: Arc<dyn KeyCheck>,
+    seen: handshake::SeenNonces,
+    admit: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+    service: Weak<dyn RpcService>,
+    /// Handshakes under way, in all ([`HANDSHAKES_AT_ONCE`]).
+    handshakes: Arc<Semaphore>,
+    /// Handshakes under way, by source address ([`HANDSHAKES_PER_SOURCE`]).
+    sources: Arc<Mutex<HashMap<IpAddr, usize>>>,
+    /// Slots for the person's computers alone ([`HANDSHAKES_FOR_PEERS`]),
+    /// and whether an address is one's ([`advertised_by_peer`]).
+    for_peers: Arc<Semaphore>,
+    peers: Arc<dyn Fn(IpAddr) -> bool + Send + Sync>,
+    /// Kept slots held, by source address ([`HANDSHAKES_FOR_PEERS_PER_SOURCE`]).
+    peer_sources: Arc<Mutex<HashMap<IpAddr, usize>>>,
+    /// Busy answers being written ([`BUSY_ANSWERS`]), and by source address
+    /// ([`BUSY_ANSWERS_PER_SOURCE`]).
+    busy: Arc<Semaphore>,
+    busy_sources: Arc<Mutex<HashMap<IpAddr, usize>>>,
+    /// Wakes a served link's check.
+    changes: Changes,
+    /// How a served link is checked again.
+    recheck: direct_rpc::Recheck,
+    refusals: Throttle,
+}
+
+impl Host {
+    fn new(
+        me: String,
+        signer: Signer,
+        keys: Arc<dyn KeyCheck>,
+        admit: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+        service: Weak<dyn RpcService>,
+        changes: Changes,
+    ) -> Self {
+        Self {
+            me,
+            signer,
+            keys,
+            seen: handshake::SeenNonces::default(),
+            admit,
+            service,
+            handshakes: Arc::new(Semaphore::new(HANDSHAKES_AT_ONCE)),
+            sources: Arc::default(),
+            for_peers: Arc::new(Semaphore::new(HANDSHAKES_FOR_PEERS)),
+            peers: Arc::new(|_| false),
+            peer_sources: Arc::default(),
+            busy: Arc::new(Semaphore::new(BUSY_ANSWERS)),
+            busy_sources: Arc::default(),
+            changes,
+            recheck: direct_rpc::Recheck::default(),
+            refusals: Throttle::default(),
+        }
+    }
+
+    /// A handshake slot for a connection from `source`: one of the
+    /// [`HANDSHAKES_AT_ONCE`] (or, those taken, of the
+    /// [`HANDSHAKES_FOR_PEERS`] when `source` is a peer's), and of that
+    /// address's [`HANDSHAKES_PER_SOURCE`]. `None`: busy.
+    fn slot(&self, source: IpAddr) -> Option<Slot> {
+        let held = Held::take(&self.sources, source, HANDSHAKES_PER_SOURCE)?;
+        let (permit, kept) = match self.handshakes.clone().try_acquire_owned() {
+            Ok(permit) => (permit, None),
+            Err(_) if (self.peers)(source) => {
+                let kept = Held::take(&self.peer_sources, source, HANDSHAKES_FOR_PEERS_PER_SOURCE)?;
+                (self.for_peers.clone().try_acquire_owned().ok()?, Some(kept))
+            }
+            Err(_) => return None,
+        };
+        Some(Slot {
+            _permit: permit,
+            _held: held,
+            _kept: kept,
+        })
+    }
+}
+
+/// One of an address's places, given back when dropped.
+struct Held {
+    source: IpAddr,
+    sources: Arc<Mutex<HashMap<IpAddr, usize>>>,
+}
+
+impl Held {
+    /// A place for `source` among `sources`, if it holds fewer than `cap`.
+    fn take(sources: &Arc<Mutex<HashMap<IpAddr, usize>>>, source: IpAddr, cap: usize) -> Option<Self> {
+        let mut held = lock(sources);
+        let count = held.entry(source).or_default();
+        if *count >= cap {
+            return None;
+        }
+        *count += 1;
+        Some(Self {
+            source,
+            sources: sources.clone(),
+        })
+    }
+}
+
+impl Drop for Held {
+    fn drop(&mut self) {
+        let mut sources = lock(&self.sources);
+        if let Some(held) = sources.get_mut(&self.source) {
+            *held = held.saturating_sub(1);
+            if *held == 0 {
+                sources.remove(&self.source);
+            }
+        }
+    }
+}
+
+/// One handshake's place: given back when dropped.
+struct Slot {
+    _permit: OwnedSemaphorePermit,
+    _held: Held,
+    /// Its address's place among the kept slots, when it took one.
+    _kept: Option<Held>,
+}
+
+/// At most [`REFUSALS_LOGGED`] refusals logged a minute; the rest are
+/// counted, and the count said when the minute is up.
+#[derive(Default)]
+struct Throttle(Mutex<Option<(Instant, u32)>>);
+
+impl Throttle {
+    /// Whether to log this one, and how many went unlogged before it.
+    fn allow(&self) -> (bool, u32) {
+        let mut window = lock(&self.0);
+        let now = Instant::now();
+        match &mut *window {
+            Some((start, count)) if now.duration_since(*start) < Duration::from_secs(60) => {
+                *count += 1;
+                (*count <= REFUSALS_LOGGED, 0)
+            }
+            previous => {
+                let dropped = previous.map_or(0, |(_, count)| count.saturating_sub(REFUSALS_LOGGED));
+                *previous = Some((now, 1));
+                (true, dropped)
+            }
+        }
+    }
+
+    fn refused(&self, peer: SocketAddr, why: &dyn std::fmt::Display) {
+        let (log, unlogged) = self.allow();
+        if log {
+            tracing::info!(%peer, %why, unlogged, "tailnet road refused a connection");
+        }
+    }
+}
+
+/// Tell a connection there's no room for its handshake now, and close it,
+/// with a moment for the far end to read that (closing with its hello
+/// unread would reset the connection first). At most [`BUSY_ANSWERS`] at
+/// once, [`BUSY_ANSWERS_PER_SOURCE`] to one address; past that it's just
+/// closed.
+fn answer_busy(mut stream: TcpStream, from: IpAddr, host: &Host) {
+    let Some(held) = Held::take(&host.busy_sources, from, BUSY_ANSWERS_PER_SOURCE) else { return };
+    let Ok(permit) = host.busy.clone().try_acquire_owned() else { return };
+    tokio::spawn(async move {
+        let _permit = (permit, held);
+        let _ = tokio::time::timeout(Duration::from_millis(500), async {
+            stream.write_all(handshake::BUSY.as_bytes()).await?;
+            stream.shutdown().await?;
+            let mut sink = [0u8; 1024];
+            while stream.read(&mut sink).await? > 0 {}
+            std::io::Result::Ok(())
+        })
+        .await;
+    });
+}
+
+/// A listener taking connections, and the links it serves: dropped, all
+/// close. The socket itself closes as it's dropped, not later on the accept
+/// task, so once the road is switched off or moves nothing more is taken
+/// there.
+struct Listener {
+    at: SocketAddr,
+    socket: Arc<Mutex<Option<TcpListener>>>,
+    accept: tokio::task::JoinHandle<()>,
+    served: Arc<Mutex<Vec<AbortHandle>>>,
+}
+
+impl Drop for Listener {
+    fn drop(&mut self) {
+        // Closed here and now (the accept task finds it gone).
+        drop(lock(&self.socket).take());
+        self.accept.abort();
+        for link in lock(&self.served).drain(..) {
+            link.abort();
+        }
+    }
+}
+
+fn listen(listener: TcpListener, host: Arc<Host>) -> std::io::Result<Listener> {
+    let at = listener.local_addr()?;
+    let socket = Arc::new(Mutex::new(Some(listener)));
+    let served: Arc<Mutex<Vec<AbortHandle>>> = Arc::default();
+    let links = served.clone();
+    let held = socket.clone();
+    let accept = tokio::spawn(async move {
+        loop {
+            let accepted = std::future::poll_fn(|cx| match lock(&held).as_ref() {
+                Some(listener) => listener.poll_accept(cx).map(Some),
+                None => Poll::Ready(None),
+            })
+            .await;
+            let Some(accepted) = accepted else { return }; // closed
+            let (stream, from) = match accepted {
+                Ok(accepted) => accepted,
+                Err(error) => {
+                    tracing::debug!(%error, "tailnet listener: accept failed");
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                    continue;
+                }
+            };
+            let Some(slot) = host.slot(from.ip()) else {
+                host.refusals.refused(from, &"busy: too many handshakes at once");
+                answer_busy(stream, from.ip(), &host);
+                continue;
+            };
+            // Served only while the socket is open, checked under its lock:
+            // once dropped (switched off, moved) the listener has closed
+            // every link it holds, and one taken as it closed isn't added.
+            let open = lock(&held);
+            if open.is_none() {
+                return;
+            }
+            let task = tokio::spawn(host.clone().serve(stream, slot));
+            let mut links = lock(&links);
+            links.retain(|link| !link.is_finished());
+            links.push(task.abort_handle());
+            drop((links, open));
+        }
+    });
+    Ok(Listener {
+        at,
+        socket,
+        accept,
+        served,
+    })
+}
+
+impl Host {
+    /// One connection: the handshake, then calls as the device it proved.
+    async fn serve(self: Arc<Self>, stream: TcpStream, slot: Slot) {
+        let _ = stream.set_nodelay(true);
+        let (Ok(local), Ok(peer)) = (stream.local_addr(), stream.peer_addr()) else {
+            return;
+        };
+        let mut io = BufReader::new(stream);
+        let ends = handshake::Ends {
+            me: &self.me,
+            local,
+            peer,
+            signer: &self.signer,
+            keys: &self.keys,
+        };
+        let proven = tokio::time::timeout(
+            SERVE_HANDSHAKE,
+            handshake::server(&mut io, ends, &self.seen, self.admit.as_ref()),
+        )
+        .await;
+        drop(slot);
+        let handshake::Proven { device, key } = match proven {
+            Ok(Ok(proven)) => proven,
+            Ok(Err(why)) => {
+                self.refusals.refused(peer, &why);
+                return;
+            }
+            Err(_) => {
+                self.refusals.refused(peer, &"the handshake took too long");
+                return;
+            }
+        };
+        let Some(service) = self.service.upgrade() else {
+            return;
+        };
+        let guarded = zeron_rpc::device_room::peer_service(service, Some(device.clone()));
+        tracing::info!(device, road = "tailnet", "tailnet link serving calls from this device");
+        // Served only while the device stays on the list with its key, and
+        // no longer than a proven link's lifetime.
+        let (admit, keys) = (self.admit.clone(), self.keys.clone());
+        let holds = {
+            let device = device.clone();
+            move || {
+                let (admit, keys, device, key) = (admit.clone(), keys.clone(), device.clone(), key.clone());
+                async move {
+                    if !admit(&device) {
+                        return Err("no longer on this device's list".to_owned());
+                    }
+                    handshake::check_key(&keys, &device, &key)
+                        .await
+                        .map_err(|why| why.to_string())
+                }
+            }
+        };
+        let lapsed = direct_rpc::lapsed(holds, (self.changes)(), self.recheck);
+        match direct_rpc::serve_until(guarded, Idle::new(io, SERVED_IDLE), lapsed).await {
+            Some(why) => {
+                tracing::info!(device, road = "tailnet", %why, "tailnet link from this device closed: it must prove itself again");
+            }
+            None => tracing::info!(device, road = "tailnet", "tailnet link from this device closed"),
+        }
+    }
+}
+
+/// The dialling end: a TCP connection to the device's tailnet endpoint and
+/// the handshake, under [`direct_rpc::Links`].
+pub struct Dialer {
+    /// Whether the device dialled is still one this device serves
+    /// ([`listed`]).
+    listed: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+    /// The key each device proved itself with on the last link dialled.
+    far_keys: Mutex<HashMap<String, String>>,
+    me: String,
+    endpoint: Arc<dyn Fn(&str) -> Option<SocketAddr> + Send + Sync>,
+    signer: Signer,
+    keys: Arc<dyn KeyCheck>,
+}
+
+#[async_trait::async_trait]
+impl direct_rpc::Pairing for Dialer {
+    async fn ready(&self, device: &str) -> bool {
+        (self.endpoint)(device).is_some()
+    }
+
+    fn warm(&self, _device: &str) {}
+
+    /// Busy (the listener's handshake slots full): once more after a short
+    /// pause, then [`direct_rpc::Busy`], which isn't held against the
+    /// device.
+    async fn open(&self, device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        let to = (self.endpoint)(device).ok_or_else(|| anyhow::anyhow!("no Tailscale address for it"))?;
+        match self.dial(device, to).await {
+            Err(Dialled::Busy) => {}
+            Err(Dialled::Failed(error)) => return Err(error),
+            Ok(io) => return Ok(io),
+        }
+        let pause = {
+            use ring::rand::SecureRandom as _;
+            let mut byte = [0u8; 2];
+            let _ = ring::rand::SystemRandom::new().fill(&mut byte);
+            let (low, high) = BUSY_RETRY_MS;
+            low + u64::from(u16::from_le_bytes(byte)) % (high - low)
+        };
+        tracing::info!(device, pause_ms = pause, "the Tailscale road's listener is busy; trying once more");
+        tokio::time::sleep(Duration::from_millis(pause)).await;
+        match self.dial(device, to).await {
+            Ok(io) => Ok(io),
+            Err(Dialled::Busy) => Err(anyhow::Error::new(direct_rpc::Busy)),
+            Err(Dialled::Failed(error)) => Err(error),
+        }
+    }
+
+    /// The device dialled is still listed, and the key it proved itself with
+    /// on the last link isn't revoked.
+    async fn holds(&self, device: &str) -> Result<(), String> {
+        if !(self.listed)(device) {
+            return Err("no longer on this device's list".to_owned());
+        }
+        let key = lock(&self.far_keys).get(device).cloned();
+        match key {
+            Some(key) => handshake::check_key(&self.keys, device, &key)
+                .await
+                .map_err(|why| why.to_string()),
+            None => Ok(()),
+        }
+    }
+}
+
+/// Why one dial didn't make a link.
+enum Dialled {
+    Busy,
+    Failed(anyhow::Error),
+}
+
+impl From<anyhow::Error> for Dialled {
+    fn from(error: anyhow::Error) -> Self {
+        Self::Failed(error)
+    }
+}
+
+impl From<std::io::Error> for Dialled {
+    fn from(error: std::io::Error) -> Self {
+        Self::Failed(error.into())
+    }
+}
+
+impl Dialer {
+    /// One connection to `to` and the handshake with `device` on it.
+    async fn dial(&self, device: &str, to: SocketAddr) -> Result<zeron_preview::mux::BoxIo, Dialled> {
+        let stream = tokio::time::timeout(CONNECT_TIMEOUT, TcpStream::connect(to))
+            .await
+            .map_err(|_| anyhow::anyhow!("no answer at {to} within {CONNECT_TIMEOUT:?}"))??;
+        let _ = stream.set_nodelay(true);
+        let (local, peer) = (stream.local_addr()?, stream.peer_addr()?);
+        let mut io = BufReader::new(stream);
+        let ends = handshake::Ends {
+            me: &self.me,
+            local,
+            peer,
+            signer: &self.signer,
+            keys: &self.keys,
+        };
+        match tokio::time::timeout(DIAL_HANDSHAKE, handshake::client_key(&mut io, ends, device)).await {
+            Err(_) => Err(anyhow::anyhow!("the handshake with {to} took too long").into()),
+            Ok(Err(handshake::Failed::Busy)) => Err(Dialled::Busy),
+            Ok(Err(failed)) => Err(anyhow::anyhow!("the handshake with {to} failed: {failed}").into()),
+            Ok(Ok(key)) => {
+                lock(&self.far_keys).insert(device.to_owned(), key);
+                Ok(Box::new(io))
+            }
+        }
+    }
+}
+
+/// A stream whose reads fail once nothing arrived for `limit`.
+struct Idle<S> {
+    io: S,
+    limit: Duration,
+    quiet: Pin<Box<tokio::time::Sleep>>,
+}
+
+impl<S> Idle<S> {
+    fn new(io: S, limit: Duration) -> Self {
+        Self {
+            io,
+            limit,
+            quiet: Box::pin(tokio::time::sleep(limit)),
+        }
+    }
+}
+
+impl<S: AsyncRead + Unpin> AsyncRead for Idle<S> {
+    fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut ReadBuf<'_>) -> Poll<std::io::Result<()>> {
+        let this = &mut *self;
+        match Pin::new(&mut this.io).poll_read(cx, buf) {
+            Poll::Ready(read) => {
+                let next = tokio::time::Instant::now() + this.limit;
+                this.quiet.as_mut().reset(next);
+                Poll::Ready(read)
+            }
+            Poll::Pending => match this.quiet.as_mut().poll(cx) {
+                Poll::Ready(()) => Poll::Ready(Err(std::io::Error::new(
+                    std::io::ErrorKind::TimedOut,
+                    "nothing read for a while",
+                ))),
+                Poll::Pending => Poll::Pending,
+            },
+        }
+    }
+}
+
+impl<S: AsyncWrite + Unpin> AsyncWrite for Idle<S> {
+    fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<std::io::Result<usize>> {
+        Pin::new(&mut self.io).poll_write(cx, buf)
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.io).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Pin::new(&mut self.io).poll_shutdown(cx)
+    }
+}
