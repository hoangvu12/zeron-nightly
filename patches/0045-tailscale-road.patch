diff --git a/crates/engine/tests/tailnet_road.rs b/crates/engine/tests/tailnet_road.rs
new file mode 100644
index 0000000000000000000000000000000000000000..db3aa7f594c56900d3318cd9d2f9824a26dfc6ef
--- /dev/null
+++ b/crates/engine/tests/tailnet_road.rs
@@ -0,0 +1,586 @@
+//! The Tailscale road between two real engines, a loopback address standing
+//! in for each one's tailnet address.
+//!
+//! - Ticket 04: a forwarded call takes it and both logs say so; plugins'
+//!   calls, which need the verified caller, are served over it as the
+//!   calling device's; a Cloud machine neither listens nor dials, and a peer
+//!   refuses one that dials anyway.
+//! - Ticket 05: the road follows the address (appears, changes, goes); the
+//!   off switch takes the listener and the endpoint entry away; a dead
+//!   endpoint costs about a second (Linux only, below), a failed dial waits
+//!   out its backoff; a peer on a version without the road is reached the
+//!   old way.
+
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use async_trait::async_trait;
+use engines::{Engines, wait_until};
+use zeron_engine::EngineCore;
+use zeron_engine::device_proof::AccountKeys;
+use zeron_engine::plugins::keys::KeyRow;
+use zeron_engine::tailnet::{FixedAddress, FixedKeys, KeyCheck, Signer, TailnetConfig, TailnetRoad};
+use zeron_rpc::{RpcError, RpcReply, RpcService, methods};
+
+
+/// What reached an engine over its Tailscale road: each call's method and
+/// the device it was served as.
+type Seen = Arc<Mutex<Vec<(String, Option<String>)>>>;
+
+struct NotedTailnet {
+    inner: Arc<dyn RpcService>,
+    seen: Seen,
+}
+
+#[async_trait]
+impl RpcService for NotedTailnet {
+    async fn handle(&self, method: &str, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        let caller = match zeron_rpc::caller() {
+            zeron_rpc::Caller::Peer { device } => device,
+            _ => Some("not a peer".into()),
+        };
+        self.seen.lock().unwrap().push((method.to_owned(), caller));
+        self.inner.handle(method, params).await
+    }
+}
+
+fn came(seen: &Seen, method: &str) -> Vec<Option<String>> {
+    seen.lock()
+        .unwrap()
+        .iter()
+        .filter(|(m, _)| m == method)
+        .map(|(_, caller)| caller.clone())
+        .collect()
+}
+
+/// Each engine's signing key (in a folder of its own), and the account's
+/// keys as both have them.
+struct Account {
+    keys: Arc<dyn KeyCheck>,
+    signers: [Signer; 2],
+    _dirs: [tempfile::TempDir; 2],
+}
+
+fn account(a: &str, b: &str) -> Account {
+    let dirs = [tempfile::tempdir().unwrap(), tempfile::tempdir().unwrap()];
+    let row = |dir: &tempfile::TempDir, device: &str| KeyRow {
+        key: zeron_engine::plugins::signing::load_or_create_key(dir.path()).unwrap().public(),
+        fingerprint: String::new(),
+        device_id: device.into(),
+        created_at: 1,
+        revoked_at: None,
+    };
+    let rows = vec![row(&dirs[0], a), row(&dirs[1], b)];
+    Account {
+        keys: Arc::new(FixedKeys {
+            keys: AccountKeys::fixed("test-account", rows),
+            account: "test-account".into(),
+        }),
+        signers: [Signer::from_dir(dirs[0].path()), Signer::from_dir(dirs[1].path())],
+        _dirs: dirs,
+    }
+}
+
+const LOOPBACK: IpAddr = IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1));
+/// Another loopback address, standing in for a tailnet address that changed:
+/// IPv6's, which every OS has (127.0.0.2 is this machine only on Linux and
+/// Windows; macOS has 127.0.0.1 alone).
+const OTHER_LOOPBACK: IpAddr = IpAddr::V6(Ipv6Addr::LOCALHOST);
+
+/// The road on loopback, any port, `serve`d by what's given.
+fn config(account: &Account, which: usize, serve: Option<Arc<dyn RpcService>>) -> TailnetConfig {
+    config_at(account, which, serve, Arc::new(FixedAddress::new(Some(LOOPBACK))))
+}
+
+/// The road with its address from `source`, asked again every 100 ms.
+fn config_at(
+    account: &Account,
+    which: usize,
+    serve: Option<Arc<dyn RpcService>>,
+    source: Arc<FixedAddress>,
+) -> TailnetConfig {
+    TailnetConfig {
+        source,
+        port: 0,
+        signer: account.signers[which].clone(),
+        keys: Some(account.keys.clone()),
+        cloud: false,
+        serve,
+        enabled: true,
+        poll: Duration::from_millis(100),
+        // Loopback stands in for the tailnet here.
+        allow_loopback: true,
+    }
+}
+
+/// B's road, noting what comes over it.
+fn serve_noted(core: &EngineCore, config: impl FnOnce(Arc<dyn RpcService>) -> TailnetConfig) -> (TailnetRoad, Seen) {
+    let seen = Seen::default();
+    let noted: Arc<dyn RpcService> = Arc::new(NotedTailnet {
+        inner: core.rpc_service(),
+        seen: seen.clone(),
+    });
+    (core.start_tailnet_road(config(noted)), seen)
+}
+
+/// Where `core`'s list says `device` serves the road (loopback standing in
+/// for the tailnet, as the roads here are allowed).
+fn endpoint_of(core: &EngineCore, device: &str) -> Option<SocketAddr> {
+    zeron_engine::tailnet::peer_endpoint_allowing_loopback(&core.workspace, device)
+}
+
+/// A device-addressed call from `core` to `target`, asked again while the
+/// target's relay host is still joining.
+async fn call(core: &EngineCore, method: &str, target: &str) -> serde_json::Value {
+    let client = zeron_rpc::memory_client(core.rpc_service());
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(30);
+    loop {
+        match client.call(method, serde_json::json!({ "targetDeviceId": target })).await {
+            Ok(value) => return value,
+            Err(err) => {
+                assert!(tokio::time::Instant::now() < deadline, "{method} to {target} never answered: {err}");
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+        }
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_forwarded_call_takes_the_tailscale_road_and_both_logs_say_so() {
+    let engines = Engines::start("tailnet-road").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config(&account, 1, Some(noted)));
+    let road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+
+    // Each listens on the address it was given, never every address, and
+    // its row says where.
+    let at = road_b.listening().expect("B listens");
+    assert_eq!(at.ip().to_string(), "127.0.0.1");
+    assert!(road_a.listening().is_some_and(|a| !a.ip().is_unspecified()));
+    wait_until(Duration::from_secs(20), "A's list has B's Tailscale endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(at)
+    })
+    .await;
+
+    // A forwarded read takes the road, served as A's.
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert_eq!(came(&seen, methods::LIST_HARNESSES), [Some(engines.a_id.clone())]);
+    logs::wait_for_line(
+        "calls to this device take a new road",
+        &[("device", engines.b_id.as_str()), ("road", "tailnet")],
+        Duration::from_secs(5),
+    )
+    .await;
+    logs::wait_for_line(
+        "tailnet link serving calls from this device",
+        &[("device", engines.a_id.as_str())],
+        Duration::from_secs(5),
+    )
+    .await;
+
+    // Plugins' calls need the verified caller: they take it too, as A's.
+    call(&engines.a, methods::LIST_PLUGINS, &engines.b_id).await;
+    assert_eq!(came(&seen, methods::LIST_PLUGINS), [Some(engines.a_id.clone())]);
+
+    drop((road_a, road_b));
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_cloud_machine_neither_listens_nor_dials() {
+    let engines = Engines::start("tailnet-cloud").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    // B serves the road; A runs as a Cloud machine: its road as the
+    // environment makes it there (ZERON_DEVICE_PLATFORM=cloud), with only
+    // the test's address, keys and poll put in.
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config(&account, 1, Some(noted)));
+    let dir = tempfile::tempdir().unwrap();
+    let test = config(&account, 0, None);
+    let road_a = engines.a.start_tailnet_road(TailnetConfig {
+        source: test.source,
+        port: test.port,
+        signer: test.signer,
+        keys: test.keys,
+        poll: test.poll,
+        allow_loopback: test.allow_loopback,
+        ..TailnetConfig::from_env_on(dir.path(), zeron_proto::CLOUD_PLATFORM)
+    });
+    assert!(road_a.listening().is_none(), "a Cloud machine doesn't listen");
+    let at = road_b.listening().expect("B listens");
+    wait_until(Duration::from_secs(20), "A's list has B's Tailscale endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(at)
+    })
+    .await;
+
+    // A's calls take the relay; nothing reaches B's road.
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert!(came(&seen, methods::LIST_HARNESSES).is_empty());
+    // And B's list has no road for A.
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_eq!(endpoint_of(&engines.b, &engines.a_id), None);
+    assert!(logs::find("tailnet link serving calls from this device", &[("device", engines.a_id.as_str())]).is_empty());
+
+    drop((road_a, road_b));
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_peer_refuses_a_cloud_machine_that_dials_its_road() {
+    let engines = Engines::start("tailnet-refuses-cloud").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config(&account, 1, Some(noted)));
+    let at = road_b.listening().expect("B listens");
+
+    // A's row says it's a Cloud machine, and B's list has that.
+    let mut row = engines
+        .a
+        .workspace
+        .read_devices()
+        .unwrap()
+        .into_iter()
+        .find(|d| d.id == engines.a_id)
+        .unwrap();
+    row.platform = zeron_proto::CLOUD_PLATFORM.into();
+    engines.a.workspace.upsert_device_row(&row);
+    wait_until(Duration::from_secs(20), "B's list says A is a Cloud machine", || {
+        engines.b.workspace.read_devices().is_ok_and(|devices| {
+            devices
+                .iter()
+                .any(|d| d.id == engines.a_id && d.platform == zeron_proto::CLOUD_PLATFORM)
+        })
+    })
+    .await;
+
+    // Yet A dials the road (as a build that didn't stay off would): B
+    // refuses it, and the call reaches B another way.
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+    wait_until(Duration::from_secs(20), "A's list has B's Tailscale endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(at)
+    })
+    .await;
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    wait_until(Duration::from_secs(5), "B's road refused A", || {
+        logs::find("tailnet road refused a connection", &[])
+            .iter()
+            .any(|line| line.contains("not a device this one serves"))
+    })
+    .await;
+    assert!(came(&seen, methods::LIST_HARNESSES).is_empty(), "nothing served over the road");
+    assert!(logs::find("tailnet link serving calls from this device", &[("device", engines.a_id.as_str())]).is_empty());
+
+    drop(road_b);
+    engines.shutdown().await;
+}
+
+// ---- Ticket 05: the road looks after itself ----
+
+/// Whether something listens at `at` (a connection is taken).
+async fn answers(at: SocketAddr) -> bool {
+    matches!(
+        tokio::time::timeout(Duration::from_secs(1), tokio::net::TcpStream::connect(at)).await,
+        Ok(Ok(_))
+    )
+}
+
+/// Call `method` on `target` from `core` until it reaches `target`'s road
+/// (`seen` has one more): the first call after the road moved may still
+/// find the old link and go another way.
+async fn call_until_it_takes_the_road(core: &EngineCore, method: &str, target: &str, seen: &Seen) {
+    let before = came(seen, method).len();
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while came(seen, method).len() == before {
+        assert!(Instant::now() < deadline, "{method} to {target} never took the Tailscale road");
+        call(core, method, target).await;
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn the_road_follows_the_tailscale_address_as_it_comes_changes_and_goes() {
+    let engines = Engines::start("tailnet-follows").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    // B starts with no Tailscale address.
+    let address = Arc::new(FixedAddress::new(None));
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config_at(&account, 1, Some(noted), address.clone()));
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+
+    // No address: no listener, and no endpoint entry on its row.
+    assert_eq!(road_b.listening(), None);
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_eq!(road_b.listening(), None);
+    assert!(engines.b.workspace.device_endpoints(&engines.b_id).is_empty());
+    assert_eq!(endpoint_of(&engines.a, &engines.b_id), None);
+
+    // Tailscale comes up after the engine: picked up, served, advertised.
+    address.set(Some(LOOPBACK));
+    wait_until(Duration::from_secs(5), "B listens on the address that appeared", || {
+        road_b.listening().is_some_and(|at| at.ip() == LOOPBACK)
+    })
+    .await;
+    let first = road_b.listening().unwrap();
+    wait_until(Duration::from_secs(20), "A's list has B's endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(first)
+    })
+    .await;
+    call_until_it_takes_the_road(&engines.a, methods::LIST_HARNESSES, &engines.b_id, &seen).await;
+
+    // The address changes: the listener moves, the row follows, calls too.
+    address.set(Some(OTHER_LOOPBACK));
+    wait_until(Duration::from_secs(5), "B listens on the new address", || {
+        road_b.listening().is_some_and(|at| at.ip() == OTHER_LOOPBACK)
+    })
+    .await;
+    let second = road_b.listening().unwrap();
+    assert!(!answers(first).await, "nothing listens on the old address");
+    wait_until(Duration::from_secs(20), "A's list has B's new endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(second)
+    })
+    .await;
+    call_until_it_takes_the_road(&engines.a, methods::LIST_HARNESSES, &engines.b_id, &seen).await;
+
+    // The address goes: no listener, the entry is gone, calls go the old way.
+    address.set(None);
+    wait_until(Duration::from_secs(5), "B stops listening", || road_b.listening().is_none()).await;
+    assert!(!answers(second).await, "nothing listens on the last address");
+    assert!(engines.b.workspace.device_endpoints(&engines.b_id).is_empty());
+    wait_until(Duration::from_secs(20), "A's list has no endpoint for B", || {
+        endpoint_of(&engines.a, &engines.b_id).is_none()
+    })
+    .await;
+    let taken = came(&seen, methods::LIST_HARNESSES).len();
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert_eq!(came(&seen, methods::LIST_HARNESSES).len(), taken, "not over the road");
+
+    drop(road_b);
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn the_off_switch_takes_the_listener_and_the_endpoint_away() {
+    let engines = Engines::start("tailnet-off").await;
+    let account = account(&engines.a_id, &engines.b_id);
+    let (road_b, seen) = serve_noted(&engines.b, |noted| config(&account, 1, Some(noted)));
+    let _road_a = engines.a.start_tailnet_road(config(&account, 0, None));
+    let at = road_b.listening().expect("B listens");
+    wait_until(Duration::from_secs(20), "A's list has B's endpoint", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(at)
+    })
+    .await;
+
+    // Off: the listener closes at once and the entry goes.
+    road_b.set_enabled(false);
+    assert_eq!(road_b.listening(), None);
+    assert!(!answers(at).await, "nothing listens");
+    assert!(engines.b.workspace.device_endpoints(&engines.b_id).is_empty());
+    wait_until(Duration::from_secs(20), "A's list has no endpoint for B", || {
+        endpoint_of(&engines.a, &engines.b_id).is_none()
+    })
+    .await;
+    call(&engines.a, methods::LIST_HARNESSES, &engines.b_id).await;
+    assert!(came(&seen, methods::LIST_HARNESSES).is_empty(), "not over the road");
+
+    // On again: back on its address.
+    road_b.set_enabled(true);
+    let again = road_b.listening().expect("B listens again");
+    wait_until(Duration::from_secs(20), "A's list has B's endpoint again", || {
+        endpoint_of(&engines.a, &engines.b_id) == Some(again)
+    })
+    .await;
+    call_until_it_takes_the_road(&engines.a, methods::LIST_HARNESSES, &engines.b_id, &seen).await;
+    drop(road_b);
+
+    // Started switched off (ZERON_TAILNET=0 or the setting), with the entry
+    // its last run left on its row: never listens, and the entry goes.
+    assert!(!engines.b.workspace.device_endpoints(&engines.b_id).is_empty());
+    let off = engines.b.start_tailnet_road(TailnetConfig {
+        enabled: false,
+        ..config(&account, 1, None)
+    });
+    assert_eq!(off.listening(), None);
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_eq!(off.listening(), None);
+    assert!(engines.b.workspace.device_endpoints(&engines.b_id).is_empty());
+
+    drop(off);
+    engines.shutdown().await;
+}
