@@ -0,0 +1,113 @@
+//! Where another of the person's devices can be reached straight, without
+//! the edge: an `endpoints` field on its device row, which only that device
+//! writes (its Tailscale road's address and port, `kind: "tailnet"`).
+//!
+//! A field of its own rather than one on `zeron_proto::Device`, per-field LWW
+//! like every row field: an `upsert_device` never clears it, readers that
+//! don't know it ignore it, and an entry that doesn't parse is skipped, never
+//! the row. Peers read it from their cached list, so it's there while the
+//! edge is down.
+
+use super::*;
+
+/// The row field.
+pub const ENDPOINTS_FIELD: &str = "endpoints";
+/// An endpoint on the device's Tailscale address.
+pub const ENDPOINT_TAILNET: &str = "tailnet";
+
+/// One way to reach a device straight.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct DeviceEndpoint {
+    pub kind: String,
+    pub addr: String,
+    pub port: u16,
+}
+
+impl RegistryDoc {
+    /// `id`'s endpoints as its row has them (none: no row, no field, or
+    /// none that parse).
+    pub fn device_endpoints(&self, id: &str) -> Vec<DeviceEndpoint> {
+        let Some(row) = self.overlay_row(KIND_DEVICES, id) else {
+            return Vec::new();
+        };
+        match row.fields.get(ENDPOINTS_FIELD) {
+            Some(Value::Array(entries)) => entries
+                .iter()
+                .filter_map(|entry| serde_json::from_value(entry.clone()).ok())
+                .collect(),
+            _ => Vec::new(),
+        }
+    }
+
+    /// Write `id`'s endpoints (none: the field cleared), only when they
+    /// differ from what its row has. `false` when no such row.
+    pub fn set_device_endpoints(&mut self, id: &str, endpoints: &[DeviceEndpoint]) -> bool {
+        if !self.row_exists(KIND_DEVICES, id) {
+            return false;
+        }
+        let value = if endpoints.is_empty() {
+            Value::Null
+        } else {
+            json!(endpoints)
+        };
+        self.update_changed(
+            KIND_DEVICES,
+            id,
+            fields([(ENDPOINTS_FIELD, value)]),
+            |_, now, new| now == new,
+        );
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn device(id: &str) -> Device {
+        Device {
+            id: id.into(),
+            name: id.into(),
+            platform: "linux".into(),
+            last_seen_at: None,
+            created_at: None,
+            version: None,
+            cursor_sdk_version: None,
+            capabilities: vec![],
+        }
+    }
+
+    #[test]
+    fn a_devices_endpoints_survive_its_row_being_written_again_and_clear_when_gone() {
+        let mut doc = RegistryDoc::new("pc");
+        let tailnet = DeviceEndpoint {
+            kind: ENDPOINT_TAILNET.into(),
+            addr: "100.78.25.96".into(),
+            port: 27660,
+        };
+        assert!(!doc.set_device_endpoints("pc", std::slice::from_ref(&tailnet)), "no row yet");
+        doc.upsert_device(&device("pc")).unwrap();
+        assert!(doc.device_endpoints("pc").is_empty());
+        assert!(doc.set_device_endpoints("pc", std::slice::from_ref(&tailnet)));
+        assert_eq!(doc.device_endpoints("pc"), [tailnet.clone()]);
+        // The device's boot writes its row again: the field stays.
+        doc.upsert_device(&device("pc")).unwrap();
+        assert_eq!(doc.device_endpoints("pc"), [tailnet.clone()]);
+        // The same again writes nothing.
+        let pending = doc.pending.len();
+        doc.set_device_endpoints("pc", std::slice::from_ref(&tailnet));
+        assert_eq!(doc.pending.len(), pending);
+        // An entry that doesn't parse is skipped, the rest kept.
+        doc.write(
+            KIND_DEVICES,
+            "pc",
+            OpKind::Update,
+            fields([(ENDPOINTS_FIELD, json!([{ "kind": "future" }, tailnet]))]),
+        );
+        assert_eq!(doc.device_endpoints("pc"), [tailnet]);
+        assert_eq!(doc.read_devices().unwrap().len(), 1, "the row still parses");
+        // None: cleared.
+        assert!(doc.set_device_endpoints("pc", &[]));
+        assert!(doc.device_endpoints("pc").is_empty());
+    }
+}
