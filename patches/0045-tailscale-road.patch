new file mode 100644
index 0000000000000000000000000000000000000000..e443797fe90db36c998aa7789404da8ead950a83
--- /dev/null
+++ b/crates/engine/src/direct_rpc/tailnet_road.rs
@@ -0,0 +1,116 @@
+//! The Tailscale road's place among the roads (crate::tailnet): first, and
+//! a stalled or dead address costs a call about a second before the next
+//! road is taken.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use super::{Links, Pairing, RoadKind, Roads};
+
+/// The longest a call waits on the Tailscale road for a link: one it opens
+/// (a connect and a handshake take milliseconds on a tailnet) or one another
+/// call is opening. Past it the call takes the next road; the opening goes
+/// on, and a link it makes is there for the next call.
+pub(super) const TAILNET_WAIT: Duration = Duration::from_secs(1);
+
+impl Links {
+    /// Links named `name` over a [`Pairing`] whose streams have proved both
+    /// ends by the time they open (the Tailscale road): each serves calls
+    /// that need the verified caller.
+    pub fn proven_over(name: &'static str, pairing: Arc<dyn Pairing>) -> Self {
+        Self {
+            name,
+            proven_road: true,
+            ..Self::over(pairing)
+        }
+    }
+}
+
+impl Roads {
+    /// The Tailscale road before the others: `links` over it, to the devices
+    /// `serves` says have one.
+    pub fn with_tailnet(self, links: Links, serves: Arc<dyn Fn(&str) -> bool + Send + Sync>) -> Self {
+        self.first(RoadKind::Tailnet, links.open_within(TAILNET_WAIT), serves, TAILNET_WAIT)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+    use std::time::{Duration, Instant};
+
+    use serde_json::{Value, json};
+    use zeron_rpc::{RpcError, RpcReply, RpcService};
+
+    use super::super::{Links, Pairing, RoadKind, Roads, serve};
+
+    struct Named(&'static str);
+
+    #[async_trait::async_trait]
+    impl RpcService for Named {
+        async fn handle(&self, _method: &str, _params: Value) -> Result<RpcReply, RpcError> {
+            RpcReply::value(&json!(self.0))
+        }
+    }
+
+    /// A Tailscale peer that takes the connection and then says nothing:
+    /// its stream never opens.
+    struct Stalls;
+
+    #[async_trait::async_trait]
+    impl Pairing for Stalls {
+        async fn ready(&self, _device: &str) -> bool {
+            true
+        }
+        fn warm(&self, _device: &str) {}
+        async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+            tokio::time::sleep(Duration::from_secs(4)).await;
+            anyhow::bail!("the handshake took too long")
+        }
+    }
+
+    /// The WebRTC link's stand-in, up.
+    struct Up;
+
+    #[async_trait::async_trait]
+    impl Pairing for Up {
+        async fn ready(&self, _device: &str) -> bool {
+            true
+        }
+        fn warm(&self, _device: &str) {}
+        async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+            let (near, far) = tokio::io::duplex(64 * 1024);
+            tokio::spawn(serve(zeron_rpc::device_room::peer_service(Arc::new(Named("direct")), None), far));
+            Ok(Box::new(near))
+        }
+    }
+
+    /// A peer that accepts the Tailscale connection and stalls costs a call
+    /// about a second, then the call takes the next road; so does the next
+    /// call while that opening is still under way.
+    #[tokio::test]
+    async fn a_stalled_tailscale_peer_costs_about_a_second() {
+        let relay = zeron_rpc::LinkCache::new(zeron_rpc::LinkCacheConfig::new(
+            "http://127.0.0.1:9",
+            Arc::new(zeron_rpc::StaticToken("t".into())),
+        ));
+        let roads = Roads::new(relay, Links::over(Arc::new(Up)), Arc::new(|_: &str| true))
+            .with_tailnet(Links::proven_over("tailnet", Arc::new(Stalls)), Arc::new(|_: &str| true));
+
+        for (call, wait) in [
+            ("a plain call", Duration::ZERO),
+            ("a call while it's still opening", Duration::ZERO),
+            ("a big transfer", super::super::BULK_PATIENCE),
+        ] {
+            let started = Instant::now();
+            let road = roads.client_within("desktop", wait).await.expect("a road");
+            let took = started.elapsed();
+            assert_eq!(road.kind, RoadKind::WebRtc, "{call}");
+            assert!(took < wait.max(Duration::from_secs(1)) + Duration::from_millis(300), "{call}: {took:?}");
+        }
+        let started = Instant::now();
+        let road = roads.proven("desktop", Duration::ZERO).await;
+        assert!(road.is_none(), "the WebRTC stand-in proved nothing");
+        assert!(started.elapsed() < Duration::from_millis(1300), "{:?}", started.elapsed());
+    }
+}
