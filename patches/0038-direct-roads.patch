+    /// There is an open direct connection to `device` right now.
+    async fn ready(&self, device: &str) -> bool;
+    /// Start pairing with `device` in the background.
+    fn warm(&self, device: &str);
+    /// Open the [`SERVICE`] stream on `device` over the paired connection.
+    async fn open(&self, device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo>;
+}
