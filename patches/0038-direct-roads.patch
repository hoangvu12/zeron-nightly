+    /// What a plugin's host trusts as its caller is the device the edge
+    /// verified: those calls never take a direct link. The rest may.
+    #[test]
+    fn calls_that_need_the_verified_caller_keep_to_the_relay() {
+        for method in [
+            methods::REVIEW_PLUGIN,
+            methods::DECIDE_PLUGIN,
+            methods::INSTALL_PLUGIN,
+            methods::PLUGIN_DELIVER,
+            methods::SERVE_PLUGIN_CALL,
+            methods::SERVE_PLUGIN_AGENTS,
+        ] {
+            assert!(needs_verified_caller(method), "{method}");
+        }
+        for method in [
+            methods::READ_CHAT_IMAGE_CHUNK,
+            methods::READ_ATTACHMENT_CHUNK,
+            methods::READ_WORKSPACE_FILE,
+            methods::WATCH_WORKSPACE_GIT_STATUS,
+            methods::WATCH_QUEUE,
+            methods::UPLOAD_CHUNK,
+            methods::RELAY_COMMAND,
+        ] {
+            assert!(!needs_verified_caller(method), "{method}");
+        }
+    }
+
+    /// A call cut off on the direct link is asked again on the relay only
+    /// when asking twice can't do anything twice.
+    #[test]
+    fn only_reads_are_asked_again_on_the_relay() {
+        for method in [
+            methods::READ_CHAT_IMAGE_CHUNK,
+            methods::READ_WORKSPACE_FILE,
+            methods::LIST_MODELS,
+            methods::WATCH_QUEUE,
+            methods::SUBSCRIBE_TERMINAL,
+            methods::DEVICE_STATS,
+        ] {
+            assert!(repeatable(method), "{method}");
+        }
+        for method in [
+            methods::QUEUE_MESSAGE,
+            methods::RUN_COMMAND,
+            methods::WRITE_WORKSPACE_FILE,
+            methods::UPLOAD_COMMIT,
+            methods::GET_ACP_AGENT_SIGN_IN,
+            methods::APPLY_UPDATE,
+        ] {
+            assert!(!repeatable(method), "{method}");
+        }
+    }
+
