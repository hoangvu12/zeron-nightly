+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_forwarded_stream_takes_the_direct_link_when_up_and_the_relay_when_down() {
+    let (relay_url, relay) = fake_device_room().await;
+    let dirs = tempfile::tempdir().expect("tempdir");
+    let pair = direct_pair(dirs.path(), &relay_url, relay);
+
+    // A queued row in a chat on B (named A's for now, so B's drain leaves
+    // the row for the watch to show).
+    pair.core_b
+        .workspace
+        .create_chat("chat-queue-direct", None, Some("device-a"), None, None)
+        .expect("create chat");
+    pair.core_b
+        .workspace
