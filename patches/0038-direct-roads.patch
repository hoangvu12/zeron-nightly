+// ---------------------------------------------------------------------------
+// Direct links: device-addressed calls take the direct road when it's up
+// ---------------------------------------------------------------------------
+
+/// What reached B over the direct link, by method.
+type Seen = Arc<Mutex<Vec<String>>>;
+
+/// B's service as its direct link serves it, noting each call that came
+/// that way.
+struct NotedDirect {
+    inner: Arc<dyn RpcService>,
+    seen: Seen,
+}
+
+#[async_trait]
+impl RpcService for NotedDirect {
+    async fn handle(&self, method: &str, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        self.seen.lock().expect("lock").push(method.to_owned());
+        self.inner.handle(method, params).await
+    }
+}
+
+/// A stand-in for the WebRTC pairing between A and B: while `up`, a stream
+/// A opens reaches B's real direct RPC host (`direct_rpc::Service`, with
+/// its guard); `cut` drops every open link, as a lost connection does.
+struct DirectRig {
+    up: std::sync::atomic::AtomicBool,
+    host: zeron_engine::direct_rpc::Service,
+    pipes: Mutex<Vec<tokio::task::JoinHandle<()>>>,
+}
+
+impl DirectRig {
+    fn set_up(&self) {
+        self.up.store(true, Ordering::SeqCst);
+    }
+
+    async fn cut(&self) {
+        self.up.store(false, Ordering::SeqCst);
+        for pipe in self.pipes.lock().expect("lock").drain(..) {
+            pipe.abort();
+        }
+        // Let the far ends read the close.
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    }
+}
+
+#[async_trait]
+impl zeron_engine::direct_rpc::Pairing for DirectRig {
+    async fn ready(&self, _device: &str) -> bool {
+        self.up.load(Ordering::SeqCst)
+    }
+
+    fn warm(&self, _device: &str) {}
+
+    async fn open(&self, _device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        use zeron_preview::mux::Connector as _;
+        anyhow::ensure!(self.up.load(Ordering::SeqCst), "not paired");
+        let mut far = self
+            .host
+            .connect_from(Some("device-a"), zeron_engine::direct_rpc::SERVICE)
+            .await?;
+        let (near, mut pipe) = tokio::io::duplex(1024 * 1024);
+        self.pipes
+            .lock()
+            .expect("lock")
+            .push(tokio::spawn(async move {
+                let _ = tokio::io::copy_bidirectional(&mut far, &mut pipe).await;
+            }));
+        Ok(Box::new(near))
+    }
+}
+
+/// A and B in one device room, A's direct road to B through a [`DirectRig`]
+/// (down at first), and A's registry row for B saying B serves direct RPC.
+struct DirectPair {
+    core_a: EngineCore,
+    core_b: EngineCore,
+    rig: Arc<DirectRig>,
+    seen: Seen,
+    _direct_service: Arc<dyn RpcService>,
+    _host: HostRelay,
+    _relay: tokio::task::JoinHandle<()>,
+}
+
+fn direct_pair(dirs: &std::path::Path, relay_url: &str, relay: tokio::task::JoinHandle<()>) -> DirectPair {
+    let core_b = assemble(&dirs.join("b"), "device-b");
+    let host = core_b.start_host_relay(relay_url);
+    let seen = Seen::default();
+    let direct_service: Arc<dyn RpcService> = Arc::new(NotedDirect {
+        inner: core_b.rpc_service(),
+        seen: seen.clone(),
+    });
+    let rig = Arc::new(DirectRig {
+        up: Default::default(),
+        host: zeron_engine::direct_rpc::Service::new(&direct_service),
+        pipes: Default::default(),
+    });
+
+    let core_a = assemble(&dirs.join("a"), "device-a");
+    let mut row = device_row("device-b", env!("CARGO_PKG_VERSION"), 0);
+    row.capabilities = zeron_proto::capabilities::current();
+    row.capabilities
+        .push(zeron_proto::capabilities::DIRECT_RPC_V1.to_owned());
+    core_a.workspace.upsert_device_row(&row);
+    core_a.set_direct_links(zeron_engine::direct_rpc::Links::over(rig.clone()));
+    let mut link_config =
+        LinkCacheConfig::new(relay_url.to_owned(), Arc::new(StaticToken("test-user".into())));
+    link_config.probe_timeout = Duration::from_secs(5);
+    core_a.set_links(LinkCache::new(link_config));
+    DirectPair {
+        core_a,
+        core_b,
+        rig,
+        seen,
+        _direct_service: direct_service,
+        _host: host,
+        _relay: relay,
+    }
+}
+
+fn came_direct(seen: &Seen, method: &str) -> usize {
+    seen.lock()
+        .expect("lock")
+        .iter()
+        .filter(|m| m.as_str() == method)
+        .count()
+}
+
+/// A call through A, asked again while B's relay host is still coming up.
+async fn call_until_answered(
+    client: &zeron_rpc::RpcClient,
+    method: &str,
+    params: serde_json::Value,
+) -> serde_json::Value {
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(15);
+    loop {
+        match client.call(method, params.clone()).await {
+            Ok(value) => return value,
+            Err(err) => {
+                assert!(
+                    tokio::time::Instant::now() < deadline,
+                    "{method} never answered: {err}"
+                );
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+        }
+    }
+}
