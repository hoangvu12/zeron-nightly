+    let row = pair
+        .core_b
+        .doc_host
+        .queue_message_with_behavior("chat-queue-direct", "held on B", Vec::new(), true)
+        .expect("seed queue row");
+    let watch = serde_json::json!({
+        "chatId": "chat-queue-direct",
+        "targetDeviceId": "device-b",
+    });
+    let client = zeron_rpc::memory_client(pair.core_a.rpc_service());
+
+    // Paired: the stream opens on the direct link and its items come that way.
+    pair.rig.set_up();
+    let mut direct = client
+        .subscribe_checked(methods::WATCH_QUEUE, watch.clone())
+        .await
+        .expect("watch over the direct link");
+    let first = tokio::time::timeout(Duration::from_secs(5), direct.recv())
+        .await
+        .expect("a frame in time")
+        .expect("stream open");
+    assert_eq!(first["items"][0]["id"], row);
+    assert_eq!(came_direct(&pair.seen, methods::WATCH_QUEUE), 1);
+
+    // The link drops: the stream ends, as a relay link's does, and asked
+    // again it opens on the relay.
+    pair.rig.cut().await;
+    let ended = tokio::time::timeout(Duration::from_secs(5), async {
+        while direct.recv().await.is_some() {}
+    })
+    .await;
+    assert!(ended.is_ok(), "a stream on a dropped direct link ends");
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(15);
+    let mut relayed = loop {
+        match client
+            .subscribe_checked(methods::WATCH_QUEUE, watch.clone())
+            .await
+        {
+            Ok(stream) => break stream,
+            Err(err) => {
+                assert!(
+                    tokio::time::Instant::now() < deadline,
+                    "relay never came up: {err}"
+                );
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+        }
+    };
+    let again = tokio::time::timeout(Duration::from_secs(5), relayed.recv())
+        .await
+        .expect("a frame in time")
+        .expect("stream open");
+    assert_eq!(again["items"][0]["id"], row);
+    assert_eq!(came_direct(&pair.seen, methods::WATCH_QUEUE), 1);
+
+    pair.core_a.shutdown().await;
+    pair.core_b.shutdown().await;
+}
