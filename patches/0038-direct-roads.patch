+/// Calls whose host trusts the caller only as the device the edge verified
+/// on a relay link (`Caller::Peer{device: Some(..)}`): plugins' reviews,
+/// decisions and installs from another device, and what one plugin sends
+/// another's (its sender). A direct link's far end is the signaling's
+/// claim, not proven, so it's served as an unverified peer, and these would
+/// be refused or come from "Another device". They take the relay alone.
+pub fn needs_verified_caller(method: &str) -> bool {
+    matches!(
+        method,
+        methods::LIST_PLUGINS
+            | methods::WATCH_PLUGINS
+            | methods::REVIEW_PLUGIN
+            | methods::DECIDE_PLUGIN
+            | methods::SET_PLUGIN_OFF
+            | methods::REMOVE_PLUGIN
+            | methods::INSTALL_PLUGIN
+            | methods::STAGE_PLUGIN_PACKAGE
+            | methods::CHECK_PLUGIN_UPDATES
+            | methods::UPDATE_PLUGIN
+            | methods::PLUGIN_STATUS
+            | methods::PLUGIN_DELIVER
+            | methods::SERVE_PLUGIN_CALL
+            | methods::SERVE_PLUGIN_AGENTS
+    )
+}
+
+/// A call that only reads, so one the direct link dropped can be asked again
+/// on the relay at once: nothing ran twice if the first did reach the host.
+pub fn repeatable(method: &str) -> bool {
+    // (GetAcpAgentSignIn starts an agent to ask it.)
+    if method == methods::GET_ACP_AGENT_SIGN_IN {
+        return false;
+    }
+    ["Read", "List", "Get", "Search", "Watch", "Subscribe"]
+        .iter()
+        .any(|verb| method.starts_with(verb))
+        || matches!(method, methods::ENGINE_INFO | methods::DEVICE_STATS | methods::UPDATE_STATUS)
+}
+
+/// The road one call took.
+pub struct Road {
+    pub client: Arc<RpcClient>,
+    pub direct: bool,
+}
+
+/// Where a call to another of the person's devices goes: the direct link
+/// when the device advertises it ([`zeron_proto::capabilities::DIRECT_RPC_V1`])
+/// and one is up or opens now, else the relay. Every engine-to-engine call
+/// picks its road here, so the fallback, the invalidation after a failure
+/// and the log of road changes are the same for all of them.
+#[derive(Clone)]
+pub struct Roads {
+    relay: Arc<LinkCache>,
+    direct: Links,
+    serves_direct: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+}
+
+impl Roads {
+    /// `serves_direct`: whether a device's registry row advertises direct RPC.
+    pub fn new(
+        relay: Arc<LinkCache>,
+        direct: Links,
+        serves_direct: Arc<dyn Fn(&str) -> bool + Send + Sync>,
+    ) -> Self {
+        Self {
+            relay,
+            direct,
+            serves_direct,
+        }
+    }
+
+    pub fn relay(&self) -> &Arc<LinkCache> {
+        &self.relay
+    }
+
+    /// A client for a call of `method` to `target`: the direct link first,
+    /// unless the call needs the relay's verified caller.
+    pub async fn for_method(&self, target: &str, method: &str) -> Result<Road, RpcError> {
+        if needs_verified_caller(method) {
+            return self.by_relay(target).await;
+        }
+        self.client(target).await
+    }
+
+    /// A client for `target`: the direct link when it serves one and it's
+    /// up, else the relay (and pairing starts, for the next call).
+    pub async fn client(&self, target: &str) -> Result<Road, RpcError> {
+        if (self.serves_direct)(target) {
+            if let Some(client) = self.direct.client(target).await {
+                self.direct.note_road(target, true);
+                return Ok(Road {
+                    client,
+                    direct: true,
+                });
+            }
+            self.direct.note_road(target, false);
+        }
+        self.by_relay(target).await
+    }
+
+    /// The relay alone.
+    pub async fn by_relay(&self, target: &str) -> Result<Road, RpcError> {
+        Ok(Road {
+            client: self.relay.client(target).await?,
+            direct: false,
+        })
+    }
+
+    /// A call on `road` timed out or its link failed: drop that link, so
+    /// the next call opens afresh instead of feeding a dead pipe.
+    pub fn suspect(&self, target: &str, direct: bool) {
+        if direct {
+            self.direct.invalidate(target);
+        } else {
+            self.relay.invalidate(target);
+        }
+    }
+
+    /// Signed out: every link closes.
+    pub fn disconnect_all(&self) {
+        self.direct.close_all();
+        self.relay.disconnect_all();
+    }
+}
