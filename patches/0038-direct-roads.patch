+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_forwarded_image_read_takes_the_direct_link_when_up_and_the_relay_when_down() {
+    let (relay_url, relay) = fake_device_room().await;
+    let dirs = tempfile::tempdir().expect("tempdir");
+    let pair = direct_pair(dirs.path(), &relay_url, relay);
+
+    // A reply's picture, in a chat B hosts.
+    let pictures = dirs.path().join("b-chat-folder");
+    std::fs::create_dir_all(&pictures).unwrap();
+    let payload = b"\x89PNG\r\n\x1a\ndirect-or-relay";
+    std::fs::write(pictures.join("shot.png"), payload).unwrap();
+    pair.core_b
+        .workspace
+        .create_chat(
+            "chat-pictures",
+            None,
+            Some("device-b"),
+            None,
+            Some(pictures.to_string_lossy().into_owned()),
+        )
+        .unwrap();
+    let params = serde_json::json!({
+        "chatId": "chat-pictures",
+        "path": pictures.join("shot.png"),
+        "offset": 0,
+    });
+    let local = zeron_rpc::memory_client(pair.core_b.rpc_service())
+        .call(methods::READ_CHAT_IMAGE_CHUNK, params.clone())
+        .await
+        .unwrap();
+    let mut targeted = params;
+    targeted["targetDeviceId"] = "device-b".into();
+    let client = zeron_rpc::memory_client(pair.core_a.rpc_service());
+
+    // Not paired: the relay carries it.
+    let relayed = call_until_answered(&client, methods::READ_CHAT_IMAGE_CHUNK, targeted.clone()).await;
+    assert_eq!(relayed, local);
+    assert_eq!(came_direct(&pair.seen, methods::READ_CHAT_IMAGE_CHUNK), 0);
+
+    // Paired: the direct link carries it, the same bytes.
+    pair.rig.set_up();
+    let direct = client
+        .call(methods::READ_CHAT_IMAGE_CHUNK, targeted.clone())
+        .await
+        .expect("read over the direct link");
+    assert_eq!(direct, local);
+    assert_eq!(direct["size"], payload.len());
+    assert_eq!(came_direct(&pair.seen, methods::READ_CHAT_IMAGE_CHUNK), 1);
+    // Other unary reads go the same way.
+    let harnesses = client
+        .call(
+            methods::LIST_HARNESSES,
+            serde_json::json!({ "targetDeviceId": "device-b" }),
+        )
+        .await
+        .expect("list over the direct link");
+    assert!(harnesses.is_array());
+    assert_eq!(came_direct(&pair.seen, methods::LIST_HARNESSES), 1);
+
+    // A plugin call keeps to the relay: its host trusts only the device the
+    // edge verified, which a direct link can't prove.
+    let _ = client
+        .call(
+            methods::LIST_PLUGINS,
+            serde_json::json!({ "targetDeviceId": "device-b" }),
+        )
+        .await;
+    assert_eq!(came_direct(&pair.seen, methods::LIST_PLUGINS), 0);
+
+    // The link drops: the next read takes the relay, and still answers.
+    pair.rig.cut().await;
+    let after = call_until_answered(&client, methods::READ_CHAT_IMAGE_CHUNK, targeted).await;
+    assert_eq!(after, local);
+    assert_eq!(came_direct(&pair.seen, methods::READ_CHAT_IMAGE_CHUNK), 1);
+
+    pair.core_a.shutdown().await;
+    pair.core_b.shutdown().await;
+}
