+/// What a host already holds of one upload, as its `UploadStatus` says.
+enum HostHolds {
+    /// Assembled: nothing more to send.
+    Committed,
+    /// Staged chunks as `(seq, base64 length)`; none from a host too old to
+    /// say, which then gets every chunk, as before.
+    Chunks(Vec<(u64, u64)>),
+}
+
+/// Ask a host what it holds of an upload. `Err` only when the link failed: a
+/// host that can't say (too old, or it refused) is sent everything.
+async fn upload_status(
+    client: &zeron_rpc::RpcClient,
+    transfer: &crate::uploads::AttachmentTransfer,
+) -> Result<HostHolds, String> {
+    let params = serde_json::json!({
+        "uploadId": transfer.upload_id, "fileName": transfer.file_name,
+    });
+    let call = client.call(zeron_rpc::methods::UPLOAD_STATUS, params);
+    match tokio::time::timeout(TRANSFER_CHUNK_TIMEOUT, call).await {
+        Err(_) => Err("upload status timed out; peer link suspect".into()),
+        Ok(Err(err @ (zeron_rpc::RpcError::Transport(_) | zeron_rpc::RpcError::Closed))) => {
+            Err(format!("upload status failed: {err}"))
+        }
+        Ok(Err(_)) => Ok(HostHolds::Chunks(Vec::new())),
+        Ok(Ok(reply)) => Ok(
+            match serde_json::from_value::<crate::uploads::UploadStatus>(reply) {
+                Ok(status) if status.committed => HostHolds::Committed,
+                Ok(status) => HostHolds::Chunks(status.chunks),
+                Err(_) => HostHolds::Chunks(Vec::new()),
+            },
+        ),
+    }
+}
+
+/// The chunks of a `b64_len`-character upload still to send, as `(seq,
+/// start, end)` into its base64: each one the host doesn't hold exactly as it
+/// would be sent (missing, or of another length: a write cut short, or
+/// another chunking). A file of no bytes is one empty chunk, as the host's
+/// commit needs one.
+fn chunks_to_send(b64_len: usize, chunk: usize, staged: &[(u64, u64)]) -> Vec<(u64, usize, usize)> {
+    let count = b64_len.div_ceil(chunk).max(1);
+    (0..count)
+        .map(|i| {
+            let start = i * chunk;
+            (i as u64, start, (start + chunk).min(b64_len))
+        })
+        .filter(|(seq, start, end)| !staged.contains(&(*seq, (end - start) as u64)))
+        .collect()
+}
