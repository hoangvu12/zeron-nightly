+/// What a transfer's bytes are for: it goes on while that still waits.
+#[derive(Debug)]
+pub(crate) enum Awaiting {
+    /// A command in the chat's doc, by id.
+    Command(String),
+    /// A row in the chat's queue, by id, sent at `issued_at` (ms).
+    Row { id: String, issued_at: i64 },
