index 0000000000000000000000000000000000000000..23b3d9ab6b42e8580ef72991b748d06a45637a4e
--- /dev/null
+++ b/crates/engine/tests/flaky_link_attachments.rs
@@ -0,0 +1,377 @@
+//! A queued attachment over a peer link that keeps dropping. Engine A sends a
+//! message with a file to a chat hosted on engine B, through a device room
+//! that cuts A's connection after every few chunks it carries. A transfer that
+//! started over from its first byte after each drop never got past the cut;
+//! one that asks B what landed (`UploadStatus`) and sends only the rest
+//! finishes in a few connections, and B runs the message with the whole file.
+
+// tungstenite's `accept_hdr_async` callback signature fixes the Err type as a
+// full `Response` — its size is not ours to shrink.
+#![allow(clippy::result_large_err)]
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD as BASE64;
+use futures::stream::BoxStream;
+use futures::{SinkExt, StreamExt};
+use tokio::net::TcpListener;
+use tokio::sync::mpsc;
+use tokio_tungstenite::tungstenite::Message as WsMessage;
+use tokio_tungstenite::tungstenite::handshake::server::{
+    Request as WsRequest, Response as WsResponse,
+};
+
+use zeron_doc::{MessageRole, MessageStatus, SessionCommandPayload};
+use zeron_engine::{EngineCore, HarnessRegistry};
+use zeron_harness::{Harness, HarnessError, RunControls};
+use zeron_proto::{
+    AgentEvent, Device, DoneStatus, HarnessId, Model, ReasoningLevel, RunRequest, SandboxLevel,
+    SteeringMode,
+};
+use zeron_rpc::{
+    DeviceFrameHeader, LinkCache, LinkCacheConfig, StaticToken, decode_device_frame,
+    encode_device_frame, methods,
+};
+
+const CHAT: &str = "chat-flaky-link";
+/// Chunks a client connection carries before the room cuts it.
+const CHUNKS_PER_CONNECTION: usize = 10;
+
+#[derive(Default)]
+struct RelayState {
+    host: Option<mpsc::UnboundedSender<Vec<u8>>>,
+    clients: HashMap<String, mpsc::UnboundedSender<Vec<u8>>>,
+}
+
+/// A device room (route-only, as relay_delivery.rs's) that closes a client's
+/// socket once it has carried [`CHUNKS_PER_CONNECTION`] `UploadChunk` calls.
+/// `chunks` counts every chunk it carried to the host.
+async fn flaky_device_room(chunks: Arc<AtomicUsize>) -> (String, tokio::task::JoinHandle<()>) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind relay");
+    let url = format!(
+        "http://127.0.0.1:{}",
+        listener.local_addr().expect("addr").port()
+    );
+    let state = Arc::new(Mutex::new(RelayState::default()));
+    let task = tokio::spawn(async move {
+        loop {
+            let Ok((stream, _)) = listener.accept().await else {
+                break;
+            };
+            let state = state.clone();
+            let chunks = chunks.clone();
+            tokio::spawn(async move {
+                let mut uri = String::new();
+                let Ok(ws) = tokio_tungstenite::accept_hdr_async(
+                    stream,
+                    |req: &WsRequest, res: WsResponse| {
+                        uri = req.uri().to_string();
+                        Ok(res)
+                    },
+                )
+                .await
+                else {
+                    return;
+                };
+                let query = uri.split_once('?').map(|(_, q)| q).unwrap_or("");
+                let is_host = query.contains("role=host");
+                let conn_id = query
+                    .split('&')
+                    .find_map(|kv| kv.strip_prefix("connId="))
+                    .unwrap_or("anon")
+                    .to_string();
+                let (mut sink, mut ws_stream) = ws.split();
+                let (tx, mut rx) = mpsc::unbounded_channel::<Vec<u8>>();
+                {
+                    let mut st = state.lock().expect("lock");
+                    if is_host {
+                        st.host = Some(tx);
+                    } else {
+                        st.clients.insert(conn_id.clone(), tx);
+                    }
+                }
+                let writer = tokio::spawn(async move {
+                    while let Some(bytes) = rx.recv().await {
+                        if sink.send(WsMessage::Binary(bytes)).await.is_err() {
+                            break;
+                        }
+                    }
+                });
+                let mut carried = 0usize;
+                while let Some(Ok(message)) = ws_stream.next().await {
+                    let WsMessage::Binary(bytes) = message else {
+                        continue;
+                    };
+                    let Ok((header, payload)) = decode_device_frame(&bytes) else {
+                        break;
+                    };
+                    let is_chunk = !is_host
+                        && payload
+                            .windows(b"\"UploadChunk\"".len())
+                            .any(|w| w == b"\"UploadChunk\"");
+                    {
+                        let st = state.lock().expect("lock");
+                        if is_host {
+                            let Some(to) = header.to else { continue };
+                            if let Some(client) = st.clients.get(&to) {
+                                let stripped = DeviceFrameHeader::new(header.s, header.k);
+                                let _ = client.send(
+                                    encode_device_frame(&stripped, &payload).expect("encode"),
+                                );
+                            }
+                        } else if let Some(host) = &st.host {
+                            let mut routed = DeviceFrameHeader::new(header.s, header.k);
+                            routed.from = Some(conn_id.clone());
+                            let _ =
+                                host.send(encode_device_frame(&routed, &payload).expect("encode"));
+                        }
+                    }
+                    if is_chunk {
+                        chunks.fetch_add(1, Ordering::SeqCst);
+                        carried += 1;
+                        if carried >= CHUNKS_PER_CONNECTION {
+                            break; // the link drops
+                        }
+                    }
+                }
+                state.lock().expect("lock").clients.remove(&conn_id);
+                writer.abort();
+            });
+        }
+    });
+    (url, task)
+}
+
+struct InstantHarness;
+
+#[async_trait]
+impl Harness for InstantHarness {
+    fn id(&self) -> HarnessId {
+        HarnessId::Mock
+    }
+    fn display_name(&self) -> &str {
+        "Instant"
+    }
+    fn supports_steering(&self) -> bool {
+        false
+    }
+    fn steering_mode(&self) -> SteeringMode {
+        SteeringMode::TurnBoundary
+    }
+    fn reasoning_levels(&self) -> &[ReasoningLevel] {
+        &[]
+    }
+    async fn models(&self) -> Result<Vec<Model>, HarnessError> {
+        Ok(vec![])
+    }
+    async fn run(
+        &self,
+        request: RunRequest,
+        _controls: RunControls,
+    ) -> Result<BoxStream<'static, Result<AgentEvent, HarnessError>>, HarnessError> {
+        assert!(
+            !request.prompt.contains("pending://"),
+            "the run started before its file landed: {}",
+            request.prompt
+        );
+        Ok(futures::stream::iter([
+            Ok(AgentEvent::SessionStarted {
+                harness: HarnessId::Mock,
+                model: "instant-1".into(),
+                tools: vec![],
+                cwd: "/tmp".into(),
+                session_id: "hs-flaky".into(),
+                assistant_message_id: "a-1".into(),
+            }),
+            Ok(AgentEvent::TextDelta {
+                text: "got it".into(),
+            }),
+            Ok(AgentEvent::Done {
+                status: DoneStatus::Completed,
+                result: None,
+                error: None,
+                session_id: Some("hs-flaky".into()),
+            }),
+        ])
+        .boxed())
+    }
+}
+
+fn registry() -> Arc<HarnessRegistry> {
+    let registry = HarnessRegistry::new();
+    registry.register(Arc::new(InstantHarness));
+    Arc::new(registry)
+}
+
+fn assemble(dir: &std::path::Path, device_id: &str) -> EngineCore {
+    std::fs::create_dir_all(dir).expect("create data dir");
+    std::fs::write(dir.join("device-id"), device_id).expect("write device id");
+    EngineCore::assemble(dir, registry(), HarnessId::Mock, None).expect("engine assembles")
+}
+
+fn complete_assistant_count(core: &EngineCore) -> usize {
+    core.doc_host
+        .open(CHAT)
+        .ok()
+        .and_then(|h| h.doc().read_entries().ok())
+        .unwrap_or_default()
+        .iter()
+        .filter(|e| e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Complete))
+        .count()
+}
+
+/// The file named `name` anywhere under `dir`.
+fn find_file(dir: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    for entry in std::fs::read_dir(dir).ok()?.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            if let Some(found) = find_file(&path, name) {
+                return Some(found);
+            }
+        } else if path.file_name().is_some_and(|n| n == name) {
+            return Some(path);
+        }
+    }
+    None
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_file_over_a_link_that_keeps_dropping_resumes_and_lands_whole() {
+    let chunks = Arc::new(AtomicUsize::new(0));
+    let (relay_url, _relay) = flaky_device_room(chunks.clone()).await;
+    let dirs = tempfile::tempdir().expect("tempdir");
+
+    let core_b = assemble(&dirs.path().join("b"), "device-b");
+    let _host = core_b.start_host_relay(&relay_url);
+
+    let core_a = assemble(&dirs.path().join("a"), "device-a");
+    let mut link_config =
+        LinkCacheConfig::new(relay_url.clone(), Arc::new(StaticToken("test-user".into())));
+    link_config.probe_timeout = Duration::from_secs(5);
+    link_config.cooldown_base = Duration::from_millis(100);
+    link_config.cooldown_max = Duration::from_millis(500);
+    core_a.set_links(LinkCache::new(link_config));
+    core_a.workspace.upsert_device_row(&Device {
+        id: "device-b".into(),
+        name: "b".into(),
+        platform: "linux".into(),
+        last_seen_at: Some(chrono::Utc::now()),
+        created_at: None,
+        version: Some("0.3.21".into()),
+        cursor_sdk_version: None,
+        capabilities: zeron_proto::capabilities::current(),
+    });
+    let client_a = zeron_rpc::memory_client(core_a.rpc_service());
+    client_a
+        .call(
+            methods::MUTATE,
+            serde_json::json!({ "op": "createChat", "chatId": CHAT, "deviceId": "device-b" }),
+        )
+        .await
+        .expect("createChat on A");
+    core_b
+        .workspace
+        .rename_chat(CHAT, "Pre-titled")
+        .expect("pre-title on B (no auto-title harness run)");
+
+    // A 1.5 MB file: 34 chunks of 60,000 base64 characters, more than three
+    // times what one connection carries.
+    let bytes: Vec<u8> = (0..1_500_000u32)
+        .map(|i| (i.wrapping_mul(2_654_435_761) >> 13) as u8)
+        .collect();
+    let total_chunks = BASE64.encode(&bytes).len().div_ceil(60_000);
+    assert!(total_chunks > 3 * CHUNKS_PER_CONNECTION);
+    // Staged on A, as the composer does before it sends.
+    let encoded = BASE64.encode(&bytes);
+    for (seq, piece) in encoded.as_bytes().chunks(500_000).enumerate() {
+        client_a
+            .call(
+                methods::UPLOAD_CHUNK,
+                serde_json::json!({
+                    "uploadId": "att-flaky", "seq": seq,
+                    "data": std::str::from_utf8(piece).expect("base64 is ascii"),
+                }),
+            )
+            .await
+            .expect("stage chunk on A");
+    }
+    client_a
+        .call(
+            methods::UPLOAD_COMMIT,
+            serde_json::json!({ "uploadId": "att-flaky", "fileName": "big.bin" }),
+        )
+        .await
+        .expect("commit on A");
+
+    let reference = "pending://att-flaky/big.bin";
+    let command = serde_json::to_value(SessionCommandPayload::Run {
+        request: RunRequest {
+            mcp: None,
+            prompt: format!("look at this\n\nAttached files:\n- {reference}"),
+            harness: None,
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            cwd: "~".into(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            auto_approve: true,
+            access: Default::default(),
+            plan: false,
+            code_mode: false,
+            zeron_mcp_only: false,
+            attachments: vec![reference.into()],
+            worktree: None,
+            resume: None,
+            env: Default::default(),
+            extra_mcp: Vec::new(),
+        },
+        message_id: "msg-flaky-1".into(),
+    })
+    .expect("command json");
+    client_a
+        .call(
+            methods::QUEUE_COMMAND,
+            serde_json::json!({
+                "chatId": CHAT,
+                "command": command,
+                "transfers": [{ "uploadId": "att-flaky", "fileName": "big.bin" }],
+            }),
+        )
+        .await
+        .expect("queue on A");
+
+    // Each drop costs a backoff (2 s, 4 s, 8 s …) and a redial; four
+    // connections carry it.
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(90);
+    while complete_assistant_count(&core_b) < 1 {
+        assert!(
+            tokio::time::Instant::now() < deadline,
+            "the message never ran on B; {} chunks carried for a {total_chunks}-chunk file",
+            chunks.load(Ordering::SeqCst)
+        );
+        tokio::time::sleep(Duration::from_millis(250)).await;
+    }
+
+    let landed = find_file(&dirs.path().join("b"), "att-flak-big.bin")
+        .expect("B committed the file under its upload's name");
+    assert_eq!(
+        std::fs::read(landed).expect("read landed file"),
+        bytes,
+        "B holds the file whole"
+    );
+    // Resumed, not restarted: each drop resends at most the chunks that were
+    // in flight when it cut, never the file from its start.
+    let carried = chunks.load(Ordering::SeqCst);
+    assert!(
+        carried < total_chunks + total_chunks / 2,
+        "{carried} chunks carried for a {total_chunks}-chunk file"
+    );
+
+    core_a.shutdown().await;
+    core_b.shutdown().await;
+}
