+/// A sandbox provider or template as the engine lists it: `{id, name}`.
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct NamedRow {
+    pub id: String,
+    #[serde(default)]
+    pub name: String,
+}
+
+/// Where a chat's sandbox is made ([`Zeron::resolve_place`]): its provider
+/// and its template (`None`: Blank).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Place {
+    pub provider: NamedRow,
+    pub template: Option<NamedRow>,
+}
+
+impl Place {
+    /// What `ListHarnesses` / `ListModels` are asked for: the place's own
+    /// catalog, its template's agents.
+    pub fn target(&self) -> String {
+        zeron_proto::places::place_target(
+            &self.provider.id,
+            self.template.as_ref().map(|t| t.id.as_str()),
+        )
+    }
+}
+
+/// `name (id), …` of listed rows, for an error that says what there is.
+fn listed(rows: &[NamedRow]) -> String {
+    if rows.is_empty() {
+        return "none".to_owned();
+    }
+    rows.iter()
+        .map(|r| if r.name.is_empty() || r.name == r.id { r.id.clone() } else { format!("{} ({})", r.name, r.id) })
+        .collect::<Vec<_>>()
+        .join(", ")
+}
