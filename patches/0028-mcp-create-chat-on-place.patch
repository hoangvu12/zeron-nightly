+    /// A place to make a chat's sandbox on: the provider by id or name (as
+    /// `ListSandboxProviders` lists them), the template by id or exact name
+    /// from its account's (`ListSandboxTemplates`, asked each time: one saved
+    /// or removed since shows), or Blank for none, `blank` or "". An image
+    /// reference the account doesn't list (it holds `/`) goes as is.
+    pub async fn resolve_place(&self, provider: &str, template: Option<&str>) -> anyhow::Result<Place> {
+        let provider = provider.trim();
+        let providers = self
+            .call(methods::LIST_SANDBOX_PROVIDERS, json!({}))
+            .await
+            .context("this Zeron lists no sandbox providers")?;
+        let providers: Vec<NamedRow> = serde_json::from_value(providers).unwrap_or_default();
+        let provider = providers
+            .iter()
+            .find(|p| p.id == provider)
+            .or_else(|| {
+                providers
+                    .iter()
+                    .find(|p| p.id.eq_ignore_ascii_case(provider) || p.name.eq_ignore_ascii_case(provider))
+            })
+            .with_context(|| {
+                format!(
+                    "no sandbox provider matches {provider:?}; known: {}",
+                    listed(&providers)
+                )
+            })?
+            .clone();
+        let template = template
+            .map(str::trim)
+            .filter(|t| !t.is_empty() && !t.eq_ignore_ascii_case("blank"));
+        let Some(template) = template else {
+            return Ok(Place { provider, template: None });
+        };
+        let templates = self
+            .call(methods::LIST_SANDBOX_TEMPLATES, json!({ "provider": provider.id }))
+            .await
+            .with_context(|| format!("{}'s templates", provider.name))?;
