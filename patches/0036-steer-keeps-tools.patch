+        .run(request("scenario:busy-steer"), controls)
+        .await
+        .expect("run starts");
+    let events = tokio::time::timeout(Duration::from_secs(15), async move {
+        let mut events = Vec::new();
+        let mut stream = stream;
+        let mut steer = Some(steer);
+        let (mut settled, mut tool_open, mut sent) = (false, false, false);
+        while let Some(ev) = stream.next().await {
+            let ev = ev.expect("stream event");
+            // The tool opens after the owned turn settled: the agent's own.
+            tool_open |= matches!(&ev, AgentEvent::ToolCall { id, .. } if id == "sc-1");
+            settled |= matches!(ev, AgentEvent::Done { .. });
+            if settled && tool_open && !sent
