+/// Claude Code on a CLI that moves running work aside: the person's steer
+/// during a command goes straight to the agent, no stop first. The agent
+/// reads it at once and the command runs on in the background, so the
+/// turn ends completed, not stopped, in the same runtime.
+#[tokio::test]
+async fn a_steer_to_an_agent_that_moves_the_command_aside_stops_nothing() {
+    let rig = rig_moving_tools();
+    let turn = running_a_command(&rig).await;
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    assert!(
+        !rig.core.sessions.steer_stops_tool(CHAT),
+        "a command is open, but this agent doesn't need it stopped"
+    );
+    steer(&rig, "stop and look at the logs", "m-steer");
+    wait_for(
+        || read(&rig).iter().any(|p| p == "stop and look at the logs"),
+        "the steer to be read while the command runs",
+    )
+    .await;
+    wait_for(
+        || status(&rig.core) == Some(SessionStatus::Idle),
+        "the steered turn to end",
+    )
+    .await;
+    assert_eq!(rig.ledger.stops.load(Ordering::SeqCst), 0, "no interrupt");
+    assert_eq!(rig.ledger.kills.load(Ordering::SeqCst), 0, "no teardown");
+    assert_eq!(rig.ledger.spawns.load(Ordering::SeqCst), 1, "the same runtime");
+    assert!(turn.background_live(), "the command runs on in the background");
+    let doc = rig.core.doc_host.open(CHAT).unwrap();
+    let entries = doc.doc().read_entries().unwrap();
+    assert!(
+        !entries
+            .iter()
+            .any(|e| e.status == Some(MessageStatus::Aborted)),
+        "nothing reads as stopped"
+    );
+    assert_eq!(
+        entries.iter().filter(|e| e.id == "m-steer").count(),
+        1,
+        "the steer is in the transcript once"
+    );
+    rig.core.sessions.shutdown().await;
+}
+
+/// The same agent, a message from another chat: still no stop, and it is
+/// read once the command returns, as before.
