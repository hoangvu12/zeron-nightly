+*scenario:tool-steer*)
+  # A steer while a foreground Bash runs. The next stdin line is the steer
+  # (an interrupt instead would kill the command): the text says how it
+  # came — `now` from a human, `next`, plain `now`, or an interrupt. As
+  # 2.1.328 does for `now` from a human, the command then moves to the
+  # background (shapes from `live-2.1.328-steer-bash.jsonl`).
+  emit '{"type":"system","subtype":"init","model":"claude-opus-5-5","tools":[],"cwd":"/tmp","session_id":"sess-tool-steer"}'
+  emit '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_run","name":"Bash","input":{"command":"make test","description":"Run the tests"}}]},"parent_tool_use_id":null,"session_id":"sess-tool-steer"}'
+  emit '{"type":"system","subtype":"task_started","task_id":"bt1","tool_use_id":"toolu_run","description":"Run the tests","is_backgrounded":false,"task_type":"local_bash","session_id":"sess-tool-steer"}'
+  read -r steer || exit 1
+  case "$steer" in
+    *'"subtype":"interrupt"'*) shape=interrupt ;;
+    *'"origin":{"kind":"human"}'*)
+      case "$steer" in *'"priority":"now"'*) shape=now-human ;; *) shape=other-human ;; esac ;;
+    *'"origin"'*) shape=other-origin ;;
+    *'"priority":"next"'*) shape=next ;;
+    *'"priority":"now"'*) shape=now ;;
+    *) shape=none ;;
+  esac
+  if [ "$shape" = now-human ]; then
+    emit '{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bt1","task_type":"local_bash","description":"Run the tests"}],"session_id":"sess-tool-steer"}'
+    emit '{"type":"system","subtype":"task_updated","task_id":"bt1","patch":{"is_backgrounded":true},"session_id":"sess-tool-steer"}'
+    emit '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_run","type":"tool_result","content":"Command was moved to the background (ID: bt1) so that a message that arrived while it was running can reach you; it was not interrupted. Output is being written to: /tmp/claude-1000/s/tasks/bt1.output.","is_error":false}]},"parent_tool_use_id":null,"session_id":"sess-tool-steer","tool_use_result":{"stdout":"","stderr":"","interrupted":false,"backgroundTaskId":"bt1","backgroundedToDeliverMessage":true}}'
+  else
+    emit '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_run","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"sess-tool-steer"}'
+  fi
+  # The steer, replayed as the turn takes it up.
+  [ "$shape" = interrupt ] || emit "$steer"
+  emit "{\"type\":\"stream_event\",\"parent_tool_use_id\":null,\"event\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"steer:$shape\"}}}"
+  emit '{"type":"result","subtype":"success","is_error":false,"result":"done","usage":{"input_tokens":1,"output_tokens":1},"session_id":"sess-tool-steer"}'
+  ;;
