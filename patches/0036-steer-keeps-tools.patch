+/// as the real one does; every other launch runs the fake.
+fn cli_of_version(dir: &std::path::Path, version: &str) -> ClaudeHarness {
+    use std::os::unix::fs::PermissionsExt;
+    let path = dir.join(format!("claude-{version}"));
+    std::fs::write(
+        &path,
+        format!(
+            "#!/bin/sh\n[ \"$1\" = --version ] && {{ echo '{version} (Claude Code)'; exit 0; }}\nexec '{}' \"$@\"\n",
+            fixture_path().display()
+        ),
+    )
+    .unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+    ClaudeHarness::new().with_executable(path)
+}
+
+/// Runs `scenario:tool-steer`, steering with `prompt` once the command is
+/// running; the text the fake CLI answers with says how the steer came.
+async fn steer_during_a_command(harness: &ClaudeHarness, prompt: &str) -> Vec<AgentEvent> {
+    let (controls, steer, _token) = controls("A");
+    let stream = harness
+        .run(request("scenario:tool-steer"), controls)
+        .await
+        .expect("run starts");
+    tokio::time::timeout(Duration::from_secs(10), async move {
+        let mut stream = stream;
+        // Open until the run ends: a closed mailbox ends the CLI's stdin.
+        let steer = steer;
+        let mut sent = false;
+        let mut events = Vec::new();
+        while let Some(ev) = stream.next().await {
+            let ev = ev.expect("stream event");
+            if matches!(&ev, AgentEvent::ToolCall { id, .. } if id == "toolu_run") && !sent {
+                sent = true;
+                steer.send(SteerMessage::text(prompt)).await.expect("steer sent");
+            }
+            events.push(ev);
+        }
+        events
+    })
+    .await
+    .expect("run finished in time")
+}
+
+fn steer_shape(events: &[AgentEvent]) -> &str {
+    events
+        .iter()
+        .find_map(|e| match e {
+            AgentEvent::TextDelta { text } => text.strip_prefix("steer:"),
+            _ => None,
+        })
+        .expect("the fake CLI read the steer")
+}
+
+/// The person's steer on a CLI that moves running work aside (2.1.286+)
+/// goes as `now` from a human, and the command it reached reads as moved to
+/// the background: no exit code, not failed.
+#[tokio::test]
+async fn the_persons_steer_during_a_command_is_now_from_a_human_on_a_new_cli() {
+    let dir = tempfile::tempdir().unwrap();
+    let harness = cli_of_version(dir.path(), "2.1.328");
+    assert!(!harness.steer_stops_tool(), "the engine stops nothing first");
+    let events = steer_during_a_command(&harness, "look at the logs").await;
+    assert_eq!(steer_shape(&events), "now-human", "{events:?}");
+    let result = events
+        .iter()
+        .find_map(|e| match e {
+            AgentEvent::ToolResult { id, is_error, exit_code, output, .. } if id == "toolu_run" => {
+                Some((*is_error, *exit_code, output.clone()))
+            }
+            _ => None,
+        })
+        .expect("the command's result");
+    assert_eq!(result.0, false, "moved, not failed");
+    assert_eq!(result.1, None, "still running: no exit code");
+    assert!(
+        result.2.as_deref().is_some_and(|o| o.contains("moved to the background")),
+        "{result:?}"
+    );
+    assert!(matches!(
+        events.last(),
+        Some(AgentEvent::Done { status: DoneStatus::Completed, .. })
+    ));
+}
+
+/// Another chat's message is not the person's: on any CLI it waits for the
+/// running command (`next`) and never claims a human origin.
+#[tokio::test]
+async fn another_chats_message_during_a_command_stays_next() {
+    let dir = tempfile::tempdir().unwrap();
+    let message =
+        zeron_proto::agent_messages::agent_message("Coordinator (139d8682)", "139d8682", "status?");
+    for version in ["2.1.328", "2.1.280"] {
+        let harness = cli_of_version(dir.path(), version);
+        let events = steer_during_a_command(&harness, &message).await;
+        assert_eq!(steer_shape(&events), "next", "{version}: {events:?}");
+    }
+}
+
+/// An older CLI would interrupt the command for a `now` steer: the steer
+/// keeps the old path (`next` while a tool is open), and the engine's stop
+/// stays what reads it at once there.
+#[tokio::test]
+async fn an_older_cli_keeps_the_old_steer_path() {
+    let dir = tempfile::tempdir().unwrap();
+    let harness = cli_of_version(dir.path(), "2.1.280");
+    assert!(harness.steer_stops_tool());
+    let events = steer_during_a_command(&harness, "look at the logs").await;
+    assert_eq!(steer_shape(&events), "next", "{events:?}");
+    let exit = events.iter().find_map(|e| match e {
+        AgentEvent::ToolResult { id, exit_code, .. } if id == "toolu_run" => Some(*exit_code),
+        _ => None,
+    });
+    assert_eq!(exit, Some(Some(0)), "a command that returned exited 0");
+}
