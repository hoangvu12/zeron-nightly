+    /// The person's `/compact` to a Claude chat: its divider is in the
+    /// transcript, running, as its turn starts, before the agent says a
+    /// word (a CLI stopped while idle says it's compacting only once it's
+    /// up and has read the session back); a message sent meanwhile waits;
+    /// the agent's own start and end go into that one divider.
+    #[tokio::test]
+    async fn a_compact_sent_shows_its_divider_before_the_agent_speaks() {
+        let chat = "chat-compact-at-once";
+        let (feed, rx) = mpsc::unbounded_channel();
+        let turn_slot = Arc::new(Mutex::new(None));
+        let registry = HarnessRegistry::new();
+        registry.register(Arc::new(WakeHarness {
+            id: HarnessId::ClaudeCode,
+            feed: Mutex::new(Some(rx)),
+            turn: turn_slot.clone(),
+        }));
+        let dir = tempfile::tempdir().unwrap();
+        let core = crate::EngineCore::assemble(
+            dir.path(),
+            Arc::new(registry),
+            HarnessId::ClaudeCode,
+            None,
+        )
+        .unwrap();
+        let compactions = || -> Vec<(Option<u64>, Option<u64>)> {
+            core.doc_host
+                .open(chat)
+                .unwrap()
+                .doc()
+                .read_entries()
+                .unwrap_or_default()
+                .iter()
+                .flat_map(|e| e.parts.iter())
+                .filter_map(|p| match p {
+                    MessagePart::Compaction {
+                        pre_tokens,
+                        post_tokens,
+                        ..
+                    } => Some((*pre_tokens, *post_tokens)),
+                    _ => None,
+                })
+                .collect()
+        };
+        core.sessions
+            .dispatch(
+                chat,
+                HarnessId::ClaudeCode,
+                RunRequest {
+                    prompt: "/compact".into(),
+                    ..request()
+                },
+                None,
+            )
+            .await
+            .unwrap();
+        // (Nothing from the agent yet.)
+        tokio::time::sleep(std::time::Duration::from_millis(150)).await;
+        assert_eq!(compactions(), [(None, None)], "a running divider at once");
+        assert!(core.sessions.defers_to_turn_end(chat, None));
+
+        feed.send(started()).unwrap();
+        feed.send(AgentEvent::Compaction {
+            pre_tokens: Some(250_000),
+            post_tokens: None,
+            summary: None,
+        })
+        .unwrap();
+        feed.send(AgentEvent::Compaction {
+            pre_tokens: Some(250_000),
+            post_tokens: Some(20_000),
+            summary: None,
+        })
+        .unwrap();
+        feed.send(done(DoneStatus::Completed)).unwrap();
+        tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+        assert_eq!(compactions(), [(Some(250_000), Some(20_000))], "one divider");
+        assert!(!core.sessions.defers_to_turn_end(chat, None));
+        core.sessions.shutdown().await;
+    }
+
