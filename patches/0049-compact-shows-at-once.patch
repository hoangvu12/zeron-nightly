From: hoangvu12 <hggaming91@gmail.com>
Date: Sat, 28 Nov 2026 14:47:27 +0700
Subject: [PATCH] engine: a /compact the person sends shows "Compacting" as its
 turn starts

A /compact sent to a Claude Code chat (typed, picked from the / list, or
the composer's Compact chat) showed nothing until the CLI said it was
compacting: once it was up and had read the session back, seconds later
for a long chat whose process had been stopped while idle. Its divider
now shows as the turn starts, with the context it compacts, as the
engine's own idle compaction's already did, and the turn counts as
compacting from then on (a message sent meanwhile waits for it). The
CLI's own start goes into the same divider.

crates/engine/src/sessions.rs only. Tests:
a_compact_to_claude_shows_as_its_turn_starts (which prompts count) and
a_compact_sent_shows_its_divider_before_the_agent_speaks (a running
divider before the agent says a word, one divider after its start and
end, a message held meanwhile).
---
 crates/engine/src/sessions.rs | 129 +++++++++++++++++++++++++++++++++-
 1 file changed, 126 insertions(+), 3 deletions(-)

diff --git a/crates/engine/src/sessions.rs b/crates/engine/src/sessions.rs
index c972f57ec09e58ae15c72c798c41b9a4f68fbe16..a0368973f7f87bd283ff7ef795244fb72061ba46 100644
--- a/crates/engine/src/sessions.rs
+++ b/crates/engine/src/sessions.rs
@@ -1745,8 +1745,14 @@ impl SessionsEngine {
         let interrupt_token = CancellationToken::new();
         let turn = TurnControl::default();
         let started = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        // The person's own `/compact` (typed, picked from the `/` list, or the
+        // composer's Compact chat): a compaction from its first moment, not
+        // from the CLI's first word about it.
+        let compacts_now = !quiet && !idle && compacts_at_once(&request.prompt, harness_id);
         let compacting = Arc::new(std::sync::atomic::AtomicU8::new(if quiet {
             COMPACTING_OWN
+        } else if compacts_now {
+            COMPACTING
         } else {
             NOT_COMPACTING
         }));
@@ -1859,8 +1865,12 @@ impl SessionsEngine {
             self.inner.note_message(chat_id, &request.prompt);
         }
         // Its divider shows at once (with the context it compacts), and the
-        // journal says what the turn was: a restart doesn't revive it.
-        if quiet {
+        // journal says what the turn was: a restart doesn't revive it. The
+        // person's `/compact` too: the CLI says it's compacting only once
+        // it's up and has read the session back, seconds later for a long
+        // chat whose process was stopped while idle ("Compacting" showed
+        // late). Its own start, when it comes, goes into the same divider.
+        if quiet || compacts_now {
             let tokens = handle.doc().context_usage().and_then(|u| u.tokens);
             if let Some(h) = lock(&self.inner.runs).get(chat_id).filter(|h| h.run_id == run_id) {
                 let _ = h.engine_tx.send(AgentEvent::Compaction {
@@ -4664,6 +4674,17 @@ impl SessionsEngine {
     }
 }
 
+/// Whether `prompt` is a `/compact` (with or without its instructions) to
+/// an agent that says when it compacts (Claude Code), whose divider can
+/// show as its turn starts: typed, or picked from the `/` list (a command
+/// link, delivered as `/compact`).
+fn compacts_at_once(prompt: &str, harness: HarnessId) -> bool {
+    use zeron_proto::invocation;
+    harness == HarnessId::ClaudeCode
+        && invocation::leading_command(&invocation::harness_prompt(prompt, harness))
+            .is_some_and(|(name, _)| name == "compact")
+}
+
 /// Whether the provider routes this prompt as a native command: a command
 /// selected in the composer leads it, or its delivered text leads with a
 /// `/name` in the command grammar (Codex `command_request`, OpenCode
@@ -8838,6 +8859,26 @@ mod tests {
         ));
     }
 
+    #[test]
+    fn a_compact_to_claude_shows_as_its_turn_starts() {
+        let claude = HarnessId::ClaudeCode;
+        assert!(compacts_at_once("/compact", claude));
+        assert!(compacts_at_once("\n  /compact keep the API notes", claude));
+        let picked = zeron_proto::invocation::Invocation::Command {
+            name: "compact".into(),
+        }
+        .link();
+        assert!(compacts_at_once(&picked, claude));
+        assert!(compacts_at_once(&format!("{picked} keep the API notes"), claude));
+        // Not a compaction, or not an agent that says when it compacts.
+        assert!(!compacts_at_once("/compacting", claude));
+        assert!(!compacts_at_once("/review", claude));
+        assert!(!compacts_at_once("please /compact", claude));
+        assert!(!compacts_at_once("    /compact", claude), "indented: code");
+        assert!(!compacts_at_once("/compact", HarnessId::Codex));
+        assert!(!compacts_at_once("/compact", HarnessId::Mock));
+    }
