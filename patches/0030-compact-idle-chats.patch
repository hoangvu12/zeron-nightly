new file mode 100644
index 0000000000000000000000000000000000000000..7ef3b2a680db7823514b8b8fc7fd08a1f38badbd
--- /dev/null
+++ b/apps/zgx/ui/ds/compaction.luau
@@ -0,0 +1,146 @@
+-- Where a chat's context was compacted (`/compact`, or Zeron's own before an
+-- idle chat's prompt cache expires): one divider across the transcript,
+-- its line in the middle. While it runs, "Compacting 240k tokens…" with
+-- the working ring; done, "Compacted 240k → 18k tokens", which opens the
+-- summary the agent goes on from under it.
+--
+--   Compaction { id = m.id, now = function() return row:get() end }
+--
+-- `now()` gives what the host says of it (src/chat.rs `compaction_value`):
+-- `pre` and `post` (tokens; `post` none while it runs), `summary`, `live`
+-- (running now) and `stopped` (its turn ended before it did).
+
+local Icon = require("@self/icon")
+local Markdown = require("@self/markdown")
+local status = require("@self/status")
+local locale = require("@self/locale")
+
+export type Data = { pre: number?, post: number?, summary: string?, live: boolean?, stopped: boolean? }
+
+local M = {}
+
+-- A count of tokens as the divider and the composer's notice say it:
+-- "240k", "1.5k", "980".
+function M.short(n: number): string
+	if n >= 10000 then
+		return `{math.floor(n / 1000 + 0.5)}k`
+	elseif n >= 1000 then
+		return string.format("%.1fk", n / 1000)
+	end
+	return tostring(math.floor(n))
+end
+
+-- Its line, as it stands.
+function M.line(d: Data): string
+	if d.post then
+		return if d.pre
+			then locale.s("ds.transcript.compaction.done", { pre = M.short(d.pre), post = M.short(d.post) })
+			else locale.s("ds.transcript.compaction.done_to", { post = M.short(d.post) })
+	elseif d.stopped then
+		return locale.s("ds.transcript.compaction.stopped")
+	end
+	return if d.pre
+		then locale.s("ds.transcript.compaction.running", { n = M.short(d.pre) })
+		else locale.s("ds.transcript.compaction.running_unknown")
+end
+
+-- Which summaries are open, by the divider's id: one map, so a divider
+-- scrolled away and back keeps it.
+local OPEN = ui.state("transcript_compaction_open", {} :: { [string]: boolean })
+
+local function rule(): Node
+	return ui.div { h = 1, grow = 1, min_w = 16, bg = "$border.subtle", aria_hidden = true }
+end
+
+function M.Compaction(props: { id: string, now: () -> Data }): Node
+	local function open(): boolean
+		return OPEN:get()[props.id] == true
+	end
+	local function has_summary(): boolean
+		local s = props.now().summary
+		return s ~= nil and s ~= ""
+	end
+	local function toggle()
+		local all = table.clone(OPEN:peek())
+		all[props.id] = if all[props.id] then nil else true
+		OPEN:set(all)
+	end
+	local function label(): string
+		return M.line(props.now())
+	end
+	return ui.column {
+		class = "compaction",
+		w_full = true,
+		gap = "$space.2",
+		ui.row {
+			w_full = true,
+			items = "center",
+			gap = "$space.3",
+			selectable = false,
+			rule(),
+			-- (With a summary to open, a button; while it runs, or with none,
+			-- only its words.)
+			ui.presence(function(): string
+				return if has_summary() then "button" else "line"
+			end, function(kind: string): Node
+				local line: { [any]: any } = {
+					class = "compaction-line",
+					h = 24,
+					px = "$space.2",
+					gap = "$space.2",
+					items = "center",
+					min_w = 0,
+					rounded = "$radius.md",
+					color = "$text.secondary",
+					ui.show(function(): boolean
+						return props.now().live == true
+					end, status.Spinner { size = 12, ink = "$text.secondary" }),
+					ui.text { label, text_size = "$font.size.sm", weight = "$font.weight.medium", truncate = true },
+				}
+				if kind == "line" then
+					line.role = "status"
+					line.label = label
+					return ui.row(line)
+				end
+				line.label = label
+				line.expanded = open
+				line.bg = "#00000000"
+				line.hover = { color = "$text.primary", bg = "$zeron.secondary.bg" }
+				line.active = { bg = "$zeron.secondary.hover" }
+				line.cursor = "pointer"
+				line.on_click = toggle
+				table.insert(line, ui.div {
+					aria_hidden = true,
+					Icon {
+						name = function(): string
+							return if open() then "alt-arrow-up" else "alt-arrow-down"
+						end,
+						size = 12,
+					},
+				})
+				return ui.button(line)
+			end, { min_w = 0 }),
+			rule(),
+		},
+		ui.presence(function(): string?
+			return if open() and has_summary() then "open" else nil
+		end, function(): Node
+			return ui.column {
+				class = "compaction-summary",
+				w_full = true,
+				p = "$space.4",
+				rounded = "$radius.lg",
+				bg = "$zeron.secondary.bg",
+				color = "$text.secondary",
+				text_size = "$font.size.sm",
+				Markdown {
+					text = function(): string
+						return props.now().summary or ""
+					end,
+				},
+			}
+		end, { enter = { opacity = { 0, 1 }, duration = 150 } }),
+	}
+end
+
+return M
