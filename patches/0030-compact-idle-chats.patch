diff --git a/apps/zgx/ui/screens/chat/idle_compact.luau b/apps/zgx/ui/screens/chat/idle_compact.luau
new file mode 100644
index 0000000000000000000000000000000000000000..b3d6dae7559988e12ce58bd05eec94fbdc972e7f
--- /dev/null
+++ b/apps/zgx/ui/screens/chat/idle_compact.luau
@@ -0,0 +1,192 @@
+-- "Next message resends 240k tokens": a Claude chat's alert on its
+-- composer's deck once its prompt cache has expired with a large context,
+-- so the next message sends all of it again at full price. Its action is
+-- Compact chat (`/compact`, as typed); Send still just sends. × puts it
+-- away for the chat until its cache expires again.
+--
+--   local idle = IdleCompact.bind { session = fn, text = shared.text, send = fn }
+--   alerts = idle.merged(machine.alerts), on_alert_action = idle.on_alert(machine.on_alert),
+--   on_dismiss_alert = idle.on_dismiss(machine.dismiss)
+--
+-- It reads the session's `context_tokens`, `cache_expires` (Unix ms, nil
+-- when not known: taken as expired), `harness`, `child` and `running`.
+
+local Draft = require("@ds/draft_text")
+local compaction = require("@ds/compaction")
+local sessions = require("@account/sessions")
+
+local M = {}
+
+-- As large as a context must be (the engine's idle compaction's floor).
+M.MIN_TOKENS = 200000
+-- The alert's id in the deck.
+M.ID = "idle-compact"
+
+-- Put away, by chat: the cache expiry it was put away for. Kept across
+-- launches; a new expiry (a turn since) shows it again.
+local DISMISSED = ui.persist("idle_compact_dismissed", {} :: { [string]: string })
+-- Moved as a cache expires, so the alert is judged again then; nothing
+-- ticks otherwise.
+local TICK = ui.state("idle_compact_tick", 0)
+local due: { [number]: boolean } = {}
+
+local function now_ms(): number
+	return os.time() * 1000
+end
+
+local function judge_again_at(ms: number)
+	local key = math.ceil(ms / 1000)
+	if due[key] then
+		return
+	end
+	due[key] = true
+	ui.after(math.max(0, ms - now_ms()) + 250, function()
+		due[key] = nil
+		TICK:set(TICK:peek() + 1)
+	end)
+end
+
+-- What a put-away is keyed by: the expiry it saw.
+function M.expiry_key(s: any): string
+	return tostring(s.cache_expires or "unknown")
+end
+
+-- Whether a session's alert shows (`draft`: the composer's words; `put_away`:
+-- what it was put away for in this chat, if it was). The rules, apart from
+-- where they're read.
+function M.shows(s: any, now: number, draft: string, put_away: string?): boolean
+	if not s or s.state ~= "ready" then
+		return false
+	end
+	-- (Another chat's: a subagent's or a side chat's.)
+	if s.harness ~= "claude-code" or s.child == true or s.running == true then
+		return false
+	end
+	if (s.context_tokens or 0) < M.MIN_TOKENS then
+		return false
+	end
+	if s.cache_expires ~= nil and s.cache_expires > now then
+		return false
+	end
+	-- (A command being typed: `/compact` itself, among others.)
+	if string.sub(draft, 1, 1) == "/" then
+		return false
+	end
+	return put_away ~= M.expiry_key(s)
+end
+
+-- This device's "Compact idle chats" (Settings → General), as last heard:
+-- nil until asked. What a chat's own "Compact when idle" falls back on.
+M.setting = ui.state("idle_compact_setting", nil :: boolean?)
+
+-- Asks the engine for it (once heard, it's kept; Settings sets it as it
+-- changes it).
+function M.load_setting()
+	local ok, p = pcall(ui.call, "settings.engine", { method = "GetIdleCompactSettings", params = {} })
+	if not ok or not p then
+		return
+	end
+	p:after(function(v: any)
+		if type(v) == "table" and v.compactIdleChats ~= nil then
+			M.setting:set(v.compactIdleChats == true)
+		end
+	end, function() end)
+end
+
+-- Whether a chat compacts when idle: its own choice (`compact_idle` on its
+-- row), else the setting (on unless heard otherwise).
+function M.compacts(row: any): boolean
+	if row.compact_idle ~= nil then
+		return row.compact_idle == true
+	end
+	return M.setting:peek() ~= false
+end
+
+-- Its choice flipped: what it now says, kept as the chat's own only where
+-- it differs from the setting (else it follows the setting again).
+function M.toggle(row: any): any
+	local next = not M.compacts(row)
+	local follows = next == (M.setting:peek() ~= false)
+	return sessions.compact_idle(row.id, if follows then nil else next)
+end
+
+export type Bind = {
+	session: () -> any,
+	-- The composer's words (a draft state: ds/draft_text).
+	text: any,
+	-- Compact chat: `/compact` to the chat, as sent from the composer.
+	send: (id: string) -> (),
+}
+
+function M.bind(c: Bind): any
+	local b = {}
+	b.alert = ui.computed(function(): any
+		TICK:get()
+		local s = c.session()
+		if not s then
+			return nil
+		end
+		local now = now_ms()
+		if s.cache_expires ~= nil and s.cache_expires > now then
+			judge_again_at(s.cache_expires)
+		end
+		if not M.shows(s, now, Draft.sub(c.text, 1, 1), DISMISSED:get()[s.id]) then
+			return nil
+		end
+		return {
+			id = M.ID,
+			tone = "info",
+			title = ui.t("chat.composer.idle_compact.title", { n = compaction.short(s.context_tokens) }):get(),
+			action = ui.t("chat.composer.idle_compact.action"):get(),
+			dismissable = true,
+		}
+	end)
+	-- The deck's alerts: this one first, then `others`'.
+	function b.merged(others: State<{ any }>?): State<{ any }>
+		return ui.computed(function(): { any }
+			local mine = b.alert:get()
+			local rest = if others then others:get() else {}
+			if not mine then
+				return rest
+			end
+			local out = { mine }
+			for _, x in rest do
+				table.insert(out, x)
+			end
+			return out
+		end)
+	end
+	-- Its action (Compact chat), else `other`'s.
+	function b.on_alert(other: ((id: string) -> ())?): (id: string) -> ()
+		return function(id: string)
+			if id ~= M.ID then
+				if other then
+					other(id)
+				end
+				return
+			end
+			local s = c.session()
+			if s then
+				c.send(s.id)
+			end
+		end
+	end
+	-- Its ×, else `other`'s.
+	function b.on_dismiss(other: ((id: string) -> ())?): (id: string) -> ()
+		return function(id: string)
+			if id ~= M.ID then
+				if other then
+					other(id)
+				end
+				return
+			end
+			local s = c.session()
+			if s then
+				DISMISSED:set_key(s.id, M.expiry_key(s))
+			end
+		end
+	end
+	return b
+end
+
+return M
