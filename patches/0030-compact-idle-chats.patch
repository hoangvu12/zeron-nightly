+    // while idle), or turned off. Rechecked in full when it fires.
+    let small = doc
+        .context_usage()
+        .and_then(|u| u.tokens)
+        .is_none_or(|t| t < overrides.min_tokens());
+    let choice = inner.workspace().and_then(|ws| ws.chat_compact_idle(chat_id));
+    let on = choice.unwrap_or_else(|| inner.registry.idle_compact_settings().compact_idle_chats);
+    if small || !on {
+        compactions.disarm(chat_id);
+        return;
+    }
+    let generation = compactions.next_generation();
+    let delay = std::time::Duration::from_millis((at - now_ms()).max(0) as u64);
+    let weak = Arc::downgrade(inner);
+    let chat = chat_id.to_owned();
+    // Armed under the lock: a timer due at once finds itself armed.
+    let task = tokio::spawn(async move {
+        tokio::time::sleep(delay).await;
+        if let Some(inner) = weak.upgrade() {
+            SessionsEngine { inner }
+                .compact_idle_chat(&chat, generation)
+                .await;
+        }
+    });
+    tracing::info!(chat = %chat_id, in_secs = delay.as_secs(), "idle compaction armed");
+    compactions.arm(chat_id, generation, at, task.abort_handle());
+}
