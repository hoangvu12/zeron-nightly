diff --git a/apps/zgx/ui/tests/idle_compact.test.luau b/apps/zgx/ui/tests/idle_compact.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..c58fe79b604939e9ef9cf567b61fb96ca3ab373f
--- /dev/null
+++ b/apps/zgx/ui/tests/idle_compact.test.luau
@@ -0,0 +1,187 @@
+-- Compact idle chats, as the window shows it: a compaction's divider in the
+-- transcript (running, then done, its summary opening under it); the
+-- composer's "Next message resends …" alert on a large Claude chat whose
+-- prompt cache expired (Compact chat sends `/compact`; a command being
+-- typed, a clear and × each put it away); Settings' "Compact idle chats";
+-- and a chat's own "Compact when idle" in its menu. On ui/chat_fixture.luau,
+-- ui/shell_fixture.luau and ui/settings_fixture.luau.
+
+local NOTICE = "Next message resends 240k tokens"
+local ITEM = 'role:menu "Session actions" >> role:menuitemcheckbox "Compact when idle"'
+
+local function chat(): any
+	local app = mount("chat_fixture.luau")
+	app:resize(1000, 800)
+	app:frames(30)
+	app:command("go_s2")
+	app:frames(30)
+	return app
+end
+
+-- Whether the alert is there: the deck's pill, opened to read it.
+local function notice(app: any): boolean
+	if not app:has('role:button "Open Alerts"') then
+		return app:has(`"{NOTICE}"`)
+	end
+	app:click('role:button "Open Alerts"')
+	app:frames(30)
+	return app:has(`"{NOTICE}"`)
+end
+
+test("idle compact: a compaction is one divider: running, then done, its summary opening under it", function()
+	local app = chat()
+	app:command("compaction_rows")
+	app:frames(40)
+	local tree = app:tree("#transcript")
+	expect(tree).to_contain("Compacted 240k → 18k tokens")
+	expect(tree).to_contain("Compacting 180k tokens…")
+	-- (No user turn of its own, no reply's lane.)
+	expect(string.find(tree, "/compact", 1, true)).to_be(nil)
+	-- Running, it's only words; done, it opens its summary.
+	expect(app:has('role:button "Compacting 180k tokens…"')).to_be(false)
+	expect(app:has('"We were porting "')).to_be(false)
+	app:click('role:button "Compacted 240k → 18k tokens"')
+	app:frames(30)
+	expect(app:tree("#transcript")).to_contain("the deck")
+	app:click('role:button "Compacted 240k → 18k tokens"')
+	app:frames(30)
+	expect(string.find(app:tree("#transcript"), "the deck", 1, true)).to_be(nil)
+	-- The running one finishes in place.
+	app:command("compaction_done")
+	app:frames(40)
+	tree = app:tree("#transcript")
+	expect(tree).to_contain("Compacted 180k → 12k tokens")
+	expect(string.find(tree, "Compacting", 1, true)).to_be(nil)
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: a large chat whose cache expired says what the next message resends; Compact chat sends /compact", function()
+	local app = chat()
+	expect(notice(app)).to_be(false)
+	app:command("idle_expired")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	app:click('role:button "Compact chat"')
+	app:frames(30)
+	expect(app:state("calls")).to_contain("send:s2:/compact")
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: no alert while the cache is warm", function()
+	local app = chat()
+	app:command("idle_cached")
+	app:frames(30)
+	expect(notice(app)).to_be(false)
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: a command being typed puts it away; the words gone, it's back", function()
+	local app = chat()
+	app:command("idle_expired")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	app:type("role:textbox", "/")
+	app:frames(30)
+	expect(app:has(`"{NOTICE}"`)).to_be(false)
+	app:fill("role:textbox", "")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	-- Ordinary words keep it: Send still just sends.
+	app:type("role:textbox", "carry on")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: a clear empties the context: the alert goes", function()
+	local app = chat()
+	app:command("idle_expired")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	app:command("idle_cleared")
+	app:frames(30)
+	expect(app:has(`"{NOTICE}"`)).to_be(false)
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: × puts it away until the cache expires again", function()
+	local app = chat()
+	app:command("idle_expired")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	app:click(`role:button "Dismiss {NOTICE}"`)
+	app:frames(30)
+	expect(app:has(`"{NOTICE}"`)).to_be(false)
+	-- A turn since (its cache warm), then expired again: back.
+	app:command("idle_cached")
+	app:frames(30)
+	app:command("idle_expired")
+	app:frames(30)
+	expect(notice(app)).to_be(true)
+	expect(app:error()).to_be(nil)
+end)
+
+test("idle compact: a Claude chat's menu has Compact when idle: ticked by the setting, flipped as its own", function()
+	local app = mount("shell_fixture.luau")
+	app:resize(1200, 900)
+	app:frames(30)
+	local row = '#shell-sidebar >> role:button "Tidy the tests"'
+	app:right_click(row)
+	app:frames(20)
+	expect(app:tree(ITEM)).to_contain("checked")
+	expect(app:tree(ITEM)).never.to_contain("unchecked")
+	app:click(ITEM)
+	app:frames(30)
+	expect(app:state("calls")).to_contain("compact_idle:a3:false")
+	-- Turned back on, it follows the setting again.
+	app:right_click(row)
+	app:frames(20)
+	expect(app:tree(ITEM)).to_contain("unchecked")
+	app:click(ITEM)
+	app:frames(30)
+	expect(app:state("calls")).to_contain("compact_idle:a3:setting")
+	-- Another agent's chat has none.
+	app:key("escape")
+	app:frames(60)
+	app:right_click('#shell-sidebar >> role:button "Write the docs"')
+	app:frames(30)
+	-- (The menu shown: an earlier one stays in the tree, hidden.)
+	local shown = app:tree('role:menu "Session actions"')
+	expect(shown).to_contain("Codex conversation link")
+	expect(shown).never.to_contain("Compact when idle")
+	expect(app:error()).to_be(nil)
+end)
+
+local function asked(app: any, entry: string): boolean
+	for _, c in (app:state("settings_stub_calls") :: any) or {} do
+		if c == entry then
+			return true
+		end
+	end
+	return false
+end
+
+test("idle compact: Settings has Compact idle chats, on until turned off; a chat's menu follows it", function()
+	local app = mount("shell_fixture.luau")
+	app:resize(1200, 900)
+	app:frames(30)
+	app:command("settings_stub.sign_in")
+	app:command("shell.settings")
+	app:frames(20)
+	local switch = '#settings-page >> role:switch "Compact idle chats"'
+	expect(asked(app, "settings.engine:GetIdleCompactSettings")).to_be(true)
+	expect(app:tree(switch)).never.to_contain("unchecked")
+	expect(app:tree("#settings-page")).to_contain("Before the prompt cache expires, on chats over 200k tokens.")
