+            &ChatConfig {
+                harness: id,
+                model: model.clone(),
+                reasoning: None,
+                model_options: Default::default(),
+                sandbox: SandboxLevel::DangerFullAccess,
+                access: Default::default(),
+                plan: false,
+            },
+        )
+        .unwrap();
+    core.doc_host
+        .queue_command(
+            CHAT,
+            SessionCommandPayload::Run {
+                message_id: "u0".into(),
+                request: RunRequest {
