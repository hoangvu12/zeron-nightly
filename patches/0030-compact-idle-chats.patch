+/// One compaction is one part. Its start (nothing but `pre`), its end
+/// (`post`) and its summary arrive as separate events: each goes into the
+/// turn's latest compaction part while that one still takes it (running,
+/// for a start or an end; any, for a summary not yet known), else starts a
+/// new part (a second compaction in the same turn).
+fn fold_compaction(
+    out: &mut Vec<MessagePart>,
+    pre: Option<u64>,
+    post: Option<u64>,
+    summary: Option<&str>,
+) {
+    let summary = summary.map(str::trim).filter(|s| !s.is_empty());
+    let latest = out.iter_mut().rev().find_map(|p| match p {
+        MessagePart::Compaction {
+            pre_tokens,
+            post_tokens,
+            summary,
+            ..
+        } => Some((pre_tokens, post_tokens, summary)),
+        _ => None,
+    });
