+-- The open chat a large Claude one, idle: its prompt cache expired a
+-- minute ago (`idle_expired`), or good for an hour yet (`idle_cached`);
+-- its context emptied (`idle_cleared`, a `/clear`).
+local function idle(patch: { [string]: any })
+	local s = store.session:peek()
+	if s and s.id then
+		local all: { [string]: any } = { harness = "claude-code", context_tokens = 240000, context_window = 1000000 }
+		for k, v in patch do
+			all[k] = v
+		end
+		publish(s.id, all)
+	end
+end
+-- (Each time a cache of its own: expired a moment earlier than the last.)
+local expiries = 0
+ui.command {
+	id = "idle_expired",
+	title = "The open chat is large and its prompt cache expired",
+	run = function()
+		expiries += 1
+		idle({ cache_expires = (os.time() - 60 - expiries) * 1000 })
+	end,
+}
+ui.command {
+	id = "idle_cached",
+	title = "The open chat is large and its prompt cache is warm",
+	run = function()
+		idle({ cache_expires = (os.time() + 3600) * 1000 })
+	end,
+}
+ui.command {
+	id = "idle_cleared",
+	title = "The open chat's context was cleared",
+	run = function()
+		idle({ context_tokens = 0, cache_expires = (os.time() - 60) * 1000 })
+	end,
+}
+-- Compactions in the transcript: one done, its summary to open, and one
+-- running (`compaction_rows`), which then finishes (`compaction_done`).
+ui.command {
+	id = "compaction_rows",
+	title = "Two compactions: one done, one running",
+	run = function()
+		local list = table.clone(store.messages:peek())
+		table.insert(list, { id = "c1", role = "compaction", text = "", pre = 240000, post = 18000, summary = "We were porting **the deck**.\n\nNext: its tests." })
+		table.insert(list, { id = "u-after", role = "user", text = "Carry on" })
+		table.insert(list, { id = "c2", role = "compaction", text = "", pre = 180000, live = true })
+		store.messages:set(list)
+	end,
+}
+ui.command {
+	id = "compaction_done",
+	title = "The running compaction finishes",
+	run = function()
+		local list = table.clone(store.messages:peek())
+		for i, m in list do
+			if m.id == "c2" then
+				list[i] = { id = "c2", role = "compaction", text = "", pre = 180000, post = 12000, summary = "Carried on." }
+			end
+		end
+		store.messages:set(list)
+	end,
+}
