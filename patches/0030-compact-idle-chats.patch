 /// The blocks of these parts of a reply (`streaming`: still being written).
+/// A bare `/compact` (as the agent gets it: a command picked from the list
+/// arrives as its name), no instructions after it.
+fn is_compact_command(text: &str) -> bool {
+    zeron_proto::invocation::invocation_prompt(text).trim() == "/compact"
+}
+
+/// A compaction part as the transcript's divider reads it: its context
+/// before and after (`post` absent while it runs), its summary, and whether
+/// it runs (`live`) or was cut off (`stopped`: the turn ended without it).
+/// `tag` is the field naming it (`role` for a row, `kind` for a block).
+fn compaction_value(part: &Json, id: &str, tag: &str, streaming: bool) -> Value {
+    let num = |key: &str| part[key].as_f64().map_or(Value::Nil, Value::Num);
+    let done = part["postTokens"].as_f64().is_some();
+    Value::record([
+        ("id", Value::from(id)),
+        (tag, Value::from("compaction")),
+        ("text", Value::from("")),
+        ("pre", num("preTokens")),
+        ("post", num("postTokens")),
+        ("summary", part["summary"].as_str().map_or(Value::Nil, Value::from)),
+        ("live", Value::Bool(!done && streaming)),
+        ("stopped", Value::Bool(!done && !streaming)),
+    ])
+}
+
+/// A reply that is one compaction and nothing else (`/compact`, or Zeron's
+/// own for an idle chat): one divider across the transcript, not a reply.
+/// Empty thoughts and heartbeats don't count; anything said does.
+fn compaction_row(entry: &Json, id: &str, streaming: bool) -> Option<Value> {
+    let parts = entry["parts"].as_array()?;
+    let mut compaction = None;
+    for part in parts {
+        match part["kind"].as_str() {
+            Some("compaction") if compaction.is_none() => compaction = Some(part),
+            Some("reasoning") if part["text"].as_str().unwrap_or_default().trim().is_empty() => {}
+            _ => return None,
+        }
+    }
+    // (The row is the entry's: its id, not the part's.)
+    Some(compaction_value(compaction?, id, "role", streaming))
+}
