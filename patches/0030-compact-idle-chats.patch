new file mode 100644
index 0000000000000000000000000000000000000000..3ddcaf1eda486e7a52c233d1963acf4a0d4fae42
--- /dev/null
+++ b/crates/engine/src/idle_compact.rs
@@ -0,0 +1,509 @@
+//! Compact idle chats: a large idle Claude chat is compacted shortly before
+//! its prompt cache expires, while its history is still cached.
+//!
+//! A Claude subscription's prompt cache lives an hour from the start of the
+//! request that last wrote or read it. A chat left past that resends its
+//! whole context uncached with the next message (measured on the PC: after
+//! an hour away, 96 of 98 requests missed the cache and rewrote ~190k
+//! tokens each, at twice the input price). Compacting while the cache is
+//! warm costs a cached read of the history and leaves a small context for
+//! that next message.
+//!
+//! Claude Code has this itself (`idleCompaction`), but its timer never runs
+//! under Zeron: it arms only for interactive sessions or a list of
+//! entrypoints, and the engine stops an idle agent after two minutes
+//! ([`super::AGENT_IDLE_STOP`]). So the engine does it:
+//!
+//! - Each request's start and its usage's cache lifetime are noted per chat
+//!   ([`CacheClock`]). A request that only read the cache carries the
+//!   lifetime before it on.
+//! - When a turn ends, the expiry is written to the chat's context usage
+//!   (`cacheExpiresAt`, the app's "Next message resends …" notice) and, for
+//!   an hour's cache, a timer is armed [`LEAD`] before it ([`fire_at`]).
+//! - When it fires, the chat must still be idle and eligible
+//!   ([`eligible`]); then `/compact` goes to the agent as a run of its own
+//!   that resumes the session, with no user message in the transcript (its
+//!   divider is the agent's own compaction, as for a `/compact` sent by
+//!   hand). Messages sent meanwhile wait in the queue for its end.
+//! - A compaction's own end never arms another: a chat compacts at most once
+//!   per idle spell. Timers live in memory: a restart drops them, and the
+//!   app's notice covers what they missed.
+
+use std::collections::HashMap;
+use std::time::Duration;
+
+/// The context a chat must hold for it to be worth compacting.
+pub const MIN_TOKENS: u64 = 200_000;
+
+/// How long before the cache expires the compaction starts: its own request
+/// must read the history while it is still cached.
+pub const LEAD: Duration = Duration::from_secs(2 * 60);
+
+/// The cache lifetime worth compacting for. A 5-minute cache expires before
+/// anyone is away long enough for it to matter.
+pub const HOUR_TTL_SECS: u64 = 60 * 60;
+
+/// The prompt that compacts (Claude Code's own command).
+pub const COMPACT_PROMPT: &str = "/compact";
+
+/// Test and measurement knobs, read once per use:
+/// `ZERON_IDLE_COMPACT_AFTER_MS` fires that long after the last request's
+/// start, whatever the cache's lifetime (a live run needn't wait an hour);
+/// `ZERON_IDLE_COMPACT_MIN_TOKENS` lowers [`MIN_TOKENS`].
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Overrides {
+    pub after: Option<Duration>,
+    pub min_tokens: Option<u64>,
+}
+
+impl Overrides {
+    pub fn from_env() -> Self {
+        let num = |name: &str| {
+            std::env::var(name)
+                .ok()
+                .and_then(|v| v.trim().parse::<u64>().ok())
+        };
+        Self {
+            after: num("ZERON_IDLE_COMPACT_AFTER_MS").map(Duration::from_millis),
+            min_tokens: num("ZERON_IDLE_COMPACT_MIN_TOKENS"),
+        }
+    }
+
+    pub fn min_tokens(self) -> u64 {
+        self.min_tokens.unwrap_or(MIN_TOKENS)
+    }
+}
+
+/// One chat's prompt cache as its requests left it.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct CacheClock {
+    /// When the request under way (or the last one) started, Unix ms.
+    request_started: Option<i64>,
+    /// The lifetime of the last cache write, carried over reads.
+    ttl_secs: Option<u64>,
+    /// When the cache the last measured request left expires, Unix ms.
+    expires_at: Option<i64>,
+}
+
+impl CacheClock {
+    /// A request leaves (a turn's prompt, a tool's result going back, a
+    /// compaction): its cache lifetime counts from here.
+    pub fn request_started(&mut self, at_ms: i64) {
+        self.request_started = Some(at_ms);
+    }
+
+    /// Its usage came: `ttl` is the lifetime it wrote, `None` for a pure
+    /// read (the cache lives on as long as it did, from this request).
+    pub fn usage(&mut self, ttl_secs: Option<u64>) {
+        if ttl_secs.is_some() {
+            self.ttl_secs = ttl_secs;
+        }
+        if let (Some(start), Some(ttl)) = (self.request_started, self.ttl_secs) {
+            self.expires_at = Some(start + (ttl as i64) * 1000);
+        }
+    }
+
+    pub fn expires_at(&self) -> Option<i64> {
+        self.expires_at
+    }
+
+    pub fn ttl_secs(&self) -> Option<u64> {
+        self.ttl_secs
+    }
+
+    pub fn request_started_at(&self) -> Option<i64> {
+        self.request_started
+    }
+}
+
+/// When to compact, Unix ms: [`LEAD`] before an hour's cache expires (or
+/// `after` the request's start, when overridden). `None`: not worth it (a
+/// shorter cache, or none known).
+pub fn fire_at(clock: &CacheClock, overrides: Overrides) -> Option<i64> {
+    if let Some(after) = overrides.after {
+        return Some(clock.request_started_at()? + after.as_millis() as i64);
+    }
+    if clock.ttl_secs()? < HOUR_TTL_SECS {
+        return None;
+    }
+    Some(clock.expires_at()? - LEAD.as_millis() as i64)
+}
+
+/// What decides whether a chat compacts now, read when its timer fires.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Facts {
+    /// This device's "Compact idle chats".
+    pub setting_on: bool,
+    /// The chat's own "Compact when idle", when set.
+    pub chat_choice: Option<bool>,
+    pub claude: bool,
+    pub tokens: Option<u64>,
+    pub min_tokens: u64,
+    /// A subagent's or another chat's child (it has a parent).
+    pub child: bool,
+    pub archived: bool,
+    /// A question waits on the person.
+    pub awaiting_input: bool,
+    /// The agent runs background work.
+    pub background: bool,
+    /// A message waits in the queue (or on its way through the commands).
+    pub queued: bool,
+    pub turn_running: bool,
+    /// Its cache expired already (the machine slept through the timer):
+    /// compacting would pay the whole context uncached all the same.
+    pub cache_expired: bool,
+}
+
+/// Why a chat doesn't compact now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Skip {
+    Off,
+    NotClaude,
+    Small,
+    Child,
+    Archived,
+    Question,
+    Background,
+    Queued,
+    Running,
+    Expired,
+}
+
+pub fn eligible(facts: &Facts) -> Result<(), Skip> {
+    if !facts.chat_choice.unwrap_or(facts.setting_on) {
+        return Err(Skip::Off);
+    }
+    if !facts.claude {
+        return Err(Skip::NotClaude);
+    }
+    if facts.child {
+        return Err(Skip::Child);
+    }
+    if facts.archived {
+        return Err(Skip::Archived);
+    }
+    if facts.tokens.is_none_or(|t| t < facts.min_tokens) {
+        return Err(Skip::Small);
+    }
+    if facts.turn_running {
+        return Err(Skip::Running);
+    }
+    if facts.awaiting_input {
+        return Err(Skip::Question);
+    }
+    if facts.background {
+        return Err(Skip::Background);
+    }
+    if facts.queued {
+        return Err(Skip::Queued);
+    }
+    if facts.cache_expired {
+        return Err(Skip::Expired);
+    }
+    Ok(())
+}
+
+/// The chats' cache clocks and armed timers.
+#[derive(Default)]
+pub struct IdleCompactions {
+    clocks: HashMap<String, CacheClock>,
+    /// Armed timers: chat → (generation, when it fires (Unix ms), task).
+    armed: HashMap<String, Armed>,
+    generation: u64,
+}
+
+struct Armed {
+    generation: u64,
+    at_ms: i64,
+    task: tokio::task::AbortHandle,
+}
+
+impl IdleCompactions {
+    pub fn clock(&mut self, chat_id: &str) -> &mut CacheClock {
+        self.clocks.entry(chat_id.to_owned()).or_default()
+    }
+
+    pub fn peek(&self, chat_id: &str) -> Option<CacheClock> {
+        self.clocks.get(chat_id).copied()
+    }
+
+    /// The next generation for a timer about to be armed.
+    pub fn next_generation(&mut self) -> u64 {
+        self.generation += 1;
+        self.generation
+    }
+
+    /// Arm (replacing any timer the chat had).
+    pub fn arm(
+        &mut self,
+        chat_id: &str,
+        generation: u64,
+        at_ms: i64,
+        task: tokio::task::AbortHandle,
+    ) {
+        if let Some(old) = self.armed.insert(
+            chat_id.to_owned(),
+            Armed {
+                generation,
+                at_ms,
+                task,
+            },
+        ) {
+            old.task.abort();
+        }
+    }
+
+    /// When the chat's armed timer fires, if one is.
+    pub fn armed_at(&self, chat_id: &str) -> Option<i64> {
+        self.armed.get(chat_id).map(|a| a.at_ms)
+    }
+
+    /// The timer of `generation` fired: it is spent. `false` when another
+    /// replaced it meanwhile.
+    pub fn take_fired(&mut self, chat_id: &str, generation: u64) -> bool {
+        match self.armed.get(chat_id) {
+            Some(armed) if armed.generation == generation => {
+                self.armed.remove(chat_id);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub fn disarm(&mut self, chat_id: &str) {
+        if let Some(armed) = self.armed.remove(chat_id) {
+            armed.task.abort();
+        }
+    }
+
+    pub fn disarm_all(&mut self) {
+        for (_, armed) in self.armed.drain() {
+            armed.task.abort();
+        }
+    }
+
+    /// A chat that's gone (deleted): its clock goes too.
+    pub fn forget(&mut self, chat_id: &str) {
+        self.disarm(chat_id);
+        self.clocks.remove(chat_id);
+    }
+}
