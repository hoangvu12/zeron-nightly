+            return;
+        }
+    }
+    let id = format!("c{}", out.len());
+    out.push(MessagePart::Compaction {
+        id,
+        pre_tokens: pre,
+        post_tokens: post,
+        summary: summary.map(str::to_owned),
+    });
+}
