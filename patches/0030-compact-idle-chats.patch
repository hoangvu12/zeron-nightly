+        let empty_thought = json!({ "kind": "reasoning", "id": "r", "text": "" });
+        let reply = |parts: Vec<Json>, status: &str| json!({ "id": "a", "role": "assistant", "status": status, "parts": parts });
+
+        // Running: the reply is the divider, its words to come.
+        let running = super::message(&reply(vec![empty_thought.clone(), part(None, None)], "streaming"), None).unwrap();
+        assert_eq!(s(running.field("role")).as_deref(), Some("compaction"));
+        assert_eq!(s(running.field("id")).as_deref(), Some("a"));
+        assert_eq!(n(running.field("pre")), Some(240000.));
+        assert!(running.field("post").is_none() || matches!(running.field("post"), Some(Value::Nil)));
+        assert!(b(running.field("live")) && !b(running.field("stopped")));
+
+        // Done: before and after, and the summary to open.
+        let done = super::message(&reply(vec![part(Some(18000), Some("S"))], "done"), None).unwrap();
+        assert_eq!(s(done.field("role")).as_deref(), Some("compaction"));
+        assert_eq!(n(done.field("post")), Some(18000.));
+        assert_eq!(s(done.field("summary")).as_deref(), Some("S"));
+        assert!(!b(done.field("live")) && !b(done.field("stopped")));
+
+        // Its turn ended without it: stopped.
+        let cut = super::message(&reply(vec![part(None, None)], "done"), None).unwrap();
+        assert!(b(cut.field("stopped")));
+
+        // Said alongside: a reply, the compaction one of its blocks.
+        let said = json!({ "kind": "text", "id": "t", "text": "Done." });
+        let mixed = super::message(&reply(vec![part(Some(18000), None), said], "done"), None).unwrap();
+        assert_eq!(s(mixed.field("role")).as_deref(), Some("assistant"));
