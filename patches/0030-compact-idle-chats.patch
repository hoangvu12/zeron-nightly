+//! Opt-in real-model check of compacting an idle chat: a Claude Code turn
+//! ends, the engine arms its compaction (here 15 s after the turn's last
+//! request rather than 2 min before an hour's cache expires, and for any
+//! chat over 1k tokens), and `/compact` runs on its own: one compaction part
+//! with its before, after and summary, no user message, nothing armed after.
+//!
+//! ZERON_TEST_MODEL=haiku cargo test -p zeron-engine --test idle_compact_live -- --ignored --nocapture
+use std::{sync::Arc, time::Duration};
+use zeron_doc::{MessagePart, MessageRole, SessionCommandPayload, SessionMessageEntry};
+use zeron_engine::{EngineCore, HarnessRegistry};
+use zeron_harness::{ClaudeHarness, Harness};
+use zeron_proto::{ChatConfig, RunRequest, SandboxLevel, SessionStatus};
+
+const CHAT: &str = "idle";
+
+fn entries(core: &EngineCore) -> Vec<SessionMessageEntry> {
+    core.doc_host
+        .open(CHAT)
+        .unwrap()
+        .doc()
+        .read_entries()
+        .unwrap()
+}
+
+fn compactions(entries: &[SessionMessageEntry]) -> Vec<MessagePart> {
+    entries
+        .iter()
+        .flat_map(|e| e.parts.iter())
+        .filter(|p| matches!(p, MessagePart::Compaction { .. }))
+        .cloned()
+        .collect()
+}
+
+async fn wait(core: &EngineCore, secs: u64, what: &str, mut done: impl FnMut() -> bool) {
+    let ok = tokio::time::timeout(Duration::from_secs(secs), async {
+        while !done() {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await
+    .is_ok();
+    if !ok {
+        let all = entries(core);
+        core.shutdown().await;
+        panic!("timeout waiting for {what}: {all:#?}");
+    }
+}
