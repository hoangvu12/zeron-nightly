+impl SessionsEngine {
+    /// The chat's armed compaction (if any) won't run: its own toggle was
+    /// turned off.
+    pub fn disarm_idle_compaction(&self, chat_id: &str) {
+        lock(&self.inner.idle_compactions).disarm(chat_id);
+    }
+
+    /// No armed compaction runs: the device's setting was turned off.
+    pub fn disarm_all_idle_compactions(&self) {
+        lock(&self.inner.idle_compactions).disarm_all();
+    }
+
+    /// When `chat_id`'s compaction is armed to run (Unix ms), if it is.
+    pub fn idle_compaction_armed_at(&self, chat_id: &str) -> Option<i64> {
+        lock(&self.inner.idle_compactions).armed_at(chat_id)
+    }
+
+    /// What decides whether `chat_id` compacts now; `None` when it isn't
+    /// this device's to run (or isn't known here).
+    fn idle_compact_facts(&self, chat_id: &str) -> Option<idle_compact::Facts> {
+        let ws = self.inner.workspace()?;
+        let chat = ws.chat(chat_id).ok()??;
+        if chat.device_id != self.inner.device_id {
+            return None;
+        }
+        let handle = self.doc_handle(chat_id).ok()?;
+        let doc = handle.doc();
+        let usage = doc.context_usage().unwrap_or_default();
+        let queued = !doc.read_queue().unwrap_or_default().is_empty()
+            || doc.read_commands().unwrap_or_default().iter().any(|c| {
+                c.status == zeron_doc::SessionCommandStatus::Pending
+                    && matches!(
+                        c.payload,
+                        zeron_doc::SessionCommandPayload::Run { .. }
+                            | zeron_doc::SessionCommandPayload::Steer { .. }
+                    )
+            });
+        Some(idle_compact::Facts {
+            setting_on: self.inner.registry.idle_compact_settings().compact_idle_chats,
+            chat_choice: ws.chat_compact_idle(chat_id),
+            claude: chat
+                .config
+                .as_ref()
+                .is_some_and(|c| c.harness == HarnessId::ClaudeCode),
+            tokens: usage.tokens,
+            min_tokens: idle_compact::Overrides::from_env().min_tokens(),
+            child: chat.parent_chat_id.is_some(),
+            archived: chat.archived,
+            awaiting_input: self.inner.awaiting_input(chat_id),
+            background: self.holds_background_work(chat_id),
+            queued,
+            turn_running: self.turn_in_flight(chat_id),
+            cache_expired: usage.cache_expires_at.is_none_or(|at| at <= now_ms()),
+        })
+    }
+
+    /// The chat's timer fired: if it is still idle and eligible, `/compact`
+    /// goes to its agent as a run of the engine's own (resuming the
+    /// session), with no user message in the transcript.
+    async fn compact_idle_chat(&self, chat_id: &str, generation: u64) {
+        if !lock(&self.inner.idle_compactions).take_fired(chat_id, generation) {
+            return;
+        }
+        let Some(facts) = self.idle_compact_facts(chat_id) else {
+            return;
+        };
+        if let Err(skip) = idle_compact::eligible(&facts) {
+            tracing::info!(chat = %chat_id, ?skip, "idle compaction skipped");
+            return;
+        }
+        let Some(host) = self.inner.doc_host() else {
+            return;
+        };
+        let Some(mut request) = self
+            .last_request(chat_id)
+            .or_else(|| host.request_from_chat_row(chat_id, idle_compact::COMPACT_PROMPT))
+        else {
+            tracing::info!(chat = %chat_id, "idle compaction skipped: no run config");
+            return;
+        };
+        request.prompt = idle_compact::COMPACT_PROMPT.to_owned();
+        request.resume = None;
+        request.attachments = Vec::new();
+        let harness = host.harness_for_request(chat_id, &request);
+        if harness != HarnessId::ClaudeCode {
+            return;
+        }
+        let id = new_id();
+        {
+            let mut quiet = lock(&self.inner.quiet_runs);
+            if quiet.len() >= 64 {
+                quiet.clear();
+            }
+            quiet.insert(id.clone());
+        }
+        tracing::info!(chat = %chat_id, tokens = ?facts.tokens, "compacting an idle chat before its prompt cache expires");
+        if let Err(err) = self.dispatch(chat_id, harness, request, Some(id)).await {
+            tracing::warn!(chat = %chat_id, error = %err, "idle compaction failed to start");
+        }
+    }
+}
