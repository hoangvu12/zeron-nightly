+/// A compaction summary as the CLI wrote it, without its lead-in and the
+/// reminders it carries for the model: what the divider shows when opened.
+fn compaction_summary(text: &str) -> String {
+    let mut text = text.to_owned();
+    // `<system-reminder>…</system-reminder>` blocks are for the model.
+    while let Some(start) = text.find("<system-reminder>") {
+        let Some(end) = text[start..].find("</system-reminder>") else {
+            text.truncate(start);
+            break;
+        };
+        text.replace_range(start..start + end + "</system-reminder>".len(), "");
+    }
+    let body = match text.find("Summary:") {
+        Some(at) => &text[at + "Summary:".len()..],
+        None => text
+            .strip_prefix(COMPACT_SUMMARY_LEAD)
+            .and_then(|rest| rest.split_once('\n').map(|(_, body)| body))
+            .unwrap_or(&text),
+    };
+    // What the CLI tells the model after it (where the full transcript is,
+    // and to go on without asking) is for the model too.
+    let body = COMPACT_SUMMARY_TAILS
+        .iter()
+        .filter_map(|tail| body.find(tail))
+        .min()
+        .map_or(body, |at| &body[..at]);
+    body.trim().to_owned()
+}
+
+/// Where the CLI's own words to the model start, after a summary.
+const COMPACT_SUMMARY_TAILS: [&str; 2] = [
+    "If you need specific details from before compaction",
+    "Continue the conversation from where it left off",
+];
+
+/// How long the prompt cache a request wrote lives, from its usage: an hour
+/// for any 1-hour write, five minutes for a 5-minute one only. `None` for a
+/// request that only read the cache (the lifetime before it carries on).
+fn cache_ttl_secs(usage: &Value) -> Option<u64> {
+    let creation = usage.get("cache_creation")?;
+    let tokens = |key: &str| creation.get(key).and_then(Value::as_u64).unwrap_or(0);
+    if tokens("ephemeral_1h_input_tokens") > 0 {
+        Some(60 * 60)
+    } else if tokens("ephemeral_5m_input_tokens") > 0 {
+        Some(5 * 60)
+    } else {
+        None
+    }
 }
 
