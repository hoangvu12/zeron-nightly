+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MIN: i64 = 60 * 1000;
+
+    fn eligible_facts() -> Facts {
+        Facts {
+            setting_on: true,
+            chat_choice: None,
+            claude: true,
+            tokens: Some(240_000),
+            min_tokens: MIN_TOKENS,
+            ..Facts::default()
+        }
+    }
+
+    #[test]
+    fn the_cache_expires_an_hour_after_the_request_started_not_after_its_reply() {
+        let mut clock = CacheClock::default();
+        clock.request_started(1_000_000);
+        // The reply streamed for five minutes; its usage came at the end.
+        clock.usage(Some(HOUR_TTL_SECS));
+        assert_eq!(clock.expires_at(), Some(1_000_000 + 60 * MIN));
+        // Fired two minutes before.
+        assert_eq!(
+            fire_at(&clock, Overrides::default()),
+            Some(1_000_000 + 58 * MIN)
+        );
+    }
+
+    #[test]
+    fn a_cache_read_carries_the_lifetime_before_it_and_refreshes_it() {
+        let mut clock = CacheClock::default();
+        clock.request_started(0);
+        clock.usage(Some(HOUR_TTL_SECS));
+        // A later request only read the cache: an hour from ITS start.
+        clock.request_started(30 * MIN);
+        clock.usage(None);
+        assert_eq!(clock.ttl_secs(), Some(HOUR_TTL_SECS));
+        assert_eq!(clock.expires_at(), Some(90 * MIN));
+        assert_eq!(fire_at(&clock, Overrides::default()), Some(88 * MIN));
+    }
+
+    #[test]
+    fn a_five_minute_cache_or_none_known_arms_nothing() {
+        let mut clock = CacheClock::default();
+        clock.request_started(0);
+        clock.usage(Some(5 * 60));
+        assert_eq!(clock.expires_at(), Some(5 * MIN));
+        assert_eq!(fire_at(&clock, Overrides::default()), None);
+        // A read with no lifetime ever written: unknown.
+        let mut unknown = CacheClock::default();
+        unknown.request_started(0);
+        unknown.usage(None);
+        assert_eq!(unknown.expires_at(), None);
+        assert_eq!(fire_at(&unknown, Overrides::default()), None);
+        // A 5-minute write after an hour's: the 5-minute one stands now.
+        let mut clock = CacheClock::default();
+        clock.request_started(0);
+        clock.usage(Some(HOUR_TTL_SECS));
+        clock.request_started(MIN);
+        clock.usage(Some(5 * 60));
+        assert_eq!(fire_at(&clock, Overrides::default()), None);
+    }
+
+    #[test]
+    fn the_override_fires_after_the_request_whatever_the_cache() {
+        let mut clock = CacheClock::default();
+        clock.request_started(10_000);
+        clock.usage(Some(5 * 60));
+        let overrides = Overrides {
+            after: Some(Duration::from_secs(20)),
+            min_tokens: Some(1_000),
+        };
+        assert_eq!(fire_at(&clock, overrides), Some(30_000));
+        assert_eq!(overrides.min_tokens(), 1_000);
+        assert_eq!(Overrides::default().min_tokens(), MIN_TOKENS);
+    }
+
+    #[test]
+    fn eligibility_needs_every_rule() {
+        assert_eq!(eligible(&eligible_facts()), Ok(()));
+        let cases: Vec<(Facts, Skip)> = vec![
+            (
+                Facts {
+                    setting_on: false,
+                    ..eligible_facts()
+                },
+                Skip::Off,
+            ),
+            (
+                Facts {
+                    chat_choice: Some(false),
+                    ..eligible_facts()
+                },
+                Skip::Off,
+            ),
+            (
+                Facts {
+                    claude: false,
+                    ..eligible_facts()
+                },
+                Skip::NotClaude,
+            ),
+            (
+                Facts {
+                    tokens: Some(199_999),
+                    ..eligible_facts()
+                },
+                Skip::Small,
+            ),
+            (
+                Facts {
+                    tokens: None,
+                    ..eligible_facts()
+                },
+                Skip::Small,
+            ),
+            (
+                Facts {
+                    child: true,
+                    ..eligible_facts()
+                },
+                Skip::Child,
+            ),
+            (
+                Facts {
+                    archived: true,
+                    ..eligible_facts()
+                },
+                Skip::Archived,
+            ),
+            (
+                Facts {
+                    awaiting_input: true,
+                    ..eligible_facts()
+                },
+                Skip::Question,
+            ),
+            (
+                Facts {
+                    background: true,
+                    ..eligible_facts()
+                },
+                Skip::Background,
+            ),
+            (
+                Facts {
+                    queued: true,
+                    ..eligible_facts()
+                },
+                Skip::Queued,
+            ),
+            (
+                Facts {
+                    turn_running: true,
+                    ..eligible_facts()
+                },
+                Skip::Running,
+            ),
+            (
+                Facts {
+                    cache_expired: true,
+                    ..eligible_facts()
+                },
+                Skip::Expired,
+            ),
+        ];
+        for (facts, skip) in cases {
+            assert_eq!(eligible(&facts), Err(skip), "{facts:?}");
+        }
+        // Exactly the threshold counts.
+        assert_eq!(
+            eligible(&Facts {
+                tokens: Some(MIN_TOKENS),
+                ..eligible_facts()
+            }),
+            Ok(())
+        );
+    }
+
+    #[test]
+    fn the_chats_own_choice_overrides_the_setting() {
+        let on_here = Facts {
+            setting_on: false,
+            chat_choice: Some(true),
+            ..eligible_facts()
+        };
+        assert_eq!(eligible(&on_here), Ok(()));
+        let off_here = Facts {
+            setting_on: true,
+            chat_choice: Some(false),
+            ..eligible_facts()
+        };
+        assert_eq!(eligible(&off_here), Err(Skip::Off));
+    }
+
+    #[tokio::test]
+    async fn a_timer_fires_once_and_a_newer_one_replaces_it() {
+        let mut timers = IdleCompactions::default();
+        let task = || tokio::spawn(std::future::pending::<()>()).abort_handle();
+        let first = timers.next_generation();
+        let first_task = task();
+        timers.arm("c", first, 100, first_task.clone());
+        assert_eq!(timers.armed_at("c"), Some(100));
+        let second = timers.next_generation();
+        timers.arm("c", second, 200, task());
+        // The replaced one was stopped, and its firing counts for nothing.
+        tokio::task::yield_now().await;
+        assert!(first_task.is_finished());
+        assert!(!timers.take_fired("c", first));
+        // The armed one fires once.
+        assert!(timers.take_fired("c", second));
+        assert!(!timers.take_fired("c", second));
+        assert_eq!(timers.armed_at("c"), None);
+    }
+}
