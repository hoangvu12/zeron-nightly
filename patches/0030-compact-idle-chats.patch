+            // estimate the start was given.)
+            if pre.is_some() && (pre_slot.is_none() || post.is_some()) {
+                *pre_slot = pre;
+            }
+            if post.is_some() {
+                *post_slot = post;
+            }
+            if let Some(summary) = summary {
+                *summary_slot = Some(summary.to_owned());
