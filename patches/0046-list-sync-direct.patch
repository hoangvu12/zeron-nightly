+//! Other devices' list writes that reached this one straight from them, over
+//! a direct link, ahead of the RegistryRoom (docs/registry-sync.md, "Peer
+//! overlay").
+//!
+//! A device that writes its list pushes the ops to the room, as always, and
+//! also sends them to its online peers. A peer keeps what it's sent here, in
+//! memory alone, and every read of a row replays them over the room's row
+//! (before its own pending writes to that row, and again after them when it
+//! has some, for an update to a row only its own queue has made) with the
+//! same per-field newest-wins merge ([`apply_op`]). They're never pushed
+//! (their writer pushes them), never saved, and never move the sync cursor:
+//! only the room's rows do that.
+//!
+//! An op stays only while it still changes the row as the room has it: once
+//! the room's row carries the same clock or a newer one, it's dropped
+//! (`settle`). Dropping an op that changes nothing at its place in the replay
+//! leaves the replay's result as it was, so this never changes what's shown;
+//! once the room has every op, nothing is left here. An op the room never
+//! confirms (its writer never pushed it) is dropped after a while by
+//! [`RegistryDoc::expire_peer_ops`].
+//!
+//! Only a device's own writes are taken from it: every clock an op carries
+//! names its writer, so one device can't pass off another's writes. Nor may
+//! a peer say, here alone, which device hosts a chat or a Space (`deviceId`),
+//! but for a row the room hasn't got that it says it hosts itself, while
+//! nothing else here names another host for it. Once the room has the row,
+//! no peer op on it says its host. What each peer last named as the host of
+//! a row the room hasn't got is kept beside the ops, as what disputes a claim.
+//!
+//! Known gap: a host whose list hasn't caught up with a chat being moved to
+//! it (the move reached it from a peer alone) refuses that chat's sends
+//! until the room's row says so. Taking them on the mover's word would let
+//! the old host, which still has the room's row, run them too.
+//!
+//! This device's own update to a row it knows only through a peer is held
+//! back from the room until the room has the row ([`HeldRow`]), for at most
+//! [`HOLD_LIMIT_MS`] of the room being reachable. The hold is saved with the
+//! pending queue, so a restart doesn't end it.
+
+use super::*;
+
+/// A row, by kind and id.
+type RowKey = (String, String);
+
+/// What this device keeps of its peers' writes, and of its own for them.
+#[derive(Default)]
+pub(super) struct PeerOverlay {
+    /// Per row, its peers' ops in the order they arrived.
+    rows: BTreeMap<RowKey, Vec<PeerOp>>,
+    /// This device's own writes since the last [`RegistryDoc::take_peer_outbox`];
+    /// `None` while nothing takes them.
+    outbox: Option<Vec<RowOp>>,
+    /// The outbox overflowed since the last take: some writes were lost.
+    outbox_missed: bool,
+    /// How many peer ops have arrived so far ([`PeerOp::arrival`]).
+    arrivals: u64,
+    /// Rows this device updated while it knew them only through a peer.
+    held: BTreeMap<RowKey, Hold>,
+    /// Per chat or Space the room hasn't got, the host each peer last named
+    /// for it.
+    named: BTreeMap<RowKey, BTreeMap<String, NamedHost>>,
+}
+
+/// The host a peer named for a chat or a Space.
+struct NamedHost {
+    host: Value,
+    /// The clock it named it at.
+    clock: String,
+    /// Epoch ms, when it arrived.
+    received_ms: i64,
+    /// Its place in the order namings arrived, oldest lowest (the oldest go
+    /// first past a cap).
+    arrival: u64,
+}
+
+struct PeerOp {
+    op: RowOp,
+    /// Epoch ms, when the latest write folded into it arrived.
+    received_ms: i64,
+    /// Its place in the order peer ops arrived, oldest lowest (the oldest go
+    /// first past a cap).
+    arrival: u64,
+}
+
+/// One row's hold on this device's updates to it.
+#[derive(Debug, Clone, Copy, Default)]
+struct Hold {
+    /// Epoch ms, when a push first found it holding (the room reachable):
+    /// the limit counts from there.
+    since_ms: Option<i64>,
+    /// Held as long as it may be: its updates go.
+    released: bool,
+}
+
+/// A held row as saved with the pending queue.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct HeldRow {
+    kind: String,
+    id: String,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    released: bool,
+}
+
+/// Peer ops kept from one device at most; past it, its oldest go.
+pub(super) const PEER_OPS_PER_SENDER: usize = 2_000;
+/// Peer ops kept from one device for one row at most (deletes never fold);
+/// past it, its oldest there go.
+pub(super) const PEER_OPS_PER_ROW: usize = 8;
+/// Peer ops kept in all at most; past it, the oldest go.
+pub(super) const PEER_OPS_TOTAL: usize = 8_000;
+/// How long this device's update to a row known only through a peer waits
+/// for the room to have the row, counted from the first push that held it:
+/// a peer's create reaches the room within seconds of the room being back,
+/// and neither a row no room ever gets nor a peer that keeps one alive here
+/// can hold this device's writes past it.
+pub(super) const HOLD_LIMIT_MS: i64 = 2 * 60_000;
+/// How far ahead of this device's clock a peer's may run: an op clocked
+/// further ahead would outrank every real edit to its fields until it
+/// expired.
+const CLOCK_AHEAD_MS: i64 = 5 * 60_000;
+/// The field that says which device hosts a chat or a Space.
+const HOST_FIELD: &str = "deviceId";
+
+/// The outbox holds at most this many ops; past it, it starts again empty
+/// and the next take says writes were missed (their sender then sends the
+/// whole pending queue).
+const OUTBOX_CAP: usize = 5_000;
+
+/// What [`RegistryDoc::take_peer_outbox`] hands over.
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct PeerOutbox {
+    /// This device's own writes since the last take, in the order made.
+    pub ops: Vec<RowOp>,
+    /// Some writes were dropped from the outbox (it overflowed): send the
+    /// whole pending queue instead.
+    pub missed: bool,
+}
+
+/// The device an HLC names (`{ms:013}-{counter:06}-{device}`), when it's
+/// one.
+fn hlc_device(hlc: &str) -> Option<&str> {
+    let bytes = hlc.as_bytes();
+    let digits = |range: std::ops::Range<usize>| {
+        bytes
+            .get(range)
+            .is_some_and(|b| b.iter().all(u8::is_ascii_digit))
+    };
+    (bytes.len() > 21 && digits(0..13) && bytes[13] == b'-' && digits(14..20) && bytes[20] == b'-')
+        .then(|| &hlc[21..])
+}
+
+/// Every clock `op` carries names `device`.
+pub(super) fn written_by(op: &RowOp, device: &str) -> bool {
+    hlc_device(&op.hlc) == Some(device)
+        && op
+            .clocks
+            .iter()
+            .flatten()
+            .all(|(_, clock)| hlc_device(clock) == Some(device))
+}
+
+/// A clock the room takes (`HLC_RE`: 13 digits, 6 digits, then a device of
+/// 1-128 `[A-Za-z0-9_-]`).
+fn valid_hlc(hlc: &str) -> bool {
+    hlc_device(hlc).is_some_and(|device| {
+        device.len() <= 128
+            && device
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+    })
+}
+
+/// The epoch ms an HLC carries.
+fn hlc_ms(hlc: &str) -> Option<i64> {
+    hlc.get(..13)?.parse().ok()
+}
+
+/// Alphanumerics, at most `max`, the first passing `first`.
+fn valid_name(name: &str, first: fn(&u8) -> bool, max: usize) -> bool {
+    let bytes = name.as_bytes();
+    bytes.first().is_some_and(first) && bytes.len() <= max && bytes.iter().all(u8::is_ascii_alphanumeric)
+}
+
+/// A kind: `^[a-z][a-zA-Z0-9]{0,31}$`.
+fn valid_kind(kind: &str) -> bool {
+    valid_name(kind, u8::is_ascii_lowercase, 32)
+}
+
+/// A field: `^[a-zA-Z][a-zA-Z0-9]{0,63}$`.
+fn valid_field(field: &str) -> bool {
+    valid_name(field, u8::is_ascii_alphabetic, 64)
+}
+
+/// `ID_RE`: `^[A-Za-z0-9_.:@/-]{1,256}$`.
+fn valid_id(id: &str) -> bool {
+    (1..=256).contains(&id.len())
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"_.:@/-".contains(&b))
+}
+
+/// The value rules `validateOp` puts on a sidebar pin and a cloud agent's
+/// choices.
+fn valid_values(op: &RowOp) -> bool {
+    let set = op.set.iter().flatten();
+    if op.kind == KIND_SIDEBAR_PINS {
+        return op.op != OpKind::Delete
+            && set
+                .into_iter()
+                .all(|(key, value)| match (key.as_str(), value) {
+                    ("pinned", Value::Bool(_)) => true,
+                    ("orderKey", Value::String(key)) => {
+                        key.len() <= 8192
+                            && key.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+                            && key.bytes().last().is_some_and(|b| b != b'0')
+                    }
+                    _ => false,
+                });
+    }
+    if op.kind == KIND_CLOUD_AGENTS {
+        return set.into_iter().all(|(key, value)| {
+            matches!(
+                key.as_str(),
+                "nativeSubagents" | "codeMode" | "zeronMcpOnly"
+            ) && matches!(value, Value::Bool(_) | Value::Null)
+        });
+    }
+    true
+}
+
+/// What the room's `validateOp` takes (`edge/src/registry-core.ts`): an op
+/// the room would refuse is never shown, since the room would never settle it.
+fn valid_op(op: &RowOp) -> bool {
+    valid_kind(&op.kind)
+        && valid_id(&op.id)
+        && valid_hlc(&op.hlc)
+        && match (&op.op, &op.set) {
+            (OpKind::Delete, set) => set.is_none(),
+            (_, Some(set)) => set.keys().all(|key| valid_field(key)),
+            (_, None) => false,
+        }
+        && op
+            .clocks
+            .iter()
+            .flatten()
+            .all(|(key, clock)| valid_field(key) && valid_hlc(clock))
+        && fits_op_budget(op)
+        && valid_values(op)
+}
+
+/// Some clock on `op` runs more than [`CLOCK_AHEAD_MS`] past `now_ms`.
+fn clocked_ahead(op: &RowOp, now_ms: i64) -> bool {
+    std::iter::once(&op.hlc)
+        .chain(op.clocks.iter().flatten().map(|(_, clock)| clock))
+        .any(|clock| hlc_ms(clock).is_none_or(|ms| ms > now_ms + CLOCK_AHEAD_MS))
+}
+
+/// A peer writes no device row but its own, and removes none: a device row
+/// says where and whether a device can be reached.
+fn its_own_to_write(op: &RowOp, from: &str) -> bool {
+    op.kind != KIND_DEVICES || (op.id == from && op.op != OpKind::Delete)
+}
+
+/// The host `op` names for its chat or Space, when it names one.
+fn host_named(op: &RowOp) -> Option<&Value> {
+    if op.kind != KIND_CHATS && op.kind != KIND_SPACES {
+        return None;
+    }
+    op.set.as_ref()?.get(HOST_FIELD)
+}
+
+/// Take the host out of `op`. False when that was all it said.
+fn strip_host(op: &mut RowOp) -> bool {
+    let Some(set) = &mut op.set else { return true };
+    if set.remove(HOST_FIELD).is_none() {
+        return true;
+    }
+    if let Some(clocks) = &mut op.clocks {
+        clocks.remove(HOST_FIELD);
+    }
+    !set.is_empty()
+}
+
+/// `op` from `from` without what a peer may not say here alone: which device
+/// hosts a chat or a Space, unless `may_name_itself` (the row is new and
+/// nothing else here names another host) and the host it names is `from`
+/// itself. `None`: nothing left of it.
+fn without_foreign_host(mut op: RowOp, from: &str, may_name_itself: bool) -> Option<RowOp> {
+    let names_itself = host_named(&op).is_some_and(|host| host.as_str() == Some(from));
+    if !(may_name_itself && names_itself) {
+        strip_host(&mut op);
+    }
+    let empty_update = op.op == OpKind::Update && op.set.as_ref().is_none_or(BTreeMap::is_empty);
+    (!empty_update).then_some(op)
+}
+
+/// Drop the ops that change nothing at their place in the replay over
+/// `base` (the room's row): what's left shows the same row. Once the room
+/// has the row, no peer op says its host.
+fn settle(ops: &mut Vec<PeerOp>, base: Option<&RegistryRow>) {
+    if base.is_some() {
+        ops.retain_mut(|peer| host_named(&peer.op).is_none() || strip_host(&mut peer.op));
+    }
+    let mut row = base.cloned();
+    ops.retain(|peer| {
+        let (next, changed) = apply_op(row.as_ref(), &peer.op);
+        if changed {
+            row = next;
+        }
+        changed
+    });
+}
+
+/// A row's peer ops, then this device's own pending ops on it, then the
+/// peer ops again when there were own ones (a peer's update to a row only
+/// this device's queue has made; replayed twice, a write changes nothing).
+fn replay_order<'a>(peer: &'a [PeerOp], own: Vec<&'a RowOp>) -> impl Iterator<Item = &'a RowOp> {
+    let again: &[PeerOp] = if own.is_empty() { &[] } else { peer };
+    peer.iter()
+        .map(|peer| &peer.op)
+        .chain(own)
+        .chain(again.iter().map(|peer| &peer.op))
+}
+
+impl PeerOverlay {
+    /// `(kind, id)`'s peer ops, in arrival order.
+    fn row(&self, kind: &str, id: &str) -> &[PeerOp] {
+        self.rows
+            .get(&(kind.to_owned(), id.to_owned()))
+            .map_or(&[], Vec::as_slice)
+    }
+
+    /// The room's row for `(kind, id)` is now `base`: drop what it covers.
+    /// Whether any op was dropped.
+    pub(super) fn settle_row(&mut self, kind: &str, id: &str, base: Option<&RegistryRow>) -> bool {
+        let key = (kind.to_owned(), id.to_owned());
+        self.settle_named(&key, base);
+        let Some(ops) = self.rows.get_mut(&key) else {
+            return false;
+        };
+        let before = ops.len();
+        settle(ops, base);
+        let dropped = ops.len() != before;
+        if ops.is_empty() {
+            self.rows.remove(&key);
+        }
+        dropped
+    }
+
+    /// Every row may have changed under the peer ops (a full replace).
+    pub(super) fn settle_all(&mut self, rows: &HashMap<String, HashMap<String, RegistryRow>>) {
+        self.rows.retain(|(kind, id), ops| {
+            settle(ops, rows.get(kind).and_then(|m| m.get(id)));
+            !ops.is_empty()
+        });
+        let keys: Vec<RowKey> = self.named.keys().cloned().collect();
+        for key in keys {
+            self.settle_named(&key, rows.get(&key.0).and_then(|m| m.get(&key.1)));
+        }
+    }
+
+    /// The room's row for `key` is now `base`: once it has the row, what
+    /// peers named as its host disputes nothing.
+    fn settle_named(&mut self, key: &RowKey, base: Option<&RegistryRow>) {
+        if base.is_some() {
+            self.named.remove(key);
+        }
+    }
+
+    /// `from` named `host` for `key` (a row the room hasn't got) at
+    /// `clock`: kept when newer than what it named before.
+    fn name_host(&mut self, from: &str, key: &RowKey, host: Value, clock: String, now_ms: i64) {
+        let named = self.named.entry(key.clone()).or_default();
+        if named.get(from).is_some_and(|was| !hlc_newer(&clock, Some(&was.clock))) {
+            return;
+        }
+        self.arrivals += 1;
+        let arrival = self.arrivals;
+        named.insert(
+            from.to_owned(),
+            NamedHost {
+                host,
+                clock,
+                received_ms: now_ms,
+                arrival,
+            },
+        );
+    }
+
+    /// Past [`PEER_OPS_PER_SENDER`] of `from`'s namings, or
+    /// [`PEER_OPS_TOTAL`] in all, drop the oldest. Once per call.
+    fn trim_named(&mut self, from: &str) {
+        for (sender, cap) in [(Some(from), PEER_OPS_PER_SENDER), (None, PEER_OPS_TOTAL)] {
+            let which = |who: &str| sender.is_none_or(|s| s == who);
+            let mut arrivals: Vec<u64> = self
+                .named
+                .values()
+                .flat_map(|named| named.iter())
+                .filter(|(who, _)| which(who.as_str()))
+                .map(|(_, named)| named.arrival)
+                .collect();
+            if arrivals.len() <= cap {
+                continue;
+            }
+            arrivals.sort_unstable();
+            let last = arrivals[arrivals.len() - cap - 1];
+            self.named.retain(|_, row| {
+                row.retain(|who, named| !(which(who.as_str()) && named.arrival <= last));
+                !row.is_empty()
+            });
+        }
+    }
+
+    /// Something here names `host` for `key`, a row the room hasn't got:
+    /// a peer's claim to host it that names another device no longer shows.
+    /// Whether any op changed.
+    fn drop_hosts_other_than(&mut self, key: &RowKey, host: &Value) -> bool {
+        let Some(ops) = self.rows.get_mut(key) else {
+            return false;
+        };
+        let before = ops.len();
+        let mut changed = false;
+        ops.retain_mut(|peer| match host_named(&peer.op) {
+            Some(named) if named != host => {
+                changed = true;
+                strip_host(&mut peer.op)
+            }
+            _ => true,
+        });
+        changed |= ops.len() != before;
+        if ops.is_empty() {
+            self.rows.remove(key);
+        }
+        changed
+    }
+
+    /// Past [`PEER_OPS_PER_ROW`] of `from`'s ops on `key`, drop its oldest
+    /// there.
+    fn trim_row(&mut self, from: &str, key: &RowKey) {
+        let Some(ops) = self.rows.get_mut(key) else {
+            return;
+        };
+        let theirs = |peer: &PeerOp| hlc_device(&peer.op.hlc) == Some(from);
+        let mut over = ops.iter().filter(|peer| theirs(peer)).count().saturating_sub(PEER_OPS_PER_ROW);
+        ops.retain(|peer| {
+            let drop = over > 0 && theirs(peer);
+            over -= usize::from(drop);
+            !drop
+        });
+    }
+
+    /// Past the caps, drop the oldest ops: `from`'s first, then anyone's.
+    /// The rows whose ops went.
+    fn trim(&mut self, from: &str) -> Vec<RowKey> {
+        let mut gone = Vec::new();
+        let theirs = |peer: &PeerOp| hlc_device(&peer.op.hlc) == Some(from);
+        let kept = self
+            .rows
+            .values()
+            .flatten()
+            .filter(|peer| theirs(peer))
+            .count();
+        if kept > PEER_OPS_PER_SENDER {
+            self.drop_oldest(kept - PEER_OPS_PER_SENDER, &theirs, &mut gone);
+        }
+        let kept: usize = self.rows.values().map(Vec::len).sum();
+        if kept > PEER_OPS_TOTAL {
+            self.drop_oldest(kept - PEER_OPS_TOTAL, &|_| true, &mut gone);
+        }
+        gone
+    }
+
+    /// Drop the `count` oldest of the ops `which` picks.
+    fn drop_oldest(&mut self, count: usize, which: &dyn Fn(&PeerOp) -> bool, gone: &mut Vec<RowKey>) {
+        let mut arrivals: Vec<u64> = self
+            .rows
+            .values()
+            .flatten()
+            .filter(|peer| which(peer))
+            .map(|peer| peer.arrival)
+            .collect();
+        arrivals.sort_unstable();
+        let Some(&last) = arrivals.get(count.saturating_sub(1)) else {
+            return;
+        };
+        self.rows.retain(|key, ops| {
+            let before = ops.len();
+            ops.retain(|peer| !(which(peer) && peer.arrival <= last));
+            if ops.len() != before {
+                gone.push(key.clone());
+            }
+            !ops.is_empty()
+        });
+    }
+
+    /// `device` (this one) wrote `ops`: keep its own for its peers, while
+    /// something takes them.
+    fn note_own(&mut self, device: &str, ops: &[RowOp]) {
+        let Some(outbox) = &mut self.outbox else {
+            return;
+        };
+        outbox.extend(ops.iter().filter(|op| written_by(op, device)).cloned());
+        if outbox.len() > OUTBOX_CAP {
+            outbox.clear();
+            self.outbox_missed = true;
+        }
+    }
+
+    /// The held rows, as saved.
+    pub(super) fn held_rows(&self) -> Vec<HeldRow> {
+        self.held
+            .iter()
+            .map(|((kind, id), hold)| HeldRow {
+                kind: kind.clone(),
+                id: id.clone(),
+                released: hold.released,
+            })
+            .collect()
+    }
+
+    /// The held rows a save holds, in place of any here.
+    pub(super) fn hold_rows(&mut self, rows: Vec<HeldRow>) {
+        self.held = rows
+            .into_iter()
+            .map(|row| {
+                let hold = Hold {
+                    since_ms: None,
+                    released: row.released,
+                };
+                ((row.kind, row.id), hold)
+            })
+            .collect();
+    }
+}
+
+impl RegistryDoc {
+    /// This device's pending ops on `(kind, id)`, in the order queued.
+    fn own_ops<'a>(&'a self, kind: &'a str, id: &'a str) -> impl Iterator<Item = &'a RowOp> {
+        self.pending_ops()
+            .filter(move |op| op.kind == kind && op.id == id)
+    }
+
+    /// What a read of `(kind, id)` replays over the room's row: its peer
+    /// ops and this device's pending ones ([`replay_order`]).
+    pub(super) fn row_replay<'a>(&'a self, kind: &'a str, id: &'a str) -> impl Iterator<Item = &'a RowOp> {
+        replay_order(self.peer.row(kind, id), self.own_ops(kind, id).collect())
+    }
+
+    /// [`Self::row_replay`] for every row of `kind` with something to
+    /// replay, in one pass over the pending queue: the rows peers wrote,
+    /// then those only this device's queue has.
+    pub(super) fn kind_replay<'a>(&'a self, kind: &str) -> Vec<(&'a str, Vec<&'a RowOp>)> {
+        let mut own: Vec<(&str, Vec<&RowOp>)> = Vec::new();
+        let mut at: HashMap<&str, usize> = HashMap::new();
+        for op in self.pending_ops().filter(|op| op.kind == kind) {
+            let i = *at.entry(op.id.as_str()).or_insert_with(|| {
+                own.push((op.id.as_str(), Vec::new()));
+                own.len() - 1
+            });
+            own[i].1.push(op);
+        }
+        let mut out: Vec<(&str, Vec<&RowOp>)> = Vec::new();
+        let peer_rows = self
+            .peer
+            .rows
+            .range((kind.to_owned(), String::new())..)
+            .take_while(|((k, _), _)| k == kind);
+        for ((_, id), peer) in peer_rows {
+            let mine = at
+                .remove(id.as_str())
+                .map(|i| std::mem::take(&mut own[i].1))
+                .unwrap_or_default();
+            out.push((id.as_str(), replay_order(peer, mine).collect()));
+        }
+        out.extend(own.into_iter().filter(|(id, _)| at.contains_key(id)));
+        out
+    }
+
+    /// Take another device's list writes, sent straight from it: `from` is
+    /// the device its link proved. Keeps each op written by `from` that the
+    /// room would take, that isn't clocked minutes ahead of this device, that
+    /// writes no device row but `from`'s own (and removes none), less any
+    /// host it names for a chat or Space that it may not, and that changes
+    /// the row as shown here; returns how many it kept. Past
+    /// [`PEER_OPS_PER_ROW`], [`PEER_OPS_PER_SENDER`] or [`PEER_OPS_TOTAL`]
+    /// the oldest go. Never moves the cursor, never queues a push, never
+    /// needs a save.
+    pub fn apply_peer_ops(&mut self, from: &str, ops: Vec<RowOp>) -> usize {
+        if from == self.device_id {
+            return 0;
+        }
+        let now = Self::now_ms();
+        let mut taken = 0;
+        for op in ops {
+            if !written_by(&op, from) || !valid_op(&op) || clocked_ahead(&op, now) || !its_own_to_write(&op, from) {
+                continue;
+            }
+            let in_room = self.authoritative.get(&op.kind).is_some_and(|m| m.contains_key(&op.id));
+            if let Some(host) = host_named(&op).cloned() {
+                let key = (op.kind.clone(), op.id.clone());
+                let clock = op.clock_for(HOST_FIELD).to_owned();
+                if !in_room {
+                    self.peer.name_host(from, &key, host.clone(), clock, now);
+                    if self.peer.drop_hosts_other_than(&key, &host) {
+                        self.touch_overlay(&key.0, &key.1);
+                    }
+                }
+            }
+            let may_name_itself = !in_room && !self.host_disputed(&op.kind, &op.id, from);
+            let Some(op) = without_foreign_host(op, from, may_name_itself) else {
+                continue;
+            };
+            let base = self.authoritative.get(&op.kind).and_then(|m| m.get(&op.id));
+            // Kept if it changes the row as peers' ops alone show it, or as
+            // this device's own pending ops do too (a row only its queue has).
+            let (kind, id) = (op.kind.as_str(), op.id.as_str());
+            let peer_shown = replay_row(base, self.peer.row(kind, id).iter().map(|peer| &peer.op));
+            let shown = replay_row(base, self.row_replay(kind, id));
+            if !apply_op(peer_shown.as_ref(), &op).1 && !apply_op(shown.as_ref(), &op).1 {
+                continue;
+            }
+            let key = (op.kind.clone(), op.id.clone());
+            let row_ops = self.peer.rows.entry(key.clone()).or_default();
+            // Writes to one row fold into one op where that's exact (as an
+            // unsent queue's do), so a row written often while the room is
+            // out of reach keeps one op, not one per write.
+            let folded = row_ops
+                .last()
+                .filter(|last| hlc_device(&last.op.hlc) == Some(from))
+                .and_then(|last| coalesce_ops(&last.op, &op));
+            self.peer.arrivals += 1;
+            let arrival = self.peer.arrivals;
+            match folded {
+                Some(merged) => {
+                    let last = row_ops.last_mut().expect("folded into the last op");
+                    last.op = merged;
+                    last.received_ms = now;
+                    last.arrival = arrival;
+                }
+                None => row_ops.push(PeerOp {
+                    op,
+                    received_ms: now,
+                    arrival,
+                }),
+            }
+            self.peer.trim_row(from, &key);
+            self.touch_overlay(&key.0, &key.1);
+            taken += 1;
+        }
+        self.peer.trim_named(from);
+        for (kind, id) in self.peer.trim(from) {
+            self.touch_overlay(&kind, &id);
+        }
+        taken
+    }
+
+    /// Something here names a host other than `from` for `(kind, id)`: this
+    /// device's own pending writes, or what a peer last named.
+    fn host_disputed(&self, kind: &str, id: &str, from: &str) -> bool {
+        let other = |host: &Value| host.as_str() != Some(from);
+        self.own_ops(kind, id).any(|op| host_named(op).is_some_and(other))
+            || self
+                .peer
+                .named
+                .get(&(kind.to_owned(), id.to_owned()))
+                .is_some_and(|named| named.values().any(|named| other(&named.host)))
+    }
+
+    /// The row as this device's own writes leave it: the room's row and its
+    /// pending queue, not what peers sent.
+    pub(super) fn own_row(&self, kind: &str, id: &str) -> Option<RegistryRow> {
+        replay_row(self.authoritative.get(kind).and_then(|m| m.get(id)), self.own_ops(kind, id))
+            .filter(|row| !row.deleted)
+    }
+
+    /// Ops taken from peers that the room hasn't confirmed yet.
+    pub fn peer_ops_len(&self) -> usize {
+        self.peer.rows.values().map(Vec::len).sum()
+    }
+
+    /// Drop peer ops that arrived before `cutoff_ms` (epoch ms): the room
+    /// never confirmed them, so their writer never pushed them, and the
+    /// room's rows stand. Returns how many were dropped.
+    pub fn expire_peer_ops(&mut self, cutoff_ms: i64) -> usize {
+        let mut dropped = 0;
+        let mut touched = Vec::new();
+        self.peer.rows.retain(|key, ops| {
+            let before = ops.len();
+            ops.retain(|peer| peer.received_ms >= cutoff_ms);
+            if ops.len() != before {
+                dropped += before - ops.len();
+                touched.push(key.clone());
+            }
+            !ops.is_empty()
+        });
+        self.peer.named.retain(|_, named| {
+            named.retain(|_, named| named.received_ms >= cutoff_ms);
+            !named.is_empty()
+        });
+        for (kind, id) in touched {
+            self.touch_overlay(&kind, &id);
+        }
+        dropped
+    }
+
+    /// Forget every peer op, as a restart does (the held rows stay: they're
+    /// saved).
+    pub fn forget_peer_ops(&mut self) {
+        self.peer.named.clear();
+        let keys: Vec<RowKey> = std::mem::take(&mut self.peer.rows).into_keys().collect();
+        for (kind, id) in keys {
+            self.touch_overlay(&kind, &id);
+        }
+    }
+
+    /// Keep this device's own writes for its peers from now on (`false`:
+    /// stop, and drop what's kept). Off by default: nothing takes them.
+    pub fn keep_peer_outbox(&mut self, on: bool) {
+        self.peer.outbox = on.then(Vec::new);
+        self.peer.outbox_missed = false;
+    }
+
+    /// This device's own writes since the last take, for its peers.
+    pub fn take_peer_outbox(&mut self) -> PeerOutbox {
+        let ops = self
+            .peer
+            .outbox
+            .as_mut()
+            .map(std::mem::take)
+            .unwrap_or_default();
+        PeerOutbox {
+            ops,
+            missed: std::mem::take(&mut self.peer.outbox_missed),
+        }
+    }
+
+    /// This device's own writes the room hasn't acknowledged, in the order
+    /// queued: what a peer that may have missed some is sent.
+    pub fn own_pending_ops(&self) -> Vec<RowOp> {
+        self.pending_ops()
+            .filter(|op| written_by(op, &self.device_id))
+            .cloned()
+            .collect()
+    }
+
+    /// This device is queueing `ops`: kept for its peers, and an update to a
+    /// row it knows only through a peer's ops holds that row ([`HeldRow`]).
+    pub(super) fn note_own_for_peers(&mut self, ops: &[RowOp]) {
+        self.peer.note_own(&self.device_id, ops);
+        for op in ops {
+            let in_room = self
+                .authoritative
+                .get(&op.kind)
+                .is_some_and(|rows| rows.contains_key(&op.id));
+            // This device names the host of a row the room hasn't got: a
+            // peer's claim naming another no longer shows.
+            if let Some(host) = host_named(op).filter(|_| !in_room) {
+                let key = (op.kind.clone(), op.id.clone());
+                if self.peer.drop_hosts_other_than(&key, host) {
+                    self.touch_overlay(&key.0, &key.1);
+                }
+            }
+            if op.op != OpKind::Update {
+                continue;
+            }
+            if !in_room && !self.peer.row(&op.kind, &op.id).is_empty() {
+                self.peer.held.entry((op.kind.clone(), op.id.clone())).or_default();
+            }
+        }
+    }
+
+    /// Per pending batch, whether it waits for the room to have a row (on a
+    /// push at `now_ms`, the room reachable): an `update` to a held row (the
+    /// room drops an update to a row it hasn't got, so pushed now, the write
+    /// would be lost if the peer's create reaches the room after it). Later
+    /// batches touching a waiting batch's rows wait too, so each row's
+    /// writes still reach the room in the order made. A hold ends when the
+    /// room's row arrives, or [`HOLD_LIMIT_MS`] after the first push it held
+    /// back (the update goes; if no room ever has the row it's dropped, as
+    /// it always was), whatever a peer sends or stops sending meanwhile.
+    pub(super) fn waiting_for_rows(&mut self, now_ms: i64) -> Vec<bool> {
+        let authoritative = &self.authoritative;
+        let pending = &self.pending;
+        self.peer.held.retain(|(kind, id), hold| {
+            let in_room = authoritative.get(kind).is_some_and(|rows| rows.contains_key(id));
+            let queued = || {
+                pending
+                    .iter()
+                    .flat_map(|batch| &batch.ops)
+                    .any(|op| &op.kind == kind && &op.id == id)
+            };
+            !in_room && (!hold.released || queued())
+        });
+        if self.peer.held.is_empty() {
+            return vec![false; self.pending.len()];
+        }
+        for hold in self.peer.held.values_mut().filter(|hold| !hold.released) {
+            let since = *hold.since_ms.get_or_insert(now_ms);
+            hold.released = now_ms.saturating_sub(since) >= HOLD_LIMIT_MS;
+        }
+        let held = &self.peer.held;
+        let holds = |op: &RowOp| {
+            op.op == OpKind::Update
+                && held
+                    .get(&(op.kind.clone(), op.id.clone()))
+                    .is_some_and(|hold| !hold.released)
+        };
+        let mut waiting: HashSet<(&str, &str)> = HashSet::new();
+        self.pending
+            .iter()
+            .map(|batch| {
+                let waits = batch
+                    .ops
+                    .iter()
+                    .any(|op| waiting.contains(&(op.kind.as_str(), op.id.as_str())) || holds(op));
+                if waits {
+                    waiting.extend(batch.ops.iter().map(|op| (op.kind.as_str(), op.id.as_str())));
+                }
+                waits
+            })
+            .collect()
+    }
+
+    /// Some of this device's writes aren't on their way to the room: a
+    /// transport that just applied the room's rows pushes again, since rows
+    /// can end a batch's wait ([`Self::waiting_for_rows`]).
+    pub fn has_unsent(&self) -> bool {
+        self.pending.iter().any(|batch| !batch.in_flight)
+    }
+
+    /// Every row as this device shows it (the room's, then peer ops, then its
+    /// own pending), tombstones included, by kind and id.
+    pub fn shown_rows(&self) -> Vec<RegistryRow> {
+        let mut keys: std::collections::BTreeSet<(&str, &str)> = self
+            .authoritative
+            .iter()
+            .flat_map(|(kind, rows)| rows.keys().map(move |id| (kind.as_str(), id.as_str())))
+            .collect();
+        keys.extend(
+            self.pending_ops()
+                .map(|op| (op.kind.as_str(), op.id.as_str())),
+        );
+        keys.extend(self.peer.rows.keys().map(|(kind, id)| (kind.as_str(), id.as_str())));
+        keys.into_iter()
+            .filter_map(|(kind, id)| self.overlay_row_or_tombstone(kind, id))
+            .collect()
+    }
+}
