diff --git a/crates/doc/src/registry/merge_vectors.rs b/crates/doc/src/registry/merge_vectors.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3af7a6ead379a2454b4a57ffe976e2ce17a7c3a9
--- /dev/null
+++ b/crates/doc/src/registry/merge_vectors.rs
@@ -0,0 +1,124 @@
+//! The registry merge's shared vectors, `edge/src/registry-merge-vectors.json`
+//! (the edge's `registry-core.test.ts` reads the same file), as the merge's
+//! own tests (`tests.rs`) and the peer overlay's (`peer_overlay.rs`) run them.
+
+use super::*;
+
+const VECTORS: &str = include_str!("../../../../edge/src/registry-merge-vectors.json");
+
+/// What a row shows: deleted, its tombstone clock, its fields and their
+/// clocks (not the room's seq).
+pub(super) type Shape = (
+    bool,
+    Option<String>,
+    BTreeMap<String, Value>,
+    BTreeMap<String, String>,
+);
+
+pub(super) fn shape(row: Option<RegistryRow>) -> Option<Shape> {
+    row.map(|r| (r.deleted, r.del_hlc, r.fields, r.clocks))
+}
+
+pub(super) struct Vector {
+    pub name: String,
+    pub kind: String,
+    pub id: String,
+    /// Ops already merged into the row (the room's row, to the overlay).
+    pub room: Vec<RowOp>,
+    pub steps: Vec<Step>,
+    /// The steps after these many may arrive in any order.
+    pub any_order_after: Option<usize>,
+    /// The row at the end.
+    pub expect: Option<Shape>,
+}
+
+pub(super) struct Step {
+    pub op: RowOp,
+    /// Whether it changes the row (not given where the order varies).
+    pub changed: Option<bool>,
+}
+
+impl Vector {
+    /// Every order its steps may arrive in: the one given, or with
+    /// [`Self::any_order_after`], each permutation of the rest.
+    pub fn orders(&self) -> Vec<Vec<&Step>> {
+        let Some(fixed) = self.any_order_after else {
+            return vec![self.steps.iter().collect()];
+        };
+        let (first, rest) = self.steps.split_at(fixed);
+        permutations(rest.iter().collect())
+            .into_iter()
+            .map(|tail| first.iter().chain(tail).collect())
+            .collect()
+    }
+}
+
+fn permutations<T: Copy>(items: Vec<T>) -> Vec<Vec<T>> {
+    if items.is_empty() {
+        return vec![Vec::new()];
+    }
+    let mut all = Vec::new();
+    for i in 0..items.len() {
+        let mut rest = items.clone();
+        let head = rest.remove(i);
+        for mut tail in permutations(rest) {
+            tail.insert(0, head);
+            all.push(tail);
+        }
+    }
+    all
+}
+
+pub(super) fn vectors() -> Vec<Vector> {
+    let file: Value = serde_json::from_str(VECTORS).expect("the vectors are JSON");
+    let kind = file["row"]["kind"].as_str().expect("row kind").to_owned();
+    let id = file["row"]["id"].as_str().expect("row id").to_owned();
+    let op = |value: &Value| -> RowOp {
+        let mut value = value.clone();
+        value["kind"] = json!(kind);
+        value["id"] = json!(id);
+        serde_json::from_value(value).expect("a wire op")
+    };
+    let vectors = file["vectors"].as_array().expect("vectors");
+    vectors
+        .iter()
+        .map(|vector| {
+            let ops = |key: &str| -> Vec<RowOp> {
+                vector[key].as_array().map(|ops| ops.iter().map(op).collect()).unwrap_or_default()
+            };
+            let steps = vector["ops"]
+                .as_array()
+                .expect("ops")
+                .iter()
+                .map(|step| Step {
+                    op: match step.get("seedOf") {
+                        Some(seeded) => {
+                            let ops: Vec<RowOp> = seeded.as_array().expect("seedOf ops").iter().map(op).collect();
+                            row_to_seed_op(&replay_row(None, &ops).expect("a row to seed"))
+                        }
+                        None => op(&step["apply"]),
+                    },
+                    changed: step.get("changed").map(|c| c.as_bool().expect("changed")),
+                })
+                .collect();
+            let expect = (!vector["expect"].is_null()).then(|| {
+                let want = &vector["expect"];
+                (
+                    want["deleted"].as_bool().expect("deleted"),
+                    want.get("delHlc").map(|h| h.as_str().expect("delHlc").to_owned()),
+                    serde_json::from_value(want["fields"].clone()).expect("fields"),
+                    serde_json::from_value(want["clocks"].clone()).expect("clocks"),
+                )
+            });
+            Vector {
+                name: vector["name"].as_str().expect("name").to_owned(),
+                kind: kind.clone(),
+                id: id.clone(),
+                room: ops("room"),
+                steps,
+                any_order_after: vector.get("anyOrderAfter").map(|n| n.as_u64().expect("a count") as usize),
+                expect,
+            }
+        })
+        .collect()
+}
