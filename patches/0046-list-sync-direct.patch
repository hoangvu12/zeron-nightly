+    /// Pushes at `now_ms` (the room reachable), as `take_pushable` does then.
+    fn pushable_at(doc: &mut RegistryDoc, now_ms: i64) -> usize {
+        doc.waiting_for_rows(now_ms).iter().filter(|waits| !**waits).count()
+    }
