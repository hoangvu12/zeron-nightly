+++ b/crates/engine/tests/peer_list_sync.rs
@@ -0,0 +1,205 @@
+//! List changes go straight between two of the person's computers, ahead of
+//! the RegistryRoom (ticket 07): a chat made on one shows on the other while
+//! the room holds the change back, only a proven device's changes are taken,
+//! and once the room catches up both engines and the room agree.
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+#[path = "support/proven.rs"]
+mod proven;
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use engines::{Engines, serial, wait_until};
+use zeron_engine::direct_rpc::{self, Pairing as _};
+use zeron_rpc::{RpcService, methods};
+
+/// Both engines in the room, caught up, each showing just the room's rows.
+async fn settled(engines: &Engines) {
+    let registry = &engines.edge.registry;
+    wait_until(
+        Duration::from_secs(30),
+        "both engines joined the room and show its rows",
+        || {
+            [&engines.a, &engines.b].iter().all(|core| {
+                core.workspace.connected()
+                    && core.workspace.registry_synced()
+                    && core.workspace.registry_rows() == registry.rows()
+            })
+        },
+    )
+    .await;
+}
+
+fn lists_chat(core: &zeron_engine::EngineCore, chat: &str) -> bool {
+    core.workspace
+        .watch_chats()
+        .borrow()
+        .iter()
+        .any(|c| c.id == chat)
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_chat_made_on_one_engine_shows_on_the_other_while_the_room_holds_it_back_and_all_three_agree_after()
+ {
+    let _serial = serial().await;
+    let engines = Engines::start("peer-list-new-chat").await;
+    let pairing = proven::pair_proven(&engines.a, &engines.b);
+    pairing.set_up();
+    settled(&engines).await;
+    let registry = &engines.edge.registry;
+    let chat = "chat-peer-list-new";
+
+    // The room holds A's push back: only the direct link can carry it.
+    registry.hold_pushes(true);
+    let b_cursor = engines.b.workspace.registry_cursor();
+    engines
+        .a
+        .workspace
+        .create_chat(chat, None, Some(&engines.a_id), None, None)
+        .expect("create the chat on A");
+    wait_until(Duration::from_secs(20), "B lists A's new chat", || {
+        lists_chat(&engines.b, chat)
+    })
+    .await;
+    assert!(
+        registry.row("chats", chat).is_none(),
+        "the room hasn't applied it"
+    );
+    assert!(registry.held_pushes() >= 1, "A's push waits in the room");
+    assert!(
+        pairing.a_to_b.came_direct(methods::PEER_LIST_OPS) >= 1,
+        "it came over the direct link"
+    );
+    assert_eq!(
+        engines.b.workspace.registry_cursor(),
+        b_cursor,
+        "B's cursor didn't move"
+    );
+
+    // The room catches up: A, B and the room hold the same rows, and B
+    // pushed none of A's change itself (every clock on it is A's).
+    registry.hold_pushes(false);
+    wait_until(
+        Duration::from_secs(30),
+        "A, B and the room hold identical rows",
+        || {
+            let room = registry.rows();
+            room.iter().any(|row| row.kind == "chats" && row.id == chat)
+                && engines.a.workspace.registry_rows() == room
+                && engines.b.workspace.registry_rows() == room
+                && engines.a.workspace.registry_cursor() == registry.seq()
+                && engines.b.workspace.registry_cursor() == registry.seq()
+        },
+    )
+    .await;
+    assert!(lists_chat(&engines.a, chat) && lists_chat(&engines.b, chat));
+    let row = registry.row("chats", chat).expect("the room's row");
+    assert!(
+        row.clocks.values().all(|clock| clock.ends_with(engines.a_id.as_str())),
+        "only A's writes: {:?}",
+        row.clocks
+    );
+
+    engines.shutdown().await;
+}
+
+/// A chats op as A writes them, with its clock naming `writer`.
+fn chat_op(chat: &str, host: &str, writer: &str) -> serde_json::Value {
+    let ms = chrono::Utc::now().timestamp_millis();
+    serde_json::json!({
+        "kind": "chats",
+        "id": chat,
+        "op": "upsert",
+        "set": { "id": chat, "deviceId": host, "title": "Sent straight" },
+        "hlc": format!("{ms:013}-000000-{writer}"),
+    })
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn list_changes_are_taken_only_from_a_proven_device_and_only_its_own() {
+    let _serial = serial().await;
+    let engines = Engines::start("peer-list-refused").await;
+    proven::trust_each_other(&[&engines.a, &engines.b]);
+    let (a_id, b_id) = (engines.a_id.clone(), engines.b_id.clone());
+    let b_service: Arc<dyn RpcService> = engines.b.rpc_service();
+    let rig = direct::DirectRig::over(
+        &a_id,
+        direct_rpc::Service::new(&b_service).proving(&b_id, engines.b.plugins.device_verifier()),
+    );
+    rig.set_up();
+    let ops =
+        |chat: &str, writer: &str| serde_json::json!({ "ops": [chat_op(chat, &a_id, writer)] });
+    let a = a_id.as_str();
+
+    // A link that didn't prove its device: refused.
+    let unproven = direct_rpc::client(rig.open(&b_id).await.expect("a link"));
+    let refused = unproven
+        .call(methods::PEER_LIST_OPS, ops("chat-unproven", a))
+        .await;
+    assert!(refused.is_err(), "an unproven link's changes: {refused:?}");
+
+    // This device's own app (or anything local): refused.
+    let local = zeron_rpc::memory_client(engines.b.rpc_service());
+    let refused = local
+        .call(methods::PEER_LIST_OPS, ops("chat-local", a))
+        .await;
+    assert!(refused.is_err(), "a local caller's changes: {refused:?}");
+
+    // A on the relay, which the edge vouches for: refused, whoever calls.
+    let relay = engines
+        .a
+        .roads()
+        .expect("roads")
+        .by_relay(&b_id)
+        .await
+        .expect("the relay to B");
+    let refused = relay.client.call(methods::PEER_LIST_OPS, ops("chat-relay", a)).await;
+    let why = refused.expect_err("changes by the relay").to_string();
+    assert!(why.contains("never the relay"), "refused for the road it took: {why}");
+
+    // A link that proved it's A: an op whose clock names another device
+    // isn't taken; A's own is.
+    let proven = direct_rpc::client(rig.open(&b_id).await.expect("a link"));
+    let proved = direct_rpc::prove(&proven, &b_id, &engines.a.plugins.device_link_prover())
+        .await
+        .expect("A proves itself");
+    assert_eq!(proved, a_id);
+    let forged = proven
+        .call(
+            methods::PEER_LIST_OPS,
+            ops("chat-forged", "peer-list-refused-c"),
+        )
+        .await
+        .expect("answered");
+    assert_eq!(forged["taken"], 0);
+    let taken = proven
+        .call(methods::PEER_LIST_OPS, ops("chat-proven", a))
+        .await
+        .expect("answered");
+    assert_eq!(taken["taken"], 1);
+
+    wait_until(
+        Duration::from_secs(10),
+        "B lists the proven device's chat",
+        || lists_chat(&engines.b, "chat-proven"),
+    )
+    .await;
+    for chat in ["chat-unproven", "chat-local", "chat-relay", "chat-forged"] {
+        assert!(
+            engines.b.workspace.chat(chat).expect("read").is_none(),
+            "{chat} was taken"
+        );
+    }
+
+    engines.shutdown().await;
+}
