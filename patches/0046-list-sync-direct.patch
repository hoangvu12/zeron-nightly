+/// A host behind on a chat being moved to it refuses that chat's sends
+/// until its list catches up (a known gap): the old host still has the room's
+/// row and would run them too, each with its own ledger.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_host_takes_a_moved_chats_commands_only_once_its_list_says_it_hosts_it() {
+    let _serial = serial().await;
+    let (engines, _pairing) = proven_engines("offline-moved").await;
+    let registry = &engines.edge.registry;
+    let chat = "chat-moved";
+    // A chat on a third computer, in the room and on both lists.
+    engines
+        .a
+        .workspace
+        .create_chat(chat, None, Some("offline-moved-sg"), None, None)
+        .expect("create on A");
+    wait_until(Duration::from_secs(20), "B lists the chat", || lists_chat(&engines.b, chat)).await;
+    let road = engines
+        .a
+        .roads()
+        .expect("roads")
+        .client(&engines.b_id)
+        .await
+        .expect("a road to B");
+    assert!(!road.is_relay(), "A's proven link to B");
+    let relay = |entry: zeron_doc::SessionCommandEntry| {
+        let client = road.client.clone();
+        async move {
+            client
+                .call(methods::RELAY_COMMAND, serde_json::json!({ "chatId": chat, "entry": entry }))
+                .await
+        }
+    };
+    let refused = relay(stop_from(&engines.a_id, "cmd-before")).await;
+    assert!(
+        refused.as_ref().is_err_and(|e| e.to_string().contains("doesn't host")),
+        "B doesn't host it yet: {refused:?}"
+    );
+
+    // The room is down; A moves the chat to B, then renames it. B hears
+    // both from A alone, in order: once it shows the rename, it has the move.
+    registry.set_down(true);
+    both_off_the_room(&engines).await;
+    assert!(engines.a.workspace.set_chat_host(chat, &engines.b_id).expect("move"));
+    assert!(engines.a.workspace.rename_chat(chat, "Moved").expect("rename"));
+    wait_until(Duration::from_secs(20), "B shows A's rename", || {
+        title(&engines.b, chat).as_deref() == Some("Moved")
+    })
+    .await;
+    let refused = relay(stop_from(&engines.a_id, "cmd-moving")).await;
+    assert!(
+        refused.as_ref().is_err_and(|e| e.to_string().contains("doesn't host")),
+        "A's word alone doesn't make B the host: {refused:?}"
+    );
+
+    // The room is back and B's list says B hosts it: B takes A's commands.
+    registry.set_down(false);
+    zeron_sync::wake::notify_online();
+    wait_until(Duration::from_secs(30), "B's list says B hosts the chat", || {
+        engines.b.workspace.chat(chat).ok().flatten().is_some_and(|row| row.device_id == engines.b_id)
+    })
+    .await;
+    let taken = relay(stop_from(&engines.a_id, "cmd-after")).await.expect("B takes the command");
+    assert!(taken.get("outcome").is_some(), "{taken}");
+    // Still only A's own commands.
+    let forged = relay(stop_from("offline-moved-phone", "cmd-forged")).await;
+    assert!(
+        forged.as_ref().is_err_and(|e| e.to_string().contains("its own commands")),
+        "another device's command: {forged:?}"
+    );
+
+    engines.shutdown().await;
+}
