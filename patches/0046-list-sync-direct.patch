+        assert!(doc.take_peer_outbox().ops.is_empty(), "taken once");
+        assert_eq!(
+            doc.own_pending_ops().len(),
+            doc.pending_ops_len(),
+            "the queue, for a peer that missed some"
+        );
+
+        // Rows re-seeded to a wiped room carry their writers' clocks: not ours to send.
+        let other = folded(&[RowOp {
+            id: "theirs".into(),
+            ..upsert(&hello(), 1000, "dev-b")
+        }])
