+/// A Stop in `chat` issued by `device`, as a relayed command carries it.
+fn stop_from(device: &str, id: &str) -> zeron_doc::SessionCommandEntry {
+    zeron_doc::SessionCommandEntry {
+        id: id.into(),
+        payload: zeron_doc::SessionCommandPayload::Interrupt {},
+        issued_by: device.into(),
+        issued_at: now_ms(),
+        based_on: None,
+        expires_at: None,
+        status: zeron_doc::SessionCommandStatus::Pending,
+        resolution: None,
+    }
+}
