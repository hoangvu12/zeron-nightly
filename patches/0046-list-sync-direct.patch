+    #[test]
+    fn a_held_update_waits_through_the_peers_op_going_and_at_most_the_hold_limit() {
+        let create = upsert(&hello(), 1000, "dev-a");
+        let mut doc = RegistryDoc::new("dev-me");
+        doc.apply_peer_ops("dev-a", vec![create.clone()]);
+        assert!(doc.rename_chat("chat-1", "renamed").expect("rename"));
+        let first = RegistryDoc::now_ms();
+        assert_eq!(pushable_at(&mut doc, first), 0);
+
+        // The peer's op leaves the overlay (expired, or trimmed past a cap):
+        // the update still waits for the room's row.
+        doc.expire_peer_ops(RegistryDoc::now_ms() + 1);
+        assert_eq!(doc.peer_ops_len(), 0);
+        assert!(doc.take_pushable().is_empty(), "the peer's op going ends no wait");
+
+        // A peer that keeps the row alive with newer writes doesn't stretch
+        // the wait past the limit, counted from the first push it held.
+        let again = upsert(&[("title", json!("again"))], RegistryDoc::now_ms(), "dev-a");
+        assert_eq!(doc.apply_peer_ops("dev-a", vec![again]), 1);
+        assert_eq!(pushable_at(&mut doc, first + HOLD_LIMIT_MS - 1), 0);
+        assert_eq!(pushable_at(&mut doc, first + HOLD_LIMIT_MS), 1);
+        let pushed: Vec<RowOp> = doc.take_pushable().into_iter().flat_map(|batch| batch.ops).collect();
+        assert_eq!(pushed.len(), 1, "it goes (and, no room having the row, is dropped as it always was)");
+        assert!(written_by(&pushed[0], "dev-me"));
+    }
