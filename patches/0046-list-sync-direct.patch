diff --git a/crates/engine/src/workspace_host/peer_list.rs b/crates/engine/src/workspace_host/peer_list.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fd6eb1eed9bb433677d2452930c24c57acae1934
--- /dev/null
+++ b/crates/engine/src/workspace_host/peer_list.rs
@@ -0,0 +1,494 @@
+//! List changes between the person's devices directly, ahead of the
+//! RegistryRoom (docs/registry-sync.md, "Peer overlay").
+//!
+//! - **Sending.** Every list write this device makes still goes to its
+//!   pending queue and the room, as always. It's also sent, in the order
+//!   made, to each of its online computers that takes list changes directly
+//!   ([`zeron_proto::capabilities::REGISTRY_PEER_V1`]), on a road that isn't
+//!   the relay (the relay is the edge, which the room already is) and whose
+//!   link proved this device ([`crate::direct_rpc::Roads::proven`]).
+//!   A device that may have missed some (no road a moment ago, a send that
+//!   failed, the first send to it) is sent the whole pending queue first:
+//!   what the room hasn't acknowledged yet, so what it may not have had.
+//!   Failures cost nothing more: the room carries everything anyway.
+//! - **Taking.** [`methods::PEER_LIST_OPS`] takes ops only from a caller
+//!   [`crate::direct_peer`] admits (proven, listed, another device, key not
+//!   revoked, not a Cloud machine, never by the relay), a few calls a second
+//!   at most, and only ops whose clocks name that device. A Cloud machine
+//!   takes none. They're shown over the room's rows until the room's rows
+//!   cover them (`zeron_doc` `peer_overlay`), never pushed on or counted
+//!   toward the cursor.
+//! - **Beats.** On every presence beat, each of those devices is sent a call
+//!   (empty when there's nothing new), so it knows this one is alive with the
+//!   edge down (`peer_presence`), and one that may have missed some gets the
+//!   whole pending queue as soon as a road is back. A device whose beats
+//!   return after a silence is sent it at once. Only devices
+//!   [`crate::direct_peer::may_reach`] passes are sent anything.
+//! - **Expiry.** An op the room never confirms is dropped
+//!   [`PEER_OPS_TTL_MS`] after it arrived while the room is reachable and
+//!   synced (with the room up, a live writer's push lands in seconds), and
+//!   [`PEER_OPS_OUTAGE_TTL_MS`] after while it isn't, so none stays forever.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+use std::time::Duration;
+
+use tokio::sync::{mpsc, watch};
+use tokio::time::Instant;
+use zeron_doc::RowOp;
+use zeron_rpc::{RpcError, RpcReply, methods};
+
+use super::{WeakWorkspaceHost, WorkspaceHost, WorkspaceHostInner, lock};
+use crate::direct_rpc::{Road, Roads};
+use crate::now_ms;
+
+/// How long one send of list changes may take before the link is suspect.
+const SEND_TIMEOUT: Duration = Duration::from_secs(10);
+/// Ops per call: a whole pending queue goes in calls of this many, and a
+/// call with more is refused.
+const OPS_PER_CALL: usize = 400;
+/// Sends waiting for one device; past it, that device missed some and gets
+/// the whole pending queue next time.
+const QUEUED_SENDS: usize = 64;
+/// A peer's op the room hasn't confirmed this long after it arrived (with
+/// the room reachable) is dropped: its writer never pushed it.
+pub const PEER_OPS_TTL_MS: i64 = 10 * 60 * 1000;
+/// The same while the room is out of reach: long enough to outlast an edge
+/// outage, short enough that nothing stays forever.
+pub const PEER_OPS_OUTAGE_TTL_MS: i64 = 6 * 60 * 60 * 1000;
+/// How often unconfirmed peer ops are looked at.
+const EXPIRE_EVERY: Duration = Duration::from_secs(60);
+/// Signals waiting for the sending task.
+const QUEUED_SIGNALS: usize = 64;
+/// `PeerListOps` calls one device may make at once, and a second after
+/// that: a beat every few seconds, and a whole pending queue in a burst.
+const CALL_BURST: f64 = 32.0;
+const CALLS_PER_SEC: f64 = 4.0;
+
+/// One device's allowance of [`methods::PEER_LIST_OPS`] calls.
+#[derive(Debug, Clone, Copy)]
+struct CallBudget {
+    left: f64,
+    at: Instant,
+}
+
+impl CallBudget {
+    fn new(now: Instant) -> Self {
+        Self { left: CALL_BURST, at: now }
+    }
+
+    /// One call at `now`: false when the device has none left.
+    fn take(&mut self, now: Instant) -> bool {
+        let earned = now.saturating_duration_since(self.at).as_secs_f64() * CALLS_PER_SEC;
+        self.left = (self.left + earned).min(CALL_BURST);
+        self.at = now;
+        if self.left < 1.0 {
+            return false;
+        }
+        self.left -= 1.0;
+        true
+    }
+}
+
+/// What the host keeps for sending list changes to its peers.
+#[derive(Default)]
+pub(super) struct PeerList {
+    /// The roads to the other devices, once the engine wired them.
+    roads: Mutex<Option<Roads>>,
+    /// The sending task runs.
+    started: AtomicBool,
+    /// To the sending task, once it runs.
+    signals: Mutex<Option<mpsc::Sender<Signal>>>,
+    /// Each device's allowance of calls.
+    budgets: Mutex<HashMap<String, CallBudget>>,
+}
+
+/// What the sending task is asked to do besides sending new writes.
+enum Signal {
+    /// Call every peer (the presence beat).
+    Beat,
+    /// This device's beats came back after a silence: it may have missed
+    /// some, so send it the whole pending queue now.
+    Back(String),
+}
+
+impl PeerList {
+    /// Call every peer now: the presence beat.
+    pub(super) fn beat(&self) {
+        self.signal(Signal::Beat);
+    }
+
+    /// `device` is heard from again after a silence.
+    pub(super) fn came_back(&self, device: &str) {
+        self.signal(Signal::Back(device.to_owned()));
+    }
+
+    fn signal(&self, signal: Signal) {
+        if let Some(signals) = lock(&self.signals).as_ref() {
+            // Full: the task is behind on signals it will act on anyway.
+            let _ = signals.try_send(signal);
+        }
+    }
+}
+
+/// Unconfirmed peer ops that arrived before this go (epoch ms).
+fn expiry_cutoff(now_ms: i64, room_up: bool) -> i64 {
+    now_ms
+        - if room_up {
+            PEER_OPS_TTL_MS
+        } else {
+            PEER_OPS_OUTAGE_TTL_MS
+        }
+}
+
+impl WorkspaceHost {
+    /// Send this device's list changes to its online computers on `roads`
+    /// too, as they're made. Called whenever the engine (re)wires its roads;
+    /// the latest roads are used. Not on a Cloud machine, nor a replica no
+    /// room will ever see.
+    pub fn send_list_changes_to_peers(&self, roads: Roads) {
+        if crate::runner::is_cloud_platform() || self.inner.config.local_only {
+            return;
+        }
+        *lock(&self.inner.peer_list.roads) = Some(roads);
+        let Ok(runtime) = tokio::runtime::Handle::try_current() else {
+            return;
+        };
+        if self.inner.peer_list.started.swap(true, Ordering::SeqCst) {
+            return;
+        }
+        lock(&self.inner.reg).keep_peer_outbox(true);
+        let (signals, signaled) = mpsc::channel(QUEUED_SIGNALS);
+        *lock(&self.inner.peer_list.signals) = Some(signals);
+        runtime.spawn(send_task(
+            Arc::downgrade(&self.inner),
+            self.inner.changed_tx.subscribe(),
+            signaled,
+        ));
+    }
+
+    /// [`methods::PEER_LIST_OPS`]: `{ops}` another of the person's devices
+    /// sent straight from it → `{taken}`. Refused unless
+    /// [`crate::direct_peer`] admits the caller, on a Cloud machine, past the
+    /// caller's allowance of calls, or with more ops than a device sends at
+    /// once.
+    pub fn take_peer_list_ops(&self, params: serde_json::Value) -> Result<RpcReply, RpcError> {
+        let refused = |why: &str| -> Result<RpcReply, RpcError> {
+            Err(RpcError::Failed(format!("list changes refused: {why}")))
+        };
+        // A Cloud machine's list is cut to its reach: what peers send isn't.
+        if crate::runner::is_cloud_platform() {
+            return refused("a Cloud machine takes them from the room alone");
+        }
+        let from = match self.direct_peer(None) {
+            Ok(from) => from,
+            Err(RpcError::Failed(why)) => return refused(&why),
+            Err(other) => return Err(other),
+        };
+        let allowed = lock(&self.inner.peer_list.budgets)
+            .entry(from.clone())
+            .or_insert_with(|| CallBudget::new(Instant::now()))
+            .take(Instant::now());
+        if !allowed {
+            return refused("more calls than a device makes");
+        }
+        // It just called: alive, whatever it carries (`peer_presence`).
+        self.note_peer_presence(&from);
+        // Counted before anything is read into ops.
+        let raw = match params.get("ops") {
+            Some(serde_json::Value::Array(raw)) => raw,
+            _ => return Err(RpcError::BadParams("`ops` is a list".into())),
+        };
+        let sent = raw.len();
+        if sent > OPS_PER_CALL {
+            return refused("more in one call than a device sends");
+        }
+        let ops: Vec<RowOp> = raw
+            .iter()
+            .filter(|op| room_takes_its_shape(op))
+            .filter_map(|op| serde_json::from_value(op.clone()).ok())
+            .collect();
+        let taken = lock(&self.inner.reg).apply_peer_ops(&from, ops);
+        if taken > 0 {
+            self.inner.bump_changed();
+        }
+        tracing::debug!(device = %from, sent, taken, "list changes taken straight from another device");
+        RpcReply::value(&serde_json::json!({ "taken": taken }))
+    }
+
+    /// The devices this one sends its list changes to now: those it may
+    /// reach (crate::direct_peer) that take them, not known to be offline.
+    fn peer_list_targets(&self) -> Vec<String> {
+        self.reachable_peers()
+            .into_iter()
+            .filter(|d| d.supports(zeron_proto::capabilities::REGISTRY_PEER_V1))
+            .filter(|d| !matches!(self.peer_liveness(&d.id), zeron_rpc::PeerLiveness::Dark))
+            .map(|d| d.id)
+            .collect()
+    }
+
+    /// Whether this device may still send to `device` (crate::direct_peer).
+    fn still_reachable(&self, device: &str) -> bool {
+        self.reachable_peers().iter().any(|d| d.id == device)
+    }
+
+    /// Test seam: the registry's sync cursor (the last room seq applied).
+    #[doc(hidden)]
+    pub fn registry_cursor(&self) -> u64 {
+        self.read(|doc| doc.cursor())
+    }
+
+    /// Test seam: every registry row as this device shows it, tombstones
+    /// included, by kind and id.
+    #[doc(hidden)]
+    pub fn registry_rows(&self) -> Vec<zeron_doc::RegistryRow> {
+        self.read(|doc| doc.shown_rows())
+    }
+
+    /// Test seam: forget the other devices' list changes shown here, as a
+    /// restart does (they're kept in memory alone).
+    #[doc(hidden)]
+    pub fn forget_peer_list_ops(&self) {
+        lock(&self.inner.reg).forget_peer_ops();
+        self.inner.bump_changed();
+    }
+}
+
+/// One device's sends, in order.
+struct Peer {
+    queue: mpsc::Sender<Vec<RowOp>>,
+    /// It may have missed some: send it the whole pending queue first.
+    missed: Arc<AtomicBool>,
+}
+
+/// Hands this device's list changes to each peer's sender as they're made,
+/// calls each peer on every beat, and drops unconfirmed peer ops once
+/// they're old.
+async fn send_task(
+    weak: Weak<WorkspaceHostInner>,
+    mut changed: watch::Receiver<u64>,
+    mut signals: mpsc::Receiver<Signal>,
+) {
+    let mut peers: HashMap<String, Peer> = HashMap::new();
+    let mut sweep = tokio::time::interval(EXPIRE_EVERY);
+    sweep.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        tokio::select! {
+            change = changed.changed() => {
+                if change.is_err() {
+                    return;
+                }
+                let Some(host) = WeakWorkspaceHost(weak.clone()).upgrade() else { return };
+                let outbox = lock(&host.inner.reg).take_peer_outbox();
+                if outbox.ops.is_empty() && !outbox.missed {
+                    continue;
+                }
+                let targets = host.peer_list_targets();
+                drop(host);
+                for (device, peer) in &peers {
+                    if !targets.contains(device) {
+                        peer.missed.store(true, Ordering::SeqCst);
+                    }
+                }
+                for device in targets {
+                    let peer = peers
+                        .entry(device.clone())
+                        .or_insert_with(|| spawn_peer(weak.clone(), device));
+                    if outbox.missed {
+                        peer.missed.store(true, Ordering::SeqCst);
+                    }
+                    if peer.queue.try_send(outbox.ops.clone()).is_err() {
+                        peer.missed.store(true, Ordering::SeqCst);
+                    }
+                }
+            }
+            signal = signals.recv() => {
+                let Some(signal) = signal else { return };
+                let Some(host) = WeakWorkspaceHost(weak.clone()).upgrade() else { return };
+                let targets = host.peer_list_targets();
+                drop(host);
+                for (device, peer) in &peers {
+                    if !targets.contains(device) {
+                        peer.missed.store(true, Ordering::SeqCst);
+                    }
+                }
+                for device in targets {
+                    let back = matches!(&signal, Signal::Back(which) if *which == device);
+                    if !back && !matches!(signal, Signal::Beat) {
+                        continue;
+                    }
+                    let peer = peers
+                        .entry(device.clone())
+                        .or_insert_with(|| spawn_peer(weak.clone(), device));
+                    if back {
+                        peer.missed.store(true, Ordering::SeqCst);
+                    }
+                    // Nothing new: a beat. A full queue is calls under way,
+                    // as good as one.
+                    let _ = peer.queue.try_send(Vec::new());
+                }
+            }
+            _ = sweep.tick() => {
+                let Some(host) = WeakWorkspaceHost(weak.clone()).upgrade() else { return };
+                let room_up = host.connected() && host.registry_synced();
+                let dropped = lock(&host.inner.reg).expire_peer_ops(expiry_cutoff(now_ms(), room_up));
+                if dropped > 0 {
+                    if room_up {
+                        tracing::info!(dropped, "list changes from another device the room never confirmed; the room's rows stand");
+                    } else {
+                        tracing::info!(dropped, "list changes from another device kept through a long outage expired");
+                    }
+                    host.inner.bump_changed();
+                }
+            }
+        }
+    }
+}
+
+/// The room refuses a delete that carries `set` at all, even `null`
+/// (`validateOp`: `op.set !== undefined`), which a typed op can't tell from
+/// none: such an op is never taken.
+fn room_takes_its_shape(op: &serde_json::Value) -> bool {
+    !(op.get("op").and_then(serde_json::Value::as_str) == Some("delete") && op.get("set").is_some())
+}
+
+fn spawn_peer(weak: Weak<WorkspaceHostInner>, device: String) -> Peer {
+    let (queue, sends) = mpsc::channel(QUEUED_SENDS);
+    // Nothing sent to it yet: it may have missed what's pending.
+    let missed = Arc::new(AtomicBool::new(true));
+    tokio::spawn(peer_task(weak, device, sends, missed.clone()));
+    Peer { queue, missed }
+}
+
+/// Sends one device its list changes, in the order made (an empty send is a
+/// beat: a call that carries nothing).
+async fn peer_task(
+    weak: Weak<WorkspaceHostInner>,
+    device: String,
+    mut sends: mpsc::Receiver<Vec<RowOp>>,
+    missed: Arc<AtomicBool>,
+) {
+    while let Some(mut ops) = sends.recv().await {
+        let Some(host) = WeakWorkspaceHost(weak.clone()).upgrade() else { return };
+        // Removed or revoked since it was queued: nothing goes, and it's
+        // owed the whole queue should it ever be back.
+        if !host.still_reachable(&device) {
+            missed.store(true, Ordering::SeqCst);
+            continue;
+        }
+        let roads = lock(&host.inner.peer_list.roads).clone();
+        drop(host);
+        let Some(roads) = roads else {
+            missed.store(true, Ordering::SeqCst);
+            continue;
+        };
+        let Some(road) = roads.proven(&device, std::time::Duration::ZERO).await else {
+            missed.store(true, Ordering::SeqCst);
+            continue;
+        };
+        if missed.swap(false, Ordering::SeqCst) {
+            let Some(inner) = weak.upgrade() else { return };
+            let mut all = lock(&inner.reg).own_pending_ops();
+            all.extend(ops);
+            ops = all;
+        }
+        while let Ok(more) = sends.try_recv() {
+            ops.extend(more);
+        }
+        match send(&road, &ops).await {
+            Ok(()) => tracing::debug!(
+                device,
+                ops = ops.len(),
+                "list changes sent straight to another device"
+            ),
+            Err(error) => {
+                missed.store(true, Ordering::SeqCst);
+                if matches!(error, RpcError::Transport(_) | RpcError::Closed) {
+                    roads.suspect(&device, road.kind);
+                }
+                if ops.is_empty() {
+                    tracing::debug!(device, %error, "a beat didn't reach another device directly");
+                } else {
+                    tracing::info!(device, %error, "list changes didn't reach another device directly; the room carries them");
+                }
+            }
+        }
+    }
+}
+
+/// `ops` in calls of at most [`OPS_PER_CALL`]; none, one empty call.
+async fn send(road: &Road, ops: &[RowOp]) -> Result<(), RpcError> {
+    let chunks: Vec<&[RowOp]> = if ops.is_empty() {
+        vec![ops]
+    } else {
+        ops.chunks(OPS_PER_CALL).collect()
+    };
+    for chunk in chunks {
+        let call = road
+            .client
+            .call(methods::PEER_LIST_OPS, serde_json::json!({ "ops": chunk }));
+        match tokio::time::timeout(SEND_TIMEOUT, call).await {
+            Ok(Ok(_)) => {}
+            Ok(Err(error)) => return Err(error),
+            Err(_) => return Err(RpcError::Transport("no answer in time".into())),
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_device_gets_a_burst_of_calls_then_a_few_a_second() {
+        let start = Instant::now();
+        let mut budget = CallBudget::new(start);
+        for call in 0..32 {
+            assert!(budget.take(start), "call {call} of the burst");
+        }
+        assert!(!budget.take(start), "past the burst");
+        assert!(!budget.take(start + Duration::from_millis(200)), "under one call earned");
+        assert!(budget.take(start + Duration::from_millis(250)), "one earned in a quarter second");
+        assert!(!budget.take(start + Duration::from_millis(250)));
+        // Quiet a long while: the burst again, no more.
+        let later = start + Duration::from_secs(3600);
+        for _ in 0..32 {
+            assert!(budget.take(later));
+        }
+        assert!(!budget.take(later));
+    }
+
+    #[test]
+    fn a_delete_carrying_set_even_null_is_never_taken() {
+        let delete = |set: Option<serde_json::Value>| {
+            let mut op = serde_json::json!({ "kind": "chats", "id": "c", "op": "delete", "hlc": "x" });
+            if let Some(set) = set {
+                op["set"] = set;
+            }
+            op
+        };
+        assert!(room_takes_its_shape(&delete(None)));
+        assert!(!room_takes_its_shape(&delete(Some(serde_json::Value::Null))));
+        assert!(!room_takes_its_shape(&delete(Some(serde_json::json!({})))));
+        assert!(room_takes_its_shape(
+            &serde_json::json!({ "kind": "chats", "id": "c", "op": "upsert", "set": {}, "hlc": "x" })
+        ));
+    }
+
+    #[test]
+    fn unconfirmed_peer_ops_expire_by_wall_time_while_the_room_is_down_too() {
+        let now = 1_800_000_000_000;
+        assert_eq!(
+            expiry_cutoff(now, true),
+            now - 10 * 60 * 1000,
+            "ten minutes with the room up"
+        );
+        assert_eq!(
+            expiry_cutoff(now, false),
+            now - 6 * 60 * 60 * 1000,
+            "six hours with it down"
+        );
+    }
+}
diff --git a/crates/engine/src/workspace_host/peer_presence.rs b/crates/engine/src/workspace_host/peer_presence.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2fe28d94e0ee23bcb106cebf5e8a88fa13c78d60
--- /dev/null
+++ b/crates/engine/src/workspace_host/peer_presence.rs
@@ -0,0 +1,106 @@
+//! Who's online, heard straight from the person's other computers, so it's
+//! known while the edge is down (docs/registry-sync.md, "Peer overlay").
+//!
+//! Every presence beat, this device calls each of its peers on a road that
+//! proved it (`peer_list`); a peer takes any such call as "alive now", by its
+//! own clock (never the sender's), and folds that into the same
+//! freshest-heard cache the room's presence and the relay probe feed. That
+//! cache is what the device list's `lastSeenAt` (the online dot) and the
+//! dial gate read. It never touches the room's live presence map, which
+//! alone feeds the deaf-socket tripwire: a device heard only directly can't
+//! hide a room socket that stopped hearing anyone.
+//!
+//! A device that stops beating ages out of the window like any other: no
+//! "offline" message, and a link closing says nothing (a road can flap).
+//!
+//! Only a caller [`crate::direct_peer`] admits gets here (`peer_list`): a
+//! removed or revoked device's beats count for nothing.
+
+use super::{WorkspaceHost, lock};
+use crate::now_ms;
+
+impl WorkspaceHost {
+    /// `device`, proven by its link, just called this one directly: it's
+    /// alive now. When it had gone quiet for a whole window, it's sent the
+    /// list changes it may have missed.
+    pub(super) fn note_peer_presence(&self, device: &str) {
+        let now = now_ms();
+        let fresh = self.inner.presence_fresh_ms();
+        let heard = {
+            let mut seen = lock(&self.inner.presence_seen);
+            let heard = seen.get(device).copied();
+            seen.insert(device.to_owned(), heard.map_or(now, |ms| ms.max(now)));
+            heard
+        };
+        self.inner.publish_presence();
+        if heard.is_none_or(|ms| now.saturating_sub(ms) >= fresh) {
+            self.inner.peer_list.came_back(device);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use zeron_proto::Device;
+    use zeron_sync::DocsStore;
+
+    use super::super::WorkspaceHostConfig;
+    use super::*;
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_peer_heard_directly_shows_online_but_never_quiets_the_deaf_room_tripwire() {
+        let server = zeron_sync::registry::mock_server::MockRegistryServer::start().await;
+        let dir = tempfile::tempdir().unwrap();
+        let host = WorkspaceHost::open(
+            Arc::new(DocsStore::open(dir.path()).unwrap()),
+            WorkspaceHostConfig {
+                device_id: "laptop".into(),
+                device_name: "Laptop".into(),
+                platform: "macos".into(),
+                org_id: "test-org".into(),
+                user_id: "test-user".into(),
+                edge: None,
+                local_only: false,
+            },
+        )
+        .unwrap();
+        host.upsert_device_row(&Device {
+            id: "desktop".into(),
+            name: "Desktop".into(),
+            platform: "windows".into(),
+            last_seen_at: None,
+            created_at: None,
+            version: None,
+            cursor_sdk_version: None,
+            capabilities: Vec::new(),
+        });
+        host.connect_registry_url(&server.url());
+        let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(10);
+        while !host.connected() {
+            assert!(tokio::time::Instant::now() < deadline, "joined the room");
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+        }
+        // The room once heard a peer live; now it hears no one.
+        lock(&host.inner.presence_watch).armed = true;
+
+        host.note_peer_presence("desktop");
+
+        let seen = host
+            .watch_devices()
+            .borrow()
+            .iter()
+            .find(|d| d.id == "desktop")
+            .and_then(|d| d.last_seen_at)
+            .expect("the desktop was seen");
+        assert!(
+            now_ms() - seen.timestamp_millis() < 5_000,
+            "the desktop shows online"
+        );
+        assert!(
+            lock(&host.inner.presence_watch).probed,
+            "the room is probed all the same: a peer heard directly isn't the room hearing it"
+        );
+    }
+}
diff --git a/crates/engine/tests/peer_list_offline.rs b/crates/engine/tests/peer_list_offline.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b5cdc991c272d591e9af64132543f6532ef3f8e8
--- /dev/null
+++ b/crates/engine/tests/peer_list_offline.rs
@@ -0,0 +1,567 @@
+//! The list and who's online keep working while the edge is down (ticket
+//! 08): with the edge rooms cut, list changes and presence go straight
+//! between two of the person's computers; the RegistryRoom gets every
+//! outage change with its original clock once it's back; a device that went
+//! offline shows offline within the presence window; an update to a row a
+//! device knows only through a peer is never lost; and a peer that comes
+//! back (its link, or its beats after a silence) is sent what it missed
+//! without waiting for the next write. A device removed from the list is
+//! neither heard from nor sent anything.
+
+#[path = "support/direct.rs"]
+mod direct;
+#[path = "support/edge.rs"]
+mod edge;
+#[path = "support/engines.rs"]
+mod engines;
+#[path = "support/gate.rs"]
+mod gate;
+#[path = "support/logs.rs"]
+mod logs;
+#[path = "support/proven.rs"]
+mod proven;
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use engines::{Engines, serial, wait_until};
+use zeron_doc::RegistryRow;
+use zeron_engine::EngineCore;
+use zeron_engine::direct_rpc::{self, Pairing as _};
+use zeron_rpc::{RpcService, methods};
+
+/// The short presence timing (ticket 00): a beat every 200 ms, alive for 2 s.
+const BEAT: Duration = Duration::from_millis(200);
+const WINDOW: Duration = Duration::from_secs(2);
+
+fn now_ms() -> i64 {
+    chrono::Utc::now().timestamp_millis()
+}
+
+/// Two engines with proven direct links both ways, the short presence
+/// timing, joined to the room and showing just its rows.
+async fn proven_engines(name: &str) -> (Engines, direct::DirectPairing) {
+    let engines = Engines::start(name).await;
+    let pairing = proven::pair_proven(&engines.a, &engines.b);
+    pairing.set_up();
+    for core in [&engines.a, &engines.b] {
+        core.workspace.set_presence_timing(BEAT, WINDOW);
+    }
+    wait_until(
+        Duration::from_secs(30),
+        "both engines joined the room and show its rows",
+        || {
+            [&engines.a, &engines.b]
+                .iter()
+                .all(|core| core.workspace.connected() && core.workspace.registry_synced() && shows_the_room(&engines, core))
+        },
+    )
+    .await;
+    (engines, pairing)
+}
+
+/// `core` shows exactly the room's rows: nothing of its own waiting, nothing
+/// of a peer's the room hasn't got.
+fn shows_the_room(engines: &Engines, core: &EngineCore) -> bool {
+    core.workspace.registry_rows() == engines.edge.registry.rows()
+}
+
+/// Neither engine reaches the room.
+async fn both_off_the_room(engines: &Engines) {
+    wait_until(
+        Duration::from_secs(20),
+        "both engines lost the room",
+        || !engines.a.workspace.connected() && !engines.b.workspace.connected(),
+    )
+    .await;
+}
+
+fn lists_chat(core: &EngineCore, chat: &str) -> bool {
+    core.workspace
+        .watch_chats()
+        .borrow()
+        .iter()
+        .any(|c| c.id == chat)
+}
+
+fn title(core: &EngineCore, chat: &str) -> Option<String> {
+    core.workspace
+        .chat(chat)
+        .ok()
+        .flatten()
+        .and_then(|c| c.title)
+}
+
+fn archived(core: &EngineCore, chat: &str) -> bool {
+    core.workspace
+        .chat(chat)
+        .ok()
+        .flatten()
+        .is_some_and(|c| c.archived)
+}
+
+fn room_title(engines: &Engines, chat: &str) -> Option<String> {
+    engines
+        .edge
+        .registry
+        .row("chats", chat)
+        .and_then(|row| row.fields.get("title")?.as_str().map(str::to_owned))
+}
+
+/// `core`'s device list shows `device` online: seen within the window.
+fn shows_online(core: &EngineCore, device: &str) -> bool {
+    core.workspace
+        .watch_devices()
+        .borrow()
+        .iter()
+        .find(|d| d.id == device)
+        .and_then(|d| d.last_seen_at)
+        .is_some_and(|seen| now_ms() - seen.timestamp_millis() < WINDOW.as_millis() as i64)
+}
+
+fn row(rows: &[RegistryRow], kind: &str, id: &str) -> RegistryRow {
+    rows.iter()
+        .find(|r| r.kind == kind && r.id == id)
+        .cloned()
+        .unwrap_or_else(|| panic!("no {kind}/{id}"))
+}
+
+/// With every edge room cut: A renames and archives a chat both had, and
+/// makes a new one; B makes one too. Waits until each shows the other's.
+async fn change_both_while_cut(engines: &Engines) {
+    let (a, b) = (&engines.a.workspace, &engines.b.workspace);
+    a.create_chat("chat-before", None, Some(&engines.a_id), None, None)
+        .expect("create on A");
+    wait_until(
+        Duration::from_secs(20),
+        "the room and B have A's chat",
+        || {
+            engines.edge.registry.row("chats", "chat-before").is_some()
+                && lists_chat(&engines.b, "chat-before")
+                && shows_the_room(engines, &engines.a)
+        },
+    )
+    .await;
+
+    engines.gate.cut();
+    both_off_the_room(engines).await;
+    assert!(
+        a.rename_chat("chat-before", "Renamed while cut")
+            .expect("rename")
+    );
+    assert!(a.set_chat_archived("chat-before", true).expect("archive"));
+    a.create_chat("chat-during", None, Some(&engines.a_id), None, None)
+        .expect("create on A");
+    b.create_chat("chat-from-b", None, Some(&engines.b_id), None, None)
+        .expect("create on B");
+    wait_until(
+        Duration::from_secs(20),
+        "each engine shows the other's changes",
+        || {
+            title(&engines.b, "chat-before").as_deref() == Some("Renamed while cut")
+                && archived(&engines.b, "chat-before")
+                && lists_chat(&engines.b, "chat-during")
+                && lists_chat(&engines.a, "chat-from-b")
+        },
+    )
+    .await;
+    let registry = &engines.edge.registry;
+    assert!(
+        registry.row("chats", "chat-during").is_none(),
+        "not through the room"
+    );
+    assert!(
+        registry.row("chats", "chat-from-b").is_none(),
+        "not through the room"
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn with_the_edge_rooms_cut_list_changes_cross_and_each_engine_shows_the_other_online() {
+    let _serial = serial().await;
+    let (engines, _pairing) = proven_engines("offline-cut").await;
+    change_both_while_cut(&engines).await;
+
+    wait_until(
+        Duration::from_secs(10),
+        "each shows the other online",
+        || shows_online(&engines.a, &engines.b_id) && shows_online(&engines.b, &engines.a_id),
+    )
+    .await;
+    // And keeps doing so for three windows with no edge at all.
+    let checks = (3 * WINDOW.as_millis() / BEAT.as_millis()) as usize;
+    for _ in 0..checks {
+        tokio::time::sleep(BEAT).await;
+        assert!(shows_online(&engines.a, &engines.b_id), "A lost B");
+        assert!(shows_online(&engines.b, &engines.a_id), "B lost A");
+    }
+    assert!(engines.gate.is_cut());
+
+    engines.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn when_the_edge_rooms_come_back_the_room_gets_every_outage_change_with_its_clock() {
+    let _serial = serial().await;
+    let (engines, _pairing) = proven_engines("offline-back").await;
+    change_both_while_cut(&engines).await;
+    // The clocks each change was written at, as the other engine shows them.
+    let on_b = engines.b.workspace.registry_rows();
+    let on_a = engines.a.workspace.registry_rows();
+    let before = row(&on_b, "chats", "chat-before");
+    let during = row(&on_b, "chats", "chat-during");
+    let from_b = row(&on_a, "chats", "chat-from-b");
+
+    engines.gate.restore();
+    zeron_sync::wake::notify_online();
+    let registry = &engines.edge.registry;
+    wait_until(
+        Duration::from_secs(30),
+        "the room, A and B hold the same rows",
+        || {
+            let room = registry.rows();
+            room.iter().any(|r| r.id == "chat-during")
+                && room.iter().any(|r| r.id == "chat-from-b")
+                && engines.a.workspace.registry_rows() == room
+                && engines.b.workspace.registry_rows() == room
+        },
+    )
+    .await;
+
+    let room = registry.rows();
+    let now = row(&room, "chats", "chat-before");
+    assert_eq!(now.fields["title"], "Renamed while cut");
+    assert_eq!(now.fields["archived"], true);
+    for field in ["title", "archived"] {
+        assert_eq!(now.clocks[field], before.clocks[field], "{field}'s clock");
+    }
+    assert_eq!(row(&room, "chats", "chat-during").clocks, during.clocks);
+    assert_eq!(row(&room, "chats", "chat-from-b").clocks, from_b.clocks);
+
+    engines.shutdown().await;
+}
