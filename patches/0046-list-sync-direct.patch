+
+    let refused = link.call(methods::PEER_LIST_OPS, ops(401)).await;
+    assert!(refused.is_err(), "401 ops in one call: {refused:?}");
+    assert!(engines.b.workspace.chat("flood-0").expect("read").is_none());
+    let taken = link
+        .call(methods::PEER_LIST_OPS, ops(400))
