+/// The presence path alone: A's link to B never fails and A writes nothing,
+/// so nothing but B's beats returning after a silence tells A to resend.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_peer_whose_beats_return_after_a_silence_is_sent_what_it_missed() {
