+        doc.apply_peer_ops("dev-a", vec![create.clone()]);
+        assert!(doc.rename_chat("chat-1", "renamed").expect("rename"));
+        assert!(doc.take_pushable().is_empty());
+
+        // Saved whole, or as a delta after a whole save: the peer's ops are
+        // gone after the load, the hold isn't.
+        let whole = doc.to_bytes().expect("save");
+        let mut loaded = RegistryDoc::from_bytes(&whole, "dev-me").expect("load");
+        assert_eq!(loaded.peer_ops_len(), 0);
+        assert!(loaded.take_pushable().is_empty(), "still waits for the room's row");
+        assert!(loaded.apply_rows(1, vec![room_row(std::slice::from_ref(&create), 1)]));
+        assert_eq!(loaded.take_pushable().len(), 1, "the room's row ends it");
+
+        let base = RegistryDoc::new("dev-me").to_bytes().expect("save");
+        let delta = doc.delta_bytes().expect("delta").expect("a delta");
+        let (mut loaded, clean) = RegistryDoc::from_saved(&base, &[delta], &[], "dev-me").expect("load");
+        assert!(clean);
+        assert!(loaded.take_pushable().is_empty(), "still waits for the room's row");
+    }
