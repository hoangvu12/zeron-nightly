new file mode 100644
index 0000000000000000000000000000000000000000..4c77c75d50c8b2e4e0014369a4212b6c2c9af432
--- /dev/null
+++ b/crates/engine/tests/support/proven.rs
@@ -0,0 +1,65 @@
+//! A stand-in direct pairing whose far end checks the caller's signed hello
+//! against the account's keys, as a real host does (Phase A:
+//! `direct_rpc::Service::proving`, `device_proof`).
+//!
+//! [`trust_each_other`] gives each engine a signing key and writes every
+//! engine's key into each one's saved copy of the account's keys
+//! (`<data>/device-keys.json`), so each engine's real verifier
+//! (`Plugins::device_verifier`) accepts the others' real proofs
+//! (`Plugins::device_link_prover`, which the roads use as a link opens).
+//! [`pair_proven`] then wires links both ways (the rig in `direct.rs`) whose
+//! calls, once the link proved its caller, are served as that device's
+//! (`Caller::Peer{device: Some(..)}`). Needs `direct.rs` beside it.
+
+#![allow(dead_code)]
+
+use zeron_engine::EngineCore;
+use zeron_engine::plugins::keys::KeyRow;
+use zeron_engine::plugins::signing;
+
+use super::direct::{DirectPairing, Proof, key_row};
+
+/// `core`'s data folder (its plugins live in `<data>/plugins`).
+fn data_dir(core: &EngineCore) -> std::path::PathBuf {
+    core.plugins
+        .plugins_dir()
+        .parent()
+        .expect("the data folder")
+        .to_owned()
+}
+
+/// The account the engines' keys are registered to.
+pub const ACCOUNT: &str = "direct-transport-account";
+
+/// Give each engine a signing key, and each one a saved copy of the
+/// account's keys listing all of them, so each proves itself to the others.
+pub fn trust_each_other(engines: &[&EngineCore]) {
+    let rows: Vec<KeyRow> = engines
+        .iter()
+        .map(|core| {
+            let key = signing::load_or_create_key(&data_dir(core)).expect("signing key").public();
+            key_row(&core.device_id, key)
+        })
+        .collect();
+    let copy = serde_json::json!({
+        "account": ACCOUNT,
+        "rows": rows,
+        "read_at": chrono::Utc::now().timestamp_millis(),
+    });
+    for core in engines {
+        std::fs::write(
+            data_dir(core).join(zeron_engine::device_proof::FILE),
+            serde_json::to_vec(&copy).expect("keys json"),
+        )
+        .expect("write the account's keys");
+        core.plugins.set_account(|| Some(ACCOUNT.to_owned()));
+    }
+}
+
+/// Proven direct links both ways between `a` and `b` (made to trust each
+/// other: [`trust_each_other`]), down until `set_up`. Each engine's roads
+/// take its rig; their rows come from their own boot, through the room.
+pub fn pair_proven(a: &EngineCore, b: &EngineCore) -> DirectPairing {
+    trust_each_other(&[a, b]);
+    super::direct::pair(a, b, Proof::AccountKeys)
+}
