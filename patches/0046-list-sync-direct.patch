+            (KIND_DEVICES.into(), "dev-me".into()),
+            vec![PeerOp {
+                op: theirs,
+                received_ms: 0,
+                arrival: 0,
+            }],
+        );
+        for _ in 0..3 {
+            assert!(doc.set_device_endpoints("dev-me", &mine));
+        }
