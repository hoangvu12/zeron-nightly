+        .await
+        .expect("A proves itself");
+    let ops = |count: usize| {
+        let ms = now_ms();
+        let ops: Vec<serde_json::Value> = (0..count)
+            .map(|i| {
+                serde_json::json!({
+                    "kind": "chats",
+                    "id": format!("flood-{i}"),
+                    "op": "upsert",
+                    "set": { "id": format!("flood-{i}"), "deviceId": a_id, "title": "Flood" },
+                    "hlc": format!("{ms:013}-000000-{a_id}"),
+                })
