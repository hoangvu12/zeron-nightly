+	-- The one alone: under its group's line, its row in the tree.
+	app:click('role:button "Ran a subagent"')
+	app:frames(40)
+	expect(app:has('role:button "Open find the flaky test" >> "Failed"')).to_be(true)
+	app:click('role:button "Open find the flaky test"')
+	app:frames(5)
+	expect(app:state("calls")).to_contain(":doc--sub--n3")
+	expect(app:error()).to_be(nil)
+end)
+
+test("the Running tray lists the chat's Zeron children: asking first with Answer, the finished folded", function()
+	local app = open("children_listed")
+	-- Two running and one asking count as under way.
+	expect(app:has('role:button "Open Subagents"')).to_be(true)
+	app:click('role:button "Open Subagents"')
+	app:frames(30)
+	expect(shown(app, "Open Write the session migration")).to_be(true)
+	expect(shown(app, "Answer Write the session migration")).to_be(true)
+	expect(shown(app, "Open zeron-sync")).to_be(true)
+	expect(shown(app, "Open zeron-engine")).to_be(true)
+	-- Asking above those working.
+	local tree = app:tree()
+	expect(at(tree, 'button "Open Write the session migration"') < at(tree, 'button "Open zeron-sync"')).to_be(true)
+	-- No row says what its chat said: that's a report's.
+	expect(app:has(".subagent-row-preview")).to_be(false)
+	-- The two that ended fold behind one row; a side chat at rest is the
+	-- person's own, not running.
+	expect(app:has('role:button "Show 2 finished"')).to_be(true)
+	expect(app:has('role:button "Open My own side chat"')).to_be(false)
+	app:click('role:button "Show 2 finished"')
+	app:frames(30)
+	expect(shown(app, "Open Fix flaky login tests")).to_be(true)
+	-- A row opens its chat beside this one.
+	app:click('role:button "Open zeron-sync"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "zeron-sync")).to_be(1)
+	expect(app:error()).to_be(nil)
+end)
