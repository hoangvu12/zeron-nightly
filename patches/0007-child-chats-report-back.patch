+    #[test]
+    fn a_zeron_create_chats_call_is_a_spawn_of_the_chats_it_made() {
+        let call = |tool: &str, input: Json, output: Option<&str>| {
+            let mut part = json!({ "id": "c1", "kind": "tool", "call": { "kind": "mcp", "server": "zeron", "tool": tool, "input": input } });
+            if let Some(output) = output {
+                part["output"] = json!(output);
+            }
+            part
+        };
+        let field = |v: &Value, k: &str| v.field(k).map(text);
+        // Asked, not answered yet: each request a row, by its title or the
+        // first line of its prompt, with no chat to open yet.
+        let input = json!({ "requests": [
+            { "title": "zeron-sync", "prompt": "Look for unwraps", "kind": "subagent" },
+            { "prompt": "\nAudit zeron-harness for unwrap() on input from peers, then fix them" },
+        ] });
+        let asked = call("create_chats", input.clone(), None);
+        let made = zeron_spawned(&asked).unwrap();
+        assert_eq!(made.len(), 2);
+        assert_eq!(field(&made[0], "title").as_deref(), Some("zeron-sync"));
+        assert_eq!(field(&made[0], "kind").as_deref(), Some("subagent"));
+        assert!(made[0].field("chat").is_none_or(|c| matches!(c, Value::Nil)));
+        assert_eq!(field(&made[1], "title").as_deref(), Some("Audit zeron-harness for unwrap() on inpu…"));
+        // Answered: each made chat by its index; one that failed says so.
+        let output = json!({ "results": [
+            { "index": 1, "isError": true, "error": "no such model" },
+            { "index": 0, "isError": false, "result": { "chatId": "kid-1", "kind": "subagent", "title": "zeron-sync" } },
+        ] })
+        .to_string();
+        let answered = call("create_chats", input, Some(&output));
+        let made = zeron_spawned(&answered).unwrap();
+        assert_eq!(field(&made[0], "chat").as_deref(), Some("kid-1"));
+        assert!(made[0].field("failed").is_none());
+        assert!(made[1].field("chat").is_none_or(|c| matches!(c, Value::Nil)));
+        assert!(matches!(made[1].field("failed"), Some(Value::Bool(true))));
+        // One chat: its own answer.
+        let one = call("create_chat", json!({ "prompt": "Write the migration", "kind": "side" }), Some(r#"{"chatId":"kid-2","kind":"side","title":null}"#));
+        let made = zeron_spawned(&one).unwrap();
+        assert_eq!(field(&made[0], "chat").as_deref(), Some("kid-2"));
+        assert_eq!(field(&made[0], "kind").as_deref(), Some("side"));
+        assert_eq!(field(&made[0], "title").as_deref(), Some("Write the migration"));
+        // Its row carries them, and its group is a spawn of its own, apart
+        // from the tools around it.
+        let row = tool(&one).unwrap();
+        assert!(matches!(row.field("spawned"), Some(Value::List(l)) if l.len() == 1));
+        let read = json!({ "id": "r1", "kind": "tool", "call": { "kind": "readFile", "path": "a.rs" } });
+        let entry = json!({ "id": "a", "role": "assistant", "parts": [read, one] });
+        let Value::List(shown) = blocks(&entry) else { panic!("no blocks") };
+        assert_eq!(shown.len(), 2);
+        assert!(matches!(shown[0].field("spawn"), Some(Value::Bool(false))));
+        assert!(matches!(shown[1].field("spawn"), Some(Value::Bool(true))));
+        // Another server's tool of the same name is no spawn.
+        let theirs = json!({ "id": "x", "kind": "tool", "call": { "kind": "mcp", "server": "other", "tool": "create_chat", "input": {} } });
+        assert!(zeron_spawned(&theirs).is_none());
+    }
