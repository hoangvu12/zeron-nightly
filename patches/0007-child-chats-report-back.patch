--- /dev/null
+++ b/apps/zgx/ui/ds/spawn_group.luau
@@ -0,0 +1,535 @@
+-- Children started together, as one block in the reply that started them: a
+-- Zeron `create_chats` (or `create_chat`) call, or a harness's subagents
+-- spawned side by side. In place of a tree of calls, the children
+-- themselves, live: their marks stacked, how many stand where ("4 running ·
+-- 2 finished · 1 failed · 1 needs input"), how long it has run while any
+-- does, and under it each child's row (ds/subagent_row, compact), those
+-- asking for the person and those that failed first, then those working,
+-- then those done. A click on its head folds the list, and opens it again.
+-- Its head says what kind they are ("3 subagents", "2 side chats", "2
+-- subagents, 1 side chat"); with both kinds, each side chat's row says so.
+-- Several that reported back together are the same block (`reported`: "3
+-- subagents reported"), ds/transcript's, each row with what its child said
+-- under its title (ds/subagent_row's `preview`).
+--
+-- Its head is the card's top, flush with its border: its top corners the
+-- card's, one border in (concentric), its bottom square where the list
+-- hangs under it, and the card's own while folded, when it stands alone.
+--
+--   SpawnGroup { list = function() return kids end, since = started, on_open = … }
+
+local SubagentRow = require("@self/subagent_row")
+local AgentMark = require("@self/agent_mark")
+local People = require("@self/people")
+local Icon = require("@self/icon")
+local status = require("@self/status")
+local control = require("@self/control")
+local locale = require("@self/locale")
+
+local M = {}
+
+type Child = SubagentRow.Child
+
+export type Props = {
+	-- The children (`children` is a component's own: what's nested in it).
+	list: () -> { Child },
+	-- When the turn that started them began (`os.time()` seconds): how long
+	-- they've run, while any does.
+	since: (() -> number?)?,
+	-- A name to keep whether the reader folded it under, across it being
+	-- made again (a reload, its row scrolled back).
+	key: string?,
+	-- They reported back together, rather than started together.
+	reported: boolean?,
+	on_open: ((c: Child) -> ())?,
+	on_answer: ((c: Child) -> ())?,
+}
+
+-- Which comes first in its list, and in its counts: what needs the person,
+-- what went wrong, what's under way, then what ended.
+local ORDER: { [string]: number } = { input = 1, failed = 2, working = 3, stopped = 4, done = 5 }
+M.ORDER = ORDER
+-- Each state's count, in the order the head says them.
+local COUNTS: { { state: SubagentRow.State, key: string } } = {
+	{ state = "working", key = "ds.spawn_group.running" },
+	{ state = "done", key = "ds.spawn_group.finished" },
+	{ state = "failed", key = "ds.spawn_group.failed" },
+	{ state = "stopped", key = "ds.spawn_group.stopped" },
+	{ state = "input", key = "ds.spawn_group.needs_input" },
+}
+M.COUNTS = COUNTS
+-- How many discs its head stacks before "+N", their size, how far each
+-- tucks under the one before (two fifths: a third, as ds/people's faces,
+-- reads as two discs side by side once the gap is cut), and the gap
+-- cut round the one on top.
+local STACK, STACK_MARK = 3, 20
+local STACK_OVERLAP, STACK_GAP = math.floor(STACK_MARK * 0.4), 1.5
+-- How long its list takes to fold and open.
+local FOLD = 200
+-- Its card's corner, and the corner inside its 1-point border.
+local RADIUS = "$radius.xl"
+local INNER = ui.raw(control.nest(RADIUS, 1), "the card's corner, one border in")
+
+-- The children in the order the list shows them (stable within a state).
+function M.sorted(children: { Child }): { Child }
+	local out = table.clone(children)
+	local at: { [Child]: number } = {}
+	for i, c in out do
+		at[c] = i
+	end
+	table.sort(out, function(a: Child, b: Child): boolean
+		local x, y = ORDER[a.state] or 9, ORDER[b.state] or 9
+		if x ~= y then
+			return x < y
+		end
+		return at[a] < at[b]
+	end)
+	return out
+end
+
+-- What they are, by kind ("3 subagents", "2 side chats", "2 subagents, 1
+-- side chat"); `reported`, that they reported back ("… reported"). A
+-- harness's own subagent is a subagent.
+function M.title(children: { Child }, reported: boolean?): string
+	local subagents, sides = 0, 0
+	for _, c in children do
+		if c.kind == "side" then
+			sides += 1
+		else
+			subagents += 1
+		end
+	end
+	local what = if sides == 0
+		then locale.s("ds.spawn_group.title", { n = subagents })
+		elseif subagents == 0 then locale.s("ds.spawn_group.title_side", { n = sides })
+		else locale.s("ds.spawn_group.title_both", { subagents = locale.s("ds.spawn_group.title", { n = subagents }), sides = locale.s("ds.spawn_group.title_side", { n = sides }) })
+	return if reported then locale.s("ds.spawn_group.reported", { what = what }) else what
+end
+
+-- Whether they're of both kinds (subagents and side chats).
+function M.mixed(children: { Child }): boolean
+	local side, other = false, false
+	for _, c in children do
+		if c.kind == "side" then
+			side = true
+		else
+			other = true
+		end
+	end
+	return side and other
+end
+
+-- How many of them stand in each state.
+function M.counts(children: { Child }): { [string]: number }
+	local out: { [string]: number } = {}
+	for _, c in children do
+		out[c.state] = (out[c.state] or 0) + 1
+	end
+	return out
+end
+
+-- The counts as words, joined ("3 finished, 1 failed"), for a line with no
+-- room for dots.
+function M.count_words(children: { Child }, sep: string?): string
+	local n = M.counts(children)
+	local parts: { string } = {}
+	for _, c in COUNTS do
+		if (n[c.state] or 0) > 0 then
+			table.insert(parts, locale.s(c.key, { n = n[c.state] }))
+		end
+	end
+	return table.concat(parts, sep or " · ")
+end
+
+-- A child as its row shows it at `now`: with how long it has run (working,
+-- since it started) or ran (from its start to its last word) as its time,
+-- where its chat says when it started and it has no time of its own.
+function M.timed(c: Child, now: number): Child
+	if c.at or not c.since or c.since <= 0 then
+		return c
+	end
+	local since = c.since :: number
+	-- (At rest with no last word after its start: no time to say.)
+	local to = if c.state == "working" then now elseif c.ended and c.ended >= since then c.ended else nil
+	if not to then
+		return c
+	end
+	local out = table.clone(c)
+	out.at = status.elapsed(math.max(0, to - since))
+	return out
+end
+
+-- How long a spawn took, as its head says it at `now`: from its first
+-- child's start to its last one's last word (or now, while any works), so
+-- never less than any row's. A harness's own subagents say no times: then,
+-- while one runs, since the reply started (`since`); at rest, nothing.
+function M.span(children: { Child }, now: number, since: number?): string?
+	local from, to = math.huge, -math.huge
+	local working = false
+	for _, c in children do
+		working = working or c.state == "working"
+		if c.since and c.since > 0 then
+			local ended = if c.state == "working" then now elseif c.ended and c.ended >= c.since then c.ended else nil
+			if ended then
+				from = math.min(from, c.since)
+				to = math.max(to, ended)
+			end
+		end
+	end
+	if from < math.huge then
+		return status.elapsed(math.max(0, to - from))
+	end
+	if working and since then
+		return status.elapsed(math.max(0, now - since))
+	end
+	return nil
+end
+
+-- One child alone, its row with its time going (ds/transcript's spawn of
+-- one chat, on its card): a clock of its own, ticking while it works.
+-- `rounded`: its corner where it sits in a card's.
+M.One = ui.component(function(props: { child: () -> Child, on_open: (() -> ())?, rounded: any? }): Node
+	local now = ui.use_state(os.time())
+	ui.effect(function()
+		if props.child().state ~= "working" then
+			return
+		end
+		now:set(os.time())
+		ui.every(1000, function()
+			now:set(os.time())
+		end)
+	end)
+	return SubagentRow.SubagentRow {
+		child = function(): Child
+			return M.timed(props.child(), now:get())
+		end,
+		rounded = props.rounded,
+		on_open = props.on_open,
+	}
+end)
+
+-- The counts drawn: each state's glyph, the rows' own (ds/status), and how
+-- many, no words (they're its label, and each count's on hover).
+function M.Counts(props: { children: () -> { Child } }): Node
+	local counts = ui.computed(function(): { [string]: number }
+		return M.counts(props.children())
+	end)
+	local nodes: { Node } = {}
+	for _, c in COUNTS do
+		local function words(): string
+			return locale.s(c.key, { n = counts:get()[c.state] or 0 })
+		end
+		table.insert(
+			nodes,
+			ui.show(
+				function(): boolean
+					return (counts:get()[c.state] or 0) > 0
+				end,
+				ui.row {
+					class = `spawn-group-count spawn-group-count-{c.state}`,
+					gap = ui.raw(4, "a count's glyph to its number"),
+					items = "center",
+					shrink = 0,
+					label = words,
+					tooltip = ui.text { words },
+					status.StatusIcon { kind = c.state :: status.Kind, size = 14 },
+					ui.text {
+						function(): string
+							return tostring(counts:get()[c.state] or 0)
+						end,
+						tabular = true,
+					},
+				}
+			)
+		)
+	end
+	return ui.row {
+		min_w = 0,
+		flex_wrap = true,
+		gap = ui.raw(10, "the mockup's gap between counts"),
+		items = "center",
+		text_size = "$font.size.sm",
+		color = "$text.secondary",
+		label = function(): string
+			return M.count_words(props.children(), ", ")
+		end,
+		table.unpack(nodes),
+	}
+end
+
+-- Whether the reader folded it, kept apart from the blocks (one map).
+local FOLDED = ui.state("spawn_group_folded", {} :: { [string]: boolean })
+
+M.SpawnGroup = ui.component(function(props: Props): Node
+	local all = ui.computed(props.list)
+	local shown = ui.computed(function(): { Child }
+		return M.sorted(all:get())
+	end)
+	local by_id = ui.computed(function(): { [string]: Child }
+		local out: { [string]: Child } = {}
+		for _, c in all:get() do
+			out[c.id] = c
+		end
+		return out
+	end)
+	local counts = ui.computed(function(): { [string]: number }
+		return M.counts(all:get())
+	end)
+	local own = ui.use_state(false)
+	local key = props.key
+	local function folded(): boolean
+		return if key then FOLDED:get()[key] == true else own:get()
+	end
+	local function toggle()
+		if key then
+			local now = table.clone(FOLDED:peek())
+			now[key] = not folded() or nil
+			FOLDED:set(now)
+		else
+			own:set(not own:peek())
+		end
+	end
+	-- Its rows exist while the list is open or folding (folded away, a
+	-- selection across the reply would take words no one sees).
+	local mounted = ui.use_state(not folded())
+	local folding: (() -> ())? = nil
+	ui.effect(function()
+		local open = not folded()
+		if folding then
+			folding()
+			folding = nil
+		end
+		if open then
+			mounted:set(true)
+		elseif mounted:peek() then
+			folding = ui.after(FOLD, function()
+				folding = nil
+				mounted:set(false)
+			end)
+		end
+	end)
+	local function running(): boolean
+		return (counts:get().working or 0) > 0
+	end
+	-- One clock, ticking only while a child runs.
+	local now = ui.use_state(os.time())
+	ui.effect(function()
+		if not running() then
+			return
+		end
+		now:set(os.time())
+		ui.every(1000, function()
+			now:set(os.time())
+		end)
+	end)
+	local function title(): string
+		return M.title(all:get(), props.reported)
+	end
+	local mixed = ui.computed(function(): boolean
+		return M.mixed(all:get())
+	end)
+	-- Its children's agents as discs overlapping left to right, the first on
+	-- top: each disc after it is cut where the one before sits (and a gap
+	-- round that), ds/people's stack the other way round, so what's behind
+	-- shows through the gap, glass or not. Each agent once (two Claudes are
+	-- one Claude: the title says how many), the first few, then "+N" more
+	-- agents. (No dots: the counts beside them say how each stands.)
+	local agents = ui.computed(function(): { Child }
+		local out, seen = {}, {}
+		for _, c in all:get() do
+			local agent = c.mark or c.icon or ""
+			if not seen[agent] then
+				seen[agent] = true
+				table.insert(out, c)
+			end
+		end
+		return out
+	end)
+	local stacked = ui.computed(function(): { Child }
+		local out = {}
+		for i, c in agents:get() do
+			if i > STACK then
+				break
+			end
+			table.insert(out, c)
+		end
+		return out
+	end)
+	local behind = { x = STACK_OVERLAP - STACK_MARK / 2, r = STACK_MARK / 2 + STACK_GAP }
+	-- How many more, on a disc of its own behind the last.
+	local more_disc: { [any]: any } = {
+		shrink = 0,
+		ml = ui.raw(-STACK_OVERLAP, "discs overlap by two fifths"),
+		w = STACK_MARK,
+		h = STACK_MARK,
+		rounded = "$radius.full",
+		bg = "$zeron.secondary.hover",
+		items = "center",
+		justify = "center",
+		ui.text {
+			function(): string
+				return `+{#agents:get() - STACK}`
+			end,
+			text_size = ui.raw(9, "a count inside a disc under 24 points"),
+			weight = "$font.weight.medium",
+			tabular = true,
+			color = "$text.secondary",
+		},
+	}
+	People.cut_into(more_disc, STACK_MARK, behind)
+	local more = ui.column(more_disc)
+	local stack = ui.row {
+		shrink = 0,
+		items = "center",
+		aria_hidden = true,
+		ui.each(stacked, function(c: Child, i: number): Node
+			-- (Its agent's tile, clipped round: the tile's own ground and ink,
+			-- whatever the agent.)
+			local disc: { [any]: any } = {
+				shrink = 0,
+				ml = if i == 1 then 0 else ui.raw(-STACK_OVERLAP, "discs overlap by two fifths"),
+				w = STACK_MARK,
+				h = STACK_MARK,
+				rounded = "$radius.full",
+				overflow = "hidden",
+				AgentMark { label = c.title, mark = c.mark, icon = c.icon, size = STACK_MARK },
+			}
+			if i > 1 then
+				People.cut_into(disc, STACK_MARK, behind)
+			end
+			return ui.div(disc)
+		end, {
+			key = function(c: Child): string
+				return c.id
+			end,
+		}),
+		ui.show(function(): boolean
+			return #agents:get() > STACK
+		end, more),
+	}
+	local head: { [any]: any } = {
+		class = "spawn-group-head",
+		label = title,
+		expanded = function(): boolean
+			return not folded()
+		end,
+		selectable = false,
+		w_full = true,
+		p = "$space.3",
+		-- (A button's own corner is $radius.md: its bottom would round off
+		-- over the list.)
+		rounded_tl = INNER,
+		rounded_tr = INNER,
+		rounded_bl = function(): any
+			return if folded() then INNER else 0
+		end,
+		rounded_br = function(): any
+			return if folded() then INNER else 0
+		end,
+		gap = ui.raw(10, "the mockup's head gap"),
+		items = "center",
+		bg = "$zeron.secondary.bg",
+		hover = { bg = "$zeron.secondary.hover" },
+		active = { bg = "$zeron.secondary.hover" },
+		focus = control.ring,
+		cursor = "pointer",
+		on_click = toggle,
+		on_press = function() end,
+		on_release = function() end,
+		stack,
+		ui.text { title, shrink = 0, weight = "$font.weight.medium" },
+		ui.div { grow = 1 },
+		-- How long it took (M.span), going while any works.
+		ui.show(
+			function(): boolean
+				return M.span(all:get(), now:get(), if props.since then props.since() else nil) ~= nil
+			end,
+			ui.text {
+				function(): string
+					return M.span(all:get(), now:get(), if props.since then props.since() else nil) or ""
+				end,
+				shrink = 0,
+				tabular = true,
+				text_size = "$font.size.sm",
+				color = "$text.secondary",
+			}
+		),
+		-- How they stand, at the end beside the fold's arrow.
+		M.Counts {
+			children = function(): { Child }
+				return all:get()
+			end,
+		},
+		ui.div {
+			shrink = 0,
+			color = "$text.tertiary",
+			Icon {
+				name = function(): Icon.Name
+					return if folded() then "alt-arrow-down" else "alt-arrow-up"
+				end,
+				size = 14,
+			},
+		},
+	}
+	return ui.column {
+		class = "spawn-group",
+		role = "group",
+		label = title,
+		w_full = true,
+		rounded = RADIUS,
+		border = 1,
+		border_color = "$border.subtle",
+		overflow = "hidden",
+		ui.button(head),
+		ui.column {
+			w_full = true,
+			overflow = "hidden",
+			layout = "height",
+			layout_clip = true,
+			layout_duration = FOLD,
+			layout_ease = "outQuart",
+			max_h = function(): number
+				return if folded() then 0 else 1e6
+			end,
+			ui.show(mounted, ui.column {
+				w_full = true,
+				p = "$space.1",
+				ui.each(shown, function(c: Child): Node
+					-- (Its time off the head's clock, which ticks while any runs.)
+					local function child(): Child
+						return M.timed(by_id:get()[c.id] or c, now:get())
+					end
+					return SubagentRow.SubagentRow {
+						child = child,
+						compact = true,
+						preview = props.reported,
+						kind = function(): boolean
+							return mixed:get()
+						end,
+						on_open = if props.on_open
+							then function()
+								(props.on_open :: (Child) -> ())(child())
+							end
+							else nil,
+						on_answer = if props.on_answer
+							then function()
+								(props.on_answer :: (Child) -> ())(child())
+							end
+							else nil,
+					}
+				end, {
+					key = function(c: Child): string
+						return c.id
+					end,
+					animate = { duration = 220, ease = "outCubic" },
+				}),
+			}),
+		},
+	}
+end)
+
+return setmetatable(M, {
+	__call = function(_self: any, props: Props): Node
+		return M.SpawnGroup(props)
+	end,
+}) :: any
