+    /// A report from `child` to the lead, as its host writes it.
+    fn report_from(child: &str, status: zeron_proto::agent_messages::ReportStatus, body: &str) -> zeron_doc::SessionCommandPayload {
+        let mut request = request();
+        request.prompt = zeron_proto::agent_messages::child_report(&format!("Kid ({child})"), child, status, body);
+        zeron_doc::SessionCommandPayload::Run { request, message_id: format!("report-from-{child}-{}", body.len()) }
+    }
