+        };
+        let is = |v: Option<&Value>, want: &str| matches!(v, Some(Value::Str(s)) if s.as_ref() == want);
+        let one = child_report("Review API (cd27c5c2)", id, ReportStatus::Finished, "No breaking changes.\n\n1. Deprecate `remember`.");
+        let m = message(&said(one), None).unwrap();
+        assert!(is(m.field("role"), "report"));
+        // No bubble's sender: the report's rows say who.
