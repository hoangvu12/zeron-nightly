+/// A Zeron `create_chat` or `create_chats` call: chats this one made, each
+/// a child that works on its own and reports back.
+fn zeron_spawn_call(part: &Json) -> bool {
+    let call = &part["call"];
+    call["kind"].as_str() == Some("mcp")
+        && call["server"].as_str() == Some("zeron")
+        && matches!(call["tool"].as_str(), Some("create_chat" | "create_chats"))
+}
+
+/// The chats a Zeron `create_chat(s)` call made, as ds/spawn_group lists
+/// them: each one's chat (nil until the call answers, or where making it
+/// failed), its title (what the call named it, else its prompt's first
+/// line), its kind (`subagent`, `side`; nil when the call left it to the
+/// server) and, where it couldn't be made, `failed`. Nil for any other part.
+fn zeron_spawned(part: &Json) -> Option<Vec<Value>> {
+    if !zeron_spawn_call(part) {
+        return None;
+    }
+    let input = &part["call"]["input"];
+    let asked: Vec<&Json> = match input["requests"].as_array() {
+        Some(list) if part["call"]["tool"].as_str() == Some("create_chats") => list.iter().collect(),
+        _ => vec![input],
+    };
+    // What it answered: one chat, or each request's result by its index. (An
+    // MCP result may come as its JSON, or as the content that carries it.)
+    let answer = part["output"].as_str().and_then(|o| {
+        let parsed: Json = serde_json::from_str(o.trim()).ok()?;
+        let inner = parsed["content"][0]["text"].as_str().and_then(|t| serde_json::from_str::<Json>(t).ok());
+        Some(if parsed["structuredContent"].is_object() {
+            parsed["structuredContent"].clone()
+        } else {
+            inner.unwrap_or(parsed)
+        })
+    });
+    let result = |i: usize| -> Option<&Json> {
+        let answer = answer.as_ref()?;
+        match answer["results"].as_array() {
+            Some(results) => results.iter().find(|r| r["index"].as_u64() == Some(i as u64)).or(results.get(i)),
+            None => (i == 0).then_some(answer),
+        }
+    };
+    let made = asked
+        .iter()
+        .enumerate()
+        .map(|(i, req)| {
+            let result = result(i);
+            let failed = result.is_some_and(|r| r["isError"].as_bool() == Some(true));
+            let row = result.map(|r| if r["result"].is_object() { &r["result"] } else { r });
+            let chat = row.and_then(|r| r["chatId"].as_str()).filter(|c| !c.is_empty());
+            let title = [req["title"].as_str(), row.and_then(|r| r["title"].as_str())]
+                .into_iter()
+                .flatten()
+                .map(single_line)
+                .find(|t| !t.is_empty())
+                .or_else(|| req["prompt"].as_str().and_then(|p| p.lines().find(|l| !l.trim().is_empty())).map(|l| {
+                    let line = single_line(l);
+                    let mut short: String = line.chars().take(40).collect();
+                    if line.chars().count() > 40 {
+                        short.push('…');
+                    }
+                    short
+                }))
+                .unwrap_or_else(|| "Subagent".into());
+            let kind = row.and_then(|r| r["kind"].as_str()).or(req["kind"].as_str()).filter(|k| matches!(*k, "subagent" | "side"));
+            let mut fields = vec![
+                ("chat", chat.map_or(Value::Nil, Value::from)),
+                ("title", Value::from(title.as_str())),
+                ("kind", kind.map_or(Value::Nil, Value::from)),
+            ];
+            if failed {
+                fields.push(("failed", Value::Bool(true)));
+            }
+            Value::record(fields)
+        })
+        .collect();
+    Some(made)
+}
