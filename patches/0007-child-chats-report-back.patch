+        let Some(Value::List(reports)) = m.field("reports") else { panic!("no reports") };
+        assert_eq!(reports.len(), 1);
+        assert!(is(reports[0].field("chat"), id));
+        assert!(is(reports[0].field("title"), "Review API"));
+        assert!(is(reports[0].field("status"), "finished"));
+        assert!(is(reports[0].field("body"), "No breaking changes.\n\n1. Deprecate `remember`."));
+        // Its words for a selection, and who said them for Copy; no header.
