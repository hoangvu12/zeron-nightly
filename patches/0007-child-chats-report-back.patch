+    fn a_settled_turn_answers_the_message_sent_before_it_ended() {
+        let asked = |id: &str, at: i64, text: &str| {
+            let mut e = entry(id, MessageRole::User, vec![said(&agent_messages::agent_message("Lead (parent00)", "parent", text))]);
+            e.created_at = at;
+            e
+        };
+        let answer = |id: &str, at: i64, status: MessageStatus| {
+            let mut e = entry(id, MessageRole::Assistant, vec![said("Working on it.")]);
+            e.created_at = at;
+            e.status = Some(status);
+            e
+        };
+        // Stopped mid-answer; the parent's next message came after the Stop.
+        let mut entries = vec![asked("p1", 100, "Fix it."), answer("a1", 110, MessageStatus::Aborted), asked("p2", 300, "Rebase.")];
+        assert_eq!(request_for_turn(&entries, "parent", 200), Some(0));
+        // ...and its turn has begun, still streaming: still the first.
+        entries.push(answer("a2", 310, MessageStatus::Streaming));
+        assert_eq!(request_for_turn(&entries, "parent", 200), Some(0));
+        // Once an answer to it settles, the latest is what turns answer.
+        entries[3].status = Some(MessageStatus::Complete);
+        assert_eq!(request_for_turn(&entries, "parent", 400), Some(2));
+        // Stopped before it wrote anything: the message it was on.
+        let entries = vec![asked("p1", 100, "Fix it."), answer("a1", 110, MessageStatus::Complete), asked("p2", 150, "Also this.")];
+        assert_eq!(request_for_turn(&entries, "parent", 200), Some(2));
+        // Finished, and the parent's next message landed before the report
+        // was written: it isn't what that turn answered.
+        let entries = vec![asked("p1", 100, "Fix it."), answer("a1", 110, MessageStatus::Complete), asked("p2", 250, "Next.")];
+        assert_eq!(request_for_turn(&entries, "parent", 200), Some(0));
+        assert_eq!(request_for_turn(&entries, "someone-else", 200), None);
+    }
+}
