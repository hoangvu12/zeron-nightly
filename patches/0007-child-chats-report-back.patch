diff --git a/apps/zgx/ui/ds/subagent_row.luau b/apps/zgx/ui/ds/subagent_row.luau
new file mode 100644
index 0000000000000000000000000000000000000000..d2bf10683963b1ff24cf7fefc34a3a612247f5dd
--- /dev/null
+++ b/apps/zgx/ui/ds/subagent_row.luau
@@ -0,0 +1,368 @@
+-- A child's row: one chat working for this one, however it was made (a Zeron
+-- chat an agent delegated to, a side chat, a harness's own subagent: Claude's
+-- Task, Codex's), the one way each is drawn wherever children are listed: a
+-- report that came back (ds/transcript), a spawn's children (ds/spawn_group,
+-- a native spawn in ds/activity), the composer's Running tray
+-- (ds/composer_dock). t3code's subagent row (V2LifecycleRow), Zeron's way:
+--
+-- - its agent's mark, a dot on its corner for how it stands: working, needs
+--   input (indigo, the accent), finished (emerald), failed (red), stopped
+--   (grey);
+-- - its title as its chat is called now, and what kind of child it is;
+-- - a report's row (`preview`): under its title, the first two lines of what
+--   it said, as plain text, when it finished or asks something (a report
+--   then reads apart from a spawn, which has said nothing yet). Not when it
+--   failed or was stopped: a cut-off line of an error read as noise, and its
+--   state's glyph says it. No card of it on hover;
+-- - its time, its state's glyph and a chevron; a child asking for the person
+--   has Answer before them;
+-- - a click opens it, beside this chat, where all of what it said is.
+--
+--   SubagentRow { child = function() return { id, title, state = "done", … } end, on_open = … }
+--
+-- `compact`: for a list of many (a spawn's, the tray's): its mark a little
+-- smaller, and its kind said only where the list asks (`kind`: one with
+-- subagents and side chats both).
+
+local AgentMark = require("@self/agent_mark")
+local Icon = require("@self/icon")
+local FadeText = require("@self/fade_text")
+local Button = require("@self/button")
+local status = require("@self/status")
+local control = require("@self/control")
+local locale = require("@self/locale")
+
+local M = {}
+
+export type State = "working" | "input" | "done" | "failed" | "stopped"
+export type Child = {
+	-- Its chat (a Zeron chat's id) or doc (a harness subagent's ref).
+	id: string,
+	title: string,
+	-- A Zeron chat an agent delegated to ("subagent") or a side conversation
+	-- ("side"); none, a harness's own subagent, which is a subagent too.
+	kind: string?,
+	state: State,
+	-- When ("2:14 PM"), or how long it has run ("3m 41s").
+	at: string?,
+	-- A Zeron chat's: when it started, and (at rest) when it last said
+	-- something, in `os.time()` seconds; ds/spawn_group makes them `at`.
+	since: number?,
+	ended: number?,
+	-- Its agent's mark (ds/mark's name), or a registry agent's icon.
+	mark: string?,
+	icon: string?,
+	-- What it said, in markdown (a report's reply).
+	said: string?,
+}
+
+export type Props = {
+	child: () -> Child,
+	compact: boolean?,
+	-- Whether a compact row says what kind of child it is too (live: a
+	-- list that comes to hold both kinds).
+	kind: (() -> boolean)?,
+	-- Its height where a list fixes it (the tray's rows), and its corner
+	-- where it sits in a container's (concentric with it).
+	h: number?,
+	rounded: any?,
+	-- A report's row: what its child said, under its title (see above).
+	preview: boolean?,
+	on_open: (() -> ())?,
+	-- What Answer does; without it, Answer opens the child, where the
+	-- question is.
+	on_answer: (() -> ())?,
+	class: string?,
+}
+
+-- The mark's size (bare, as a sidebar row's) and the state glyph at the
+-- row's end.
+local MARK, MARK_COMPACT, STATE_ICON = 18, 16, 14
+
+-- The dot's state for a child's (status.Kind's names).
+local DOT_KIND: { [State]: status.Kind } = {
+	working = "working",
+	input = "input",
+	done = "done",
+	failed = "failed",
+	stopped = "stopped",
+}
+
+local WORD: { [State]: string } = {
+	working = "ds.subagent_row.running",
+	input = "ds.subagent_row.needs_input",
+	done = "ds.subagent_row.finished",
+	failed = "ds.subagent_row.failed",
+	stopped = "ds.subagent_row.stopped",
+}
+
+-- Its state in a word ("Finished").
+function M.word(state: State): string
+	return locale.s(WORD[state])
+end
+
+-- Geist's ascent and descent, per point of its size (its em's 1005 and 295
+-- of 1000).
+local ASCENT, DESCENT = 1.005, 0.295
+
+-- The kind word's line box: zgx centres a line's glyphs in its box, so a
+-- line's baseline stands (box - (ascent + descent) * size) / 2 + descent *
+-- size above the box's bottom. On the title's bottom, the kind word, smaller,
+-- stands on the title's baseline in a box shorter than the title's by
+-- (ascent - descent) for each point it is smaller; in whole points, as zgx
+-- lays a line's box out (the shorter, so it never rides above the title's
+-- line: 16 for 11 under 13 on 18, which puts both 5 above the bottom).
+local function kind_line(): any
+	local size = function(name: string): number
+		return (ui.theme.get(name) :: number?) or 0
+	end
+	local line = size("font.line.md") - (ASCENT - DESCENT) * (size("font.size.md") - size("font.size.xs"))
+	return ui.raw(math.floor(line), "the title's line box less the smaller word's half-leading: one baseline")
+end
+
+-- Markdown as the words it says, on one line: no marks, fences, links'
+-- targets, headings' hashes or list bullets.
+function M.plain(md: string): string
+	local lines = {}
+	for line in string.gmatch(md, "[^\n]+") do
+		line = string.gsub(line, "^%s*```.*$", "")
+		line = string.gsub(line, "^%s*#+%s+", "")
+		line = string.gsub(line, "^%s*>%s?", "")
+		line = string.gsub(line, "^%s*[-*+]%s+%[[ xX]%]%s+", "")
+		line = string.gsub(line, "^%s*[-*+]%s+", "")
+		line = string.gsub(line, "^%s*%d+[.)]%s+", "")
+		table.insert(lines, line)
+	end
+	local text = table.concat(lines, " ")
+	text = string.gsub(text, "!%[([^%]]*)%]%b()", "%1")
+	text = string.gsub(text, "%[([^%]]*)%]%b()", "%1")
+	text = string.gsub(text, "`+", "")
+	text = string.gsub(text, "%*%*", "")
+	text = string.gsub(text, "__", "")
+	text = string.gsub(text, "~~", "")
+	text = string.gsub(text, "%f[%w%*]%*([^%*]+)%*", "%1")
+	text = string.gsub(text, "%s+", " ")
+	return (string.match(text, "^%s*(.-)%s*$") or "")
+end
+
+-- What a report's row shows of what its child said: for one that finished
+-- or asks, the words; nothing for the rest.
+function M.preview_of(child: Child): string
+	if child.state ~= "done" and child.state ~= "input" then
+		return ""
+	end
+	return M.plain(child.said or "")
+end
+
+-- A child's state from what each source says of it: a report's status
+-- (`finished`, `failed`, `stopped`, `needsInput`), a harness subagent's
+-- (`running`, `done`, `failed`), a chat's row (`working`, `waiting`,
+-- `input`, `approval`, `failed`, `done`, or none: idle). `idle`: what none
+-- means (a subagent not heard from yet runs; a chat at rest has finished).
+function M.state_of(word: string?, idle: State?): State
+	if word == "finished" or word == "done" then
+		return "done"
+	elseif word == "failed" or word == "errored" or word == "limited" then
+		return "failed"
+	elseif word == "stopped" or word == "interrupted" then
+		return "stopped"
+	elseif word == "needsInput" or word == "needs input" or word == "input" or word == "approval" or word == "plan" then
+		return "input"
+	elseif word == "running" or word == "working" or word == "waiting" or word == "connecting" then
+		return "working"
+	end
+	return idle or "working"
+end
+
+-- Its agent's mark, bare, as the sidebar draws an agent beside a title (a
+-- tile per row was a column of bright squares saying the same thing).
+function M.Avatar(props: { child: () -> Child, size: number? }): Node
+	local size = props.size or MARK
+	local first = props.child()
+	return ui.div {
+		w = size,
+		h = size,
+		shrink = 0,
+		items = "center",
+		justify = "center",
+		aria_hidden = true,
+		if first.mark or first.icon
+			then AgentMark { label = first.title, mark = first.mark, icon = first.icon, size = size, bare = true }
+			else ui.div { color = "$text.secondary", Icon { name = "side-chat", size = size } },
+	}
+end
+
+-- How it stands, as the sidebar's Subagents list says it: its state's glyph
+-- in its hue (working, the ring), its word for a reader and on hover.
