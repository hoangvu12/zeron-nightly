+    #[test]
+    fn counts_a_childs_returns_since_the_person_last_wrote() {
+        let report = |child: &str| agent_messages::child_report(child, child, ReportStatus::Finished, "ok");
+        let user = |text: &str| entry("u", MessageRole::User, vec![said(text)]);
+        let said = vec![
+            user(&report("kid-a")),
+            user("Carry on, both of you."),
+            user(&report("kid-a")),
+            entry("a", MessageRole::Assistant, vec![said("Noted.")]),
+            user(&agent_messages::merge_reports(&[report("kid-a"), report("kid-b")])),
+            user(&agent_messages::agent_message("Peer", "peer", "fyi")),
