+/// Whether a group's tools are one spawn of several children: a Zeron
+/// `create_chat(s)` call among them, or more than one native subagent.
+/// ds/transcript draws such a group as one block of its children
+/// (ds/spawn_group), not a tree of calls.
+fn spawn_group(group: &[&Json]) -> bool {
+    let natives = group.iter().filter(|p| is_agent(p) && !zeron_spawn_call(p)).count();
+    group.iter().all(|p| is_agent(p)) && (natives > 1 || group.iter().any(|p| zeron_spawn_call(p)))
 }
 
