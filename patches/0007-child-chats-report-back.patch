+    use zeron_proto::agent_messages::ReportStatus;
+
+    /// A command the subagent runs, open until the test ends it.
+    fn command(id: &str) -> AgentEvent {
+        AgentEvent::ToolCall {
+            id: id.into(),
+            call: zeron_proto::ToolCall::Exec {
+                command: "npm run gate".into(),
+            },
+        }
+    }
+
+    fn command_ended(id: &str, stopped: bool) -> AgentEvent {
+        AgentEvent::ToolResult {
+            id: id.into(),
+            is_error: stopped,
+            output: None,
+            diff: None,
+            exit_code: None,
+        }
+    }
+
+    impl FamilyRig {
+        /// The lead's agent writes `chat` while it works: a steer, read at
+        /// once only when `at_once` (an explicit `mode: "steer"`).
+        fn lead_writes(&self, chat: &str, text: &str, id: &str, at_once: bool) {
+            self.core
+                .doc_host
+                .queue_command(
+                    chat,
+                    zeron_doc::SessionCommandPayload::Steer {
+                        prompt: from_lead(text),
+                        message_id: Some(id.into()),
+                        at_once,
+                    },
+                )
+                .unwrap();
+        }
+
+        /// Every report the lead has, read or waiting for its turn's end.
+        fn heard(&self) -> Vec<(String, zeron_proto::agent_messages::ReportStatus, String)> {
+            self.reports("lead")
+                .into_iter()
+                .chain(self.queued("lead"))
+                .flat_map(|text| read(&text))
+                .collect()
+        }
+
+        /// Zeron's note on who still works for the lead, as it would read
+        /// it under a report now.
+        fn roster(&self) -> String {
+            let batch = zeron_proto::agent_messages::child_report("Kid (kid-b)", "kid-b", ReportStatus::Finished, "ok");
+            let local = self.core.sessions.local_sessions();
+            let roster = reports::report_notes(&self.core.doc_host, "lead", &batch, &local, false)
+                .pop()
+                .unwrap_or_default();
+            notes(&format!("{batch}\n\n{roster}")).concat()
+        }
+
+        /// The steer the subagent's runtime reads from its mailbox, played
+        /// as read.
+        async fn take_steer(&self, run: &ChatRun) -> SteerMessage {
+            let steer = loop {
+                if let Ok(steer) = lock(&run._steers).try_recv() {
+                    break steer;
+                }
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            };
+            run.feed
+                .send(AgentEvent::Steered { assistant_message_id: None, next_assistant_message_id: Some("a2".into()) })
+                .unwrap();
+            steer
+        }
+    }
+
+    /// The lead's agent writes Tests while Tests runs a command: the
+    /// command finishes, the message is read at the next step, and Tests'
+    /// one report is its finished reply. Nothing reads as stopped.
+    #[tokio::test]
+    async fn an_agents_message_to_a_busy_child_waits_for_its_command_and_reports_once() {
+        let rig = family_rig().await;
+        let lead = rig.start("lead", "Get the tests run.").await;
+        lead.feed.send(text("Asked Tests.")).unwrap();
+        let kid = rig.start("kid-a", &from_lead("Run the tests.")).await;
+        kid.feed.send(text("Running them.")).unwrap();
+        lead.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the lead waits on Tests", |r| r.status("lead").waiting.is_some()).await;
+        kid.feed.send(command("gate")).unwrap();
+        rig.until("the command runs", |r| r.core.sessions.steer_stops_tool("kid-a")).await;
+
+        rig.lead_writes("kid-a", "Also check the docs.", "lead-m2", false);
+        let stop = tokio::time::timeout(std::time::Duration::from_millis(500), kid.turn.stop_requested()).await;
+        assert!(stop.is_err(), "the command wasn't stopped");
+        assert_eq!(rig.status("kid-a").status, SessionStatus::Working);
+        let on: Vec<_> = reports::children_on(&rig.core.doc_host, "lead", &rig.core.sessions.local_sessions())
+            .into_iter()
+            .map(|w| w.id)
+            .collect();
+        assert_eq!(on, ["kid-a"], "Tests still works for the lead");
+        assert!(rig.roster().starts_with("Still working for you: Tests (asked "), "{}", rig.roster());
+        assert!(rig.heard().is_empty());
+
+        // The command finishes; the message is read after it, in the turn.
+        kid.feed.send(command_ended("gate", false)).unwrap();
+        let steer = rig.take_steer(&kid).await;
+        assert!(!steer.prompt.contains("Zeron note"), "nothing to explain: {}", steer.prompt);
+        kid.feed.send(text("Tests green, docs checked.")).unwrap();
+        kid.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the lead hears back", |r| !r.heard().is_empty()).await;
+        rig.quiet().await;
+        assert_eq!(
+            rig.heard(),
+            [("kid-a".into(), ReportStatus::Finished, "Tests green, docs checked.".into())]
+        );
+        rig.core.sessions.shutdown().await;
+    }
