+                tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+            };
+            run.feed.send(started()).unwrap();
+            run
+        }
+
+        fn status(&self, chat: &str) -> Session {
+            self.core.sessions.session_status(chat).expect("a session row")
+        }
+
+        /// The reports `chat` received, each message's in order.
+        fn reports(&self, chat: &str) -> Vec<String> {
+            let handle = self.core.doc_host.open(chat).unwrap();
+            handle
+                .doc()
+                .read_entries()
+                .unwrap()
+                .into_iter()
+                .filter(|e| e.role == zeron_doc::MessageRole::User)
+                .map(|e| reports::text_of_entry(&e))
+                .filter(|text| zeron_proto::agent_messages::child_reports(text).is_some())
+                .collect()
+        }
+
+        /// The lead's queue: what waits for its turn's end.
+        fn queued(&self, chat: &str) -> Vec<String> {
+            let handle = self.core.doc_host.open(chat).unwrap();
+            handle.doc().read_queue().unwrap().into_iter().map(|q| q.text).collect()
+        }
+
+        /// Until `check` holds (a few seconds at most).
+        async fn until(&self, what: &str, check: impl Fn(&Self) -> bool) {
+            for _ in 0..200 {
+                if check(self) {
+                    return;
+                }
+                tokio::time::sleep(std::time::Duration::from_millis(30)).await;
+            }
+            panic!("never happened: {what}");
+        }
+
+        /// Nothing more happens for a while.
+        async fn quiet(&self) {
+            tokio::time::sleep(std::time::Duration::from_millis(600)).await;
+        }
+    }
+
+    fn read(report: &str) -> Vec<(String, zeron_proto::agent_messages::ReportStatus, String)> {
+        zeron_proto::agent_messages::child_reports(report)
+            .unwrap()
+            .into_iter()
+            .map(|r| (r.sender.chat_id, r.status, r.body.to_owned()))
+            .collect()
+    }
+
+    fn tool_call(id: &str, tool: &str, input: serde_json::Value) -> AgentEvent {
+        AgentEvent::ToolCall {
+            id: id.into(),
+            call: zeron_proto::ToolCall::Mcp {
+                server: "zeron".into(),
+                tool: tool.into(),
+                input: Some(input),
+            },
+        }
+    }
+
+    fn tool_result(id: &str) -> AgentEvent {
+        AgentEvent::ToolResult {
+            id: id.into(),
+            is_error: false,
+            output: None,
+            diff: None,
+            exit_code: None,
+        }
+    }
