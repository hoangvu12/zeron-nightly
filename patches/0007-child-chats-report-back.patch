+    impl FamilyRig {
+        /// The lead asks both subagents for something and ends its turn,
+        /// waiting on them; each is mid-turn on it.
+        async fn both_at_work(&self) -> (ChatRun, ChatRun) {
+            let lead = self.start("lead", "Get tests and docs done.").await;
+            lead.feed.send(text("Asked both; I'll hear back.")).unwrap();
+            let a = self.start("kid-a", &from_lead("Run the tests.")).await;
+            let b = self.start("kid-b", &from_lead("Write the docs.")).await;
+            a.feed.send(text("Running them.")).unwrap();
+            b.feed.send(text("Writing.")).unwrap();
+            lead.feed.send(done(DoneStatus::Completed)).unwrap();
+            self.until("the lead waits on both", |r| {
+                r.status("lead").waiting.is_some_and(|w| w.on.len() == 2)
+            })
+            .await;
+            (a, b)
+        }
+
+        /// Every message the lead was given, in order.
+        fn said_to_lead(&self) -> Vec<String> {
+            let handle = self.core.doc_host.open("lead").unwrap();
+            handle
+                .doc()
+                .read_entries()
+                .unwrap()
+                .into_iter()
+                .filter(|e| e.role == zeron_doc::MessageRole::User)
+                .map(|e| reports::text_of_entry(&e))
+                .collect()
+        }
+    }
+
+    fn statuses(report: &str) -> Vec<(String, zeron_proto::agent_messages::ReportStatus)> {
+        read(report).into_iter().map(|(id, status, _)| (id, status)).collect()
+    }
+
+    /// Zeron's notes under the latest message the lead read.
+    fn notes(report: &str) -> Vec<String> {
+        zeron_proto::agent_messages::report_notes(report).into_iter().map(str::to_owned).collect()
+    }
