+++ b/crates/engine/src/session_reports.rs
@@ -0,0 +1,1135 @@
+//! A child chat reports back to its parent: when a turn its parent's agent
+//! asked for settles (finished, failed, stopped, or asking the person), the
+//! child's host writes the reply into the parent as a report
+//! ([`agent_messages::child_report`]), so the agent there hears back without
+//! polling, and the person never has to nudge either side.
+//!
+//! "Asked for" is one rule, the same for subagents and side chats an agent
+//! made: the child's latest message carries Zeron's header naming the
+//! parent. A turn the person started (they took the child over, or chat in
+//! it themselves) is theirs, and the parent stays out of it.
+//!
+//! A turn's end always reports, even when the child also wrote its parent
+//! with `send_message` on the way (a copy costs words; a missing end costs
+//! the task). It's skipped only when the parent's agent is blocked right now
+//! in a call waiting on that child (`wait_for_turn`, or a send or create with
+//! `wait`), whose own result carries it.
+//!
+//! Delivery is a durable Run command in the parent's doc, so it reaches a
+//! parent hosted anywhere. The parent's host decides when the agent reads
+//! it: after a short window when idle, else held for its turn's end, joined
+//! with any other report already held there (see `DocHost::hold_report`),
+//! with Zeron's notes under it ([`report_notes`]).
+//!
+//! The same rule tells a parent's host which children still work for it, for
+//! the parent's wait ([`children_on`]) and the notes.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex};
+
+use chrono::Utc;
+use serde_json::Value;
+use zeron_doc::{
+    MessagePart, MessageRole, MessageStatus, SessionCommandPayload, SessionCommandStatus,
+    SessionMessageEntry,
+};
+use zeron_proto::agent_messages::{self, ReportStatus};
+use zeron_proto::{Chat, Session, SessionStatus, ToolCall, WaitingKind, WaitingOn};
+
+use super::lock;
+use crate::doc_host::DocHost;
+use crate::run_journal::RunJournal;
+
+/// The most of a reply a report carries; past it, the report says where the
+/// rest is.
+const REPORT_CAP: usize = 16 * 1024;
+
+/// What each child has reported, in memory on its host: the parent's
+/// message its latest reports answered, and which of them went (its end, and
+/// each question it asked on the way). A turn settles through several status
+/// writes; this is what makes it one report.
+#[derive(Default)]
+pub(super) struct Reported(Mutex<HashMap<String, (String, HashSet<String>)>>);
+
+impl Reported {
+    /// Claim `stage` of the report on `message` for `child`: false when it
+    /// was already claimed.
+    pub(super) fn claim(&self, child: &str, message: &str, stage: &str) -> bool {
+        let mut reported = lock(&self.0);
+        let entry = reported.entry(child.to_owned()).or_default();
+        if entry.0 != message {
+            *entry = (message.to_owned(), HashSet::new());
+        }
+        entry.1.insert(stage.to_owned())
+    }
+
+    /// Give back a claim whose report never went (it couldn't be built or
+    /// queued): a later settle, or the next start, sends it.
+    pub(super) fn release(&self, child: &str, message: &str, stage: &str) {
+        let mut reported = lock(&self.0);
+        if let Some(entry) = reported.get_mut(child)
+            && entry.0 == message
+        {
+            entry.1.remove(stage);
+        }
+    }
+}
+
+/// How close before a turn's settle a Stop must have been sent to be the
+/// one that ended it.
+const STOP_SETTLE_MS: i64 = 60 * 1000;
+
+#[cfg(test)]
+thread_local! {
+    /// How many of the next reports fail to queue, as a parent's doc that
+    /// can't be written would.
+    pub(super) static FAIL_QUEUE: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+/// Report `child`'s settled turn to its parent, when its parent asked for it
+/// and doesn't have the reply yet. Runs on the child's host, after the
+/// status that settled it is published (its final segment is in the doc);
+/// `settled_at`: when that was.
+pub(super) async fn report_turn_end(
+    host: DocHost,
+    journal: Arc<RunJournal>,
+    reported: Arc<Reported>,
+    child: String,
+    status: ReportStatus,
+    settled_at: i64,
+) {
+    let Some(ws) = host.workspace().cloned() else {
+        return;
+    };
+    let Ok(Some(row)) = ws.chat(&child) else {
+        return;
+    };
+    let Some(parent) = row.parent_chat_id.clone() else {
+        return;
+    };
+    // An archived parent still hears (its host holds the report until it's
+    // restored); a deleted one doesn't.
+    if ws.chat(&parent).ok().flatten().is_none() {
+        return;
+    }
+    let Ok(handle) = host.open(&child) else {
+        return;
+    };
+    // A question is folded into the doc on the stream's next commit, a
+    // moment after the status that says it was asked.
+    let mut entries = handle.doc().read_entries().unwrap_or_default();
+    if status == ReportStatus::NeedsInput {
+        for _ in 0..60 {
+            if open_question(&entries).is_some() {
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+            entries = handle.doc().read_entries().unwrap_or_default();
+        }
+    }
+    let commands = handle.doc().read_commands().unwrap_or_default();
+    // The Stop that ended a stopped turn, when one did (not a "send now").
+    let stop = (status == ReportStatus::Stopped)
+        .then(|| {
+            commands
+                .iter()
+                .filter(|c| matches!(c.payload, SessionCommandPayload::Interrupt { .. }))
+                .map(|c| c.issued_at)
+                .filter(|&at| at <= settled_at && settled_at - at <= STOP_SETTLE_MS)
+                .max()
+        })
+        .flatten();
+    // A stopped turn answered what was sent before its Stop (strictly: one
+    // sent in the same millisecond came with it, not before): the parent's
+    // next message, sent after it, may be in already, its turn not begun.
+    let cut = stop.map_or(settled_at, |at| at - 1);
+    let Some(at) = request_for_turn(&entries, &parent, cut) else {
+        return; // the person's chat alone, or another chat's
+    };
+    let asked = entries[at].id.clone();
+    // Its answer runs up to the parent's next message, if one is in.
+    let after = &entries[at + 1..];
+    let after = after
+        .iter()
+        .position(|e| e.role == MessageRole::User && from_parent(&text_of(&e.parts), &parent))
+        .map_or(after, |next| &after[..next]);
+    let stage = match status {
+        ReportStatus::NeedsInput => match open_question(after) {
+            Some((request_id, _)) => format!("ask:{request_id}"),
+            None => return,
+        },
+        _ => end_stage(status).to_owned(),
+    };
+    // A stop that hands the turn to a message already on its way (the
+    // person's "send now") is no end: that message's turn reports. A Stop
+    // is one, whatever is sent after it.
+    if status == ReportStatus::Stopped && stop.is_none() && handle.continues_with_sent_message() {
+        return;
+    }
+    // Its parent's agent stopped it: that's no news to it.
+    if stopped_by_parent(&commands, &parent, entries[at].created_at) {
+        tracing::info!(chat = %child, %parent, "its parent stopped it: no report");
+        return;
+    }
+    // The parent has it already (this engine, or another before a restart,
+    // sent it): its ledger keeps every report by its key.
+    if delivered(&host, &parent, &child, &entries[at], &stage) {
+        return;
+    }
+    if !reported.claim(&child, &asked, &stage) {
+        return;
+    }
+    let chats = ws.read_chats().unwrap_or_default();
+    let keys: Vec<(&str, Option<&str>)> =
+        chats.iter().map(|c| (c.id.as_str(), c.title.as_deref())).collect();
+    let first_turn = !entries[..at].iter().any(|e| e.role == MessageRole::User);
+    // Only the parent's turn streaming now can be blocked; its calls' inputs
+    // are known when it runs here too. (A parent on another device can't be
+    // seen waiting, and gets the report as well as its call's result.)
+    let streaming = host.open(&parent).map(|doc| {
+        let entries = doc.doc().read_entries().unwrap_or_default();
+        entries
+            .into_iter()
+            .filter(|e| e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Streaming))
+            .collect::<Vec<_>>()
+    });
+    // Its wait returns the reply: the report still goes in the parent's
+    // ledger, marked so, and its host keeps it from the agent; then a later
+    // turn here knows the parent heard.
+    let mut key = report_id(&child, &asked, &stage);
+    if let Ok(streaming) = streaming
+        && waits_on(&with_inputs(&journal, &parent, streaming), &child, first_turn, &keys)
+    {
+        tracing::info!(chat = %child, %parent, "parent is waiting on its child: its wait has the reply");
+        key.push_str(WAITED);
+    }
+    let body = match status {
+        ReportStatus::NeedsInput => question_body(after, &child),
+        // What it wrote is from before the stop, however sure of itself it
+        // sounds. Only a Stop nobody's agent sent is the person's.
+        ReportStatus::Stopped => {
+            let reply = reply_body(after, status);
+            let by_person = commands.iter().any(|c| {
+                c.issued_at >= entries[at].created_at
+                    && matches!(c.payload, SessionCommandPayload::Interrupt { stopped_by: None })
+            });
+            let said = match (by_person, reply.is_empty()) {
+                (true, true) => "The person stopped it before it wrote anything.".to_owned(),
+                (true, false) => {
+                    format!("The person stopped it. What it wrote before the Stop, possibly unfinished:\n\n{reply}")
+                }
+                (false, true) => "Its turn was cut off before it wrote anything.".to_owned(),
+                (false, false) => {
+                    format!("Its turn was cut off before it finished. What it wrote, possibly unfinished:\n\n{reply}")
+                }
+            };
+            capped(said, &child)
+        }
+        _ => {
+            let mut reply = reply_body(after, status);
+            // Cut off by the engine going down, found on its next start.
+            if after.last().is_some_and(|e| e.status == Some(MessageStatus::Aborted)) {
+                reply.push_str("\n\n(Its run was cut off when the engine stopped, before it finished.)");
+            }
+            capped(reply.trim().to_owned(), &child)
+        }
+    };
+    let label = crate::rpc::agent_gate::label(Some(&row), &child);
+    let text = agent_messages::child_report(&label, &child, status, &body);
+    let Some(request) = host.request_from_chat_row(&parent, &text) else {
+        tracing::warn!(chat = %child, %parent, "report not sent: the parent has no run config");
+        reported.release(&child, &asked, &stage);
+        return;
+    };
+    let payload = SessionCommandPayload::Run { request, message_id: key };
+    #[cfg(test)]
+    if FAIL_QUEUE.with(|left| left.replace(left.get().saturating_sub(1))) > 0 {
+        tracing::warn!(chat = %child, %parent, "child report failed (test)");
+        reported.release(&child, &asked, &stage);
+        return;
+    }
+    match host.queue_command(&parent, payload) {
+        Ok(_) => tracing::info!(chat = %child, %parent, status = status.as_str(), "child reported to its parent"),
+        Err(error) => {
+            tracing::warn!(chat = %child, %parent, %error, "child report failed");
+            reported.release(&child, &asked, &stage);
+        }
+    }
+}
+
+/// The stage of the report a turn's end makes. A stop's is its own: a
+/// report of the stop never stands for the end of the work it cut (a turn
+/// on the same message can still finish, and report that).
+fn end_stage(status: ReportStatus) -> &'static str {
+    match status {
+        ReportStatus::Stopped => "stopped",
+        _ => "end",
+    }
+}
+
+/// How long before this engine started a child's turn may have ended and
+/// still report now, when its report never reached the parent (the engine
+/// went down between the two). Older ones are history.
+const OWED_RECENT_MS: i64 = 60 * 60 * 1000;
+
+/// On this engine's start: the child chats hosted here whose last turn on
+/// their parent's message ended (or was cut off) shortly before, with no
+/// report of it in the parent's ledger, and how each ended. A turn the
+/// engine revives isn't among them (`running`): it reports as it settles.
+pub(super) fn owed_on_boot(host: &DocHost, running: impl Fn(&str) -> bool) -> Vec<(String, ReportStatus)> {
+    let Some(ws) = host.workspace() else {
+        return Vec::new();
+    };
+    let now = Utc::now().timestamp_millis();
+    ws.read_chats()
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|c| c.device_id == host.device_id() && !c.archived && !running(&c.id))
+        .filter_map(|child| {
+            let parent = child.parent_chat_id.clone()?;
+            let handle = host.open(&child.id).ok()?;
+            let entries = handle.doc().read_entries().unwrap_or_default();
+            // Its turn ended when its last answer did.
+            let ended = entries
+                .iter()
+                .rev()
+                .find(|e| e.role == MessageRole::Assistant)
+                .map(|e| e.created_at + e.duration_ms.unwrap_or(0))?;
+            let at = request_for_turn(&entries, &parent, ended)?;
+            let after = &entries[at + 1..];
+            let last = after.iter().rev().find(|e| e.role == MessageRole::Assistant)?;
+            if now - (last.created_at + last.duration_ms.unwrap_or(0)) > OWED_RECENT_MS {
+                return None;
+            }
+            let commands = handle.doc().read_commands().unwrap_or_default();
+            let since = entries[at].created_at;
+            if stopped_by_parent(&commands, &parent, since) {
+                return None;
+            }
+            let stopped = commands
+                .iter()
+                .any(|c| c.issued_at >= since && matches!(c.payload, SessionCommandPayload::Interrupt { .. }));
+            let failed = last.status == Some(MessageStatus::Aborted)
+                || last.parts.iter().any(|p| matches!(p, MessagePart::Error { .. }));
+            let status = if stopped {
+                ReportStatus::Stopped
+            } else if open_question(after).is_some() {
+                ReportStatus::NeedsInput
+            } else if failed {
+                ReportStatus::Failed
+            } else {
+                ReportStatus::Finished
+            };
+            if delivered(host, &parent, &child.id, &entries[at], end_stage(status)) {
+                return None;
+            }
+            Some((child.id, status))
+        })
+        .collect()
+}
+
+/// The children working on something `parent`'s agent asked of them now, as
+/// its wait lists them: a child whose latest message is the parent's and
+/// whose turn on it still runs, or that has a message from the parent still
+/// on its way. `local` holds this host's own session rows (fresher than the
+/// registry's for runs here).
+pub(super) fn children_on(host: &DocHost, parent: &str, local: &[Session]) -> Vec<WaitingOn> {
+    let Some(ws) = host.workspace() else {
+        return Vec::new();
+    };
+    let chats = ws.read_chats().unwrap_or_default();
+    let children: Vec<&Chat> = chats
+        .iter()
+        .filter(|c| c.parent_chat_id.as_deref() == Some(parent) && !c.archived)
+        .collect();
+    if children.is_empty() {
+        return Vec::new();
+    }
+    let remote = ws.read_sessions().unwrap_or_default();
+    let now = Utc::now();
+    children
+        .into_iter()
+        .filter(|child| {
+            let session = session_of(host, child, local, &remote, now);
+            // Its own wait on background work is still its turn.
+            let working = session.is_some_and(|s| {
+                s.status == SessionStatus::Working
+                    || (s.status == SessionStatus::Idle && s.waiting.is_some())
+            });
+            let Ok(handle) = host.open(&child.id) else {
+                return false;
+            };
+            let doc = handle.doc();
+            let entries = doc.read_entries().unwrap_or_default();
+            if on_its_way(host, &doc.read_commands().unwrap_or_default(), &entries, parent, &child.id, session) {
+                return true;
+            }
+            working
+                && request_message(&entries, parent)
+                    .is_some_and(|at| !delivered(host, parent, &child.id, &entries[at], "end"))
+        })
+        .map(|child| WaitingOn {
+            id: child.id.clone(),
+            kind: WaitingKind::Agent,
+            label: child
+                .title
+                .as_deref()
+                .map(str::trim)
+                .filter(|t| !t.is_empty())
+                .map_or_else(|| child.id.chars().take(8).collect(), str::to_owned),
+        })
+        .collect()
+}
+
+/// Every this many times one child has come back to its parent with the
+/// person silent, the parent is told so (it never stops anything: a loop
+/// costs turns, a stall would cost the task).
+const EXCHANGES_NOTED: usize = 10;
+
+/// Zeron's notes under the reports `parent`'s agent is about to read
+/// (`batch`, one child's or several merged), each a line of fact as this
+/// engine knows it now: a question in it still waiting on the agent (or
+/// answered meanwhile in the child), how often a child has come back since
+/// the person last wrote (every [`EXCHANGES_NOTED`]th time), and which
+/// children still work on something it asked. Nothing waits on them.
+/// `local`: this engine's session rows.
+pub(crate) fn report_notes(host: &DocHost, parent: &str, batch: &str, local: &[Session], more: bool) -> Vec<String> {
+    let Some(reports) = agent_messages::child_reports(batch) else {
+        return Vec::new();
+    };
+    let mut notes = Vec::new();
+    if more {
+        notes.push("More of your children's reports are waiting: they reach you right after this turn.".to_owned());
+    }
+    for report in reports.iter().filter(|r| r.status == ReportStatus::NeedsInput) {
+        let (title, id) = (&report.sender.title, &report.sender.chat_id);
+        let open = host
+            .open(id)
+            .is_ok_and(|child| open_question(&child.doc().read_entries().unwrap_or_default()).is_some());
+        notes.push(if open {
+            format!("{title} is waiting on the answer to its question above: answer with the Zeron `respond_to_input` tool, chat {id}.")
+        } else {
+            format!("{title}'s question above has been answered in its chat already.")
+        });
+    }
+    let said = host
+        .open(parent)
+        .map(|doc| doc.doc().read_entries().unwrap_or_default())
+        .unwrap_or_default();
+    let mut counted = HashSet::new();
+    for report in &reports {
+        let (title, id) = (&report.sender.title, report.sender.chat_id.as_str());
+        if !counted.insert(id) {
+            continue;
+        }
+        let before = back_since_person(&said, id);
+        let now = before + reports.iter().filter(|r| r.sender.chat_id == id).count();
+        if now / EXCHANGES_NOTED > before / EXCHANGES_NOTED {
+            notes.push(format!(
+                "{title} has come back to you {now} times since the person last wrote: keep going only if the task needs it."
+            ));
+        }
+    }
+    notes.push(roster(host, parent, local));
+    notes.iter().map(|note| agent_messages::report_note(note)).collect()
+}
+
+/// How many times `child` has come back to its parent (`said`: the parent's
+/// transcript) since the person last wrote there.
+fn back_since_person(said: &[SessionMessageEntry], child: &str) -> usize {
+    said.iter()
+        .rev()
+        .filter(|e| e.role == MessageRole::User)
+        .map(|e| text_of(&e.parts))
+        .take_while(|text| agent_messages::agent_message_sender(text).is_some())
+        .filter_map(|text| {
+            agent_messages::child_reports(&text).map(|reports| reports.iter().filter(|r| r.sender.chat_id == child).count())
+        })
+        .sum()
+}
+
+/// One line naming each child still working on something `parent` asked:
+/// how long since it was asked, and how long since its run last did
+/// anything (when it runs here) or since its device was last heard from.
+fn roster(host: &DocHost, parent: &str, local: &[Session]) -> String {
+    let Some(ws) = host.workspace() else {
+        return "No child is working for you now.".into();
+    };
+    let remote = ws.read_sessions().unwrap_or_default();
+    let now = Utc::now();
+    let journal = host.sessions().map(|engine| engine.inner.journal.clone());
+    let open: Vec<String> = ws
+        .read_chats()
+        .unwrap_or_default()
+        .iter()
+        .filter(|c| c.parent_chat_id.as_deref() == Some(parent) && !c.archived)
+        .filter_map(|child| {
+            let handle = host.open(&child.id).ok()?;
+            let doc = handle.doc();
+            let label = child
+                .title
+                .as_deref()
+                .map(str::trim)
+                .filter(|t| !t.is_empty())
+                .map_or_else(|| child.id.chars().take(8).collect(), str::to_owned);
+            let commands = doc.read_commands().unwrap_or_default();
+            if commands
+                .iter()
+                .any(|c| c.status == SessionCommandStatus::Pending && matches!(c.payload, SessionCommandPayload::Interrupt { .. }))
+            {
+                return Some(format!("{label} (stop requested)"));
+            }
+            let entries = doc.read_entries().unwrap_or_default();
+            let session = session_of(host, child, local, &remote, now);
+            if on_its_way(host, &commands, &entries, parent, &child.id, session) {
+                return Some(format!("{label} (sent, not started)"));
+            }
+            let at = request_message(&entries, parent)?;
+            if delivered(host, parent, &child.id, &entries[at], "end")
+                || stopped_by_parent(&commands, parent, entries[at].created_at)
+            {
+                return None;
+            }
+            let asked = entries[at].created_at;
+            let since = |ms: i64| ago(now.timestamp_millis() - ms);
+            let mut facts = vec![format!("asked {} ago", since(asked))];
+            match session {
+                Some(s) if s.status == SessionStatus::AwaitingInput => facts.insert(0, "waiting on an answer".into()),
+                Some(s) if s.status == SessionStatus::Working || s.waiting.is_some() => {
+                    if let Some(at) = journal.as_ref().and_then(|j| j.last_append_ms(&child.id)) {
+                        facts.push(format!("last output {} ago", since(at)));
+                    }
+                }
+                Some(_) => return None,
+                None => {
+                    // A row from another device gone quiet: the last of it.
+                    let last = remote
+                        .iter()
+                        .find(|s| s.chat_id == child.id && s.device_id == child.device_id)
+                        .filter(|s| matches!(s.status, SessionStatus::Working | SessionStatus::AwaitingInput))?;
+                    facts.push(format!("its device last heard from {} ago", since(last.updated_at.timestamp_millis())));
+                }
+            }
+            Some(format!("{label} ({})", facts.join(", ")))
+        })
+        .collect();
+    if open.is_empty() {
+        "No child is working for you now.".into()
+    } else {
+        format!("Still working for you: {}. Their reports reach you on their own.", open.join("; "))
+    }
+}
+
+/// A span of milliseconds as a person says it.
+fn ago(ms: i64) -> String {
+    let secs = ms.max(0) / 1000;
+    match secs {
+        0..60 => format!("{secs} s"),
+        60..3600 => format!("{} min", secs / 60),
+        _ => format!("{} h {} min", secs / 3600, secs % 3600 / 60),
+    }
+}
+
+/// `child`'s session row: this engine's own for a chat it hosts, else the
+/// registry's while fresh.
+fn session_of<'a>(
+    host: &DocHost,
+    child: &Chat,
+    local: &'a [Session],
+    remote: &'a [Session],
+    now: chrono::DateTime<Utc>,
+) -> Option<&'a Session> {
+    if child.device_id == host.device_id() {
+        local.iter().find(|s| s.chat_id == child.id)
+    } else {
+        remote.iter().find(|s| {
+            s.chat_id == child.id && s.device_id == child.device_id && !zeron_proto::view::session_stale(s, now)
+        })
+    }
+}
+
+/// A message from `parent` the child's host hasn't run yet: its command
+/// still pending, as this device's copy of the child's doc says.
+///
+/// For a child hosted on another device that copy only catches up while
+/// this device keeps the doc open (it stops syncing seconds after the last
+/// read, and the read here comes right after opening it), so the host's
+/// `applied` can be long in coming. Any sign the message got there counts
+/// instead: it's in the transcript, the parent's ledger has a report on it,
+/// or (`session`: the child's fresh row) a turn of the child's ended since.
+fn on_its_way(
+    host: &DocHost,
+    commands: &[zeron_doc::SessionCommandEntry],
+    entries: &[SessionMessageEntry],
+    parent: &str,
+    child: &str,
+    session: Option<&Session>,
+) -> bool {
+    let ran_since = |issued_at: i64| {
+        session
+            .and_then(|s| s.last_turn_outcome.as_ref())
+            .is_some_and(|o| o.finished_at.timestamp_millis() >= issued_at)
+    };
+    commands
+        .iter()
+        .filter(|c| c.status == SessionCommandStatus::Pending)
+        .any(|c| {
+            let (text, message) = match &c.payload {
+                SessionCommandPayload::Run { request, message_id } => (&request.prompt, message_id.as_str()),
+                SessionCommandPayload::Steer { prompt, message_id, .. } => {
+                    (prompt, message_id.as_deref().unwrap_or(&c.id))
+                }
+                _ => return false,
+            };
+            from_parent(text, parent)
+                && !(entries.iter().any(|e| e.id == message)
+                    || reported_on(host, parent, child, message)
+                    || ran_since(c.issued_at))
+        })
+}
+
+/// Whether `parent`'s ledger has any report from `child` on its message
+/// `asked` (an id in the child's transcript).
+fn reported_on(host: &DocHost, parent: &str, child: &str, asked: &str) -> bool {
+    let Ok(doc) = host.open(parent) else {
+        return false;
+    };
+    let prefix = format!("report-{child}-{asked}-");
+    doc.doc().read_commands().unwrap_or_default().iter().any(|c| {
+        matches!(&c.payload, SessionCommandPayload::Run { message_id, .. } if message_id.starts_with(&prefix))
+    })
+}
+
+/// `text` is a message `parent` sent (not a report, which only parents
+/// receive).
+fn from_parent(text: &str, parent: &str) -> bool {
+    agent_messages::child_reports(text).is_none()
+        && agent_messages::agent_message_sender(text).is_some_and(|(s, _)| s.chat_id == parent)
+}
+
+/// Where the parent's latest message to the child sits in `entries`: what
+/// the child's turns since answer, whoever else wrote meanwhile (a message
+/// read into a turn the person started is that turn's to answer too).
+/// Whether it's answered yet is the parent's ledger's to say ([`delivered`]).
+fn request_message(entries: &[SessionMessageEntry], parent: &str) -> Option<usize> {
+    entries
+        .iter()
+        .rposition(|e| e.role == MessageRole::User && from_parent(&text_of(&e.parts), parent))
+}
+
+/// Where the parent's message that the child's settled turn answered sits in
+/// `entries`: its latest, once an answer to that has settled. With none
+/// settled since (a turn on it not begun yet, or stopped before it wrote a
+/// word), the latest sent by `cut`: when the turn was cut off (its Stop) or
+/// settled. One sent later came after that turn, and its own turn reports.
+fn request_for_turn(entries: &[SessionMessageEntry], parent: &str, cut: i64) -> Option<usize> {
+    let latest = request_message(entries, parent)?;
+    let answered = entries[latest + 1..]
+        .iter()
+        .any(|e| e.role == MessageRole::Assistant && e.status != Some(MessageStatus::Streaming));
+    if answered {
+        return Some(latest);
+    }
+    entries
+        .iter()
+        .rposition(|e| e.role == MessageRole::User && e.created_at <= cut && from_parent(&text_of(&e.parts), parent))
+        .or(Some(latest))
+}
+
+/// What a report's key ends on when the parent's own wait returned the
+/// reply: in its ledger, never read by its agent.
+pub(crate) const WAITED: &str = "-waited";
+
+/// The key `child`'s report on the parent's message `asked` goes by (its
+/// end, or `ask:<id>` for a question on the way): the message id of its
+/// command in the parent's doc, so the parent's ledger says which went.
+fn report_id(child: &str, asked: &str, stage: &str) -> String {
+    format!("report-{child}-{asked}-{}", stage.replace(':', "-"))
+}
+
+/// Whether `parent` has `child`'s report (`stage` of it) on its message
+/// `asked` already: a command keyed so in the parent's ledger, or, sent
+/// before reports were keyed, one from `child` ending a turn since (as
+/// stopped, for the `stopped` stage; finished or failed, for the end).
+fn delivered(host: &DocHost, parent: &str, child: &str, asked: &SessionMessageEntry, stage: &str) -> bool {
+    let Ok(doc) = host.open(parent) else {
+        return false;
+    };
+    let key = report_id(child, &asked.id, stage);
+    doc.doc().read_commands().unwrap_or_default().iter().any(|c| {
+        let SessionCommandPayload::Run { request, message_id } = &c.payload else {
+            return false;
+        };
+        if message_id.strip_prefix(key.as_str()).is_some_and(|rest| rest.is_empty() || rest == WAITED) {
+            return true;
+        }
+        let ends = |status: ReportStatus| match stage {
+            "end" => matches!(status, ReportStatus::Finished | ReportStatus::Failed),
+            "stopped" => status == ReportStatus::Stopped,
+            _ => false,
+        };
+        !message_id.starts_with("report-")
+            && c.issued_at >= asked.created_at
+            && agent_messages::child_reports(&request.prompt)
+                .is_some_and(|reports| reports.iter().any(|r| r.sender.chat_id == child && ends(r.status)))
+    })
+}
+
+/// Whether `parent`'s agent stopped the child since its message at `since`
+/// (its Stop, in the child's ledger, says who made it).
+fn stopped_by_parent(commands: &[zeron_doc::SessionCommandEntry], parent: &str, since: i64) -> bool {
+    commands.iter().any(|c| {
+        c.issued_at >= since
+            && matches!(&c.payload, SessionCommandPayload::Interrupt { stopped_by: Some(by) } if by == parent)
+    })
+}
+
+#[cfg(test)]
+pub(super) fn text_of_entry(entry: &SessionMessageEntry) -> String {
+    text_of(&entry.parts)
+}
+
+fn text_of(parts: &[MessagePart]) -> String {
+    parts
+        .iter()
+        .filter_map(|part| match part {
+            MessagePart::Text { text, .. } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// `entries` with each Zeron tool call's input put back from `journal`, as
+/// the run recorded it: the doc keeps no MCP input (`sanitize_tool_call`;
+/// only the host's journal does), and the checks below read whom a call
+/// named. A call this host never ran stays as the doc has it.
+fn with_inputs(journal: &RunJournal, chat: &str, mut entries: Vec<SessionMessageEntry>) -> Vec<SessionMessageEntry> {
+    for part in entries.iter_mut().flat_map(|e| e.parts.iter_mut()) {
+        let MessagePart::Tool { id, call, .. } = part else {
+            continue;
+        };
+        if !matches!(call, ToolCall::Mcp { server, .. } if server == "zeron") {
+            continue;
+        }
+        if let Ok(Some(exchange)) = journal.tool_exchange(chat, id) {
+            *call = exchange.call;
+        }
+    }
+    entries
+}
+
+/// `batch` (children's reports, one or several merged) without what
+/// `parent`'s agent got already from its own wait calls: a turn's end from
+/// a child a call returned since `since` (when the first of them arrived)
+/// waited on. A child on another device can't see its parent waiting, so
+/// the parent's host, which ran the calls, looks. `None`: nothing left.
+pub(crate) fn without_waited(host: &DocHost, parent: &str, batch: &str, since: i64) -> Option<String> {
+    let (Some(reports), Some(blocks)) = (agent_messages::child_reports(batch), agent_messages::report_blocks(batch)) else {
+        return Some(batch.to_owned());
+    };
+    let (Some(engine), Some(ws), Ok(doc)) = (host.sessions(), host.workspace(), host.open(parent)) else {
+        return Some(batch.to_owned());
+    };
+    let entries = doc.doc().read_entries().unwrap_or_default();
+    let from = entries
+        .iter()
+        .rposition(|e| e.role == MessageRole::User && e.created_at <= since)
+        .map_or(0, |at| at + 1);
+    let calls = with_inputs(
+        &engine.inner.journal,
+        parent,
+        entries[from..].iter().filter(|e| e.role == MessageRole::Assistant).cloned().collect(),
+    );
+    let chats = ws.read_chats().unwrap_or_default();
+    let keys: Vec<(&str, Option<&str>)> = chats.iter().map(|c| (c.id.as_str(), c.title.as_deref())).collect();
+    let kept: Vec<&str> = blocks
+        .iter()
+        .zip(&reports)
+        .filter(|(_, r)| {
+            !(matches!(r.status, ReportStatus::Finished | ReportStatus::Failed | ReportStatus::Stopped)
+                && returned(&calls, &r.sender.chat_id, &keys))
+        })
+        .map(|(block, _)| *block)
+        .collect();
+    if kept.len() == blocks.len() {
+        Some(batch.to_owned())
+    } else {
+        (!kept.is_empty()).then(|| agent_messages::merge_reports(&kept))
+    }
+}
+
+/// A wait call in `entries` named `child` and has returned: `wait_for_turn`
+/// on it, or a send to it with `wait`.
+fn returned(entries: &[SessionMessageEntry], child: &str, chats: &[(&str, Option<&str>)]) -> bool {
+    let names = |args: &Value| {
+        args.get("chat")
+            .and_then(Value::as_str)
+            .and_then(|key| agent_messages::resolve_chat_key(key, chats))
+            == Some(child)
+    };
+    let waits = |args: &Value| args.get("wait").and_then(Value::as_bool).unwrap_or(false);
+    entries.iter().flat_map(|e| &e.parts).any(|part| {
+        let MessagePart::Tool {
+            call: ToolCall::Mcp { server, tool, input: Some(input) },
+            resolved: true,
+            is_error: false,
+            ..
+        } = part
+        else {
+            return false;
+        };
+        server == "zeron"
+            && match tool.as_str() {
+                "wait_for_turn" => names(input),
+                "send_message" => waits(input) && names(input),
+                "send_messages" => input
+                    .get("requests")
+                    .and_then(Value::as_array)
+                    .is_some_and(|rs| rs.iter().any(|r| (waits(r) || waits(input)) && names(r))),
+                _ => false,
+            }
+    })
+}
+
+/// The parent's agent is blocked right now in a Zeron call whose result
+/// will carry `child`'s reply: `wait_for_turn` on it, a `send_message(s)` to
+/// it with `wait`, or (for the turn that created it) a `create_chat(s)` with
+/// `wait`. Only the turn streaming now counts: a call cut off in an old turn
+/// never resolves, and waits on nothing.
+fn waits_on(
+    entries: &[SessionMessageEntry],
+    child: &str,
+    first_turn: bool,
+    chats: &[(&str, Option<&str>)],
+) -> bool {
+    let names = |args: &Value| {
+        args.get("chat")
+            .and_then(Value::as_str)
+            .and_then(|key| agent_messages::resolve_chat_key(key, chats))
+            == Some(child)
+    };
+    let waits = |args: &Value| args.get("wait").and_then(Value::as_bool).unwrap_or(false);
+    let requests = |args: &Value| {
+        args.get("requests")
+            .and_then(Value::as_array)
+            .cloned()
+            .unwrap_or_default()
+    };
+    entries
+        .iter()
+        .filter(|e| e.role == MessageRole::Assistant && e.status == Some(MessageStatus::Streaming))
+        .flat_map(|e| &e.parts)
+        .any(|part| {
+            let MessagePart::Tool {
+                call: ToolCall::Mcp { server, tool, input: Some(input) },
+                resolved: false,
+                ..
+            } = part
+            else {
+                return false;
+            };
+            if server != "zeron" {
+                return false;
+            }
+            match tool.as_str() {
+                "wait_for_turn" => names(input),
+                "send_message" => waits(input) && names(input),
+                "send_messages" => requests(input)
+                    .iter()
+                    .any(|r| (waits(r) || waits(input)) && names(r)),
+                "create_chat" => first_turn && waits(input),
+                "create_chats" => {
+                    first_turn && (waits(input) || requests(input).iter().any(waits))
+                }
+                _ => false,
+            }
+        })
+}
+
+/// The reply a finished (or failed, or stopped) turn ends with: the text
+/// closing its last answer, after its last tool call, or the whole answer's
+/// text when it ends on a tool. A failure adds what went wrong.
+fn reply_body(after: &[SessionMessageEntry], status: ReportStatus) -> String {
+    let reply = after
+        .iter()
+        .rev()
+        .filter(|e| e.role == MessageRole::Assistant)
+        .find_map(|e| {
+            let tail = e
+                .parts
+                .iter()
+                .rposition(|p| !matches!(p, MessagePart::Text { .. } | MessagePart::Reasoning { .. }))
+                .map_or(0, |at| at + 1);
+            let closing = text_of(&e.parts[tail..]);
+            let text = if closing.trim().is_empty() { text_of(&e.parts) } else { closing };
+            (!text.trim().is_empty()).then(|| text.trim().to_owned())
+        });
+    let error = (status == ReportStatus::Failed)
+        .then(|| {
+            after.iter().rev().flat_map(|e| e.parts.iter().rev()).find_map(|p| match p {
+                MessagePart::Error { message, .. } => Some(message.trim().to_owned()),
+                _ => None,
+            })
+        })
+        .flatten();
+    [reply, error]
+        .into_iter()
+        .flatten()
+        .filter(|t| !t.is_empty())
+        .collect::<Vec<_>>()
+        .join("\n\n")
+}
+
+/// The question the child's turn stopped on, still unanswered: its request
+/// id and its questions.
+fn open_question(entries: &[SessionMessageEntry]) -> Option<(&str, &[zeron_proto::UserInputQuestion])> {
+    entries.iter().rev().flat_map(|e| e.parts.iter().rev()).find_map(|p| match p {
+        MessagePart::Input {
+            request_id,
+            questions,
+            resolved: false,
+            ..
+        } => Some((request_id.as_str(), questions.as_slice())),
+        _ => None,
+    })
+}
+
+/// A needs-input report: what the child asks, and how the parent answers.
+fn question_body(after: &[SessionMessageEntry], child: &str) -> String {
+    let asked = open_question(after)
+        .map(|(_, questions)| {
+            questions
+                .iter()
+                .map(|q| {
+                    let mut line = q.question.trim().to_owned();
+                    if !q.options.is_empty() {
+                        line.push_str(&format!("\nOptions: {}", q.options.join(" · ")));
+                    }
+                    line
+                })
+                .collect::<Vec<_>>()
+                .join("\n\n")
+        })
+        .unwrap_or_default();
+    capped(
+        format!("{asked}\n\nAnswer with the Zeron `respond_to_input` tool, chat {child}.")
+            .trim()
+            .to_owned(),
+        child,
+    )
+}
+
+/// `body` cut to [`REPORT_CAP`] on a character boundary, saying where the
+/// rest is when it was cut.
+fn capped(body: String, child: &str) -> String {
+    if body.len() <= REPORT_CAP {
+        return body;
+    }
+    let mut end = REPORT_CAP;
+    while !body.is_char_boundary(end) {
+        end -= 1;
+    }
+    format!(
+        "{}\n\n[Cut at 16 KB. Read the whole reply with the Zeron `read_chat` tool, chat {child}.]",
+        body[..end].trim_end()
+    )
+}
+
