+        assert_eq!(ago(4 * 60_000 + 5_000), "4 min");
+        assert_eq!(ago(2 * 3_600_000 + 7 * 60_000), "2 h 7 min");
+        assert_eq!(ago(-5), "0 s");
+    }
+
+    #[test]
+    fn each_report_goes_once() {
+        let reported = Reported::default();
+        assert!(reported.claim("c", "m1", "ask:r1"));
+        assert!(reported.claim("c", "m1", "end"));
+        assert!(!reported.claim("c", "m1", "end"));
+        // A stop's report is its own: the end on the same message still goes.
+        assert!(reported.claim("c", "m1", "stopped"));
+        assert!(reported.claim("c", "m2", "end"), "a new request reports anew");
+        // One that never went is given back, and goes when tried again.
+        reported.release("c", "m2", "end");
+        assert!(reported.claim("c", "m2", "end"));
+        reported.release("c", "m1", "end");
