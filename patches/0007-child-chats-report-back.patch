+/// What child chats reported to this one when a turn it asked for ended, as
+/// ds/transcript's `report`: each child's chat, its title as the header
+/// named it, how its turn ended (`finished`, `failed`, `stopped`,
+/// `needsInput`) and its reply, one for a single report, several for a
+/// merged one. Its text is the replies (what a selection takes), and Copy
+/// copies them with who said each.
+fn report_message(id: &str, entry: &Json, reports: &[zeron_proto::agent_messages::ChildReport<'_>]) -> Value {
+    let status = |r: &zeron_proto::agent_messages::ChildReport<'_>| {
+        serde_json::to_value(r.status).ok().and_then(|s| s.as_str().map(str::to_owned)).unwrap_or_default()
+    };
+    let list: Vec<Value> = reports
+        .iter()
+        .map(|r| {
+            Value::record([
+                ("chat", Value::from(r.sender.chat_id.as_str())),
+                ("title", Value::from(r.sender.title.as_str())),
+                ("status", Value::from(status(r).as_str())),
+                ("body", Value::from(r.body.trim())),
+            ])
+        })
+        .collect();
+    let text = reports.iter().map(|r| r.body.trim()).filter(|b| !b.is_empty()).collect::<Vec<_>>().join("\n\n");
+    let copy = reports
+        .iter()
+        .map(|r| format!("{} ({}):\n{}", r.sender.title, r.status.as_str(), r.body.trim()))
+        .collect::<Vec<_>>()
+        .join("\n\n");
+    let created = entry["createdAt"].as_f64().unwrap_or(0.) / 1000.;
+    Value::record([
+        ("id", Value::from(id)),
+        ("role", Value::from("report")),
+        ("text", Value::from(text.as_str())),
+        ("reports", Value::List(list.into())),
+        ("at", stamp(created as i64).map_or(Value::Nil, |at| Value::from(at.as_str()))),
+        ("copy", copy_value(&copy)),
+    ])
+}
