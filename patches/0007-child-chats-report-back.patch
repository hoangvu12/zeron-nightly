+    fn a_child_s_report_is_a_report_not_a_message_from_it() {
+        use zeron_proto::agent_messages::{ReportStatus, child_report, merge_reports};
+        let id = "cd27c5c2-0000-4000-8000-000000000000";
+        let said = |text: String| {
