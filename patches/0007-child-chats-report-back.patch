diff --git a/apps/zgx/ui/tests/subagent_reports.test.luau b/apps/zgx/ui/tests/subagent_reports.test.luau
new file mode 100644
index 0000000000000000000000000000000000000000..3f9b052c77b9cc1d264a5810b9e684b9fc2f1f84
--- /dev/null
+++ b/apps/zgx/ui/tests/subagent_reports.test.luau
@@ -0,0 +1,298 @@
+-- A chat's children, each drawn as one row wherever they're listed
+-- (ds/subagent_row): what they reported back as their turns ended (one at a
+-- time, or several that landed together), a spawn of Zeron chats or of a
+-- harness's own subagents (ds/spawn_group), and the composer's Running tray.
+-- On ui/chat_fixture.luau, whose child chats are listed under the open chat
+-- (`children_listed`). A report's row says the first of what its child said;
+-- a spawn's and the tray's don't.
+
+local function open(command: string): any
+	local app = mount("chat_fixture.luau")
+	app:resize(1000, 900)
+	app:frames(30)
+	app:command(command)
+	app:frames(40)
+	expect(app:error()).to_be(nil)
+	return app
+end
+
+-- The panel tabs open beside the chat, by kind and title.
+local function tabs(app: any, kind: string, title: string): number
+	local n = 0
+	for _, s in (app:state("panel_sessions") :: any) or {} do
+		for _, tab in s.tabs do
+			if tab.kind == kind and tab.title == title then
+				n += 1
+			end
+		end
+	end
+	return n
+end
+
+-- Whether a button is on screen (a folded list keeps its rows laid out of
+-- the way, hidden or clipped to nothing).
+local function shown(app: any, label: string): boolean
+	for line in app:tree():gmatch("[^\n]+") do
+		if line:find(`button "{label}"`, 1, true) then
+			return not line:find(" hidden", 1, true) and not line:find("x0$") and not line:find(" 0x", 1, true)
+		end
+	end
+	return false
+end
+
+-- Where `word` first stands in the transcript's tree (to say what's above what).
+local function at(tree: string, word: string): number
+	return (string.find(tree, word, 1, true) :: number?) or math.huge
+end
+
+test("a child's report is its row on a card, not a bubble: its title as its chat is called now, how it ended, the first of what it said", function()
+	local app = open("child_reports")
+	local tree = app:tree("#transcript")
+	expect(tree).to_contain("Review API compatibility")
+	expect(string.find(tree, "Old API title", 1, true)).to_be(nil)
+	expect(tree).to_contain("Finished")
+	-- What it said, under its title as plain words (the rest is its chat's,
+	-- a click away).
+	expect(app:has('.report-card >> .subagent-row-preview >> ~"No breaking changes to public endpoints"')).to_be(true)
+	expect(app:has('.report-card >> .subagent-row-preview >> ~"POST /session still accepts remember"')).to_be(true)
+	expect(string.find(tree, "`POST", 1, true)).to_be(nil)
+	expect(app:has('.report-card >> role:button "Open Review API compatibility"')).to_be(true)
+	-- The header is the agent's, never shown.
+	expect(string.find(tree, "Report from", 1, true)).to_be(nil)
+	expect(string.find(tree, "Reply to it with", 1, true)).to_be(nil)
+	expect(app:has('role:button "Open Review API compatibility"')).to_be(true)
+	-- A subagent says so; a side chat too.
+	expect(app:has('role:button "Open Review API compatibility" >> "Subagent"')).to_be(true)
+	expect(app:has('role:button "Open Update auth docs" >> "Side chat"')).to_be(true)
+end)
+
+test("each way a turn ends has its word, and one asking for the person has Answer", function()
+	local app = open("child_reports")
+	expect(app:has('role:button "Open Fix flaky login tests" >> "Failed"')).to_be(true)
+	-- A failure's words are noise cut off: its glyph says it.
+	expect(app:has('role:button "Open Fix flaky login tests" >> ~"cargo test exited 101"')).to_be(false)
+	expect(app:has('role:button "Open Update auth docs" >> "Stopped"')).to_be(true)
+	expect(app:has('role:button "Open Update auth docs" >> .subagent-row-preview')).to_be(false)
+	expect(app:has('role:button "Open Write the session migration" >> "Needs input"')).to_be(true)
+	-- One asking says what.
+	expect(app:has('role:button "Open Write the session migration" >> ~"Drop the old sessions table now"')).to_be(true)
+	expect(app:has('role:button "Answer Write the session migration"')).to_be(true)
+	expect(app:has('role:button "Answer Fix flaky login tests"')).to_be(false)
+	expect(app:has('role:button "Answer Review API compatibility"')).to_be(false)
+end)
+
+test("a report's row opens its child beside this chat, and Answer opens the one asking", function()
+	local app = open("child_reports")
+	app:click('role:button "Open Review API compatibility"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "Review API compatibility")).to_be(1)
+	app:click('role:button "Answer Write the session migration"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "Write the session migration")).to_be(1)
+	-- The chat stays.
+	expect(app:has('role:button "Open Review API compatibility"')).to_be(true)
+	expect(app:error()).to_be(nil)
+end)
+
+test("reports that landed together are a spawn's block: what they are, how they stand, asking and failed first", function()
+	local app = open("merged_report")
+	local tree = app:tree("#transcript")
+	expect(app:has('role:button "5 subagents reported"')).to_be(true)
+	expect(tree).to_contain("3 finished, 1 failed, 1 needs input")
+	-- Asking first, then failed, then finished, each as listed now; chats no
+	-- longer listed read as they reported.
+	expect(at(tree, "Write the session migration") < at(tree, "Fix flaky login tests")).to_be(true)
+	expect(at(tree, "Fix flaky login tests") < at(tree, "Review API compatibility")).to_be(true)
+	expect(tree).to_contain("zeron-text")
+	expect(tree).to_contain("zeron-rpc")
+	expect(app:has('role:button "Answer Write the session migration"')).to_be(true)
+	-- Each row says the first of what its child said, but a failure's.
+	expect(app:has('role:button "Open zeron-text" >> .subagent-row-preview >> "Clean"')).to_be(true)
+	expect(app:has('role:button "Open Write the session migration" >> ~"Vendored acp code has 3 unwraps"')).to_be(true)
+	expect(string.find(tree, "cargo test hung", 1, true)).to_be(nil)
+	-- Its head folds them away.
+	app:click('role:button "5 subagents reported"')
+	app:frames(40)
+	expect(shown(app, "Open zeron-rpc")).to_be(false)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a spawn's head says what kind they are, and with both kinds each side chat's row says so", function()
+	local app = open("spawned_mixed")
+	expect(app:has('role:button "2 subagents, 1 side chat"')).to_be(true)
+	expect(app:has('role:button "Open Update auth docs" >> "Side chat"')).to_be(true)
+	expect(app:has('role:button "Open zeron-sync" >> "Subagent"')).to_be(true)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a create_chats spawn is one live block of its chats: marks, counts, how long, asking first", function()
+	local app = open("spawned_chats")
+	local tree = app:tree("#transcript")
+	expect(app:has('role:button "6 subagents"')).to_be(true)
+	expect(tree).to_contain("3 running")
+	expect(tree).to_contain("1 finished")
+	expect(tree).to_contain("1 failed")
+	expect(tree).to_contain("1 needs input")
+	-- How long it has run, while any does.
+	expect(tree).to_contain("3m 4")
+	-- Each chat as it's called and stands now; one not made yet, as asked.
+	expect(at(tree, "Write the session migration") < at(tree, "Fix flaky login tests")).to_be(true)
+	expect(at(tree, "Fix flaky login tests") < at(tree, "zeron-sync")).to_be(true)
+	expect(at(tree, "zeron-sync") < at(tree, "Review API compatibility")).to_be(true)
+	-- In a spawn, a row is its title and how it stands: it has said nothing
+	-- yet, and what it says is the chat's, a click away.
+	expect(app:has('role:button "Open zeron-sync" >> "Running"')).to_be(true)
+	expect(string.find(tree, "Reading crates/sync/src/peer.rs", 1, true)).to_be(nil)
+	expect(app:has("#transcript >> .subagent-row-preview")).to_be(false)
+	expect(app:has('role:button "Open zeron-doc" >> "Running"')).to_be(true)
+	-- It follows its chats as they go.
+	app:command("child_finishes")
+	app:frames(30)
+	tree = app:tree("#transcript")
+	expect(tree).to_contain("2 running")
+	expect(tree).to_contain("2 finished")
+	expect(app:has('role:button "Open zeron-sync" >> "Finished"')).to_be(true)
+	-- A row opens its chat beside this one.
+	app:click('role:button "Open zeron-sync"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "zeron-sync")).to_be(1)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a spawned chat at rest reads as its report said it ended, not finished", function()
+	local app = open("spawned_chats")
+	expect(app:tree("#transcript")).to_contain("1 failed")
+	app:command("spawned_reported_failed")
+	app:frames(30)
+	expect(app:tree("#transcript")).to_contain("2 failed")
+	expect(app:error()).to_be(nil)
+end)
+
+test("Zeron's notes under a report are its agent's: none is shown", function()
+	local app = open("child_reports")
+	app:frames(5)
+	-- (As a host that still sent them would.)
+	app:command("report_with_notes")
+	app:frames(30)
+	local tree = app:tree("#transcript")
+	expect(tree).to_contain("Index the docs")
+	expect(string.find(tree, "Still working for you", 1, true)).to_be(nil)
+	expect(app:error()).to_be(nil)
+end)
+
+test("children's messages are their rows too, standing as their chats do now", function()
+	local app = open("child_messaged")
+	local tree = app:tree("#transcript")
+	expect(app:has('role:button "2 subagents reported"')).to_be(true)
+	-- A message says nothing of how a turn ends: one working runs.
+	expect(app:has('role:button "Open zeron-sync" >> "Running"')).to_be(true)
+	expect(app:has('role:button "Open Review API compatibility" >> "Finished"')).to_be(true)
+	-- What one at rest said is under its title; one still working says
+	-- nothing yet (its chat has the rest, a click away).
+	expect(string.find(tree, "Halfway", 1, true)).to_be(nil)
+	expect(app:has('role:button "Open Review API compatibility" >> .subagent-row-preview >> "Which branch should I base on?"')).to_be(true)
+end)
+
+test("a message after a child's report doesn't change how its spawn says it ended", function()
+	local app = open("spawned_chats")
+	app:command("spawned_reported_failed")
+	app:frames(30)
+	expect(app:tree("#transcript")).to_contain("2 failed")
+	app:command("child_messaged")
+	app:frames(30)
+	expect(app:tree("#transcript")).to_contain("2 failed")
+	expect(app:error()).to_be(nil)
+end)
+
+test("a spawn's head folds its list away and opens it again", function()
+	local app = open("spawned_chats")
+	expect(shown(app, "Open zeron-engine")).to_be(true)
+	app:click('role:button "6 subagents"')
+	app:frames(40)
+	expect(shown(app, "Open zeron-engine")).to_be(false)
+	app:click('role:button "6 subagents"')
+	app:frames(40)
+	expect(shown(app, "Open zeron-engine")).to_be(true)
+end)
+
+test("a spawn whose doc kept no chats lists the children made during its reply, not one nameless row", function()
+	local app = open("spawned_from_the_list")
+	local tree = app:tree("#transcript")
+	expect(app:has('role:button "3 subagents"')).to_be(true)
+	expect(app:has('role:button "Open Count crates" >> "Running"')).to_be(true)
+	expect(app:has('role:button "Open Summarise agent_messages" >> "Finished"')).to_be(true)
+	expect(app:has('role:button "Answer Ask the person"')).to_be(true)
+	-- Each says how long it ran (from its start to its last word), or has
+	-- run, going; and that a click opens it.
+	expect(app:has('role:button "Open Summarise agent_messages" >> "1m 35s"')).to_be(true)
+	expect(string.match(app:tree('role:button "Open Count crates"'), '"%d+s"') ~= nil).to_be(true)
+	-- Its head, how long they all took: the first one's start to the last
+	-- word said (Summarise's, at 97 s in; Count crates, working, is under it).
+	expect(app:has('role:button "3 subagents" >> "1m 36s"')).to_be(true)
+	-- One made before this reply is another's.
+	expect(string.find(tree, "An earlier subagent", 1, true)).to_be(nil)
+	expect(app:has('role:button "Open Subagent"')).to_be(false)
+	app:click('role:button "Open Count crates"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "Count crates")).to_be(1)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a spawn of one chat is its row alone on a card, as a report of one is, with no group around it", function()
+	local app = open("spawned_one")
+	expect(app:has('role:button "1 subagent"')).to_be(false)
+	expect(app:has('.spawn-card >> role:button "Open Count crates" >> "Running"')).to_be(true)
+	expect(app:has(".spawn-card >> .subagent-row-preview")).to_be(false)
+	app:click('role:button "Open Count crates"')
+	app:frames(40)
+	expect(tabs(app, "side_chat", "Count crates")).to_be(1)
+	expect(app:error()).to_be(nil)
+end)
+
+test("a harness's subagents side by side are one block too, and one alone is its row on the tree", function()
+	local app = open("native_spawns")
+	expect(app:has('role:button "2 subagents"')).to_be(true)
+	expect(app:has('role:button "Open scan the repo" >> "Running"')).to_be(true)
+	expect(app:has('role:button "Open read the docs" >> "Finished"')).to_be(true)
