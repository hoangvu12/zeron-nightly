+        kid.feed.send(text("Watching.")).unwrap();
+        kid.feed.send(done(DoneStatus::Completed)).unwrap();
+        rig.until("the end report", |r| r.heard().len() == 1).await;
+        let wake = |said: &'static str| {
+            let rig = &rig;
+            let kid = &kid;
