+/// The settled turn [`classify_settled_turn`] reads: the child's doc, how
+/// its turn ended, and when.
+pub(super) struct SettledTurn<'a> {
+    pub entries: &'a [SessionMessageEntry],
+    pub commands: &'a [SessionCommandEntry],
+    pub status: ReportStatus,
+    pub stop: Option<&'a TurnStop>,
+    /// When it settled, on its host's clock.
+    pub settled_at: i64,
+    /// The child still runs background work, or waits on some.
+    pub background: bool,
+}
+
+/// What a settled turn is to the child's parent.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Verdict {
+    /// A report, as `stage`, on the parent's message at `at` in the child's
+    /// transcript; `follow_up` when it's the one turn the child started on
+    /// its own after its end report.
+    Report { at: usize, status: ReportStatus, stage: String, follow_up: bool },
+    /// The person's Stop: filed in the parent's ledger without waking it
+    /// (the next start skips it, its notes say so), and the parent's
+    /// message stays open for what the person writes next.
+    Quiet { at: usize },
+    /// Nothing for the parent; why, for the log.
+    Skip(&'static str),
+}
+
+/// The one rule for what a child's settled turn is to its parent, the same
+/// for the turn's own settle and for the next start's catch-up
+/// ([`owed_on_boot`]), so the two never drift apart.
+///
+/// A message from the parent opens a request. The first turn that settles
+/// after it answers it, whoever wrote to the child meanwhile, and reports
+/// once. A turn the person's Stop ended doesn't answer it: their Stop is
+/// filed quietly, and the turn after what they write next answers it. Once
+/// it's answered, a turn the person started is theirs. Only a question, and
+/// one follow-up (the first turn the child starts on its own once the work
+/// it left running is done, when its end said it left some), still report.
+pub(super) fn classify_settled_turn(host: &DocHost, child: &str, parent: &str, turn: &SettledTurn) -> Verdict {
+    let SettledTurn { entries, commands, stop, .. } = *turn;
+    let stop_command = match stop {
+        Some(TurnStop::Command(id)) => commands.iter().find(|c| &c.id == id),
+        _ => None,
+    };
+    let status = if stop.is_some() && turn.status != ReportStatus::NeedsInput {
+        ReportStatus::Stopped
+    } else {
+        turn.status
+    };
+    // A stopped turn answered what was sent before its Stop (strictly: one
+    // sent in the same millisecond came with it, not before): the parent's
+    // next message, sent after it, may be in already, its turn not begun.
+    let cut = stop_command.map_or(turn.settled_at, |c| c.issued_at - 1);
+    let Some(at) = request_for_turn(entries, parent, cut) else {
+        return Verdict::Skip("the person's chat alone, or another chat's");
+    };
+    let asked = &entries[at];
+    let after = answer_to(entries, at, parent);
+    // A turn its runtime called done that ended on an error (the provider
+    // refused the request) failed, and the parent hears why.
+    let status = if status == ReportStatus::Finished && ends_on_error(after) {
+        ReportStatus::Failed
+    } else {
+        status
+    };
+    if stopped_by_parent(commands, parent, asked) {
+        return Verdict::Skip("its parent stopped it");
+    }
+    // The parent's ledger says what it heard. One that can't be read is
+    // taken as having nothing: a report sent twice is dropped there.
+    let filed = filed(host, parent, child, &asked.id).unwrap_or_default();
+    let heard = answered(&filed).or_else(|| delivered(host, parent, child, asked, "end").then_some(i64::MIN));
+    let question = || match open_question(after) {
+        Some((request_id, _)) => Verdict::Report {
+            at,
+            status: ReportStatus::NeedsInput,
+            stage: format!("ask:{request_id}"),
+            follow_up: false,
+        },
+        None => Verdict::Skip("its question was answered already"),
+    };
+    let Some(heard) = heard else {
+        // This turn answers the request.
+        return match status {
+            ReportStatus::NeedsInput => question(),
+            ReportStatus::Stopped => {
+                let by = stop_command.and_then(|c| match &c.payload {
+                    SessionCommandPayload::Interrupt { stopped_by } => stopped_by.clone(),
+                    _ => None,
+                });
+                // The person's Stop (or one nobody's agent claims, from an
+                // engine that never said who sent it): theirs to follow up.
+                if stop.is_some() && by.is_none() {
+                    Verdict::Quiet { at }
+                } else {
+                    Verdict::Report { at, status, stage: "stopped".into(), follow_up: false }
+                }
+            }
+            _ => Verdict::Report { at, status, stage: "end".into(), follow_up: false },
+        };
+    };
+    if person_since(entries, commands, at, heard) {
+        return Verdict::Skip("the person wrote to it since its report: it's theirs");
+    }
+    match status {
+        ReportStatus::NeedsInput => question(),
+        ReportStatus::Stopped => Verdict::Skip("a stop after its report"),
+        _ => {
+            // A turn it started on its own (its background work woke it).
+            if !filed.iter().any(|f| f.stage == "end" && f.text.contains(BACKGROUND)) {
+                return Verdict::Skip("its end left nothing running: no follow-up");
+            }
+            if filed.iter().any(|f| f.stage.starts_with("end-")) {
+                return Verdict::Skip("its one follow-up went already");
+            }
+            if turn.background {
+                return Verdict::Skip("its background work still runs");
+            }
+            let Some(last) = after.iter().rev().find(|e| e.role == MessageRole::Assistant) else {
+                return Verdict::Skip("no answer");
+            };
+            if last.created_at <= heard {
+                return Verdict::Skip("the reported turn settling again");
+            }
+            Verdict::Report { at, status, stage: format!("end:{}", last.id), follow_up: true }
+        }
+    }
+}
