+/// The Stop that ended a child's turn, as the host that ran it saw it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum TurnStop {
+    /// A Stop command in the child's doc (its id), which says who sent it.
+    Command(String),
+    /// A Stop that came no other way than through this engine (a "send
+    /// now", a voice chat's): nobody's agent sent it, so the person did.
+    Unattributed,
+}
