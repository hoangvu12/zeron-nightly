+/// File the person's Stop on `child`'s turn in its parent's ledger, keyed
+/// [`QUIET`]: its host never shows it to the agent. Once per message.
+fn file_persons_stop(host: &DocHost, reported: &Reported, child: &Chat, parent: &str, asked: &SessionMessageEntry) {
+    // Claimed apart from the `stopped` stage, which another chat's agent's
+    // Stop on the same message still reports by.
+    if persons_stop_filed(host, parent, &child.id, &asked.id) || !reported.claim(&child.id, &asked.id, PERSONS_STOP) {
         return;
+    }
+    let label = crate::rpc::agent_gate::label(Some(child), &child.id);
+    let text = agent_messages::child_report(
+        &label,
+        &child.id,
+        ReportStatus::Stopped,
+        "The person stopped it. What they write to it next carries on your task.",
+    );
+    let key = format!("{}{QUIET}", report_id(&child.id, &asked.id, "stopped"));
+    if queue_report(host, reported, &child.id, parent, &asked.id, PERSONS_STOP, key, &text) {
+        tracing::info!(chat = %child.id, %parent, "the person stopped it: filed, not reported");
+    }
+}
