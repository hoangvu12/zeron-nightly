+/// The child's answer to the parent's message at `at`: what follows it, up
+/// to the parent's next message, if one is in.
+fn answer_to<'a>(entries: &'a [SessionMessageEntry], at: usize, parent: &str) -> &'a [SessionMessageEntry] {
+    let after = &entries[at + 1..];
+    after
+        .iter()
+        .position(|e| e.role == MessageRole::User && from_parent(&text_of(&e.parts), parent))
+        .map_or(after, |next| &after[..next])
+}
