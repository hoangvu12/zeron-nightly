+/// The Stop sent the child after the parent's message `asked`, when nothing
+/// sent after it started another turn: the one that ended its last turn.
+fn stop_after(commands: &[SessionCommandEntry], asked: &str) -> Option<String> {
+    let sent = |c: &SessionCommandEntry, id: &str| match &c.payload {
+        SessionCommandPayload::Run { message_id, .. } => message_id == id,
+        SessionCommandPayload::Steer { message_id, .. } => message_id.as_deref().unwrap_or(&c.id) == id,
+        _ => false,
+    };
+    let from = commands.iter().position(|c| sent(c, asked)).map_or(0, |at| at + 1);
+    let stop = commands[from..]
+        .iter()
+        .rposition(|c| matches!(c.payload, SessionCommandPayload::Interrupt { .. }))?
+        + from;
+    let later = commands[stop + 1..]
+        .iter()
+        .any(|c| matches!(c.payload, SessionCommandPayload::Run { .. } | SessionCommandPayload::Steer { .. }));
+    (!later).then(|| commands[stop].id.clone())
+}
