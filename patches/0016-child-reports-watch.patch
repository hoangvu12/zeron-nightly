+/// Whether a parent's ledger (`commands`) has the report `held` (filed
+/// under `key`) kept from its agent already under another mark: another
+/// pusher's `-waited` or `-quiet` of it, by its structured `(child, asked,
+/// stage)`. Never a `stopped` (see [`DocHost::drop_kept`]), nor a report
+/// whose key says nothing of what it's on.
+fn kept_already(commands: &[SessionCommandEntry], held: &HeldReport, key: &str) -> bool {
+    held.stage != "stopped"
+        && !held.asked.is_empty()
+        && commands.iter().any(|c| match &c.payload {
+            SessionCommandPayload::Run { message_id, .. } => {
+                message_id != key
+                    && (message_id.ends_with(crate::sessions::REPORT_WAITED)
+                        || message_id.ends_with(crate::sessions::REPORT_QUIET))
+                    && crate::sessions::report_key_parts(message_id, &held.child)
+                        .is_some_and(|(asked, stage)| asked == held.asked && stage == held.stage)
+            }
+            _ => false,
+        })
+}
