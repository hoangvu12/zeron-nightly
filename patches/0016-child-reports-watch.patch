+/// at `since` (the child's host's clock, as its reports are stamped): its
+/// `· message` reports in the parent's ledger.
+fn messages_in_ledger(host: &DocHost, parent: &str, child: &str, since: i64) -> Vec<String> {
+    let ledger = host
+        .open(parent)
+        .ok()
+        .and_then(|doc| doc.doc().read_commands().ok())
+        .unwrap_or_default();
+    ledger
+        .iter()
+        .filter(|c| c.issued_at >= since)
+        .filter_map(|c| match &c.payload {
+            SessionCommandPayload::Run { request, .. } => agent_messages::child_reports(&request.prompt),
+            _ => None,
+        })
+        .flatten()
+        .filter(|r| r.sender.chat_id == child && r.status == ReportStatus::Message)
+        .map(|r| r.body.to_owned())
+        .collect()
+}
