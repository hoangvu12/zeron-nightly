+    /// A report kept from the agent (keyed `key`, `-waited` or `-quiet`:
+    /// its wait returned it, or a thanks was answered) wins over the same
+    /// report held plain from another pusher, matched by its structured
+    /// `(child, asked, stage)`: let go unsaid, alone in its row, or as its
+    /// child's one block in a merged one (one it can't single out stays).
+    /// Never a `stopped`: the person's, kept quiet, leaves another agent's
+    /// Stop on the same message to report.
+    fn drop_kept(&self, handle: &Arc<ChatDocHandle>, key: &str, prompt: &str) -> Result<(), EngineError> {
+        let Some(child) = zeron_proto::agent_messages::child_reports(prompt)
+            .and_then(|reports| reports.first().map(|r| r.sender.chat_id.clone()))
+        else {
+            return Ok(());
+        };
+        let Some((asked, stage)) = crate::sessions::report_key_parts(key, &child) else {
+            return Ok(());
+        };
+        if stage == "stopped" {
+            return Ok(());
+        }
+        let same = |h: &HeldReport| h.kind == HeldKind::Report && h.child == child && h.asked == asked && h.stage == stage;
+        let mut dropped = false;
+        for row in handle.doc.read_queue()?.into_iter().filter(|row| held_report_row(row)) {
+            let held = held_of(&row);
+            if !held.iter().any(|h| same(h)) {
+                continue;
+            }
+            let rest: Vec<HeldReport> = held.iter().filter(|h| !same(*h)).cloned().collect();
+            if rest.is_empty() {
+                handle.doc.take_queued(&row.id)?;
+                lock(&handle.held_sends).remove(&row.id);
+            } else {
+                let (Some(reports), Some(blocks)) = (
+                    zeron_proto::agent_messages::child_reports(&row.text),
+                    zeron_proto::agent_messages::report_blocks(&row.text),
+                ) else {
+                    continue;
+                };
+                let theirs: Vec<usize> =
+                    reports.iter().enumerate().filter(|(_, r)| r.sender.chat_id == child).map(|(i, _)| i).collect();
+                let [one] = theirs.as_slice() else {
+                    continue;
+                };
+                let kept: Vec<&str> =
+                    blocks.iter().enumerate().filter(|(i, _)| i != one).map(|(_, block)| *block).collect();
+                let text = zeron_proto::agent_messages::merge_reports(&kept);
+                handle.doc.set_queued_text(&row.id, &text, now_ms())?;
+                handle.doc.set_queued_held(&row.id, &rest)?;
+                if let Some(held) = lock(&handle.held_sends).get_mut(&row.id) {
+                    held.prompt = text;
+                }
+            }
+            dropped = true;
+            tracing::info!(chat = %handle.chat_id, %child, %stage, "a report held plain, kept from the agent under another mark: let go");
+        }
+        if dropped {
+            handle.publish_queue();
+        }
+        Ok(())
+    }
