+/// Tell `parent` how `child`'s turn on its message `asked` ended, its row
+/// saying so long enough with its chat still not synced here ([`reconcile`]):
+/// its status alone, under [`UNSYNCED`], once. Its full end follows when
+/// the chat syncs.
+fn file_unsynced(
+    host: &DocHost,
+    reported: &Reported,
+    child: &Chat,
+    parent: &str,
+    asked: &SessionMessageEntry,
+    status: ReportStatus,
+) {
+    if delivered(host, parent, &child.id, asked, UNSYNCED) || !reported.claim(&child.id, &asked.id, UNSYNCED) {
+        return;
+    }
+    let label = crate::rpc::agent_gate::label(Some(child), &child.id);
+    let text = agent_messages::child_report(
+        &label,
+        &child.id,
+        status,
+        "Its chat hasn't synced to this device yet, so open it for the reply. Its full report follows once it has.",
+    );
+    let key = report_id(&child.id, &asked.id, UNSYNCED);
+    if queue_report(host, reported, &child.id, parent, &asked.id, UNSYNCED, key, &text) {
+        tracing::info!(chat = %child.id, %parent, status = status.as_str(), "a watched child's status, its chat not synced yet");
+    }
