+// ---- The parent's watch: children whose hosts don't report (2b) ----
+
+/// How long after this host first saw a watched child's turn settled on
+/// the parent's message, what its chat says of it still not synced here,
+/// the parent hears it ended anyway, the reply to follow ([`UNSYNCED`]).
+/// `ZERON_REPORT_UNSYNCED_MS` sets it for tests.
+const UNSYNCED_AFTER_MS: i64 = 10 * 60 * 1000;
+
+fn unsynced_after_ms() -> i64 {
+    std::env::var("ZERON_REPORT_UNSYNCED_MS")
+        .ok()
+        .and_then(|ms| ms.parse().ok())
+        .unwrap_or(UNSYNCED_AFTER_MS)
+}
+
+/// The stage of a watched child's status-only report ([`file_unsynced`]).
+/// None of an end's or a stop's names, so it's no end anywhere (not
+/// [`delivered`]'s, [`answered`]'s, a group's, a pause's): the request stays
+/// open, and its full end still goes, once, when its chat syncs.
+pub(super) const UNSYNCED: &str = "unsynced";
+
+/// How long before its row says a watched child's turn finished, its
+/// failed or cut-off last answer may have ended (both on its host's clock).
+const FAILED_WITHIN_MS: i64 = 60_000;
+
+/// How long a device unheard from is offline (the Devices page's window).
+const OFFLINE_AFTER_MS: i64 = 70_000;
+
+/// When the watch looks again at a doc it waits on with nothing new: this
+/// long at first, twice as long each time, up to the second.
+const WATCH_RETRY_MS: (i64, i64) = (1_000, 30_000);
+
+/// When the watch looks again with nothing to wait on.
+const WATCH_IDLE_MS: i64 = 5 * 60 * 1000;
+
+/// A doc that changed is looked at once it has been still this long.
+const WATCH_SETTLE_MS: u64 = 250;
+
+/// What the watch keeps between looks: by child, the outcome its row says
+/// its turn settled with (when it finished, on its host's clock) and when
+/// this host first saw it so (its own clock).
+type Seen = HashMap<String, (i64, i64)>;
+
+/// What one look found: the docs of children whose end hasn't synced here
+/// yet, looked at again as they change, and when a status-only report next
+/// falls due.
+#[derive(Default)]
+struct Look {
+    waiting: Vec<Arc<ChatDocHandle>>,
+    due: Option<i64>,
+}
+
+/// The parent's side of a child whose host doesn't report its turns by
+/// itself (its device lacks `child-reports`: an older Zeron). This host,
+/// hosting the parent, files the child's report as the child's host would:
+/// by the same rule ([`classify_settled_turn`]), under the same key, once
+/// the child's registry row says its turn settled and its doc, synced here,
+/// shows that very turn ([`reconcile`]). A child whose host reports too
+/// (it updated meanwhile) is no harm: both check the ledger first, and the
+/// parent's host files a key once.
+///
+/// It looks at every such child on start, whenever the registry's session
+/// rows or chats change, when a device's capabilities change or it comes
+/// back, as a doc it waits on changes, and every while. As long as its
+/// engine runs.
+pub(super) async fn watch_children(inner: Weak<super::Inner>, ws: WorkspaceHost) {
+    let mut rows = ws.watch_session_rows();
+    let mut chats = ws.watch_chats();
+    let mut devices = ws.watch_devices();
+    let mut known = device_marks(&devices.borrow_and_update());
+    let mut seen = Seen::new();
+    let mut retry = WATCH_RETRY_MS.0;
+    loop {
+        let _ = rows.borrow_and_update();
+        let _ = chats.borrow_and_update();
+        let look = {
+            let Some(inner) = inner.upgrade() else {
+                return;
+            };
+            let Some(host) = inner.doc_host() else {
+                return;
+            };
+            let floor = inner.journal.child_reports_watch_since(now_ms()) - OWED_FLOOR_MARGIN_MS;
+            look(&host, &inner.journal, &inner.reported, floor, &mut seen).await
+        };
+        let now = now_ms();
+        let next = now + if look.waiting.is_empty() { WATCH_IDLE_MS } else { retry };
+        let next = look.due.map_or(next, |due| due.min(next));
+        let deadline =
+            tokio::time::Instant::now() + std::time::Duration::from_millis(u64::try_from(next - now).unwrap_or(0));
+        let mut docs: Vec<watch::Receiver<u64>> = look.waiting.iter().map(|handle| handle.changes()).collect();
+        loop {
+            tokio::select! {
+                changed = rows.changed() => {
+                    if changed.is_err() {
+                        return;
+                    }
+                    retry = WATCH_RETRY_MS.0;
+                    break;
+                }
+                changed = chats.changed() => {
+                    if changed.is_err() {
+                        return;
+                    }
+                    retry = WATCH_RETRY_MS.0;
+                    break;
+                }
+                changed = devices.changed() => {
+                    if changed.is_err() {
+                        return;
+                    }
+                    let now_known = device_marks(&devices.borrow_and_update());
+                    if now_known != known {
+                        known = now_known;
+                        retry = WATCH_RETRY_MS.0;
+                        break;
+                    }
+                }
+                _ = any_change(&mut docs) => {
+                    tokio::time::sleep(std::time::Duration::from_millis(WATCH_SETTLE_MS)).await;
+                    break;
+                }
+                _ = tokio::time::sleep_until(deadline) => {
+                    retry = (retry * 2).min(WATCH_RETRY_MS.1);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+/// The next change to any of `docs`; never, with none.
+async fn any_change(docs: &mut [watch::Receiver<u64>]) {
+    if docs.is_empty() {
+        return std::future::pending().await;
+    }
+    let _ = futures::future::select_all(docs.iter_mut().map(|doc| Box::pin(doc.changed()))).await;
+}
+
+/// Each device as the watch tells them apart: whether it reports its chats'
+/// turns by itself, and whether it's online. A change in either (an update,
+/// a device back) is worth a look.
+fn device_marks(devices: &[Device]) -> Vec<(String, bool, bool)> {
+    let now = Utc::now();
+    devices
+        .iter()
+        .map(|d| (d.id.clone(), d.supports(zeron_proto::capabilities::CHILD_REPORTS), online(d, now)))
+        .collect()
+}
+
+/// `device` was heard from within [`OFFLINE_AFTER_MS`] of `now`.
+fn online(device: &Device, now: chrono::DateTime<Utc>) -> bool {
+    device
+        .last_seen_at
+        .is_some_and(|at| (now - at).num_milliseconds() <= OFFLINE_AFTER_MS)
+}
+
+/// One look at every child this host watches for ([`watch_children`]): a
+/// child of a parent chat hosted here, itself hosted on a device that
+/// doesn't report by itself (no `child-reports` on its row, or no row),
+/// whose session row moved since `floor` (when the watch came to this
+/// host, less a margin: older work is history).
+async fn look(host: &DocHost, journal: &Arc<RunJournal>, reported: &Arc<Reported>, floor: i64, seen: &mut Seen) -> Look {
+    let mut look = Look::default();
+    let Some(ws) = host.workspace() else {
+        return look;
+    };
+    let (Ok(chats), Ok(devices), Ok(rows)) = (ws.read_chats(), ws.read_devices(), ws.read_sessions()) else {
+        return look;
+    };
+    let here = |id: &str| chats.iter().any(|c| c.id == id && c.device_id == host.device_id());
+    let children: Vec<&Chat> = chats
+        .iter()
+        .filter(|c| {
+            !c.archived && c.parent_chat_id.as_deref().is_some_and(|parent| here(parent)) && watched(c, &devices, host.device_id())
+        })
+        .collect();
+    seen.retain(|id, _| children.iter().any(|c| &c.id == id));
+    let now = now_ms();
+    for child in children {
+        let Some(parent) = child.parent_chat_id.as_deref() else {
+            continue;
+        };
+        let Some(row) = last_row_of(child, &rows).filter(|row| row.updated_at.timestamp_millis() >= floor) else {
+            continue;
+        };
+        if let Some((handle, due)) = reconcile(host, journal, reported, child, parent, row, floor, now, seen).await {
+            look.waiting.push(handle);
+            look.due = due.into_iter().chain(look.due).min();
+        }
+    }
+    look
+}
+
+/// Bring the parent's ledger up to `child`'s settled turn, as its own host
+/// would have (see [`watch_children`]). Its row (`row`, from its device)
+/// says how the turn ended; its doc, synced here, must show that very turn
+/// before anything goes, never a body from a doc half in:
+/// - finished: the answer its row names (`last_completed_turn`) is there,
+///   after the parent's message;
+/// - failed or stopped: its last answer after the parent's message, cut off
+///   or ending on an error (or a Stop after it), ended within
+///   [`FAILED_WITHIN_MS`] before its row's outcome did;
+/// - asking: its question is there, unanswered.
+///
+/// Then the report goes as its host's settle would send it
+/// ([`report_turn_end`]). Short of that, the doc is looked at again as it
+/// changes. Once the row has said so for [`unsynced_after_ms`], and it's
+/// this request's (its turn finished after the parent's message, both on
+/// the child's clock, and nothing newer is on its way), the parent hears its
+/// status alone ([`file_unsynced`]); not this request's, nothing (the
+/// parent's notes say its status is unconfirmed, [`roster`]).
+///
+/// Only a request still open keeps the child's doc syncing here. `Some`:
+/// the doc, still waited on, and when its status-only report falls due.
+#[allow(clippy::too_many_arguments)]
+async fn reconcile(
+    host: &DocHost,
+    journal: &Arc<RunJournal>,
+    reported: &Arc<Reported>,
+    child: &Chat,
+    parent: &str,
+    row: &Session,
+    floor: i64,
+    now: i64,
+    seen: &mut Seen,
+) -> Option<(Arc<ChatDocHandle>, Option<i64>)> {
+    // Still at it (or waiting on its background work): its end isn't in.
+    if row.status == SessionStatus::Working || row.waiting.is_some() {
+        seen.remove(&child.id);
+        return None;
+    }
+    let handle = host.open_local(&child.id).ok()?;
+    let entries = handle.doc().read_entries().unwrap_or_default();
+    let commands = handle.doc().read_commands().unwrap_or_default();
+    let interrupted = row.last_turn_outcome.as_ref().is_some_and(|o| o.status == DoneStatus::Interrupted);
+    let open = request_message(&entries, parent).filter(|&at| {
+        let asked = &entries[at];
+        asked.created_at >= floor
+            && !stopped_by_parent(&commands, parent, asked)
+            && (row.status == SessionStatus::AwaitingInput
