+/// The candidate pair ICE selected, from a stats report.
+fn describe_route(report: &RTCStatsReport) -> Option<String> {
+    let selected = report
+        .transport()
+        .map(|transport| transport.selected_candidate_pair_id.as_str())
+        .filter(|id| !id.is_empty());
+    let pair = report
+        .candidate_pairs()
+        .find(|pair| selected.map_or(pair.nominated, |id| pair.stats.id == id))?;
+    // Candidates are filed as `RTCLocalIceCandidate_<id>` /
+    // `RTCRemoteIceCandidate_<id>`; a pair names them by `<id>`.
+    let candidate = |id: &str| {
+        let suffix = format!("_{id}");
+        report.iter().find_map(|entry| match entry {
+            RTCStatsReportEntry::LocalCandidate(c) | RTCStatsReportEntry::RemoteCandidate(c)
+                if c.stats.id == id || c.stats.id.ends_with(&suffix) =>
+            {
+                Some(c)
+            }
+            _ => None,
+        })
+    };
+    let end = |id: &str| match candidate(id) {
+        Some(c) => format!(
+            "{} {}:{}",
+            c.candidate_type,
+            c.address.as_deref().unwrap_or("?"),
+            c.port
+        ),
+        // A peer-reflexive candidate learned from a check isn't filed.
+        None => "unlisted".to_owned(),
+    };
+    let protocol = candidate(&pair.local_candidate_id)
+        .map(|c| c.protocol.clone())
+        .unwrap_or_else(|| "udp".into());
+    Some(format!(
+        "{} -> {} {protocol}, rtt {:.0} ms",
+        end(&pair.local_candidate_id),
+        end(&pair.remote_candidate_id),
+        pair.current_round_trip_time * 1000.0
+    ))
+}
