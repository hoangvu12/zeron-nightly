+    /// (hosted here, a host on the relay alone, an engine from before).
+    fn keep_link_warm(self: &Rc<Self>) {
+        let turn = self.link_kept.get() + 1;
+        self.link_kept.set(turn);
+        let Some(id) = self.open_id() else { return };
+        let weak = Rc::downgrade(self);
+        engine::get().spawn(async move {
+            while warm_link(&id).await {
+                zgx::timer::sleep(LINK_KEPT_EVERY).await;
+                if weak.upgrade().is_none_or(|view| view.link_kept.get() != turn) {
+                    return;
+                }
+            }
+        });
+    }
