@@ -0,0 +1,259 @@
+//! Which local addresses ICE gathers host candidates from.
+//!
+//! The wildcard (`0.0.0.0:0`) binds a socket on every IPv4 interface. On a
+//! Windows machine with WSL, Hyper-V or Docker Desktop that includes their
+//! host-only switches (`vEthernet (WSL)`, `vEthernet (Default Switch)`). No
+//! other device can reach those, and every connectivity check sent from them
+//! to another network fails with WSAENETUNREACH (10051): about fifty ERRORs
+//! a pairing, and checks that only delay the ones that can work.
+//!
+//! So on Windows the wildcard becomes the addresses of the adapters that are
+//! up, minus host-only virtual switches. A virtual switch with a default
+//! gateway stays: a Hyper-V external switch carries the machine's real LAN
+//! on a `vEthernet` adapter. When the adapters can't be listed, or nothing is
+//! left, the wildcard stays as it was.
+// (Only Windows lists its adapters; elsewhere ICE binds every interface.)
+#![cfg_attr(not(any(windows, test)), allow(dead_code))]
+use std::net::Ipv4Addr;
+
+/// What ICE binds when told nothing else.
+pub(crate) const WILDCARD: &str = "0.0.0.0:0";
+
+/// A network adapter, as far as choosing candidates goes.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Adapter {
+    pub name: String,
+    pub description: String,
+    pub up: bool,
+    pub loopback: bool,
+    /// It has a default gateway: other networks are reached through it.
+    pub gateway: bool,
+    pub ipv4: Vec<Ipv4Addr>,
+}
+
+/// Names of virtual switches and host-only adapters, lowercase.
+const VIRTUAL: &[&str] = &[
+    "vethernet",
+    "hyper-v",
+    "wsl",
+    "virtualbox",
+    "vbox",
+    "vmware",
+    "docker",
+];
+
+impl Adapter {
+    /// A virtual switch only this machine and its VMs are on.
+    fn host_only(&self) -> bool {
+        let name = self.name.to_lowercase();
+        let description = self.description.to_lowercase();
+        !self.gateway
+            && VIRTUAL
+                .iter()
+                .any(|word| name.contains(word) || description.contains(word))
+    }
+}
+
+/// The addresses to bind, one `ip:0` per usable IPv4 address, in adapter
+/// order. Loopback and link-local are left out, as the wildcard's expansion
+/// leaves them out.
+pub(crate) fn bind_addrs(adapters: &[Adapter]) -> Vec<String> {
+    let mut addrs: Vec<String> = Vec::new();
+    for adapter in adapters
+        .iter()
+        .filter(|a| a.up && !a.loopback && !a.host_only())
+    {
+        for ip in &adapter.ipv4 {
+            if ip.is_loopback() || ip.is_link_local() || ip.is_unspecified() {
+                continue;
+            }
+            let addr = format!("{ip}:0");
+            if !addrs.contains(&addr) {
+                addrs.push(addr);
+            }
+        }
+    }
+    addrs
+}
+
+/// The addresses to bind for a new connection when none were configured.
+/// Read afresh each time, so a network that changed is followed.
+pub(crate) fn default_udp_addrs() -> Vec<String> {
+    #[cfg(windows)]
+    match windows::adapters() {
+        Ok(adapters) => {
+            let addrs = bind_addrs(&adapters);
+            let skipped: Vec<&str> = adapters
+                .iter()
+                .filter(|a| a.up && a.host_only())
+                .map(|a| a.name.as_str())
+                .collect();
+            if !addrs.is_empty() {
+                tracing::debug!(?addrs, ?skipped, "preview ICE binds these addresses");
+                return addrs;
+            }
+        }
+        Err(error) => tracing::debug!(%error, "network adapters not listed; ICE binds every interface"),
+    }
+    vec![WILDCARD.to_owned()]
+}
+
+#[cfg(windows)]
+mod windows {
+    use super::Adapter;
+    use std::net::Ipv4Addr;
+    use windows_sys::Win32::Foundation::{ERROR_BUFFER_OVERFLOW, ERROR_SUCCESS};
+    use windows_sys::Win32::NetworkManagement::IpHelper::{
+        GAA_FLAG_INCLUDE_GATEWAYS, GAA_FLAG_SKIP_ANYCAST, GAA_FLAG_SKIP_DNS_SERVER,
+        GAA_FLAG_SKIP_MULTICAST, GetAdaptersAddresses, IF_TYPE_SOFTWARE_LOOPBACK,
+        IP_ADAPTER_ADDRESSES_LH, IP_ADAPTER_UNICAST_ADDRESS_LH,
+    };
+    use windows_sys::Win32::NetworkManagement::Ndis::IfOperStatusUp;
+    use windows_sys::Win32::Networking::WinSock::{AF_INET, SOCKADDR, SOCKADDR_IN};
+    use windows_sys::core::PWSTR;
+
+    /// The machine's adapters with their IPv4 addresses and whether each has
+    /// a gateway.
+    pub(super) fn adapters() -> std::io::Result<Vec<Adapter>> {
+        let flags = GAA_FLAG_INCLUDE_GATEWAYS
+            | GAA_FLAG_SKIP_ANYCAST
+            | GAA_FLAG_SKIP_MULTICAST
+            | GAA_FLAG_SKIP_DNS_SERVER;
+        // Microsoft's advice: start at 15 KB, grow to what the call asks for.
+        let mut size: u32 = 15 * 1024;
+        let mut buffer: Vec<u64>;
+        let mut tries = 0;
+        loop {
+            // u64s, so the list is 8-byte aligned as its structs need.
+            buffer = vec![0u64; (size as usize).div_ceil(8)];
+            // SAFETY: `buffer` holds `size` writable bytes, and `size` says so.
+            let status = unsafe {
+                GetAdaptersAddresses(
+                    u32::from(AF_INET),
+                    flags,
+                    std::ptr::null(),
+                    buffer.as_mut_ptr().cast(),
+                    &mut size,
+                )
+            };
+            match status {
+                ERROR_SUCCESS => break,
+                ERROR_BUFFER_OVERFLOW if tries < 3 => tries += 1,
+                _ => return Err(std::io::Error::from_raw_os_error(status as i32)),
+            }
+        }
+        let mut adapters = Vec::new();
+        let mut next = buffer.as_ptr().cast::<IP_ADAPTER_ADDRESSES_LH>();
+        // SAFETY: on success the buffer holds a linked list the call wrote,
+        // every pointer in it into the buffer (or null), which lives until
+        // the end of this function.
+        while let Some(adapter) = unsafe { next.as_ref() } {
+            let mut ipv4 = Vec::new();
+            let mut unicast: *const IP_ADAPTER_UNICAST_ADDRESS_LH = adapter.FirstUnicastAddress;
+            while let Some(address) = unsafe { unicast.as_ref() } {
+                if let Some(ip) = unsafe { v4(address.Address.lpSockaddr) } {
+                    ipv4.push(ip);
+                }
+                unicast = address.Next;
+            }
+            adapters.push(Adapter {
+                name: unsafe { wide(adapter.FriendlyName) },
+                description: unsafe { wide(adapter.Description) },
+                up: adapter.OperStatus == IfOperStatusUp,
+                loopback: adapter.IfType == IF_TYPE_SOFTWARE_LOOPBACK,
+                gateway: !adapter.FirstGatewayAddress.is_null(),
+                ipv4,
+            });
+            next = adapter.Next;
+        }
+        Ok(adapters)
+    }
+
+    /// The IPv4 address a socket address holds, if it holds one.
+    ///
+    /// SAFETY: `address` is null or points at a socket address of its
+    /// family's size.
+    unsafe fn v4(address: *const SOCKADDR) -> Option<Ipv4Addr> {
+        let family = unsafe { address.as_ref()? }.sa_family;
+        if family != AF_INET {
+            return None;
+        }
+        let address = unsafe { &*address.cast::<SOCKADDR_IN>() };
+        // Network byte order, as it lies in memory.
+        let raw = unsafe { address.sin_addr.S_un.S_addr };
+        Some(Ipv4Addr::from(raw.to_ne_bytes()))
+    }
+
+    /// A NUL-terminated UTF-16 string.
+    ///
+    /// SAFETY: `text` is null or NUL-terminated.
+    unsafe fn wide(text: PWSTR) -> String {
+        if text.is_null() {
+            return String::new();
+        }
+        let mut len = 0;
+        while unsafe { *text.add(len) } != 0 {
+            len += 1;
+        }
+        String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(text, len) })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn adapter(name: &str, description: &str, gateway: bool, ip: &str) -> Adapter {
+        Adapter {
+            name: name.into(),
+            description: description.into(),
+            up: true,
+            loopback: false,
+            gateway,
+            ipv4: vec![ip.parse().unwrap()],
+        }
+    }
+
+    /// The adapters of the desktop whose pairings logged ~50 10051 ERRORs.
+    #[test]
+    fn host_only_switches_are_left_out_and_real_networks_kept() {
+        let adapters = [
+            adapter("Ethernet", "Intel(R) Ethernet Connection", true, "192.168.1.20"),
+            adapter("vEthernet (WSL (Hyper-V firewall))", "Hyper-V Virtual Ethernet Adapter", false, "172.29.32.1"),
+            adapter("vEthernet (Default Switch)", "Hyper-V Virtual Ethernet Adapter #2", false, "172.18.48.1"),
+            adapter("Tailscale", "Tailscale Tunnel", false, "100.95.236.38"),
+            adapter("VirtualBox Host-Only Network", "VirtualBox Host-Only Ethernet Adapter", false, "192.168.56.1"),
+            adapter("Wi-Fi", "Intel(R) Wi-Fi 6E AX211", true, "192.168.1.21"),
+            Adapter {
+                loopback: true,
+                ..adapter("Loopback Pseudo-Interface 1", "Software Loopback Interface 1", false, "127.0.0.1")
+            },
+            Adapter {
+                up: false,
+                ..adapter("Ethernet 2", "Realtek USB GbE", true, "10.0.0.5")
+            },
+            adapter("Ethernet 3", "Realtek USB GbE", false, "169.254.10.2"),
+        ];
+        assert_eq!(
+            bind_addrs(&adapters),
+            ["192.168.1.20:0", "100.95.236.38:0", "192.168.1.21:0"],
+            "a tailnet stays: it is routed, though it has no gateway"
+        );
+    }
+
+    #[test]
+    fn a_virtual_switch_carrying_the_lan_stays() {
+        // A Hyper-V external switch: the machine's own network, on vEthernet.
+        let adapters = [adapter("vEthernet (External)", "Hyper-V Virtual Ethernet Adapter", true, "192.168.1.30")];
+        assert_eq!(bind_addrs(&adapters), ["192.168.1.30:0"]);
+    }
+
+    #[test]
+    fn nothing_usable_binds_nothing_so_the_wildcard_stays() {
+        let adapters = [adapter("vEthernet (WSL)", "Hyper-V Virtual Ethernet Adapter", false, "172.29.32.1")];
+        assert!(bind_addrs(&adapters).is_empty());
+        assert!(bind_addrs(&[]).is_empty());
+        #[cfg(not(windows))]
+        assert_eq!(default_udp_addrs(), [WILDCARD]);
+    }
+}
