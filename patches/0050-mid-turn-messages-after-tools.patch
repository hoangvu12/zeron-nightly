+    /// Whether a message sent while `chat_id`'s turn runs goes into that
+    /// turn once the tool calls under way return ([`Self::steer_after_tools`]),
+    /// as one typed into Claude Code's own terminal mid-turn does, rather
+    /// than waiting in the queue for the turn's end. Only a Claude Code turn
+    /// that takes a word now: not while it compacts, waits on a question or
+    /// an agent update, or is being stopped; and never a command (`/name`),
+    /// which Claude Code too runs only once the turn is over.
+    pub(crate) fn takes_after_tools(&self, chat_id: &str, prompt: &str) -> bool {
+        use std::sync::atomic::Ordering::Acquire;
+        if !self.turn_in_flight(chat_id)
+            || self.defers_to_turn_end(chat_id, None)
+            || self.live_run_update_pending(chat_id)
+            || native_command(prompt, HarnessId::ClaudeCode)
+        {
+            return false;
+        }
+        lock(&self.inner.runs).get(chat_id).is_some_and(|h| {
+            h.runtime_config.harness_id == HarnessId::ClaudeCode
+                && h.steerable
+                && !h.retiring.load(Acquire)
+                && lock(&h.pending_inputs).is_empty()
+        })
+    }
