+    /// A message queued while a Claude Code turn runs goes into that turn
+    /// once its open tool calls return (Claude Code's `next`), as one typed
+    /// into its own terminal mid-turn does, rather than waiting for the
+    /// turn's end; a command waits for the end, and holds the rows behind it.
+    #[tokio::test]
+    async fn a_message_sent_mid_turn_goes_in_after_the_open_tools() {
+        let chat = "chat-after-tools";
+        let (feed, rx) = mpsc::unbounded_channel();
+        let turn_slot = Arc::new(Mutex::new(None));
+        let steers = Arc::new(Mutex::new(None));
+        let registry = HarnessRegistry::new();
+        registry.register(Arc::new(WakeHarness {
+            id: HarnessId::ClaudeCode,
+            feed: Mutex::new(Some(rx)),
+            turn: turn_slot.clone(),
+            steers: Some(steers.clone()),
+        }));
+        let dir = tempfile::tempdir().unwrap();
+        let core = crate::EngineCore::assemble(
+            dir.path(),
+            Arc::new(registry),
+            HarnessId::ClaudeCode,
+            None,
+        )
+        .unwrap();
+        core.workspace
+            .create_space(chat, &core.device_id, "/tmp", None, false)
+            .unwrap();
+        core.workspace
+            .create_chat(chat, Some(chat), None, None, None)
+            .unwrap();
+        core.sessions
+            .dispatch(chat, HarnessId::ClaudeCode, request(), None)
+            .await
+            .unwrap();
+        feed.send(started()).unwrap();
+        let mut steering = loop {
+            if let Some(rx) = steers.lock().unwrap().take() {
+                break rx;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        };
+        feed.send(AgentEvent::TextDelta { text: "on it".into() }).unwrap();
+        tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+
+        let command = core.doc_host.queue_message(chat, "/review", vec![]).unwrap();
+        core.doc_host
+            .queue_message(chat, "also check the tests", vec![])
+            .unwrap();
+        let handle = core.doc_host.open(chat).unwrap();
+        core.doc_host.drain_queue(&handle).await;
+        tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+        assert!(steering.try_recv().is_err(), "a command waits for the turn's end");
+        assert_eq!(handle.doc().read_queue().unwrap().len(), 2);
+
+        assert!(core.doc_host.remove_queued_message(chat, &command).await.unwrap());
+        core.doc_host.drain_queue(&handle).await;
+        let message = tokio::time::timeout(std::time::Duration::from_secs(2), steering.recv())
+            .await
+            .expect("the message reaches the agent mid-turn")
+            .unwrap();
+        assert!(message.after_tools, "read once the open tools return");
+        assert!(message.prompt.ends_with("also check the tests"), "{}", message.prompt);
+        assert!(handle.doc().read_queue().unwrap().is_empty());
+        core.sessions.shutdown().await;
+    }
+
