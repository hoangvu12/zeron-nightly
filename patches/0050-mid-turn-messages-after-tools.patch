+/// How a mailbox message goes out: one sent while the agent works
+/// ([`crate::SteerMessage::after_tools`]) as Claude Code's terminal sends a message
+/// typed mid-turn, `next`: read in the same turn once the open tool calls
+/// return, nothing stopped or moved (a turn that ends first takes it as its
+/// next prompt); a steer by [`steer_priority`].
+fn message_priority(
+    after_tools: bool,
+    moves_tools: bool,
+    from_another_chat: bool,
+    tools_open: bool,
+) -> wire::SteerPriority {
+    if after_tools {
+        wire::SteerPriority::Next
+    } else {
+        steer_priority(moves_tools, from_another_chat, tools_open)
+    }
+}
