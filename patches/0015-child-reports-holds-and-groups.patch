--- a/crates/engine/src/doc_host.rs
+++ b/crates/engine/src/doc_host.rs
@@ -250,6 +250,30 @@ fn queue_lead(queue: &[QueuedMessage]) -> Option<QueuedMessage> {
         .cloned()
 }
 
+/// When the first of the FYIs held in `row` and in the rows of FYIs alone
+/// `behind` it got here: they may go alone [`REPORT_FYI_HOLD`] after.
+/// `None`: there are none.
+fn fyis_since(row: &QueuedMessage, behind: &[&QueuedMessage]) -> Option<i64> {
+    held_of(row)
+        .iter()
+        .filter(|held| held.kind == HeldKind::Fyi)
+        .map(|held| held.held_at)
+        .chain(behind.iter().map(|row| held_since(row)))
+        .min()
+}
+
+/// A held row's FYIs, as a row of their own: its id, and each FYI filed as
+/// it was, so its hold counts on from when it got here. `None`: it has
+/// none.
+fn fyis_of(row: &QueuedMessage) -> Option<QueuedMessage> {
+    let fyis = zeron_proto::agent_messages::split_fyis(&row.text).1?;
+    Some(QueuedMessage {
+        text: fyis.to_owned(),
+        held: held_of(row).into_iter().filter(|held| held.kind == HeldKind::Fyi).collect(),
+        ..row.clone()
+    })
+}
+
 /// Transfer attempt outcome: transient failures retry (the link may heal),
 /// permanent ones stop (the host actively refused, or the bytes are gone).
 enum TransferError {
@@ -5212,18 +5236,43 @@ impl DocHost {
                 }
                 // The FYIs held go with what wakes the agent, after it: its
                 // children's reports, or their own time come.
-                if !parts.is_empty() || fyis.is_some() {
-                    parts.extend(fyis.map(str::to_owned));
-                    for row in queue.iter().take_while(|row| held_report_row(row)) {
-                        if row.id == item.id || wakes(row) {
-                            continue;
+                let behind: Vec<&QueuedMessage> = queue
+                    .iter()
+                    .take_while(|row| held_report_row(row))
+                    .filter(|row| row.id != item.id && !wakes(row))
+                    .collect();
+                let woke = !parts.is_empty();
+                let due = fyis_since(&item, &behind).is_some_and(|since| now_ms() >= since + report_fyi_hold_ms());
+                // Its reports all dropped, nothing wakes the agent: its FYIs
+                // wait on, where it was, for the next wake or their own time,
+                // as they were held (their hold doesn't start over).
+                if !woke && !reports.is_empty() && fyis.is_some() && !due {
+                    if let Some(row) = fyis_of(&item) {
+                        let at = queue.iter().position(|q| q.id == item.id).unwrap_or(0);
+                        if let Some(held) = lock(&handle.held_sends).get_mut(&row.id) {
+                            held.prompt = row.text.clone();
+                        }
+                        match handle.doc.insert_queued(at, &row) {
+                            Ok(()) => tracing::info!(chat = %handle.chat_id, "held FYIs wait on: their reports went otherwise"),
+                            Err(err) => tracing::warn!(chat = %handle.chat_id, error = %err, "held FYIs couldn't wait on"),
                         }
+                    }
+                    handle.publish_queue();
+                    continue;
+                }
+                if woke || fyis.is_some() {
+                    // What an end going now says again of its child's FYIs
+                    // isn't said twice.
+                    let ends = parts.first().cloned().unwrap_or_default();
+                    let unsaid = |fyis: &str| crate::sessions::without_repeated(&ends, fyis);
+                    parts.extend(fyis.and_then(unsaid));
+                    for row in behind {
                         let Ok(Some(rider)) = handle.doc.take_queued(&row.id) else {
                             continue;
                         };
                         lock(&handle.held_sends).remove(&rider.id);
                         let (_, fyis) = zeron_proto::agent_messages::split_fyis(&rider.text);
-                        parts.push(fyis.unwrap_or(rider.text.as_str()).to_owned());
+                        parts.extend(unsaid(fyis.unwrap_or(rider.text.as_str())));
                         riders.push(rider);
                     }
                 }
@@ -8253,7 +8302,9 @@ mod queued_message_prompt_tests {
 
 #[cfg(test)]
 mod held_report_tests {
-    use super::{DocHost, DocHostConfig, HeldKind, QueuedMessage, held_of, queue_lead, wakes};
+    use super::{
