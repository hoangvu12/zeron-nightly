+        assert!(read(&entries, serde_json::json!({ "lastMessage": last }).to_string()));
+        // Read while it still streamed: not seen finished.
+        let mut streaming = entries.clone();
+        streaming[1].status = Some(MessageStatus::Streaming);
+        assert!(!read(&entries, read_chat_result(&streaming)));
+        // The same answer by its id, other words in it: not the reply reported.
+        let mut other = entries.clone();
+        other[1].parts = vec![said("Some fail.")];
+        assert!(!read(&entries, read_chat_result(&other)));
+        // An answer written after the report isn't the one it carries.
+        assert!(!answer_read(&entries, "parent", "u1", -1, &reply, &[read_chat_result(&entries)]));
+        // Its last entry continues an earlier one: the read folds it in,
+        // under the first one's id.
+        let mut tail = entry("a1#c1", MessageRole::Assistant, vec![said("All 40 pass.")]);
+        tail.continuation_of = Some("a1".into());
+        let mut split = transcript(vec![said("Let me look.")]);
+        split.push(tail);
+        assert!(read(&split, read_chat_result(&split)));
+    }
+
+    #[test]
+    fn only_a_read_its_agent_was_shown_whole_counts() {
+        let entries = transcript(vec![said("All 40 pass.")]);
+        let reply = squash("All 40 pass.");
+        let read = |result: String| answer_read(&entries, "parent", "u1", 10, &reply, &[result]);
+        let whole = read_chat_result(&entries);
+        assert!(read(whole.clone()));
+        // Too big to be shown whole (older messages in the window): nothing.
+        let mut window = entries.clone();
+        window.insert(0, entry("u0", MessageRole::User, vec![said(&"word ".repeat(5 * 1024))]));
+        assert!(!read(read_chat_result(&window)));
+        // Cut short on its way: nothing.
+        assert!(!read(format!("{}\n… (reply cut short: too large to send whole.)", &whole[..whole.len() / 2])));
+        // Saved to a file in its place: nothing.
+        assert!(!read("Output too large, saved to /tmp/result.txt".into()));
+    }
+
+    #[test]
+    fn a_read_cancels_only_a_requests_plain_end() {
+        assert_eq!(plain_end("report-kid-m1-end", "kid"), Some("m1"));
+        // A follow-up, a question, a stop, one kept from the agent, another
+        // child's: never.
+        for key in [
+            "report-kid-m1-end-a2",
+            "report-kid-m1-ask-r1",
+            "report-kid-m1-stopped",
+            "report-kid-m1-end-waited",
+            "report-kid-m1-end-quiet",
+            "report-other-m1-end",
+        ] {
+            assert_eq!(plain_end(key, "kid"), None, "{key}");
+        }
+        // What the read must show is the reply alone, not Zeron's lines
+        // under it.
+        let running = format!("All 40 pass.\n\n{BACKGROUND}the tests (4 s). Once it's done, you hear of it.)");
+        assert_eq!(reported_reply(&running), "All 40 pass.");
+        let long = "word ".repeat(REPORT_CAP / 4);
+        let cut = capped(long.clone(), "kid");
+        assert!(cut.len() < long.len() && long.starts_with(reported_reply(&cut)), "{}", &cut[cut.len() - 100..]);
+    }
 }
