-            Some((asked.to_owned(), stage.to_owned()))
-        })
-    })
+        .filter_map(|stage| Some((rest.strip_suffix(stage)?.strip_suffix('-')?, stage.to_owned())))
+        .collect();
+    for stage in ["end", "ask"] {
+        let mark = format!("-{stage}-");
+        for at in (0..rest.len()).filter(|&at| rest.is_char_boundary(at) && rest[at..].starts_with(&mark)) {
+            let id = &rest[at + mark.len()..];
+            if !id.is_empty() {
