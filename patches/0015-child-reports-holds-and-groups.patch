+/// How many reports one child files with its parent, with the person
+/// silent in both chats, before the rest are paused: filed, kept from the
+/// parent's agent ([`QUIET`]), still its end there, until the person writes
+/// in either. Its questions, failures and stops still go. Nothing else
+/// stores the pause: the ledger and the two chats are what it's read from,
+/// so it lasts through a restart and ends when the person writes.
+const PAUSE_AT: usize = 20;
+
+/// One of a child's reports in its parent's ledger: its key without the
+/// mark it was kept by, the command that filed it first, and whether that
+/// one was kept [`QUIET`].
+#[derive(Debug, PartialEq, Eq)]
+struct Back {
+    key: String,
+    command: String,
+    quiet: bool,
+}
+
+/// When the person last wrote in a chat (`entries`, `commands`: its doc):
+/// a message with no chat's header on it, read or sent.
+fn person_wrote_at(entries: &[SessionMessageEntry], commands: &[SessionCommandEntry]) -> Option<i64> {
+    let read = entries
+        .iter()
+        .filter(|e| e.role == MessageRole::User && typed(&text_of(&e.parts)))
+        .map(|e| e.created_at);
+    let sent = commands.iter().filter(|c| typed_command(c)).map(|c| c.issued_at);
+    read.chain(sent).max()
+}
+
+/// `child`'s reports in its parent's ledger (`ledger`: the parent's
+/// commands) filed after `since`, in the ledger's order, each once: one sent
+/// again, or kept by another mark, is the same report. The person's Stop,
+/// filed as one, is no coming back.
+fn reports_since(ledger: &[SessionCommandEntry], child: &str, since: i64) -> Vec<Back> {
+    let prefix = format!("report-{child}-");
+    let mut back: Vec<Back> = Vec::new();
+    for c in ledger.iter().filter(|c| c.issued_at > since) {
+        let SessionCommandPayload::Run { message_id, .. } = &c.payload else {
+            continue;
+        };
+        if !message_id.starts_with(&prefix) || message_id.ends_with(PERSONS_STOP) {
+            continue;
+        }
+        let (key, quiet) = match message_id.strip_suffix(QUIET) {
+            Some(key) => (key, true),
+            None => (message_id.strip_suffix(WAITED).unwrap_or(message_id.as_str()), false),
+        };
+        if !back.iter().any(|b| b.key == key) {
+            back.push(Back { key: key.to_owned(), command: c.id.clone(), quiet });
+        }
+    }
+    back
+}
+
+/// `child`'s reports in its parent's ledger since the person last wrote in
+/// either chat ([`reports_since`]). `said`, `ledger`: the parent's doc.
+fn back_since_written(host: &DocHost, said: &[SessionMessageEntry], ledger: &[SessionCommandEntry], child: &str) -> Vec<Back> {
+    let in_child = host.open(child).ok().and_then(|handle| {
+        let doc = handle.doc();
+        person_wrote_at(&doc.read_entries().unwrap_or_default(), &doc.read_commands().unwrap_or_default())
+    });
+    let since = person_wrote_at(said, ledger).max(in_child).unwrap_or(i64::MIN);
+    reports_since(ledger, child, since)
+}
+
+/// Whether `child`'s reports to `parent` are paused: it has come back
+/// [`PAUSE_AT`] times since the person last wrote in either chat.
+fn paused(host: &DocHost, parent: &str, child: &str) -> bool {
+    let Ok(handle) = host.open(parent) else {
+        return false;
+    };
+    let doc = handle.doc();
+    let ledger = doc.read_commands().unwrap_or_default();
+    back_since_written(host, &doc.read_entries().unwrap_or_default(), &ledger, child).len() >= PAUSE_AT
+}
+
+/// `parent`'s children whose reports are paused now ([`paused`]), each with
+/// its name and how many times it has come back.
+fn paused_children(host: &DocHost, parent: &str) -> Vec<(String, String, usize)> {
+    let (Some(ws), Ok(handle)) = (host.workspace(), host.open(parent)) else {
+        return Vec::new();
+    };
+    let doc = handle.doc();
+    let (said, ledger) = (doc.read_entries().unwrap_or_default(), doc.read_commands().unwrap_or_default());
+    ws.read_chats()
+        .unwrap_or_default()
+        .iter()
+        .filter(|c| c.parent_chat_id.as_deref() == Some(parent) && !c.archived)
+        .filter_map(|child| {
