+/// `fyis` (children's FYIs, one or several merged) without one an end in
+/// `batch` (the reports going with them) says again: its words, spaced as
+/// [`squash`] spaces them, in the reply of an end from the same child
+/// (finished, failed or stopped). `None`: nothing left.
+pub(crate) fn without_repeated(batch: &str, fyis: &str) -> Option<String> {
+    let (Some(said), Some(blocks)) = (agent_messages::child_fyis(fyis), agent_messages::fyi_blocks(fyis)) else {
+        return Some(fyis.to_owned());
+    };
+    let reports = agent_messages::child_reports(batch).unwrap_or_default();
+    let ends: Vec<(&str, String)> = reports
+        .iter()
+        .filter(|r| matches!(r.status, ReportStatus::Finished | ReportStatus::Failed | ReportStatus::Stopped))
+        .map(|r| (r.sender.chat_id.as_str(), squash(reported_reply(r.body))))
+        .collect();
+    let kept: Vec<&str> = blocks
+        .iter()
+        .zip(&said)
+        .filter(|(_, f)| {
+            let words = squash(f.body);
+            words.is_empty() || !ends.iter().any(|(child, reply)| *child == f.sender.chat_id && reply.contains(&words))
+        })
+        .map(|(block, _)| *block)
+        .collect();
+    if kept.len() == blocks.len() {
+        Some(fyis.to_owned())
+    } else {
+        (!kept.is_empty()).then(|| agent_messages::merge_reports(&kept))
+    }
+}
+
