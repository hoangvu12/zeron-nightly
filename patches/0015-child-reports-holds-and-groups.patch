+    entries
+        .iter()
+        .filter(|e| e.role == MessageRole::Assistant)
+        .flat_map(|e| &e.parts)
+        .filter_map(|part| {
+            let MessagePart::Tool { id, call: ToolCall::Mcp { server, tool, .. }, resolved: true, is_error: false, .. } = part
+            else {
