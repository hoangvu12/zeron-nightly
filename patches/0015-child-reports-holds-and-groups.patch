+    /// What to tell a parent of its child hosted on `device_id` when that
+    /// host may not report the child's turns back on its own: one that
+    /// doesn't say it does (`child-reports`), or isn't known. Never fails the
+    /// call it's part of: a device list that can't be read says nothing.
+    async fn reports_back(&self, device_id: &str) -> Option<String> {
+        let devices = self.zeron.devices().await.ok()?;
+        let device = devices.iter().find(|d| d.id == device_id);
+        if device.is_some_and(|d| d.supports(zeron_proto::capabilities::CHILD_REPORTS)) {
+            return None;
+        }
+        let name = device.map_or(device_id, |d| d.name.as_str());
+        Some(format!(
+            "{name} runs a Zeron that may not report this chat's results back to you on its own. Collect them with wait_for_turn or read_chat."
+        ))
+    }
