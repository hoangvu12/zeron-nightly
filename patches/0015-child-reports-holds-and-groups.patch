+            };
+            if server != "zeron" || !matches!(tool.as_str(), "read_chat" | "get_chat") {
+                return None;
+            }
+            let result = journal.tool_exchange(chat, id).ok()??.result?;
+            if result.is_error {
+                return None;
+            }
+            result.output
+        })
+        .collect()
