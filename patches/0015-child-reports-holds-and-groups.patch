+}
+
+/// What a held row holds ([`QueuedMessage::held`]): as this host filed it,
+/// or, for a row held before it filed any, read off the row: each report
+/// and FYI held when the row was, the first by the row's key.
+fn held_of(row: &QueuedMessage) -> Vec<HeldReport> {
+    if !row.held.is_empty() {
+        return row.held.clone();
+    }
+    let reports = zeron_proto::agent_messages::child_reports(&row.text).unwrap_or_default();
+    let fyis = zeron_proto::agent_messages::child_fyis(&row.text).unwrap_or_default();
+    reports
+        .iter()
+        .map(|r| (HeldKind::Report, r.sender.chat_id.as_str()))
+        .chain(fyis.iter().map(|f| (HeldKind::Fyi, f.sender.chat_id.as_str())))
+        .enumerate()
+        .map(|(i, (kind, child))| held_report(kind, child, if i == 0 { row.id.as_str() } else { "" }, row.issued_at))
+        .collect()
+}
+
+/// A report or FYI from `child`, held at `held_at` under its command's
+/// `key`: what the key says it's on, when it's a report's
+/// ([`crate::sessions::report_key_parts`]); else the key is its stage.
+fn held_report(kind: HeldKind, child: &str, key: &str, held_at: i64) -> HeldReport {
+    let (asked, stage) = crate::sessions::report_key_parts(key, child).unwrap_or_else(|| (String::new(), key.to_owned()));
+    HeldReport {
+        kind,
+        child: child.to_owned(),
+        request_id: stage.strip_prefix("ask:").map(str::to_owned),
+        asked,
+        stage,
+        held_at,
+        wake: kind == HeldKind::Report,
+    }
+}
+
+/// The held row wakes the agent: it holds a report, not FYIs alone.
+fn wakes(row: &QueuedMessage) -> bool {
+    held_of(row).iter().any(|held| held.wake)
+}
+
+/// When the first of what a held row holds got here (this host's clock).
+fn held_since(row: &QueuedMessage) -> i64 {
+    held_of(row).iter().map(|held| held.held_at).min().unwrap_or(row.issued_at)
+}
+
+/// The row the drain hands the agent next: the head, but among the
+/// children's reports and FYIs held at the head, the first report (the
+/// FYIs go with it); and past FYIs alone, the row behind them, as they wait
+/// for something to wake the agent.
+fn queue_lead(queue: &[QueuedMessage]) -> Option<QueuedMessage> {
+    let held = queue.iter().take_while(|row| held_report_row(row)).count();
+    queue[..held]
+        .iter()
+        .find(|row| wakes(row))
+        .or_else(|| queue.get(held))
+        .or_else(|| queue.first())
+        .cloned()
 }
 
