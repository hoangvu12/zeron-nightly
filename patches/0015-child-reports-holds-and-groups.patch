         assert_eq!(lead(&[theirs, fyi]).as_deref(), Some("p1"));
         assert_eq!(lead(&[]), None);
     }
+
+    /// A row holding reports and FYIs (a turn on them failed, and they were
+    /// held again) whose reports all went otherwise: its FYIs wait on alone,
+    /// as held as they were, until the first of them, or of the FYIs behind
+    /// it, is as old as their hold.
+    #[test]
+    fn fyis_whose_reports_went_otherwise_wait_on_from_when_they_came() {
+        let text = merge_reports(&[
+            report("kid-a", ReportStatus::Finished, "Green."),
+            child_fyi("Kid (kid-a)", "kid-a", "Halfway."),
+            child_fyi("Kid (kid-b)", "kid-b", "Outlined."),
+        ]);
+        let mut both = row("report-kid-a-lead-m1-end", text, 9_000);
+        both.held = vec![
+            held_report(HeldKind::Report, "kid-a", "report-kid-a-lead-m1-end", 9_000),
+            held_report(HeldKind::Fyi, "kid-a", "fyi-1", 1_000),
+            held_report(HeldKind::Fyi, "kid-b", "fyi-2", 2_000),
+        ];
+        let alone = fyis_of(&both).expect("it holds FYIs");
+        assert_eq!(alone.id, both.id);
+        assert!(zeron_proto::agent_messages::child_reports(&alone.text).is_none());
+        assert_eq!(zeron_proto::agent_messages::child_fyis(&alone.text).map(|f| f.len()), Some(2));
+        assert_eq!(
+            filed(&alone),
+            [
+                entry(HeldKind::Fyi, "kid-a", "", "fyi-1", None, 1_000),
+                entry(HeldKind::Fyi, "kid-b", "", "fyi-2", None, 2_000),
+            ]
+        );
+        assert!(!wakes(&alone));
+        // Their hold counts from the first FYI's arrival, not the row's; an
+        // FYI behind it, held earlier, counts too.
+        assert_eq!(fyis_since(&both, &[]), Some(1_000));
+        let older = row("fyi-0", child_fyi("Kid (kid-b)", "kid-b", "Started."), 500);
+        assert_eq!(fyis_since(&both, &[&older]), Some(500));
+        // Reports alone hold no FYIs.
+        let ended = row("report-kid-a-lead-m1-end", report("kid-a", ReportStatus::Finished, "Green."), 2_000);
+        assert!(fyis_of(&ended).is_none());
+        assert_eq!(fyis_since(&ended, &[]), None);
+    }
 }
 
