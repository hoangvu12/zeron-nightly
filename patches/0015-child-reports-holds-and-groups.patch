         }
         if let Some(prompt) = args.prompt.filter(|p| !p.trim().is_empty()) {
             // The row may not have folded into WatchChats yet; build the
@@ -1552,6 +1545,13 @@ impl Tools {
             .deliver(&chat, space, &harnesses, baseline.as_ref(), body, mode)
             .await?;
         result["sent"] = delivered.receipt;
+        // A request to a child of this chat's: its answer may not come back.
+        if chat.parent_chat_id.is_some()
+            && chat.parent_chat_id.as_deref() == self.zeron.origin().chat_id.as_deref()
+            && let Some(warning) = self.reports_back(&chat.device_id).await
