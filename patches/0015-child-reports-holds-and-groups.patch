+        let mut row = item("report-kid-a-m-1-ask-req-1", "[Report …]");
+        row.held = vec![end.clone()];
+        doc.push_queued(&row).unwrap();
+        doc.push_queued(&item("q2", "typed")).unwrap();
+        assert_eq!(doc.read_queue().unwrap(), vec![row.clone(), item("q2", "typed")]);
+        let json = serde_json::to_value(doc.read_queue().unwrap()).unwrap();
+        assert_eq!(json[0]["held"][0]["heldAt"], 5_000);
+        assert_eq!(json[0]["held"][0]["kind"], "report");
+        assert!(json[1].get("held").is_none());
+
+        let fyi = HeldReport {
+            kind: HeldKind::Fyi,
+            child: "kid-b".into(),
+            asked: String::new(),
+            stage: "f-1".into(),
+            request_id: None,
+            held_at: 6_000,
+            wake: false,
+        };
+        assert!(doc.set_queued_held(&row.id, &[end.clone(), fyi.clone()]).unwrap());
+        assert!(doc.move_queued(&row.id, 1).unwrap());
+        assert_eq!(doc.read_queue().unwrap()[1].held, [end, fyi]);
+        assert!(!doc.set_queued_held("gone", &[]).unwrap());
+    }
