+/// The parent's message whose plain end `child`'s report keyed `message_id`
+/// is: none for a follow-up (`end-<answer>`), a question, a stop, or one
+/// kept from the agent.
+fn plain_end<'a>(message_id: &'a str, child: &str) -> Option<&'a str> {
+    message_id
+        .strip_prefix(&format!("report-{child}-"))?
+        .strip_suffix("-end")
+        .filter(|asked| !asked.is_empty())
+}
+
+/// Whether one of `results` shows the child's last answer on the parent's
+/// message `asked` (in `entries`, its transcript) by the time its report
+/// was `written` (both on the child's host's clock): that entry, by its id
+/// or the one it continues, complete, its text holding `reply`.
+fn answer_read(
+    entries: &[SessionMessageEntry],
+    parent: &str,
+    asked: &str,
+    written: i64,
+    reply: &str,
+    results: &[String],
+) -> bool {
+    let Some(at) = entries.iter().position(|e| e.id == asked) else {
+        return false;
+    };
+    let Some(last) = answer_to(entries, at, parent)
+        .iter()
+        .rev()
+        .find(|e| e.role == MessageRole::Assistant && e.created_at <= written)
+    else {
+        return false;
+    };
+    let ids: Vec<&str> = std::iter::once(last.id.as_str()).chain(last.continuation_of.as_deref()).collect();
+    results.iter().any(|output| shows_answer(output, &ids, reply))
+}
+
+/// A `read_chat` or `get_chat` result (`output`) its agent was shown whole,
+/// with a message by one of `ids` from the child, complete, whose text
+/// holds `reply` (spaced as [`squash`] spaces it).
+fn shows_answer(output: &str, ids: &[&str], reply: &str) -> bool {
+    fn shows(value: &Value, ids: &[&str], reply: &str) -> bool {
+        match value {
+            Value::Object(map) => {
+                let field = |key: &str| map.get(key).and_then(Value::as_str);
+                (field("id").is_some_and(|id| ids.contains(&id))
+                    && field("role") == Some("assistant")
+                    && field("status") == Some("complete")
+                    && field("text").is_some_and(|text| squash(&agent_messages::quote_headers(text)).contains(reply)))
+                    || map.values().any(|v| shows(v, ids, reply))
+            }
+            Value::Array(items) => items.iter().any(|v| shows(v, ids, reply)),
+            // A result wrapped as text (MCP content) holds the JSON inside.
+            Value::String(text) => parsed(text).is_some_and(|v| shows(&v, ids, reply)),
+            _ => false,
+        }
+    }
+    output.len() < READ_IN_FULL
+        && ids.iter().any(|id| output.contains(*id))
+        && parsed(output).is_some_and(|value| shows(&value, ids, reply))
+}
