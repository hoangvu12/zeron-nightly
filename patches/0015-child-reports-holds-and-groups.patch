+/// The plain end in `parent`'s ledger (`commands`) that the report `block`
+/// from `child` is: the parent's message it answers, and when the child's
+/// host wrote it. The latest, when the same words answered two.
+fn end_filed<'a>(commands: &'a [SessionCommandEntry], child: &str, block: &str) -> Option<(&'a str, i64)> {
+    commands.iter().rev().find_map(|c| match &c.payload {
+        SessionCommandPayload::Run { request, message_id } if request.prompt == block => {
+            plain_end(message_id, child).map(|asked| (asked, c.issued_at))
+        }
+        _ => None,
+    })
