+/// How long a child's FYIs (its `send_message` with `wake: false`) wait at
+/// a resting parent with nothing to wake it, counted from when the first of
+/// them got here: they go with whatever wakes it first, else then.
+/// `ZERON_REPORT_FYI_HOLD_MS` sets it for tests.
+const REPORT_FYI_HOLD: std::time::Duration = std::time::Duration::from_secs(30 * 60);
+
+fn report_fyi_hold_ms() -> i64 {
+    std::env::var("ZERON_REPORT_FYI_HOLD_MS")
+        .ok()
+        .and_then(|ms| ms.parse().ok())
+        .unwrap_or(REPORT_FYI_HOLD.as_millis() as i64)
+}
