+/// Zeron's notes on `parent`'s groups for a wake carrying `reports`: one
+/// still open says who is done (their ends wait for the rest) and who is
+/// out; one whose wait ran out, as its ends go, says who it still waits on,
+/// each reporting on its own from now on.
+fn group_notes(host: &DocHost, parent: &str, reports: &[agent_messages::ChildReport<'_>]) -> Vec<String> {
+    let Ok(handle) = host.open(parent) else {
+        return Vec::new();
+    };
+    let groups = handle.doc().report_groups();
+    if groups.is_empty() {
+        return Vec::new();
+    }
+    let chats = host.workspace().map(|ws| ws.read_chats().unwrap_or_default()).unwrap_or_default();
+    let ledger = handle.doc().read_commands().unwrap_or_default();
+    let names = |ids: &[&str]| {
+        ids.iter()
+            .map(|id| chats.iter().find(|c| c.id == *id).map_or_else(|| id.chars().take(8).collect(), name_of))
+            .collect::<Vec<_>>()
+            .join(", ")
+    };
+    groups
+        .iter()
+        .filter(|g| !crate::doc_host::cut_off(g))
+        .filter_map(|g| match &g.released {
+            Some(out) => {
+                let ends = reports
+                    .iter()
+                    .any(|r| g.members.iter().any(|m| m.child == r.sender.chat_id && !out.contains(&m.child)));
+                let out: Vec<&str> = out.iter().map(String::as_str).collect();
+                ends.then(|| {
+                    format!(
+                        "The children you asked to hear from at once took too long: above are the ends so far. Still waiting on {}, each reporting on its own from now on.",
+                        names(&out)
+                    )
+                })
+            }
+            None => {
+                let (done, out): (Vec<&GroupMember>, Vec<&GroupMember>) =
+                    g.members.iter().partition(|m| group_done(&ledger, m));
+                let done: Vec<&str> = done.iter().map(|m| m.child.as_str()).collect();
+                let out: Vec<&str> = out.iter().map(|m| m.child.as_str()).collect();
+                let done = if done.is_empty() { "none yet".to_owned() } else { names(&done) };
+                Some(format!(
+                    "You asked to hear from {} at once, when all are done. Done: {done}. Still out: {}.",
+                    names(&g.members.iter().map(|m| m.child.as_str()).collect::<Vec<_>>()),
+                    names(&out)
+                ))
+            }
+        })
+        .collect()
+}
