+/// What a report's key ([`report_id`]) says, `child` known (the report's
+/// header names it): the parent's message it's on, and its stage as a claim
+/// spells it (`end`, `stopped`, `end:<answer>`, `ask:<request>`). Ids hold
+/// dashes, so it's read from both ends, never split on them: the child's id
+/// off the front, the stage's own word found after the message. `None` for
+/// any other key (a message on the way, an FYI).
+pub(crate) fn report_key_parts(key: &str, child: &str) -> Option<(String, String)> {
+    let rest = key.strip_prefix("report-")?.strip_prefix(child)?.strip_prefix('-')?;
+    // A follow-up's or a question's stage carries an id of its own: the
+    // first stage word after the message starts it (a message id is a
+    // uuid, the stage's id may be anything).
+    let with_id = ["end", "ask"]
+        .into_iter()
+        .filter_map(|stage| {
+            let at = rest.find(&format!("-{stage}-"))?;
+            let (asked, id) = (&rest[..at], &rest[at + stage.len() + 2..]);
+            (!asked.is_empty() && !id.is_empty()).then(|| (asked.to_owned(), format!("{stage}:{id}")))
+        })
+        .min_by_key(|(asked, _)| asked.len());
+    with_id.or_else(|| {
+        ["end", "stopped"].into_iter().find_map(|stage| {
+            let asked = rest.strip_suffix(stage)?.strip_suffix('-').filter(|asked| !asked.is_empty())?;
+            Some((asked.to_owned(), stage.to_owned()))
+        })
+    })
+}
