+/// The most a `read_chat` or `get_chat` result may be for its agent to have
+/// been shown it whole (not cut, nor saved to a file). A bigger one cancels
+/// nothing.
+const READ_IN_FULL: usize = 20 * 1024;
+
+/// `batch` (children's reports, one or several merged) without an end
+/// `parent`'s agent read already: a `read_chat` or `get_chat` call it made
+/// since `since` (as for [`without_waited`]) returned the child's last
+/// answer on that request, complete, with the reply the report carries, and
+/// small enough to be shown whole. What it returned is what its host's
+/// journal recorded, never a fresh read. Only a request's end: a follow-up,
+/// a question or a stop is said, and so is a failure (its error isn't in the
+/// answer's text). `None`: nothing left.
+pub(crate) fn without_read(host: &DocHost, parent: &str, batch: &str, since: i64) -> Option<String> {
+    let (Some(reports), Some(blocks)) = (agent_messages::child_reports(batch), agent_messages::report_blocks(batch)) else {
+        return Some(batch.to_owned());
+    };
+    let (Some(engine), Ok(doc)) = (host.sessions(), host.open(parent)) else {
+        return Some(batch.to_owned());
+    };
+    let entries = doc.doc().read_entries().unwrap_or_default();
+    let from = entries
+        .iter()
+        .rposition(|e| e.role == MessageRole::User && e.created_at <= since)
+        .map_or(0, |at| at + 1);
+    let results = read_results(&engine.inner.journal, parent, &entries[from..]);
+    if results.is_empty() {
+        return Some(batch.to_owned());
+    }
+    let commands = doc.doc().read_commands().unwrap_or_default();
+    let kept: Vec<&str> = blocks
+        .iter()
+        .zip(&reports)
+        .filter(|(block, r)| {
+            let child = r.sender.chat_id.as_str();
+            let reply = squash(reported_reply(r.body));
+            let read = r.status == ReportStatus::Finished
+                && !r.body.starts_with(FOLLOW_UP)
+                && !reply.is_empty()
+                && end_filed(&commands, child, block).is_some_and(|(asked, written)| {
+                    host.open(child)
+                        .ok()
+                        .and_then(|handle| handle.doc().read_entries().ok())
+                        .is_some_and(|entries| answer_read(&entries, parent, asked, written, &reply, &results))
+                });
+            !read
+        })
+        .map(|(block, _)| *block)
+        .collect();
+    if kept.len() == blocks.len() {
+        Some(batch.to_owned())
+    } else {
