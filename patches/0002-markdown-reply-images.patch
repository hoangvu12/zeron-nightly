+/// The images a finished reply names in Markdown are kept by the chat's
+/// host, so they still show once their files are gone.
+#[tokio::test]
+async fn a_finished_replys_images_outlive_their_files() {
+    use base64::Engine as _;
+    let dir = tempfile::tempdir().unwrap();
+    let shots = tempfile::tempdir().unwrap();
+    let shot = shots.path().join("shot one.png");
+    let png = {
+        let mut bytes = std::io::Cursor::new(Vec::new());
+        image::DynamicImage::new_rgb8(3, 2)
+            .write_to(&mut bytes, image::ImageFormat::Png)
+            .unwrap();
+        bytes.into_inner()
+    };
+    std::fs::write(&shot, &png).unwrap();
+    let path = shot.to_string_lossy().into_owned();
+    let core = assemble(
+        dir.path(),
+        Arc::new(ScriptedHarness {
+            script: vec![
+                AgentEvent::TextDelta {
+                    text: format!("Here it is:\n\n![the shot](<{path}>)\n"),
+                },
+                done(DoneStatus::Completed),
+            ],
+            step_delay: Duration::from_millis(5),
+            hang_until_interrupt: false,
+        }),
+    );
+    let here = core.device_id.clone();
+    core.workspace
+        .create_chat(CHAT, None, Some(&here), None, None)
+        .unwrap();
+    let handle = core.doc_host.open(CHAT).unwrap();
+    queue_as_viewer(
+        handle.doc(),
+        "cmd-run-images",
+        SessionCommandPayload::Run {
+            request: run_request("show me"),
+            message_id: "m-1".into(),
+        },
+    );
+    fn kept(dir: &std::path::Path) -> usize {
+        std::fs::read_dir(dir)
+            .into_iter()
+            .flatten()
+            .flatten()
+            .map(|entry| {
+                let path = entry.path();
+                if path.file_name().is_some_and(|name| name == "reply-images") {
+                    std::fs::read_dir(&path).map_or(0, |files| files.count())
+                } else if path.is_dir() {
+                    kept(&path)
+                } else {
+                    0
+                }
+            })
+            .sum()
+    }
+    wait_for(|| kept(dir.path()) == 1, "the kept image").await;
+    std::fs::remove_file(&shot).unwrap();
+    let client = zeron_rpc::memory_client(core.rpc_service());
+    let chunk = client
+        .call(
+            zeron_rpc::methods::READ_CHAT_IMAGE_CHUNK,
+            serde_json::json!({ "chatId": CHAT, "path": path, "offset": 0 }),
+        )
+        .await
+        .expect("the kept copy");
+    assert_eq!(
+        base64::engine::general_purpose::STANDARD
+            .decode(chunk["data"].as_str().unwrap())
+            .unwrap(),
+        png
+    );
+    assert_eq!(chunk["name"], "shot one.png");
+    core.shutdown().await;
+}
