+//! Images an agent's reply names in Markdown (`![alt](path)`), from any
+//! local folder on the chat's host.
+//!
+//! The UI asks the chat's host for each one (`ReadChatImageChunk`, relayed
+//! when the chat runs on another device). When a reply segment finishes, the
+//! host also keeps a copy of each image it names under
+//! `{uploads}/reply-images/`, named by chat and resolved path, so the picture
+//! outlives its file. A read serves that copy when there is one, the file
+//! otherwise. Keeping runs once per finished segment and always writes the
+//! same name, so a replay or a restart rewrites a copy rather than adding one.
+//!
+//! Any local path is allowed: absolute, `~/…`, or relative to the chat's
+//! folder. Still refused: URLs, network (UNC) and device paths, and links
+//! that lead to one, since merely opening `\\host\share\…` sends the user's
+//! credentials to that host. Only a PNG, JPEG, WebP, or GIF by its extension
+//! AND its first bytes, of at most [`zeron_proto::IMAGE_MAX_BYTES`].
+
+use std::collections::VecDeque;
+use std::ffi::OsString;
+use std::io::{Read, Seek, Write};
+use std::path::{Path, PathBuf};
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD as BASE64;
+use sha2::{Digest, Sha256};
+
+use crate::EngineError;
+use crate::uploads::{
+    AttachmentChunk, READ_CHUNK_BYTES, lexical_components, mime_by_ext, raster_signature,
+};
+
+/// Where the kept copies live, under the uploads dir.
+const KEPT_DIR: &str = "reply-images";
+/// Images kept per finished segment; any past these are still read live.
+const MAX_KEPT: usize = 8;
+/// Links followed while resolving one path.
+const MAX_LINKS: usize = 40;
+
+/// The image sources `text` names (`![alt](src)`, `![alt](<src>)`), in
+/// order and once each, outside fenced code.
+pub(crate) fn sources(text: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    let mut fence: Option<&str> = None;
+    for line in text.lines() {
+        let trimmed = line.trim_start();
+        if let Some(marker) = ["```", "~~~"].into_iter().find(|m| trimmed.starts_with(m)) {
+            match fence {
+                Some(open) if open == marker => fence = None,
+                None => fence = Some(marker),
+                Some(_) => {}
+            }
+            continue;
+        }
+        if fence.is_some() {
+            continue;
+        }
+        let mut rest = line;
+        while let Some(start) = rest.find("![") {
+            rest = &rest[start + 2..];
+            let Some(close) = rest.find("](") else { break };
+            rest = &rest[close + 2..];
+            let source = if let Some(inner) = rest.strip_prefix('<') {
+                let Some(end) = inner.find('>') else { break };
+                rest = &inner[end + 1..];
+                &inner[..end]
+            } else {
+                let end = rest
+                    .find(|c: char| c == ')' || c.is_whitespace())
+                    .unwrap_or(rest.len());
+                let (source, after) = rest.split_at(end);
+                rest = after;
+                source
+            };
+            let source = source.trim();
+            if !source.is_empty() && !out.iter().any(|known| known == source) {
+                out.push(source.to_owned());
+            }
+        }
+    }
+    out
+}
+
+/// Where `source` points on this host, lexically (no filesystem call):
+/// absolute, `~/…`, or relative to the chat's `folder`. `None` for a URL, a
+/// network or device path, or a relative path with no folder to join.
+pub(crate) fn resolve(source: &str, folder: Option<&Path>) -> Option<PathBuf> {
+    let source = source.trim();
+    if has_scheme(source) {
+        return None;
+    }
+    let path = match source.strip_prefix('~') {
+        Some(rest) if rest.is_empty() || rest.starts_with(['/', '\\']) => {
+            crate::repos::session_home_dir()
+                .ok()?
+                .join(rest.trim_start_matches(['/', '\\']))
+        }
+        Some(_) => return None,
+        None if Path::new(source).is_absolute() => PathBuf::from(source),
+        None => folder?.join(source),
+    };
+    Some(lexical_components(&path)?.into_iter().collect())
+}
+
+/// `http:`, `file:`, `data:`…; a drive letter (`C:\`) is not one.
+fn has_scheme(source: &str) -> bool {
+    source.split_once(':').is_some_and(|(scheme, _)| {
+        scheme.len() > 1
+            && scheme.starts_with(|c: char| c.is_ascii_alphabetic())
+            && scheme
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '+' | '-' | '.'))
+    })
+}
+
+/// A resolved path's anchor (`C:` + `\` on Windows, `/` elsewhere) and the
+/// names below it.
+fn split_anchor(mut parts: Vec<OsString>) -> (PathBuf, Vec<OsString>) {
+    let names = parts.split_off(if cfg!(windows) { 2 } else { 1 }.min(parts.len()));
+    (parts.into_iter().collect(), names)
+}
+
+/// `path` with each link on it followed, `lstat`ing every component before
+/// anything opens it: a link (a Windows junction counts) to a network or
+/// device path is refused unfollowed, as is a Windows device name or a loop.
+/// `None` when part of it doesn't exist.
+fn local_target(path: &Path) -> Option<PathBuf> {
+    let (mut walked, names) = split_anchor(lexical_components(path)?);
+    let mut pending: VecDeque<OsString> = names.into();
+    let mut links = 0;
+    while let Some(name) = pending.pop_front() {
+        #[cfg(windows)]
+        if crate::uploads::is_windows_device_name(&name) {
+            return None;
+        }
+        walked.push(&name);
+        if !std::fs::symlink_metadata(&walked)
+            .ok()?
+            .file_type()
+            .is_symlink()
+        {
+            continue;
+        }
+        links += 1;
+        if links > MAX_LINKS {
+            return None;
+        }
+        let target = std::fs::read_link(&walked).ok()?;
+        walked.pop();
+        let (anchor, names) = split_anchor(lexical_components(&walked.join(target))?);
+        walked = anchor;
+        pending = names.into_iter().chain(pending).collect();
+    }
+    Some(walked)
+}
+
+/// The type of the image at `file` (a path with no links left on it), when
+/// it is one a reply may show.
+fn checked(file: &Path) -> Result<&'static str, EngineError> {
+    let refused = |why: &str| EngineError::Other(why.into());
+    let meta = std::fs::metadata(file)?;
+    if !meta.is_file() {
+        return Err(refused("Image is not a file"));
+    }
+    if meta.len() > zeron_proto::IMAGE_MAX_BYTES as u64 {
+        return Err(refused("Image is too large"));
+    }
+    let mime = mime_by_ext(file)
+        .filter(|mime| {
+            matches!(
+                *mime,
+                "image/png" | "image/jpeg" | "image/webp" | "image/gif"
+            )
+        })
+        .ok_or_else(|| refused("Not a PNG, JPEG, WebP, or GIF image"))?;
+    let mut head = Vec::with_capacity(12);
+    std::fs::File::open(file)?.take(12).read_to_end(&mut head)?;
+    if raster_signature(&head).map(|(_, mime)| mime) != Some(mime) {
+        return Err(refused("Image content doesn't match its name"));
+    }
+    Ok(mime)
+}
+
+/// Where the copy of `path` a reply in `chat_id` names is kept.
+fn kept(uploads_dir: &Path, chat_id: &str, path: &Path) -> Option<PathBuf> {
+    let ext = path.extension()?.to_str()?.to_ascii_lowercase();
+    let key = Sha256::digest(format!("{chat_id}\0{}", path.display()).as_bytes());
+    Some(uploads_dir.join(KEPT_DIR).join(format!("{key:x}.{ext}")))
+}
+
+/// Keep a copy of each image `text` names (see the module docs). Blocking;
+/// an image that can't be kept stays a live read.
+pub(crate) fn keep(uploads_dir: &Path, chat_id: &str, folder: &Path, text: &str) {
+    for source in sources(text).into_iter().take(MAX_KEPT) {
+        let Some(path) = resolve(&source, Some(folder)) else {
+            continue;
+        };
+        if let Err(err) = keep_one(uploads_dir, chat_id, &path) {
+            tracing::debug!(chat = %chat_id, %source, error = %err, "reply image not kept");
+        }
+    }
+}
+
+fn keep_one(uploads_dir: &Path, chat_id: &str, path: &Path) -> Result<(), EngineError> {
+    let refused = |why: &str| EngineError::Other(why.into());
+    let destination =
+        kept(uploads_dir, chat_id, path).ok_or_else(|| refused("Image has no extension"))?;
+    let file = local_target(path).ok_or_else(|| refused("Image is not a local file"))?;
+    let mime = checked(&file)?;
+    let mut bytes = Vec::new();
+    std::fs::File::open(&file)?
+        .take(zeron_proto::IMAGE_MAX_BYTES as u64 + 1)
+        .read_to_end(&mut bytes)?;
+    // Checked again: the file may have changed since.
+    if bytes.len() > zeron_proto::IMAGE_MAX_BYTES
+        || raster_signature(&bytes).map(|(_, found)| found) != Some(mime)
+    {
+        return Err(refused("Image changed while it was kept"));
+    }
+    let dir = destination.parent().expect("a kept image has a folder");
+    std::fs::create_dir_all(dir)?;
+    let mut temporary = tempfile::NamedTempFile::new_in(dir)?;
+    temporary.write_all(&bytes)?;
+    temporary
+        .persist(&destination)
+        .map_err(|e| EngineError::Io(e.error))?;
+    Ok(())
+}
+
+/// One chunk of the image `source` names in a reply in `chat_id`: its kept
+/// copy when there is one, else the file itself.
+pub(crate) fn read_chunk(
+    uploads_dir: &Path,
+    chat_id: &str,
+    folder: Option<&Path>,
+    source: &str,
+    offset: u64,
+) -> Result<AttachmentChunk, EngineError> {
+    let refused = |why: &str| EngineError::Other(why.into());
+    let path = resolve(source, folder)
+        .ok_or_else(|| refused("Image is not a local path on the chat's device"))?;
+    let file = match kept(uploads_dir, chat_id, &path).filter(|kept| kept.is_file()) {
+        Some(kept) => kept,
+        None => local_target(&path)
+            .ok_or_else(|| refused("Image is missing, or behind a network or device path"))?,
+    };
+    let mime_type = checked(&file)?;
+    let mut handle = std::fs::File::open(&file)?;
+    let size = handle.metadata()?.len();
+    let start = offset.min(size);
+    let next_offset = (start + READ_CHUNK_BYTES).min(size);
+    handle.seek(std::io::SeekFrom::Start(start))?;
+    let mut buf = Vec::with_capacity((next_offset - start) as usize);
+    handle.take(next_offset - start).read_to_end(&mut buf)?;
+    Ok(AttachmentChunk {
+        name: Path::new(source)
+            .file_name()
+            .map(|n| n.to_string_lossy().into_owned())
+            .unwrap_or_else(|| "image".into()),
+        mime_type: mime_type.to_owned(),
+        data: BASE64.encode(&buf),
+        next_offset,
+        done: next_offset >= size,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PNG: &[u8] = b"\x89PNG\r\n\x1a\nfixture";
+
+    fn read_all(uploads: &Path, chat: &str, folder: Option<&Path>, source: &str) -> Vec<u8> {
+        let (mut offset, mut out) = (0, Vec::new());
+        loop {
+            let chunk = read_chunk(uploads, chat, folder, source, offset)
+                .unwrap_or_else(|e| panic!("{source}: {e}"));
+            out.extend(BASE64.decode(&chunk.data).unwrap());
+            if chunk.done {
+                return out;
+            }
+            offset = chunk.next_offset;
+        }
+    }
+
+    #[test]
+    fn sources_are_the_images_outside_code() {
+        let text = "Before ![a](shots/a.png) and ![b [x]](<C:\\Users\\HP MEDIA\\b.png>).\n\
+                    ![a again](shots/a.png \"title\")\n\
+                    ```\n![not](code.png)\n```\n\
+                    [a link](c.png) ![](  ) ![last](/tmp/d.webp)";
+        assert_eq!(
+            sources(text),
+            ["shots/a.png", r"C:\Users\HP MEDIA\b.png", "/tmp/d.webp"]
+        );
+    }
+
+    #[test]
+    fn only_local_paths_resolve() {
+        let folder = std::env::temp_dir().join("chat");
+        assert_eq!(
+            resolve("shots/a.png", Some(&folder)),
+            resolve(&folder.join("shots").join("a.png").to_string_lossy(), None)
+        );
+        assert!(resolve("a.png", None).is_none());
+        assert!(resolve("~/a.png", None).is_some());
+        let mut refused = vec![
+            "https://example.com/a.png",
+            "file:///tmp/a.png",
+            "data:image/png;base64,iVBORw0KGgo=",
+            "~someone/a.png",
+        ];
+        // Network and device paths, as Windows reads them.
+        #[cfg(windows)]
+        refused.extend([
+            r"\\host\share\a.png",
+            "//host/share/a.png",
+            r"\\.\COM1\a.png",
+            "C:a.png",
+        ]);
+        for source in refused {
+            assert!(resolve(source, Some(&folder)).is_none(), "{source}");
+        }
+    }
+
+    #[test]
+    fn images_read_from_any_folder_and_from_their_kept_copy_once_kept() {
+        let uploads = tempfile::tempdir().unwrap();
+        let folder = tempfile::tempdir().unwrap();
+        let elsewhere = tempfile::tempdir().unwrap();
+        let outside = elsewhere.path().join("outside.png");
+        std::fs::write(&outside, PNG).unwrap();
+        std::fs::write(folder.path().join("here.png"), PNG).unwrap();
+        let outside_text = outside.to_string_lossy().into_owned();
+
+        // Live, from outside the chat's folder and relative to it.
+        assert_eq!(read_all(uploads.path(), "c", None, &outside_text), PNG);
+        assert_eq!(
+            read_all(uploads.path(), "c", Some(folder.path()), "here.png"),
+            PNG
+        );
+
+        // A long file arrives in chunks that concatenate to it.
+        let mut long = PNG.to_vec();
+        long.resize(100_000, 7);
+        std::fs::write(folder.path().join("long.png"), &long).unwrap();
+        assert_eq!(
+            read_all(uploads.path(), "c", Some(folder.path()), "long.png"),
+            long
+        );
+
+        // Kept, it outlives its file, for that chat only.
+        let reply = format!("![one](<{outside_text}>) ![two](here.png)");
+        keep(uploads.path(), "c", folder.path(), &reply);
+        keep(uploads.path(), "c", folder.path(), &reply);
+        let kept_dir = uploads.path().join(KEPT_DIR);
+        assert_eq!(std::fs::read_dir(&kept_dir).unwrap().count(), 2);
+        std::fs::remove_file(&outside).unwrap();
+        assert_eq!(read_all(uploads.path(), "c", None, &outside_text), PNG);
+        assert!(read_chunk(uploads.path(), "other", None, &outside_text, 0).is_err());
+    }
+
+    #[test]
+    fn what_is_not_an_image_file_is_refused() {
+        let uploads = tempfile::tempdir().unwrap();
+        let folder = tempfile::tempdir().unwrap();
+        let at = |name: &str| folder.path().join(name);
+        std::fs::create_dir(at("dir.png")).unwrap();
+        std::fs::write(at("notes.txt"), b"secret").unwrap();
+        std::fs::write(at("fake.png"), b"secret, not a png").unwrap();
+        std::fs::write(at("photo.png"), b"\xff\xd8\xffjpeg").unwrap();
+        std::fs::write(at("logo.svg"), b"<svg/>").unwrap();
+        std::fs::File::create(at("big.png"))
+            .unwrap()
+            .set_len(zeron_proto::IMAGE_MAX_BYTES as u64 + 1)
+            .unwrap();
+        let mut refused = vec![
+            ("dir.png", "not a file"),
+            ("notes.txt", "Not a PNG"),
+            ("logo.svg", "Not a PNG"),
+            ("fake.png", "doesn't match its name"),
+            ("photo.png", "doesn't match its name"),
+            ("big.png", "too large"),
+            ("gone.png", "missing"),
+        ];
+        #[cfg(windows)]
+        refused.extend([
+            (r"\\host\share\x.png", "not a local path"),
+            ("nul.png", "missing"),
+        ]);
+        for (name, why) in refused {
+            let error = read_chunk(uploads.path(), "c", Some(folder.path()), name, 0)
+                .expect_err(name)
+                .to_string();
+            assert!(error.contains(why), "{name}: {error}");
+        }
+        keep(
+            uploads.path(),
+            "c",
+            folder.path(),
+            "![](fake.png) ![](big.png)",
+        );
+        assert!(!uploads.path().join(KEPT_DIR).exists());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn links_are_followed_only_to_local_paths() {
+        let uploads = tempfile::tempdir().unwrap();
+        let folder = tempfile::tempdir().unwrap();
+        let elsewhere = tempfile::tempdir().unwrap();
+        std::fs::write(elsewhere.path().join("x.png"), PNG).unwrap();
+        std::os::unix::fs::symlink(elsewhere.path(), folder.path().join("linked")).unwrap();
+        std::os::unix::fs::symlink("x.png", elsewhere.path().join("alias.png")).unwrap();
+        std::os::unix::fs::symlink("loop.png", folder.path().join("loop.png")).unwrap();
+        for name in ["linked/x.png", "linked/alias.png"] {
+            assert_eq!(
+                read_all(uploads.path(), "c", Some(folder.path()), name),
+                PNG
+            );
+        }
+        assert!(read_chunk(uploads.path(), "c", Some(folder.path()), "loop.png", 0).is_err());
+    }
+}
