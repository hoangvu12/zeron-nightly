+-- A file attached in a chat's composer gets the direct link to the chat's
+-- host ready while the message is still being written
+-- (screens/chat/composer, store.warm_link): the engine pairs then, so Send
+-- finds the link up instead of starting the bytes on the relay. On
+-- ui/chat_fixture.luau, which notes `warm_link:<id>`.
+
+local function settle(app: any)
+	app:frames(30)
+end
+
+local function calls(app: any): string
+	return app:state("calls") or ""
+end
+
+test("a file attached in a chat's composer warms the link to its host", function()
+	local app = mount("chat_fixture.luau")
+	app:resize(1200, 800)
+	settle(app)
+	app:command("go_s2")
+	settle(app)
+	expect(calls(app)).never.to_contain("warm_link:")
