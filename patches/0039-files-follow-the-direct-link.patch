+    pub async fn client_within(
+        &self,
+        device: &str,
+        patience: Duration,
+    ) -> Option<Arc<RpcClient>> {
+        let deadline = Instant::now() + patience;
+        loop {
+            if let Some(client) = self.client(device).await {
