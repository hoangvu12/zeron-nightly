+
+/// A stand-in for the WebRTC pairing between A and B, in front of B's real
+/// direct RPC host. It comes up `after` asked for (`None`: only when
+/// [`Pairing::set_up`] says so).
+struct Pairing {
+    host: zeron_engine::direct_rpc::Service,
+    after: Option<Duration>,
+    asked: Mutex<Option<std::time::Instant>>,
+    up: std::sync::atomic::AtomicBool,
+}
+
+impl Pairing {
+    fn set_up(&self) {
+        self.up.store(true, Ordering::SeqCst);
+    }
+}
+
+#[async_trait]
+impl zeron_engine::direct_rpc::Pairing for Pairing {
+    async fn ready(&self, _device: &str) -> bool {
+        self.up.load(Ordering::SeqCst)
+            || self.after.is_some_and(|after| {
+                self.asked
+                    .lock()
+                    .expect("lock")
+                    .is_some_and(|asked| asked.elapsed() >= after)
+            })
+    }
+
+    fn warm(&self, _device: &str) {
+        self.asked
+            .lock()
+            .expect("lock")
+            .get_or_insert_with(std::time::Instant::now);
+    }
+
+    async fn open(&self, device: &str) -> anyhow::Result<zeron_preview::mux::BoxIo> {
+        use zeron_preview::mux::Connector as _;
+        anyhow::ensure!(
+            zeron_engine::direct_rpc::Pairing::ready(self, device).await,
+            "not paired"
+        );
+        self.host
+            .connect_from(Some("device-a"), zeron_engine::direct_rpc::SERVICE)
+            .await
+    }
+}
+
+/// A and B in a room that never cuts a link (`on_chunk` hears of each chunk
+/// it carries), B's direct host behind a [`Pairing`] that comes up `after`
+/// asked for, and A's registry row for B saying B serves direct RPC.
+struct DirectPair {
+    core_a: EngineCore,
+    core_b: EngineCore,
+    pairing: Arc<Pairing>,
+    seen: Seen,
+    relayed: Arc<AtomicUsize>,
+    _direct_service: Arc<dyn zeron_rpc::RpcService>,
+    _host: zeron_rpc::HostRelay,
+    _relay: tokio::task::JoinHandle<()>,
+}
+
+async fn direct_pair(
+    dirs: &std::path::Path,
+    after: Option<Duration>,
+    on_chunk: impl Fn(usize, &Pairing) + Send + Sync + 'static,
+) -> DirectPair {
+    let core_b = assemble(&dirs.join("b"), "device-b");
+    let seen = Seen::default();
+    let direct_service: Arc<dyn zeron_rpc::RpcService> = Arc::new(NotedDirect {
+        inner: core_b.rpc_service(),
+        seen: seen.clone(),
+    });
+    let pairing = Arc::new(Pairing {
+        host: zeron_engine::direct_rpc::Service::new(&direct_service),
+        after,
+        asked: Mutex::new(None),
+        up: Default::default(),
+    });
+    let relayed = Arc::new(AtomicUsize::new(0));
+    let hook = {
+        let pairing = Arc::downgrade(&pairing);
+        Arc::new(move |count: usize| {
+            if let Some(pairing) = pairing.upgrade() {
+                on_chunk(count, &pairing);
+            }
+        })
+    };
+    let (relay_url, relay) = device_room(relayed.clone(), usize::MAX, Some(hook)).await;
+    let host = core_b.start_host_relay(&relay_url);
+
+    let core_a = assemble(&dirs.join("a"), "device-a");
+    let mut capabilities = zeron_proto::capabilities::current();
+    capabilities.push(zeron_proto::capabilities::DIRECT_RPC_V1.to_owned());
+    core_a.workspace.upsert_device_row(&Device {
+        id: "device-b".into(),
+        name: "b".into(),
+        platform: "linux".into(),
+        last_seen_at: Some(chrono::Utc::now()),
+        created_at: None,
+        version: Some("0.3.21".into()),
+        cursor_sdk_version: None,
+        capabilities,
+    });
+    core_a.set_direct_links(zeron_engine::direct_rpc::Links::over(pairing.clone()));
+    let mut link_config =
+        LinkCacheConfig::new(relay_url, Arc::new(StaticToken("test-user".into())));
+    link_config.probe_timeout = Duration::from_secs(5);
+    core_a.set_links(LinkCache::new(link_config));
+    DirectPair {
+        core_a,
+        core_b,
+        pairing,
+        seen,
+        relayed,
+        _direct_service: direct_service,
+        _host: host,
+        _relay: relay,
+    }
+}
+
+/// A message with a file of `size` bytes, sent from A to the chat on B;
+/// returns the bytes and how many chunks they make.
+async fn send_file(pair: &DirectPair, upload: &str, size: u32) -> (Vec<u8>, usize) {
+    let bytes: Vec<u8> = (0..size)
+        .map(|i| (i.wrapping_mul(2_654_435_761) >> 13) as u8)
+        .collect();
+    let total_chunks = BASE64.encode(&bytes).len().div_ceil(60_000);
+    let client_a = zeron_rpc::memory_client(pair.core_a.rpc_service());
+    client_a
+        .call(
+            methods::MUTATE,
+            serde_json::json!({ "op": "createChat", "chatId": CHAT, "deviceId": "device-b" }),
+        )
+        .await
+        .expect("createChat on A");
+    pair.core_b
+        .workspace
+        .rename_chat(CHAT, "Pre-titled")
+        .expect("pre-title on B (no auto-title harness run)");
+    let encoded = BASE64.encode(&bytes);
+    for (seq, piece) in encoded.as_bytes().chunks(500_000).enumerate() {
+        client_a
+            .call(
+                methods::UPLOAD_CHUNK,
+                serde_json::json!({
+                    "uploadId": upload, "seq": seq,
+                    "data": std::str::from_utf8(piece).expect("base64 is ascii"),
+                }),
+            )
+            .await
+            .expect("stage chunk on A");
+    }
+    client_a
+        .call(
+            methods::UPLOAD_COMMIT,
+            serde_json::json!({ "uploadId": upload, "fileName": "big.bin" }),
+        )
+        .await
+        .expect("commit on A");
+    let reference = format!("pending://{upload}/big.bin");
+    let command = serde_json::to_value(SessionCommandPayload::Run {
+        request: RunRequest {
+            mcp: None,
+            prompt: format!("look at this\n\nAttached files:\n- {reference}"),
+            harness: None,
+            model: None,
+            reasoning: None,
+            model_options: Default::default(),
+            cwd: "~".into(),
+            sandbox: SandboxLevel::WorkspaceWrite,
+            auto_approve: true,
+            access: Default::default(),
+            plan: false,
+            code_mode: false,
+            zeron_mcp_only: false,
+            attachments: vec![reference.clone()],
+            worktree: None,
+            resume: None,
+            env: Default::default(),
+            extra_mcp: Vec::new(),
+        },
+        message_id: format!("msg-{upload}"),
+    })
+    .expect("command json");
+    client_a
+        .call(
+            methods::QUEUE_COMMAND,
+            serde_json::json!({
+                "chatId": CHAT,
+                "command": command,
+                "transfers": [{ "uploadId": upload, "fileName": "big.bin" }],
+            }),
+        )
+        .await
+        .expect("queue on A");
+    (bytes, total_chunks)
+}
+
+/// The message ran on B, with the file whole there.
+async fn ran_with_the_file(pair: &DirectPair, dirs: &std::path::Path, name: &str, bytes: &[u8]) {
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(90);
+    while complete_assistant_count(&pair.core_b) < 1 {
+        assert!(
+            tokio::time::Instant::now() < deadline,
+            "the message never ran on B; {} chunks relayed, {} direct",
+            pair.relayed.load(Ordering::SeqCst),
+            came_direct(&pair.seen, methods::UPLOAD_CHUNK),
+        );
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    let landed = find_file(&dirs.join("b"), name).expect("B committed the file");
+    assert_eq!(std::fs::read(landed).expect("read landed file"), bytes, "whole");
+}
+
+fn came_direct(seen: &Seen, method: &str) -> usize {
+    seen.lock()
+        .expect("lock")
+        .iter()
+        .filter(|m| m.as_str() == method)
+        .count()
+}
+
+/// The 2.1 MB image of 2026-11-26 started on the relay while pairing was
+/// 0.84 s from done, and took 21.7 s there. A big file now waits a moment for
+/// a pairing under way, and goes direct, every chunk.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_big_file_waits_a_moment_for_a_pairing_under_way_and_goes_direct() {
+    let dirs = tempfile::tempdir().expect("tempdir");
+    let pair = direct_pair(dirs.path(), Some(Duration::from_millis(300)), |_, _| {}).await;
+    let (bytes, total_chunks) = send_file(&pair, "att-wait", 1_500_000).await;
+    ran_with_the_file(&pair, dirs.path(), "att-wait-big.bin", &bytes).await;
+    assert_eq!(pair.relayed.load(Ordering::SeqCst), 0, "no chunk took the relay");
+    assert_eq!(came_direct(&pair.seen, methods::UPLOAD_CHUNK), total_chunks);
+    assert_eq!(came_direct(&pair.seen, methods::UPLOAD_COMMIT), 1);
+    pair.core_a.shutdown().await;
+    pair.core_b.shutdown().await;
+}
+
+/// A file under way on the relay moves to the direct link when that comes
+/// up: the road is picked again each time the window has room, and the host
+/// keeps each chunk whichever road carried it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_file_on_the_relay_moves_to_the_direct_link_when_it_comes_up() {
+    let dirs = tempfile::tempdir().expect("tempdir");
+    let pair = direct_pair(dirs.path(), None, |count, pairing| {
+        if count == 8 {
+            pairing.set_up();
+        }
+    })
+    .await;
+    let (bytes, total_chunks) = send_file(&pair, "att-move", 1_500_000).await;
+    ran_with_the_file(&pair, dirs.path(), "att-move-big.bin", &bytes).await;
+    let relayed = pair.relayed.load(Ordering::SeqCst);
+    let direct = came_direct(&pair.seen, methods::UPLOAD_CHUNK);
+    assert!(relayed >= 8, "{relayed} relayed");
+    assert!(direct > 0, "none moved to the direct link ({relayed} relayed)");
+    assert!(
+        relayed < total_chunks,
+        "the rest stayed on the relay: {relayed} of {total_chunks}"
+    );
+    assert!(relayed + direct >= total_chunks);
+    assert!(
+        pair.pairing.up.load(Ordering::SeqCst),
+        "the pairing came up mid-file"
+    );
+    pair.core_a.shutdown().await;
+    pair.core_b.shutdown().await;
+}
