From 97d3d5cf2113cb59a9610c263b3aff564992409a Mon Sep 17 00:00:00 2001
From: hoangvu12 <hggaming91@gmail.com>
Date: Sat, 14 Nov 2026 04:29:38 +0700
Subject: [PATCH] plugins: a window has the memory its manifest asks for its
 service

A plugin's manifest asking `"limits": { "memory_mb": 256 }` had it for its
service alone: its window stayed at zgx's 32 MiB for any plugin, and the
Design plugin's window stopped on a large design ("not enough memory").
Each window loaded now gets what its service does (at most 512 MB, as the
engine checks), by zgx's ScriptHost::plugin_memory; the rest keep the
default. Needs a zgx with that setter (zgx-script `plugin_memory`).
---
 apps/zgx/src/plugins/loading_tests.rs | 33 ++++++++++++++++++++++++++-
 apps/zgx/src/plugins/mod.rs           | 18 +++++++++++++++
 2 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/apps/zgx/src/plugins/loading_tests.rs b/apps/zgx/src/plugins/loading_tests.rs
index 294e7553d656e10b5ca91f887b6b34f8ec4d6a82..3f37895d994569faf0f5a3002aca639b1eb3dd22 100644
--- a/apps/zgx/src/plugins/loading_tests.rs
+++ b/apps/zgx/src/plugins/loading_tests.rs
@@ -16,7 +16,7 @@ use std::{
 use serde_json::json;
 use zgx_script::{ScriptHost, Value, testing::TestApp};
 
-use super::{Item, expose_own, expose_surface, json_value, live, problem_words, records, recovery, vlist};
+use super::{Item, expose_own, expose_surface, give_memory, json_value, live, problem_words, records, recovery, vlist};
 
 const APP: &str = r#"
 local who = ui.shared("zeron.route", { name = "home" })
@@ -105,6 +105,7 @@ fn app_of(root: &Path, source: &str, items: &[Item], extra: Vec<zgx_script::Plug
         }
         plugins.extend(extra);
         host.set_plugins(plugins);
+        give_memory(&host, &items);
         host
     });
     (app, heard)
@@ -1168,3 +1169,33 @@ n:set(n:peek() + 1)
     a.host.save();
     assert_eq!(saved().as_deref().map(str::trim), Some("1"), "starts from its initial");
 }
+
+#[test]
+fn a_window_has_the_memory_its_manifest_asks() {
+    let root = dir("memory");
+    // 48 strings of 1 MB, held: past zgx's default 32 MB for a plugin.
+    let hold = |id: &str| {
+        format!(
+            r#"
+local held, made = table.create(48), 0
+for i = 1, 48 do
+    if not pcall(function() held[i] = string.rep("x", 1048576) .. i end) then break end
+    made = i
+end
+ui.invoke("plugin.{id}.result", made)
+"#
+        )
+    };
+    let mut asks = plugin(&root, "asks", &hold("asks"), &[], &[], &[]);
+    asks.json["service_memory_mb"] = json!(64);
+    let plain = plugin(&root, "plain", &hold("plain"), &[], &[], &[]);
+    let (a, heard) = app(&root, &[asks, plain], vec![]);
+    a.frames(2);
+    let made = |id: &str| -> usize {
+        let key = format!("plugin.{id}.result");
+        let heard = heard.borrow();
+        heard.iter().find(|(k, _)| *k == key).unwrap_or_else(|| panic!("{id}: {heard:?}")).1.parse().unwrap()
+    };
+    assert_eq!(made("asks"), 48, "64 MB asked: it holds all 48");
+    assert!(made("plain") < 32, "the default: under 32 MB");
+}
diff --git a/apps/zgx/src/plugins/mod.rs b/apps/zgx/src/plugins/mod.rs
index b6b9effa54483c39ee13c15adc5d41dd562a9bdd..21cfdfa14694debc89a5dc1ef17b14c6b5de2ddd 100644
--- a/apps/zgx/src/plugins/mod.rs
+++ b/apps/zgx/src/plugins/mod.rs
@@ -174,6 +174,23 @@ impl Item {
             ),
         })
     }
+    /// Its window's heap, in bytes: what its manifest asks for its service
+    /// (`limits.memory_mb`, at most the engine's 512), its window too; none,
+    /// zgx's default for a plugin.
+    pub fn window_memory(&self) -> Option<usize> {
+        let mb = self.json["service_memory_mb"].as_u64().filter(|mb| *mb > 0)?;
+        Some((mb.min(512) as usize) << 20)
+    }
+}
+
+/// Each plugin's window heap as its manifest asks (`Item::window_memory`),
+/// after `set_plugins`, which forgets those set before.
+fn give_memory<'a>(host: &ScriptHost, items: impl IntoIterator<Item = &'a Item>) {
+    for item in items {
+        if let Some(bytes) = item.window_memory() {
+            host.plugin_memory(item.id(), bytes);
+        }
+    }
 }
 
 #[derive(Default)]
@@ -1340,6 +1357,7 @@ impl Bridge {
         }
         *self.loaded.borrow_mut() = want.clone();
         self.host.set_plugins(want);
+        give_memory(&self.host, items.iter().filter(|i| loading.contains(i.id())));
         self.reload();
     }
 
