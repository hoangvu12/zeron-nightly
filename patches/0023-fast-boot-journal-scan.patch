@@ -552,9 +553,19 @@ impl RunJournal {
 
     /// Crash-recovery scan: chat ids whose journal's last event is NOT a `Done` — their
     /// runs died mid-stream and need recovery (stamp `aborted`, close the journal).
+    ///
+    /// Boot runs this before the engine is ready, over every journal ever written. A
+    /// journal is append-only, so one that ended in a closed turn and still has the size
+    /// and modified time it had then has not changed: [`CLOSED_INDEX`] remembers those,
+    /// and only journals that are new or changed are opened. Opening is what costs: on
+    /// Windows an on-access virus scan reads the whole file first (~30 ms a journal cold,
+    /// 30 s+ over a thousand), where reading its size and time opens no data at all.
+    /// The ones that must be read are read a few at a time, since those scans overlap.
     pub fn stale_sessions(&self) -> Result<Vec<String>, JournalError> {
         self.flush_all();
-        let mut stale = Vec::new();
+        let known = read_closed_index(&self.dir);
+        let mut closed: Vec<(String, FileStamp)> = Vec::new();
+        let mut unknown: Vec<(String, PathBuf, Option<FileStamp>)> = Vec::new();
         for entry in std::fs::read_dir(&self.dir)? {
             let entry = entry?;
             let path = entry.path();
@@ -564,12 +575,27 @@ impl RunJournal {
             let Some(chat_id) = path.file_stem().and_then(|s| s.to_str()) else {
                 continue;
             };
-            // Tail read only: journals reach tens of MB and boot scans every one.
-            match last_valid_line(&path)? {
-                Some((_, AgentEvent::Done { .. })) | None => {}
-                Some(_) => stale.push(chat_id.to_string()),
+            // The file's own metadata, not the directory listing's copy (NTFS updates
+            // that lazily while a handle is open).
+            let stamp = std::fs::metadata(&path).ok().and_then(|m| FileStamp::of(&m));
+            match stamp {
+                Some(stamp) if known.get(chat_id) == Some(&stamp) => {
+                    closed.push((chat_id.to_string(), stamp));
+                }
+                _ => unknown.push((chat_id.to_string(), path, stamp)),
+            }
+        }
+        let mut stale = Vec::new();
+        for ((chat_id, _, stamp), is_stale) in unknown.iter().zip(read_tails(&unknown)) {
+            if is_stale? {
+                stale.push(chat_id.clone());
+            } else if let Some(stamp) = stamp {
+                closed.push((chat_id.clone(), *stamp));
             }
         }
+        if closed.len() != known.len() || closed.iter().any(|(id, stamp)| known.get(id) != Some(stamp)) {
+            write_closed_index(&self.dir, &mut closed);
+        }
         stale.sort();
         Ok(stale)
     }
@@ -606,6 +632,125 @@ fn contains(haystack: &[u8], needle: &[u8]) -> bool {
