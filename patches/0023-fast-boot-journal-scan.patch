+/// Beside the journals: one `{chat_id}\t{len}\t{modified_ns}` line per journal last
+/// seen ending in a closed turn ([`RunJournal::stale_sessions`]). Losing it costs one
+/// slow scan; a wrong line can't hide a crash, since any write changes the length.
+const CLOSED_INDEX: &str = "closed-journals.idx";
+/// The most journals [`read_tails`] opens at once (cold opens wait on a virus scan,
+/// and those overlap: 8 at a time took a third of the time one at a time did).
+const TAIL_READERS: usize = 8;
+
+/// A journal's size and modified time, as [`CLOSED_INDEX`] records them.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct FileStamp {
+    len: u64,
+    modified_ns: u128,
+}
+
+impl FileStamp {
+    fn of(meta: &std::fs::Metadata) -> Option<Self> {
+        let modified = meta
+            .modified()
+            .ok()?
+            .duration_since(std::time::UNIX_EPOCH)
+            .ok()?;
+        Some(Self {
+            len: meta.len(),
+            modified_ns: modified.as_nanos(),
+        })
+    }
+}
+
+/// [`CLOSED_INDEX`] as saved; empty when missing or unreadable, and a line that
+/// doesn't parse is left out (its journal is read again).
+fn read_closed_index(dir: &Path) -> HashMap<String, FileStamp> {
+    let Ok(raw) = std::fs::read_to_string(dir.join(CLOSED_INDEX)) else {
+        return HashMap::new();
+    };
+    raw.lines()
+        .filter_map(|line| {
+            let mut fields = line.split('\t');
+            let chat_id = fields.next().filter(|id| !id.is_empty())?;
+            let len = fields.next()?.parse().ok()?;
+            let modified_ns = fields.next()?.parse().ok()?;
+            if fields.next().is_some() {
+                return None;
+            }
+            Some((chat_id.to_string(), FileStamp { len, modified_ns }))
+        })
+        .collect()
+}
+
+/// Replace [`CLOSED_INDEX`] (written aside, then renamed over it). Best-effort.
+fn write_closed_index(dir: &Path, closed: &mut [(String, FileStamp)]) {
+    closed.sort_by(|a, b| a.0.cmp(&b.0));
+    let mut out = String::with_capacity(closed.len() * 72);
+    for (chat_id, stamp) in closed.iter() {
+        if chat_id.contains(['\t', '\n', '\r']) {
+            continue;
+        }
+        out.push_str(&format!("{chat_id}\t{}\t{}\n", stamp.len, stamp.modified_ns));
+    }
+    let tmp = dir.join(format!("{CLOSED_INDEX}.tmp"));
+    let saved = std::fs::write(&tmp, out).and_then(|()| std::fs::rename(&tmp, dir.join(CLOSED_INDEX)));
+    if let Err(err) = saved {
+        let _ = std::fs::remove_file(&tmp);
+        tracing::warn!(error = %err, "journal: closed-journal index not saved; the next boot reads every journal");
+    }
+}
+
+/// For each journal, in order: whether its last valid event is something other than a
+/// `Done` (a run that died mid-stream). Up to [`TAIL_READERS`] are read at once.
+fn read_tails(journals: &[(String, PathBuf, Option<FileStamp>)]) -> Vec<Result<bool, JournalError>> {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let is_stale = |path: &Path| -> Result<bool, JournalError> {
+        Ok(matches!(
+            last_valid_line(path)?,
+            Some((_, event)) if !matches!(event, AgentEvent::Done { .. })
+        ))
+    };
+    let next = AtomicUsize::new(0);
+    // A reader takes the next unclaimed journal until none are left, and says
+    // which one each of its results is for.
+    let indexed_work = || {
+        let mut read = Vec::new();
+        loop {
+            let i = next.fetch_add(1, Ordering::Relaxed);
+            let Some((_, path, _)) = journals.get(i) else { break };
+            read.push((i, is_stale(path)));
+        }
+        read
+    };
+    let mut results: Vec<Option<Result<bool, JournalError>>> = (0..journals.len()).map(|_| None).collect();
+    let mut place = |indexed: Vec<(usize, Result<bool, JournalError>)>| {
+        for (i, result) in indexed {
+            results[i] = Some(result);
+        }
+    };
+    std::thread::scope(|scope| {
+        let helpers: Vec<_> = (1..TAIL_READERS.min(journals.len()))
+            .filter_map(|_| {
+                std::thread::Builder::new()
+                    .name("journal-scan".into())
+                    .spawn_scoped(scope, indexed_work)
+                    .ok()
+            })
+            .collect();
+        // This thread reads too, so a reader that couldn't start costs nothing.
+        place(indexed_work());
+        for helper in helpers {
+            match helper.join() {
+                Ok(indexed) => place(indexed),
+                Err(panic) => std::panic::resume_unwind(panic),
+            }
+        }
+    });
+    results
+        .into_iter()
+        .map(|result| result.expect("every journal is claimed by exactly one reader"))
+        .collect()
+}
+
 /// Parse every valid line; malformed lines (torn tail writes) are skipped.
 fn read_lines(path: &Path) -> Result<Vec<(u64, AgentEvent)>, JournalError> {
     let file = match File::open(path) {
@@ -1143,6 +1288,107 @@ mod tests {
         assert_eq!(journal.stale_sessions().unwrap(), expected);
         assert!(expected.contains(&"multi-chunk-garbage-tail".to_string()));
         assert!(!expected.contains(&"multi-chunk-middle-line".to_string()));
+        // Again, from the index the first scan saved: the same answer.
+        assert!(dir.path().join(CLOSED_INDEX).exists());
+        assert_eq!(journal.stale_sessions().unwrap(), expected);
+    }
+
+    /// The index lists only journals that ended in a closed turn, and a journal
+    /// written to after it was listed is read again.
+    #[test]
+    fn closed_index_lists_closed_journals_and_rereads_changed_ones() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = RunJournal::open(dir.path()).unwrap();
+        journal.append("dead", &text("partial")).unwrap();
+        journal.append("clean", &text("full")).unwrap();
+        journal.append("clean", &done()).unwrap();
+        assert_eq!(journal.stale_sessions().unwrap(), vec!["dead".to_string()]);
+        let index = read_closed_index(dir.path());
+        assert_eq!(index.keys().collect::<Vec<_>>(), vec!["clean"]);
+
+        // A new turn in the listed journal dies mid-stream: found, and unlisted.
+        journal.append("clean", &text("next turn")).unwrap();
+        assert_eq!(
+            journal.stale_sessions().unwrap(),
+            vec!["clean".to_string(), "dead".to_string()]
+        );
+        assert!(read_closed_index(dir.path()).is_empty());
+
+        // Both close: both listed.
+        journal.append("clean", &done()).unwrap();
+        journal.append("dead", &done()).unwrap();
+        assert!(journal.stale_sessions().unwrap().is_empty());
+        let mut listed: Vec<_> = read_closed_index(dir.path()).into_keys().collect();
+        listed.sort();
+        assert_eq!(listed, vec!["clean", "dead"]);
+
+        // A journal that's gone leaves the index.
+        journal.discard("dead").unwrap();
+        assert!(journal.stale_sessions().unwrap().is_empty());
+        assert_eq!(read_closed_index(dir.path()).into_keys().collect::<Vec<_>>(), vec!["clean"]);
+    }
+
+    /// A listed journal whose size and modified time are unchanged is not opened:
+    /// rewritten in place to the same length and time (which an append-only journal
+    /// never is), its new contents go unseen.
+    #[test]
+    fn closed_index_skips_unchanged_journals() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("chat.jsonl");
+        let closed = format!("{}\n", serde_json::to_string(&JournalLineRef { seq: 1, event: &done() }).unwrap());
+        std::fs::write(&path, &closed).unwrap();
+        let journal = RunJournal::open(dir.path()).unwrap();
+        assert!(journal.stale_sessions().unwrap().is_empty());
+
+        let modified = std::fs::metadata(&path).unwrap().modified().unwrap();
+        // The same length: JSON padded with trailing spaces.
+        let open = serde_json::to_string(&JournalLineRef { seq: 1, event: &text("x") }).unwrap();
+        let open = format!("{open:<width$}\n", width = closed.len() - 1);
+        assert_eq!(open.len(), closed.len());
+        std::fs::write(&path, &open).unwrap();
+        File::options().write(true).open(&path).unwrap().set_modified(modified).unwrap();
+        assert!(journal.stale_sessions().unwrap().is_empty(), "read from the index");
+
+        // Any other time and it is read.
+        let later = modified + std::time::Duration::from_secs(5);
+        File::options().write(true).open(&path).unwrap().set_modified(later).unwrap();
+        assert_eq!(journal.stale_sessions().unwrap(), vec!["chat".to_string()]);
+    }
+
+    /// A damaged index costs a read of every journal, never a wrong answer.
+    #[test]
+    fn closed_index_damage_reads_journals_again() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = RunJournal::open(dir.path()).unwrap();
+        journal.append("dead", &text("partial")).unwrap();
+        journal.append("clean", &done()).unwrap();
+        std::fs::write(
+            dir.path().join(CLOSED_INDEX),
+            "dead\tnot-a-number\t1\nclean\t1\nnoise\n\t5\t5\ndead\t1\t2\t3\n",
+        )
+        .unwrap();
+        assert_eq!(journal.stale_sessions().unwrap(), vec!["dead".to_string()]);
+        assert_eq!(read_closed_index(dir.path()).into_keys().collect::<Vec<_>>(), vec!["clean"]);
+    }
+
+    /// More journals than readers: every one is read, each result is its own.
+    #[test]
+    fn many_journals_are_read_in_parallel_with_the_same_answer() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = RunJournal::open(dir.path()).unwrap();
+        let mut expected = Vec::new();
+        for i in 0..TAIL_READERS * 5 + 3 {
+            let chat = format!("chat-{i:03}");
+            journal.append(&chat, &text("a")).unwrap();
+            if i % 3 == 0 {
+                expected.push(chat);
+            } else {
+                journal.append(&chat, &done()).unwrap();
+            }
+        }
+        assert_eq!(journal.stale_sessions().unwrap(), expected);
+        assert_eq!(read_closed_index(dir.path()).len(), TAIL_READERS * 5 + 3 - expected.len());
+        assert_eq!(journal.stale_sessions().unwrap(), expected);
     }
 
     #[test]
