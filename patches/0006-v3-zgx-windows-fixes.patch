-accesskit_windows = { git = "https://github.com/zeronsh/zgx", rev = "5773514414a637df4bc705ea2838f9eda714285d" }
+wgpu-hal = { git = "https://github.com/hoangvu12/zgx", rev = "d8b7c6ca10b8d9d72d8b0a3eaf760daf9878f4ae" }
+winit = { git = "https://github.com/hoangvu12/zgx", rev = "d8b7c6ca10b8d9d72d8b0a3eaf760daf9878f4ae" }
