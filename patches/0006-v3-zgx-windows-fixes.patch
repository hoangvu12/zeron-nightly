-accesskit_atspi_common = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9" }
-accesskit_unix = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9" }
-accesskit_windows = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9" }
+wgpu-hal = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+winit = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+accesskit_macos = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+accesskit_consumer = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+accesskit_atspi_common = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+accesskit_unix = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
+accesskit_windows = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
 
