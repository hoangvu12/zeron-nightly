+accesskit_atspi_common = { git = "https://github.com/hoangvu12/zgx", rev = "d8b7c6ca10b8d9d72d8b0a3eaf760daf9878f4ae" }
+accesskit_unix = { git = "https://github.com/hoangvu12/zgx", rev = "d8b7c6ca10b8d9d72d8b0a3eaf760daf9878f4ae" }
+accesskit_windows = { git = "https://github.com/hoangvu12/zgx", rev = "d8b7c6ca10b8d9d72d8b0a3eaf760daf9878f4ae" }
 
