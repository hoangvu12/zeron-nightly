diff --git a/apps/zgx/Cargo.toml b/apps/zgx/Cargo.toml
index cb96e7fd7..478333a26 100644
--- a/apps/zgx/Cargo.toml
+++ b/apps/zgx/Cargo.toml
@@ -30,7 +30,7 @@ beta = []
 layout_probe = []
 
 [dependencies]
-zgx = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9" }
+zgx = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea" }
 # `mimalloc`: the program's allocator, in place of the system's. It hands
 # freed memory back to the system (the system's keeps the most it ever
 # held), and zgx measures 1-10% less CPU for script, text and layout work.
@@ -41,22 +41,22 @@ zgx = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a2
 # none of it, and without it pages are placeholders ("Web view · <url>").
 # zgx-run turns it on by default, but this app takes zgx-run without its
 # defaults (below). Nothing on macOS or Windows.
-zgx-desktop = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9", features = ["mimalloc", "terminal", "webkitgtk"] }
+zgx-desktop = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea", features = ["mimalloc", "terminal", "webkitgtk"] }
 # `inspect`: devtools for `zgx inspect` (and its MCP server), asked for
 # with `--inspect`. `i18n`: `ui.t`'s plurals and numbers by each locale's
 # own rules (ICU4X's data, about 90 KB), for ui/locales' translations.
-zgx-script = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9", features = ["inspect", "i18n"] }
+zgx-script = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea", features = ["inspect", "i18n"] }
 # A picture's pixels for the clipboard (src/images.rs): zgx's own decoder,
 # the formats `ui.image` shows (no features of its own: the ones zgx-desktop
 # turns on).
-zgx-gpu = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9", default-features = false }
+zgx-gpu = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea", default-features = false }
 # Each plugin's own database (`zeron.db`, src/plugins/db.rs): SQLite,
 # built in; `limits` to keep one from attaching any other file.
 rusqlite = { version = "0.32", features = ["bundled", "limits", "hooks"] }
 # `fetch`: zgx's own transport for `ui.fetch` and remote images (HTTP and
 # HTTPS, rustls), given to every window (src/main.rs): the app's scripts,
 # and plugins granted "network". Nothing else of the runner.
-zgx-run = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9", default-features = false, features = ["fetch"] }
+zgx-run = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea", default-features = false, features = ["fetch"] }
 # `webp`: `ui.image` decodes through this crate, by what its features
 # allow, so turning WebP on here is all it takes (the member cards' art).
 # `ico`: sites' favicons (the browser tab's: src/favicons.rs), most of
@@ -148,7 +148,7 @@ foreign-types = "0.5"
 # elements, box drawing and Powerline glyphs to the cell; zgx's own renderer
 # draws them from the font at its text line height, gapped. Builds Ghostty
 # with Zig 0.16 (cached in ~/Library/Caches/zgx-ghostty).
-zgx-desktop = { git = "https://github.com/zeronsh/zgx", rev = "88ff58c08b6318eb2e05bb2a22128fefdfca8db9", features = ["ghostty"] }
+zgx-desktop = { git = "https://github.com/hoangvu12/zgx", rev = "f29cf3dc5a9271c27f3dce480e48065c7410cfea", features = ["ghostty"] }
 
 # Windows' Transparency effects (src/transparency.rs), read and watched in
 # the registry, until zgx reports them (zgx-asks/windows-transparency); a
@@ -159,13 +159,13 @@ windows-sys = { version = "0.61", features = ["Win32_Foundation", "Win32_Graphic
 # zgx's own patches (its root Cargo.toml): a git dependency does not bring
 # them, so every consumer repeats them.
