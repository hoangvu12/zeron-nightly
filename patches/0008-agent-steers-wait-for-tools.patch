+/// A message sent while a command runs is written `next`, with no stop
+/// before it: the command runs to its end, and the message is read after
+/// its result. (An agent's send to a busy chat comes this way; only a steer
+/// read at once stops the turn first, by `TurnControl::stop_turn`.)
+#[tokio::test]
+async fn a_message_sent_while_a_command_runs_waits_for_it() {
+    let (controls, steer, _token) = controls("A");
+    let mut stream = harness()
+        .run(request("scenario:tool-open-steer"), controls)
+        .await
+        .expect("run starts");
+    macro_rules! next {
+        () => {
+            tokio::time::timeout(Duration::from_secs(10), stream.next())
+                .await
+                .expect("event in time")
+                .expect("stream open")
+                .expect("stream event")
+        };
+    }
+    loop {
+        if matches!(next!(), AgentEvent::ToolCall { id, .. } if id == "tool-gate") {
+            break;
+        }
+    }
+    steer.send(steer_msg("from the lead")).await.unwrap();
+    let mut events = Vec::new();
+    loop {
+        let event = next!();
+        let said = matches!(&event, AgentEvent::TextDelta { text } if text.starts_with("priority:"));
+        events.push(event);
+        if said {
+            break;
+        }
+    }
+    assert!(
+        events.iter().any(|e| matches!(e, AgentEvent::ToolResult { id, is_error: false, .. } if id == "tool-gate")),
+        "the command ran to its end: {events:?}"
+    );
+    assert_eq!(
+        events.last(),
+        Some(&AgentEvent::TextDelta {
+            text: "priority:next".into()
+        })
+    );
+}
