+/// A running tool call as the note after a steer's stop names it.
+fn running_call(call: &zeron_proto::ToolCall) -> String {
+    use zeron_proto::ToolCall;
+    match call {
+        ToolCall::Exec { command } => {
+            let line = command.lines().next().unwrap_or_default().trim();
+            let short: String = line.chars().take(80).collect();
+            let more = if short.len() < command.trim().len() { "…" } else { "" };
+            format!("command `{short}{more}`")
+        }
+        ToolCall::Mcp { tool, .. } => format!("`{tool}` call"),
+        ToolCall::Unknown { name, .. } => format!("`{name}` call"),
+        _ => "tool call".to_owned(),
+    }
+}
+
+/// What a steer read at once tells the agent when it stopped the agent's
+/// running `calls` to get there: the provider tells it the person declined
+/// them, and an agent that believes that stops and waits for nobody.
+fn stopped_calls_note(calls: &[String]) -> String {
+    let what = match calls {
+        [] => "tool call".to_owned(),
+        [one] => one.clone(),
+        [rest @ .., last] => format!("{} and {last}", rest.join(", ")),
+    };
+    let (was, it, is) = if calls.len() > 1 {
+        ("were", "them", "they're")
+    } else {
+        ("was", "it", "it's")
+    };
+    format!(
+        "[Zeron note: your running {what} {was} stopped so you could read the message above at once. \
+         Nobody declined {it}; run {it} again if {is} still needed.]"
+    )
+}
